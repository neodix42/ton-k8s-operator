clear_longhorn_namespace_resource_finalizers() {
  local resource
  for resource in $(kubectl api-resources --api-group=longhorn.io -o name 2>/dev/null || true); do
    kubectl -n "$LONGHORN_NAMESPACE" get "$resource" -o name 2>/dev/null \
      | xargs -r -I{} kubectl -n "$LONGHORN_NAMESPACE" patch {} --type=merge -p '{"metadata":{"finalizers":[]}}' >/dev/null 2>&1 || true
  done
}

force_finalize_namespace() {
  local ns="$1"

  kubectl patch namespace "$ns" --type=json -p='[{"op":"replace","path":"/spec/finalizers","value":[]}]' >/dev/null 2>&1 || true
  kubectl patch namespace "$ns" --type=merge -p '{"spec":{"finalizers":[]}}' >/dev/null 2>&1 || true

  if command -v jq >/dev/null 2>&1; then
    kubectl get ns "$ns" -o json 2>/dev/null \
      | jq '.spec.finalizers=[]' \
      | kubectl replace --raw "/api/v1/namespaces/${ns}/finalize" -f - >/dev/null 2>&1 || true
  fi

  kubectl delete namespace "$ns" --ignore-not-found --wait=false >/dev/null 2>&1 || true
}

recover_stuck_longhorn_namespace() {
  local phase
  if ! kubectl get namespace "$LONGHORN_NAMESPACE" >/dev/null 2>&1; then
    return 0
  fi

  phase="$(kubectl get namespace "$LONGHORN_NAMESPACE" -o jsonpath='{.status.phase}' 2>/dev/null || true)"
  if [[ "$phase" != "Terminating" ]]; then
    return 0
  fi

  echo "[baremetal] Namespace ${LONGHORN_NAMESPACE} is Terminating; cleaning stale Longhorn webhooks/finalizers ..."
  cleanup_longhorn_webhook_configs
  clear_longhorn_namespace_resource_finalizers
  force_finalize_namespace "$LONGHORN_NAMESPACE"
  wait_namespace_gone "$LONGHORN_NAMESPACE" "$NAMESPACE_DELETE_PROGRESS_TIMEOUT" || true
}

delete_volume_attachments_for_pv() {
  local pv="$1"
  local attachment

  kubectl get volumeattachments.storage.k8s.io \
    -o jsonpath='{range .items[?(@.spec.source.persistentVolumeName=="'"${pv}"'")]}{.metadata.name}{"\n"}{end}' 2>/dev/null \
    | while IFS= read -r attachment; do
        attachment="$(trim_whitespace "$attachment")"
        [[ -z "$attachment" ]] && continue
        echo "[cleanup] Deleting stale VolumeAttachment ${attachment} for PV ${pv} ..."
        kubectl delete volumeattachment "$attachment" --ignore-not-found --wait=false >/dev/null 2>&1 || true
      done
}

delete_vault_pvcs_and_backing_volumes() {
  local -a pvc_rows=()
  local namespace_marker pvc_rows_output pvc

  if ! namespace_marker="$(kubectl get namespace "$VAULT_NAMESPACE" --ignore-not-found -o jsonpath='{.metadata.uid}' 2>/dev/null)"; then
    echo "Error: could not inspect Vault namespace ${VAULT_NAMESPACE} before storage cleanup." >&2
    return 1
  fi
  namespace_marker="$(trim_whitespace "$namespace_marker")"
  if [[ -z "$namespace_marker" ]]; then
    return 0
  fi

  if ! pvc_rows_output="$(kubectl -n "$VAULT_NAMESPACE" get pvc -o jsonpath='{range .items[*]}{.metadata.name}{"\n"}{end}' 2>/dev/null)"; then
    echo "Error: could not list Vault PVCs in ${VAULT_NAMESPACE}." >&2
    return 1
  fi
  while IFS= read -r pvc; do
    pvc="$(trim_whitespace "$pvc")"
    [[ -z "$pvc" ]] && continue
    append_unique_item "$VAULT_NAMESPACE"$'\t'"$pvc" pvc_rows
  done <<<"$pvc_rows_output"

  if [[ ${#pvc_rows[@]} -eq 0 ]]; then
    return 0
  fi

  delete_pvc_rows_and_backing_volumes pvc_rows "cleanup"
}

cleanup_vault_force() {
  echo "[uninstall] Forcing Vault cleanup ..."

  if ! kubectl get namespace "$VAULT_NAMESPACE" >/dev/null 2>&1; then
    return 0
  fi

  # Ensure workload references are gone so pvc-protection can clear.
  kubectl -n "$VAULT_NAMESPACE" delete statefulset vault --ignore-not-found --wait=false >/dev/null 2>&1 || true
  kubectl -n "$VAULT_NAMESPACE" delete pod --all --ignore-not-found --grace-period=0 --force >/dev/null 2>&1 || true
  if ! delete_vault_pvcs_and_backing_volumes; then
    echo "Error: Vault backing storage cleanup did not complete; keeping ${VAULT_NAMESPACE} for a safe retry." >&2
    return 1
  fi

  local resource
  for resource in $(kubectl api-resources --verbs=list --namespaced -o name 2>/dev/null || true); do
    kubectl -n "$VAULT_NAMESPACE" get "$resource" -o name 2>/dev/null \
      | xargs -r -I{} kubectl -n "$VAULT_NAMESPACE" patch {} --type=merge -p '{"metadata":{"finalizers":[]}}' >/dev/null 2>&1 || true
    kubectl -n "$VAULT_NAMESPACE" delete "$resource" --all --ignore-not-found --wait=false >/dev/null 2>&1 || true
  done

  force_finalize_namespace "$VAULT_NAMESPACE"
  wait_namespace_gone "$VAULT_NAMESPACE" "$NAMESPACE_DELETE_PROGRESS_TIMEOUT" || true
}

recover_stuck_vault_namespace() {
  local phase
  if ! kubectl get namespace "$VAULT_NAMESPACE" >/dev/null 2>&1; then
    return 0
  fi

  phase="$(kubectl get namespace "$VAULT_NAMESPACE" -o jsonpath='{.status.phase}' 2>/dev/null || true)"
  if [[ "$phase" != "Terminating" ]]; then
    return 0
  fi

  echo "[baremetal] Namespace ${VAULT_NAMESPACE} is Terminating; cleaning stuck Vault pods/PVC/finalizers ..."
  cleanup_vault_force
}

delete_namespace_with_progress() {
  local ns="$1"
  local timeout_seconds="${2:-$NAMESPACE_DELETE_PROGRESS_TIMEOUT}"
  local start_ts now_ts elapsed phase pods
  local force_attempts=0
  local max_force_attempts=3

  if ! kubectl get namespace "$ns" >/dev/null 2>&1; then
    echo "[uninstall] Namespace ${ns} already absent."
    return 0
  fi

  echo "[uninstall] Deleting namespace ${ns} ..."
  kubectl delete namespace "$ns" --ignore-not-found --wait=false >/dev/null 2>&1 || true

  start_ts="$(date +%s)"
  while kubectl get namespace "$ns" >/dev/null 2>&1; do
    now_ts="$(date +%s)"
    elapsed=$((now_ts - start_ts))
    phase="$(kubectl get namespace "$ns" -o jsonpath='{.status.phase}' 2>/dev/null || true)"
    pods="$(kubectl -n "$ns" get pods --no-headers 2>/dev/null | awk 'NF{c++} END{print c+0}')"
    [[ -z "$pods" ]] && pods="0"
    echo "[progress] namespace ${ns}: phase=${phase:-unknown}, pods=${pods} (elapsed ${elapsed}s)"

    if (( elapsed >= timeout_seconds )); then
      if (( force_attempts >= max_force_attempts )); then
        echo "Warning: namespace ${ns} still exists after ${max_force_attempts} forced cleanup attempts; continuing uninstall." >&2
        return 0
      fi
      ((force_attempts+=1))
      echo "Warning: namespace ${ns} still exists after ${timeout_seconds}s; forcing cleanup attempt." >&2
      if [[ "$ns" == "$LONGHORN_NAMESPACE" ]]; then
        recover_stuck_longhorn_namespace || true
      elif [[ "$ns" == "$VAULT_NAMESPACE" ]]; then
        recover_stuck_vault_namespace || true
      else
        kubectl patch namespace "$ns" --type=merge -p '{"spec":{"finalizers":[]}}' >/dev/null 2>&1 || true
        kubectl delete namespace "$ns" --ignore-not-found --wait=false >/dev/null 2>&1 || true
      fi
      start_ts="$(date +%s)"
    fi
    sleep 10
  done

  echo "[uninstall] Namespace ${ns} removed."
  return 0
}

run_with_namespace_progress() {
  local label="$1"
  local ns="$2"
  shift 2

  "$@" &
  local cmd_pid=$!
  local start_ts now_ts elapsed pods total ready
  start_ts="$(date +%s)"

  while kill -0 "$cmd_pid" >/dev/null 2>&1; do
    sleep 10
    if ! kill -0 "$cmd_pid" >/dev/null 2>&1; then
      break
    fi
    now_ts="$(date +%s)"
    elapsed=$((now_ts - start_ts))
    pods="$(kubectl -n "$ns" get pods --no-headers 2>/dev/null || true)"
    if [[ -n "$pods" ]]; then
      total="$(printf '%s\n' "$pods" | awk 'NF{c++} END{print c+0}')"
      ready="$(printf '%s\n' "$pods" | awk 'NF{split($2,a,"/"); if (a[1]==a[2]) c++} END{print c+0}')"
      echo "[progress] ${label}: ${ready}/${total} pods ready (elapsed ${elapsed}s)"
    else
      echo "[progress] ${label}: waiting for first pods (elapsed ${elapsed}s)"
    fi
  done

  wait "$cmd_pid"
}

longhorn_release_status() {
  helm status "$LONGHORN_RELEASE_NAME" -n "$LONGHORN_NAMESPACE" 2>/dev/null \
    | awk -F': ' '/^STATUS:/ {print tolower($2); exit}'
}

longhorn_latest_deployed_revision() {
  helm history "$LONGHORN_RELEASE_NAME" -n "$LONGHORN_NAMESPACE" 2>/dev/null \
    | awk '$1 ~ /^[0-9]+$/ && $0 ~ /[[:space:]]deployed[[:space:]]/ {rev=$1} END{if (rev != "") print rev}'
}

longhorn_daemonset_ready_quick() {
  local name="$1"
  local desired ready updated

  if ! kubectl -n "$LONGHORN_NAMESPACE" get daemonset "$name" >/dev/null 2>&1; then
    return 1
  fi

  desired="$(kubectl -n "$LONGHORN_NAMESPACE" get daemonset "$name" -o jsonpath='{.status.desiredNumberScheduled}' 2>/dev/null || true)"
  ready="$(kubectl -n "$LONGHORN_NAMESPACE" get daemonset "$name" -o jsonpath='{.status.numberReady}' 2>/dev/null || true)"
  updated="$(kubectl -n "$LONGHORN_NAMESPACE" get daemonset "$name" -o jsonpath='{.status.updatedNumberScheduled}' 2>/dev/null || true)"

  [[ "$desired" =~ ^[0-9]+$ && "$ready" =~ ^[0-9]+$ && "$updated" =~ ^[0-9]+$ ]] || return 1
  (( desired > 0 && ready == desired && updated == desired ))
}

longhorn_deployment_ready_quick() {
  local name="$1"
  local desired available updated

  if ! kubectl -n "$LONGHORN_NAMESPACE" get deployment "$name" >/dev/null 2>&1; then
    return 1
  fi

  desired="$(kubectl -n "$LONGHORN_NAMESPACE" get deployment "$name" -o jsonpath='{.spec.replicas}' 2>/dev/null || true)"
  available="$(kubectl -n "$LONGHORN_NAMESPACE" get deployment "$name" -o jsonpath='{.status.availableReplicas}' 2>/dev/null || true)"
  updated="$(kubectl -n "$LONGHORN_NAMESPACE" get deployment "$name" -o jsonpath='{.status.updatedReplicas}' 2>/dev/null || true)"
  [[ -z "$desired" ]] && desired="1"
  [[ -z "$available" ]] && available="0"
  [[ -z "$updated" ]] && updated="0"

  [[ "$desired" =~ ^[0-9]+$ && "$available" =~ ^[0-9]+$ && "$updated" =~ ^[0-9]+$ ]] || return 1
  (( available >= desired && updated >= desired ))
}

longhorn_storage_ready_quick() {
  local storage_class="${1:-longhorn}"
  local provisioner expected_ready csi_nodes_count dep

  provisioner="$(storage_class_provisioner "$storage_class")"
  [[ "$provisioner" == "driver.longhorn.io" ]] || return 1

  longhorn_daemonset_ready_quick longhorn-manager || return 1
  longhorn_daemonset_ready_quick longhorn-csi-plugin || return 1

  for dep in csi-attacher csi-provisioner csi-resizer csi-snapshotter longhorn-driver-deployer; do
    longhorn_deployment_ready_quick "$dep" || return 1
  done

  expected_ready="$(kubectl -n "$LONGHORN_NAMESPACE" get daemonset longhorn-csi-plugin -o jsonpath='{.status.desiredNumberScheduled}' 2>/dev/null || true)"
  csi_nodes_count="$(list_longhorn_csi_node_names | awk 'NF{c++} END{print c+0}')"
  [[ "$expected_ready" =~ ^[0-9]+$ && "$csi_nodes_count" =~ ^[0-9]+$ ]] || return 1
  (( expected_ready > 0 && csi_nodes_count >= expected_ready ))
}

longhorn_release_metadata_present() {
  local count
  count="$(kubectl -n "$LONGHORN_NAMESPACE" get secret,configmap -l "owner=helm,name=${LONGHORN_RELEASE_NAME}" --no-headers 2>/dev/null | awk 'NF{c++} END{print c+0}' || true)"
  [[ "${count:-0}" != "0" ]]
}

storage_class_provisioner() {
  local storage_class="$1"
  kubectl get storageclass "$storage_class" -o jsonpath='{.provisioner}' 2>/dev/null | tr -d '[:space:]'
}

storage_class_is_longhorn() {
  local storage_class="$1"
  [[ "$(storage_class_provisioner "$storage_class")" == "driver.longhorn.io" ]]
}

longhorn_selector_to_kubectl_selector() {
  local selector="$1"
  local -a selector_pairs=()
  local kubectl_selector=""
  local pair

  parse_selector_pairs "$selector" selector_pairs || return 1
  for pair in "${selector_pairs[@]}"; do
    if [[ -n "$kubectl_selector" ]]; then
      kubectl_selector+=","
    fi
    kubectl_selector+="$pair"
  done
  printf '%s' "$kubectl_selector"
}

wait_longhorn_storage_ready() {
  local storage_class="${1:-longhorn}"
  local timeout_seconds="${2:-$KUBETON_LONGHORN_READY_TIMEOUT_SECONDS}"
  local deadline=$(( $(date +%s) + timeout_seconds ))
  local provisioner=""
  local expected_ready=0
  local csi_nodes_count=0
  local dep

  echo "[baremetal] Waiting for Longhorn CSI/storage readiness (timeout ${timeout_seconds}s) ..."

  while (( $(date +%s) < deadline )); do
    provisioner="$(storage_class_provisioner "$storage_class")"
    if [[ "$provisioner" == "driver.longhorn.io" ]]; then
      break
    fi
    sleep 2
  done
  if [[ "$provisioner" != "driver.longhorn.io" ]]; then
    echo "Error: StorageClass ${storage_class} is not available with Longhorn provisioner driver.longhorn.io." >&2
    return 1
  fi

  if kubectl -n "$LONGHORN_NAMESPACE" get daemonset longhorn-manager >/dev/null 2>&1; then
    kubectl -n "$LONGHORN_NAMESPACE" rollout status daemonset/longhorn-manager --timeout="${timeout_seconds}s" >/dev/null
  fi

  while (( $(date +%s) < deadline )); do
    if kubectl -n "$LONGHORN_NAMESPACE" get daemonset longhorn-csi-plugin >/dev/null 2>&1; then
      break
    fi
    sleep 2
  done
  if ! kubectl -n "$LONGHORN_NAMESPACE" get daemonset longhorn-csi-plugin >/dev/null 2>&1; then
    echo "Error: Longhorn CSI daemonset ${LONGHORN_NAMESPACE}/longhorn-csi-plugin was not created." >&2
    return 1
  fi
  kubectl -n "$LONGHORN_NAMESPACE" rollout status daemonset/longhorn-csi-plugin --timeout="${timeout_seconds}s" >/dev/null

  for dep in csi-attacher csi-provisioner csi-resizer csi-snapshotter longhorn-driver-deployer; do
    if kubectl -n "$LONGHORN_NAMESPACE" get deployment "$dep" >/dev/null 2>&1; then
      kubectl -n "$LONGHORN_NAMESPACE" rollout status "deployment/${dep}" --timeout="${timeout_seconds}s" >/dev/null
    fi
  done

  while (( $(date +%s) < deadline )); do
    expected_ready="$(kubectl -n "$LONGHORN_NAMESPACE" get daemonset longhorn-csi-plugin -o jsonpath='{.status.desiredNumberScheduled}' 2>/dev/null || true)"
    csi_nodes_count="$(list_longhorn_csi_node_names | awk 'NF{c++} END{print c+0}')"
    if [[ "${expected_ready:-0}" != "0" && "${csi_nodes_count:-0}" -ge "${expected_ready:-0}" ]]; then
      verify_longhorn_multipathd_safe
      return 0
    fi
    sleep 2
  done

  echo "Error: timeout waiting for Longhorn CSI registration in CSINode objects (${csi_nodes_count:-0}/${expected_ready:-0})." >&2
  return 1
}

longhorn_setting_value_matches() {
  local current_value="$1"
  local desired_value="$2"
  local compact_current

  current_value="$(trim_whitespace "$current_value")"
  desired_value="$(trim_whitespace "$desired_value")"
  if [[ "$current_value" == "$desired_value" ]]; then
    return 0
  fi

  # Longhorn 1.10 can normalize some numeric settings into a v1/v2 JSON string,
  # for example default-replica-count: {"v1":"3","v2":"3"}.
  if [[ "$desired_value" =~ ^[0-9]+$ ]]; then
    compact_current="${current_value//[[:space:]]/}"
    if [[ "$compact_current" == "{\"v1\":\"${desired_value}\",\"v2\":\"${desired_value}\"}" ]] \
      || [[ "$compact_current" == "{\"v2\":\"${desired_value}\",\"v1\":\"${desired_value}\"}" ]] \
      || [[ "$compact_current" == "{\"v1\":${desired_value},\"v2\":${desired_value}}" ]] \
      || [[ "$compact_current" == "{\"v2\":${desired_value},\"v1\":${desired_value}}" ]]; then
      return 0
    fi
  fi

  return 1
}

apply_longhorn_setting_value() {
  local setting_name="$1"
  local desired_value="$2"
  local timeout_seconds="${3:-120}"
  local deadline=$(( $(date +%s) + timeout_seconds ))
  local current_value escaped_desired

  setting_name="$(trim_whitespace "$setting_name")"
  desired_value="$(trim_whitespace "$desired_value")"
  if [[ -z "$setting_name" ]]; then
    echo "Error: internal Longhorn setting name is empty." >&2
    return 1
  fi

  while (( $(date +%s) < deadline )); do
    current_value="$(kubectl -n "$LONGHORN_NAMESPACE" get settings.longhorn.io "$setting_name" -o jsonpath='{.value}' 2>/dev/null || true)"
    current_value="$(trim_whitespace "$current_value")"
    if longhorn_setting_value_matches "$current_value" "$desired_value"; then
      return 0
    fi

    escaped_desired="$(json_escape_string "$desired_value")"
    if kubectl -n "$LONGHORN_NAMESPACE" patch settings.longhorn.io "$setting_name" --type=merge \
      -p "{\"value\":\"${escaped_desired}\"}" >/dev/null 2>&1; then
      current_value="$(kubectl -n "$LONGHORN_NAMESPACE" get settings.longhorn.io "$setting_name" -o jsonpath='{.value}' 2>/dev/null || true)"
      current_value="$(trim_whitespace "$current_value")"
      if longhorn_setting_value_matches "$current_value" "$desired_value"; then
        return 0
      fi
    else
      sleep 2
      continue
    fi
    sleep 2
  done

  current_value="$(kubectl -n "$LONGHORN_NAMESPACE" get settings.longhorn.io "$setting_name" -o jsonpath='{.value}' 2>/dev/null || true)"
  current_value="$(trim_whitespace "$current_value")"
  echo "Error: timeout setting Longhorn ${setting_name}=${desired_value}; current value is '${current_value:-unknown}'." >&2
  return 1
}

apply_longhorn_post_start_settings() {
  local system_managed_selector_value="${1:-}"

  if [[ "$LONGHORN_DEFAULT_REPLICA_COUNT" =~ ^[0-9]+$ ]]; then
    echo "[baremetal] Setting Longhorn default-replica-count=${LONGHORN_DEFAULT_REPLICA_COUNT} after manager startup ..."
    apply_longhorn_setting_value "default-replica-count" "$LONGHORN_DEFAULT_REPLICA_COUNT" || return 1
  fi

  system_managed_selector_value="$(trim_whitespace "$system_managed_selector_value")"
  if [[ -n "$system_managed_selector_value" ]]; then
    echo "[baremetal] Setting Longhorn system-managed-components-node-selector after manager startup ..."
    apply_longhorn_setting_value "system-managed-components-node-selector" "$system_managed_selector_value" || return 1
  fi
}

selector_pairs_to_json_object() {
  local selector="$1"
  local -a selector_pairs=()
  local pair key value json_object="" first=1

  parse_selector_pairs "$selector" selector_pairs || return 1
  [[ ${#selector_pairs[@]} -gt 0 ]] || return 1
  json_object="{"
  for pair in "${selector_pairs[@]}"; do
    key="${pair%%=*}"
    value="${pair#*=}"
    (( first == 1 )) || json_object+=","
    json_object+="$(json_quote "$key"):$(json_quote "$value")"
    first=0
  done
  json_object+="}"
  printf '%s' "$json_object"
}

patch_longhorn_daemonset_node_selector() {
  local daemonset="$1"
  local selector="$2"
  local selector_json patch

  selector_json="$(selector_pairs_to_json_object "$selector")" || return 1
  patch="{\"spec\":{\"template\":{\"spec\":{\"nodeSelector\":${selector_json}}}}}"
  kubectl -n "$LONGHORN_NAMESPACE" patch daemonset "$daemonset" --type=merge -p "$patch" >/dev/null
}

ensure_longhorn_daemonsets_constrained() {
  local selector="$1"
  local timeout_seconds="${2:-180}"
  local deadline=$(( $(date +%s) + timeout_seconds ))
  local daemonset actual_selector all_constrained mismatch_since=0 now
  local -a selector_validation_pairs=()
  local -A patched=()

  selector="$(trim_whitespace "$selector")"
  [[ -n "$selector" ]] || return 0
  parse_selector_pairs "$selector" selector_validation_pairs || return 1

  while (( $(date +%s) < deadline )); do
    all_constrained=1
    for daemonset in longhorn-manager longhorn-csi-plugin; do
      if ! longhorn_daemonset_exists "$daemonset"; then
        all_constrained=0
        continue
      fi
      actual_selector="$(longhorn_daemonset_node_selector "$daemonset" || true)"
      if selector_contains_selector_pairs "$actual_selector" "$selector"; then
        continue
      fi
      all_constrained=0
      now="$(date +%s)"
      if (( mismatch_since == 0 )); then
        mismatch_since="$now"
      fi
      # Let Longhorn reconcile the Setting first. A direct DaemonSet patch is
      # only a no-volume recovery fallback for a previously failed install.
      if (( now - mismatch_since >= 15 )) \
        && [[ -z "${patched[$daemonset]:-}" ]] \
        && longhorn_placement_may_be_reconfigured; then
        echo "[baremetal] Repairing Longhorn ${daemonset} placement selector before storage readiness ..."
        patch_longhorn_daemonset_node_selector "$daemonset" "$selector" || return 1
        patched["$daemonset"]=1
      fi
    done
    (( all_constrained == 1 )) && return 0
    sleep 2
  done

  echo "Error: Longhorn manager/CSI DaemonSets did not adopt LONGHORN_NODE_SELECTOR='${selector}'." >&2
  echo "Refusing to wait for CSI on nodes excluded by the kubeton preflight." >&2
  return 1
}

verify_longhorn_multipathd_safe() {
  if ! is_true "$KUBETON_FAIL_ON_LONGHORN_MULTIPATHD"; then
    return 0
  fi
  if ! kubectl get namespace "$LONGHORN_NAMESPACE" >/dev/null 2>&1; then
    return 0
  fi
  if ! kubectl -n "$LONGHORN_NAMESPACE" get nodes.longhorn.io >/dev/null 2>&1; then
    return 0
  fi

  local selector=""
  local selected_count=0
  local node status reason message row
  local -A selected_nodes=()
  local -a bad_nodes=()

  if [[ -n "${LONGHORN_NODE_SELECTOR:-}" ]]; then
    selector="$(longhorn_selector_to_kubectl_selector "$LONGHORN_NODE_SELECTOR")" || return 1
    while IFS= read -r node; do
      node="$(trim_whitespace "$node")"
      [[ -z "$node" ]] && continue
      selected_nodes["$node"]=1
      ((selected_count+=1))
    done < <(list_schedulable_nodes_by_selector "$selector" || true)
    if (( selected_count == 0 )); then
      echo "Error: LONGHORN_NODE_SELECTOR='${LONGHORN_NODE_SELECTOR}' matched no schedulable Kubernetes nodes." >&2
      echo "Cordoned nodes are ignored for Vault/TON mount preflight because workloads cannot schedule there." >&2
      return 1
    fi
  fi

  while IFS=$'\t' read -r node status reason message; do
    node="$(trim_whitespace "$node")"
    status="$(trim_whitespace "$status")"
    reason="$(trim_whitespace "$reason")"
    message="$(trim_whitespace "$message")"
    [[ -z "$node" ]] && continue
    if (( selected_count > 0 )) && [[ -z "${selected_nodes[$node]:-}" ]]; then
      continue
    fi
    if [[ "$status" == "False" || "$reason" == "MultipathdIsRunning" ]]; then
      row="$node"
      [[ -n "$reason" ]] && row+=" (${reason})"
      [[ -n "$message" ]] && row+=": ${message}"
      bad_nodes+=("$row")
    fi
  done < <(
    kubectl -n "$LONGHORN_NAMESPACE" get nodes.longhorn.io \
      -o go-template='{{range .items}}{{ $node := .metadata.name }}{{range .status.conditions}}{{if eq .type "Multipathd"}}{{$node}}{{"\t"}}{{.status}}{{"\t"}}{{.reason}}{{"\t"}}{{.message}}{{"\n"}}{{end}}{{end}}{{end}}' 2>/dev/null || true
  )

  if [[ ${#bad_nodes[@]} -eq 0 ]]; then
    return 0
  fi

  echo "Error: Longhorn reports multipathd running on selected storage node(s)." >&2
  printf '  - %s\n' "${bad_nodes[@]}" >&2
  echo "Longhorn volumes can be claimed by multipathd and fail first mount with:" >&2
  echo "  /dev/longhorn/pvc-* is apparently in use by the system; will not make a filesystem here" >&2
  echo "Fix the host OS before running kubeton start: disable multipathd if unused, or blacklist Longhorn devices in /etc/multipath.conf." >&2
  echo "Temporary bypass: KUBETON_FAIL_ON_LONGHORN_MULTIPATHD=false, but Vault/TON mounts may fail." >&2
  return 1
}

repair_stale_longhorn_release() {
  local status="$1"
  local reason

  if [[ -n "$status" ]]; then
    reason="status=${status}"
  else
    reason="orphaned_helm_metadata"
  fi

  if ! is_true "$ALLOW_DESTRUCTIVE_LONGHORN_REPAIR"; then
    echo "Error: detected stale Longhorn release (${reason}), but destructive auto-repair is disabled." >&2
    echo "Refusing to delete Longhorn resources during start/bootstrap." >&2
    echo "If you really want this automatic cleanup, rerun with: ALLOW_DESTRUCTIVE_LONGHORN_REPAIR=true ./kubeton start" >&2
    return 1
  fi

  if [[ -n "$status" ]]; then
    echo "[baremetal] Longhorn Helm release is in state '${status}', resetting stale release state ..."
  else
    echo "[baremetal] Longhorn Helm metadata exists without a healthy deployed release; resetting stale release state ..."
  fi

  # Uninstall hook can fail when deleting-confirmation-flag is false.
  helm uninstall "$LONGHORN_RELEASE_NAME" -n "$LONGHORN_NAMESPACE" --no-hooks >/dev/null 2>&1 || true
  kubectl -n "$LONGHORN_NAMESPACE" delete secret,configmap -l "owner=helm,name=${LONGHORN_RELEASE_NAME}" --ignore-not-found >/dev/null 2>&1 || true
  cleanup_longhorn_force || true
}

recover_longhorn_release_non_destructive() {
  local status="$1"
  local deployed_revision post_status

  case "$status" in
    failed|pending-install|pending-upgrade|pending-rollback) ;;
    *) return 1 ;;
  esac

  deployed_revision="$(longhorn_latest_deployed_revision || true)"
  deployed_revision="$(trim_whitespace "$deployed_revision")"
  if [[ -z "$deployed_revision" ]]; then
    echo "Warning: Longhorn Helm release is '${status}', but no deployed revision was found for non-destructive recovery." >&2
    return 1
  fi

  echo "[baremetal] Longhorn Helm release is '${status}'; rolling back to deployed revision ${deployed_revision} ..."
  if ! helm rollback "$LONGHORN_RELEASE_NAME" "$deployed_revision" -n "$LONGHORN_NAMESPACE" --wait --timeout 20m; then
    echo "Warning: non-destructive Longhorn rollback to revision ${deployed_revision} failed." >&2
    return 1
  fi

  post_status="$(longhorn_release_status || true)"
  if [[ "$post_status" != "deployed" ]]; then
    echo "Warning: Longhorn rollback completed but Helm status is '${post_status:-unknown}', not deployed." >&2
    return 1
  fi

  return 0
}

ensure_longhorn_installed() {
  require_bin helm
  require_bin kubectl
  if [[ ! "$LONGHORN_CHART_VERSION" =~ ^1\. ]]; then
    echo "Error: LONGHORN_CHART_VERSION must be a v1.x release, got: $LONGHORN_CHART_VERSION" >&2
    exit 1
  fi

  recover_stuck_longhorn_namespace

  # Previous failed uninstall can leave namespace in Terminating state.
  # Helm install cannot create release secrets there until namespace recovers.
  ensure_namespace_not_terminating "$LONGHORN_NAMESPACE" 240

  local lh_status=""
  lh_status="$(longhorn_release_status || true)"
  if [[ -n "$lh_status" && "$lh_status" != "deployed" ]]; then
    if recover_longhorn_release_non_destructive "$lh_status"; then
      lh_status="$(longhorn_release_status || true)"
    else
      repair_stale_longhorn_release "$lh_status"
      recover_stuck_longhorn_namespace
      ensure_namespace_not_terminating "$LONGHORN_NAMESPACE" 240
      lh_status="$(longhorn_release_status || true)"
    fi
  elif [[ -z "$lh_status" ]] && kubectl get namespace "$LONGHORN_NAMESPACE" >/dev/null 2>&1 && longhorn_release_metadata_present; then
    repair_stale_longhorn_release ""
    recover_stuck_longhorn_namespace
    ensure_namespace_not_terminating "$LONGHORN_NAMESPACE" 240
  fi

  local -a longhorn_selector_pairs=()
  local longhorn_system_managed_selector_setting=""
  if [[ -n "${LONGHORN_NODE_SELECTOR:-}" ]]; then
    parse_selector_pairs "$LONGHORN_NODE_SELECTOR" longhorn_selector_pairs || return 1
    if [[ ${#longhorn_selector_pairs[@]} -eq 0 ]]; then
      echo "Error: LONGHORN_NODE_SELECTOR is set but has no valid key=value pairs." >&2
      return 1
    fi
    longhorn_system_managed_selector_setting="$(selector_pairs_to_longhorn_setting longhorn_selector_pairs)"
  fi

  if [[ "$lh_status" == "deployed" ]] \
    && ! is_true "$KUBETON_LONGHORN_PLACEMENT_RECONFIGURE" \
    && is_true "$KUBETON_SKIP_LONGHORN_HELM_UPGRADE_WHEN_READY" \
    && longhorn_storage_ready_quick "longhorn"; then
    apply_longhorn_post_start_settings "$longhorn_system_managed_selector_setting" || return 1
    ensure_longhorn_daemonsets_constrained "$LONGHORN_NODE_SELECTOR" || return 1
    wait_longhorn_storage_ready "longhorn"
    verify_longhorn_multipathd_safe
    echo "[baremetal] Longhorn is already deployed and CSI/storage are Ready; skipping Helm upgrade."
    return 0
  fi

  ensure_helm_repo "longhorn" "https://charts.longhorn.io"
  helm repo update longhorn >/dev/null

  local longhorn_selector_values_file=""
  local -a longhorn_extra_args=()
  if [[ -n "${LONGHORN_NODE_SELECTOR:-}" ]]; then
    local kubectl_selector=""
    local pair
    local matched_nodes=0
    local desired_nodes=0

    for pair in "${longhorn_selector_pairs[@]}"; do
      if [[ -n "$kubectl_selector" ]]; then
        kubectl_selector+=","
      fi
      kubectl_selector+="$pair"
    done

    matched_nodes="$(list_schedulable_nodes_by_selector "$kubectl_selector" | awk 'NF{c++} END{print c+0}')"
    if is_default_longhorn_node_selector "$LONGHORN_NODE_SELECTOR"; then
      desired_nodes="$(desired_longhorn_node_count)"
      if (( matched_nodes < desired_nodes )); then
        auto_label_default_longhorn_nodes "$desired_nodes" || true
      fi
      matched_nodes="$(list_schedulable_nodes_by_selector "$kubectl_selector" | awk 'NF{c++} END{print c+0}')"
    fi
    if [[ "${matched_nodes:-0}" == "0" ]]; then
      echo "Error: LONGHORN_NODE_SELECTOR='${LONGHORN_NODE_SELECTOR}' matched 0 Kubernetes nodes." >&2
      if is_default_longhorn_node_selector "$LONGHORN_NODE_SELECTOR"; then
        echo "Auto-labeling was attempted but no matching nodes are available yet." >&2
      else
        echo "Label at least one node and retry. Example:" >&2
        echo "  kubectl label node <node-name> node.longhorn.io/create-default-disk=true" >&2
      fi
      return 1
    fi
    if [[ "$LONGHORN_DEFAULT_REPLICA_COUNT" =~ ^[0-9]+$ ]] && (( matched_nodes < LONGHORN_DEFAULT_REPLICA_COUNT )); then
      echo "Warning: LONGHORN_NODE_SELECTOR matches ${matched_nodes} nodes, which is less than LONGHORN_DEFAULT_REPLICA_COUNT=${LONGHORN_DEFAULT_REPLICA_COUNT}." >&2
    fi

    longhorn_selector_values_file="$(build_longhorn_selector_values_file "$LONGHORN_NODE_SELECTOR")"
    longhorn_extra_args+=(-f "$longhorn_selector_values_file")
    echo "[baremetal] Restricting Longhorn components to schedulable nodes: ${LONGHORN_NODE_SELECTOR} (matched ${matched_nodes} node(s))"
  fi

  echo "[baremetal] Installing/ensuring Longhorn ${LONGHORN_CHART_VERSION} ..."
  echo "[baremetal] Waiting for Longhorn components to become Ready (timeout 40m) ..."
  local install_rc=0
  # Longhorn managers apply defaultSettings during daemon startup. Passing those
  # through Helm makes every manager race on the same Setting objects.
  run_with_namespace_progress "longhorn" "$LONGHORN_NAMESPACE" \
    helm upgrade --install "$LONGHORN_RELEASE_NAME" "$LONGHORN_CHART" \
    "${longhorn_extra_args[@]}" \
    --version "$LONGHORN_CHART_VERSION" \
    -n "$LONGHORN_NAMESPACE" \
    --create-namespace \
    --reset-values \
    --set "persistence.defaultClassReplicaCount=${LONGHORN_DEFAULT_REPLICA_COUNT}" \
    --disable-openapi-validation \
    --wait \
    --timeout 40m || install_rc=$?

  if [[ -n "$longhorn_selector_values_file" ]]; then
    rm -f "$longhorn_selector_values_file" >/dev/null 2>&1 || true
  fi
  if (( install_rc != 0 )); then
    return "$install_rc"
  fi

  apply_longhorn_post_start_settings "$longhorn_system_managed_selector_setting" || return 1
  ensure_longhorn_daemonsets_constrained "$LONGHORN_NODE_SELECTOR" || return 1
  wait_longhorn_storage_ready "longhorn"
}

ensure_longhorn_crypto_secret() {
  require_bin openssl
  if kubectl -n "$LONGHORN_NAMESPACE" get secret "$LONGHORN_CRYPTO_SECRET_NAME" >/dev/null 2>&1; then
    return
  fi

  echo "[baremetal] Creating Longhorn encryption secret ${LONGHORN_CRYPTO_SECRET_NAME} ..."
  kubectl -n "$LONGHORN_NAMESPACE" create secret generic "$LONGHORN_CRYPTO_SECRET_NAME" \
    --from-literal=CRYPTO_KEY_VALUE="$(openssl rand -base64 48)" \
    --from-literal=CRYPTO_KEY_PROVIDER=secret \
    --from-literal=CRYPTO_KEY_CIPHER=aes-xts-plain64 \
    --from-literal=CRYPTO_KEY_HASH=sha256 \
    --from-literal=CRYPTO_KEY_SIZE=256 \
    --from-literal=CRYPTO_PBKDF=argon2i >/dev/null
}

ensure_encrypted_storage_class() {
  echo "[baremetal] Applying encrypted StorageClass ${ENCRYPTED_SC_NAME} ..."
  cat <<EOF | kubectl apply -f - >/dev/null
apiVersion: storage.k8s.io/v1
kind: StorageClass
metadata:
  name: ${ENCRYPTED_SC_NAME}
provisioner: driver.longhorn.io
allowVolumeExpansion: true
reclaimPolicy: Delete
volumeBindingMode: Immediate
parameters:
  numberOfReplicas: "${LONGHORN_DEFAULT_REPLICA_COUNT}"
  staleReplicaTimeout: "2880"
  encrypted: "true"
  csi.storage.k8s.io/provisioner-secret-name: "${LONGHORN_CRYPTO_SECRET_NAME}"
  csi.storage.k8s.io/provisioner-secret-namespace: "${LONGHORN_NAMESPACE}"
  csi.storage.k8s.io/node-publish-secret-name: "${LONGHORN_CRYPTO_SECRET_NAME}"
  csi.storage.k8s.io/node-publish-secret-namespace: "${LONGHORN_NAMESPACE}"
  csi.storage.k8s.io/node-stage-secret-name: "${LONGHORN_CRYPTO_SECRET_NAME}"
  csi.storage.k8s.io/node-stage-secret-namespace: "${LONGHORN_NAMESPACE}"
  csi.storage.k8s.io/node-expand-secret-name: "${LONGHORN_CRYPTO_SECRET_NAME}"
  csi.storage.k8s.io/node-expand-secret-namespace: "${LONGHORN_NAMESPACE}"
EOF
}

ensure_localdev_encrypted_storage_class() {
  local base_sc="$1"
  local provisioner reclaim_policy volume_binding_mode allow_expand existing_provisioner

  provisioner="$(kubectl get storageclass "$base_sc" -o jsonpath='{.provisioner}')"
  reclaim_policy="$(kubectl get storageclass "$base_sc" -o jsonpath='{.reclaimPolicy}')"
  volume_binding_mode="$(kubectl get storageclass "$base_sc" -o jsonpath='{.volumeBindingMode}')"
  allow_expand="$(kubectl get storageclass "$base_sc" -o jsonpath='{.allowVolumeExpansion}')"

  [[ -z "$provisioner" ]] && { echo "Error: failed to read provisioner for StorageClass $base_sc" >&2; exit 1; }

  if kubectl get storageclass "$ENCRYPTED_SC_NAME" >/dev/null 2>&1; then
    existing_provisioner="$(kubectl get storageclass "$ENCRYPTED_SC_NAME" -o jsonpath='{.provisioner}')"
    if [[ "$existing_provisioner" == "$provisioner" ]]; then
      return
    fi
    echo "[localdev] Replacing StorageClass ${ENCRYPTED_SC_NAME} (old provisioner=${existing_provisioner}, new provisioner=${provisioner}) ..."
    kubectl delete storageclass "$ENCRYPTED_SC_NAME" --ignore-not-found >/dev/null
  fi

  [[ -z "$reclaim_policy" ]] && reclaim_policy="Delete"
  [[ -z "$volume_binding_mode" ]] && volume_binding_mode="Immediate"
  [[ -z "$allow_expand" ]] && allow_expand="true"

  echo "[localdev] Applying StorageClass ${ENCRYPTED_SC_NAME} (provisioner=${provisioner}, base=${base_sc}) ..."
  cat <<EOF | kubectl apply -f - >/dev/null
apiVersion: storage.k8s.io/v1
kind: StorageClass
metadata:
  name: ${ENCRYPTED_SC_NAME}
provisioner: ${provisioner}
allowVolumeExpansion: ${allow_expand}
reclaimPolicy: ${reclaim_policy}
volumeBindingMode: ${volume_binding_mode}
EOF
}

run_vault_helm_install() {
  local vault_storage_class="$1"
  local -n rc_ref="$2"
  local -a selector_files=("${@:3}")
  local -a helm_args=(
    helm upgrade --install "$VAULT_RELEASE_NAME" "$VAULT_CHART"
    "${selector_files[@]}"
    --version "$VAULT_CHART_VERSION"
    -n "$VAULT_NAMESPACE"
    --create-namespace
    --set "server.ha.enabled=false"
    --set "server.standalone.enabled=true"
    --set "server.dataStorage.enabled=true"
    --set-string "server.dataStorage.storageClass=${vault_storage_class}"
    --set "injector.enabled=false"
    --timeout 30m
  )

  echo "[bootstrap] Installing/ensuring Vault chart ${VAULT_CHART_VERSION} ..."

  rc_ref=0
  run_with_namespace_progress "vault" "$VAULT_NAMESPACE" "${helm_args[@]}" || rc_ref=$?
}

vault_mount_conflict_event() {
  local message

  message="$(kubectl -n "$VAULT_NAMESPACE" get events \
    --field-selector "involvedObject.kind=Pod,involvedObject.name=${VAULT_RELEASE_NAME}-0,type=Warning,reason=FailedMount" \
    --sort-by=.lastTimestamp \
    -o custom-columns=MESSAGE:.message \
    --no-headers 2>/dev/null | tail -n 1 || true)"
  message="$(trim_whitespace "$message")"

  if [[ -z "$message" ]]; then
    return 1
  fi

  if grep -Eiq 'already mapped or mounted|Cannot use device /dev/longhorn/.*in use|is apparently in use by the system|already mounted or mount point busy' <<<"$message"; then
    printf '%s' "$message"
    return 0
  fi
  return 1
}

wait_vault_status_or_mount_conflict() {
  local timeout_seconds="${1:-$KUBETON_VOLUME_STAGE_TIMEOUT_SECONDS}"
  local deadline=$(( $(date +%s) + timeout_seconds ))
  local phase conflict_message status initialized sealed

  while (( $(date +%s) < deadline )); do
    if conflict_message="$(vault_mount_conflict_event)"; then
      echo "Warning: detected Vault Longhorn mount conflict: ${conflict_message}" >&2
      return 2
    fi

    phase="$(kubectl -n "$VAULT_NAMESPACE" get pod "${VAULT_RELEASE_NAME}-0" -o jsonpath='{.status.phase}' 2>/dev/null || true)"
    phase="$(trim_whitespace "$phase")"
    if [[ "$phase" == "Running" ]]; then
      status="$(kubectl -n "$VAULT_NAMESPACE" exec "${VAULT_RELEASE_NAME}-0" -- vault status 2>&1 || true)"
      initialized="$(printf '%s\n' "$status" | awk '/^Initialized[[:space:]]+/ {print tolower($2); exit}')"
      sealed="$(printf '%s\n' "$status" | awk '/^Sealed[[:space:]]+/ {print tolower($2); exit}')"
      if [[ "$initialized" == "true" || "$initialized" == "false" ]]; then
        echo "[bootstrap] Vault status is reachable (initialized=${initialized}, sealed=${sealed:-unknown})."
        return 0
      fi
    fi

    if [[ "$phase" == "Failed" ]]; then
      echo "Error: Vault pod ${VAULT_NAMESPACE}/${VAULT_RELEASE_NAME}-0 failed." >&2
      kubectl -n "$VAULT_NAMESPACE" describe pod "${VAULT_RELEASE_NAME}-0" >&2 || true
      return 1
    fi
    sleep 3
  done

  echo "Error: timeout waiting for Vault status from ${VAULT_NAMESPACE}/${VAULT_RELEASE_NAME}-0." >&2
  if conflict_message="$(vault_mount_conflict_event)"; then
    echo "Last Vault mount conflict: ${conflict_message}" >&2
    return 2
  fi
  kubectl -n "$VAULT_NAMESPACE" describe pod "${VAULT_RELEASE_NAME}-0" >&2 || true
  return 1
}

ensure_vault_installed() {
  local vault_storage_class="${1:-longhorn}"
  local vault_selector_values_file=""
  local vault_csi_affinity_values_file=""
  local -a vault_selector_values_files=()
  local -a vault_extra_args=()
  local -a longhorn_csi_nodes=()
  local k3d_selector=""
  local k3d_matched_nodes=0
  local attempt=1
  local max_attempts="$KUBETON_VAULT_MOUNT_RECOVERY_ATTEMPTS"
  local install_rc=0
  local wait_rc=0
  require_bin helm
  if ! [[ "$max_attempts" =~ ^[0-9]+$ ]] || (( max_attempts < 1 )); then
    max_attempts=1
  fi
  ensure_namespace_not_terminating "$VAULT_NAMESPACE" 240
  ensure_helm_repo "hashicorp" "https://helm.releases.hashicorp.com"
  helm repo update hashicorp >/dev/null

  if cluster_is_k3d; then
    k3d_selector="$(trim_whitespace "${VAULT_LOCALDEV_NODE_SELECTOR:-}")"
    if [[ -n "$k3d_selector" ]]; then
      k3d_matched_nodes="$(kubectl get nodes -l "$k3d_selector" --no-headers 2>/dev/null | awk 'NF{c++} END{print c+0}')"
      if [[ "${k3d_matched_nodes:-0}" == "0" ]]; then
        echo "Warning: VAULT_LOCALDEV_NODE_SELECTOR='${k3d_selector}' matched 0 nodes; continuing without Vault node selector." >&2
      else
        vault_selector_values_file="$(build_vault_selector_values_file "$k3d_selector")"
        vault_selector_values_files+=("$vault_selector_values_file")
        vault_extra_args+=(-f "$vault_selector_values_file")
        echo "[localdev] Restricting Vault server to nodes: ${k3d_selector} (matched ${k3d_matched_nodes} node(s))"
      fi
    fi
  fi

  if ! cluster_is_k3d && [[ -n "${LONGHORN_NODE_SELECTOR:-}" ]]; then
    local -a selector_pairs=()
    local kubectl_selector=""
    local pair
    local matched_nodes=0

    parse_selector_pairs "$LONGHORN_NODE_SELECTOR" selector_pairs || return 1
    for pair in "${selector_pairs[@]}"; do
      if [[ -n "$kubectl_selector" ]]; then
        kubectl_selector+=","
      fi
      kubectl_selector+="$pair"
    done
    matched_nodes="$(list_schedulable_nodes_by_selector "$kubectl_selector" | awk 'NF{c++} END{print c+0}')"
    if [[ "${matched_nodes:-0}" == "0" ]]; then
      echo "Error: Vault cannot be scheduled because LONGHORN_NODE_SELECTOR='${LONGHORN_NODE_SELECTOR}' matched 0 schedulable nodes." >&2
      return 1
    fi

    vault_selector_values_file="$(build_vault_selector_values_file "$LONGHORN_NODE_SELECTOR")"
    vault_selector_values_files+=("$vault_selector_values_file")
    vault_extra_args+=(-f "$vault_selector_values_file")
    echo "[baremetal] Restricting Vault server to schedulable Longhorn nodes: ${LONGHORN_NODE_SELECTOR} (matched ${matched_nodes} node(s))"
  fi

  if storage_class_is_longhorn "$vault_storage_class"; then
    wait_longhorn_storage_ready "$vault_storage_class"
    mapfile -t longhorn_csi_nodes < <(list_longhorn_csi_node_names)
    if [[ ${#longhorn_csi_nodes[@]} -eq 0 ]]; then
      echo "Error: storage class '${vault_storage_class}' uses Longhorn, but no CSINode reports driver.longhorn.io." >&2
      return 1
    fi
    vault_csi_affinity_values_file="$(build_vault_csi_affinity_values_file longhorn_csi_nodes)"
    vault_selector_values_files+=("$vault_csi_affinity_values_file")
    vault_extra_args+=(-f "$vault_csi_affinity_values_file")
    echo "[bootstrap] Vault Longhorn CSI nodeAffinity enabled for ${#longhorn_csi_nodes[@]} node(s)."
  fi

  echo "[bootstrap] Waiting for Vault status to become reachable (timeout ${KUBETON_VOLUME_STAGE_TIMEOUT_SECONDS}s) ..."
  while (( attempt <= max_attempts )); do
    install_rc=0
    wait_rc=0
    run_vault_helm_install "$vault_storage_class" install_rc "${vault_extra_args[@]}"
    if (( install_rc != 0 )); then
      break
    fi

    wait_vault_status_or_mount_conflict "$KUBETON_VOLUME_STAGE_TIMEOUT_SECONDS" || wait_rc=$?
    if (( wait_rc == 0 )); then
      break
    fi
    if (( wait_rc != 2 || attempt >= max_attempts )); then
      install_rc="$wait_rc"
      break
    fi

    echo "[bootstrap] Recreating Vault after Longhorn mount conflict (attempt ${attempt}/${max_attempts}) ..."
    uninstall_vault || true
    cleanup_vault_force || true
    delete_namespace_with_progress "$VAULT_NAMESPACE" "$NAMESPACE_DELETE_PROGRESS_TIMEOUT" || true
    ensure_namespace_not_terminating "$VAULT_NAMESPACE" 240
    ((attempt+=1))
  done

  for vault_selector_values_file in "${vault_selector_values_files[@]}"; do
    [[ -n "$vault_selector_values_file" ]] || continue
    rm -f "$vault_selector_values_file" >/dev/null 2>&1 || true
  done
  if (( install_rc != 0 )); then
    return "$install_rc"
  fi
}

vault_exec() {
  kubectl -n "$VAULT_NAMESPACE" exec "${VAULT_RELEASE_NAME}-0" -- "$@"
}

reset_localdev_vault() {
  echo "[localdev] Resetting Vault release/namespace for local recovery ..."
  helm uninstall "$VAULT_RELEASE_NAME" -n "$VAULT_NAMESPACE" >/dev/null 2>&1 || true
  kubectl delete namespace "$VAULT_NAMESPACE" --ignore-not-found >/dev/null 2>&1 || true
  wait_namespace_gone "$VAULT_NAMESPACE" 240 || true
}

vault_status_with_retry() {
  local deadline=$(( $(date +%s) + 180 ))
  local status initialized
  while (( $(date +%s) < deadline )); do
    status="$(vault_exec vault status 2>&1 || true)"
    initialized="$(printf '%s\n' "$status" | awk '/^Initialized[[:space:]]+/ {print tolower($2); exit}')"
    if [[ "$initialized" == "true" || "$initialized" == "false" ]]; then
      printf '%s' "$status"
      return 0
    fi
    sleep 3
  done
  printf '%s' "${status:-}"
  return 1
}

verify_vault_data_path_writable() {
  local check_out
  check_out="$(vault_exec sh -ec '
    test -d /vault/data
    touch /vault/data/.kubeton-rw-test
    rm -f /vault/data/.kubeton-rw-test
  ' 2>&1)" && return 0

  echo "Error: Vault data path /vault/data is not writable in ${VAULT_NAMESPACE}/${VAULT_RELEASE_NAME}-0." >&2
  if [[ -n "$check_out" ]]; then
    echo "Detail: $(printf '%s' "$check_out" | tr '\n' ' ')" >&2
  fi
  echo "This usually means the underlying PVC/PV/Longhorn volume is unhealthy (for example I/O error)." >&2
  echo "Check: kubectl -n ${VAULT_NAMESPACE} describe pod ${VAULT_RELEASE_NAME}-0 ; kubectl -n ${VAULT_NAMESPACE} get pvc ; kubectl -n longhorn-system get volumes.longhorn.io -o wide" >&2
  return 1
}

ensure_vault_bootstrap_secret_from_env() {
  local env_unseal_key env_root_token
  if [[ -z "$VAULT_BOOTSTRAP_UNSEAL_KEY" || -z "$VAULT_BOOTSTRAP_ROOT_TOKEN" ]]; then
    return 1
  fi
  env_unseal_key="$(sanitize_compact "$VAULT_BOOTSTRAP_UNSEAL_KEY")"
  env_root_token="$(sanitize_compact "$VAULT_BOOTSTRAP_ROOT_TOKEN")"
  if [[ -z "$env_unseal_key" || -z "$env_root_token" ]]; then
    echo "Error: provided Vault bootstrap credentials are empty after sanitization." >&2
    return 1
  fi
  echo "[baremetal] Recreating missing Vault bootstrap secret ${VAULT_BOOTSTRAP_SECRET} from environment ..."
  kubectl -n "$VAULT_NAMESPACE" create secret generic "$VAULT_BOOTSTRAP_SECRET" \
    --from-literal=unseal_key="$env_unseal_key" \
    --from-literal=root_token="$env_root_token" \
    --dry-run=client -o yaml | kubectl apply -f - >/dev/null
}

initialize_and_unseal_vault() {
  local status init_out unseal_key root_token initialized sealed

  if ! status="$(vault_status_with_retry)"; then
    echo "Error: failed to get parseable Vault status from ${VAULT_NAMESPACE}/${VAULT_RELEASE_NAME}-0." >&2
    if [[ -n "${status:-}" ]]; then
      echo "Last vault status output:" >&2
      printf '%s\n' "$status" >&2
    fi
    echo "Check pod logs: kubectl -n ${VAULT_NAMESPACE} logs ${VAULT_RELEASE_NAME}-0" >&2
    echo "Check pod events: kubectl -n ${VAULT_NAMESPACE} describe pod ${VAULT_RELEASE_NAME}-0" >&2
    exit 1
  fi
  initialized="$(printf '%s\n' "$status" | awk '/^Initialized[[:space:]]+/ {print tolower($2); exit}')"
  if [[ "$initialized" == "false" ]]; then
    echo "[baremetal] Initializing Vault ..." >&2
    init_out="$(vault_exec vault operator init -key-shares=1 -key-threshold=1)"
    unseal_key="$(printf '%s\n' "$init_out" | awk -F': ' '/Unseal Key 1:/ {print $2; exit}')"
    root_token="$(printf '%s\n' "$init_out" | awk -F': ' '/Initial Root Token:/ {print $2; exit}')"
    unseal_key="$(sanitize_compact "$unseal_key")"
    root_token="$(sanitize_compact "$root_token")"
    if [[ -z "$unseal_key" || -z "$root_token" ]]; then
      echo "Error: failed to parse Vault init output." >&2
      exit 1
    fi
    kubectl -n "$VAULT_NAMESPACE" create secret generic "$VAULT_BOOTSTRAP_SECRET" \
      --from-literal=unseal_key="$unseal_key" \
      --from-literal=root_token="$root_token" \
      --dry-run=client -o yaml | kubectl apply -f - >/dev/null
  elif [[ "$initialized" != "true" ]]; then
    echo "Error: unable to parse Vault initialized state." >&2
    echo "Vault status output:" >&2
    printf '%s\n' "$status" >&2
    exit 1
  fi

  if ! kubectl -n "$VAULT_NAMESPACE" get secret "$VAULT_BOOTSTRAP_SECRET" >/dev/null 2>&1; then
    if [[ "$initialized" == "true" ]] && ensure_vault_bootstrap_secret_from_env; then
      :
    else
      echo "Error: missing Vault bootstrap secret $VAULT_BOOTSTRAP_SECRET in namespace $VAULT_NAMESPACE" >&2
      if [[ "$initialized" == "true" ]]; then
        echo "Vault is already initialized. Provide existing credentials via:" >&2
        echo "  VAULT_BOOTSTRAP_UNSEAL_KEY=<unseal-key> VAULT_BOOTSTRAP_ROOT_TOKEN=<root-token> ./kubeton start" >&2
      fi
      exit 1
    fi
  fi

  unseal_key="$(kubectl -n "$VAULT_NAMESPACE" get secret "$VAULT_BOOTSTRAP_SECRET" -o jsonpath='{.data.unseal_key}' | base64 -d)"
  root_token="$(kubectl -n "$VAULT_NAMESPACE" get secret "$VAULT_BOOTSTRAP_SECRET" -o jsonpath='{.data.root_token}' | base64 -d)"
  unseal_key="$(sanitize_compact "$unseal_key")"
  root_token="$(sanitize_compact "$root_token")"
  if [[ -z "$unseal_key" || -z "$root_token" ]]; then
    echo "Error: Vault bootstrap secret ${VAULT_BOOTSTRAP_SECRET} is missing required keys." >&2
    exit 1
  fi

  status="$(vault_status_with_retry || true)"
  sealed="$(printf '%s\n' "$status" | awk '/^Sealed[[:space:]]+/ {print tolower($2); exit}')"
  if [[ "$sealed" == "true" ]]; then
    echo "[baremetal] Unsealing Vault ..." >&2
    vault_exec vault operator unseal "$unseal_key" >/dev/null
  fi

  printf '%s' "$root_token"
}

configure_vault_for_ton() {
  local root_token="$1"
  local ton_token

  root_token="$(sanitize_compact "$root_token")"
  if [[ -z "$root_token" ]]; then
    echo "Error: empty root token for Vault configuration." >&2
    return 1
  fi
  verify_vault_data_path_writable || return 1

  echo "[baremetal] Configuring Vault Transit key and policy ..."
  vault_exec sh -ec "export VAULT_TOKEN='${root_token}'; vault secrets list | grep -q '^transit/' || vault secrets enable -path=transit transit" || return 1
  vault_exec sh -ec "export VAULT_TOKEN='${root_token}'; vault read transit/keys/${VAULT_TRANSIT_KEY} >/dev/null 2>&1 || vault write -f transit/keys/${VAULT_TRANSIT_KEY}" || return 1
  vault_exec sh -ec "export VAULT_TOKEN='${root_token}'; printf '%s\n' 'path \"transit/encrypt/${VAULT_TRANSIT_KEY}\" { capabilities = [\"update\"] }' 'path \"transit/decrypt/${VAULT_TRANSIT_KEY}\" { capabilities = [\"update\"] }' | vault policy write ${VAULT_TON_POLICY_NAME} -" || return 1
  ton_token="$(vault_exec sh -ec "export VAULT_TOKEN='${root_token}'; vault token create -policy=${VAULT_TON_POLICY_NAME} -period=${VAULT_TOKEN_PERIOD} -orphan -field=token")" || return 1
  ton_token="$(sanitize_compact "$ton_token")"
  if [[ -z "$ton_token" ]]; then
    echo "Error: failed to create TON Vault token." >&2
    return 1
  fi

  ensure_namespace "$TON_NAMESPACE"
  kubectl -n "$TON_NAMESPACE" create secret generic "$TON_VAULT_CREDS_SECRET" \
    --from-literal=VAULT_ADDR="$VAULT_ADDR_INTERNAL" \
    --from-literal=VAULT_TOKEN="$ton_token" \
    --dry-run=client -o yaml | kubectl apply -f - >/dev/null || return 1

  return 0
}

ensure_baremetal_stack() {
  require_bin kubectl
  require_bin helm
  require_bin openssl
  require_bin base64

  ensure_longhorn_installed
  ensure_longhorn_crypto_secret
  ensure_encrypted_storage_class
  ensure_vault_installed "longhorn"
  local root_token
  root_token="$(initialize_and_unseal_vault)"
  configure_vault_for_ton "$root_token"
}

ensure_localdev_stack() {
  require_bin kubectl
  require_bin helm
  require_bin base64

  local base_sc
  local root_token
  base_sc="$(resolve_localdev_storage_class)"
  ensure_localdev_encrypted_storage_class "$base_sc"
  ensure_vault_installed "$base_sc"
  root_token="$(initialize_and_unseal_vault)"

  if ! configure_vault_for_ton "$root_token"; then
    echo "[localdev] Vault configuration failed; reinstalling Vault and reinitializing ..." >&2
    reset_localdev_vault
    ensure_vault_installed "$base_sc"
    root_token="$(initialize_and_unseal_vault)"
    if ! configure_vault_for_ton "$root_token"; then
      echo "Error: Vault configuration is still failing after local recovery." >&2
      exit 1
    fi
  fi
}

ensure_auto_bootstrap_stack() {
  if cluster_is_k3d; then
    ensure_localdev_stack
    return
  fi
  ensure_baremetal_stack
}

vault_runtime_ready() {
  if ! kubectl -n "$VAULT_NAMESPACE" get pod "${VAULT_RELEASE_NAME}-0" >/dev/null 2>&1; then
    return 1
  fi
  kubectl -n "$VAULT_NAMESPACE" wait --for=condition=Ready "pod/${VAULT_RELEASE_NAME}-0" --timeout=5s >/dev/null 2>&1
}

ensure_auto_bootstrap_stack_if_needed() {
  local missing_reasons=()

  if ! kubectl get storageclass "$ENCRYPTED_SC_NAME" >/dev/null 2>&1; then
    missing_reasons+=("StorageClass ${ENCRYPTED_SC_NAME} is missing")
  fi
  if ! kubectl -n "$TON_NAMESPACE" get secret "$TON_VAULT_CREDS_SECRET" >/dev/null 2>&1; then
    missing_reasons+=("secret ${TON_NAMESPACE}/${TON_VAULT_CREDS_SECRET} is missing")
  fi
  if ! vault_runtime_ready; then
    missing_reasons+=("Vault pod ${VAULT_NAMESPACE}/${VAULT_RELEASE_NAME}-0 is not Ready")
  fi

  if (( ${#missing_reasons[@]} == 0 )); then
    echo "[bootstrap] Reusing existing Vault/StorageClass prerequisites."
    return 0
  fi

  printf '[bootstrap] Prerequisites missing/unhealthy, running bootstrap: %s\n' "$(IFS='; '; echo "${missing_reasons[*]}")"
  ensure_auto_bootstrap_stack
}

validate_external_key_prereqs() {
  if is_true "$SKIP_KEY_PREREQ_CHECK"; then
    return
  fi
  if ! kubectl get storageclass "$ENCRYPTED_SC_NAME" >/dev/null 2>&1; then
    echo "Error: missing StorageClass $ENCRYPTED_SC_NAME. Configure cloud/bare-metal prerequisite first." >&2
    exit 1
  fi
  if ! kubectl -n "$TON_NAMESPACE" get secret "$TON_VAULT_CREDS_SECRET" >/dev/null 2>&1; then
    echo "Error: missing secret $TON_VAULT_CREDS_SECRET in namespace $TON_NAMESPACE." >&2
    echo "Configure Vault/KMS prerequisites first or enable AUTO_BAREMETAL_BOOTSTRAP for bare-metal/local k3d." >&2
    exit 1
  fi
}

append_baremetal_key_overrides() {
  local -n target="$1"
  target+=(--set "tonNode.keyManagement.enabled=true")
  target+=(--set-string "tonNode.keyManagement.provider=vault")
  target+=(--set-string "tonNode.keyManagement.credentialsSecretRef=${TON_VAULT_CREDS_SECRET}")
  target+=(--set-string "tonNode.keyManagement.vaultTransitKey=${VAULT_TRANSIT_KEY}")
  target+=(--set-string "tonNode.keyManagement.encryptedBundle.storageClassName=${ENCRYPTED_SC_NAME}")
}

ton_storage_class_name() {
  trim_whitespace "${TON_STORAGE_CLASS_NAME:-local-path}"
}

ton_storage_class_auto() {
  [[ "$(ton_storage_class_name)" == "auto" ]]
}

ensure_ton_storage_class_available() {
  local storage_class

  if ton_storage_class_auto; then
    return 0
  fi

  storage_class="$(ton_storage_class_name)"
  if [[ -z "$storage_class" ]]; then
    echo "Error: TON_STORAGE_CLASS_NAME is empty. Use a local StorageClass name such as local-path, or set TON_STORAGE_CLASS_NAME=auto." >&2
    return 1
  fi

  if kubectl get storageclass "$storage_class" >/dev/null 2>&1; then
    return 0
  fi

  echo "Error: TON data StorageClass '${storage_class}' was not found." >&2
  echo "/var/ton-work/db is stored in the ton-work PVC, so kubeton now requires a local TON StorageClass by default." >&2
  echo "Install/provide a local provisioner, for example local-path, or override:" >&2
  echo "  TON_STORAGE_CLASS_NAME=<your-local-storage-class> ./kubeton start" >&2
  echo "Use TON_STORAGE_CLASS_NAME=auto only if you intentionally want operator auto-detection." >&2
  return 1
}

append_ton_storage_overrides() {
  local -n target="$1"
  local storage_class

  if ton_storage_class_auto; then
    echo "[start] TON storageClassName override disabled (TON_STORAGE_CLASS_NAME=auto); operator will auto-detect storage." >&2
    return 0
  fi

  storage_class="$(ton_storage_class_name)"
  target+=(--set-string "tonNode.storage.storageClassName=${storage_class}")
  echo "[start] Using TON data StorageClass '${storage_class}' for /var/ton-work and /var/ton-work/db." >&2
}

ton_storage_class_requires_sequential_start() {
  local storage_class
  local provisioner

  if ton_storage_class_auto; then
    return 1
  fi

  storage_class="$(ton_storage_class_name)"
  storage_class="$(trim_whitespace "$storage_class")"
  [[ -n "$storage_class" ]] || return 1

  provisioner="$(storage_class_provisioner "$storage_class")"
  provisioner="$(trim_whitespace "$provisioner")"

  [[ "$storage_class" == "local-path" ]] && return 0
  [[ "$provisioner" == "rancher.io/local-path" ]] && return 0
  [[ "$provisioner" == *"local-path"* ]]
}

list_ton_pods() {
  kubectl get pods -A -l "$TON_POD_LABEL" \
    -o jsonpath='{range .items[*]}{.metadata.namespace}{"\t"}{.metadata.name}{"\t"}{.spec.nodeName}{"\n"}{end}'
}

fleet_has_running_ton_pods() {
  local marker

  marker="$(kubectl get pods -A -l "$TON_POD_LABEL" \
    -o jsonpath='{range .items[?(@.status.phase=="Running")]}x{"\n"}{end}' 2>/dev/null || true)"
  [[ -n "$(trim_whitespace "$marker")" ]]
}

list_ton_statefulsets() {
  kubectl get statefulsets -A -l "$TON_POD_LABEL" \
    -o jsonpath='{range .items[*]}{.metadata.namespace}{"\t"}{.metadata.name}{"\t"}{.spec.replicas}{"\n"}{end}'
}

list_node_names() {
  kubectl get nodes -o jsonpath='{range .items[*]}{.metadata.name}{"\n"}{end}' 2>/dev/null \
    | awk 'NF' \
    | sort -u
}

local_path_provisioner_root() {
  local root
  root="$(trim_whitespace "${LOCAL_PATH_PROVISIONER_ROOT:-/opt/local-path-provisioner}")"
  root="${root%/}"
  if [[ -z "$root" || "$root" == "/" || "$root" != /* ]]; then
    echo "Error: invalid LOCAL_PATH_PROVISIONER_ROOT='${LOCAL_PATH_PROVISIONER_ROOT}'." >&2
    return 1
  fi
  printf '%s' "$root"
}

local_path_relative_target() {
  local path="$1"
  local root rel
  root="$(local_path_provisioner_root)" || return 1
  path="$(trim_whitespace "$path")"
  path="${path%/}"
  if [[ -z "$path" || "$path" == "$root" || "$path" != "$root"/* ]]; then
    return 1
  fi
  rel="${path#"$root"/}"
  case "$rel" in
    ""|"."|".."|/*|../*|*/../*|*//*) return 1 ;;
  esac
  printf '%s' "$rel"
}

# Exact PV paths are authoritative for a bound local-path PV.  Unlike the
# optional orphan-pattern fallback below, they do not depend on the configured
# local-path provisioner root: clusters commonly use a custom root.
local_path_absolute_target() {
  local path="$1"

  path="$(trim_whitespace "$path")"
  case "$path" in
    *//*|*$'\t'*|*$'\n'*|*$'\r'*) return 1 ;;
  esac
  path="${path%/}"
  case "$path" in
    ""|/|/..|/../*|*/..|*/../*|/.|/./*|*/.|*/./*) return 1 ;;
  esac
  [[ "$path" == /* ]] || return 1
  printf '%s' "$path"
}

local_path_safe_name_component() {
  [[ "${1:-}" =~ ^[A-Za-z0-9._-]+$ ]]
}

local_path_cleanup_namespaces() {
  local ns phase
  local -a seen=()

  # A privileged host-root cleanup Pod is often rejected in an application
  # namespace by Pod Security admission, while kube-system is allowed.  Keep
  # an explicit choice first, but emit every usable fallback so the caller can
  # retry if creation is denied in the first namespace.
  for ns in "$KUBETON_LOCAL_PATH_CLEANUP_NAMESPACE" kube-system "$TON_NAMESPACE" default; do
    ns="$(trim_whitespace "$ns")"
    [[ -z "$ns" ]] && continue
    if [[ " ${seen[*]} " == *" ${ns} "* ]]; then
      continue
    fi
    seen+=("$ns")
    if ! kubectl get namespace "$ns" >/dev/null 2>&1; then
      continue
    fi
    phase="$(kubectl get namespace "$ns" -o jsonpath='{.status.phase}' 2>/dev/null || true)"
    if [[ "$phase" != "Terminating" ]]; then
      printf '%s\n' "$ns"
    fi
  done
}

local_path_cleanup_namespace() {
  local -a namespaces=()

  mapfile -t namespaces < <(local_path_cleanup_namespaces)
  if [[ ${#namespaces[@]} -gt 0 ]]; then
    printf '%s' "${namespaces[0]}"
    return 0
  fi
  echo "Error: no usable namespace found for local-path cleanup pod." >&2
  return 1
}

local_path_pv_host_path() {
  local pv="$1"
  local path
  if ! path="$(kubectl get pv "$pv" --ignore-not-found -o jsonpath='{.spec.hostPath.path}' 2>/dev/null)"; then
    echo "Error: could not inspect host path for PV ${pv}." >&2
    return 1
  fi
  path="$(trim_whitespace "$path")"
  if [[ -z "$path" ]]; then
    if ! path="$(kubectl get pv "$pv" --ignore-not-found -o jsonpath='{.spec.local.path}' 2>/dev/null)"; then
      echo "Error: could not inspect local path for PV ${pv}." >&2
      return 1
    fi
    path="$(trim_whitespace "$path")"
  fi
  printf '%s' "$path"
}

local_path_pv_matches_claim() {
  local pv="$1"
  local pvc_ref="$2"
  local expected_ns expected_pvc expected_uid actual_ns actual_pvc actual_uid

  IFS=/ read -r expected_ns expected_pvc <<<"$pvc_ref"
  [[ -n "$expected_ns" && -n "$expected_pvc" ]] || return 1
  actual_ns="$(kubectl get pv "$pv" -o jsonpath='{.spec.claimRef.namespace}' 2>/dev/null || true)"
  actual_pvc="$(kubectl get pv "$pv" -o jsonpath='{.spec.claimRef.name}' 2>/dev/null || true)"
  expected_uid="$(kubectl -n "$expected_ns" get pvc "$expected_pvc" -o jsonpath='{.metadata.uid}' 2>/dev/null || true)"
  actual_uid="$(kubectl get pv "$pv" -o jsonpath='{.spec.claimRef.uid}' 2>/dev/null || true)"
  actual_ns="$(trim_whitespace "$actual_ns")"
  actual_pvc="$(trim_whitespace "$actual_pvc")"
  expected_uid="$(trim_whitespace "$expected_uid")"
  actual_uid="$(trim_whitespace "$actual_uid")"
  [[ "$actual_ns" == "$expected_ns" && "$actual_pvc" == "$expected_pvc" ]] || return 1
  [[ -n "$expected_uid" && -n "$actual_uid" && "$actual_uid" == "$expected_uid" ]]
}

local_path_pv_is_provisioned_by_local_path() {
  local pv="$1"
  local storage_class provisioner pv_provisioner

  storage_class="$(kubectl get pv "$pv" -o jsonpath='{.spec.storageClassName}' 2>/dev/null || true)"
  storage_class="$(trim_whitespace "$storage_class")"
  provisioner="$(storage_class_provisioner "$storage_class")"
  pv_provisioner="$(kubectl get pv "$pv" -o jsonpath='{.metadata.annotations.pv\.kubernetes\.io/provisioned-by}' 2>/dev/null || true)"
  pv_provisioner="$(trim_whitespace "$pv_provisioner")"

  [[ "$provisioner" == "rancher.io/local-path" || "$provisioner" == *"local-path"* ]] || return 1
  [[ "$pv_provisioner" == "rancher.io/local-path" || "$pv_provisioner" == *"local-path"* ]]
}

resolve_node_name_for_hostname_value() {
  local hostname_value="$1"
  local node node_rows
  local -a nodes=()
  hostname_value="$(trim_whitespace "$hostname_value")"
  [[ -n "$hostname_value" ]] || return 1

  # This value came from the kubernetes.io/hostname *label* in PV affinity.
  # Do not treat an equal node name as proof: a cluster can legitimately have
  # node foo with hostname label bar while another node has hostname foo.
  # Resolve the label itself and require one exact current owner.
  if ! node_rows="$(kubectl get nodes -l "kubernetes.io/hostname=${hostname_value}" -o jsonpath='{range .items[*]}{.metadata.name}{"\n"}{end}' 2>/dev/null)"; then
    return 1
  fi
  while IFS= read -r node; do
    node="$(trim_whitespace "$node")"
    [[ -n "$node" ]] || continue
    append_unique_item "$node" nodes
  done <<<"$node_rows"
  [[ ${#nodes[@]} -eq 1 ]] || return 1
  printf '%s' "${nodes[0]}"
}

collect_local_path_nodes_for_pv() {
  local pv="$1"
  local -n nodes_ref="$2"
  local node resolved_node affinity_rows affinity_operator affinity_values selected_node
  local term_count=0 term_has_hostname=0 term_invalid=0 affinity_fully_resolved=1
  local affinity_reason=""
  local -a affinity_nodes=()
  local -a term_nodes=()
  local -a affinity_values_array=()

  # nodeSelectorTerms are ORed.  Do not mistake one hostname-constrained term
  # for an ownership proof when another term can match a different node.  A
  # record separator after *every* term lets us require each alternative to
  # resolve to the same exact hostname owner.  When that cannot be proven,
  # Rancher's selected-node annotation below is the only acceptable fallback.
  if ! affinity_rows="$(kubectl get pv "$pv" --ignore-not-found \
    -o jsonpath='{range .spec.nodeAffinity.required.nodeSelectorTerms[*]}{range .matchExpressions[?(@.key=="kubernetes.io/hostname")]}{.operator}{"\t"}{range .values[*]}{.}{"|"}{end}{"\n"}{end}{"__KUBETON_TERM_END__\n"}{end}' 2>/dev/null)"; then
    echo "Error: could not inspect node affinity for local-path PV ${pv}." >&2
    return 1
  fi
  while IFS=$'\t' read -r affinity_operator affinity_values; do
    affinity_operator="$(trim_whitespace "$affinity_operator")"
    affinity_values="$(trim_whitespace "$affinity_values")"
    if [[ "$affinity_operator" == "__KUBETON_TERM_END__" && -z "$affinity_values" ]]; then
      ((term_count+=1))
      if (( term_has_hostname == 0 || term_invalid != 0 || ${#term_nodes[@]} != 1 )); then
        affinity_fully_resolved=0
      else
        append_unique_item "${term_nodes[0]}" affinity_nodes
      fi
      term_has_hostname=0
      term_invalid=0
      term_nodes=()
      continue
    fi
    [[ -n "$affinity_operator" || -n "$affinity_values" ]] || continue
    term_has_hostname=1
    if [[ "$affinity_operator" != "In" ]]; then
      term_invalid=1
      affinity_reason="hostname affinity uses unsupported operator ${affinity_operator:-unknown}"
      continue
    fi
    IFS='|' read -r -a affinity_values_array <<<"$affinity_values"
    if [[ ${#affinity_values_array[@]} -eq 0 ]]; then
      term_invalid=1
      affinity_reason="hostname affinity has no node value"
      continue
    fi
    for node in "${affinity_values_array[@]}"; do
      node="$(trim_whitespace "$node")"
      if [[ -z "$node" ]]; then
        term_invalid=1
        affinity_reason="hostname affinity has an empty node value"
        continue
      fi
      resolved_node="$(resolve_node_name_for_hostname_value "$node" || true)"
      resolved_node="$(trim_whitespace "$resolved_node")"
      if [[ -z "$resolved_node" ]]; then
        term_invalid=1
        affinity_reason="hostname affinity value ${node} does not resolve to exactly one live node"
        continue
      fi
      append_unique_item "$resolved_node" term_nodes
    done
  done <<<"$affinity_rows"

  if (( term_count == 0 || ${#affinity_nodes[@]} != 1 )); then
    affinity_fully_resolved=0
  fi

  # Rancher local-path writes the provisioning node as a PV annotation.  It is
  # the authoritative fallback for older hostPath PVs that lack nodeAffinity
  # and for installations configured with a non-hostname nodeAffinityKey.
  if ! selected_node="$(kubectl get pv "$pv" --ignore-not-found \
    -o jsonpath='{.metadata.annotations.local\.path\.provisioner/selected-node}' 2>/dev/null)"; then
    echo "Error: could not inspect selected-node provenance for local-path PV ${pv}." >&2
    return 1
  fi
  selected_node="$(trim_whitespace "$selected_node")"
  if [[ -n "$selected_node" ]]; then
    if ! [[ "$selected_node" =~ ^[a-z0-9]([a-z0-9.-]*[a-z0-9])?$ && ${#selected_node} -le 253 ]]; then
      echo "Error: refusing local-path host cleanup for PV ${pv}: its selected-node annotation is invalid." >&2
      return 1
    fi
    if ! kubectl get node "$selected_node" >/dev/null 2>&1; then
      echo "Error: refusing local-path host cleanup for PV ${pv}: selected-node ${selected_node} is no longer a live Kubernetes node." >&2
      return 1
    fi
    if (( affinity_fully_resolved == 1 )) && [[ "${affinity_nodes[0]}" != "$selected_node" ]]; then
      echo "Error: refusing local-path host cleanup for PV ${pv}: node affinity and selected-node provenance disagree." >&2
      return 1
    fi
    append_unique_item "$selected_node" nodes_ref
  elif (( affinity_fully_resolved == 1 )); then
    append_unique_item "${affinity_nodes[0]}" nodes_ref
  else
    echo "Error: refusing local-path host cleanup for PV ${pv}: node affinity does not uniquely resolve every selector term${affinity_reason:+ (${affinity_reason})}, and Rancher selected-node provenance is unavailable." >&2
    return 1
  fi

  [[ ${#nodes_ref[@]} -eq 1 ]]
}

append_local_path_exact_cleanup_rows_for_pv() {
  local pv="$1"
  local pvc_ref="$2"
  local -n rows_ref="$3"
  local path node pv_uid pvc_uid pvc_ns pvc_name
  local -a nodes=()

  is_true "$KUBETON_LOCAL_PATH_CLEANUP" || return 0
  [[ -n "$pv" ]] || return 0

  if ! path="$(local_path_pv_host_path "$pv")"; then
    echo "Error: refusing local-path cleanup for PV ${pv}: its host path could not be inspected." >&2
    return 1
  fi
  # Non-hostPath PVs (for example Longhorn CSI) are handled by their own
  # deletion path and never become host cleanup targets.
  [[ -n "$path" ]] || return 0

  if ! local_path_pv_matches_claim "$pv" "$pvc_ref"; then
    echo "Error: refusing local-path cleanup for PV ${pv}: its claimRef does not match ${pvc_ref}." >&2
    return 1
  fi
  if ! local_path_pv_is_provisioned_by_local_path "$pv"; then
    echo "Error: refusing host cleanup for PV ${pv}: it has hostPath data but is not a verified local-path PV." >&2
    return 1
  fi

  path="$(local_path_absolute_target "$path" 2>/dev/null || true)"
  if [[ -z "$path" ]]; then
    echo "Error: refusing unsafe local-path cleanup target reported by PV ${pv}." >&2
    return 1
  fi

  if ! collect_local_path_nodes_for_pv "$pv" nodes; then
    # The PV, claim, provisioner, and host path were all verified above; only
    # its owner node is unresolved. Callers that are explicitly tearing down
    # TON may retain the UID-bound record and force-remove the unmounted PVC
    # object, but must never host-clean this path.
    return 2
  fi
  if [[ ${#nodes[@]} -ne 1 ]]; then
    echo "Error: refusing local-path host cleanup for PV ${pv}: exactly one owning node is required." >&2
    return 2
  fi
  IFS=/ read -r pvc_ns pvc_name <<<"$pvc_ref"
  pv_uid="$(kubectl get pv "$pv" -o jsonpath='{.metadata.uid}' 2>/dev/null || true)"
  pvc_uid="$(kubectl -n "$pvc_ns" get pvc "$pvc_name" -o jsonpath='{.metadata.uid}' 2>/dev/null || true)"
  pv_uid="$(trim_whitespace "$pv_uid")"
  pvc_uid="$(trim_whitespace "$pvc_uid")"
  if [[ -z "$pv_uid" || -z "$pvc_uid" ]]; then
    echo "Error: refusing local-path cleanup for PV ${pv}: missing PV or PVC identity." >&2
    return 1
  fi
  for node in "${nodes[@]}"; do
    node="$(trim_whitespace "$node")"
    [[ -z "$node" ]] && continue
    append_unique_item "$node"$'\t'"$path"$'\t'"$pv"$'\t'"$pvc_ref"$'\t'"$pv_uid"$'\t'"$pvc_uid" rows_ref
  done
}

# Record every bound PV, not only a local-path PV.  Kubernetes objects can be
# removed between uninstall attempts, so the UID-bound record is what lets a
# retry safely finish an encrypted/CSI volume without guessing from a PVC
# name.  Local-path PVs additionally get an exact host-path target above.
append_pv_cleanup_ledger_row_for_pv() {
  local pv="$1"
  local pvc_ref="$2"
  local -n rows_ref="$3"
  local pvc_ns pvc_name pv_identity pv_uid claim_ns claim_name claim_uid pvc_uid reclaim_policy csi_driver volume_handle longhorn_ns longhorn_uid

  [[ -n "$pv" && -n "$pvc_ref" ]] || return 1
  IFS=/ read -r pvc_ns pvc_name <<<"$pvc_ref"
  [[ -n "$pvc_ns" && -n "$pvc_name" ]] || return 1

  if ! pv_identity="$(kubectl get pv "$pv" --ignore-not-found \
    -o jsonpath='{.metadata.uid}{"\t"}{.spec.claimRef.namespace}{"\t"}{.spec.claimRef.name}{"\t"}{.spec.claimRef.uid}{"\t"}{.spec.persistentVolumeReclaimPolicy}{"\t"}{.spec.csi.driver}{"\t"}{.spec.csi.volumeHandle}' 2>/dev/null)"; then
    echo "Error: could not inspect PV ${pv} before recording cleanup state." >&2
    return 1
  fi
  IFS=$'\t' read -r pv_uid claim_ns claim_name claim_uid reclaim_policy csi_driver volume_handle <<<"$pv_identity"
  pv_uid="$(trim_whitespace "$pv_uid")"
  claim_ns="$(trim_whitespace "$claim_ns")"
  claim_name="$(trim_whitespace "$claim_name")"
  claim_uid="$(trim_whitespace "$claim_uid")"
  reclaim_policy="$(trim_whitespace "$reclaim_policy")"
  csi_driver="$(trim_whitespace "$csi_driver")"
  volume_handle="$(trim_whitespace "$volume_handle")"
  if [[ -z "$pv_uid" || -z "$reclaim_policy" ]]; then
    echo "Error: bound PV ${pv} disappeared before cleanup state could be recorded." >&2
    return 1
  fi
  if ! pvc_uid="$(kubectl -n "$pvc_ns" get pvc "$pvc_name" --ignore-not-found -o jsonpath='{.metadata.uid}' 2>/dev/null)"; then
    echo "Error: could not inspect PVC ${pvc_ref} before recording cleanup state." >&2
    return 1
  fi
  pvc_uid="$(trim_whitespace "$pvc_uid")"
  if [[ -z "$pvc_uid" || "$claim_ns" != "$pvc_ns" || "$claim_name" != "$pvc_name" || "$claim_uid" != "$pvc_uid" ]]; then
    echo "Error: refusing to record PV ${pv}: its claimRef does not match PVC ${pvc_ref}." >&2
    return 1
  fi

  longhorn_uid=""
  # A Longhorn CSI volume is identified by its CSI volumeHandle, not by the
  # Kubernetes PV name.  Store that immutable mapping and the Volume UID so a
  # later retry cannot delete a different Longhorn volume that reused a name.
  if [[ "$csi_driver" == "driver.longhorn.io" ]]; then
    if [[ -z "$volume_handle" ]]; then
      echo "Error: refusing to record Longhorn PV ${pv} without a CSI volume handle." >&2
      return 1
    fi
    if ! longhorn_ns="$(kubectl get namespace "$LONGHORN_NAMESPACE" --ignore-not-found -o jsonpath='{.metadata.uid}' 2>/dev/null)"; then
      echo "Error: could not inspect Longhorn namespace ${LONGHORN_NAMESPACE} before recording PV ${pv}." >&2
      return 1
    fi
    longhorn_ns="$(trim_whitespace "$longhorn_ns")"
    if [[ -n "$longhorn_ns" ]]; then
      if ! longhorn_uid="$(kubectl -n "$LONGHORN_NAMESPACE" get volumes.longhorn.io "$volume_handle" --ignore-not-found -o jsonpath='{.metadata.uid}' 2>/dev/null)"; then
        echo "Error: could not inspect Longhorn volume ${volume_handle} before recording cleanup state." >&2
        return 1
      fi
      longhorn_uid="$(trim_whitespace "$longhorn_uid")"
    fi
  fi

  if [[ "$pv$pvc_ref$pv_uid$pvc_uid$reclaim_policy$csi_driver$volume_handle$longhorn_uid" == *$'\t'* || "$pv$pvc_ref$pv_uid$pvc_uid$reclaim_policy$csi_driver$volume_handle$longhorn_uid" == *$'\n'* ]]; then
    echo "Error: refusing to record an unsafe PV cleanup ledger field for ${pv}." >&2
    return 1
  fi
  append_unique_item "$pv"$'\t'"$pvc_ref"$'\t'"$pv_uid"$'\t'"$pvc_uid"$'\t'"$reclaim_policy"$'\t'"$csi_driver"$'\t'"$volume_handle"$'\t'"$longhorn_uid" rows_ref
}

local_path_pattern_cleanup_enabled() {
  is_true "$KUBETON_LOCAL_PATH_PATTERN_CLEANUP"
}

collect_local_path_pattern_cleanup_rows_for_pvcs() {
  local -n pvc_rows_ref="$1"
  local -n rows_ref="$2"
  local row ns pvc node
  local -a nodes=()

  is_true "$KUBETON_LOCAL_PATH_CLEANUP" || return 0
  local_path_pattern_cleanup_enabled || return 0
  mapfile -t nodes < <(list_node_names)
  [[ ${#nodes[@]} -gt 0 ]] || return 0

  for row in "${pvc_rows_ref[@]}"; do
    [[ -z "$row" ]] && continue
    IFS=$'\t' read -r ns pvc <<<"$row"
    ns="$(trim_whitespace "$ns")"
    pvc="$(trim_whitespace "$pvc")"
    [[ -z "$ns" || -z "$pvc" ]] && continue
    local_path_safe_name_component "$ns" || continue
    local_path_safe_name_component "$pvc" || continue
    for node in "${nodes[@]}"; do
      node="$(trim_whitespace "$node")"
      [[ -z "$node" ]] && continue
      append_unique_item "$node"$'\t'"$ns"$'\t'"$pvc" rows_ref
    done
  done
}

build_local_path_cleanup_script() {
  local node="$1"
  local root="$2"
  local exact_rows_name="$3"
  local pattern_rows_name="$4"
  local -n exact_rows_ref="$exact_rows_name"
  local -n pattern_rows_ref="$pattern_rows_name"
  local row row_node path pv pvc_ref ns pvc pattern
  local emitted=0

  {
    printf 'set -eu\n'
    printf 'host_root=/host\n'
    printf 'root=%s\n' "$(shell_quote "/host${root}")"
    printf 'remaining=0\n'
    printf 'rm_errors="/tmp/kubeton-local-path-rm.err"\n'
    printf 'remove_path_if_present() {\n'
    printf '  target="$1"\n'
    printf '  label="$2"\n'
    printf '  [ -e "$target" ] || return 0\n'
    printf '  echo "[cleanup] Removing local-path PV directory: ${label}"\n'
    printf '  : > "$rm_errors"\n'
    printf '  rm -rf -- "$target" 2>"$rm_errors" || true\n'
    printf '  if [ -e "$target" ]; then\n'
    printf '    echo "Error: local-path PV directory still exists: ${label}" >&2\n'
    printf '    if [ -s "$rm_errors" ]; then cat "$rm_errors" >&2; fi\n'
    printf '    remaining=1\n'
    printf '  fi\n'
    printf '  rm -f "$rm_errors" >/dev/null 2>&1 || true\n'
    printf '}\n'
    printf 'remove_pattern_matches() {\n'
    printf '  pattern="$1"\n'
    printf '  label="$2"\n'
    printf '  if [ ! -d "$root" ]; then\n'
    printf '    echo "Error: local-path provisioner root is unavailable: ${root}" >&2\n'
    printf '    remaining=1\n'
    printf '    return 0\n'
    printf '  fi\n'
    printf '  : > "$rm_errors"\n'
    printf '  find "$root" -mindepth 1 -maxdepth 1 -type d -name "$pattern" -exec rm -rf -- {} + 2>"$rm_errors" || true\n'
    printf '  if [ -n "$(find "$root" -mindepth 1 -maxdepth 1 -type d -name "$pattern" -print -quit)" ]; then\n'
    printf '    echo "Error: local-path directory matching ${label} still exists" >&2\n'
    printf '    if [ -s "$rm_errors" ]; then cat "$rm_errors" >&2; fi\n'
    printf '    remaining=1\n'
    printf '  fi\n'
    printf '  rm -f "$rm_errors" >/dev/null 2>&1 || true\n'
    printf '}\n'

    for row in "${exact_rows_ref[@]}"; do
      [[ -z "$row" ]] && continue
      IFS=$'\t' read -r row_node path pv pvc_ref <<<"$row"
      [[ "$row_node" == "$node" ]] || continue
      path="$(local_path_absolute_target "$path" 2>/dev/null || true)"
      [[ -n "$path" ]] || continue
      printf 'target="$host_root"%s\n' "$(shell_quote "$path")"
      printf 'remove_path_if_present "$target" "${target#$host_root/}"\n'
      emitted=1
    done

    for row in "${pattern_rows_ref[@]}"; do
      [[ -z "$row" ]] && continue
      IFS=$'\t' read -r row_node ns pvc <<<"$row"
      [[ "$row_node" == "$node" ]] || continue
      local_path_safe_name_component "$ns" || continue
      local_path_safe_name_component "$pvc" || continue
      pattern="*_${ns}_${pvc}"
      printf 'remove_pattern_matches %s %s\n' "$(shell_quote "$pattern")" "$(shell_quote "$pattern")"
      emitted=1
    done

    printf 'exit "$remaining"\n'
  } || return 1

  (( emitted == 1 ))
}

wait_local_path_cleanup_pod_done() {
  local ns="$1"
  local pod="$2"
  local timeout_seconds="$3"
  local deadline=$(( $(date +%s) + timeout_seconds ))
  local phase

  while (( $(date +%s) < deadline )); do
    phase="$(kubectl -n "$ns" get pod "$pod" -o jsonpath='{.status.phase}' 2>/dev/null || true)"
    case "$phase" in
      Succeeded)
        return 0
        ;;
      Failed)
        echo "Error: local-path cleanup pod ${ns}/${pod} failed." >&2
        kubectl -n "$ns" logs "$pod" >&2 || true
        return 1
        ;;
    esac
    sleep 2
  done

  echo "Error: timeout waiting for local-path cleanup pod ${ns}/${pod}." >&2
  kubectl -n "$ns" logs "$pod" >&2 || true
  return 1
}

run_local_path_cleanup_pod_for_node() {
  local cleanup_ns="$1"
  local node="$2"
  local root="$3"
  local label="$4"
  local exact_rows_name="$5"
  local pattern_rows_name="$6"
  local script pod node_fragment timeout_seconds rc=0

  script="$(build_local_path_cleanup_script "$node" "$root" "$exact_rows_name" "$pattern_rows_name")" || return 0
  node_fragment="$(sanitize_k8s_name_fragment "$node")"
  node_fragment="${node_fragment:0:32}"
  [[ -z "$node_fragment" ]] && node_fragment="node"
  pod="kubeton-lpp-clean-${node_fragment}-${RANDOM}-${RANDOM}"
  timeout_seconds="$(trim_whitespace "${KUBETON_LOCAL_PATH_CLEANUP_TIMEOUT_SECONDS:-180}")"
  if ! [[ "$timeout_seconds" =~ ^[0-9]+$ ]] || (( timeout_seconds < 30 )); then
    timeout_seconds=180
  fi

  if [[ -n "$root" ]]; then
    echo "[${label}] Purging local-path data on node ${node} under ${root} ..."
  else
    echo "[${label}] Purging exact local-path PV data on node ${node} ..."
  fi
  if ! cat <<EOF | kubectl -n "$cleanup_ns" apply -f - >/dev/null; then
apiVersion: v1
kind: Pod
metadata:
  name: ${pod}
  labels:
    app.kubernetes.io/name: kubeton-local-path-cleanup
    app.kubernetes.io/managed-by: kubeton
spec:
  restartPolicy: Never
  nodeName: $(yaml_quote "$node")
  tolerations:
    - operator: Exists
  containers:
    - name: cleanup
      image: ${KUBETON_LOCAL_PATH_CLEANUP_IMAGE}
      imagePullPolicy: IfNotPresent
      command:
        - /bin/sh
        - -ec
      args:
        - |
$(printf '%s\n' "$script" | sed 's/^/          /')
      securityContext:
        privileged: true
        runAsUser: 0
        allowPrivilegeEscalation: true
      volumeMounts:
        - name: host-root
          mountPath: /host
  volumes:
    - name: host-root
      hostPath:
        path: /
        type: Directory
EOF
    echo "Warning: could not create local-path cleanup pod ${cleanup_ns}/${pod}." >&2
    kubectl -n "$cleanup_ns" delete pod "$pod" --ignore-not-found --wait=false >/dev/null 2>&1 || true
    return 1
  fi

  if ! wait_local_path_cleanup_pod_done "$cleanup_ns" "$pod" "$timeout_seconds"; then
    rc=1
  fi
  kubectl -n "$cleanup_ns" delete pod "$pod" --ignore-not-found --wait=false >/dev/null 2>&1 || true
  return "$rc"
}

run_local_path_cleanup_pod_for_node_with_fallback() {
  local namespaces_name="$1"
  local node="$2"
  local root="$3"
  local label="$4"
  local exact_rows_name="$5"
  local pattern_rows_name="$6"
  local -n namespaces_ref="$namespaces_name"
  local cleanup_ns

  for cleanup_ns in "${namespaces_ref[@]}"; do
    if run_local_path_cleanup_pod_for_node "$cleanup_ns" "$node" "$root" "$label" "$exact_rows_name" "$pattern_rows_name"; then
      return 0
    fi
    echo "Warning: local-path ${label} cleanup could not run in namespace ${cleanup_ns}; trying another eligible namespace." >&2
  done
  return 1
}

cleanup_local_path_provisioner_data() {
  local exact_rows_name="$1"
  local pattern_rows_name="$2"
  local label="${3:-cleanup}"
  local -n exact_rows_ref="$exact_rows_name"
  local -n pattern_rows_ref="$pattern_rows_name"
  local root row node rc=0
  local -a nodes=()
  local -a cleanup_namespaces=()
  local -a cleanup_pids=()
  local -a cleanup_nodes=()
  local i

  is_true "$KUBETON_LOCAL_PATH_CLEANUP" || return 0
  if [[ ${#exact_rows_ref[@]} -eq 0 && ${#pattern_rows_ref[@]} -eq 0 ]]; then
    return 0
  fi

  # Exact PV targets come from the bound PV itself and may live under a custom
  # local-path root.  The configured root is needed only for optional wildcard
  # orphan cleanup.
  root=""
  if [[ ${#pattern_rows_ref[@]} -gt 0 ]]; then
    root="$(local_path_provisioner_root)" || return 1
  fi
  mapfile -t cleanup_namespaces < <(local_path_cleanup_namespaces)
  if [[ ${#cleanup_namespaces[@]} -eq 0 ]]; then
    echo "Error: no usable namespace found for local-path cleanup pod." >&2
    return 1
  fi

  for row in "${exact_rows_ref[@]}"; do
    [[ -z "$row" ]] && continue
    IFS=$'\t' read -r node _ <<<"$row"
    node="$(trim_whitespace "$node")"
    [[ -z "$node" ]] && continue
    append_unique_item "$node" nodes
  done
  for row in "${pattern_rows_ref[@]}"; do
    [[ -z "$row" ]] && continue
    IFS=$'\t' read -r node _ <<<"$row"
    node="$(trim_whitespace "$node")"
    [[ -z "$node" ]] && continue
    append_unique_item "$node" nodes
  done

  for node in "${nodes[@]}"; do
    [[ -z "$node" ]] && continue
    run_local_path_cleanup_pod_for_node_with_fallback cleanup_namespaces "$node" "$root" "$label" "$exact_rows_name" "$pattern_rows_name" &
    cleanup_pids+=("$!")
    cleanup_nodes+=("$node")
  done

  for i in "${!cleanup_pids[@]}"; do
    if ! wait "${cleanup_pids[$i]}"; then
      echo "Warning: local-path ${label} cleanup failed on node ${cleanup_nodes[$i]}." >&2
      rc=1
    fi
  done
  return "$rc"
}

# PVC/PV objects can disappear before a host cleanup pod gets a chance to run.
# Persist the exact, verified host paths first, so a later `kubeton uninstall`
# can finish the cleanup without guessing from a broad directory pattern.
local_path_cleanup_ledger_id() {
  local raw base primary_hash secondary_hash

  raw="${RELEASE_NAME}-${TON_NAMESPACE}"
  base="$(sanitize_k8s_name_fragment "$raw")"
  # cksum is part of POSIX userlands, unlike sha256sum. Use two independent
  # deterministic inputs so every host computes the same, collision-resistant
  # ledger identity without a runtime tool dependency.
  primary_hash="$(printf '%s' "$raw" | cksum | awk '{print $1}')"
  secondary_hash="$(printf '%s:%s' "$raw" "${#raw}" | cksum | awk '{print $1}')"
  printf '%s-%s-%s' "${base:0:8}" "$primary_hash" "$secondary_hash"
}

local_path_cleanup_ledger_name() {
  local name
  name="$(trim_whitespace "${KUBETON_LOCAL_PATH_CLEANUP_LEDGER_NAME:-}")"
  if [[ -n "$name" ]]; then
    if ! [[ "$name" =~ ^[a-z0-9]([a-z0-9.-]*[a-z0-9])?$ ]]; then
      echo "Error: invalid KUBETON_LOCAL_PATH_CLEANUP_LEDGER_NAME='${KUBETON_LOCAL_PATH_CLEANUP_LEDGER_NAME}'." >&2
      return 1
    fi
    if (( ${#name} > 63 )); then
      echo "Error: KUBETON_LOCAL_PATH_CLEANUP_LEDGER_NAME must be at most 63 characters." >&2
      return 1
    fi
    printf '%s' "$name"
    return 0
  fi
  printf 'kubeton-local-path-cleanup-%s' "$(local_path_cleanup_ledger_id)"
}

local_path_cleanup_ledger_namespace() {
  local configured ns phase

  configured="$(trim_whitespace "${KUBETON_LOCAL_PATH_CLEANUP_LEDGER_NAMESPACE:-}")"
  if [[ -n "$configured" ]]; then
    case "$configured" in
      "$OP_NAMESPACE"|"$VAULT_NAMESPACE"|"$LONGHORN_NAMESPACE")
        echo "Error: KUBETON_LOCAL_PATH_CLEANUP_LEDGER_NAMESPACE=${configured} is deleted by kubeton uninstall and cannot retain cleanup state." >&2
        return 1
        ;;
    esac
    if ! kubectl get namespace "$configured" >/dev/null 2>&1; then
      echo "Error: cleanup-ledger namespace ${configured} does not exist." >&2
      return 1
    fi
    phase="$(kubectl get namespace "$configured" -o jsonpath='{.status.phase}' 2>/dev/null || true)"
    if [[ "$phase" == "Terminating" ]]; then
      echo "Error: cleanup-ledger namespace ${configured} is terminating." >&2
      return 1
    fi
    printf '%s' "$configured"
    return 0
  fi

  # This ConfigMap is an authorization boundary for a privileged host cleanup
  # pod. Keep it in kube-system by default rather than an application
  # namespace where a workload may be able to write arbitrary ConfigMaps.
  for ns in kube-system; do
    case "$ns" in
      "$OP_NAMESPACE"|"$VAULT_NAMESPACE"|"$LONGHORN_NAMESPACE") continue ;;
    esac
    kubectl get namespace "$ns" >/dev/null 2>&1 || continue
    phase="$(kubectl get namespace "$ns" -o jsonpath='{.status.phase}' 2>/dev/null || true)"
    [[ "$phase" == "Terminating" ]] && continue
    printf '%s' "$ns"
    return 0
  done

  echo "Error: no durable protected namespace is available for the local-path cleanup ledger. Set KUBETON_LOCAL_PATH_CLEANUP_LEDGER_NAMESPACE to an existing admin-only namespace that kubeton uninstall does not delete." >&2
  return 1
}

list_local_path_cleanup_ledger_locations() {
  local ns name found purpose ledger_id found_ledger_id

  ns="$(local_path_cleanup_ledger_namespace)" || return 1
  name="$(local_path_cleanup_ledger_name)" || return 1
  if ! found="$(kubectl -n "$ns" get configmap "$name" --ignore-not-found -o jsonpath='{.metadata.name}' 2>/dev/null)"; then
    echo "Error: could not inspect local-path cleanup ledger ${ns}/${name}." >&2
    return 1
  fi
  found="$(trim_whitespace "$found")"
  [[ -n "$found" ]] || return 0
  purpose="$(kubectl -n "$ns" get configmap "$name" -o jsonpath='{.metadata.labels.app\.kubernetes\.io/name}' 2>/dev/null || true)"
  found_ledger_id="$(kubectl -n "$ns" get configmap "$name" -o jsonpath='{.metadata.labels.ton\.ton\.org/kubeton-storage-cleanup}' 2>/dev/null || true)"
  ledger_id="$(local_path_cleanup_ledger_id)"
  if [[ "$purpose" != "kubeton-local-path-cleanup-ledger" || "$found_ledger_id" != "$ledger_id" ]]; then
    echo "Error: refusing to use ConfigMap ${ns}/${name} as a local-path cleanup ledger because its ownership labels do not match." >&2
    return 1
  fi
  printf '%s\t%s\n' "$ns" "$name"
}

collect_local_path_cleanup_ledger_rows() {
  local -n rows_ref="$1"
  local ns name contents row node path pv pvc_ref pv_uid pvc_uid extra locations

  locations="$(list_local_path_cleanup_ledger_locations)" || return 1
  [[ -n "$locations" ]] || return 0
  while IFS=$'\t' read -r ns name; do
    ns="$(trim_whitespace "$ns")"
    name="$(trim_whitespace "$name")"
    [[ -n "$ns" && -n "$name" ]] || continue
    if ! contents="$(kubectl -n "$ns" get configmap "$name" -o jsonpath='{.data.targets}' 2>/dev/null)"; then
      echo "Error: could not read local-path cleanup ledger ${ns}/${name}." >&2
      return 1
    fi
    while IFS= read -r row; do
      [[ -n "$row" ]] || continue
      IFS=$'\t' read -r node path pv pvc_ref pv_uid pvc_uid extra <<<"$row"
      node="$(trim_whitespace "$node")"
      path="$(local_path_absolute_target "$path" 2>/dev/null || true)"
      pv="$(trim_whitespace "$pv")"
      pvc_ref="$(trim_whitespace "$pvc_ref")"
      pv_uid="$(trim_whitespace "$pv_uid")"
      pvc_uid="$(trim_whitespace "$pvc_uid")"
      if [[ -n "$extra" || -z "$node" || -z "$path" || -z "$pv" || -z "$pvc_ref" || -z "$pv_uid" || -z "$pvc_uid" ]]; then
        echo "Error: local-path cleanup ledger ${ns}/${name} contains an invalid target record." >&2
        return 1
      fi
      append_unique_item "$node"$'\t'"$path"$'\t'"$pv"$'\t'"$pvc_ref"$'\t'"$pv_uid"$'\t'"$pvc_uid" rows_ref
    done <<<"$contents"
  done <<<"$locations"
}

# `pv-targets` tracks every backed PVC, including CSI volumes with no host
# path. It is deliberately a separate ConfigMap key so existing targets-only
# ledgers remain readable across upgrades.
collect_pv_cleanup_ledger_rows() {
  local -n rows_ref="$1"
  local ns name contents row pv pvc_ref pv_uid pvc_uid reclaim_policy csi_driver volume_handle longhorn_uid extra locations

  locations="$(list_local_path_cleanup_ledger_locations)" || return 1
  [[ -n "$locations" ]] || return 0
  while IFS=$'\t' read -r ns name; do
    ns="$(trim_whitespace "$ns")"
    name="$(trim_whitespace "$name")"
    [[ -n "$ns" && -n "$name" ]] || continue
    if ! contents="$(kubectl -n "$ns" get configmap "$name" -o jsonpath='{.data.pv-targets}' 2>/dev/null)"; then
      echo "Error: could not read PV cleanup targets from ledger ${ns}/${name}." >&2
      return 1
    fi
    while IFS= read -r row; do
      [[ -n "$row" ]] || continue
      IFS=$'\t' read -r pv pvc_ref pv_uid pvc_uid reclaim_policy csi_driver volume_handle longhorn_uid extra <<<"$row"
      pv="$(trim_whitespace "$pv")"
      pvc_ref="$(trim_whitespace "$pvc_ref")"
      pv_uid="$(trim_whitespace "$pv_uid")"
      pvc_uid="$(trim_whitespace "$pvc_uid")"
      reclaim_policy="$(trim_whitespace "$reclaim_policy")"
      csi_driver="$(trim_whitespace "$csi_driver")"
      volume_handle="$(trim_whitespace "$volume_handle")"
      longhorn_uid="$(trim_whitespace "$longhorn_uid")"
      if [[ -n "$extra" || -z "$pv" || -z "$pvc_ref" || -z "$pv_uid" || -z "$pvc_uid" || -z "$reclaim_policy" ]]; then
        echo "Error: local-path cleanup ledger ${ns}/${name} contains an invalid PV target record." >&2
        return 1
      fi
      if [[ "$csi_driver" == "driver.longhorn.io" && -z "$volume_handle" ]]; then
        echo "Error: local-path cleanup ledger ${ns}/${name} has a Longhorn PV target without a volume handle." >&2
        return 1
      fi
      append_unique_item "$pv"$'\t'"$pvc_ref"$'\t'"$pv_uid"$'\t'"$pvc_uid"$'\t'"$reclaim_policy"$'\t'"$csi_driver"$'\t'"$volume_handle"$'\t'"$longhorn_uid" rows_ref
    done <<<"$contents"
  done <<<"$locations"
}

storage_cleanup_ledger_has_pending_longhorn_targets() {
  local -a pv_rows=()
  local row pv pvc_ref pv_uid pvc_uid reclaim_policy csi_driver volume_handle longhorn_uid

  collect_pv_cleanup_ledger_rows pv_rows || return 2
  for row in "${pv_rows[@]}"; do
    [[ -n "$row" ]] || continue
    IFS=$'\t' read -r pv pvc_ref pv_uid pvc_uid reclaim_policy csi_driver volume_handle longhorn_uid <<<"$row"
    [[ "$csi_driver" == "driver.longhorn.io" ]] && return 0
  done
  return 1
}

record_local_path_cleanup_ledger() {
  local exact_rows_name="$1"
  local pv_rows_name="${2:-}"
  local -n exact_rows_ref="$exact_rows_name"
  local -a ledger_rows=()
  local -a pv_ledger_rows=()
  local row ledger_ns ledger_name targets_file pv_targets_file ledger_id existing_name existing_purpose existing_id

  collect_local_path_cleanup_ledger_rows ledger_rows || return 1
  collect_pv_cleanup_ledger_rows pv_ledger_rows || return 1
  for row in "${exact_rows_ref[@]}"; do
    [[ -n "$row" ]] && append_unique_item "$row" ledger_rows
  done
  if [[ -n "$pv_rows_name" ]]; then
    local -n requested_pv_rows_ref="$pv_rows_name"
    for row in "${requested_pv_rows_ref[@]}"; do
      [[ -n "$row" ]] && append_unique_item "$row" pv_ledger_rows
    done
  fi
  [[ ${#ledger_rows[@]} -gt 0 || ${#pv_ledger_rows[@]} -gt 0 ]] || return 0

  ledger_ns="$(local_path_cleanup_ledger_namespace)" || return 1
  ledger_name="$(local_path_cleanup_ledger_name)" || return 1
  ledger_id="$(local_path_cleanup_ledger_id)"

  targets_file="$(mktemp "${TMPDIR:-/tmp}/kubeton-local-path-ledger-targets.XXXXXX")" || return 1
  pv_targets_file="$(mktemp "${TMPDIR:-/tmp}/kubeton-local-path-ledger-pvs.XXXXXX")" || {
    rm -f "$targets_file"
    return 1
  }
  printf '%s\n' "${ledger_rows[@]}" >"$targets_file"
  printf '%s\n' "${pv_ledger_rows[@]}" >"$pv_targets_file"
  if ! existing_name="$(kubectl -n "$ledger_ns" get configmap "$ledger_name" --ignore-not-found -o jsonpath='{.metadata.name}' 2>/dev/null)"; then
    rm -f "$targets_file" "$pv_targets_file"
    echo "Error: could not inspect local-path cleanup ledger ${ledger_ns}/${ledger_name}; leaving PVCs intact." >&2
    return 1
  fi
  existing_name="$(trim_whitespace "$existing_name")"
  if [[ -n "$existing_name" ]]; then
    existing_purpose="$(kubectl -n "$ledger_ns" get configmap "$ledger_name" -o jsonpath='{.metadata.labels.app\.kubernetes\.io/name}' 2>/dev/null || true)"
    existing_id="$(kubectl -n "$ledger_ns" get configmap "$ledger_name" -o jsonpath='{.metadata.labels.ton\.ton\.org/kubeton-storage-cleanup}' 2>/dev/null || true)"
    if [[ "$existing_purpose" != "kubeton-local-path-cleanup-ledger" || "$existing_id" != "$ledger_id" ]]; then
      rm -f "$targets_file" "$pv_targets_file"
      echo "Error: refusing to overwrite non-kubeton ConfigMap ${ledger_ns}/${ledger_name} with cleanup state." >&2
      return 1
    fi
  elif kubectl -n "$ledger_ns" create configmap "$ledger_name" --from-file=targets="$targets_file" --from-file=pv-targets="$pv_targets_file" --dry-run=client -o yaml \
    | kubectl label --local -f - \
      app.kubernetes.io/name=kubeton-local-path-cleanup-ledger \
      "ton.ton.org/kubeton-storage-cleanup=${ledger_id}" --overwrite -o yaml \
    | kubectl -n "$ledger_ns" create -f - >/dev/null; then
    rm -f "$targets_file" "$pv_targets_file"
    return 0
  else
    rm -f "$targets_file" "$pv_targets_file"
    echo "Error: could not create local-path cleanup ledger ${ledger_ns}/${ledger_name}; leaving PVCs intact." >&2
    return 1
  fi

  if ! kubectl -n "$ledger_ns" create configmap "$ledger_name" --from-file=targets="$targets_file" --from-file=pv-targets="$pv_targets_file" --dry-run=client -o yaml \
    | kubectl label --local -f - \
      app.kubernetes.io/name=kubeton-local-path-cleanup-ledger \
      "ton.ton.org/kubeton-storage-cleanup=${ledger_id}" --overwrite -o yaml \
    | kubectl apply -f - >/dev/null; then
    rm -f "$targets_file" "$pv_targets_file"
    echo "Error: could not persist local-path cleanup ledger ${ledger_ns}/${ledger_name}; leaving PVCs intact." >&2
    return 1
  fi
  rm -f "$targets_file" "$pv_targets_file"
}

# Make sure a recorded directory is not referenced by any other current
# hostPath/local PV before the privileged cleanup pod removes it.  This is
# needed whether the recorded PV is already gone or is still present: a static
# or rebound PV can share the same directory in either case.
local_path_target_is_exclusive_to_recorded_pv() {
  local expected_path="$1"
  local expected_pv="$2"
  local expected_pv_uid="$3"
  local pv_names candidate_pv candidate_uid candidate_path

  if ! pv_names="$(kubectl get pv -o jsonpath='{range .items[*]}{.metadata.name}{"\n"}{end}' 2>/dev/null)"; then
    echo "Error: could not check whether local-path target ${expected_path} was rebound to another PV." >&2
    return 1
  fi
  while IFS= read -r candidate_pv; do
    candidate_pv="$(trim_whitespace "$candidate_pv")"
    [[ -n "$candidate_pv" ]] || continue
    if ! candidate_uid="$(kubectl get pv "$candidate_pv" --ignore-not-found -o jsonpath='{.metadata.uid}' 2>/dev/null)"; then
      echo "Error: could not inspect PV ${candidate_pv} while checking local-path target ${expected_path}." >&2
      return 1
    fi
    candidate_uid="$(trim_whitespace "$candidate_uid")"
    [[ -n "$candidate_uid" ]] || continue
    if ! candidate_path="$(local_path_pv_host_path "$candidate_pv")"; then
      return 1
    fi
    candidate_path="$(local_path_absolute_target "$candidate_path" 2>/dev/null || true)"
    [[ "$candidate_path" == "$expected_path" ]] || continue
    if [[ "$candidate_pv" == "$expected_pv" && "$candidate_uid" == "$expected_pv_uid" ]]; then
      continue
    fi
    echo "Error: refusing to remove local-path target ${expected_path}: it is currently referenced by PV ${candidate_pv} (UID ${candidate_uid})." >&2
    return 1
  done <<<"$pv_names"
  return 0
}

local_path_recorded_pv_can_be_deleted() {
  local pv="$1"
  local expected_path="$2"
  local pvc_ref="$3"
  local expected_pv_uid="$4"
  local expected_pvc_uid="$5"
  local expected_node="$6"
  local actual_path actual_identity actual_pv_uid actual_reclaim_policy expected_ns expected_pvc actual_ns actual_pvc actual_pvc_uid live_pvc_uid namespace_marker claim_ref node
  local -a pv_nodes=()

  if ! actual_identity="$(kubectl get pv "$pv" --ignore-not-found -o jsonpath='{.metadata.uid}{"\t"}{.spec.persistentVolumeReclaimPolicy}' 2>/dev/null)"; then
    echo "Error: could not verify recorded PV ${pv} before local-path cleanup." >&2
    return 1
  fi
  IFS=$'\t' read -r actual_pv_uid actual_reclaim_policy <<<"$actual_identity"
  actual_pv_uid="$(trim_whitespace "$actual_pv_uid")"
  actual_reclaim_policy="$(trim_whitespace "$actual_reclaim_policy")"
  if [[ -z "$actual_pv_uid" ]]; then
    local_path_target_is_exclusive_to_recorded_pv "$expected_path" "$pv" "$expected_pv_uid"
    return $?
  fi
  if [[ -z "$actual_pv_uid" || "$actual_pv_uid" != "$expected_pv_uid" ]]; then
    echo "Error: refusing to delete PV ${pv}: its UID no longer matches the cleanup ledger." >&2
    return 1
  fi
  if [[ "$actual_reclaim_policy" != "Delete" ]]; then
    echo "Error: refusing local-path cleanup for PV ${pv}: reclaimPolicy is ${actual_reclaim_policy:-unknown}, not Delete." >&2
    return 1
  fi
  if ! actual_path="$(local_path_pv_host_path "$pv")"; then
    return 1
  fi
  actual_path="$(local_path_absolute_target "$actual_path" 2>/dev/null || true)"
  if [[ -z "$actual_path" || "$actual_path" != "$expected_path" ]]; then
    echo "Error: refusing to delete PV ${pv}: its host path no longer matches the cleanup ledger." >&2
    return 1
  fi
  if ! local_path_pv_is_provisioned_by_local_path "$pv"; then
    echo "Error: refusing to delete PV ${pv}: it is no longer a verified local-path PV." >&2
    return 1
  fi
  if ! collect_local_path_nodes_for_pv "$pv" pv_nodes || [[ ${#pv_nodes[@]} -ne 1 ]]; then
    echo "Error: refusing to delete PV ${pv}: its local-path node affinity is no longer uniquely resolvable." >&2
    return 1
  fi
  node="${pv_nodes[0]}"
  if [[ "$node" != "$expected_node" ]]; then
    echo "Error: refusing to delete PV ${pv}: its local-path node no longer matches the cleanup ledger." >&2
    return 1
  fi

  IFS=/ read -r expected_ns expected_pvc <<<"$pvc_ref"
  if ! claim_ref="$(kubectl get pv "$pv" -o jsonpath='{.spec.claimRef.namespace}{"\t"}{.spec.claimRef.name}{"\t"}{.spec.claimRef.uid}' 2>/dev/null)"; then
    echo "Error: could not verify claimRef for recorded PV ${pv}." >&2
    return 1
  fi
  IFS=$'\t' read -r actual_ns actual_pvc actual_pvc_uid <<<"$claim_ref"
  actual_ns="$(trim_whitespace "$actual_ns")"
  actual_pvc="$(trim_whitespace "$actual_pvc")"
  actual_pvc_uid="$(trim_whitespace "$actual_pvc_uid")"
  if [[ -n "$actual_ns" || -n "$actual_pvc" || -n "$actual_pvc_uid" ]]; then
    if [[ "$actual_ns" != "$expected_ns" || "$actual_pvc" != "$expected_pvc" || "$actual_pvc_uid" != "$expected_pvc_uid" ]]; then
      echo "Error: refusing to delete PV ${pv}: its claimRef no longer matches the cleanup ledger." >&2
      return 1
    fi
  fi
  if ! namespace_marker="$(kubectl get namespace "$expected_ns" --ignore-not-found -o jsonpath='{.metadata.uid}' 2>/dev/null)"; then
    echo "Error: could not verify namespace ${expected_ns} before local-path cleanup." >&2
    return 1
  fi
  namespace_marker="$(trim_whitespace "$namespace_marker")"
  if [[ -n "$namespace_marker" ]]; then
    if ! live_pvc_uid="$(kubectl -n "$expected_ns" get pvc "$expected_pvc" --ignore-not-found -o jsonpath='{.metadata.uid}' 2>/dev/null)"; then
      echo "Error: could not verify PVC ${expected_ns}/${expected_pvc} before local-path cleanup." >&2
      return 1
    fi
    live_pvc_uid="$(trim_whitespace "$live_pvc_uid")"
  else
    live_pvc_uid=""
  fi
  if [[ -n "$live_pvc_uid" ]]; then
    echo "Error: refusing to delete PV ${pv}: PVC ${expected_ns}/${expected_pvc} exists again." >&2
    return 1
  fi
  if ! local_path_target_is_exclusive_to_recorded_pv "$expected_path" "$pv" "$expected_pv_uid"; then
    return 1
  fi
  return 0
}

pvc_has_pod_references() {
  local ns="$1"
  local pvc="$2"
  local pod claims claim rows namespace_name namespace_phase
  local -a referenced_pods=()
  local -a claim_rows=()

  if ! namespace_name="$(kubectl get namespace "$ns" --ignore-not-found -o jsonpath='{.metadata.name}' 2>/dev/null)"; then
    echo "Error: could not verify namespace ${ns} before local-path cleanup." >&2
    return 0
  fi
  namespace_name="$(trim_whitespace "$namespace_name")"
  # A deleted namespace cannot contain a pod still mounting the old PVC.
  [[ -n "$namespace_name" ]] || return 1
  namespace_phase="$(kubectl get namespace "$ns" -o jsonpath='{.status.phase}' 2>/dev/null || true)"
  if [[ "$namespace_phase" == "Terminating" ]]; then
    echo "Error: namespace ${ns} is terminating; cannot verify pod references for PVC ${ns}/${pvc}." >&2
    return 0
  fi
  if ! rows="$(kubectl -n "$ns" get pods \
    -o jsonpath='{range .items[*]}{.metadata.name}{"\t"}{range .spec.volumes[*]}{.persistentVolumeClaim.claimName}{","}{end}{"\n"}{end}' 2>/dev/null)"; then
    echo "Error: could not verify pod references for PVC ${ns}/${pvc}." >&2
    return 0
  fi
  while IFS=$'\t' read -r pod claims; do
    pod="$(trim_whitespace "$pod")"
    [[ -n "$pod" ]] || continue
    IFS=',' read -r -a claim_rows <<<"$claims"
    for claim in "${claim_rows[@]}"; do
      claim="$(trim_whitespace "$claim")"
      [[ "$claim" == "$pvc" ]] && append_unique_item "$pod" referenced_pods
    done
  done <<<"$rows"

  if [[ ${#referenced_pods[@]} -eq 0 ]]; then
    return 1
  fi
  echo "Error: refusing destructive PVC/host cleanup while pod(s) still reference ${ns}/${pvc}: ${referenced_pods[*]}" >&2
  return 0
}

verify_no_pod_references_for_pvc() {
  local ns="$1"
  local pvc="$2"

  if pvc_has_pod_references "$ns" "$pvc"; then
    return 1
  fi
  return 0
}

# Host data is destructive to remove, so a local-path target is eligible only
# when the same PV cleanup record says reclaimPolicy=Delete. Older ledgers that
# lack that record may proceed only while the still-live PV proves Delete.
verify_recorded_local_path_targets_use_delete_reclaim_policy() {
  local exact_rows_name="$1"
  local pv_rows_name="$2"
  local -n exact_rows_ref="$exact_rows_name"
  local -n pv_rows_ref="$pv_rows_name"
  local row pv_row node path pv pvc_ref pv_uid pvc_uid recorded_pv recorded_pvc_ref recorded_pv_uid recorded_pvc_uid recorded_reclaim matching_rows same_name_rows current_reclaim
  local -A exact_identities=()

  for row in "${exact_rows_ref[@]}"; do
    [[ -n "$row" ]] || continue
    IFS=$'\t' read -r node path pv pvc_ref pv_uid pvc_uid <<<"$row"
    pv="$(trim_whitespace "$pv")"
    [[ -n "$pv" ]] || return 1
    local exact_identity="${pvc_ref}|${pv_uid}|${pvc_uid}|${path}"
    if [[ -n "${exact_identities[$pv]+present}" && "${exact_identities[$pv]}" != "$exact_identity" ]]; then
      echo "Error: refusing local-path cleanup for reused PV name ${pv}: the cleanup ledger has multiple target identities." >&2
      return 1
    fi
    exact_identities[$pv]="$exact_identity"
  done

  for row in "${exact_rows_ref[@]}"; do
    [[ -n "$row" ]] || continue
    IFS=$'\t' read -r node path pv pvc_ref pv_uid pvc_uid <<<"$row"
    pv="$(trim_whitespace "$pv")"
    [[ -n "$pv" ]] || return 1
    matching_rows=0
    same_name_rows=0
    recorded_reclaim=""
    for pv_row in "${pv_rows_ref[@]}"; do
      [[ -n "$pv_row" ]] || continue
      IFS=$'\t' read -r recorded_pv recorded_pvc_ref recorded_pv_uid recorded_pvc_uid recorded_reclaim _ <<<"$pv_row"
      recorded_pv="$(trim_whitespace "$recorded_pv")"
      [[ "$recorded_pv" == "$pv" ]] || continue
      ((same_name_rows+=1))
      if [[ "$recorded_pvc_ref" != "$pvc_ref" || "$recorded_pv_uid" != "$pv_uid" || "$recorded_pvc_uid" != "$pvc_uid" ]]; then
        continue
      fi
      ((matching_rows+=1))
      recorded_reclaim="$(trim_whitespace "$recorded_reclaim")"
    done
    if (( same_name_rows > 1 )); then
      echo "Error: refusing local-path cleanup for PV ${pv}: the cleanup ledger has multiple lifetimes for that PV name." >&2
      return 1
    fi
    if (( matching_rows == 1 )); then
      if [[ "$recorded_reclaim" != "Delete" ]]; then
        echo "Error: refusing local-path cleanup for PV ${pv}: cleanup ledger recorded reclaimPolicy ${recorded_reclaim:-unknown}, not Delete." >&2
        return 1
      fi
      continue
    fi
    if (( same_name_rows == 1 )); then
      echo "Error: refusing local-path cleanup for PV ${pv}: its PV/PVC identity does not match the cleanup ledger." >&2
      return 1
    fi

    if ! current_reclaim="$(kubectl get pv "$pv" --ignore-not-found -o jsonpath='{.spec.persistentVolumeReclaimPolicy}' 2>/dev/null)"; then
      echo "Error: cannot verify reclaimPolicy for legacy local-path target PV ${pv}." >&2
      return 1
    fi
    current_reclaim="$(trim_whitespace "$current_reclaim")"
    if [[ "$current_reclaim" != "Delete" ]]; then
      echo "Error: refusing local-path cleanup for legacy target PV ${pv}: reclaimPolicy is ${current_reclaim:-unknown}, not Delete." >&2
      return 1
    fi
  done
  return 0
}

verify_recorded_local_path_targets_safe_for_host_cleanup() {
  local exact_rows_name="$1"
  local -n exact_rows_ref="$exact_rows_name"
  local row node path pv pvc_ref pv_uid pvc_uid ns pvc live_pvc_uid namespace_marker

  for row in "${exact_rows_ref[@]}"; do
    [[ -n "$row" ]] || continue
    IFS=$'\t' read -r node path pv pvc_ref pv_uid pvc_uid <<<"$row"
    IFS=/ read -r ns pvc <<<"$pvc_ref"
    ns="$(trim_whitespace "$ns")"
    pvc="$(trim_whitespace "$pvc")"
    if [[ -z "$ns" || -z "$pvc" ]]; then
      echo "Error: cleanup ledger has an invalid PVC reference for PV ${pv}." >&2
      return 1
    fi
    if ! namespace_marker="$(kubectl get namespace "$ns" --ignore-not-found -o jsonpath='{.metadata.uid}' 2>/dev/null)"; then
      echo "Error: could not verify namespace ${ns} before local-path cleanup." >&2
      return 1
    fi
    namespace_marker="$(trim_whitespace "$namespace_marker")"
    if [[ -n "$namespace_marker" ]]; then
      if ! live_pvc_uid="$(kubectl -n "$ns" get pvc "$pvc" --ignore-not-found -o jsonpath='{.metadata.uid}' 2>/dev/null)"; then
        echo "Error: could not verify PVC ${ns}/${pvc} before local-path cleanup." >&2
        return 1
      fi
      live_pvc_uid="$(trim_whitespace "$live_pvc_uid")"
    else
      live_pvc_uid=""
    fi
    if [[ -n "$live_pvc_uid" ]]; then
      echo "Error: refusing local-path host cleanup: PVC ${ns}/${pvc} exists again." >&2
      return 1
    fi
    if ! verify_no_pod_references_for_pvc "$ns" "$pvc"; then
      return 1
    fi
    if ! local_path_recorded_pv_can_be_deleted "$pv" "$path" "$pvc_ref" "$pv_uid" "$pvc_uid" "$node"; then
      return 1
    fi
  done
}

delete_recorded_local_path_pvs() {
  local exact_rows_name="$1"
  local label="${2:-cleanup}"
  local -n exact_rows_ref="$exact_rows_name"
  local row node path pv pvc_ref expected_pv_uid pvc_uid actual_pv_uid final_pv_uid rc=0
  local -a processed_pvs=()

  for row in "${exact_rows_ref[@]}"; do
    [[ -n "$row" ]] || continue
    IFS=$'\t' read -r node path pv pvc_ref expected_pv_uid pvc_uid <<<"$row"
    pv="$(trim_whitespace "$pv")"
    [[ -n "$pv" ]] || { rc=1; continue; }
    if [[ " ${processed_pvs[*]} " == *" ${pv} "* ]]; then
      continue
    fi
    processed_pvs+=("$pv")
    if ! local_path_recorded_pv_can_be_deleted "$pv" "$path" "$pvc_ref" "$expected_pv_uid" "$pvc_uid" "$node"; then
      rc=1
      continue
    fi
    if ! actual_pv_uid="$(kubectl get pv "$pv" --ignore-not-found -o jsonpath='{.metadata.uid}' 2>/dev/null)"; then
      echo "Error: could not verify recorded PV ${pv} before deletion." >&2
      rc=1
      continue
    fi
    actual_pv_uid="$(trim_whitespace "$actual_pv_uid")"
    if [[ -z "$actual_pv_uid" ]]; then
      continue
    fi
    if [[ "$actual_pv_uid" != "$expected_pv_uid" ]]; then
      echo "Error: refusing to delete PV ${pv}: its UID changed after local-path cleanup was verified." >&2
      rc=1
      continue
    fi
    if ! ensure_volume_attachments_gone_for_pv "$pv"; then
      rc=1
      continue
    fi
    # The attachment wait can take long enough for a name to be reused. Check
    # immediately before the destructive API call rather than deleting by a
    # stale PV name alone.
    if ! final_pv_uid="$(kubectl get pv "$pv" --ignore-not-found -o jsonpath='{.metadata.uid}' 2>/dev/null)"; then
      echo "Error: could not recheck recorded PV ${pv} immediately before deletion." >&2
      rc=1
      continue
    fi
    final_pv_uid="$(trim_whitespace "$final_pv_uid")"
    if [[ -z "$final_pv_uid" ]]; then
      continue
    fi
    if [[ "$final_pv_uid" != "$expected_pv_uid" ]]; then
      echo "Error: refusing to delete PV ${pv}: its UID changed immediately before deletion." >&2
      rc=1
      continue
    fi
    echo "[${label}] Deleting verified local-path PV ${pv} ..."
    if ! delete_pv_and_wait_for_gone "$pv" 180 60; then
      rc=1
    fi
  done
  return "$rc"
}

recorded_pvc_is_absent_and_unmounted() {
  local pvc_ref="$1"
  local expected_pvc_uid="$2"
  local ns pvc namespace_marker live_pvc_uid

  IFS=/ read -r ns pvc <<<"$pvc_ref"
  ns="$(trim_whitespace "$ns")"
  pvc="$(trim_whitespace "$pvc")"
  if [[ -z "$ns" || -z "$pvc" || -z "$expected_pvc_uid" ]]; then
    echo "Error: cleanup ledger has an invalid PVC identity." >&2
    return 1
  fi
  if ! namespace_marker="$(kubectl get namespace "$ns" --ignore-not-found -o jsonpath='{.metadata.uid}' 2>/dev/null)"; then
    echo "Error: could not verify namespace ${ns} before storage cleanup." >&2
    return 1
  fi
  namespace_marker="$(trim_whitespace "$namespace_marker")"
  if [[ -n "$namespace_marker" ]]; then
    if ! live_pvc_uid="$(kubectl -n "$ns" get pvc "$pvc" --ignore-not-found -o jsonpath='{.metadata.uid}' 2>/dev/null)"; then
      echo "Error: could not verify PVC ${ns}/${pvc} before storage cleanup." >&2
      return 1
    fi
    live_pvc_uid="$(trim_whitespace "$live_pvc_uid")"
    if [[ -n "$live_pvc_uid" ]]; then
      echo "Error: refusing storage cleanup: PVC ${ns}/${pvc} exists again (UID ${live_pvc_uid})." >&2
      return 1
    fi
  fi
  if ! verify_no_pod_references_for_pvc "$ns" "$pvc"; then
    return 1
  fi
  return 0
}

recorded_pv_matches_cleanup_ledger() {
  local pv="$1"
  local pvc_ref="$2"
  local expected_pv_uid="$3"
  local expected_pvc_uid="$4"
  local expected_reclaim_policy="$5"
  local expected_csi_driver="$6"
  local expected_volume_handle="$7"
  local pv_identity actual_pv_uid actual_ns actual_pvc actual_pvc_uid actual_reclaim_policy actual_csi_driver actual_volume_handle

  if ! recorded_pvc_is_absent_and_unmounted "$pvc_ref" "$expected_pvc_uid"; then
    return 1
  fi
  if ! pv_identity="$(kubectl get pv "$pv" --ignore-not-found \
    -o jsonpath='{.metadata.uid}{"\t"}{.spec.claimRef.namespace}{"\t"}{.spec.claimRef.name}{"\t"}{.spec.claimRef.uid}{"\t"}{.spec.persistentVolumeReclaimPolicy}{"\t"}{.spec.csi.driver}{"\t"}{.spec.csi.volumeHandle}' 2>/dev/null)"; then
    echo "Error: could not verify recorded PV ${pv} before cleanup." >&2
    return 1
  fi
  IFS=$'\t' read -r actual_pv_uid actual_ns actual_pvc actual_pvc_uid actual_reclaim_policy actual_csi_driver actual_volume_handle <<<"$pv_identity"
  actual_pv_uid="$(trim_whitespace "$actual_pv_uid")"
  # The PV may already have been deleted during an earlier partial teardown.
  [[ -n "$actual_pv_uid" ]] || return 0
  actual_ns="$(trim_whitespace "$actual_ns")"
  actual_pvc="$(trim_whitespace "$actual_pvc")"
  actual_pvc_uid="$(trim_whitespace "$actual_pvc_uid")"
  actual_reclaim_policy="$(trim_whitespace "$actual_reclaim_policy")"
  actual_csi_driver="$(trim_whitespace "$actual_csi_driver")"
  actual_volume_handle="$(trim_whitespace "$actual_volume_handle")"
  if [[ "$actual_pv_uid" != "$expected_pv_uid" ]]; then
    echo "Error: refusing to delete PV ${pv}: its UID no longer matches the cleanup ledger." >&2
    return 1
  fi
  if [[ "$actual_reclaim_policy" != "$expected_reclaim_policy" || "$actual_csi_driver" != "$expected_csi_driver" || "$actual_volume_handle" != "$expected_volume_handle" ]]; then
    echo "Error: refusing to delete PV ${pv}: its storage identity no longer matches the cleanup ledger." >&2
    return 1
  fi
  if [[ -n "$actual_ns$actual_pvc$actual_pvc_uid" ]]; then
    local expected_ns expected_pvc
    IFS=/ read -r expected_ns expected_pvc <<<"$pvc_ref"
    if [[ "$actual_ns" != "$expected_ns" || "$actual_pvc" != "$expected_pvc" || "$actual_pvc_uid" != "$expected_pvc_uid" ]]; then
      echo "Error: refusing to delete PV ${pv}: its claimRef no longer matches the cleanup ledger." >&2
      return 1
    fi
  fi
  return 0
}

recorded_longhorn_volume_matches_cleanup_ledger() {
  local csi_driver="$1"
  local volume_handle="$2"
  local expected_volume_uid="$3"
  local namespace_marker actual_volume_uid

  [[ "$csi_driver" == "driver.longhorn.io" ]] || return 0
  [[ -n "$volume_handle" ]] || return 1
  if ! namespace_marker="$(kubectl get namespace "$LONGHORN_NAMESPACE" --ignore-not-found -o jsonpath='{.metadata.uid}' 2>/dev/null)"; then
    echo "Error: could not verify Longhorn namespace ${LONGHORN_NAMESPACE}." >&2
    return 1
  fi
  namespace_marker="$(trim_whitespace "$namespace_marker")"
  # If Longhorn itself is gone, its Volume CRs are gone as well.
  [[ -n "$namespace_marker" ]] || return 0
  if ! actual_volume_uid="$(kubectl -n "$LONGHORN_NAMESPACE" get volumes.longhorn.io "$volume_handle" --ignore-not-found -o jsonpath='{.metadata.uid}' 2>/dev/null)"; then
    echo "Error: could not verify Longhorn volume ${volume_handle}." >&2
    return 1
  fi
  actual_volume_uid="$(trim_whitespace "$actual_volume_uid")"
  if [[ -z "$expected_volume_uid" ]]; then
    if [[ -n "$actual_volume_uid" ]]; then
      echo "Error: refusing to delete Longhorn volume ${volume_handle}: it did not exist when cleanup state was recorded." >&2
      return 1
    fi
    return 0
  fi
  if [[ -n "$actual_volume_uid" && "$actual_volume_uid" != "$expected_volume_uid" ]]; then
    echo "Error: refusing to delete Longhorn volume ${volume_handle}: its UID no longer matches the cleanup ledger." >&2
    return 1
  fi
  return 0
}

# A CSI volumeHandle is a backend identity, but an old PV can disappear while
# a different static/rebound PV starts using the same handle. Never ask a CSI
# controller to delete a PV unless that handle is still exclusive to the
# recorded PV. This applies to generic CSI drivers as well as Longhorn.
csi_volume_handle_is_exclusive_to_recorded_pv() {
  local expected_pv="$1"
  local expected_pv_uid="$2"
  local csi_driver="$3"
  local volume_handle="$4"
  local recorded_pv_current_uid="${5:-}"
  local rows row pv pv_uid current_driver current_handle

  [[ -n "$csi_driver" && -n "$volume_handle" ]] || return 0
  if ! rows="$(kubectl get pv -o jsonpath='{range .items[*]}{.metadata.name}{"\t"}{.metadata.uid}{"\t"}{.spec.csi.driver}{"\t"}{.spec.csi.volumeHandle}{"\n"}{end}' 2>/dev/null)"; then
    echo "Error: could not check whether CSI volume handle ${volume_handle} (${csi_driver}) is referenced by another PV." >&2
    return 1
  fi
  while IFS=$'\t' read -r pv pv_uid current_driver current_handle; do
    pv="$(trim_whitespace "$pv")"
    pv_uid="$(trim_whitespace "$pv_uid")"
    current_driver="$(trim_whitespace "$current_driver")"
    current_handle="$(trim_whitespace "$current_handle")"
    [[ "$current_driver" == "$csi_driver" && "$current_handle" == "$volume_handle" ]] || continue
    if [[ -z "$recorded_pv_current_uid" || "$pv" != "$expected_pv" || "$pv_uid" != "$expected_pv_uid" ]]; then
      echo "Error: refusing to delete CSI volume handle ${volume_handle} (${csi_driver}): it is now referenced by PV ${pv} (UID ${pv_uid})." >&2
      return 1
    fi
  done <<<"$rows"
  return 0
}

# Retain the narrower helper name for Longhorn-specific callers and tests;
# its safety check is shared with every CSI driver above.
longhorn_volume_handle_is_exclusive_to_recorded_pv() {
  csi_volume_handle_is_exclusive_to_recorded_pv "$1" "$2" driver.longhorn.io "$3" "${4:-}"
}

delete_recorded_pv_cleanup_targets() {
  local rows_name="$1"
  local label="${2:-cleanup}"
  local local_rows_name="${3:-}"
  local -n rows_ref="$rows_name"
  local row pv pvc_ref pv_uid pvc_uid reclaim_policy csi_driver volume_handle longhorn_uid actual_pv_uid final_pv_uid actual_longhorn_uid longhorn_namespace_uid rc=0
  local -a processed_pvs=()
  local -a local_pvs=()
  local -A pv_identities=()
  local -A csi_volume_handle_identities=()

  if [[ -n "$local_rows_name" ]]; then
    local -n local_rows_ref="$local_rows_name"
    local local_row local_pv
    for local_row in "${local_rows_ref[@]}"; do
      [[ -n "$local_row" ]] || continue
      IFS=$'\t' read -r _ _ local_pv _ <<<"$local_row"
      local_pv="$(trim_whitespace "$local_pv")"
      [[ -n "$local_pv" ]] && append_unique_item "$local_pv" local_pvs
    done
  fi

  # A name can be reused across PVC/PV lifetimes. Treat differing ledger
  # identities for the same name as a conflict instead of picking one row and
  # silently clearing the other backend volume.
  for row in "${rows_ref[@]}"; do
    [[ -n "$row" ]] || continue
    IFS=$'\t' read -r pv pvc_ref pv_uid pvc_uid reclaim_policy csi_driver volume_handle longhorn_uid <<<"$row"
    pv="$(trim_whitespace "$pv")"
    [[ -n "$pv" ]] || { rc=1; continue; }
    local identity="${pv_uid}|${pvc_ref}|${pvc_uid}|${reclaim_policy}|${csi_driver}|${volume_handle}|${longhorn_uid}"
    if [[ -n "${pv_identities[$pv]+present}" && "${pv_identities[$pv]}" != "$identity" ]]; then
      echo "Error: cleanup ledger has conflicting identities for reused PV name ${pv}; retaining it for manual review." >&2
      return 1
    fi
    pv_identities[$pv]="$identity"
    if [[ -n "$csi_driver" && -n "$volume_handle" ]]; then
      local handle_key="${csi_driver}|${volume_handle}"
      local handle_identity="${pv}|${pv_uid}|${pvc_ref}|${pvc_uid}|${reclaim_policy}|${longhorn_uid}"
      if [[ -n "${csi_volume_handle_identities[$handle_key]+present}" && "${csi_volume_handle_identities[$handle_key]}" != "$handle_identity" ]]; then
        echo "Error: cleanup ledger has conflicting identities for CSI volume handle ${volume_handle} (${csi_driver}); retaining it for manual review." >&2
        return 1
      fi
      csi_volume_handle_identities[$handle_key]="$handle_identity"
    fi
  done

  for row in "${rows_ref[@]}"; do
    [[ -n "$row" ]] || continue
    IFS=$'\t' read -r pv pvc_ref pv_uid pvc_uid reclaim_policy csi_driver volume_handle longhorn_uid <<<"$row"
    pv="$(trim_whitespace "$pv")"
    [[ -n "$pv" ]] || { rc=1; continue; }
    if [[ " ${processed_pvs[*]} " == *" ${pv} "* ]]; then
      continue
    fi
    processed_pvs+=("$pv")
    if [[ " ${local_pvs[*]} " == *" ${pv} "* ]]; then
      # This PV was already verified and removed by the host-path phase.
      continue
    fi

    if [[ "$reclaim_policy" != "Delete" ]]; then
      echo "Error: PV ${pv} uses reclaimPolicy ${reclaim_policy}; retaining its cleanup ledger for manual storage removal." >&2
      rc=1
      continue
    fi
    if [[ -z "$csi_driver" ]]; then
      echo "Error: PV ${pv} has no CSI driver and is not a recorded local-path target; retaining its cleanup ledger for manual review." >&2
      rc=1
      continue
    fi

    if ! recorded_pv_matches_cleanup_ledger "$pv" "$pvc_ref" "$pv_uid" "$pvc_uid" "$reclaim_policy" "$csi_driver" "$volume_handle"; then
      rc=1
      continue
    fi
    if ! actual_pv_uid="$(kubectl get pv "$pv" --ignore-not-found -o jsonpath='{.metadata.uid}' 2>/dev/null)"; then
      echo "Error: could not verify recorded PV ${pv} before deletion." >&2
      rc=1
      continue
    fi
    actual_pv_uid="$(trim_whitespace "$actual_pv_uid")"
    if [[ -n "$actual_pv_uid" && "$actual_pv_uid" != "$pv_uid" ]]; then
      echo "Error: refusing to delete PV ${pv}: its UID changed after cleanup was verified." >&2
      rc=1
      continue
    fi

    if [[ -n "$actual_pv_uid" ]]; then
      if ! ensure_volume_attachments_gone_for_pv "$pv"; then
        rc=1
        continue
      fi
    fi

    # A stale VolumeAttachment can outlive its PV object. Longhorn backend
    # deletion is therefore gated even on a ledger-only retry where the PV is
    # already absent.
    if [[ "$csi_driver" == "driver.longhorn.io" && -z "$actual_pv_uid" ]]; then
      if ! ensure_volume_attachments_gone_for_pv "$pv"; then
        rc=1
        continue
      fi
    fi

    if [[ "$csi_driver" == "driver.longhorn.io" ]]; then
      if ! longhorn_volume_handle_is_exclusive_to_recorded_pv "$pv" "$pv_uid" "$volume_handle" "$actual_pv_uid"; then
        rc=1
        continue
      fi
    elif ! csi_volume_handle_is_exclusive_to_recorded_pv "$pv" "$pv_uid" "$csi_driver" "$volume_handle" "$actual_pv_uid"; then
      rc=1
      continue
    fi

    if ! recorded_longhorn_volume_matches_cleanup_ledger "$csi_driver" "$volume_handle" "$longhorn_uid"; then
      rc=1
      continue
    fi
    if [[ "$csi_driver" == "driver.longhorn.io" && -n "$longhorn_uid" ]]; then
      if ! longhorn_namespace_uid="$(kubectl get namespace "$LONGHORN_NAMESPACE" --ignore-not-found -o jsonpath='{.metadata.uid}' 2>/dev/null)"; then
        echo "Error: could not verify Longhorn namespace ${LONGHORN_NAMESPACE} before deleting volume ${volume_handle}." >&2
        rc=1
        continue
      fi
      longhorn_namespace_uid="$(trim_whitespace "$longhorn_namespace_uid")"
      if [[ -n "$longhorn_namespace_uid" ]]; then
        if ! actual_longhorn_uid="$(kubectl -n "$LONGHORN_NAMESPACE" get volumes.longhorn.io "$volume_handle" --ignore-not-found -o jsonpath='{.metadata.uid}' 2>/dev/null)"; then
          echo "Error: could not verify Longhorn volume ${volume_handle} before deletion." >&2
          rc=1
          continue
        fi
        actual_longhorn_uid="$(trim_whitespace "$actual_longhorn_uid")"
        if [[ -n "$actual_longhorn_uid" && "$actual_longhorn_uid" != "$longhorn_uid" ]]; then
          echo "Error: refusing to delete Longhorn volume ${volume_handle}: its UID changed after cleanup was verified." >&2
          rc=1
          continue
        fi
        if [[ -n "$actual_longhorn_uid" ]]; then
          echo "[${label}] Deleting verified Longhorn volume ${volume_handle} ..."
          kubectl -n "$LONGHORN_NAMESPACE" delete volumes.longhorn.io "$volume_handle" --ignore-not-found --wait=false >/dev/null 2>&1 || true
        fi
        if ! wait_longhorn_volume_gone "$volume_handle" 300; then
          rc=1
          continue
        fi
      fi
    fi

    # Re-read the UID immediately before deletion. A PV that disappeared then
    # reappeared under the same name must leave the ledger intact rather than
    # being deleted by name.
    if ! final_pv_uid="$(kubectl get pv "$pv" --ignore-not-found -o jsonpath='{.metadata.uid}' 2>/dev/null)"; then
      echo "Error: could not recheck recorded PV ${pv} immediately before deletion." >&2
      rc=1
      continue
    fi
    final_pv_uid="$(trim_whitespace "$final_pv_uid")"
    if [[ -n "$final_pv_uid" && "$final_pv_uid" != "$pv_uid" ]]; then
      echo "Error: refusing to delete PV ${pv}: its UID changed immediately before deletion." >&2
      rc=1
      continue
    fi

    if [[ -n "$final_pv_uid" ]]; then
      echo "[${label}] Deleting recorded PV ${pv} ..."
      if [[ "$csi_driver" == "driver.longhorn.io" ]]; then
        # Longhorn's recorded Volume CR has already been verified gone.
        delete_pv_and_wait_for_gone "$pv" 180 60 true || rc=1
      else
        # For a generic CSI driver, never strip PV finalizers: that could
        # remove the Kubernetes object while leaking a cloud disk.
        delete_pv_and_wait_for_gone "$pv" 180 60 false || rc=1
      fi
    fi
  done
  return "$rc"
}

clear_local_path_cleanup_ledgers() {
  local ns name locations

  locations="$(list_local_path_cleanup_ledger_locations)" || return 1
  [[ -n "$locations" ]] || return 0
  while IFS=$'\t' read -r ns name; do
    ns="$(trim_whitespace "$ns")"
    name="$(trim_whitespace "$name")"
    [[ -n "$ns" && -n "$name" ]] || continue
    if ! kubectl -n "$ns" delete configmap "$name" --ignore-not-found --wait=true >/dev/null; then
      echo "Error: could not remove completed local-path cleanup ledger ${ns}/${name}." >&2
      return 1
    fi
  done <<<"$locations"
}

cleanup_recorded_local_path_data() {
  local label="${1:-cleanup}"
  local -a exact_rows=()
  local -a pv_rows=()
  local -a pattern_rows=()

  collect_local_path_cleanup_ledger_rows exact_rows || return 1
  collect_pv_cleanup_ledger_rows pv_rows || return 1
  [[ ${#exact_rows[@]} -gt 0 || ${#pv_rows[@]} -gt 0 ]] || return 0

  if [[ ${#exact_rows[@]} -gt 0 ]]; then
    if ! is_true "$KUBETON_LOCAL_PATH_CLEANUP"; then
      echo "Error: local-path cleanup is disabled while the cleanup ledger still has host-path targets." >&2
      return 1
    fi
    if ! verify_recorded_local_path_targets_use_delete_reclaim_policy exact_rows pv_rows; then
      echo "Error: local-path cleanup ledger has a Retain or unverifiable host-path target; it will be retained for manual cleanup." >&2
      return 1
    fi
    if ! verify_recorded_local_path_targets_safe_for_host_cleanup exact_rows; then
      echo "Error: local-path cleanup ledger has active or changed storage; it will be retained for retry." >&2
      return 1
    fi
    if ! cleanup_local_path_provisioner_data exact_rows pattern_rows "$label"; then
      echo "Error: local-path cleanup ledger still has unresolved host data; it will be retained for retry." >&2
      return 1
    fi
    if ! delete_recorded_local_path_pvs exact_rows "$label"; then
      echo "Error: local-path cleanup ledger still has unresolved PV data; it will be retained for retry." >&2
      return 1
    fi
  fi
  if ! delete_recorded_pv_cleanup_targets pv_rows "$label" exact_rows; then
    echo "Error: cleanup ledger still has unresolved PV or backend-volume data; it will be retained for retry." >&2
    return 1
  fi
  clear_local_path_cleanup_ledgers
}

collect_local_path_cleanup_ledger_leftovers() {
  local -n rows_ref="$1"
  local ns name locations

  if ! locations="$(list_local_path_cleanup_ledger_locations)"; then
    append_unique_item "LocalPathCleanupLedger lookup failed" rows_ref
    return 0
  fi
  [[ -n "$locations" ]] || return 0
  while IFS=$'\t' read -r ns name; do
    ns="$(trim_whitespace "$ns")"
    name="$(trim_whitespace "$name")"
    [[ -n "$ns" && -n "$name" ]] || continue
    append_unique_item "LocalPathCleanupLedger ${ns}/${name}" rows_ref
  done <<<"$locations"
}

delete_pvc_rows_and_backing_volumes() {
  local pvc_rows_name="$1"
  local label="${2:-cleanup}"
  # A missing local-path owner is normally a hard stop: deleting a PVC can
  # make its provisioner remove the backing directory before kubeton can
  # verify it.  Explicit TON drop/uninstall may opt into removing *only* the
  # PVC object after a UID-bound PV ledger was persisted and no pod references
  # the claim.  The unresolved storage record remains in that ledger.
  local force_unresolved_local_pvcs="${3:-false}"
  local -n pvc_rows_ref="$pvc_rows_name"
  local -a local_path_exact_rows=()
  local -a recorded_pv_rows=()
  local -a local_path_pattern_rows=()
  local -a empty_local_path_exact_rows=()
  local -a normally_deletable_pvc_rows=()
  local -a unresolved_local_pvc_rows=()
  local -a failed_pvc_rows=()
  local row ns pvc_name volume failed_row ledger_row ledger_pvc_ref ledger_pvc_uid expected_pvc_uid recorded_pvc_matches
  local -a wait_pids=()
  local -a wait_rows=()
  local i exact_inventory_rc=0 generic_inventory_rc=0 hard_inventory_rc=0 unresolved_local_rc=0 delete_rc=0 cleanup_rc=0

  if [[ ${#pvc_rows_ref[@]} -eq 0 ]]; then
    return 0
  fi

  for row in "${pvc_rows_ref[@]}"; do
    IFS=$'\t' read -r ns pvc_name <<<"$row"
    [[ -z "$ns" || -z "$pvc_name" ]] && continue
    if ! volume="$(kubectl -n "$ns" get pvc "$pvc_name" --ignore-not-found -o jsonpath='{.spec.volumeName}' 2>/dev/null)"; then
      echo "Error: could not inspect PVC ${ns}/${pvc_name} before deleting backing storage." >&2
      hard_inventory_rc=1
      continue
    fi
    volume="$(trim_whitespace "$volume")"
    if [[ -z "$volume" ]]; then
      append_unique_item "$ns"$'\t'"$pvc_name" normally_deletable_pvc_rows
      continue
    fi

    exact_inventory_rc=0
    generic_inventory_rc=0
    # Record the UID-bound PV/PVC identity first. If this fails, do not even
    # retain an exact path row: it would be unsafe to reconcile a host path
    # without the immutable ownership record that binds it to this PVC.
    if ! append_pv_cleanup_ledger_row_for_pv "$volume" "${ns}/${pvc_name}" recorded_pv_rows; then
      generic_inventory_rc=1
    fi

    # Without an immutable PV/PVC record, no later retry can establish that a
    # reused PV belongs to this claim.  Keep this PVC intact rather than
    # forcing its finalizers away.
    if (( generic_inventory_rc != 0 )); then
      echo "Error: could not record verified backing-storage cleanup state for PVC ${ns}/${pvc_name}; leaving that PVC intact." >&2
      hard_inventory_rc=1
      continue
    fi

    # Carry the recorded PVC UID into the force-only path. A same-name PVC
    # may be recreated between inventory and finalizer removal; never remove
    # finalizers from that different claim.
    expected_pvc_uid=""
    recorded_pvc_matches=0
    for ledger_row in "${recorded_pv_rows[@]}"; do
      [[ -n "$ledger_row" ]] || continue
      IFS=$'\t' read -r _ ledger_pvc_ref _ ledger_pvc_uid _ <<<"$ledger_row"
      if [[ "$ledger_pvc_ref" == "${ns}/${pvc_name}" ]]; then
        expected_pvc_uid="$(trim_whitespace "$ledger_pvc_uid")"
        ((recorded_pvc_matches+=1))
      fi
    done
    if [[ -z "$expected_pvc_uid" || "$recorded_pvc_matches" != "1" ]]; then
      echo "Error: could not recover the recorded PVC identity for ${ns}/${pvc_name}; leaving that PVC intact." >&2
      hard_inventory_rc=1
      continue
    fi

    if append_local_path_exact_cleanup_rows_for_pv "$volume" "${ns}/${pvc_name}" local_path_exact_rows; then
      exact_inventory_rc=0
    else
      exact_inventory_rc=$?
    fi

    if (( exact_inventory_rc != 0 )); then
      if (( exact_inventory_rc == 2 )) && is_true "$force_unresolved_local_pvcs"; then
        echo "Warning: exact local-path ownership for PVC ${ns}/${pvc_name} could not be proven. Its UID-bound storage record will be retained; uninstall may remove only the unmounted PVC object." >&2
        append_unique_item "$ns"$'\t'"$pvc_name"$'\t'"$expected_pvc_uid" unresolved_local_pvc_rows
        unresolved_local_rc=1
      else
        echo "Error: exact local-path safety checks failed for PVC ${ns}/${pvc_name}; leaving that PVC intact." >&2
        hard_inventory_rc=1
        continue
      fi
    else
      append_unique_item "$ns"$'\t'"$pvc_name" normally_deletable_pvc_rows
    fi
  done

  # Keep the non-destructive start/cleanup behavior unchanged: it must not
  # alter any PVC when a local backing directory cannot be proven. Explicit
  # TON uninstall/drop continues per PVC after the durable ledger is written.
  if (( hard_inventory_rc != 0 || unresolved_local_rc != 0 )) && ! is_true "$force_unresolved_local_pvcs"; then
    echo "Error: could not safely inventory all local-path backing directories; leaving PVCs intact." >&2
    return 1
  fi
  if ! record_local_path_cleanup_ledger local_path_exact_rows recorded_pv_rows; then
    return 1
  fi

  # Pattern cleanup is intentionally limited to fully verified PVCs. A
  # wildcard match must never compensate for missing exact host-path
  # provenance on an unresolved local-path record.
  collect_local_path_pattern_cleanup_rows_for_pvcs normally_deletable_pvc_rows local_path_pattern_rows

  if [[ ${#normally_deletable_pvc_rows[@]} -gt 0 ]]; then
    echo "[${label}] Deleting PVCs ..."
  fi
  for row in "${normally_deletable_pvc_rows[@]}"; do
    IFS=$'\t' read -r ns pvc_name <<<"$row"
    [[ -z "$ns" || -z "$pvc_name" ]] && continue
    kubectl -n "$ns" delete pvc "$pvc_name" --ignore-not-found --wait=false >/dev/null 2>&1 || true
  done

  for row in "${normally_deletable_pvc_rows[@]}"; do
    IFS=$'\t' read -r ns pvc_name <<<"$row"
    [[ -z "$ns" || -z "$pvc_name" ]] && continue
    wait_pvc_gone "$ns" "$pvc_name" 120 &
    wait_pids+=("$!")
    wait_rows+=("$row")
  done
  for i in "${!wait_pids[@]}"; do
    if ! wait "${wait_pids[$i]}"; then
      failed_row="${wait_rows[$i]:-}"
      [[ -n "$failed_row" ]] && failed_pvc_rows+=("$failed_row")
    fi
  done
  wait_pids=()
  wait_rows=()

  for failed_row in "${failed_pvc_rows[@]}"; do
    IFS=$'\t' read -r ns pvc_name <<<"$failed_row"
    [[ -z "$ns" || -z "$pvc_name" ]] && continue
    if ! delete_pvc_and_wait_for_gone "$ns" "$pvc_name" 60 60; then
      delete_rc=1
    fi
  done

  # The exact host directory is unknown for these claims, but their generic
  # PV/PVC identity is now durable.  Remove a stuck PVC only after proving it
  # is not mounted.  The subsequent ledger reconciliation deliberately
  # refuses to guess at a host path or strip a PV finalizer.
  for row in "${unresolved_local_pvc_rows[@]}"; do
    IFS=$'\t' read -r ns pvc_name expected_pvc_uid <<<"$row"
    [[ -z "$ns" || -z "$pvc_name" ]] && continue
    if ! force_delete_unmounted_pvc_after_unresolved_local_inventory "$ns" "$pvc_name" "$expected_pvc_uid" 60; then
      delete_rc=1
    fi
  done

  # The PVC is gone now, so no Kubernetes pod can still mount its RWO
  # filesystem.  The persisted ledger makes this retryable if the privileged
  # cleanup pod cannot remove the host directory on this attempt.
  if ! cleanup_recorded_local_path_data "$label"; then
    cleanup_rc=1
  fi
  if (( cleanup_rc == 0 )) && ! cleanup_local_path_provisioner_data empty_local_path_exact_rows local_path_pattern_rows "$label"; then
    cleanup_rc=1
  fi
  if (( hard_inventory_rc != 0 )); then
    echo "Error: one or more PVCs were retained because their backing storage could not be safely inventoried." >&2
  fi
  if (( unresolved_local_rc != 0 )); then
    echo "Warning: one or more unmounted PVC objects were force-deleted, but their unverified local-path storage records remain for manual reconciliation." >&2
  fi
  (( hard_inventory_rc == 0 && unresolved_local_rc == 0 && delete_rc == 0 && cleanup_rc == 0 ))
}

collect_expected_ton_pvc_rows_from_values() {
  local -n rows_ref="$1"
  local ns sts replicas claim_prefix ordinal pvc_name
  local -a claim_prefixes=("ton-work" "ton-src" "mytoncore" "mytonctrl" "keybundle")

  ns="$(resolve_tonnode_namespace_from_values)"
  sts="$(resolve_tonnode_name_from_values)"
  replicas="$(resolve_ton_replicas_from_values_file "$TON_VALUES_FILE" || true)"
  if ! [[ "$replicas" =~ ^[1-9][0-9]*$ ]]; then
    replicas="$(resolve_ton_replicas_from_values_file "$CHART_DIR/values.yaml" || true)"
  fi
  if ! [[ "$replicas" =~ ^[1-9][0-9]*$ ]]; then
    replicas=1
  fi

  for claim_prefix in "${claim_prefixes[@]}"; do
    for ((ordinal=0; ordinal<replicas; ordinal++)); do
      append_unique_item "$ns"$'\t'"${claim_prefix}-${sts}-${ordinal}" rows_ref
    done
  done

  # Also include any higher ordinals from an older replica count.
  while IFS= read -r pvc_name; do
    [[ -z "$pvc_name" ]] && continue
    append_unique_item "$ns"$'\t'"$pvc_name" rows_ref
  done < <(
    kubectl -n "$ns" get pvc -o jsonpath='{range .items[*]}{.metadata.name}{"\n"}{end}' 2>/dev/null \
      | grep -E "^(ton-work|ton-src|mytoncore|mytonctrl|keybundle)-${sts}-" || true
  )
}

collect_labeled_ton_pvc_rows() {
  local -n rows_ref="$1"
  local ns pvc

  while IFS=$'\t' read -r ns pvc; do
    [[ -z "$ns" || -z "$pvc" ]] && continue
    append_unique_item "$ns"$'\t'"$pvc" rows_ref
  done < <(
    kubectl get pvc -A -l 'app.kubernetes.io/name=ton-node,app.kubernetes.io/managed-by=ton-k8s-operator' -o jsonpath='{range .items[*]}{.metadata.namespace}{"\t"}{.metadata.name}{"\n"}{end}' 2>/dev/null || true
  )
}

pvc_has_kubeton_attribution() {
  local ns="$1"
  local pvc="$2"
  local managed_by app_name

  if ! kubectl -n "$ns" get pvc "$pvc" >/dev/null 2>&1; then
    return 1
  fi

  managed_by="$(kubectl -n "$ns" get pvc "$pvc" -o jsonpath='{.metadata.labels.app\.kubernetes\.io/managed-by}' 2>/dev/null || true)"
  app_name="$(kubectl -n "$ns" get pvc "$pvc" -o jsonpath='{.metadata.labels.app\.kubernetes\.io/name}' 2>/dev/null || true)"
  managed_by="$(trim_whitespace "$managed_by")"
  app_name="$(trim_whitespace "$app_name")"

  [[ "$managed_by" == "kubeton" ]] && return 0
  [[ "$managed_by" == "ton-k8s-operator" && "$app_name" == "ton-node" ]] && return 0

  return 1
}

# Older chart/controller versions did not always preserve the labels carried by
# a StatefulSet VolumeClaimTemplate.  During an explicitly destructive TON
# cleanup, the configured claim-template names are still a narrow and useful
# ownership signal: a PVC named mytoncore-<configured-tonnode>-<ordinal> cannot
# coexist with that StatefulSet's claim for the same ordinal.  Do not use this
# fallback during normal start/repair flows; those must continue to require
# Kubernetes ownership labels.
pvc_is_configured_ton_claim_template() {
  local ns="$1"
  local pvc="$2"
  local configured_ns configured_sts claim_prefix prefix ordinal
  local -a claim_prefixes=("ton-work" "ton-src" "mytoncore" "mytonctrl" "keybundle")

  configured_ns="$(resolve_tonnode_namespace_from_values)"
  configured_sts="$(resolve_tonnode_name_from_values)"
  [[ -n "$configured_ns" && -n "$configured_sts" && "$ns" == "$configured_ns" ]] || return 1

  for claim_prefix in "${claim_prefixes[@]}"; do
    prefix="${claim_prefix}-${configured_sts}-"
    [[ "$pvc" == "$prefix"* ]] || continue
    ordinal="${pvc#"$prefix"}"
    [[ "$ordinal" =~ ^(0|[1-9][0-9]*)$ ]] && return 0
  done
  return 1
}

# A current StatefulSet selected with TON_POD_LABEL is an additional trusted
# provenance source for an unlabelled legacy claim.  This lets uninstall clean
# a fleet whose values file was renamed after deployment, while limiting the
# fallback to names captured from that particular StatefulSet.
pvc_row_has_trusted_ton_statefulset_provenance() {
  local ns="$1"
  local pvc="$2"
  local trusted_rows_name="${3:-}"
  local expected_row row

  [[ -n "$trusted_rows_name" ]] || return 1
  local -n trusted_rows_ref="$trusted_rows_name"
  expected_row="${ns}"$'\t'"${pvc}"
  for row in "${trusted_rows_ref[@]}"; do
    [[ "$row" == "$expected_row" ]] && return 0
  done
  return 1
}

collect_existing_pvc_rows() {
  local -n candidate_rows_ref="$1"
  local -n existing_rows_ref="$2"
  local row ns pvc

  for row in "${candidate_rows_ref[@]}"; do
    [[ -z "$row" ]] && continue
    IFS=$'\t' read -r ns pvc <<<"$row"
    [[ -z "$ns" || -z "$pvc" ]] && continue
    if kubectl -n "$ns" get pvc "$pvc" >/dev/null 2>&1; then
      append_unique_item "$ns"$'\t'"$pvc" existing_rows_ref
    fi
  done
}

collect_existing_kubeton_pvc_rows() {
  local -n candidate_rows_ref="$1"
  local -n existing_rows_ref="$2"
  local label="${3:-cleanup}"
  local trusted_rows_name="${4:-}"
  local row ns pvc

  for row in "${candidate_rows_ref[@]}"; do
    [[ -z "$row" ]] && continue
    IFS=$'\t' read -r ns pvc <<<"$row"
    [[ -z "$ns" || -z "$pvc" ]] && continue
    if ! kubectl -n "$ns" get pvc "$pvc" >/dev/null 2>&1; then
      continue
    fi
    if pvc_has_kubeton_attribution "$ns" "$pvc"; then
      append_unique_item "$ns"$'\t'"$pvc" existing_rows_ref
    elif [[ "$label" == "uninstall" || "$label" == "drop" ]] \
      && { pvc_is_configured_ton_claim_template "$ns" "$pvc" \
        || pvc_row_has_trusted_ton_statefulset_provenance "$ns" "$pvc" "$trusted_rows_name"; }; then
      echo "[${label}] Accepting legacy unlabelled PVC ${ns}/${pvc}: it matches a configured or captured TON claim template." >&2
      append_unique_item "$ns"$'\t'"$pvc" existing_rows_ref
    else
      echo "[${label}] Skipping PVC ${ns}/${pvc}: missing kubeton/ton-k8s-operator ownership labels." >&2
    fi
  done
}

strip_ansi_sequences() {
  local text="${1:-}"
  text="${text//$'\r'/}"
  printf '%s' "$text" | sed -E $'s/\x1B\\[[0-9;]*[[:alpha:]]//g'
}

resolve_tonnode_wallet_address_from_pod() {
  local ns="$1"
  local pod="$2"
  local wallet_name="$3"
  local output address

  output="$(run_with_timeout "$STATUS_EXEC_TIMEOUT" kubectl -n "$ns" exec "$pod" -c ton-node -- bash -lc '
    shopt -s expand_aliases
    if [[ -f ~/.bashrc ]]; then
      source ~/.bashrc >/dev/null 2>&1
    fi
    if command -v mytonctrl >/dev/null 2>&1; then
      echo wl | mytonctrl
    fi
  ' 2>/dev/null || true)"
  output="$(strip_ansi_sequences "$output")"
  address="$(printf '%s\n' "$output" | awk -v wallet_name="$wallet_name" '$1 == wallet_name {print $NF; exit}')"
  address="$(trim_whitespace "$address")"

  if [[ -z "$address" ]]; then
    return 1
  fi
  printf '%s' "$address"
}

resolve_tonnode_wallet_row_from_pod() {
  local ns="$1"
  local pod="$2"
  local wallet_name="$3"
  local output row

  output="$(run_with_timeout "$STATUS_EXEC_TIMEOUT" kubectl -n "$ns" exec "$pod" -c ton-node -- bash -lc '
    shopt -s expand_aliases
    if [[ -f ~/.bashrc ]]; then
      source ~/.bashrc >/dev/null 2>&1
    fi
    if command -v mytonctrl >/dev/null 2>&1; then
      echo wl | mytonctrl
    fi
  ' 2>/dev/null || true)"
  output="$(strip_ansi_sequences "$output")"
  row="$(printf '%s\n' "$output" | awk -v wallet_name="$wallet_name" '
    $1 == wallet_name && NF >= 6 {
      print $1 "\t" $2 "\t" $3 "\t" $4 "\t" $5 "\t" $NF
      exit
    }
  ')"
  row="$(trim_whitespace "$row")"
  if [[ -z "$row" ]]; then
    return 1
  fi
  printf '%s' "$row"
}

list_tonnode_wallet_names_from_pod() {
  local ns="$1"
  local pod="$2"
  local output

  output="$(run_with_timeout "$STATUS_EXEC_TIMEOUT" kubectl -n "$ns" exec "$pod" -c ton-node -- bash -lc '
    wallet_dir="/usr/local/bin/mytoncore/wallets"
    [[ -d "$wallet_dir" ]] || exit 0
    shopt -s nullglob
    for f in "$wallet_dir"/*.pk; do
      base="${f##*/}"
      printf "%s\n" "${base%.pk}"
    done | sort -u
  ' 2>/dev/null || true)"
  output="$(strip_ansi_sequences "$output")"
  printf '%s\n' "$output" | awk 'NF'
}

read_tonnode_wallet_address_file_from_pod() {
  local ns="$1"
  local pod="$2"
  local wallet_name="$3"
  local output

  output="$(run_with_timeout "$STATUS_EXEC_TIMEOUT" kubectl -n "$ns" exec "$pod" -c ton-node -- bash -lc '
    wallet_name="$1"
    wallet_dir="/usr/local/bin/mytoncore/wallets"
    if ! [[ "$wallet_name" =~ ^[A-Za-z0-9._-]+$ ]]; then
      exit 2
    fi
    addr_file="${wallet_dir}/${wallet_name}.addr"
    [[ -r "$addr_file" ]] || exit 1
    LC_ALL=C tr -cd "[:print:]\n" < "$addr_file" | head -n1 | tr -d "\r\n"
  ' _ "$wallet_name" 2>/dev/null || true)"
  output="$(strip_ansi_sequences "$output")"
  output="$(trim_whitespace "$output")"
  [[ -n "$output" ]] || return 1
  printf '%s' "$output"
}

read_tonnode_wallet_private_key_hex_from_pod() {
  local ns="$1"
  local pod="$2"
  local wallet_name="$3"
  local output
  local exec_rc=0

  output="$(run_with_timeout "$STATUS_EXEC_TIMEOUT" kubectl -n "$ns" exec "$pod" -c ton-node -- bash -lc '
    wallet_name="$1"
    wallet_dir="/usr/local/bin/mytoncore/wallets"
    if ! [[ "$wallet_name" =~ ^[A-Za-z0-9._-]+$ ]]; then
      echo "Error: invalid wallet name ${wallet_name}." >&2
      exit 2
    fi
    pk_file="${wallet_dir}/${wallet_name}.pk"
    if [[ ! -r "$pk_file" ]]; then
      echo "Error: private key file not found or not readable: ${pk_file}" >&2
      exit 1
    fi
    if ! command -v od >/dev/null 2>&1; then
      echo "Error: od command not found." >&2
      exit 127
    fi
    LC_ALL=C od -An -tx1 -v "$pk_file" | tr -d " \n"
    printf "\n"
  ' _ "$wallet_name" 2>&1)" || exec_rc=$?
  output="$(strip_ansi_sequences "$output")"
  output="$(trim_whitespace "$output")"
  if (( exec_rc != 0 )); then
    echo "Error: failed to read private key for '${wallet_name}' in ${ns}/${pod} (exit ${exec_rc})." >&2
    if [[ -n "$output" ]]; then
      print_prefixed_lines "  ${pod}> " "$output" >&2
    fi
    return "$exec_rc"
  fi
  if ! [[ "$output" =~ ^[0-9A-Fa-f]+$ ]]; then
    echo "Error: private key output for '${wallet_name}' in ${ns}/${pod} was not hex." >&2
    return 1
  fi
  printf '%s' "$(printf '%s' "$output" | tr '[:upper:]' '[:lower:]')"
}

run_wallet_export_tonnode() {
  local target_pod_name="${1:-}"
  local target_wallet_name="${2:-}"
  local row target_ns target_pod target_node_name wallet_name wallet_row
  local status balance version workchain address address_hex private_key_hex
  local rc=0
  local -a pod_rows=()
  local -a wallet_names=()
  local -a candidate_rows=()
  local -a table_rows=()

  target_pod_name="$(trim_whitespace "$target_pod_name")"
  target_wallet_name="$(trim_whitespace "$target_wallet_name")"
  if [[ -n "$target_wallet_name" ]] && ! [[ "$target_wallet_name" =~ ^[A-Za-z0-9._-]+$ ]]; then
    echo "Error: invalid wallet name '${target_wallet_name}'." >&2
    return 1
  fi

  if [[ -n "$target_pod_name" ]]; then
    row="$(resolve_tonnode_pod_row_by_name "$target_pod_name" || true)"
    row="$(trim_whitespace "$row")"
    if [[ -z "$row" ]]; then
      echo "Error: TON pod '${target_pod_name}' not found." >&2
      return 1
    fi
    pod_rows+=("$row")
  else
    mapfile -t pod_rows < <(list_ton_pods 2>/dev/null || true)
  fi

  for row in "${pod_rows[@]}"; do
    [[ -z "$row" ]] && continue
    IFS=$'\t' read -r target_ns target_pod target_node_name <<<"$row"
    [[ -z "$target_ns" || -z "$target_pod" ]] && continue
    if [[ -z "$(trim_whitespace "$target_node_name")" ]]; then
      if [[ -n "$target_pod_name" ]]; then
        echo "Error: pod ${target_ns}/${target_pod} does not have a host assigned; cannot exec into it." >&2
        return 1
      fi
      echo "Warning: pod ${target_ns}/${target_pod} does not have a host assigned; skipping." >&2
      continue
    fi

    wallet_names=()
    if [[ -n "$target_wallet_name" ]]; then
      wallet_names+=("$target_wallet_name")
    else
      mapfile -t wallet_names < <(list_tonnode_wallet_names_from_pod "$target_ns" "$target_pod" || true)
    fi
    if [[ ${#wallet_names[@]} -eq 0 ]]; then
      echo "Warning: no wallet private key files found in ${target_ns}/${target_pod}." >&2
      continue
    fi

    for wallet_name in "${wallet_names[@]}"; do
      wallet_name="$(trim_whitespace "$wallet_name")"
      [[ -z "$wallet_name" ]] && continue
      if ! [[ "$wallet_name" =~ ^[A-Za-z0-9._-]+$ ]]; then
        echo "Warning: invalid wallet name '${wallet_name}' in ${target_ns}/${target_pod}; skipping." >&2
        continue
      fi

      address=""
      wallet_row="$(resolve_tonnode_wallet_row_from_pod "$target_ns" "$target_pod" "$wallet_name" || true)"
      wallet_row="$(trim_whitespace "$wallet_row")"
      if [[ -n "$wallet_row" ]]; then
        IFS=$'\t' read -r wallet_name status balance version workchain address <<<"$wallet_row"
      fi
      address="$(trim_whitespace "$address")"
      if [[ -z "$address" ]]; then
        address="$(read_tonnode_wallet_address_file_from_pod "$target_ns" "$target_pod" "$wallet_name" || true)"
        address="$(trim_whitespace "$address")"
      fi
      if [[ -z "$address" ]]; then
        address="unknown"
        address_hex="unknown"
        echo "Warning: cannot resolve wallet address for '${wallet_name}' in ${target_ns}/${target_pod}; exporting private key with unknown address." >&2
      else
        address_hex="$(ton_address_to_hex "$address" || true)"
        address_hex="$(trim_whitespace "$address_hex")"
        [[ -z "$address_hex" ]] && address_hex="unknown"
      fi
      candidate_rows+=("${target_ns}"$'\t'"${target_pod}"$'\t'"${wallet_name}"$'\t'"${address}"$'\t'"${address_hex}")
    done
  done

  if [[ ${#candidate_rows[@]} -eq 0 ]]; then
    echo "Error: no TON pod wallets found to export." >&2
    return 1
  fi

  if [[ -n "$target_pod_name" ]]; then
    confirm_or_exit "This will print private key hex for wallet '${target_wallet_name}' in '${target_pod_name}'. Continue?"
  else
    confirm_or_exit "This will print private key hex for ${#candidate_rows[@]} wallet(s) from all TON pods. Continue?"
  fi

  for row in "${candidate_rows[@]}"; do
    IFS=$'\t' read -r target_ns target_pod wallet_name address address_hex <<<"$row"
    private_key_hex="$(read_tonnode_wallet_private_key_hex_from_pod "$target_ns" "$target_pod" "$wallet_name" || true)"
    private_key_hex="$(trim_whitespace "$private_key_hex")"
    if [[ -z "$private_key_hex" ]]; then
      rc=1
      continue
    fi
    table_rows+=("${target_ns}"$'\t'"${target_pod}"$'\t'"${wallet_name}"$'\t'"${address}"$'\t'"${address_hex}"$'\t'"${private_key_hex}")
  done

  if [[ ${#table_rows[@]} -eq 0 ]]; then
    echo "Error: no private keys were exported." >&2
    return 1
  fi
  print_aligned_table_6col "namespace" "tonnode pod" "wallet-name" "wallet-address" "address-hex" "private-key-hex" "${table_rows[@]}"
  return "$rc"
}

