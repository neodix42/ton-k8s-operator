ton_restore_archive_validation_script() {
  cat <<'PY'
import json
import sys
import tarfile


def require(condition, message):
    if not condition:
        raise ValueError(message)


with tarfile.open(sys.argv[1] if len(sys.argv) > 1 else "/recovery/check.tar.gz", "r:gz") as archive:
    members = {}
    for item in archive:
        name = item.name.removeprefix("./")
        require(name not in members, "duplicate archive member")
        require(not name.startswith("/") and ".." not in name.split("/") and (item.isfile() or item.isdir()), "unsafe archive member")
        members[name] = item
    required = ["tondb/config.json", "controller/initialized.json", "controller/mytoncore/mytoncore.db",
                "controller/services/validator.service", "controller/services/mytoncore.service"]
    require(all(name in members and members[name].isfile() and members[name].size for name in required), "incomplete controller bootstrap")
    for prefix, message in [("tondb/keyring/", "missing ADNL keyring"), ("keys/", "missing node keys")]:
        require(any(name.startswith(prefix) and item.isfile() and item.size for name, item in members.items()), message)
    wallets = [name for name, item in members.items() if name.startswith("controller/mytoncore/wallets/") and name.endswith(".pk") and item.isfile() and item.size]
    require(wallets, "missing wallet private keys")
    require(all(name[:-3] + ".addr" in members and members[name[:-3] + ".addr"].isfile() and members[name[:-3] + ".addr"].size for name in wallets), "missing wallet address files")
    config = json.load(archive.extractfile(members["tondb/config.json"]))
    require(config.get("addrs"), "missing advertised addresses")
PY
}

run_restore_keys_targeted() (
  set -euo pipefail
  umask 077
  require_bin kubectl; require_bin python3; require_bin sha256sum
  local target="${1:-}" input_dir="" destination="" option ns="" sts="" replicas="" context checked pod ordinal source hostname address port
  [[ -n "$target" ]] || { echo 'Error: usage: kubeton restore-keys <server-name|pod-name|namespace/pod> [backup-dir] [--to-node server]' >&2; exit 1; }
  shift
  while (( $# )); do
    case "$1" in
      --to-node) (( $# >= 2 )) && [[ -n "$2" ]] || { echo 'Error: --to-node requires a server name.' >&2; exit 1; }; destination="$2"; shift 2 ;;
      -*) echo "Error: unknown restore-keys option: $1" >&2; exit 1 ;;
      *) [[ -z "$input_dir" && -d "$1" ]] || { echo 'Error: supply at most one existing backup directory.' >&2; exit 1; }; input_dir="$(cd "$1" && pwd)"; shift ;;
    esac
  done
  [[ -f "$CHART_DIR/fleet.py" && -f "$CHART_DIR/fleet-crypto.sh" ]] || { echo 'Error: fleet.py and fleet-crypto.sh must be installed beside kubeton.' >&2; exit 1; }
  get_single_ton_statefulset ns sts replicas || exit 1
  local KUBETON_ADD_MODE=true KUBETON_ADD_CPU_MILLI KUBETON_ADD_MEMORY_BYTES KUBETON_ADD_DATA_BYTES KUBETON_ADD_STS="$sts"
  local KUBETON_ADD_SELECTED_NODE KUBETON_ADD_SELECTED_HOSTNAME
  local -a KUBETON_ADD_HOST_PORTS=() KUBETON_ADD_STORAGE_REQUIREMENTS=() operator_names=() operator_replicas=()
  local -A KUBETON_ADD_OCCUPIED_NODES=()
  TON_NAMESPACE="$ns"
  context="$(ton_restore_plan "$ns" "$sts" "$target")"
  pod="$(ton_add_field "$context" pod)"; ordinal="$(ton_add_field "$context" ordinal)"; source="$(ton_add_field "$context" source)"
  ton_add_admit_node "$context" "$destination"
  destination="$KUBETON_ADD_SELECTED_NODE"; hostname="$KUBETON_ADD_SELECTED_HOSTNAME"
  [[ "$destination" != "$source" ]] || { echo 'Error: replacement must use a different unoccupied server.' >&2; exit 1; }
  local label
  while IFS= read -r label; do [[ -z "$label" ]] || kubectl label node "$destination" "$label" --overwrite >/dev/null; done < <(ton_add_field "$context" managed | python3 -c 'import json,sys; print("\n".join(k+"="+v for k,v in json.load(sys.stdin).items()))')
  if is_true "$(ton_add_field "$context" longhorn)"; then wait_ton_selected_nodes_longhorn_csi_ready "kubernetes.io/hostname=${hostname}"; fi
  address="$(kubectl get node "$destination" -o json | python3 -c 'import json,ipaddress,sys; a=json.load(sys.stdin)["status"]["addresses"]; values=[x["address"] for kind in ("ExternalIP","InternalIP") for x in a if x["type"]==kind]; print(next(x for x in values if isinstance(ipaddress.ip_address(x),ipaddress.IPv4Address)))')"
  port="$(kubectl -n "$ns" get statefulset "$sts" -o jsonpath='{.spec.template.spec.containers[?(@.name=="ton-node")].ports[?(@.name=="validator-udp")].containerPort}')"
  [[ "$port" =~ ^[0-9]+$ ]] || { echo 'Error: cannot resolve the live validator UDP port.' >&2; exit 1; }
  if [[ -n "$input_dir" ]]; then echo 'Warning: an external backup restores only the wallets and identity state captured in that snapshot; newer changes are not included.' >&2; fi
  confirm_or_exit "Recover only ${ns}/${pod} from ${source} onto ${destination} (advertised IPv4 ${address})? The target blockchain database will be replaced and resynchronized; sibling pods keep running."
  local checkpoint helper="" orphaned=0 operator_paused=0 finished=0 enc meta bundle_dir
  checkpoint="$(mktemp -d "$PWD/kubeton-recovery-${sts}-${ordinal}-$(date -u +%Y%m%dT%H%M%SZ).XXXXXX")"
  chmod 700 "$checkpoint"
  cleanup_targeted_restore() {
    local rc=$?
    trap - EXIT
    if [[ -n "$helper" ]]; then kubectl -n "$ns" delete pod "$helper" --ignore-not-found --wait=true --timeout=120s >/dev/null 2>&1 || true; fi
    if (( operator_paused && ! orphaned )); then ton_add_resume_operator operator_names operator_replicas || rc=1; fi
    if (( ! finished )); then
      echo "Error: targeted recovery stopped. Protected recovery checkpoint: ${checkpoint}" >&2
      if (( orphaned )); then echo "Error: operator reconciliation remains paused. Healthy orphaned pods remain running. Do not run start/add/install or resume the operator until the target bundle and claims in this checkpoint have been reviewed." >&2; fi
    fi
    exit "$rc"
  }
  trap cleanup_targeted_restore EXIT
  trap 'exit 130' INT; trap 'exit 143' TERM
  printf '%s\n' "$context" > "$checkpoint/plan.json"
  kubectl -n "$ns" get statefulset "$sts" -o json > "$checkpoint/statefulset.json"
  kubectl -n "$ns" get tonnodes.ton.ton.org "$sts" -o json > "$checkpoint/tonnode.json"
  printf 'prepared\n' > "$checkpoint/phase"
  mkdir "$checkpoint/source" "$checkpoint/rebound"
  enc="$(ton_add_field "$context" enc)"; meta="$(ton_add_field "$context" meta)"
  if [[ -n "$input_dir" ]]; then
    bundle_dir="$input_dir/$ns/$sts/$ordinal/bundle"
    [[ -d "$bundle_dir" && -f "$input_dir/$ns/$sts/$ordinal/SHA256SUMS" ]] || { echo 'Error: targeted external restore requires its bundle directory and SHA256SUMS.' >&2; exit 1; }
    (cd "$input_dir/$ns/$sts/$ordinal" && sha256sum -c SHA256SUMS >/dev/null)
    key_bundle_upload_checksums "$bundle_dir" >/dev/null
    cp "$bundle_dir/$enc" "$bundle_dir/$meta" "$checkpoint/source/"
  else
    # A retained bundle may predate wallets created since the last backup.
    # Refresh only the target, then capture the committed pair twice around
    # the copy. Failure requires an explicit external snapshot instead.
    local before after
    trigger_key_backup_once "$ns" "$pod" || { echo 'Error: cannot create a current target backup; supply an explicit usable backup directory if the source is damaged. No node storage was changed.' >&2; exit 1; }
    before="$(kubectl -n "$ns" exec "$pod" -c key-backup -- sh -ec 'cd /var/ton-key-bundle; test ! -e .backup-publish; sha256sum "$KEY_BUNDLE_FILE" "$KEY_BUNDLE_META_FILE"')" || { echo 'Error: retained encrypted bundle is inaccessible; supply a verified backup directory. No node storage was changed.' >&2; exit 1; }
    kubectl -n "$ns" cp -c key-backup "$pod:/var/ton-key-bundle/$enc" "$checkpoint/source/$enc"
    kubectl -n "$ns" cp -c key-backup "$pod:/var/ton-key-bundle/$meta" "$checkpoint/source/$meta"
    after="$(kubectl -n "$ns" exec "$pod" -c key-backup -- sh -ec 'cd /var/ton-key-bundle; test ! -e .backup-publish; sha256sum "$KEY_BUNDLE_FILE" "$KEY_BUNDLE_META_FILE"')"
    [[ "$before" == "$after" ]] || { echo 'Error: encrypted bundle changed during capture; retry.' >&2; exit 1; }
    (cd "$checkpoint/source" && printf '%s\n' "$after" | sha256sum -c - >/dev/null)
  fi
  helper="kubeton-recover-check-$RANDOM-$RANDOM"
  ton_restore_helper_manifest "$helper" "$destination" "$KUBETON_FLEET_TOOLS_IMAGE" verify "$ordinal" < "$checkpoint/statefulset.json" | kubectl create -f - >/dev/null
  kubectl -n "$ns" wait --for=condition=Ready "pod/$helper" --timeout="$HELPER_POD_READY_TIMEOUT" >/dev/null
  kubectl -n "$ns" cp "$checkpoint/source/$enc" "$helper:/bundle/$enc" >/dev/null
  kubectl -n "$ns" cp "$checkpoint/source/$meta" "$helper:/bundle/$meta" >/dev/null
  kubectl -n "$ns" cp "$CHART_DIR/fleet.py" "$helper:/recovery/fleet.py" >/dev/null
  local validation
  validation="$(ton_restore_archive_validation_script)"
  kubectl -n "$ns" exec "$helper" -- sh -ec '
    ulimit -c 0
    test ! -L /recovery && test "$(stat -f -c %T /recovery)" = tmpfs
    test ! -L /tmp && test "$(stat -f -c %T /tmp)" = tmpfs
    awk '\''NR > 1 { used = 1 } END { exit used }'\'' /proc/swaps || { echo "Error: recovery requires a worker with swap disabled." >&2; exit 1; }
    crypto="$1"; validation="$2"; address="$3"; port="$4"
    metadata="/bundle/$KEY_BUNDLE_META_FILE"
    test "$(awk -F= '\''$1 == "provider" {print $2}'\'' "$metadata")" = vault
    test "$(awk -F= '\''$1 == "algorithm" {print $2}'\'' "$metadata")" = aes-256-cbc-pbkdf2
    data_key="$(sh -ec "$crypto" -- unwrap < "/bundle/$KEY_BUNDLE_META_FILE")"
    export DATA_KEY_B64="$data_key"
    trap "rm -f /recovery/check.tar.gz" EXIT
    openssl enc -d -aes-256-cbc -pbkdf2 -md sha256 -pass env:DATA_KEY_B64 -in "/bundle/$KEY_BUNDLE_FILE" -out /recovery/check.tar.gz
    python3 -c "$validation"
    printf "%s\n" "$data_key" | sh -ec "$crypto" -- restore "$address" "$port"
  ' _ "$(cat "$CHART_DIR/fleet-crypto.sh")" "$validation" "$address" "$port" >/dev/null
  kubectl -n "$ns" cp "$helper:/bundle/$enc" "$checkpoint/rebound/$enc" >/dev/null
  kubectl -n "$ns" cp "$helper:/bundle/$meta" "$checkpoint/rebound/$meta" >/dev/null
  kubectl -n "$ns" delete pod "$helper" --wait=true --timeout=120s >/dev/null; helper=""
  checked="$(ton_restore_plan "$ns" "$sts" "$target")"
  [[ "$checked" == "$context" ]] || { echo 'Error: fleet identity or claims changed during validation; rerun recovery.' >&2; exit 1; }
  ton_add_admit_node "$context" "$destination"
  [[ "$KUBETON_ADD_SELECTED_HOSTNAME" == "$hostname" ]] || { echo 'Error: destination hostname changed.' >&2; exit 1; }
  operator_paused=1
  pause_operator_reconcile operator_names operator_replicas
  (( ${#operator_names[@]} > 0 )) || { echo 'Error: cannot safely pause the TonNode operator.' >&2; exit 1; }
  printf '%s\n' "${operator_names[@]}" > "$checkpoint/operator-names"
  printf '%s\n' "${operator_replicas[@]}" > "$checkpoint/operator-replicas"
  kubectl -n "$OP_NAMESPACE" wait --for=delete pod -l "app.kubernetes.io/instance=${RELEASE_NAME}" --timeout=120s >/dev/null
  checked="$(ton_restore_plan "$ns" "$sts" "$target")"
  [[ "$checked" == "$context" ]] || { echo 'Error: fleet changed while pausing reconciliation.' >&2; exit 1; }
  local retention_patch
  retention_patch="$(python3 -c 'import json,sys; s=json.load(sys.stdin); print(json.dumps([{"op":"test","path":"/metadata/uid","value":s["metadata"]["uid"]},{"op":"test","path":"/spec","value":s["spec"]},{"op":"add","path":"/spec/updateStrategy","value":{"type":"OnDelete"}},{"op":"add","path":"/spec/persistentVolumeClaimRetentionPolicy","value":{"whenDeleted":"Retain","whenScaled":"Retain"}}]))' < "$checkpoint/statefulset.json")"
  kubectl -n "$ns" patch statefulset "$sts" --type=json -p "$retention_patch" >/dev/null
  # Fetch the retention-safe snapshot which is recreated after staging.
  kubectl -n "$ns" get statefulset "$sts" -o json > "$checkpoint/statefulset.json"
  printf 'orphaning\n' > "$checkpoint/phase"
  orphaned=1
  kubectl -n "$ns" delete statefulset "$sts" --cascade=orphan --wait=true --timeout=120s >/dev/null
  # API deletion alone cannot fence a validator on an unreachable machine.
  # Require a live stop acknowledgement before the replacement can start.
  kubectl -n "$ns" exec "$pod" -c ton-node -- sh -ec 'systemctl stop validator mytoncore; ! systemctl is-active --quiet validator; ! systemctl is-active --quiet mytoncore' >/dev/null || {
    echo 'Error: cannot verify that the original validator and MyTonCore stopped. The replacement identity was not started; fence/recover the source before proceeding.' >&2; exit 1;
  }
  [[ "$(kubectl -n "$ns" get pod "$pod" -o jsonpath='{.metadata.uid}')" == "$(ton_add_field "$context" pod_uid)" ]] || { echo 'Error: source Pod identity changed while stopping services.' >&2; exit 1; }
  kubectl -n "$ns" delete pod "$pod" --wait=true --timeout=300s >/dev/null
  printf 'target-stopped\n' > "$checkpoint/phase"
  local claim claim_uid pv pv_uid current rows
  rows="$(printf '%s' "$context" | python3 -c 'import json,sys; print("\n".join("\t".join(x[k] for k in ("name","uid","pv","pv_uid")) for x in json.load(sys.stdin)["old_claims"]))')"
  while IFS=$'\t' read -r claim claim_uid pv pv_uid; do
    current="$(kubectl -n "$ns" get pvc "$claim" -o jsonpath='{.metadata.uid}')"; [[ "$current" == "$claim_uid" ]] || { echo 'Error: target PVC identity changed.' >&2; exit 1; }
    current="$(kubectl get pv "$pv" -o jsonpath='{.metadata.uid}')"; [[ "$current" == "$pv_uid" ]] || { echo 'Error: target PV identity changed.' >&2; exit 1; }
    kubectl get pv "$pv" -o json > "$checkpoint/$claim.pv.json"
    kubectl -n "$ns" get pvc "$claim" -o json > "$checkpoint/$claim.pvc.json"
    kubectl patch pv "$pv" --type=merge -p '{"spec":{"persistentVolumeReclaimPolicy":"Retain"}}' >/dev/null
    kubectl -n "$ns" delete pvc "$claim" --wait=true --timeout=300s >/dev/null
  done <<< "$rows"
  printf 'old-volumes-retained\n' > "$checkpoint/phase"
  python3 -c 'import json,sys; s=json.load(sys.stdin); n=int(sys.argv[1]); print(json.dumps({"apiVersion":"v1","kind":"List","items":[{"apiVersion":"v1","kind":"PersistentVolumeClaim","metadata":{"name":t["metadata"]["name"]+"-"+s["metadata"]["name"]+"-"+str(n),"namespace":s["metadata"]["namespace"],"labels":t["metadata"].get("labels",{})},"spec":t["spec"]} for t in s["spec"]["volumeClaimTemplates"]]}))' "$ordinal" < "$checkpoint/statefulset.json" | kubectl create -f - >/dev/null
  helper="kubeton-recover-stage-$RANDOM-$RANDOM"
  ton_restore_helper_manifest "$helper" "$destination" "$KUBETON_FLEET_TOOLS_IMAGE" stage "$ordinal" < "$checkpoint/statefulset.json" | kubectl create -f - >/dev/null
  kubectl -n "$ns" wait --for=condition=Ready "pod/$helper" --timeout="$HELPER_POD_READY_TIMEOUT" >/dev/null
  [[ "$(kubectl -n "$ns" get pod "$helper" -o jsonpath='{.spec.nodeName}')" == "$destination" ]] || { echo 'Error: staging helper landed on the wrong server.' >&2; exit 1; }
  local checksums staging="/bundle/.restore-upload-$RANDOM-$RANDOM"
  checksums="$(key_bundle_upload_checksums "$checkpoint/rebound")"
  kubectl -n "$ns" exec "$helper" -- mkdir -p "$staging"
  kubectl -n "$ns" cp "$checkpoint/rebound/." "$helper:$staging" >/dev/null
  commit_uploaded_key_bundle "$ns" "$helper" /bundle "$staging" "$checksums"
  # A restored initialized.json intentionally retains controller settings.
  # Request database bootstrap separately, so -d is honored on fresh storage
  # without reinstalling MyTonCtrl or recreating validator/wallet identities.
  local bootstrap_request
  bootstrap_request="$(python3 -c 'import json,sys; print(json.dumps({"version":1,"args":json.load(sys.stdin)["spec"].get("args",[])}))' < "$checkpoint/tonnode.json")"
  kubectl -n "$ns" exec "$helper" -- sh -ec 'umask 077; printf "%s\n" "$1" > /bundle/.restore-node-bootstrap.json.tmp; mv /bundle/.restore-node-bootstrap.json.tmp /bundle/.restore-node-bootstrap.json; sync' _ "$bootstrap_request"
  printf 'identity-staged\n' > "$checkpoint/phase"
  kubectl -n "$ns" delete pod "$helper" --wait=true --timeout=120s >/dev/null; helper=""
  kubectl get nodes -o json > "$checkpoint/nodes.json"
  python3 -c '
import copy,json,sys
root=sys.argv[1]; node=sys.argv[2]; map_key=sys.argv[3]; s=json.load(open(root+"/statefulset.json")); c=json.load(open(root+"/plan.json")); nodes=json.load(open(root+"/nodes.json")); hosts={n["metadata"]["name"]:n["metadata"].get("labels",{}).get("kubernetes.io/hostname",n["metadata"]["name"]) for n in nodes["items"]}; mapping=dict(c["running"]); mapping[str(c["ordinal"])]=node
s["metadata"]={k:v for k,v in s["metadata"].items() if k in ("name","namespace","labels","annotations","ownerReferences")}; s.pop("status",None); s["metadata"].setdefault("annotations",{})[map_key]=",".join(k+"="+v for k,v in sorted(mapping.items(),key=lambda x:int(x[0]))); s["spec"]["updateStrategy"]={"type":"OnDelete"}; spec=s["spec"]["template"]["spec"]; spec.setdefault("affinity",{})["nodeAffinity"]={"requiredDuringSchedulingIgnoredDuringExecution":{"nodeSelectorTerms":[{"matchExpressions":[{"key":"kubernetes.io/hostname","operator":"In","values":sorted({hosts[n] for n in mapping.values()})}]}]}}
# Refresh the shared helper while retaining the operator-managed recovery
# init. Only the fresh target bundle has a bootstrap request.
main=next(container for container in spec["containers"] if container["name"]=="ton-node")
bootstrap={key:copy.deepcopy(main[key]) for key in ("image","imagePullPolicy","env","envFrom","resources","volumeMounts") if key in main}
bootstrap.update(name="restore-node-bootstrap",command=["/opt/mytonctrl/venv/bin/python","-c",open(sys.argv[4]).read(),"restore-bootstrap"],terminationMessagePolicy="FallbackToLogsOnError")
spec["initContainers"]=[container for container in spec.get("initContainers",[]) if container["name"]!="restore-node-bootstrap"]+[bootstrap]
print(json.dumps(s))
' "$checkpoint" "$destination" "$STICKY_ORDINAL_NODE_MAP_ANNOTATION_KEY" "$CHART_DIR/fleet.py" > "$checkpoint/replacement-statefulset.json"
  kubectl create -f "$checkpoint/replacement-statefulset.json" >/dev/null
  printf 'statefulset-recreated\n' > "$checkpoint/phase"
  # Adoption is an API operation, independent of the recovered node syncing.
  local deadline=$(( $(date +%s) + 120 )) adopted=false
  while (( $(date +%s) < deadline )); do
    current="$(kubectl -n "$ns" get statefulset "$sts" -o jsonpath='{.metadata.uid}')"
    checked="$(kubectl -n "$ns" get pods -o json)"
    if printf '%s\0%s' "$context" "$checked" | python3 -c 'import json,sys; c,p=map(json.loads,sys.stdin.read().split("\0")); actual={x["metadata"]["name"]:x for x in p["items"]}; owned=lambda x:any(o.get("controller") and o.get("uid")==sys.argv[1] for o in x["metadata"].get("ownerReferences",[])); target=actual.get(c["pod"]); ok=all(name in actual and actual[name]["metadata"]["uid"]==uid and owned(actual[name]) for name,uid in c["siblings"].items()) and target and target["metadata"]["uid"]!=c["pod_uid"] and owned(target) and target.get("spec",{}).get("nodeName",sys.argv[2])==sys.argv[2]; sys.exit(0 if ok else 1)' "$current" "$destination"; then adopted=true; break; fi
    sleep 2
  done
  is_true "$adopted" || { echo 'Error: could not verify adoption of every unchanged sibling pod; operator remains paused.' >&2; exit 1; }
  ton_add_resume_operator operator_names operator_replicas
  operator_paused=0; orphaned=0; finished=1
  printf 'complete\n' > "$checkpoint/phase"
  echo "[restore-keys] ${ns}/${pod} recovery started on ${destination}; wallet keys and ADNL identity from the verified backup preserved, advertised IPv4 updated to ${address}."
  echo '[restore-keys] Preserved installation arguments are used for recovery, including dump download when -d/DUMP is enabled.'
  echo '[restore-keys] Blockchain synchronization continues in the background. Check: ./kubeton status'
  echo "[restore-keys] Original target volumes and protected recovery checkpoint retained: ${checkpoint}"
)

run_restore_keys() {
  if [[ $# -ne 1 || ! -d "${1:-}" ]]; then
    run_restore_keys_targeted "$@"
    return
  fi
  require_bin kubectl
  require_bin sha256sum

  if [[ $# -ne 1 ]]; then
    echo "Error: usage: kubeton restore-keys <input-dir>" >&2
    exit 1
  fi
  local input_dir="$1"
  if [[ ! -d "$input_dir" ]]; then
    echo "Error: restore input dir not found: $input_dir" >&2
    exit 1
  fi
  input_dir="$(cd "$input_dir" && pwd)"

  local -a sts_rows=()
  mapfile -t sts_rows < <(list_ton_statefulsets)
  if [[ ${#sts_rows[@]} -eq 0 || -z "${sts_rows[0]}" ]]; then
    echo "No TON StatefulSets found."
    return
  fi

  confirm_or_exit "This will overwrite encrypted key bundles from ${input_dir} and restart TON StatefulSets. Missing replica backups will be reported and skipped. Continue?"

  local -a ns_list=()
  local -a sts_list=()
  local -a replicas_list=()
  local -A ordinal_node_maps=()
  local -A helper_nodes_by_replica=()
  local -a operator_deploy_names=()
  local -a operator_deploy_replicas=()
  local row ns sts replicas i ordinal node_map_key node_map
  local operator_paused=0
  for row in "${sts_rows[@]}"; do
    [[ -z "$row" ]] && continue
    IFS=$'\t' read -r ns sts replicas <<<"$row"
    replicas="$(trim_whitespace "${replicas:-0}")"
    if ! [[ "$replicas" =~ ^[0-9]+$ ]]; then
      replicas=0
    fi
    ns_list+=("$ns")
    sts_list+=("$sts")
    replicas_list+=("$replicas")
    if (( replicas > 0 )); then
      node_map_key="${ns}/${sts}"
      node_map="$(build_sts_ordinal_node_map "$ns" "$sts" "$replicas" || true)"
      node_map="$(trim_whitespace "$node_map")"
      if [[ -n "$node_map" ]]; then
        ordinal_node_maps["$node_map_key"]="$node_map"
      fi
    fi
  done

  for i in "${!sts_list[@]}"; do
    ns="${ns_list[$i]}"
    sts="${sts_list[$i]}"
    replicas="${replicas_list[$i]}"
    if ! [[ "$replicas" =~ ^[0-9]+$ ]]; then
      replicas=0
    fi
    if (( replicas == 0 )); then
      continue
    fi

    for ordinal in $(seq 0 $((replicas - 1))); do
      local pod="${sts}-${ordinal}"
      local helper_key="${ns}/${sts}/${ordinal}"
      local pod_node=""
      pod_node="$(kubectl -n "$ns" get pod "$pod" -o jsonpath='{.spec.nodeName}' 2>/dev/null || true)"
      pod_node="$(trim_whitespace "$pod_node")"
      if [[ -n "$pod_node" ]]; then
        helper_nodes_by_replica["$helper_key"]="$pod_node"
      fi
    done
  done

  local restore_required=1
  cleanup_restore() {
    [[ "${restore_required:-0}" -ne 1 ]] && return 0
    local i ns sts replicas node_map_key node_map
    local -a expected_nodes=()
    for i in "${!sts_list[@]}"; do
      ns="${ns_list[$i]}"
      sts="${sts_list[$i]}"
      replicas="${replicas_list[$i]}"
      if [[ "$replicas" =~ ^[1-9][0-9]*$ ]]; then
        node_map_key="${ns}/${sts}"
        node_map="${ordinal_node_maps[$node_map_key]:-}"
        expected_nodes=()
        if [[ -n "$node_map" ]] \
          && parse_ordinal_node_map "$node_map" expected_nodes \
          && (( ${#expected_nodes[@]} >= replicas )) \
          && restore_statefulset_with_expected_nodes "$ns" "$sts" "$replicas" expected_nodes >/dev/null 2>&1; then
          continue
        fi
      fi
      set_ton_replicas "$ns" "$sts" "$replicas" >/dev/null 2>&1 || true
    done
    if [[ "${operator_paused:-0}" -eq 1 ]]; then
      resume_operator_reconcile operator_deploy_names operator_deploy_replicas || true
    fi
  }
  trap cleanup_restore EXIT INT TERM

  pause_operator_reconcile operator_deploy_names operator_deploy_replicas
  operator_paused=1

  echo "Scaling TON StatefulSets to 0 ..."
  for i in "${!sts_list[@]}"; do
    set_ton_replicas "${ns_list[$i]}" "${sts_list[$i]}" 0
  done
  for i in "${!sts_list[@]}"; do
    wait_statefulset_pods_gone "${ns_list[$i]}" "${sts_list[$i]}"
  done

  echo "Restoring encrypted bundles from $input_dir (parallel) ..."
  local restored_count=0
  local skipped_missing_count=0
  local failed_count=0
  local -a restore_pids=()
  local -a restore_descs=()
  for i in "${!sts_list[@]}"; do
    ns="${ns_list[$i]}"
    sts="${sts_list[$i]}"
    replicas="${replicas_list[$i]}"
    if ! [[ "$replicas" =~ ^[0-9]+$ ]]; then
      replicas=0
    fi
    if (( replicas == 0 )); then
      continue
    fi

    for ordinal in $(seq 0 $((replicas - 1))); do
      local helper_key="${ns}/${sts}/${ordinal}"
      local helper_node="${helper_nodes_by_replica[$helper_key]:-}"
      restore_replica_from_backup "$ns" "$sts" "$ordinal" "$input_dir" "$helper_node" &
      restore_pids+=("$!")
      restore_descs+=("${ns}/${sts}/${ordinal}")
    done
  done

  for i in "${!restore_pids[@]}"; do
    local restore_rc=0
    if wait "${restore_pids[$i]}"; then
      restore_rc=0
    else
      restore_rc=$?
    fi
    case "$restore_rc" in
      0)
        ((restored_count+=1))
        ;;
      10)
        ((skipped_missing_count+=1))
        ;;
      *)
        echo "Error: encrypted bundle restore failed for ${restore_descs[$i]}." >&2
        ((failed_count+=1))
        ;;
    esac
  done

  echo "Restoring TON StatefulSets replicas with sticky node placement ..."
  local sticky_restore_count=0
  local sticky_restore_failed=0
  local -a expected_nodes=()
  for i in "${!sts_list[@]}"; do
    ns="${ns_list[$i]}"
    sts="${sts_list[$i]}"
    replicas="${replicas_list[$i]}"
    if ! [[ "$replicas" =~ ^[0-9]+$ ]]; then
      replicas=0
    fi
    if (( replicas == 0 )); then
      set_ton_replicas "$ns" "$sts" 0
      continue
    fi

    node_map_key="${ns}/${sts}"
    node_map="${ordinal_node_maps[$node_map_key]:-}"
    if [[ -z "$node_map" ]]; then
      echo "Error: missing pre-restore ordinal->node map for ${ns}/${sts}; refusing non-sticky restore." >&2
      ((sticky_restore_failed+=1))
      continue
    fi

    expected_nodes=()
    if ! parse_ordinal_node_map "$node_map" expected_nodes; then
      echo "Error: invalid pre-restore ordinal->node map for ${ns}/${sts}; refusing non-sticky restore." >&2
      ((sticky_restore_failed+=1))
      continue
    fi
    if (( ${#expected_nodes[@]} < replicas )); then
      echo "Error: incomplete pre-restore ordinal->node map for ${ns}/${sts} (have ${#expected_nodes[@]}, need ${replicas})." >&2
      ((sticky_restore_failed+=1))
      continue
    fi
    if restore_statefulset_with_expected_nodes "$ns" "$sts" "$replicas" expected_nodes; then
      ((sticky_restore_count+=1))
    else
      echo "Error: failed sticky-node restore for ${ns}/${sts} after restore-keys." >&2
      ((sticky_restore_failed+=1))
    fi
  done
  echo "Restore node placement summary: restored=${sticky_restore_count}, failed=${sticky_restore_failed}"
  if (( sticky_restore_failed > 0 )); then
    return 1
  fi
  if [[ "$operator_paused" -eq 1 ]]; then
    resume_operator_reconcile operator_deploy_names operator_deploy_replicas
    operator_paused=0
  fi

  restore_required=0
  trap - EXIT INT TERM
  echo "Restore summary: restored=${restored_count}, skipped_missing=${skipped_missing_count}, failed=${failed_count}"
  if (( failed_count > 0 )); then
    echo "Error: encrypted key bundle restore failed for ${failed_count} replica(s)." >&2
    return 1
  fi
  if (( restored_count == 0 )); then
    echo "Warning: no replica bundles were restored."
  fi
  echo "Encrypted key bundle restore complete. Pods will restore key material during startup."
}

run_stop_without_backup() {
  require_bin helm
  local -a helm_cmd=(
    helm upgrade "$RELEASE_NAME" "$CHART_DIR"
    -n "$OP_NAMESPACE"
    -f "$OP_VALUES_FILE"
    --set tonNode.enabled=false
  )

  append_helm_force_conflicts_if_supported helm_cmd
  "${helm_cmd[@]}"
}

run_stop_backup() {
  require_bin kubectl

  mapfile -t pod_rows < <(list_ton_pods)
  if [[ ${#pod_rows[@]} -eq 0 || -z "${pod_rows[0]}" ]]; then
    echo "No TON pods found; skipping stop-time key backup."
    return 0
  fi

  echo "Triggering stop-time encrypted key backup in running TON pods ..."
  local -a failed_pods=()
  local row ns pod
  local skipped_count=0
  local backed_up_count=0
  local container_names=""
  for row in "${pod_rows[@]}"; do
    [[ -z "$row" ]] && continue
    IFS=$'\t' read -r ns pod _ <<<"$row"

    container_names="$(kubectl -n "$ns" get pod "$pod" -o jsonpath='{.spec.containers[*].name}' 2>/dev/null || true)"
    if ! grep -qw "key-backup" <<<"$container_names"; then
      echo "Warning: ${ns}/${pod} has no key-backup sidecar; skipping stop-time backup." >&2
      ((skipped_count+=1))
      continue
    fi

    if trigger_key_backup_once "$ns" "$pod" && pod_has_encrypted_bundle "$ns" "$pod"; then
      ((backed_up_count+=1))
      continue
    fi
    echo "Error: ${ns}/${pod} did not produce encrypted bundle files after stop-time backup trigger." >&2
    failed_pods+=("${ns}/${pod}")
  done

  if [[ ${#failed_pods[@]} -gt 0 ]]; then
    echo "Error: stop-time key backup failed for: ${failed_pods[*]}" >&2
    echo "Refusing to stop TON pods to avoid losing in-memory keys." >&2
    echo "If you want to force pod stop anyway, run: SKIP_STOP_KEY_BACKUP=true ./kubeton stop" >&2
    echo "Or disable TON via Helm directly: helm upgrade $RELEASE_NAME $CHART_DIR -n $OP_NAMESPACE -f $OP_VALUES_FILE --set tonNode.enabled=false" >&2
    return 1
  fi

  echo "Stop-time key backup summary: backed_up=${backed_up_count}, skipped=${skipped_count}"
}

run_stop() {
  if [[ $# -ne 0 ]]; then
    echo "Error: usage: kubeton stop" >&2
    exit 1
  fi
  run_stop_fleet || return $?
  stop_managed_dashboard_workloads
}

# Dashboard shutdown preserves provisioned configuration and login Secrets.
# Only deployments carrying both kubeton ownership and a dashboard component
# label are eligible. Record replicas on the resource so another CLI machine
# can resume the same dashboards without local state or creating new ones.
managed_dashboard_deployment_rows() {
  kubectl get deployments -A \
    -l 'app.kubernetes.io/managed-by=kubeton,app.kubernetes.io/name in (kubeton-prometheus,kubeton-grafana)' \
    -o 'jsonpath={range .items[*]}{.metadata.namespace}{"|"}{.metadata.name}{"|"}{.spec.replicas}{"|"}{.metadata.annotations.ton\.ton\.org/kubeton-dashboard-paused-replicas}{"|"}{.metadata.uid}{"|"}{.metadata.resourceVersion}{"|"}{.metadata.labels.app\.kubernetes\.io/name}{"\n"}{end}'
}

wait_managed_dashboard_stopped() {
  local ns="$1" name="$2" component="$3" selector pod_names pod
  local -a wait_args=()
  selector="app.kubernetes.io/name=${component}"
  if [[ "$component" == kubeton-prometheus ]]; then
    selector+=",app.kubernetes.io/instance=${name}"
  fi
  # Wait for the controller to observe replicas=0 before taking the final
  # Pod inventory. Include older Pods whose templates lack managed-by labels.
  kubectl -n "$ns" rollout status "deployment/${name}" --timeout=180s >/dev/null || return 1
  pod_names="$(kubectl -n "$ns" get pods -l "$selector" \
    -o 'jsonpath={range .items[*]}{.metadata.name}{"\n"}{end}')" || return 1
  while IFS= read -r pod; do
    [[ -n "$pod" ]] && wait_args+=("pod/$pod")
  done <<<"$pod_names"
  if (( ${#wait_args[@]} > 0 )); then
    kubectl -n "$ns" wait --for=delete "${wait_args[@]}" --timeout=180s >/dev/null || return 1
  fi
}

stop_managed_dashboard_workloads() {
  local inventory ns name replicas saved uid version component patch rc=0 count=0
  cleanup_prometheus_port_forwards
  cleanup_grafana_port_forwards
  inventory="$(managed_dashboard_deployment_rows)" || {
    echo "Error: cannot inventory managed dashboards; shutdown could not be verified." >&2
    return 1
  }
  while IFS='|' read -r ns name replicas saved uid version component; do
    [[ -n "$ns" && -n "$name" ]] || continue
    replicas="${replicas:-1}"
    if [[ ! "$replicas" =~ ^[0-9]+$ || -z "$uid" || -z "$version" \
      || ! "$component" =~ ^kubeton-(prometheus|grafana)$ \
      || ( -n "$saved" && ! "$saved" =~ ^[0-9]+$ ) ]]; then
      echo "Error: invalid dashboard shutdown state for ${ns}/${name}; no change made." >&2
      rc=1; continue
    fi
    if (( replicas > 0 )); then saved="$replicas"; fi
    if [[ -n "$saved" ]]; then
      printf -v patch '{"metadata":{"uid":"%s","resourceVersion":"%s","annotations":{"ton.ton.org/kubeton-dashboard-paused-replicas":"%s"}},"spec":{"replicas":0}}' "$uid" "$version" "$saved"
      if ! kubectl -n "$ns" patch deployment "$name" --type=merge -p "$patch" >/dev/null; then
        echo "Error: could not pause managed dashboard ${ns}/${name}." >&2
        rc=1; continue
      fi
    fi
    if ! wait_managed_dashboard_stopped "$ns" "$name" "$component"; then
      echo "Error: managed dashboard ${ns}/${name} still has running or terminating Pods." >&2
      rc=1; continue
    fi
    ((count+=1))
  done <<<"$inventory"
  if (( rc == 0 )); then
    echo "[stop] Paused ${count} managed Prometheus/Grafana deployment(s); credentials and configuration retained, local dashboard listeners closed."
  fi
  return "$rc"
}

resume_stopped_dashboard_workloads() {
  local inventory ns name replicas saved uid version component patch rc=0 count=0
  inventory="$(managed_dashboard_deployment_rows)" || {
    echo "Error: cannot inventory paused dashboards for restart." >&2
    return 1
  }
  while IFS='|' read -r ns name replicas saved uid version component; do
    [[ -n "$ns" && -n "$name" && -n "$saved" ]] || continue
    if [[ ! "$saved" =~ ^[0-9]+$ || -z "$uid" || -z "$version" \
      || ! "$component" =~ ^kubeton-(prometheus|grafana)$ ]]; then
      echo "Error: invalid saved dashboard replicas for ${ns}/${name}; no change made." >&2
      rc=1; continue
    fi
    printf -v patch '{"metadata":{"uid":"%s","resourceVersion":"%s"},"spec":{"replicas":%s}}' "$uid" "$version" "$saved"
    if ! kubectl -n "$ns" patch deployment "$name" --type=merge -p "$patch" >/dev/null \
      || ! kubectl -n "$ns" rollout status "deployment/${name}" --timeout=180s >/dev/null; then
      echo "Error: could not resume managed dashboard ${ns}/${name}." >&2
      rc=1; continue
    fi
    # Keep the resume record until readiness succeeds, so a failed start can
    # be retried. Tests prevent erasing a concurrent new stop or replacement.
    printf -v patch '[{"op":"test","path":"/metadata/uid","value":"%s"},{"op":"test","path":"/spec/replicas","value":%s},{"op":"test","path":"/metadata/annotations/ton.ton.org~1kubeton-dashboard-paused-replicas","value":"%s"},{"op":"remove","path":"/metadata/annotations/ton.ton.org~1kubeton-dashboard-paused-replicas"}]' "$uid" "$saved" "$saved"
    if ! kubectl -n "$ns" patch deployment "$name" --type=json -p "$patch" >/dev/null; then
      echo "Error: dashboard ${ns}/${name} changed during restart; resume state retained." >&2
      rc=1; continue
    fi
    ((count+=1))
  done <<<"$inventory"
  if (( count > 0 )); then
    echo "[start] Resumed ${count} previously paused Prometheus/Grafana deployment(s). Use 'kubeton prometheus start' or 'kubeton grafana start' to open dashboard access."
  fi
  return "$rc"
}

run_stop_fleet() {
  require_bin kubectl
  if [[ $# -ne 0 ]]; then
    echo "Error: usage: kubeton stop" >&2
    exit 1
  fi

  if is_true "$SKIP_STOP_KEY_BACKUP"; then
    echo "SKIP_STOP_KEY_BACKUP=true, skipping stop-time key backup."
  else
    run_stop_backup || return $?
  fi

  local -a sts_rows=()
  local sts_inventory
  sts_inventory="$(list_ton_statefulsets)" || {
    echo "Error: cannot inventory TON StatefulSets; fleet shutdown could not be verified." >&2
    return 1
  }
  mapfile -t sts_rows <<<"$sts_inventory"
  if [[ ${#sts_rows[@]} -eq 0 || -z "${sts_rows[0]}" ]]; then
    echo "No TON StatefulSets found."
    return
  fi

  local row ns sts replicas
  local pause_annotation existing_pause_annotation tonnode_exists tonnode_marker
  local node_map_annotation node_map_patch
  local tonnodes_paused=0
  local fallback_statefulsets_scaled=0

  echo "Stopping TON fleet by setting TonNode replicas to 0 (operator stays running) ..."
  for row in "${sts_rows[@]}"; do
    [[ -z "$row" ]] && continue
    IFS=$'\t' read -r ns sts replicas <<<"$row"
    if [[ -z "$ns" || -z "$sts" ]]; then
      continue
    fi

    if ! [[ "$replicas" =~ ^[0-9]+$ ]]; then
      replicas=0
    fi
    node_map_annotation="$(build_sts_ordinal_node_map "$ns" "$sts" "$replicas" || true)"
    node_map_annotation="$(trim_whitespace "$node_map_annotation")"
    node_map_patch="\"${KUBETON_PAUSE_NODEMAP_ANNOTATION_KEY}\":null"
    if [[ -n "$node_map_annotation" ]]; then
      node_map_patch="\"${KUBETON_PAUSE_NODEMAP_ANNOTATION_KEY}\":\"${node_map_annotation}\""
    elif (( replicas > 0 )); then
      echo "Warning: not saving stopped ordinal node map for ${ns}/${sts}; at least one replica is not scheduled." >&2
    fi

    tonnode_exists=0
    tonnode_marker="$(kubectl -n "$ns" get tonnodes.ton.ton.org "$sts" --ignore-not-found -o name)" || {
      echo "Error: cannot inspect TonNode ${ns}/${sts}; fleet shutdown was stopped." >&2
      return 1
    }
    if [[ -n "$(trim_whitespace "$tonnode_marker")" ]]; then
      tonnode_exists=1
      existing_pause_annotation="$(get_annotation_value tonnodes.ton.ton.org "$ns" "$sts" "$KUBETON_PAUSE_ANNOTATION_KEY")"
    else
      existing_pause_annotation="$(get_annotation_value statefulset "$ns" "$sts" "$KUBETON_PAUSE_ANNOTATION_KEY")"
    fi
    if [[ "$replicas" =~ ^[1-9][0-9]*$ ]]; then
      pause_annotation="$replicas"
    elif [[ "$existing_pause_annotation" =~ ^[1-9][0-9]*$ ]]; then
      pause_annotation="$existing_pause_annotation"
    else
      pause_annotation="$replicas"
    fi

    if (( tonnode_exists == 1 )); then
      kubectl -n "$ns" patch tonnodes.ton.ton.org "$sts" --type=merge \
        -p "{\"metadata\":{\"annotations\":{\"${KUBETON_PAUSE_ANNOTATION_KEY}\":\"${pause_annotation}\",${node_map_patch}}}}" >/dev/null || return 1
      ((tonnodes_paused+=1))
      kubectl -n "$ns" patch statefulset "$sts" --type=merge \
        -p "{\"metadata\":{\"annotations\":{\"${KUBETON_PAUSE_ANNOTATION_KEY}\":\"${pause_annotation}\",${node_map_patch}}}}" >/dev/null 2>&1 || true
    else
      echo "Warning: TonNode ${ns}/${sts} not found; using StatefulSet scale fallback." >&2
      kubectl -n "$ns" patch statefulset "$sts" --type=merge \
        -p "{\"metadata\":{\"annotations\":{\"${KUBETON_PAUSE_ANNOTATION_KEY}\":\"${pause_annotation}\",${node_map_patch}}}}" >/dev/null 2>&1 || true
      set_ton_replicas "$ns" "$sts" 0 || return 1
      ((fallback_statefulsets_scaled+=1))
    fi
  done

  echo "Waiting for TON pods to terminate ..."
  wait_statefulset_rows_pods_gone sts_rows || return 1

  echo "Stop summary: tonnodes_stopped=${tonnodes_paused}, fallback_statefulsets_scaled=${fallback_statefulsets_scaled}, operator_scaled_to_zero=0"
}

run_start_stopped_fleet() {
  require_bin kubectl
  if [[ $# -ne 0 ]]; then
    echo "Error: internal usage: run_start_stopped_fleet does not accept arguments" >&2
    exit 1
  fi

  local target_replicas pause_annotation
  local tonnode_spec_replicas
  local fallback_replicas
  local -a sts_rows=()
  local row row_ns row_sts row_replicas
  local resumed_tonnodes=0
  local resumed_statefulsets=0
  local skipped=0
  local paused_without_annotation=0

  mapfile -t sts_rows < <(list_ton_statefulsets)
  if [[ ${#sts_rows[@]} -eq 0 || -z "${sts_rows[0]}" ]]; then
    echo "No TON StatefulSets found."
    return
  fi

  # Restoring replicas creates Pods just like a Helm scale-up. Revalidate the
  # collector after the caller's operator/PVC recovery work and before the
  # first stopped replica can be recreated.
  if ! verify_start_victoria_logs_collection_ready; then
    restrict_existing_victoria_logs_after_failed_preflight || true
    echo "Error: VictoriaLogs coverage was lost before the stopped TON fleet could be restored." >&2
    return 1
  fi

  echo "Restoring TON fleet from stop annotations ..."
  for row in "${sts_rows[@]}"; do
    [[ -z "$row" ]] && continue
    IFS=$'\t' read -r row_ns row_sts row_replicas <<<"$row"
    if [[ -z "$row_ns" || -z "$row_sts" ]]; then
      continue
    fi
    if ! [[ "$row_replicas" =~ ^[0-9]+$ ]]; then
      row_replicas=0
    fi

    target_replicas=""
    if kubectl -n "$row_ns" get tonnodes.ton.ton.org "$row_sts" >/dev/null 2>&1; then
      tonnode_spec_replicas="$(kubectl -n "$row_ns" get tonnodes.ton.ton.org "$row_sts" -o jsonpath='{.spec.replicas}' 2>/dev/null || true)"
      pause_annotation="$(get_annotation_value tonnodes.ton.ton.org "$row_ns" "$row_sts" "$KUBETON_PAUSE_ANNOTATION_KEY")"
      if ! [[ "$pause_annotation" =~ ^[0-9]+$ ]]; then
        pause_annotation="$(get_annotation_value statefulset "$row_ns" "$row_sts" "$KUBETON_PAUSE_ANNOTATION_KEY")"
      fi
      if [[ "$pause_annotation" =~ ^[0-9]+$ ]]; then
        target_replicas="$(max_positive_replicas "$pause_annotation" "$tonnode_spec_replicas" "$KUBETON_TARGET_TON_REPLICAS")"
        if [[ -z "$target_replicas" ]]; then
          target_replicas="$pause_annotation"
        fi
        if [[ "$target_replicas" != "$pause_annotation" ]]; then
          echo "[start] Restoring ${row_ns}/${row_sts} to ${target_replicas} replicas (pause metadata=${pause_annotation}, requested/spec=${tonnode_spec_replicas:-unknown})."
        fi
        if (( target_replicas > row_replicas )); then
          preapply_stopped_node_mapping_for_statefulset "$row_ns" "$row_sts" "$target_replicas" || true
          kubectl -n "$row_ns" patch tonnodes.ton.ton.org "$row_sts" --field-manager=helm --type=merge \
            -p "{\"metadata\":{\"annotations\":{\"${KUBETON_PAUSE_ANNOTATION_KEY}\":null}},\"spec\":{\"replicas\":${target_replicas}}}" >/dev/null
          clear_statefulset_pause_annotation "$row_ns" "$row_sts"
          ((resumed_tonnodes+=1))
        else
          kubectl -n "$row_ns" patch tonnodes.ton.ton.org "$row_sts" --type=merge \
            -p "{\"metadata\":{\"annotations\":{\"${KUBETON_PAUSE_ANNOTATION_KEY}\":null}}}" >/dev/null 2>&1 || true
          clear_statefulset_pause_annotation "$row_ns" "$row_sts"
          ((skipped+=1))
        fi
      else
        if [[ "$tonnode_spec_replicas" =~ ^[1-9][0-9]*$ ]] && (( tonnode_spec_replicas > row_replicas )); then
          target_replicas="$tonnode_spec_replicas"
          echo "Warning: missing ${KUBETON_PAUSE_ANNOTATION_KEY} on TonNode ${row_ns}/${row_sts}; restoring from TonNode spec.replicas=${target_replicas}."
          preapply_stopped_node_mapping_for_statefulset "$row_ns" "$row_sts" "$target_replicas" || true
          kubectl -n "$row_ns" patch tonnodes.ton.ton.org "$row_sts" --field-manager=helm --type=merge \
            -p "{\"metadata\":{\"annotations\":{\"${KUBETON_PAUSE_ANNOTATION_KEY}\":null}},\"spec\":{\"replicas\":${target_replicas}}}" >/dev/null 2>&1 || true
          clear_statefulset_pause_annotation "$row_ns" "$row_sts"
          ((resumed_tonnodes+=1))
        else
          if (( row_replicas == 0 )); then
            ((paused_without_annotation+=1))
          fi
          ((skipped+=1))
        fi
      fi
      continue
    fi

    pause_annotation="$(get_annotation_value statefulset "$row_ns" "$row_sts" "$KUBETON_PAUSE_ANNOTATION_KEY")"
    if [[ "$pause_annotation" =~ ^[0-9]+$ ]]; then
      fallback_replicas="$(resolve_ton_replicas_from_values_file "$TON_VALUES_FILE" || true)"
      if ! [[ "$fallback_replicas" =~ ^[1-9][0-9]*$ ]]; then
        fallback_replicas="$(resolve_ton_replicas_from_values_file "$CHART_DIR/values.yaml" || true)"
      fi
      target_replicas="$(max_positive_replicas "$pause_annotation" "$fallback_replicas" "$KUBETON_TARGET_TON_REPLICAS")"
      if [[ -z "$target_replicas" ]]; then
        target_replicas="$pause_annotation"
      fi
      if [[ "$target_replicas" != "$pause_annotation" ]]; then
        echo "[start] Restoring ${row_ns}/${row_sts} to ${target_replicas} replicas (pause metadata=${pause_annotation}, values=${fallback_replicas:-unknown})."
      fi
      if (( target_replicas > row_replicas )); then
        preapply_stopped_node_mapping_for_statefulset "$row_ns" "$row_sts" "$target_replicas" || true
        set_ton_replicas "$row_ns" "$row_sts" "$target_replicas"
        ((resumed_statefulsets+=1))
      else
        ((skipped+=1))
      fi
      kubectl -n "$row_ns" patch statefulset "$row_sts" --type=merge -p "{\"metadata\":{\"annotations\":{\"${KUBETON_PAUSE_ANNOTATION_KEY}\":null}}}" >/dev/null 2>&1 || true
    else
      fallback_replicas="$(resolve_ton_replicas_from_values_file "$TON_VALUES_FILE" || true)"
      if ! [[ "$fallback_replicas" =~ ^[1-9][0-9]*$ ]]; then
        fallback_replicas="$(resolve_ton_replicas_from_values_file "$CHART_DIR/values.yaml" || true)"
      fi

      if (( row_replicas == 0 )) && [[ "$fallback_replicas" =~ ^[1-9][0-9]*$ ]]; then
        echo "Warning: missing ${KUBETON_PAUSE_ANNOTATION_KEY} on StatefulSet ${row_ns}/${row_sts}; restoring using values replicas=${fallback_replicas}."
        preapply_stopped_node_mapping_for_statefulset "$row_ns" "$row_sts" "$fallback_replicas" || true
        set_ton_replicas "$row_ns" "$row_sts" "$fallback_replicas"
        ((resumed_statefulsets+=1))
      else
        if (( row_replicas == 0 )); then
          ((paused_without_annotation+=1))
        fi
        ((skipped+=1))
      fi
    fi
  done

  enforce_stopped_node_mappings_after_start || true

  echo "Start summary: tonnodes_restored=${resumed_tonnodes}, statefulsets_restored=${resumed_statefulsets}, skipped=${skipped}, operator_scaled_to_zero=0"
  if (( paused_without_annotation > 0 )); then
    echo "Warning: ${paused_without_annotation} StatefulSet(s) are at replicas=0 without ${KUBETON_PAUSE_ANNOTATION_KEY}; start could not infer target replicas." >&2
    echo "Patch TonNode replicas manually for these StatefulSets." >&2
  fi
}

