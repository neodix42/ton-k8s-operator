  if kubectl -n "$ns" get pvc "$MAIN_WALLET_BUNDLE_PVC" >/dev/null 2>&1; then
    if pvc_has_kubeton_attribution "$ns" "$MAIN_WALLET_BUNDLE_PVC" \
