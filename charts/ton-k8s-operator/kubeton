    echo
    echo "  send <from-wallet-name> <to-tonnode-name> <wallet-name> <amount> [-n]"
    echo "    Send to explicit target wallet name on selected TON pod."
    echo
    echo "  collect <main-wallet-name> [amount]"
    echo "    Collect from all TON pods using validator_wallet_001 into the named main wallet."
    echo "    If [amount] is omitted, mytonctrl mg receives 'alld'."
    echo
    echo "  collect <main-wallet-name> <from-tonnode-name> [wallet-name] [amount]"
    echo "    Collect from one TON pod into the named main wallet."
    echo "    If [wallet-name] is omitted, validator_wallet_001 is used; if [amount] is omitted, 'alld' is used."
    echo
    echo "Notes:"
    echo "  - deploy/send/collect detect the network from the active global.config.json in TON pods."
    echo "  - deploy/send reuse the active global config and select the matching TONCenter endpoint."
    echo "  - A legacy network argument must match detection; it cannot override the active network."
    echo "  - activate runs mytonctrl aw inside TON pods and does not use the kubeton main-wallet BOC sender."
    echo "  - wallet state uses network-matched HTTPS from this machine, with pod lite-server fallback."
    echo "  - export prints private key material to stdout; treat the output as a secret."
    echo "  - collect only runs mytonctrl mg for source wallets confirmed active; unreadable state stops collection."
