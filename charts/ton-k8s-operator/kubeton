bytes_to_human() {
  local bytes="$1"
  if ! [[ "$bytes" =~ ^[0-9]+$ ]]; then
    echo "N/A"
    return
  fi
  awk -v b="$bytes" 'BEGIN {
    if (b < 1024) {
      printf "%.0f B", b
    } else if (b < 1024*1024) {
      printf "%.2f KB", b/1024
    } else if (b < 1024*1024*1024) {
      printf "%.2f MB", b/1024/1024
    } else if (b < 1024*1024*1024*1024) {
      printf "%.2f GB", b/1024/1024/1024
    } else {
      printf "%.2f TB", b/1024/1024/1024/1024
    }
  }'
}

folder_size_gb() {
  local ns="$1"
  local pod="$2"
  local folder="$3"
  local bytes=""

  bytes="$(run_with_timeout "$STATUS_EXEC_TIMEOUT" kubectl -n "$ns" exec "$pod" -- bash -lc "
    bytes=\$(du -s -B1 \"$folder\" 2>/dev/null | cut -f1 | head -n1)
    if [[ \"\$bytes\" =~ ^[0-9]+$ ]]; then
      printf '%s' \"\$bytes\"
      exit 0
    fi
    kbytes=\$(du -sk \"$folder\" 2>/dev/null | cut -f1 | head -n1)
    if [[ \"\$kbytes\" =~ ^[0-9]+$ ]]; then
      printf '%s' \$((kbytes*1024))
      exit 0
    fi
    exit 1
  " 2>/dev/null || true)"
  if [[ -n "$bytes" ]]; then
    bytes="${bytes%%$'\n'*}"
    bytes="$(printf '%s' "$bytes" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')"
    bytes_to_human "$bytes"
    return
  fi

  echo "N/A"
}

sync_value() {
  local ns="$1"
  local pod="$2"
  local output=""
  local sync=""
  local initial_sync_lag=""

  output="$(run_with_timeout "$STATUS_EXEC_TIMEOUT" kubectl -n "$ns" exec "$pod" -- bash -lc '
    shopt -s expand_aliases
    if [[ -f ~/.bashrc ]]; then
      source ~/.bashrc >/dev/null 2>&1
    fi
    if command -v mytonctrl >/dev/null 2>&1; then
      echo status | mytonctrl
    fi
  ' 2>/dev/null || true)"
  output="${output//$'\r'/}"
  output="$(printf '%s' "$output" | sed -E $'s/\x1B\\[[0-9;]*[[:alpha:]]//g')"
  sync="$(printf '%s\n' "$output" | awk -F': *' '
    /^[[:space:]]*Masterchain out of sync:/ {master=$2}
    /^[[:space:]]*Local validator out of sync:/ {local=$2}
    /^[[:space:]]*Shardchain out of sync:/ {shard=$2}
    END {
      if (master != "") print master
      else if (local != "") print local
      else if (shard != "") print shard
    }
  ')"
  sync="$(trim_whitespace "$sync")"

  if [[ -z "$sync" ]]; then
    initial_sync_lag="$(printf '%s\n' "$output" | sed -nE 's/^[[:space:]]*Local validator initial sync status:.*last known block was[[:space:]]*([0-9]+)[[:space:]]*s ago.*/\1 s ago/p' | head -n1)"
    initial_sync_lag="$(trim_whitespace "$initial_sync_lag")"
    if [[ -n "$initial_sync_lag" ]]; then
      sync="$initial_sync_lag"
    fi
  fi

  if [[ -z "$sync" ]]; then
    echo "N/A"
    return
  fi

  echo "$sync"
}

