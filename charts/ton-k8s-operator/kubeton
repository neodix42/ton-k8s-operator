cleanup_dashboard_port_forwards() {
  local state_dir="$1" remote_port="$2"
  local pid_file pid filename ns service_name local_port

  if [[ ! -d "$state_dir" ]]; then
    return 0
  fi

  for pid_file in "$state_dir"/*.pid; do
    [[ -f "$pid_file" ]] || continue
    pid="$(cat "$pid_file" 2>/dev/null || true)"
    filename="${pid_file##*/}"
    if [[ "$filename" =~ ^([a-z0-9.-]+)__([a-z0-9.-]+)__([0-9]+)\.pid$ ]]; then
      ns="${BASH_REMATCH[1]}"
      service_name="${BASH_REMATCH[2]}"
      local_port="${BASH_REMATCH[3]}"
      # Saved process IDs can be reused by unrelated applications.
      if port_forward_process_matches "$pid" "$ns" "$service_name" "$local_port" "$remote_port" ''; then
        kill "$pid" >/dev/null 2>&1 || true
      fi
    elif [[ "$filename" =~ ^proxy-([0-9]+)\.pid$ ]]; then
      local_port="${BASH_REMATCH[1]}"
      if kubectl_proxy_process_matches "$pid" "$local_port"; then
        kill "$pid" >/dev/null 2>&1 || true
      fi
    fi
    rm -f "$pid_file" >/dev/null 2>&1 || true
  done

  rm -rf "$state_dir" >/dev/null 2>&1 || true
}

