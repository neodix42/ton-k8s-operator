main_wallet_timeout_seconds() {
  local raw
  raw="$(trim_whitespace "${MAIN_WALLET_POD_TIMEOUT:-900s}")"
  if [[ "$raw" =~ ^([0-9]+)s?$ ]]; then
    printf '%s' "${BASH_REMATCH[1]}"
    return 0
  fi
  printf '%s' "900"
}

find_main_wallet_template_pvc() {
  local preferred_ns="$1"
  local sts_name=""

  sts_name="$(kubectl -n "$preferred_ns" get statefulsets -l "$TON_POD_LABEL" -o jsonpath='{.items[0].metadata.name}' 2>/dev/null || true)"
  sts_name="$(trim_whitespace "$sts_name")"
  if [[ -n "$sts_name" ]] && kubectl -n "$preferred_ns" get pvc "keybundle-${sts_name}-0" >/dev/null 2>&1; then
    printf '%s\t%s\n' "$preferred_ns" "keybundle-${sts_name}-0"
    return 0
  fi

  local row ns sts
  while IFS= read -r row; do
    [[ -z "$row" ]] && continue
    IFS=$'\t' read -r ns sts _ <<<"$row"
    [[ -z "$ns" || -z "$sts" ]] && continue
    if kubectl -n "$ns" get pvc "keybundle-${sts}-0" >/dev/null 2>&1; then
      printf '%s\t%s\n' "$ns" "keybundle-${sts}-0"
      return 0
    fi
  done < <(list_ton_statefulsets 2>/dev/null || true)
  return 1
}

ensure_main_wallet_bundle_pvc() {
  local ns="$1"
  local pvc_name="$MAIN_WALLET_BUNDLE_PVC"
  local source_row source_ns source_pvc
  local storage_request storage_class volume_mode access_modes_raw
  local -a access_modes=()
  local mode

  if kubectl -n "$ns" get pvc "$pvc_name" >/dev/null 2>&1; then
    return 0
  fi

  source_row="$(find_main_wallet_template_pvc "$ns" || true)"
  source_row="$(trim_whitespace "$source_row")"
  if [[ -n "$source_row" ]]; then
    IFS=$'\t' read -r source_ns source_pvc <<<"$source_row"
    storage_request="$(kubectl -n "$source_ns" get pvc "$source_pvc" -o jsonpath='{.spec.resources.requests.storage}' 2>/dev/null || true)"
    storage_class="$(kubectl -n "$source_ns" get pvc "$source_pvc" -o jsonpath='{.spec.storageClassName}' 2>/dev/null || true)"
    volume_mode="$(kubectl -n "$source_ns" get pvc "$source_pvc" -o jsonpath='{.spec.volumeMode}' 2>/dev/null || true)"
    access_modes_raw="$(kubectl -n "$source_ns" get pvc "$source_pvc" -o jsonpath='{.spec.accessModes[*]}' 2>/dev/null || true)"
    read -r -a access_modes <<<"$access_modes_raw"
  fi

  storage_request="$(trim_whitespace "${storage_request:-}")"
  if [[ -z "$storage_request" ]]; then
    storage_request="$(trim_whitespace "$MAIN_WALLET_BUNDLE_SIZE")"
  fi
  if [[ -z "$storage_request" ]]; then
    storage_request="5Gi"
  fi

  storage_class="$(trim_whitespace "${storage_class:-}")"
  if [[ -z "$storage_class" ]]; then
    storage_class="$(trim_whitespace "$MAIN_WALLET_BUNDLE_STORAGE_CLASS")"
  fi
  ensure_main_wallet_longhorn_ready "$storage_class"

  volume_mode="$(trim_whitespace "${volume_mode:-}")"
  if [[ ${#access_modes[@]} -eq 0 ]]; then
    access_modes=("$(trim_whitespace "$MAIN_WALLET_BUNDLE_ACCESS_MODE")")
  fi
  if [[ -z "${access_modes[0]:-}" ]]; then
    access_modes=("ReadWriteOnce")
  fi

  {
    echo "apiVersion: v1"
    echo "kind: PersistentVolumeClaim"
    echo "metadata:"
    echo "  name: ${pvc_name}"
    echo "  namespace: ${ns}"
    echo "  labels:"
    echo "    app.kubernetes.io/name: kubeton-main-wallet"
    echo "    app.kubernetes.io/managed-by: kubeton"
    echo "spec:"
    echo "  accessModes:"
    for mode in "${access_modes[@]}"; do
      mode="$(trim_whitespace "$mode")"
      [[ -z "$mode" ]] && continue
      echo "  - ${mode}"
    done
    if [[ -n "$storage_class" ]]; then
      echo "  storageClassName: ${storage_class}"
    fi
    if [[ -n "$volume_mode" ]]; then
      echo "  volumeMode: ${volume_mode}"
    fi
    echo "  resources:"
    echo "    requests:"
    echo "      storage: ${storage_request}"
  } | kubectl apply -f - >/dev/null

  if pvc_uses_wait_for_first_consumer "$ns" "$pvc_name"; then
    echo "PVC ${ns}/${pvc_name} uses WaitForFirstConsumer; skipping pre-run Bound wait."
    return 0
  fi
  wait_pvc_bound "$ns" "$pvc_name" 900
}

ensure_main_wallet_script_configmap() {
  local ns="$1"
  if [[ ! -f "$MAIN_WALLET_SCRIPT_FILE" ]]; then
    echo "Error: main wallet script file not found: ${MAIN_WALLET_SCRIPT_FILE}" >&2
    return 1
  fi
  kubectl -n "$ns" create configmap "$MAIN_WALLET_SCRIPT_CONFIGMAP" \
    --from-file=main-wallet.sh="$MAIN_WALLET_SCRIPT_FILE" \
    --dry-run=client -o yaml | kubectl -n "$ns" apply -f - >/dev/null
}

main_wallet_bundle_storage_class() {
  local ns="$1"
  local pvc_name="$2"
  local storage_class=""

  storage_class="$(kubectl -n "$ns" get pvc "$pvc_name" -o jsonpath='{.spec.storageClassName}' 2>/dev/null || true)"
  storage_class="$(trim_whitespace "$storage_class")"
  if [[ -z "$storage_class" ]]; then
    storage_class="$(kubectl get storageclass -o jsonpath='{range .items[*]}{.metadata.name}{"\t"}{.metadata.annotations.storageclass\.kubernetes\.io/is-default-class}{"\n"}{end}' 2>/dev/null | awk '$2=="true"{print $1; exit}')"
    storage_class="$(trim_whitespace "$storage_class")"
  fi
  printf '%s' "$storage_class"
}

ensure_main_wallet_longhorn_ready() {
  local storage_class="$1"
  local provisioner desired ready

  storage_class="$(trim_whitespace "$storage_class")"
  [[ -z "$storage_class" ]] && return 0

  if ! kubectl get storageclass "$storage_class" >/dev/null 2>&1; then
    echo "Error: main-wallet storage class '${storage_class}' not found." >&2
    return 1
  fi

  provisioner="$(kubectl get storageclass "$storage_class" -o jsonpath='{.provisioner}' 2>/dev/null || true)"
  provisioner="$(trim_whitespace "$provisioner")"
  if [[ "$provisioner" != "driver.longhorn.io" ]]; then
    return 0
  fi

  if ! kubectl -n "$LONGHORN_NAMESPACE" get daemonset longhorn-manager >/dev/null 2>&1; then
    echo "Error: storage class '${storage_class}' uses Longhorn, but daemonset ${LONGHORN_NAMESPACE}/longhorn-manager is missing." >&2
    echo "Run './kubeton bootstrap-baremetal' or fix Longhorn before running main-wallet." >&2
    return 1
  fi

  desired="$(kubectl -n "$LONGHORN_NAMESPACE" get daemonset longhorn-manager -o jsonpath='{.status.desiredNumberScheduled}' 2>/dev/null || true)"
  ready="$(kubectl -n "$LONGHORN_NAMESPACE" get daemonset longhorn-manager -o jsonpath='{.status.numberReady}' 2>/dev/null || true)"
  desired="$(trim_whitespace "$desired")"
  ready="$(trim_whitespace "$ready")"

  if ! [[ "$desired" =~ ^[0-9]+$ && "$ready" =~ ^[0-9]+$ ]]; then
    echo "Error: cannot read Longhorn readiness for daemonset ${LONGHORN_NAMESPACE}/longhorn-manager." >&2
    return 1
  fi
  if (( desired == 0 || ready == 0 )); then
    echo "Error: Longhorn is required by storage class '${storage_class}', but longhorn-manager readiness is ${ready}/${desired}." >&2
    return 1
  fi

  if ! kubectl -n "$LONGHORN_NAMESPACE" rollout status daemonset/longhorn-manager --timeout=120s >/dev/null 2>&1; then
    echo "Error: Longhorn manager is not Ready (daemonset ${LONGHORN_NAMESPACE}/longhorn-manager)." >&2
    return 1
  fi
}

main_wallet_pod_longhorn_csi_affinity_yaml() {
  local storage_class="$1"
  local provisioner=""
  local -a longhorn_csi_nodes=()
  local node

  storage_class="$(trim_whitespace "$storage_class")"
  [[ -z "$storage_class" ]] && return 0

  provisioner="$(kubectl get storageclass "$storage_class" -o jsonpath='{.provisioner}' 2>/dev/null || true)"
  provisioner="$(trim_whitespace "$provisioner")"
  if [[ "$provisioner" != "driver.longhorn.io" ]]; then
    return 0
  fi

  mapfile -t longhorn_csi_nodes < <(list_longhorn_csi_node_names)
  if [[ ${#longhorn_csi_nodes[@]} -eq 0 ]]; then
    echo "Error: storage class '${storage_class}' uses Longhorn, but no nodes with CSI driver 'driver.longhorn.io' were found in CSINode." >&2
    return 1
  fi

  echo "  affinity:"
  echo "    nodeAffinity:"
  echo "      requiredDuringSchedulingIgnoredDuringExecution:"
  echo "        nodeSelectorTerms:"
  echo "          - matchExpressions:"
  echo "              - key: kubernetes.io/hostname"
  echo "                operator: In"
  echo "                values:"
  for node in "${longhorn_csi_nodes[@]}"; do
    node="$(trim_whitespace "$node")"
    [[ -z "$node" ]] && continue
    printf '                  - %s\n' "$(yaml_quote "$node")"
  done
}

main_wallet_helper_pod_uses_pvc() {
  local ns="$1"
  local pod="$2"
  local pvc_name="$3"
  local claim=""

  while IFS= read -r claim; do
    claim="$(trim_whitespace "$claim")"
    [[ -z "$claim" ]] && continue
    if [[ "$claim" == "$pvc_name" ]]; then
      return 0
    fi
  done < <(kubectl -n "$ns" get pod "$pod" -o jsonpath='{range .spec.volumes[*]}{.persistentVolumeClaim.claimName}{"\n"}{end}' 2>/dev/null || true)

  return 1
}

cleanup_terminated_main_wallet_helper_pods() {
  local ns="$1"
  kubectl -n "$ns" delete pod -l app.kubernetes.io/name=kubeton-main-wallet --field-selector=status.phase==Succeeded --ignore-not-found --wait=false >/dev/null 2>&1 || true
  kubectl -n "$ns" delete pod -l app.kubernetes.io/name=kubeton-main-wallet --field-selector=status.phase==Failed --ignore-not-found --wait=false >/dev/null 2>&1 || true
}

ensure_main_wallet_helper_slot() {
  local ns="$1"
  local pvc_name="$2"
  local timeout_seconds="${3:-120}"
  local deadline row pod phase deleting
  local -a conflicting_pods=()

  cleanup_terminated_main_wallet_helper_pods "$ns"
  deadline=$(( $(date +%s) + timeout_seconds ))

  while (( $(date +%s) < deadline )); do
    conflicting_pods=()
    while IFS= read -r row; do
      [[ -z "$row" ]] && continue
      IFS=$'\t' read -r pod phase deleting <<<"$row"
      pod="$(trim_whitespace "$pod")"
      phase="$(trim_whitespace "$phase")"
      deleting="$(trim_whitespace "$deleting")"
      [[ -z "$pod" ]] && continue
      [[ "$phase" == "Succeeded" || "$phase" == "Failed" ]] && continue
      if ! main_wallet_helper_pod_uses_pvc "$ns" "$pod" "$pvc_name"; then
        continue
      fi
      if [[ -n "$deleting" ]]; then
        continue
      fi
      conflicting_pods+=("${pod} (${phase:-unknown})")
    done < <(kubectl -n "$ns" get pods -l app.kubernetes.io/name=kubeton-main-wallet -o jsonpath='{range .items[*]}{.metadata.name}{"\t"}{.status.phase}{"\t"}{.metadata.deletionTimestamp}{"\n"}{end}' 2>/dev/null || true)

    if [[ ${#conflicting_pods[@]} -eq 0 ]]; then
      return 0
    fi
    sleep 2
  done

  echo "Error: another main-wallet helper pod is still active and holds PVC '${pvc_name}'." >&2
  echo "Conflicting pod(s): ${conflicting_pods[*]}" >&2
  echo "Wait for completion or delete stale helper pod(s) before retrying." >&2
  return 1
}

main_wallet_mount_conflict_event() {
  local ns="$1"
  local pod="$2"
  local message

  message="$(kubectl -n "$ns" get events \
    --field-selector "involvedObject.kind=Pod,involvedObject.name=${pod},type=Warning,reason=FailedMount" \
    --sort-by=.lastTimestamp \
    -o custom-columns=MESSAGE:.message \
    --no-headers 2>/dev/null | tail -n 1 || true)"
  message="$(trim_whitespace "$message")"

  if [[ -z "$message" ]]; then
    return 1
  fi

  if grep -Eiq 'already mapped or mounted|Cannot use device /dev/longhorn/.*in use|already mounted or mount point busy' <<<"$message"; then
    printf '%s' "$message"
    return 0
  fi
  return 1
}

wait_main_wallet_pod_completion() {
  local ns="$1"
  local pod="$2"
  local timeout_seconds="$3"
  local deadline phase exit_code mount_conflict

  deadline=$(( $(date +%s) + timeout_seconds ))
  while (( $(date +%s) < deadline )); do
    phase="$(kubectl -n "$ns" get pod "$pod" -o jsonpath='{.status.phase}' 2>/dev/null || true)"
    phase="$(trim_whitespace "$phase")"
    case "$phase" in
      Succeeded)
        return 0
        ;;
      Failed)
        exit_code="$(kubectl -n "$ns" get pod "$pod" -o jsonpath='{.status.containerStatuses[0].state.terminated.exitCode}' 2>/dev/null || true)"
        exit_code="$(trim_whitespace "$exit_code")"
        if [[ "$exit_code" =~ ^[0-9]+$ ]]; then
          return "$exit_code"
        fi
        return 1
        ;;
      "")
        ;;
      *)
        ;;
    esac
    if mount_conflict="$(main_wallet_mount_conflict_event "$ns" "$pod")"; then
      echo "Error: encrypted volume mount conflict detected for ${ns}/${pod}: ${mount_conflict}" >&2
      echo "Aborting early to avoid waiting for timeout." >&2
      return 1
    fi
    sleep 2
  done

  echo "Error: timeout waiting for pod ${ns}/${pod} completion." >&2
  return 1
}

run_wallet() {
  wallet_usage() {
    echo "Usage: kubeton wallet <create|deploy|activate|send|collect|show|export> [args...]"
    echo
    echo "Subcommands:"
    echo "  create [name]"
    echo "    Create wallet with defaults: workchain=0, subwallet-id=42."
    echo "    If [name] is omitted, MAIN_WALLET_NAME is used (default: main-wallet)."
    echo
    echo "  create <workchain> <subwallet-id> <wallet-name>"
    echo "    Legacy explicit form."
    echo
    echo "  deploy <mainnet|testnet> [name]"
    echo "    Deploy one main wallet by sending its generated BOC."
    echo "    If [name] is omitted, deploys all wallet BOCs after confirmation."
    echo
    echo "  activate [to-tonnode-name] [wallet-name]"
    echo "    Activate mytonctrl wallet(s) inside TON pod(s) using: aw <wallet-name>."
    echo "    If [to-tonnode-name] is omitted, activates the wallet in all TON pods."
    echo "    If [wallet-name] is omitted, validator_wallet_001 is used."
    echo
    echo "  show [name]"
    echo "    Show one wallet by name, or all wallets if omitted."
    echo "    After deploy, also shows balance and seqno using the saved wallet network."
    echo
    echo "  show balance [to-tonnode-name] [wallet-name]"
    echo "    Show mytonctrl wallet balance inside one TON pod, or all TON pods if omitted."
    echo "    If [wallet-name] is omitted, validator_wallet_001 is used."
    echo
    echo "  export"
    echo "    Export all mytonctrl wallet addresses and private keys from all TON pods."
    echo
    echo "  export <main-wallet-name>"
    echo "    Export one kubeton main-wallet address and private key from the encrypted bundle."
    echo
    echo "  export <to-tonnode-name> <wallet-name>"
    echo "    Export one mytonctrl wallet address and private key from the selected TON pod."
    echo
    echo "  send <mainnet|testnet> <from-wallet-name> <amount> [-n]"
    echo "    Split mode: divides <amount> equally across all TON pods"
    echo "    using MAIN_WALLET_TARGET_WALLET_NAME (default: validator_wallet_001)."
    echo
    echo "  send <mainnet|testnet> <from-wallet-name> <destination-address> <amount> [-n]"
    echo "    Send from main wallet to an explicit TON address on the selected network."
    echo
    echo "  send <mainnet|testnet> <from-wallet-name> <to-tonnode-name> <amount> [-n]"
    echo "    Send to default target wallet name on selected TON pod."
    echo
    echo "  send <mainnet|testnet> <from-wallet-name> <to-tonnode-name> <wallet-name> <amount> [-n]"
    echo "    Send to explicit target wallet name on selected TON pod."
    echo
    echo "  collect <mainnet|testnet> <main-wallet-name> [amount]"
    echo "    Collect from all TON pods using validator_wallet_001 into the named main wallet."
    echo "    If [amount] is omitted, mytonctrl mg receives 'alld'."
    echo
    echo "  collect <mainnet|testnet> <main-wallet-name> <from-tonnode-name> [wallet-name] [amount]"
    echo "    Collect from one TON pod into the named main wallet."
    echo "    If [wallet-name] is omitted, validator_wallet_001 is used; if [amount] is omitted, 'alld' is used."
    echo
    echo "Notes:"
    echo "  - deploy/send/collect require an explicit network."
    echo "  - deploy/send use the network to select lite-server and TONCenter endpoints."
    echo "  - deploy records the wallet network so show can query balance and seqno later."
    echo "  - activate runs mytonctrl aw inside TON pods and does not use the kubeton main-wallet BOC sender."
    echo "  - activate/show balance use mytonctrl inside TON pods; mytonctrl already has its network configured."
    echo "  - export prints private key material to stdout; treat the output as a secret."
    echo "  - collect only runs mytonctrl mg for source wallets reported as active by mytonctrl wl."
    echo "  - activate/exec-mtc timeout defaults to MYTONCTRL_EXEC_TIMEOUT=${MYTONCTRL_EXEC_TIMEOUT}."
    echo "  - amount must be numeric TON amount (examples: 1, 1., 1.5)"
    echo "  - optional -n (last argument) forwards --no-bounce to wallet.fif"
    echo "  - <to-tonnode-name> is pod name like tonnode-0 (or namespace/pod when applicable)"
    echo
    echo "Examples:"
    echo "  kubeton wallet create"
    echo "  kubeton wallet create main-wallet"
    echo "  kubeton wallet create 0 42 main-wallet"
    echo "  kubeton wallet deploy testnet"
    echo "  kubeton wallet deploy testnet main-wallet"
    echo "  kubeton wallet activate"
    echo "  kubeton wallet activate tonnode-0"
    echo "  kubeton wallet activate tonnode-0 validator_wallet_001"
    echo "  kubeton wallet show"
    echo "  kubeton wallet show main-wallet"
    echo "  kubeton wallet show balance"
    echo "  kubeton wallet show balance tonnode-0"
    echo "  kubeton wallet show balance tonnode-0 validator_wallet_001"
    echo "  kubeton wallet export"
    echo "  kubeton wallet export main-wallet"
    echo "  kubeton wallet export tonnode-0 validator_wallet_001"
    echo "  kubeton wallet send testnet main-wallet 10."
    echo "  kubeton wallet send testnet main-wallet <destination-address> 10."
    echo "  kubeton wallet send testnet main-wallet tonnode-0 10."
    echo "  kubeton wallet send testnet main-wallet tonnode-0 10. -n"
    echo "  kubeton wallet send testnet main-wallet tonnode-0 validator_wallet_001 10."
    echo "  kubeton wallet send testnet main-wallet tonnode-0 validator_wallet_001 10. -n"
    echo "  kubeton wallet collect testnet main-wallet"
    echo "  kubeton wallet collect testnet main-wallet 10."
    echo "  kubeton wallet collect testnet main-wallet tonnode-0 validator_wallet_001 alld"
  }

  local action="${1:-}"
  shift || true
  if [[ -z "$action" ]]; then
    wallet_usage
    return 0
  fi
  case "$action" in
    help|-h|--help)
      wallet_usage
      return 0
      ;;
    create|deploy|activate|send|collect|show|export)
      ;;
    *)
      echo "Error: unknown wallet subcommand '$action'." >&2
      wallet_usage >&2
      return 1
      ;;
  esac

  require_bin kubectl

  local -a action_args=()
  local row target_ns target_pod target_node_name target_wallet_name destination_address amount
  local from_wallet_name to_tonnode_name
  local wallet_network=""
  local -a table_rows=()
  local -a destination_addresses=()
  case "$action" in
    create)
      case "$#" in
        0)
          action_args=()
          ;;
        1)
          action_args=("0" "42" "$1")
          ;;
        3)
          # Backward-compatible form: create <workchain> <subwallet-id> <wallet-name>
          action_args=("$1" "$2" "$3")
          ;;
        *)
          echo "Error: usage: kubeton wallet create [name]" >&2
          echo "       legacy: kubeton wallet create <workchain> <subwallet-id> <wallet-name>" >&2
          return 1
          ;;
      esac
      ;;
    deploy)
      if (( $# < 1 || $# > 2 )); then
        echo "Error: usage: kubeton wallet deploy <mainnet|testnet> [name]" >&2
        return 1
      fi
      if ! wallet_network="$(normalize_wallet_network "$1")"; then
        echo "Error: unsupported wallet network '$1'. Use mainnet or testnet." >&2
        return 1
      fi
      shift || true
      action_args=("$@")
      if (( ${#action_args[@]} == 0 )); then
        confirm_or_exit "This will deploy (send BOC) for ALL wallets on ${wallet_network}. Continue?"
      fi
      ;;
    activate)
      if (( $# > 2 )); then
        echo "Error: usage: kubeton wallet activate [to-tonnode-name] [wallet-name]" >&2
        return 1
      fi
      if (( $# >= 1 )) && normalize_wallet_network "$1" >/dev/null 2>&1; then
        echo "Error: wallet activate no longer accepts a network argument." >&2
        echo "       usage: kubeton wallet activate [to-tonnode-name] [wallet-name]" >&2
        return 1
      fi
      run_wallet_activate "${1:-}" "${2:-validator_wallet_001}"
      return $?
      ;;
    collect)
      if (( $# < 2 || $# > 5 )); then
        echo "Error: usage: kubeton wallet collect <mainnet|testnet> <main-wallet-name> [from-tonnode-name] [wallet-name] [amount]" >&2
        return 1
      fi
      if ! wallet_network="$(normalize_wallet_network "$1")"; then
        echo "Error: unsupported wallet network '$1'. Use mainnet or testnet." >&2
        return 1
      fi
      shift || true
      run_wallet_collect "$wallet_network" "$@"
      return $?
      ;;
    show)
      if (( $# >= 1 )) && normalize_wallet_network "$1" >/dev/null 2>&1; then
        echo "Error: wallet show balance no longer accepts a network argument." >&2
        echo "       usage: kubeton wallet show balance [to-tonnode-name] [wallet-name]" >&2
        return 1
      fi
      if [[ "$(trim_whitespace "${1:-}")" == "balance" ]]; then
        shift || true
        if (( $# > 2 )); then
          echo "Error: usage: kubeton wallet show balance [to-tonnode-name] [wallet-name]" >&2
          return 1
        fi
        run_wallet_balance_show "${1:-}" "${2:-validator_wallet_001}"
        return $?
      fi
      if (( $# <= 1 )); then
        action_args=("$@")
      else
        echo "Error: usage: kubeton wallet show [name]" >&2
        return 1
      fi
      ;;
    export)
      case "$#" in
        0)
          run_wallet_export_tonnode "" ""
          return $?
          ;;
        1)
          if ! [[ "$1" =~ ^[A-Za-z0-9._-]+$ ]]; then
            echo "Error: invalid main wallet name '$1'." >&2
            return 1
          fi
          action_args=("$1")
          confirm_or_exit "This will restore the encrypted main-wallet bundle and print private key hex for '$1'. Continue?"
          ;;
        2)
          run_wallet_export_tonnode "$1" "$2"
          return $?
          ;;
        *)
          echo "Error: usage: kubeton wallet export [main-wallet-name]" >&2
          echo "       usage: kubeton wallet export <to-tonnode-name> <wallet-name>" >&2
          return 1
          ;;
      esac
      ;;
    send)
      local send_no_bounce_flag=""
      if (( $# < 1 )); then
        echo "Error: usage: kubeton wallet send <mainnet|testnet> [from-wallet-name] [to-tonnode-name] [wallet-name] [amount] [-n]" >&2
        return 1
      fi
      if ! wallet_network="$(normalize_wallet_network "$1")"; then
        echo "Error: unsupported wallet network '$1'. Use mainnet or testnet." >&2
        return 1
      fi
      shift || true
      local -a send_args=("$@")
      local send_last_index send_last_arg send_item
      if (( ${#send_args[@]} > 0 )); then
        send_last_index=$(( ${#send_args[@]} - 1 ))
        send_last_arg="$(trim_whitespace "${send_args[$send_last_index]}")"
        if [[ "$send_last_arg" == "-n" ]]; then
          send_no_bounce_flag="-n"
          unset "send_args[$send_last_index]"
          send_args=("${send_args[@]}")
        fi
      fi

      for send_item in "${send_args[@]}"; do
        if [[ "$(trim_whitespace "$send_item")" == "-n" ]]; then
          echo "Error: '-n' must be the last optional argument for wallet send." >&2
          return 1
        fi
      done

      case "${#send_args[@]}" in
        2)
          from_wallet_name="$(trim_whitespace "${send_args[0]}")"
          amount="$(trim_whitespace "${send_args[1]}")"
          if [[ -z "$from_wallet_name" || -z "$amount" ]]; then
            echo "Error: usage: kubeton wallet send <mainnet|testnet> [from-wallet-name] [amount] [-n]" >&2
            return 1
          fi
          if ! [[ "$amount" =~ ^[0-9]+([.][0-9]+)?[.]?$ ]]; then
            echo "Error: amount '${amount}' must be numeric TON amount (for example: 1, 1., 1.5)." >&2
            return 1
          fi
          target_wallet_name="$(trim_whitespace "$MAIN_WALLET_TARGET_WALLET_NAME")"
          [[ -z "$target_wallet_name" ]] && target_wallet_name="validator_wallet_001"

          while IFS= read -r row; do
            [[ -z "$row" ]] && continue
            IFS=$'\t' read -r target_ns target_pod target_node_name <<<"$row"
            [[ -z "$target_ns" || -z "$target_pod" ]] && continue
            destination_address="$(resolve_tonnode_wallet_address_from_pod "$target_ns" "$target_pod" "$target_wallet_name" || true)"
            destination_address="$(trim_whitespace "$destination_address")"
            if [[ -z "$destination_address" ]]; then
              echo "Warning: cannot resolve wallet '${target_wallet_name}' in ${target_ns}/${target_pod}; skipping." >&2
              continue
            fi
            destination_addresses+=("$destination_address")
            table_rows+=("${target_ns}"$'\t'"${target_pod}"$'\t'"${target_wallet_name}"$'\t'"${destination_address}")
          done < <(list_ton_pods 2>/dev/null || true)

          if [[ ${#table_rows[@]} -eq 0 ]]; then
            echo "Error: no TON wallets resolved for wallet name '${target_wallet_name}'." >&2
            return 1
          fi
          local target_count total_amount_nano amount_each_nano remainder_nano amount_each
          local -a split_table_rows=()
          target_count="${#destination_addresses[@]}"
          total_amount_nano="$(ton_gram_amount_to_nano "$amount" || true)"
          total_amount_nano="$(trim_whitespace "$total_amount_nano")"
          if ! [[ "$total_amount_nano" =~ ^[0-9]+$ ]] || (( total_amount_nano <= 0 )); then
            echo "Error: amount '${amount}' must be numeric TON amount (for example: 1, 1., 1.5)." >&2
            return 1
          fi
          amount_each_nano=$(( total_amount_nano / target_count ))
          if (( amount_each_nano <= 0 )); then
            echo "Error: amount '${amount}' is too low for equal distribution across ${target_count} targets." >&2
            return 1
          fi
          remainder_nano=$(( total_amount_nano - (amount_each_nano * target_count) ))
          amount_each="$(ton_nano_to_gram_amount "$amount_each_nano" || true)"
          amount_each="$(trim_whitespace "$amount_each")"
          if [[ -z "$amount_each" ]]; then
            echo "Error: failed to convert equal share amount." >&2
            return 1
          fi
          for row in "${table_rows[@]}"; do
            split_table_rows+=("${row}"$'\t'"${amount_each}")
          done
          table_rows=("${split_table_rows[@]}")
          print_aligned_table_5col "namespace" "tonnode pod" "wallet-name" "wallet-address" "amount" "${table_rows[@]}"
          if (( remainder_nano > 0 )); then
            echo "Warning: ${remainder_nano} nanoTON remainder is not sent due to equal split rounding." >&2
          fi
          confirm_or_exit "This will send '${amount_each}' from '${from_wallet_name}' on ${wallet_network} to each listed TON wallet (${target_count} total). Continue?"

          action_args=("$from_wallet_name" "$amount")
          for destination_address in "${destination_addresses[@]}"; do
            action_args+=("$destination_address")
          done
          if [[ -n "$send_no_bounce_flag" ]]; then
            action_args+=("$send_no_bounce_flag")
          fi
          ;;
        3|4)
          from_wallet_name="$(trim_whitespace "${send_args[0]}")"
          to_tonnode_name="$(trim_whitespace "${send_args[1]}")"
          if [[ -z "$from_wallet_name" || -z "$to_tonnode_name" ]]; then
            echo "Error: usage: kubeton wallet send <mainnet|testnet> [from-wallet-name] [to-tonnode-name] [wallet-name] [amount] [-n]" >&2
            return 1
          fi
          if (( ${#send_args[@]} == 3 )) && looks_like_ton_address "$to_tonnode_name"; then
            destination_address="$to_tonnode_name"
            amount="$(trim_whitespace "${send_args[2]}")"
            if ! ton_address_valid_for_network "$destination_address" "$wallet_network"; then
              echo "Error: destination address '${destination_address}' is not valid for ${wallet_network}." >&2
              return 1
            fi
            if ! [[ "$amount" =~ ^[0-9]+([.][0-9]+)?[.]?$ ]]; then
              echo "Error: amount '${amount}' must be numeric TON amount (for example: 1, 1., 1.5)." >&2
              return 1
            fi

            table_rows=("${wallet_network}"$'\t'"${from_wallet_name}"$'\t'"${destination_address}"$'\t'"${amount}"$'\t'"${send_no_bounce_flag:-default}")
            print_aligned_table_5col "network" "from-wallet" "destination-address" "amount" "wallet.fif flag" "${table_rows[@]}"
            confirm_or_exit "Send '${amount}' from '${from_wallet_name}' on ${wallet_network} to '${destination_address}'?"

            action_args=("$from_wallet_name" "$destination_address" "$amount")
            if [[ -n "$send_no_bounce_flag" ]]; then
              action_args+=("$send_no_bounce_flag")
            fi
          else
            if (( ${#send_args[@]} == 3 )); then
              target_wallet_name="$(trim_whitespace "$MAIN_WALLET_TARGET_WALLET_NAME")"
              [[ -z "$target_wallet_name" ]] && target_wallet_name="validator_wallet_001"
              amount="$(trim_whitespace "${send_args[2]}")"
            else
              target_wallet_name="$(trim_whitespace "${send_args[2]}")"
              amount="$(trim_whitespace "${send_args[3]}")"
            fi
            if [[ -z "$target_wallet_name" || -z "$amount" ]]; then
              echo "Error: wallet-name and amount are required." >&2
              return 1
            fi
            if ! [[ "$amount" =~ ^[0-9]+([.][0-9]+)?[.]?$ ]]; then
              echo "Error: amount '${amount}' must be numeric TON amount (for example: 1, 1., 1.5)." >&2
              return 1
            fi

            row="$(resolve_tonnode_pod_row_by_name "$to_tonnode_name" || true)"
            row="$(trim_whitespace "$row")"
            if [[ -z "$row" ]]; then
              echo "Error: TON pod '${to_tonnode_name}' not found." >&2
              return 1
            fi
            IFS=$'\t' read -r target_ns target_pod target_node_name <<<"$row"
            destination_address="$(resolve_tonnode_wallet_address_from_pod "$target_ns" "$target_pod" "$target_wallet_name" || true)"
            destination_address="$(trim_whitespace "$destination_address")"
            if [[ -z "$destination_address" ]]; then
              echo "Error: wallet '${target_wallet_name}' was not found in ${target_ns}/${target_pod}." >&2
              return 1
            fi

            table_rows=("${target_ns}"$'\t'"${target_pod}"$'\t'"${target_wallet_name}"$'\t'"${destination_address}"$'\t'"${amount}")
            print_aligned_table_5col "namespace" "tonnode pod" "wallet-name" "wallet-address" "amount" "${table_rows[@]}"
            confirm_or_exit "Send '${amount}' from '${from_wallet_name}' on ${wallet_network} to '${target_wallet_name}' on ${target_ns}/${target_pod}?"

            action_args=("$from_wallet_name" "$destination_address" "$amount")
            if [[ -n "$send_no_bounce_flag" ]]; then
              action_args+=("$send_no_bounce_flag")
            fi
          fi
          ;;
        *)
          echo "Error: usage: kubeton wallet send <mainnet|testnet> [from-wallet-name] [to-tonnode-name] [wallet-name] [amount] [-n]" >&2
          echo "       usage: kubeton wallet send <mainnet|testnet> [from-wallet-name] [amount] [-n]" >&2
          return 1
          ;;
      esac
      ;;
  esac

  if should_bootstrap_baremetal; then
    ensure_auto_bootstrap_stack_if_needed
  fi
  validate_external_key_prereqs

  local ns
  local pod_name
  local image
  local global_config_url
  local toncenter_url
  local timeout_seconds
  local bundle_storage_class=""
  local wallet_node_affinity_yaml=""
  local pod_rc=0
  local cleanup_required=1
  local -a command_items=("/scripts/main-wallet.sh" "run" "$action")
  local item

  for item in "${action_args[@]}"; do
    command_items+=("$item")
  done

  ns="$(trim_whitespace "$TON_NAMESPACE")"
  [[ -z "$ns" ]] && ns="default"
  ensure_namespace "$ns"

  if ! ensure_main_wallet_helper_slot "$ns" "$MAIN_WALLET_BUNDLE_PVC" 120; then
    return 1
  fi

  ensure_main_wallet_script_configmap "$ns"
  ensure_main_wallet_bundle_pvc "$ns"
  bundle_storage_class="$(main_wallet_bundle_storage_class "$ns" "$MAIN_WALLET_BUNDLE_PVC")"
  ensure_main_wallet_longhorn_ready "$bundle_storage_class"
  wallet_node_affinity_yaml="$(main_wallet_pod_longhorn_csi_affinity_yaml "$bundle_storage_class")" || return 1

  image="$(resolve_main_wallet_image)"
  global_config_url="$(resolve_main_wallet_global_config_url "$wallet_network")"
  toncenter_url="$(resolve_main_wallet_toncenter_url "$wallet_network")"
  timeout_seconds="$(main_wallet_timeout_seconds)"

  pod_name="kubeton-main-wallet-$RANDOM-$RANDOM"

  cleanup_main_wallet() {
    [[ "${cleanup_required:-0}" -ne 1 ]] && return 0
    kubectl -n "$ns" delete pod "$pod_name" --ignore-not-found >/dev/null 2>&1 || true
  }
  trap cleanup_main_wallet EXIT INT TERM

  {
    echo "apiVersion: v1"
    echo "kind: Pod"
    echo "metadata:"
    echo "  name: ${pod_name}"
    echo "  labels:"
    echo "    app.kubernetes.io/name: kubeton-main-wallet"
    echo "    app.kubernetes.io/managed-by: kubeton"
    echo "spec:"
    echo "  restartPolicy: Never"
    echo "  activeDeadlineSeconds: ${timeout_seconds}"
    if [[ -n "$wallet_node_affinity_yaml" ]]; then
      printf '%s\n' "$wallet_node_affinity_yaml"
    fi
    echo "  containers:"
    echo "    - name: main-wallet"
    echo "      image: ${image}"
    echo "      imagePullPolicy: IfNotPresent"
    echo "      command:"
    for item in "${command_items[@]}"; do
      printf '        - %s\n' "$(yaml_quote "$item")"
    done
    echo "      env:"
    echo "        - name: KEY_PROVIDER"
    printf '          value: %s\n' "$(yaml_quote "vault")"
    echo "        - name: VAULT_TRANSIT_KEY"
    printf '          value: %s\n' "$(yaml_quote "$VAULT_TRANSIT_KEY")"
    echo "        - name: MODE"
    printf '          value: %s\n' "$(yaml_quote "$MAIN_WALLET_MODE")"
    echo "        - name: WALLET_NETWORK"
    printf '          value: %s\n' "$(yaml_quote "$wallet_network")"
    echo "        - name: GLOBAL_CONFIG_URL"
    printf '          value: %s\n' "$(yaml_quote "$global_config_url")"
    echo "        - name: TONCENTER_URL"
    printf '          value: %s\n' "$(yaml_quote "$toncenter_url")"
    if [[ -n "$MAIN_WALLET_TONCENTER_API_KEY" ]]; then
      echo "        - name: TONCENTER_API_KEY"
      printf '          value: %s\n' "$(yaml_quote "$MAIN_WALLET_TONCENTER_API_KEY")"
    fi
    echo "        - name: MAIN_WALLET_SEND_RETRY_ATTEMPTS"
    printf '          value: %s\n' "$(yaml_quote "$MAIN_WALLET_SEND_RETRY_ATTEMPTS")"
    echo "        - name: MAIN_WALLET_LITESERVER_SEND_ATTEMPTS"
    printf '          value: %s\n' "$(yaml_quote "$MAIN_WALLET_LITESERVER_SEND_ATTEMPTS")"
    echo "        - name: MAIN_WALLET_TONCENTER_SEND_ATTEMPTS"
    printf '          value: %s\n' "$(yaml_quote "$MAIN_WALLET_TONCENTER_SEND_ATTEMPTS")"
    echo "        - name: MAIN_WALLET_SEND_RETRY_DELAY_SEC"
    printf '          value: %s\n' "$(yaml_quote "$MAIN_WALLET_SEND_RETRY_DELAY_SEC")"
    echo "        - name: MAIN_WALLET_NAME_DEFAULT"
    printf '          value: %s\n' "$(yaml_quote "$MAIN_WALLET_NAME")"
    echo "        - name: MAIN_WALLET_DIR"
    printf '          value: %s\n' "$(yaml_quote "/var/main-wallet/runtime")"
    echo "        - name: MAIN_WALLET_BUNDLE_DIR"
    printf '          value: %s\n' "$(yaml_quote "/var/main-wallet/bundle")"
    echo "      envFrom:"
    echo "        - secretRef:"
    echo "            name: ${TON_VAULT_CREDS_SECRET}"
    echo "            optional: false"
    echo "      volumeMounts:"
    echo "        - name: main-wallet-script"
    echo "          mountPath: /scripts/main-wallet.sh"
    echo "          subPath: main-wallet.sh"
    echo "          readOnly: true"
    echo "        - name: main-wallet-runtime"
    echo "          mountPath: /var/main-wallet/runtime"
    echo "        - name: main-wallet-bundle"
    echo "          mountPath: /var/main-wallet/bundle"
    echo "  volumes:"
    echo "    - name: main-wallet-script"
    echo "      configMap:"
    echo "        name: ${MAIN_WALLET_SCRIPT_CONFIGMAP}"
    echo "        defaultMode: 0555"
    echo "    - name: main-wallet-runtime"
    echo "      emptyDir:"
    echo "        medium: Memory"
    echo "        sizeLimit: ${MAIN_WALLET_RUNTIME_TMPFS_SIZE}"
    echo "    - name: main-wallet-bundle"
    echo "      persistentVolumeClaim:"
    echo "        claimName: ${MAIN_WALLET_BUNDLE_PVC}"
  } | kubectl -n "$ns" apply -f - >/dev/null

  if wait_main_wallet_pod_completion "$ns" "$pod_name" "$timeout_seconds"; then
    pod_rc=0
  else
    pod_rc=$?
  fi

  if (( pod_rc != 0 )); then
    print_helper_pod_failure_context "$ns" "$pod_name" || true
  fi
  kubectl -n "$ns" logs "$pod_name" || true

  kubectl -n "$ns" delete pod "$pod_name" --ignore-not-found >/dev/null 2>&1 || true
  cleanup_required=0
  trap - EXIT INT TERM

  if (( pod_rc != 0 )); then
    return "$pod_rc"
  fi
  return 0
}

run_exec() {
  require_bin kubectl
  local cmd="${*:-}"
  if [[ -z "$cmd" ]]; then
    echo "Error: missing command for exec." >&2
    usage
    exit 1
  fi

  mapfile -t pod_rows < <(list_ton_pods)
  if [[ ${#pod_rows[@]} -eq 0 || -z "${pod_rows[0]}" ]]; then
    echo "No TON pods found."
    return
  fi

  local -a table_rows=()
  for row in "${pod_rows[@]}"; do
    [[ -z "$row" ]] && continue
    IFS=$'\t' read -r ns pod node_name <<<"$row"

    if kubectl -n "$ns" exec "$pod" -- bash -lc "$cmd" >/dev/null 2>&1; then
      exit_code=0
    else
      exit_code=$?
    fi
    [[ -z "$node_name" ]] && node_name="N/A"
    table_rows+=("$node_name"$'\t'"$pod"$'\t'"$exit_code")
  done

  print_aligned_table_3col "server name" "pod name" "exit code" "${table_rows[@]}"
}

run_exec_mtc() {
  require_bin kubectl
  local cmd="${*:-}"
  if [[ -z "$cmd" ]]; then
    echo "Error: missing command for exec-mtc." >&2
    usage
    exit 1
  fi

  mapfile -t pod_rows < <(list_ton_pods)
  if [[ ${#pod_rows[@]} -eq 0 || -z "${pod_rows[0]}" ]]; then
    echo "No TON pods found."
    return
  fi

  local -a table_rows=()
  for row in "${pod_rows[@]}"; do
    [[ -z "$row" ]] && continue
    IFS=$'\t' read -r ns pod node_name <<<"$row"

    if run_with_timeout "$MYTONCTRL_EXEC_TIMEOUT" kubectl -n "$ns" exec "$pod" -c ton-node -- bash -lc '
      mtc_cmd="$1"
      shopt -s expand_aliases
      if [[ -f ~/.bashrc ]]; then
        source ~/.bashrc >/dev/null 2>&1
      fi
      if ! command -v mytonctrl >/dev/null 2>&1; then
        exit 127
      fi
      printf "%s\n" "$mtc_cmd" | mytonctrl
    ' _ "$cmd" >/dev/null 2>&1; then
      exit_code=0
    else
      exit_code=$?
    fi
    [[ -z "$node_name" ]] && node_name="N/A"
    table_rows+=("$node_name"$'\t'"$pod"$'\t'"$exit_code")
  done

  print_aligned_table_3col "server name" "pod name" "exit code" "${table_rows[@]}"
}

main() {
  local command="${1:-help}"
  shift || true

  case "$command" in
    check)
      run_check "$@"
      ;;
    install)
      run_with_launch_session install run_install
      ;;
    bootstrap-baremetal)
      run_bootstrap_baremetal
      ;;
    start)
      run_with_launch_session start run_start "$@"
      ;;
    prometheus)
      run_prometheus "$@"
      ;;
    grafana)
      run_grafana "$@"
      ;;
    victoria-metrics)
      run_victoria_metrics "$@"
      ;;
    add)
      run_add "$@"
      ;;
    del)
      run_del "$@"
      ;;
    recreate)
      run_recreate "$@"
      ;;
    backup-keys)
      run_backup_keys "${1:-}"
      ;;
    restore-keys)
      run_restore_keys "$@"
      ;;
    wallet)
      run_wallet "$@"
      ;;
    main-wallet)
      echo "Warning: 'main-wallet' is deprecated; use 'wallet' instead." >&2
      run_wallet "$@"
      ;;
    stop)
      run_stop "$@"
      ;;
    drop)
      run_drop
      ;;
    uninstall)
      run_uninstall
      ;;
    purge)
      run_purge
      ;;
    verify)
      run_verify
      ;;
    status)
      run_status
      ;;
    exec)
      run_exec "$@"
      ;;
    exec-mtc)
      run_exec_mtc "$@"
      ;;
    help|-h|--help)
      usage
      ;;
    *)
      echo "Error: unknown command '$command'." >&2
      usage
      exit 1
      ;;
  esac
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  main "$@"
fi
