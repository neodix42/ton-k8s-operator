victoria_logs_state_record_name() {
  local logs_namespace="$1"
  local release_name="$2"
  local collector_release_name="$3"
  local safe_namespace safe_release checksum

  safe_namespace="$(printf '%s' "$logs_namespace" | tr '[:upper:]' '[:lower:]' | sed -E 's/[^a-z0-9.-]+/-/g; s/^[.-]+//; s/[.-]+$//')"
  safe_release="$(printf '%s' "$release_name" | tr '[:upper:]' '[:lower:]' | sed -E 's/[^a-z0-9.-]+/-/g; s/^[.-]+//; s/[.-]+$//')"
  [[ -n "$safe_namespace" && -n "$safe_release" ]] || return 1
  checksum="$(printf '%s\t%s\t%s' "$logs_namespace" "$release_name" "$collector_release_name" | cksum | awk '{print $1}')"
  [[ "$checksum" =~ ^[0-9]+$ ]] || return 1
  printf 'kubeton-vlogs-state-%.40s-%.40s-%s' "$safe_namespace" "$safe_release" "$checksum"
}

write_victoria_logs_state() {
  local state_ns="$1"
  local logs_namespace="$2"
  local release_name="$3"
  local collector_release_name="$4"
  local service_name="$5"
  local collector_daemonset="$6"
  local collector_buffer_path record_name target_state_ns
  local -a state_namespaces=()

  if ! collector_buffer_path="$(victoria_logs_collector_buffer_path "$logs_namespace" "$collector_release_name")"; then
    echo "Error: cannot persist an invalid VictoriaLogs collector buffer path." >&2
    return 1
  fi
  if ! record_name="$(victoria_logs_state_record_name "$logs_namespace" "$release_name" "$collector_release_name")"; then
    echo "Error: cannot derive a VictoriaLogs state-ledger record name." >&2
    return 1
  fi

  state_namespaces+=("$state_ns")
  if [[ "$logs_namespace" != "$state_ns" ]]; then
    # Mirror the small non-secret cleanup ledger beside the logging resources.
    # It survives removal of the operator namespace when backend cleanup is
    # intentionally blocked, while the operator-namespace copy lets a plain
    # uninstall discover a custom logs namespace in the first place.
    state_namespaces+=("$logs_namespace")
  fi
  for target_state_ns in "${state_namespaces[@]}"; do
    if ! ensure_namespace "$target_state_ns"; then
      echo "Error: failed to ensure VictoriaLogs state namespace ${target_state_ns}." >&2
      return 1
    fi
    # Keep a canonical latest record for existing readers and an immutable
    # identity-specific record. Changing custom release names cannot overwrite
    # the only cleanup provenance for a previous or partially installed stack.
    if ! cat <<EOF | kubectl -n "$target_state_ns" apply -f - >/dev/null
apiVersion: v1
kind: ConfigMap
metadata:
  name: ${VICTORIA_LOGS_STATE_CONFIGMAP}
  labels:
    app.kubernetes.io/name: kubeton-victoria-logs
    app.kubernetes.io/managed-by: kubeton
    app.kubernetes.io/part-of: kubeton-victoria-logs
data:
  namespace: $(yaml_quote "$logs_namespace")
  releaseName: $(yaml_quote "$release_name")
  collectorReleaseName: $(yaml_quote "$collector_release_name")
  serviceName: $(yaml_quote "$service_name")
  collectorDaemonSet: $(yaml_quote "$collector_daemonset")
  collectorBufferPath: $(yaml_quote "$collector_buffer_path")
---
apiVersion: v1
kind: ConfigMap
metadata:
  name: ${record_name}
  labels:
    app.kubernetes.io/name: kubeton-victoria-logs
    app.kubernetes.io/managed-by: kubeton
    app.kubernetes.io/part-of: kubeton-victoria-logs
data:
  namespace: $(yaml_quote "$logs_namespace")
  releaseName: $(yaml_quote "$release_name")
  collectorReleaseName: $(yaml_quote "$collector_release_name")
  serviceName: $(yaml_quote "$service_name")
  collectorDaemonSet: $(yaml_quote "$collector_daemonset")
  collectorBufferPath: $(yaml_quote "$collector_buffer_path")
EOF
    then
      echo "Error: failed to persist VictoriaLogs state in namespace ${target_state_ns}." >&2
      return 1
    fi
  done
}

resolve_victoria_metrics_rollout_timeout_seconds() {
  local timeout_seconds
  timeout_seconds="$(trim_whitespace "${VICTORIA_METRICS_ROLLOUT_TIMEOUT_SECONDS:-300}")"
  if ! [[ "$timeout_seconds" =~ ^[0-9]+$ ]] || (( timeout_seconds < 60 )); then
    timeout_seconds=300
  fi
  printf '%s' "$timeout_seconds"
}

resolve_victoria_metrics_operator_version() {
  local configured version redirect_url

  configured="$(trim_whitespace "${VM_OPERATOR_VERSION:-}")"
  if [[ -n "$configured" ]]; then
    printf '%s' "$configured"
    return 0
  fi

  if ! command -v curl >/dev/null 2>&1; then
    echo "Error: VM_OPERATOR_VERSION is empty and curl is required to resolve VictoriaMetrics operator latest release." >&2
    return 1
  fi

  redirect_url="$(curl -fs -o /dev/null -w '%{redirect_url}' https://github.com/VictoriaMetrics/operator/releases/latest || true)"
  redirect_url="$(trim_whitespace "$redirect_url")"
  if [[ -z "$redirect_url" ]]; then
    redirect_url="$(curl -fsSL -o /dev/null -w '%{url_effective}' https://github.com/VictoriaMetrics/operator/releases/latest || true)"
    redirect_url="$(trim_whitespace "$redirect_url")"
  fi
  version="${redirect_url##*/}"
  version="$(trim_whitespace "$version")"
  if [[ -z "$version" || "$version" == "latest" ]]; then
    echo "Error: failed to resolve VictoriaMetrics operator latest release tag. Set VM_OPERATOR_VERSION explicitly." >&2
    return 1
  fi
  printf '%s' "$version"
}

victoria_metrics_operator_manifest_url() {
  local version="$1"
  printf '%s' "https://github.com/VictoriaMetrics/operator/releases/download/${version}/${VICTORIA_METRICS_OPERATOR_INSTALL_MANIFEST}"
}

read_victoria_metrics_state_value() {
  local ns="$1"
  local key="$2"

  kubectl -n "$ns" get configmap "$VICTORIA_METRICS_STATE_CONFIGMAP" \
    -o jsonpath="{.data.${key}}" 2>/dev/null \
    || true
}

write_victoria_metrics_state() {
  local state_ns="$1"
  local stack_name="$2"
  local stack_namespace="$3"
  local operator_namespace="$4"
  local operator_version="$5"
  local operator_manifest_url="$6"

  ensure_namespace "$state_ns"
  cat <<EOF | kubectl -n "$state_ns" apply -f - >/dev/null
apiVersion: v1
kind: ConfigMap
metadata:
  name: ${VICTORIA_METRICS_STATE_CONFIGMAP}
  labels:
    app.kubernetes.io/name: kubeton-victoria-metrics
    app.kubernetes.io/managed-by: kubeton
    app.kubernetes.io/part-of: kubeton-victoria-metrics
data:
  stackName: $(yaml_quote "$stack_name")
  stackNamespace: $(yaml_quote "$stack_namespace")
  operatorNamespace: $(yaml_quote "$operator_namespace")
  operatorVersion: $(yaml_quote "$operator_version")
  operatorManifestUrl: $(yaml_quote "$operator_manifest_url")
EOF
}

ensure_victoria_metrics_operator() {
  local operator_ns="$1"
  local stack_name="$2"
  local version manifest_url timeout_seconds

  version="$(resolve_victoria_metrics_operator_version)" || return 1
  manifest_url="$(victoria_metrics_operator_manifest_url "$version")"
  timeout_seconds="$(resolve_victoria_metrics_rollout_timeout_seconds)"

  echo "[victoria-metrics] Installing/updating VictoriaMetrics operator (${version}) ..." >&2
  if ! kubectl apply -f "$manifest_url" >/dev/null; then
    echo "Error: failed to apply VictoriaMetrics operator manifest ${manifest_url}." >&2
    return 1
  fi

  if ! kubectl -n "$operator_ns" rollout status "deployment/${VICTORIA_METRICS_OPERATOR_DEPLOYMENT}" --timeout="${timeout_seconds}s" >/dev/null 2>&1; then
    echo "Warning: VictoriaMetrics operator deployment ${operator_ns}/${VICTORIA_METRICS_OPERATOR_DEPLOYMENT} is not Ready yet." >&2
  fi

  printf '%s\t%s\n' "$version" "$manifest_url"
}

wait_victoria_metrics_cr_operational() {
  local ns="$1"
  local kind="$2"
  local name="$3"
  local timeout_seconds="$4"

  if ! kubectl -n "$ns" wait --for=jsonpath='{.status.updateStatus}'=operational "${kind}/${name}" --timeout="${timeout_seconds}s" >/dev/null 2>&1; then
    echo "Warning: ${kind}/${name} in namespace ${ns} did not reach status.updateStatus=operational within ${timeout_seconds}s." >&2
  fi
}

ensure_victoria_metrics_stack() {
  local ns="$1"
  local stack_name="$2"
  local auth_username="$3"
  local auth_password="$4"
  local timeout_seconds="$5"
  local logs_auth_static_url="${6:-}"
  local password_spec_line
  local remote_write_url logs_auth_target_block=""

  if [[ -z "$auth_username" ]]; then
    auth_username="$stack_name"
  fi
  remote_write_url="http://vmsingle-${stack_name}.${ns}.svc:8428/api/v1/write"
  if [[ -n "$auth_password" ]]; then
    password_spec_line="  password: $(yaml_quote "$auth_password")"
  else
    password_spec_line="  generatePassword: true"
  fi
  if [[ -n "$logs_auth_static_url" ]]; then
    logs_auth_target_block="$(cat <<EOB
    - static:
        url: $(yaml_quote "$logs_auth_static_url")
      paths:
        - "/select/.*"
EOB
)"
  fi

  cat <<EOF | kubectl -n "$ns" apply -f - >/dev/null
apiVersion: operator.victoriametrics.com/v1beta1
kind: VMSingle
metadata:
  name: ${stack_name}
  labels:
    app.kubernetes.io/name: kubeton-victoria-metrics
    app.kubernetes.io/component: storage
    app.kubernetes.io/managed-by: kubeton
    app.kubernetes.io/part-of: kubeton-victoria-metrics
---
apiVersion: operator.victoriametrics.com/v1beta1
kind: VMAgent
metadata:
  name: ${stack_name}
  labels:
    app.kubernetes.io/name: kubeton-victoria-metrics
    app.kubernetes.io/component: agent
    app.kubernetes.io/managed-by: kubeton
    app.kubernetes.io/part-of: kubeton-victoria-metrics
spec:
  selectAllByDefault: true
  remoteWrite:
    - url: $(yaml_quote "$remote_write_url")
---
apiVersion: operator.victoriametrics.com/v1beta1
kind: VMAuth
metadata:
  name: ${stack_name}
  labels:
    app.kubernetes.io/name: kubeton-victoria-metrics
    app.kubernetes.io/component: auth
    app.kubernetes.io/managed-by: kubeton
    app.kubernetes.io/part-of: kubeton-victoria-metrics
spec:
  selectAllByDefault: true
---
apiVersion: operator.victoriametrics.com/v1beta1
kind: VMUser
metadata:
  name: ${stack_name}
  labels:
    app.kubernetes.io/name: kubeton-victoria-metrics-user
    app.kubernetes.io/managed-by: kubeton
    app.kubernetes.io/part-of: kubeton-victoria-metrics
spec:
  name: $(yaml_quote "$auth_username")
  username: $(yaml_quote "$auth_username")
${password_spec_line}
  targetRefs:
    - crd:
        kind: VMSingle
