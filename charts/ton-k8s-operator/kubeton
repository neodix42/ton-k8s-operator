  wait_victoria_metrics_cr_operational "$ns" "vmsingle" "$stack_name" "$timeout_seconds"
  wait_victoria_metrics_cr_operational "$ns" "vmagent" "$stack_name" "$timeout_seconds"
  wait_victoria_metrics_cr_operational "$ns" "vmauth" "$stack_name" "$timeout_seconds"
  wait_victoria_metrics_cr_operational "$ns" "vmuser" "$stack_name" "$timeout_seconds"
}

resolve_victoria_metrics_auth_service_name() {
  local ns="$1"
  local stack_name="$2"
  local service_name=""

  if kubectl -n "$ns" get service "vmauth-${stack_name}" >/dev/null 2>&1; then
    printf '%s' "vmauth-${stack_name}"
    return 0
  fi

  service_name="$(kubectl -n "$ns" get svc -l 'app.kubernetes.io/name=vmauth' -o jsonpath='{.items[0].metadata.name}' 2>/dev/null || true)"
  service_name="$(trim_whitespace "$service_name")"
  if [[ -n "$service_name" ]]; then
    printf '%s' "$service_name"
    return 0
  fi
  return 1
}

resolve_victoria_metrics_credentials() {
  local ns="$1"
  local stack_name="$2"
  local default_username="$3"
  local default_password="$4"
  local secret_name username password

  secret_name="vmuser-${stack_name}"
  if kubectl -n "$ns" get secret "$secret_name" >/dev/null 2>&1; then
    username="$(kubectl -n "$ns" get secret "$secret_name" -o jsonpath='{.data.username}' 2>/dev/null | base64 -d 2>/dev/null || true)"
    password="$(kubectl -n "$ns" get secret "$secret_name" -o jsonpath='{.data.password}' 2>/dev/null | base64 -d 2>/dev/null || true)"
    username="$(trim_whitespace "$username")"
    password="$(trim_whitespace "$password")"
    if [[ -n "$username" && -n "$password" ]]; then
      printf '%s\t%s\t%s\n' "$secret_name" "$username" "$password"
      return 0
    fi
  fi

  default_username="$(trim_whitespace "$default_username")"
  default_password="$(trim_whitespace "$default_password")"
  if [[ -n "$default_username" && -n "$default_password" ]]; then
    printf '%s\t%s\t%s\n' "$secret_name" "$default_username" "$default_password"
    return 0
  fi

  echo "Error: failed to resolve VictoriaMetrics credentials from secret ${ns}/${secret_name}." >&2
  return 1
}

ensure_victoria_metrics_scrape_resources() {
  local output_rows_array_name="${1:-}"
  local -a custom_rows=()
  local -a configured_rows=()
  local row ns tonnode_name custom_parameters exporter_address exporter_port
  local service_name scrape_name service_suffix
  local matched_count=0

  mapfile -t custom_rows < <(resolve_tonnode_custom_parameters_rows 2>/dev/null || true)
  for row in "${custom_rows[@]}"; do
    [[ -z "$row" ]] && continue
    IFS=$'\t' read -r ns tonnode_name custom_parameters <<<"$row"
    ns="$(trim_whitespace "$ns")"
    tonnode_name="$(trim_whitespace "$tonnode_name")"
    custom_parameters="$(trim_whitespace "$custom_parameters")"
    if [[ -z "$ns" || -z "$tonnode_name" || -z "$custom_parameters" || "$custom_parameters" == "<no value>" ]]; then
      continue
    fi

    exporter_address="$(extract_exporter_address "$custom_parameters")"
    if [[ -z "$exporter_address" ]]; then
      continue
    fi
    ((matched_count+=1))
    exporter_port="$(extract_exporter_port "$exporter_address")"
    if ! [[ "$exporter_port" =~ ^[0-9]+$ ]]; then
      echo "Warning: ignoring invalid --exporter-address '${exporter_address}' from TonNode ${ns}/${tonnode_name} for VictoriaMetrics scraping." >&2
      continue
    fi

    service_suffix="$(sanitize_k8s_name_fragment "$tonnode_name")"
    service_name="kubeton-vm-target-${service_suffix}"
    scrape_name="${service_name}-scrape"

    if ! cat <<EOF | kubectl -n "$ns" apply -f - >/dev/null
apiVersion: v1
kind: Service
metadata:
  name: ${service_name}
  labels:
    app.kubernetes.io/name: kubeton-victoria-metrics-target
    app.kubernetes.io/instance: ${service_name}
    app.kubernetes.io/managed-by: kubeton
    app.kubernetes.io/part-of: kubeton-victoria-metrics
    ton.ton.org/tonnode: ${tonnode_name}
  annotations:
    ton.ton.org/exporter-address: $(yaml_quote "$exporter_address")
spec:
  selector:
    app.kubernetes.io/name: ton-node
    app.kubernetes.io/instance: ${tonnode_name}
  ports:
    - name: metrics
      protocol: TCP
      port: ${exporter_port}
      targetPort: ${exporter_port}
---
apiVersion: operator.victoriametrics.com/v1beta1
kind: VMServiceScrape
metadata:
  name: ${scrape_name}
  labels:
    app.kubernetes.io/name: kubeton-victoria-metrics-target
    app.kubernetes.io/instance: ${service_name}
    app.kubernetes.io/managed-by: kubeton
    app.kubernetes.io/part-of: kubeton-victoria-metrics
    ton.ton.org/tonnode: ${tonnode_name}
  annotations:
    ton.ton.org/exporter-address: $(yaml_quote "$exporter_address")
spec:
  selector:
    matchLabels:
      app.kubernetes.io/name: kubeton-victoria-metrics-target
      app.kubernetes.io/instance: ${service_name}
  endpoints:
    - port: metrics
      path: /metrics
      interval: 15s
EOF
    then
      echo "Warning: failed to create VictoriaMetrics scrape resources for TonNode ${ns}/${tonnode_name}." >&2
      continue
    fi
    kubectl -n "$ns" wait --for=jsonpath='{.status.updateStatus}'=operational "vmservicescrape/${scrape_name}" --timeout=120s >/dev/null 2>&1 || true
    configured_rows+=("${ns}"$'\t'"${service_name}"$'\t'"${scrape_name}"$'\t'"${exporter_address}")
  done

  if [[ -n "$output_rows_array_name" ]]; then
    local -n output_rows_ref="$output_rows_array_name"
    output_rows_ref=("${configured_rows[@]}")
  fi

  if [[ ${#configured_rows[@]} -gt 0 ]]; then
    for row in "${configured_rows[@]}"; do
      IFS=$'\t' read -r ns service_name scrape_name exporter_address <<<"$row"
      echo "[victoria-metrics] ${ns}/${scrape_name} -> ${service_name} from --exporter-address ${exporter_address}."
    done
    return 0
  fi

  if (( matched_count == 0 )); then
    if cluster_has_tonnodes; then
      echo "Error: TonNode resources found, but none expose --exporter-address in CUSTOM_PARAMETERS; cannot configure VictoriaMetrics scraping." >&2
      return 1
    fi
    echo "[victoria-metrics] No TonNode resources found yet; skipping TonNode scrape resource creation."
    return 0
  fi

  echo "Error: no VictoriaMetrics scrape resources were created. Check TonNode exporter configuration and pod readiness." >&2
  return 1
}

victoria_metrics_port_forward_address() {
  local configured
  configured="$(trim_whitespace "${VICTORIA_METRICS_PORT_FORWARD_ADDRESS:-}")"
  if [[ -n "$configured" ]]; then
    printf '%s' "$configured"
    return 0
  fi

  if cluster_is_baremetal && ! cluster_is_k3d; then
    printf '%s' "0.0.0.0"
    return 0
  fi

  printf '%s' "127.0.0.1"
}

wait_victoria_metrics_http_ready() {
  local local_port="$1"
  local verify_seconds="$2"
  local deadline now status_code

  if ! [[ "$verify_seconds" =~ ^[0-9]+$ ]]; then
    verify_seconds=20
  fi
  if (( verify_seconds <= 0 )); then
    return 0
  fi
  if ! command -v curl >/dev/null 2>&1; then
    return 0
  fi

  deadline=$(( $(date +%s) + verify_seconds ))
  while :; do
    status_code="$(curl -sS -o /dev/null --max-time 3 -w '%{http_code}' "http://127.0.0.1:${local_port}/" || true)"
    if [[ "$status_code" == "200" || "$status_code" == "401" || "$status_code" == "403" || "$status_code" == "404" ]]; then
      return 0
    fi

    now="$(date +%s)"
    if (( now >= deadline )); then
      return 1
    fi
    sleep 1
  done
}

ensure_victoria_metrics_port_forward() {
  local ns="$1"
  local service_name="$2"
  local local_port="$3"
  local remote_port="$4"
  local bind_address="${5:-127.0.0.1}"
  local quiet="${6:-false}"
  local state_dir="${VICTORIA_METRICS_PORT_FORWARD_DIR}"
  local wait_seconds="${VICTORIA_METRICS_PORT_FORWARD_WAIT_SECONDS}"
  local verify_seconds="${VICTORIA_METRICS_PORT_FORWARD_VERIFY_SECONDS}"
  local key pid_file log_file existing_pid pf_pid deadline now

  if ! [[ "$local_port" =~ ^[0-9]+$ ]] || ! [[ "$remote_port" =~ ^[0-9]+$ ]]; then
    return 1
  fi
  if ! [[ "$wait_seconds" =~ ^[0-9]+$ ]]; then
    wait_seconds=5
  fi
  if ! [[ "$verify_seconds" =~ ^[0-9]+$ ]]; then
    verify_seconds=20
  fi

  mkdir -p "$state_dir"
  key="$(sanitize_file_name_fragment "${ns}__${service_name}__${local_port}")"
  pid_file="${state_dir}/${key}.pid"
  log_file="${state_dir}/${key}.log"

  if [[ -f "$pid_file" ]]; then
    existing_pid="$(cat "$pid_file" 2>/dev/null || true)"
    if [[ "$existing_pid" =~ ^[0-9]+$ ]] && kill -0 "$existing_pid" >/dev/null 2>&1; then
      if port_forward_process_matches "$existing_pid" "$ns" "$service_name" "$local_port" "$remote_port" "$bind_address"; then
        if wait_victoria_metrics_http_ready "$local_port" 2; then
          printf '%s\t%s\t%s\t%s\t%s\n' "$ns" "$service_name" "$local_port" "$existing_pid" "$log_file"
          return 0
        fi
      fi
      kill "$existing_pid" >/dev/null 2>&1 || true
    fi
    rm -f "$pid_file" >/dev/null 2>&1 || true
  fi

  nohup kubectl -n "$ns" port-forward --address "$bind_address" "svc/${service_name}" "${local_port}:${remote_port}" >"$log_file" 2>&1 &
  pf_pid="$!"
  echo "$pf_pid" >"$pid_file"

  deadline=$(( $(date +%s) + wait_seconds ))
  while :; do
    if ! kill -0 "$pf_pid" >/dev/null 2>&1; then
      rm -f "$pid_file" >/dev/null 2>&1 || true
      if [[ "$quiet" != "1" && "$quiet" != "true" ]]; then
        echo "Warning: failed to start background port-forward for ${ns}/${service_name} on localhost:${local_port}." >&2
        echo "Warning: see ${log_file}" >&2
      fi
      return 1
    fi
    if grep -q "Forwarding from" "$log_file" 2>/dev/null; then
      if ! wait_victoria_metrics_http_ready "$local_port" "$verify_seconds"; then
        kill "$pf_pid" >/dev/null 2>&1 || true
        rm -f "$pid_file" >/dev/null 2>&1 || true
        if [[ "$quiet" != "1" && "$quiet" != "true" ]]; then
          echo "Warning: port-forward for ${ns}/${service_name} started on localhost:${local_port}, but VictoriaMetrics auth endpoint is not ready." >&2
          echo "Warning: see ${log_file}" >&2
        fi
        return 1
      fi
      if ! kill -0 "$pf_pid" >/dev/null 2>&1 || ! wait_victoria_metrics_http_ready "$local_port" 2; then
        kill "$pf_pid" >/dev/null 2>&1 || true
        rm -f "$pid_file" >/dev/null 2>&1 || true
        if [[ "$quiet" != "1" && "$quiet" != "true" ]]; then
          echo "Warning: port-forward for ${ns}/${service_name} became unavailable immediately after startup on localhost:${local_port}." >&2
          echo "Warning: see ${log_file}" >&2
        fi
        return 1
      fi
      printf '%s\t%s\t%s\t%s\t%s\n' "$ns" "$service_name" "$local_port" "$pf_pid" "$log_file"
      return 0
    fi
    now="$(date +%s)"
    if (( now >= deadline )); then
      kill "$pf_pid" >/dev/null 2>&1 || true
      rm -f "$pid_file" >/dev/null 2>&1 || true
      if [[ "$quiet" != "1" && "$quiet" != "true" ]]; then
        echo "Warning: timed out waiting for port-forward readiness for ${ns}/${service_name} on localhost:${local_port}." >&2
        echo "Warning: see ${log_file}" >&2
      fi
      return 1
    fi
    sleep 1
  done
}

start_victoria_metrics_auth_port_forward() {
  local ns="$1"
  local service_name="$2"
  local base_port="$3"
  local remote_port="$4"
  local bind_address="$5"
  local forward_row attempt quiet_attempt

  if ! [[ "$base_port" =~ ^[0-9]+$ ]]; then
    base_port=8427
  fi

  for ((attempt=0; attempt<25; attempt++)); do
    quiet_attempt="true"
    if (( attempt == 24 )); then
      quiet_attempt="false"
    fi
    if forward_row="$(ensure_victoria_metrics_port_forward "$ns" "$service_name" "$((base_port + attempt))" "$remote_port" "$bind_address" "$quiet_attempt")"; then
      printf '%s' "$forward_row"
      return 0
    fi
  done
  return 1
}

wait_kubectl_proxy_ready() {
  local local_port="$1"
  local verify_seconds="$2"
  local deadline now

  if ! [[ "$verify_seconds" =~ ^[0-9]+$ ]]; then
    verify_seconds=20
  fi
  if (( verify_seconds <= 0 )); then
    return 0
  fi
  if ! command -v curl >/dev/null 2>&1; then
    return 0
  fi

  deadline=$(( $(date +%s) + verify_seconds ))
  while :; do
    if curl -fsS --max-time 3 "http://127.0.0.1:${local_port}/version" >/dev/null 2>&1; then
      return 0
    fi

    now="$(date +%s)"
    if (( now >= deadline )); then
      return 1
    fi
    sleep 1
  done
}

ensure_victoria_metrics_api_proxy() {
  local local_port="$1"
  local state_dir="${VICTORIA_METRICS_PORT_FORWARD_DIR}"
  local wait_seconds="${VICTORIA_METRICS_PORT_FORWARD_WAIT_SECONDS}"
  local verify_seconds="${VICTORIA_METRICS_PORT_FORWARD_VERIFY_SECONDS}"
  local pid_file log_file proxy_pid deadline now

  if ! [[ "$local_port" =~ ^[0-9]+$ ]]; then
    return 1
  fi
  if ! [[ "$wait_seconds" =~ ^[0-9]+$ ]]; then
    wait_seconds=5
  fi
  if ! [[ "$verify_seconds" =~ ^[0-9]+$ ]]; then
    verify_seconds=20
  fi

  mkdir -p "$state_dir"
  pid_file="${state_dir}/proxy-${local_port}.pid"
  log_file="${state_dir}/proxy-${local_port}.log"

  if [[ -f "$pid_file" ]]; then
    proxy_pid="$(cat "$pid_file" 2>/dev/null || true)"
    if [[ "$proxy_pid" =~ ^[0-9]+$ ]] && kill -0 "$proxy_pid" >/dev/null 2>&1; then
      if wait_kubectl_proxy_ready "$local_port" 2; then
        printf '%s\t%s\t%s\n' "$local_port" "$proxy_pid" "$log_file"
        return 0
      fi
      kill "$proxy_pid" >/dev/null 2>&1 || true
    fi
    rm -f "$pid_file" >/dev/null 2>&1 || true
  fi

  if command -v setsid >/dev/null 2>&1; then
    setsid kubectl proxy --disable-filter --address 127.0.0.1 --port "$local_port" >"$log_file" 2>&1 < /dev/null &
  else
    nohup kubectl proxy --disable-filter --address 127.0.0.1 --port "$local_port" >"$log_file" 2>&1 &
  fi
  proxy_pid="$!"
  echo "$proxy_pid" >"$pid_file"

  deadline=$(( $(date +%s) + wait_seconds ))
  while :; do
    if ! kill -0 "$proxy_pid" >/dev/null 2>&1; then
      rm -f "$pid_file" >/dev/null 2>&1 || true
      return 1
    fi
    if wait_kubectl_proxy_ready "$local_port" 1; then
      if ! wait_kubectl_proxy_ready "$local_port" "$verify_seconds"; then
        kill "$proxy_pid" >/dev/null 2>&1 || true
        rm -f "$pid_file" >/dev/null 2>&1 || true
        return 1
      fi
      printf '%s\t%s\t%s\n' "$local_port" "$proxy_pid" "$log_file"
      return 0
    fi
    now="$(date +%s)"
    if (( now >= deadline )); then
      kill "$proxy_pid" >/dev/null 2>&1 || true
      rm -f "$pid_file" >/dev/null 2>&1 || true
      return 1
    fi
    sleep 1
  done
}

ensure_victoria_metrics_nodeport_access() {
  local ns="$1"
  local stack_name="$2"
  local remote_port="$3"
  local service_name="kubeton-vmauth-nodeport-${stack_name}"
  local node_port
  local -a node_ip_rows=()
  local row node_name node_ip ip_source
  local printed=0
  local -A seen_ip=()

  if ! [[ "$remote_port" =~ ^[0-9]+$ ]]; then
    remote_port=8427
  fi

  if ! cat <<EOF | kubectl -n "$ns" apply -f - >/dev/null
apiVersion: v1
kind: Service
metadata:
  name: ${service_name}
  labels:
    app.kubernetes.io/name: kubeton-victoria-metrics-access
    app.kubernetes.io/managed-by: kubeton
    app.kubernetes.io/part-of: kubeton-victoria-metrics
spec:
  type: NodePort
  selector:
    app.kubernetes.io/name: vmauth
    app.kubernetes.io/instance: ${stack_name}
  ports:
    - name: http
      protocol: TCP
      port: ${remote_port}
      targetPort: ${remote_port}
EOF
  then
    echo "Warning: failed to create VictoriaMetrics NodePort access Service ${ns}/${service_name}." >&2
    return 1
  fi

  node_port="$(kubectl -n "$ns" get service "$service_name" -o jsonpath='{.spec.ports[0].nodePort}' 2>/dev/null || true)"
  node_port="$(trim_whitespace "$node_port")"
  if ! [[ "$node_port" =~ ^[0-9]+$ ]]; then
    echo "Warning: failed to resolve NodePort for VictoriaMetrics access service ${ns}/${service_name}." >&2
    return 1
  fi
  echo "[victoria-metrics] NodePort service: ${ns}/${service_name} (${node_port})"

  mapfile -t node_ip_rows < <(list_node_external_ip_rows)
  for row in "${node_ip_rows[@]}"; do
    [[ -z "$row" ]] && continue
    IFS=$'\t' read -r node_name node_ip ip_source <<<"$row"
    node_name="$(trim_whitespace "$node_name")"
    node_ip="$(trim_whitespace "$node_ip")"
    ip_source="$(trim_whitespace "$ip_source")"
    [[ -z "$node_ip" ]] && continue
    if [[ -n "${seen_ip[$node_ip]:-}" ]]; then
      continue
    fi
    seen_ip["$node_ip"]=1
    ((printed+=1))
    echo "[victoria-metrics] NodePort VMUI access (${ip_source} ${node_name}): http://${node_ip}:${node_port}/vmui/"
    echo "[victoria-metrics] NodePort targets access (${ip_source} ${node_name}): http://${node_ip}:${node_port}/targets"
    echo "[victoria-metrics] NodePort VictoriaLogs VMUI access (${ip_source} ${node_name}, auth via VMAuth): http://${node_ip}:${node_port}/select/vmui/"
    echo "[victoria-metrics] NodePort VictoriaLogs query API (${ip_source} ${node_name}, auth via VMAuth): http://${node_ip}:${node_port}/select/logsql/query"
  done

  if (( printed == 0 )); then
    echo "[victoria-metrics] NodePort VMUI access: <node-ip>:${node_port}/vmui/"
    echo "[victoria-metrics] NodePort targets access: <node-ip>:${node_port}/targets"
    echo "[victoria-metrics] NodePort VictoriaLogs VMUI access (auth via VMAuth): <node-ip>:${node_port}/select/vmui/"
    echo "[victoria-metrics] NodePort VictoriaLogs query API (auth via VMAuth): <node-ip>:${node_port}/select/logsql/query"
  fi
}

ensure_victoria_logs_access_service() {
  local ns="$1"
  local release_name="$2"
  local collector_release_name="$3"
  local remote_port="$4"
  local service_name network_policy_name auth_namespace auth_stack_name

  if ! [[ "$remote_port" =~ ^[0-9]+$ ]]; then
    remote_port=9428
  fi
  service_name="$(victoria_logs_access_service_name "$release_name")"
  network_policy_name="${service_name}-ingress"
  auth_namespace="$(trim_whitespace "${VICTORIA_METRICS_NAMESPACE:-vm}")"
  [[ -n "$auth_namespace" ]] || auth_namespace="vm"
  auth_stack_name="$(victoria_metrics_stack_name)"

  # The Service is used by vlagent for ingestion and by VMAuth for queries,
  # but the backend itself has no authentication. Isolate it so arbitrary
  # in-cluster Pods cannot bypass VMAuth and query collected logs directly.
  if is_true "$VICTORIA_LOGS_NETWORK_POLICY_ENABLED"; then
    if ! cat <<EOF | kubectl -n "$ns" apply -f - >/dev/null
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: ${network_policy_name}
  labels:
    app.kubernetes.io/name: kubeton-victoria-logs-access
    app.kubernetes.io/managed-by: kubeton
    app.kubernetes.io/part-of: kubeton-victoria-logs
spec:
  podSelector:
    matchLabels:
      app: server
      app.kubernetes.io/instance: ${release_name}
      app.kubernetes.io/name: victoria-logs-single
  policyTypes:
    - Ingress
  ingress:
    - from:
        - podSelector:
            matchLabels:
              app.kubernetes.io/instance: ${collector_release_name}
              app.kubernetes.io/name: victoria-logs-collector
        - namespaceSelector:
            matchLabels:
              kubernetes.io/metadata.name: ${auth_namespace}
          podSelector:
            matchLabels:
              app.kubernetes.io/instance: ${auth_stack_name}
              app.kubernetes.io/name: vmauth
      ports:
        - protocol: TCP
          port: http
EOF
    then
      echo "Error: failed to protect VictoriaLogs backend ${ns}/${release_name} with NetworkPolicy ${network_policy_name}." >&2
      return 1
    fi
  else
    echo "Warning: VICTORIA_LOGS_NETWORK_POLICY_ENABLED=false; the unauthenticated VictoriaLogs backend is reachable by other in-cluster Pods." >&2
    if ! kubectl -n "$ns" delete networkpolicy "$network_policy_name" --ignore-not-found >/dev/null; then
      echo "Error: failed to remove disabled VictoriaLogs NetworkPolicy ${ns}/${network_policy_name}." >&2
      return 1
    fi
  fi

  if ! cat <<EOF | kubectl -n "$ns" apply -f - >/dev/null
apiVersion: v1
kind: Service
metadata:
  name: ${service_name}
  labels:
    app.kubernetes.io/name: kubeton-victoria-logs-access
    app.kubernetes.io/managed-by: kubeton
    app.kubernetes.io/part-of: kubeton-victoria-logs
spec:
  type: ClusterIP
  selector:
    app: server
    app.kubernetes.io/instance: ${release_name}
    app.kubernetes.io/name: victoria-logs-single
  ports:
    - name: http
      protocol: TCP
      port: ${remote_port}
      targetPort: http
EOF
  then
    echo "Error: failed to create VictoriaLogs access Service ${ns}/${service_name}." >&2
    return 1
  fi
  printf '%s' "$service_name"
}

victoria_logs_collector_buffer_path() {
  local ns="$1"
  local collector_release_name="$2"
  local safe_ns safe_release

  # Namespace and Helm release names are DNS labels already. Preserve their
  # complete identities here rather than applying the generic 30-character
  # name truncation, which could make two releases share a host buffer.
  safe_ns="$(printf '%s' "$ns" | tr '[:upper:]' '[:lower:]' | sed -E 's/[^a-z0-9.-]+/-/g; s/-+/-/g; s/^[.-]+//; s/[.-]+$//')"
  safe_release="$(printf '%s' "$collector_release_name" | tr '[:upper:]' '[:lower:]' | sed -E 's/[^a-z0-9.-]+/-/g; s/-+/-/g; s/^[.-]+//; s/[.-]+$//')"
  [[ -n "$safe_ns" && -n "$safe_release" ]] || return 1
  printf '/var/lib/kubeton-vlogs-buffer-%s-%s' "$safe_ns" "$safe_release"
}

install_victoria_logs_collector_release() {
  local ns="$1"
  local collector_release_name="$2"
  local collector_chart="$3"
  local collector_chart_version="$4"
  local remote_write_url="$5"
  local helm_timeout_seconds="$6"
  local collector_node_selector="$7"
  local collector_buffer_path vlc_selector_values_file=""
  local -a vlc_cmd=()

  if ! collector_buffer_path="$(victoria_logs_collector_buffer_path "$ns" "$collector_release_name")"; then
    echo "Error: cannot derive a safe VictoriaLogs collector host-buffer path for ${ns}/${collector_release_name}." >&2
    return 1
  fi
  if [[ -n "$collector_node_selector" ]]; then
    vlc_selector_values_file="$(build_victoria_logs_collector_selector_values_file "$collector_node_selector")" || return 1
  fi

  # The release-specific host path survives collector restarts and allows an
  # early collector to queue logs before the VictoriaLogs Service exists.
  # Never share this queue between collector releases.
  vlc_cmd=(helm upgrade --install "$collector_release_name" "$collector_chart" -n "$ns" --create-namespace --timeout "${helm_timeout_seconds}s" \
    --set-string "remoteWrite[0].url=${remote_write_url}" \
    --set-string "remoteWrite[0].maxDiskUsagePerURL=${VICTORIA_LOGS_COLLECTOR_BUFFER_SIZE}" \
    --set-string "collector.excludeFilter=kubernetes.pod_name:=%{HOSTNAME}" \
    --set-string "extraArgs.tmpDataPath=${collector_buffer_path}" \
    --set-string "persistence.volume.hostPath.path=${collector_buffer_path}" \
    --set-string "persistence.volume.hostPath.type=DirectoryOrCreate" \
    --set-string "resources.requests.cpu=${VICTORIA_LOGS_COLLECTOR_CPU_REQUEST}" \
    --set-string "resources.requests.memory=${VICTORIA_LOGS_COLLECTOR_MEMORY_REQUEST}" \
    --set-string "resources.requests.ephemeral-storage=${VICTORIA_LOGS_COLLECTOR_EPHEMERAL_STORAGE_REQUEST}" \
    --set-string "resources.limits.cpu=${VICTORIA_LOGS_COLLECTOR_CPU_LIMIT}" \
    --set-string "resources.limits.memory=${VICTORIA_LOGS_COLLECTOR_MEMORY_LIMIT}" \
    --set-string "resources.limits.ephemeral-storage=${VICTORIA_LOGS_COLLECTOR_EPHEMERAL_STORAGE_LIMIT}")
  if [[ -n "$vlc_selector_values_file" ]]; then
    vlc_cmd+=(-f "$vlc_selector_values_file")
  fi
  if [[ -n "$collector_chart_version" ]]; then
    vlc_cmd+=(--version "$collector_chart_version")
  fi

  echo "[victoria-metrics] Installing/updating VictoriaLogs collector (${collector_release_name}); host buffer: ${collector_buffer_path}" >&2
  if ! run_with_timeout "${helm_timeout_seconds}s" "${vlc_cmd[@]}" >/dev/null; then
    [[ -z "$vlc_selector_values_file" ]] || rm -f "$vlc_selector_values_file" >/dev/null 2>&1 || true
    echo "Error: failed to install/upgrade VictoriaLogs collector release ${collector_release_name} in namespace ${ns}." >&2
    return 1
  fi
  [[ -z "$vlc_selector_values_file" ]] || rm -f "$vlc_selector_values_file" >/dev/null 2>&1 || true
}

ensure_start_victoria_logs_buffering_collector() {
  local logs_ns logs_release_name collector_release_name remote_port timeout_seconds helm_timeout_seconds
  local repo_name repo_url collector_chart collector_chart_version collector_node_selector
  local access_service remote_write_url collector_daemonset

  if ! is_true "$KUBETON_START_VICTORIA_LOGS_ENABLED" || ! is_true "$VICTORIA_LOGS_ENABLED"; then
    return 0
  fi
  require_bin helm
  logs_ns="$(victoria_logs_namespace)"
  logs_release_name="$(victoria_logs_release_name)"
  collector_release_name="$(victoria_logs_collector_release_name)"
  remote_port="$(trim_whitespace "${VICTORIA_LOGS_PORT:-9428}")"
  [[ "$remote_port" =~ ^[0-9]+$ ]] || remote_port=9428
  timeout_seconds="$(resolve_victoria_metrics_rollout_timeout_seconds)"
  helm_timeout_seconds="$(resolve_victoria_logs_helm_timeout_seconds)"
  repo_name="$(trim_whitespace "${VICTORIA_LOGS_HELM_REPO_NAME:-vm}")"
  [[ -n "$repo_name" ]] || repo_name=vm
  repo_url="$(trim_whitespace "${VICTORIA_LOGS_HELM_REPO_URL:-https://victoriametrics.github.io/helm-charts}")"
  [[ -n "$repo_url" ]] || repo_url=https://victoriametrics.github.io/helm-charts
  collector_chart="${repo_name}/victoria-logs-collector"
  collector_chart_version="$(trim_whitespace "${VICTORIA_LOGS_COLLECTOR_CHART_VERSION:-}")"
  collector_node_selector="$(trim_whitespace "${VICTORIA_LOGS_COLLECTOR_NODE_SELECTOR:-}")"
  access_service="$(victoria_logs_access_service_name "$logs_release_name")"
  remote_write_url="http://${access_service}:${remote_port}"
  collector_daemonset="$(victoria_logs_collector_daemonset_name "$collector_release_name")"

  echo "[launch] Starting the durable node-log buffer before storage/key bootstrap ..." >&2
  if ! ensure_namespace "$logs_ns"; then
    echo "Error: the pre-bootstrap VictoriaLogs namespace ${logs_ns} could not be ensured; storage/key bootstrap was not started." >&2
    return 1
  fi
  # Persist the intended release identities and exact host-buffer path before
  # Helm runs. A failed/partial custom-named Helm install must remain
  # discoverable by a later plain uninstall even when readiness is never
  # reached. Recording intent is safe when Helm creates no resources: cleanup
  # simply finds nothing under these exact identities.
  if ! write_victoria_logs_state "$OP_NAMESPACE" "$logs_ns" "$logs_release_name" \
      "$collector_release_name" "$access_service" "$collector_daemonset"; then
    echo "Error: the pre-bootstrap VictoriaLogs collector state could not be persisted; storage/key bootstrap was not started." >&2
    return 1
  fi
  if ! ensure_helm_repo "$repo_name" "$repo_url" \
    || ! helm repo update "$repo_name" >/dev/null \
    || ! install_victoria_logs_collector_release "$logs_ns" "$collector_release_name" \
      "$collector_chart" "$collector_chart_version" "$remote_write_url" \
      "$helm_timeout_seconds" "$collector_node_selector"; then
    echo "Error: the pre-bootstrap VictoriaLogs collector could not be installed; storage/key bootstrap was not started." >&2
    return 1
  fi
  # The exact Pod-level gate also handles an empty TON selector by requiring a
  # current, owned, non-terminating Ready collector on every DaemonSet target.
  # `kubectl rollout status` alone can briefly accept a Ready Pod which is
  # already terminating.
  wait_victoria_logs_collector_ready_on_selected_nodes "$logs_ns" "$collector_release_name" \
    "${KUBETON_NODE_CHECK_TON_SELECTOR:-}" "$timeout_seconds" || return 1
  echo "[launch] Pre-bootstrap container-log buffering is active; queued logs will flush when VictoriaLogs becomes available." >&2
}

ensure_victoria_logs_stack() {
  local ns="$1"
  local release_name="$2"
  local collector_release_name="$3"
  local remote_port="$4"
  local retention_period="$5"
  local pvc_size="$6"
  local rollout_timeout_seconds="$7"
  local helm_timeout_seconds="$8"
  local repo_name repo_url single_chart collector_chart
  local single_chart_version collector_chart_version
  local logs_storage_class logs_node_selector collector_node_selector logs_pin_to_longhorn_csi
  local vls_selector_values_file="" vls_affinity_values_file=""
  local matched_nodes=0
  local -a longhorn_csi_nodes=()
  local service_name collector_daemonset access_service_name remote_write_url
  local ds_desired ds_ready
  local -a vls_cmd=()

  repo_name="$(trim_whitespace "${VICTORIA_LOGS_HELM_REPO_NAME:-vm}")"
  if [[ -z "$repo_name" ]]; then
    repo_name="vm"
  fi
  repo_url="$(trim_whitespace "${VICTORIA_LOGS_HELM_REPO_URL:-https://victoriametrics.github.io/helm-charts}")"
  if [[ -z "$repo_url" ]]; then
    repo_url="https://victoriametrics.github.io/helm-charts"
  fi
  single_chart="${repo_name}/victoria-logs-single"
  collector_chart="${repo_name}/victoria-logs-collector"
  single_chart_version="$(trim_whitespace "${VICTORIA_LOGS_SINGLE_CHART_VERSION:-}")"
  collector_chart_version="$(trim_whitespace "${VICTORIA_LOGS_COLLECTOR_CHART_VERSION:-}")"
  logs_storage_class="$(trim_whitespace "${VICTORIA_LOGS_STORAGE_CLASS:-}")"
  logs_node_selector="$(trim_whitespace "${VICTORIA_LOGS_NODE_SELECTOR:-}")"
  collector_node_selector="$(trim_whitespace "${VICTORIA_LOGS_COLLECTOR_NODE_SELECTOR:-}")"
  logs_pin_to_longhorn_csi="$(trim_whitespace "${VICTORIA_LOGS_PIN_TO_LONGHORN_CSI:-true}")"
  if [[ -z "$logs_node_selector" && ! cluster_is_k3d ]]; then
    logs_node_selector="$(trim_whitespace "${LONGHORN_NODE_SELECTOR:-}")"
  fi

  if ! [[ "$rollout_timeout_seconds" =~ ^[0-9]+$ ]] || (( rollout_timeout_seconds < 60 )); then
    rollout_timeout_seconds=300
  fi
  if ! [[ "$helm_timeout_seconds" =~ ^[0-9]+$ ]] || (( helm_timeout_seconds < 60 )); then
    helm_timeout_seconds=600
  fi
  if ! [[ "$remote_port" =~ ^[0-9]+$ ]]; then
    remote_port=9428
  fi
  if [[ -z "$logs_storage_class" ]] && kubectl get storageclass longhorn >/dev/null 2>&1; then
    logs_storage_class="longhorn"
  fi
  if [[ -n "$logs_node_selector" ]]; then
    matched_nodes="$(kubectl get nodes -l "$logs_node_selector" --no-headers 2>/dev/null | awk 'NF{c++} END{print c+0}')"
    if ! [[ "$matched_nodes" =~ ^[0-9]+$ ]]; then
      matched_nodes=0
    fi
  fi
  if [[ "$logs_storage_class" == "longhorn" ]] && is_true "$logs_pin_to_longhorn_csi"; then
    mapfile -t longhorn_csi_nodes < <(list_longhorn_csi_node_names)
  fi

  if ! ensure_namespace "$ns"; then
    echo "Error: failed to ensure VictoriaLogs namespace ${ns}." >&2
    return 1
  fi
  if ! ensure_helm_repo "$repo_name" "$repo_url"; then
    echo "Error: failed to ensure VictoriaLogs Helm repository ${repo_name}." >&2
    return 1
  fi
  if ! helm repo update "$repo_name" >/dev/null; then
    echo "Error: failed to update VictoriaLogs Helm repository ${repo_name}." >&2
    return 1
  fi

  service_name="$(victoria_logs_service_name "$release_name")"
  collector_daemonset="$(victoria_logs_collector_daemonset_name "$collector_release_name")"
  # Create the restrictive policy before the backend Pod exists, eliminating
  # an unauthenticated in-cluster exposure window during Helm rollout. The
  # Service may safely have no endpoints until the StatefulSet becomes Ready.
  if ! access_service_name="$(ensure_victoria_logs_access_service "$ns" "$release_name" "$collector_release_name" "$remote_port")"; then
    return 1
  fi
  access_service_name="$(trim_whitespace "$access_service_name")"
  if [[ -z "$access_service_name" ]]; then
    echo "Error: VictoriaLogs access Service name could not be resolved." >&2
    return 1
  fi
  remote_write_url="http://${access_service_name}:${remote_port}"
  if [[ -n "$logs_node_selector" ]]; then
    vls_selector_values_file="$(build_victoria_logs_single_selector_values_file "$logs_node_selector")" || return 1
  fi
  if [[ "${#longhorn_csi_nodes[@]}" -gt 0 ]]; then
    vls_affinity_values_file="$(build_victoria_logs_single_affinity_values_file longhorn_csi_nodes)" || return 1
  fi
  vls_cmd=(helm upgrade --install "$release_name" "$single_chart" -n "$ns" --create-namespace --wait --timeout "${helm_timeout_seconds}s" \
    --set-string "server.retentionPeriod=${retention_period}" \
    --set-string "server.persistentVolume.size=${pvc_size}" \
    --set-string "server.retentionDiskSpaceUsage=${VICTORIA_LOGS_RETENTION_DISK_SPACE}")
  if [[ -n "$logs_storage_class" ]]; then
    vls_cmd+=(--set-string "server.persistentVolume.storageClassName=${logs_storage_class}")
  fi
  if [[ -n "$vls_selector_values_file" ]]; then
    vls_cmd+=(-f "$vls_selector_values_file")
  fi
  if [[ -n "$vls_affinity_values_file" ]]; then
    vls_cmd+=(-f "$vls_affinity_values_file")
  fi
  if [[ -n "$single_chart_version" ]]; then
    vls_cmd+=(--version "$single_chart_version")
  fi

  echo "[victoria-metrics] Installing/updating VictoriaLogs single (${release_name}) ..." >&2
  if [[ -n "$logs_storage_class" ]]; then
    echo "[victoria-metrics] VictoriaLogs single storageClass: ${logs_storage_class}" >&2
  fi
  if [[ -n "$logs_node_selector" ]]; then
    echo "[victoria-metrics] VictoriaLogs single nodeSelector: ${logs_node_selector} (matched ${matched_nodes} node(s))" >&2
  fi
  if [[ "${#longhorn_csi_nodes[@]}" -gt 0 ]]; then
    echo "[victoria-metrics] VictoriaLogs single Longhorn CSI nodeAffinity enabled for ${#longhorn_csi_nodes[@]} node(s)." >&2
  elif [[ "$logs_storage_class" == "longhorn" ]] && is_true "$logs_pin_to_longhorn_csi"; then
    echo "Warning: no Longhorn CSI nodes detected in CSINode objects; cannot apply VictoriaLogs CSI nodeAffinity fallback." >&2
  fi
  if ! run_with_timeout "${helm_timeout_seconds}s" "${vls_cmd[@]}" >/dev/null; then
    if [[ -n "$vls_selector_values_file" ]]; then
      rm -f "$vls_selector_values_file" >/dev/null 2>&1 || true
    fi
    if [[ -n "$vls_affinity_values_file" ]]; then
      rm -f "$vls_affinity_values_file" >/dev/null 2>&1 || true
    fi
    echo "Error: failed to install/upgrade VictoriaLogs single release ${release_name} in namespace ${ns}." >&2
    if [[ -n "$logs_storage_class" ]]; then
      echo "Warning: VictoriaLogs storageClassName in use: ${logs_storage_class}" >&2
    fi
    if [[ -n "$logs_node_selector" ]]; then
      echo "Warning: VictoriaLogs nodeSelector in use: ${logs_node_selector}" >&2
    fi
    echo "Warning: recent VictoriaLogs pod/PVC diagnostics:" >&2
    kubectl -n "$ns" get pod "${service_name}-0" -o wide >/dev/null 2>&1 && kubectl -n "$ns" get pod "${service_name}-0" -o wide >&2 || true
    kubectl -n "$ns" get pvc 2>/dev/null | awk -v prefix="server-volume-${service_name}-" 'NR==1 || index($1, prefix)==1 {print}' >&2 || true
    kubectl -n "$ns" get events --field-selector "involvedObject.name=${service_name}-0" --sort-by=.lastTimestamp 2>/dev/null | tail -n 8 >&2 || true
    if [[ -z "$logs_node_selector" ]]; then
      echo "Warning: if Longhorn CSI runs only on selected nodes, set VICTORIA_LOGS_NODE_SELECTOR (for example: ${LONGHORN_NODE_SELECTOR})." >&2
    else
      echo "Warning: verify that nodes matching VICTORIA_LOGS_NODE_SELECTOR run Longhorn CSI driver." >&2
    fi
    return 1
  fi
  if [[ -n "$vls_selector_values_file" ]]; then
    rm -f "$vls_selector_values_file" >/dev/null 2>&1 || true
  fi
  if [[ -n "$vls_affinity_values_file" ]]; then
    rm -f "$vls_affinity_values_file" >/dev/null 2>&1 || true
  fi

  # Keep the collector cluster-wide by default. An unrelated cordoned or
  # tainted node must not make Helm reject launch logging for healthy TON
  # targets; selected TON nodes are verified individually below.
  if ! install_victoria_logs_collector_release "$ns" "$collector_release_name" \
    "$collector_chart" "$collector_chart_version" "$remote_write_url" \
    "$helm_timeout_seconds" "$collector_node_selector"; then
    return 1
  fi

  if ! kubectl -n "$ns" rollout status "statefulset/${service_name}" --timeout="${rollout_timeout_seconds}s" >/dev/null 2>&1; then
    echo "Warning: VictoriaLogs StatefulSet ${ns}/${service_name} is not Ready yet." >&2
  fi
  if [[ -n "${KUBETON_NODE_CHECK_TON_SELECTOR:-}" ]]; then
    if ! wait_victoria_logs_collector_ready_on_selected_nodes "$ns" "$collector_release_name" \
      "$KUBETON_NODE_CHECK_TON_SELECTOR" "$rollout_timeout_seconds"; then
      return 1
    fi
  elif ! kubectl -n "$ns" rollout status "daemonset/${collector_daemonset}" --timeout="${rollout_timeout_seconds}s" >/dev/null 2>&1; then
    echo "Warning: VictoriaLogs collector DaemonSet ${ns}/${collector_daemonset} is not fully Ready on every cluster node." >&2
  fi

  ds_desired="$(kubectl -n "$ns" get daemonset "$collector_daemonset" -o jsonpath='{.status.desiredNumberScheduled}' 2>/dev/null || true)"
  ds_ready="$(kubectl -n "$ns" get daemonset "$collector_daemonset" -o jsonpath='{.status.numberReady}' 2>/dev/null || true)"
  ds_desired="$(trim_whitespace "$ds_desired")"
  ds_ready="$(trim_whitespace "$ds_ready")"
  if ! [[ "$ds_desired" =~ ^[0-9]+$ && "$ds_ready" =~ ^[0-9]+$ ]]; then
    echo "Error: cannot read VictoriaLogs collector readiness for ${ns}/${collector_daemonset}; log collection cannot be proven." >&2
    return 1
  fi
  if (( ds_desired == 0 )); then
    echo "Error: VictoriaLogs collector DaemonSet ${ns}/${collector_daemonset} targets no nodes; log collection is not active." >&2
    return 1
  fi
  if (( ds_ready != ds_desired )); then
    echo "Warning: VictoriaLogs collector DaemonSet aggregate readiness is ${ds_ready}/${ds_desired}; selected TON-node coverage was checked separately." >&2
  fi

  printf '%s\t%s\t%s\t%s\t%s\t%s\n' "$access_service_name" "$service_name" "$collector_daemonset" "$remote_write_url" "$ds_ready" "$ds_desired"
}

victoria_logs_collector_ready_on_selected_nodes() {
  local ns="$1"
  local collector_release_name="$2"
  local node_selector="$3"
  local collector_daemonset ds_row generation observed_generation daemonset_uid desired_scheduled current_scheduled misscheduled update_revision=""
  local revision_rows revision_row revision_kind revision_owner revision_owner_uid revision_controller revision_number revision_name
  local newest_revision=-1
  local selected_node_rows pod_rows pod_row pod_node pod_revision pod_phase terminating ready_condition owner owner_uid
  local ready_node_count=0
  local -a selected_nodes=()
  local -A ready_by_node=()
  local node

  node_selector="$(trim_whitespace "$node_selector")"
  collector_daemonset="$(victoria_logs_collector_daemonset_name "$collector_release_name")"
  if ! ds_row="$(kubectl -n "$ns" get daemonset "$collector_daemonset" \
    -o go-template='{{.metadata.generation}}{{"\x1f"}}{{.status.observedGeneration}}{{"\x1f"}}{{.metadata.uid}}{{"\x1f"}}{{.status.desiredNumberScheduled}}{{"\x1f"}}{{.status.currentNumberScheduled}}{{"\x1f"}}{{.status.numberMisscheduled}}' 2>/dev/null)"; then
    echo "Error: cannot read VictoriaLogs collector DaemonSet ${ns}/${collector_daemonset}." >&2
    return 1
  fi
  IFS=$'\x1f' read -r generation observed_generation daemonset_uid desired_scheduled current_scheduled misscheduled <<<"$ds_row"
  generation="$(trim_whitespace "$generation")"
  observed_generation="$(trim_whitespace "$observed_generation")"
  daemonset_uid="$(trim_whitespace "$daemonset_uid")"
  desired_scheduled="$(trim_whitespace "$desired_scheduled")"
  current_scheduled="$(trim_whitespace "$current_scheduled")"
  misscheduled="$(trim_whitespace "$misscheduled")"
  if ! [[ "$generation" =~ ^[1-9][0-9]*$ && "$observed_generation" == "$generation" ]] \
    || [[ -z "$daemonset_uid" ]]; then
    echo "Error: VictoriaLogs collector DaemonSet ${ns}/${collector_daemonset} has not observed its current generation." >&2
    return 1
  fi
  # DaemonSetStatus has no updateRevision field. Resolve the newest
  # ControllerRevision owned by this exact DaemonSet UID, then require the
  # corresponding controller-revision-hash on each Ready collector Pod.
  if ! revision_rows="$(kubectl -n "$ns" get controllerrevision \
    -o go-template='{{range .items}}{{$revision := .revision}}{{$revisionName := .metadata.name}}{{range .metadata.ownerReferences}}{{.kind}}{{"\x1f"}}{{.name}}{{"\x1f"}}{{.uid}}{{"\x1f"}}{{if .controller}}true{{else}}false{{end}}{{"\x1f"}}{{$revision}}{{"\x1f"}}{{$revisionName}}{{"\n"}}{{end}}{{end}}' 2>/dev/null)"; then
    echo "Error: cannot read VictoriaLogs collector revisions for ${ns}/${collector_daemonset}." >&2
    return 1
  fi
  while IFS= read -r revision_row; do
    IFS=$'\x1f' read -r revision_kind revision_owner revision_owner_uid revision_controller revision_number revision_name <<<"$revision_row"
    if [[ "$revision_kind" != "DaemonSet" \
      || "$revision_owner" != "$collector_daemonset" \
      || "$revision_owner_uid" != "$daemonset_uid" \
      || "$revision_controller" != "true" \
      || ! "$revision_number" =~ ^[0-9]+$ ]]; then
      continue
    fi
    if (( revision_number > newest_revision )); then
      newest_revision="$revision_number"
      update_revision="$revision_name"
    fi
  done <<<"$revision_rows"
  if [[ -z "$update_revision" || "$update_revision" != "${collector_daemonset}-"* ]]; then
    echo "Error: cannot resolve the current VictoriaLogs collector revision for ${ns}/${collector_daemonset}." >&2
    return 1
  fi
  update_revision="${update_revision#"${collector_daemonset}-"}"

  # With no TON selector, placement is unconstrained. Aggregate DaemonSet
  # status alone can still count a Ready Pod after deletionTimestamp is set,
  # so prove that the current revision has one non-terminating Ready Pod on
  # every desired DaemonSet node. Count unique node names to reject duplicate
  # Pods on one host masking a missing collector elsewhere.
  if [[ -z "$node_selector" ]]; then
    if ! [[ "$desired_scheduled" =~ ^[1-9][0-9]*$ \
      && "$current_scheduled" =~ ^[0-9]+$ \
      && "$misscheduled" =~ ^[0-9]+$ ]] \
      || (( current_scheduled != desired_scheduled || misscheduled != 0 )); then
      echo "Error: VictoriaLogs collector DaemonSet ${ns}/${collector_daemonset} target set is not current (current=${current_scheduled:-unknown}, desired=${desired_scheduled:-unknown}, misscheduled=${misscheduled:-unknown})." >&2
      return 1
    fi
    if ! pod_rows="$(kubectl -n "$ns" get pods \
      -l "app.kubernetes.io/name=victoria-logs-collector,app.kubernetes.io/instance=${collector_release_name}" \
      -o go-template='{{range .items}}{{.spec.nodeName}}{{"\x1f"}}{{with .metadata.labels}}{{index . "controller-revision-hash"}}{{end}}{{"\x1f"}}{{.status.phase}}{{"\x1f"}}{{if .metadata.deletionTimestamp}}terminating{{end}}{{"\x1f"}}{{range .status.conditions}}{{if and (eq .type "Ready") (eq .status "True")}}ready{{end}}{{end}}{{"\x1f"}}{{range .metadata.ownerReferences}}{{if .controller}}{{.kind}}{{"/"}}{{.name}}{{"\x1f"}}{{.uid}}{{end}}{{end}}{{"\n"}}{{end}}' 2>/dev/null)"; then
      echo "Error: cannot list VictoriaLogs collector Pods for ${ns}/${collector_daemonset}." >&2
      return 1
    fi
    ready_by_node=()
    while IFS= read -r pod_row; do
      IFS=$'\x1f' read -r pod_node pod_revision pod_phase terminating ready_condition owner owner_uid <<<"$pod_row"
      pod_node="$(trim_whitespace "$pod_node")"
      if [[ -n "$pod_node" \
        && "$pod_revision" == "$update_revision" \
        && "$pod_phase" == "Running" \
        && -z "$terminating" \
        && "$ready_condition" == "ready" \
        && "$owner" == "DaemonSet/${collector_daemonset}" \
        && "$owner_uid" == "$daemonset_uid" ]]; then
        ready_by_node["$pod_node"]=1
      fi
    done <<<"$pod_rows"
    for node in "${!ready_by_node[@]}"; do
      ready_node_count=$((ready_node_count + 1))
    done
    if (( ready_node_count != desired_scheduled )); then
      echo "Error: TON placement is unconstrained and only ${ready_node_count}/${desired_scheduled} DaemonSet target node(s) have a non-terminating Ready VictoriaLogs collector of the current revision." >&2
      return 1
    fi
    echo "[launch] VictoriaLogs collector is Ready on every DaemonSet target (${ready_node_count}/${desired_scheduled})." >&2
    return 0
  fi

  if ! selected_node_rows="$(kubectl get nodes -l "$node_selector" -o name 2>/dev/null)"; then
    echo "Error: cannot list nodes selected for TON while verifying VictoriaLogs coverage." >&2
    return 1
  fi
  mapfile -t selected_nodes < <(printf '%s\n' "$selected_node_rows" | sed 's#^node/##' | awk 'NF' | sort -u)
  if (( ${#selected_nodes[@]} == 0 )); then
    echo "Error: TON selector '${node_selector}' matches no nodes while verifying VictoriaLogs coverage." >&2
    return 1
  fi
  # Use a direct per-node field selector for the authoritative coverage check
  # instead of trusting aggregate DaemonSet counts. Require the current
  # controller revision so an old Ready pod cannot satisfy a just-upgraded
  # collector configuration.
  ready_by_node=()
  for node in "${selected_nodes[@]}"; do
    if pod_rows="$(kubectl -n "$ns" get pods \
      -l "app.kubernetes.io/name=victoria-logs-collector,app.kubernetes.io/instance=${collector_release_name}" \
      --field-selector "spec.nodeName=${node}" \
      -o go-template='{{range .items}}{{with .metadata.labels}}{{index . "controller-revision-hash"}}{{end}}{{"\x1f"}}{{.status.phase}}{{"\x1f"}}{{if .metadata.deletionTimestamp}}terminating{{end}}{{"\x1f"}}{{range .status.conditions}}{{if and (eq .type "Ready") (eq .status "True")}}ready{{end}}{{end}}{{"\x1f"}}{{range .metadata.ownerReferences}}{{if .controller}}{{.kind}}{{"/"}}{{.name}}{{"\x1f"}}{{.uid}}{{end}}{{end}}{{"\n"}}{{end}}' 2>/dev/null)"; then
      while IFS= read -r pod_row; do
        IFS=$'\x1f' read -r pod_revision pod_phase terminating ready_condition owner owner_uid <<<"$pod_row"
        if [[ "$pod_revision" == "$update_revision" \
          && "$pod_phase" == "Running" \
          && -z "$terminating" \
          && "$ready_condition" == "ready" \
          && "$owner" == "DaemonSet/${collector_daemonset}" \
          && "$owner_uid" == "$daemonset_uid" ]]; then
          ready_by_node["$node"]=1
          break
        fi
      done <<<"$pod_rows"
    fi
  done
  for node in "${selected_nodes[@]}"; do
    if [[ -z "${ready_by_node[$node]:-}" ]]; then
      echo "Error: selected TON node ${node} has no Ready VictoriaLogs collector; refusing to create TON pods with incomplete restart-log coverage." >&2
      return 1
    fi
  done
  echo "[launch] VictoriaLogs collector is Ready on every selected TON node (${#selected_nodes[@]} node(s))." >&2
}

wait_victoria_logs_collector_ready_on_selected_nodes() {
  local ns="$1"
  local collector_release_name="$2"
  local node_selector="$3"
  local timeout_seconds="$4"
  local deadline now last_error=""

  if ! [[ "$timeout_seconds" =~ ^[0-9]+$ ]] || (( timeout_seconds < 1 )); then
    timeout_seconds=300
  fi
  deadline=$(( $(date +%s) + timeout_seconds ))
  while :; do
    if last_error="$(victoria_logs_collector_ready_on_selected_nodes \
      "$ns" "$collector_release_name" "$node_selector" 2>&1)"; then
      [[ -z "$last_error" ]] || printf '%s\n' "$last_error" >&2
      return 0
    fi
    now="$(date +%s)"
    if (( now >= deadline )); then
      [[ -z "$last_error" ]] || printf '%s\n' "$last_error" >&2
      echo "Error: VictoriaLogs collector did not cover every selected TON node within ${timeout_seconds}s." >&2
      return 1
    fi
    sleep 2
  done
}

ensure_start_victoria_logs() {
  local logs_ns logs_release_name logs_collector_release_name
  local logs_retention_period logs_pvc_size logs_remote_port timeout_seconds helm_timeout_seconds
  local logs_stack_row access_service backend_service collector_daemonset remote_write_url ds_ready ds_desired
  local configured_logs_node_selector configured_collector_node_selector

  if ! is_true "$KUBETON_START_VICTORIA_LOGS_ENABLED" || ! is_true "$VICTORIA_LOGS_ENABLED"; then
    echo "Warning: automatic VictoriaLogs launch capture is disabled; the local bundle cannot guarantee preservation of every rapid container restart." >&2
    return 0
  fi
  require_bin helm
  logs_ns="$(victoria_logs_namespace)"
  logs_release_name="$(victoria_logs_release_name)"
  logs_collector_release_name="$(victoria_logs_collector_release_name)"
  logs_retention_period="$(trim_whitespace "${VICTORIA_LOGS_RETENTION_PERIOD:-30d}")"
  logs_pvc_size="$(trim_whitespace "${VICTORIA_LOGS_PVC_SIZE:-10Gi}")"
  logs_remote_port="$(trim_whitespace "${VICTORIA_LOGS_PORT:-9428}")"
  timeout_seconds="$(resolve_victoria_metrics_rollout_timeout_seconds)"
  helm_timeout_seconds="$(resolve_victoria_logs_helm_timeout_seconds)"
  [[ -n "$logs_retention_period" ]] || logs_retention_period=30d
  [[ -n "$logs_pvc_size" ]] || logs_pvc_size=10Gi
  [[ "$logs_remote_port" =~ ^[0-9]+$ ]] || logs_remote_port=9428

  configured_logs_node_selector="$(trim_whitespace "${VICTORIA_LOGS_NODE_SELECTOR:-}")"
  configured_collector_node_selector="$(trim_whitespace "${VICTORIA_LOGS_COLLECTOR_NODE_SELECTOR:-}")"
  access_service="$(victoria_logs_access_service_name "$logs_release_name")"
  collector_daemonset="$(victoria_logs_collector_daemonset_name "$logs_collector_release_name")"

  echo "[launch] Ensuring durable VictoriaLogs collection before TON pods are created ..." >&2
  # Persist intent before either Helm release is mutated. A partial custom
  # backend/collector install must remain discoverable by plain uninstall.
  if ! write_victoria_logs_state "$OP_NAMESPACE" "$logs_ns" "$logs_release_name" \
      "$logs_collector_release_name" "$access_service" "$collector_daemonset"; then
    echo "Error: durable launch logging intent could not be persisted; TON deployment was not applied." >&2
    return 1
  fi
  if ! logs_stack_row="$(VICTORIA_LOGS_NODE_SELECTOR="$configured_logs_node_selector" \
    VICTORIA_LOGS_COLLECTOR_NODE_SELECTOR="$configured_collector_node_selector" \
    ensure_victoria_logs_stack "$logs_ns" "$logs_release_name" "$logs_collector_release_name" \
      "$logs_remote_port" "$logs_retention_period" "$logs_pvc_size" "$timeout_seconds" "$helm_timeout_seconds")"; then
    echo "Error: durable launch logging is not Ready; TON deployment was not applied." >&2
    echo "Error: fix VictoriaLogs or set KUBETON_START_VICTORIA_LOGS_ENABLED=false to explicitly accept best-effort local capture." >&2
    return 1
  fi
  IFS=$'\t' read -r access_service backend_service collector_daemonset remote_write_url ds_ready ds_desired <<<"$logs_stack_row"
  if ! write_victoria_logs_state "$OP_NAMESPACE" "$logs_ns" "$logs_release_name" "$logs_collector_release_name" "$access_service" "$collector_daemonset"; then
    echo "Error: durable launch logging is running, but its cleanup/access state could not be persisted; TON deployment was not applied." >&2
    return 1
  fi
  echo "[launch] Durable container-log collection is active (${logs_ns}/${collector_daemonset}, ${ds_ready}/${ds_desired} Ready)." >&2
}

verify_start_victoria_logs_collection_ready() {
  local logs_ns collector_release_name collector_daemonset ds_row
  local generation observed_generation desired updated ready available

  if ! is_true "$KUBETON_START_VICTORIA_LOGS_ENABLED" || ! is_true "$VICTORIA_LOGS_ENABLED"; then
    return 0
  fi
  logs_ns="$(victoria_logs_namespace)"
  collector_release_name="$(victoria_logs_collector_release_name)"
  if [[ -n "${KUBETON_NODE_CHECK_TON_SELECTOR:-}" ]]; then
    victoria_logs_collector_ready_on_selected_nodes \
      "$logs_ns" "$collector_release_name" "$KUBETON_NODE_CHECK_TON_SELECTOR"
    return $?
  fi

  if [[ -n "$(trim_whitespace "${VICTORIA_LOGS_COLLECTOR_NODE_SELECTOR:-}")" ]]; then
    echo "Error: TON placement is unconstrained but VICTORIA_LOGS_COLLECTOR_NODE_SELECTOR restricts log collection; kubeton cannot prove that every possible TON node is covered." >&2
    echo "Error: remove the collector selector for cluster-wide coverage, provide a verified TON selector, or explicitly disable automatic VictoriaLogs launch capture." >&2
    return 1
  fi

  # An explicitly skipped preflight or an existing fleet whose placement is
  # intentionally preserved can leave TON placement unconstrained. In that
  # case there is no smaller safe coverage set, so require every DaemonSet
  # target to run the observed/current rollout and be Ready immediately before
  # creating TON Pods.
  collector_daemonset="$(victoria_logs_collector_daemonset_name "$collector_release_name")"
  ds_row="$(kubectl -n "$logs_ns" get daemonset "$collector_daemonset" \
    -o go-template='{{.metadata.generation}}{{"\x1f"}}{{.status.observedGeneration}}{{"\x1f"}}{{.status.desiredNumberScheduled}}{{"\x1f"}}{{.status.updatedNumberScheduled}}{{"\x1f"}}{{.status.numberReady}}{{"\x1f"}}{{.status.numberAvailable}}' 2>/dev/null || true)"
  IFS=$'\x1f' read -r generation observed_generation desired updated ready available <<<"$ds_row"
  generation="$(trim_whitespace "$generation")"
  observed_generation="$(trim_whitespace "$observed_generation")"
  desired="$(trim_whitespace "$desired")"
  updated="$(trim_whitespace "$updated")"
  ready="$(trim_whitespace "$ready")"
  available="$(trim_whitespace "$available")"
  if ! [[ "$generation" =~ ^[1-9][0-9]*$ \
    && "$observed_generation" == "$generation" \
    && "$desired" =~ ^[1-9][0-9]*$ \
    && "$updated" =~ ^[0-9]+$ \
    && "$ready" =~ ^[0-9]+$ \
    && "$available" =~ ^[0-9]+$ ]] \
    || (( updated != desired || ready != desired || available != desired )); then
    echo "Error: TON placement is unconstrained and VictoriaLogs collector rollout is observed=${observed_generation:-unknown}/${generation:-unknown}, updated=${updated:-unknown}, ready=${ready:-unknown}, available=${available:-unknown}, desired=${desired:-unknown}; refusing to create TON pods with incomplete restart-log coverage." >&2
    return 1
  fi
  # DaemonSet status may transiently count a terminating Ready Pod. Resolve
  # the current ControllerRevision and exact owning Pods as a final guard.
  victoria_logs_collector_ready_on_selected_nodes "$logs_ns" "$collector_release_name" ""
}

victoria_logs_port_forward_address() {
  local configured
  configured="$(trim_whitespace "${VICTORIA_LOGS_PORT_FORWARD_ADDRESS:-}")"
  if [[ -n "$configured" ]]; then
    printf '%s' "$configured"
    return 0
  fi

  if cluster_is_baremetal && ! cluster_is_k3d; then
    printf '%s' "0.0.0.0"
    return 0
  fi

  printf '%s' "127.0.0.1"
}

wait_victoria_logs_http_ready() {
  local local_port="$1"
  local verify_seconds="$2"
  local deadline now status_code

  if ! [[ "$verify_seconds" =~ ^[0-9]+$ ]]; then
    verify_seconds=20
  fi
  if (( verify_seconds <= 0 )); then
    return 0
  fi
  if ! command -v curl >/dev/null 2>&1; then
    return 0
  fi

  deadline=$(( $(date +%s) + verify_seconds ))
  while :; do
    status_code="$(curl -sS -o /dev/null --max-time 3 -w '%{http_code}' "http://127.0.0.1:${local_port}/health" || true)"
    if [[ "$status_code" == "200" || "$status_code" == "401" || "$status_code" == "403" || "$status_code" == "404" ]]; then
      return 0
    fi
    status_code="$(curl -sS -o /dev/null --max-time 3 -w '%{http_code}' "http://127.0.0.1:${local_port}/select/vmui/" || true)"
    if [[ "$status_code" == "200" || "$status_code" == "401" || "$status_code" == "403" || "$status_code" == "404" ]]; then
      return 0
    fi

    now="$(date +%s)"
    if (( now >= deadline )); then
      return 1
    fi
    sleep 1
  done
}

ensure_victoria_logs_port_forward() {
  local ns="$1"
  local service_name="$2"
  local local_port="$3"
  local remote_port="$4"
  local bind_address="${5:-127.0.0.1}"
  local quiet="${6:-false}"
  local state_dir="${VICTORIA_LOGS_PORT_FORWARD_DIR}"
  local wait_seconds="${VICTORIA_LOGS_PORT_FORWARD_WAIT_SECONDS}"
  local verify_seconds="${VICTORIA_LOGS_PORT_FORWARD_VERIFY_SECONDS}"
  local key pid_file log_file existing_pid pf_pid deadline now

  if ! [[ "$local_port" =~ ^[0-9]+$ ]] || ! [[ "$remote_port" =~ ^[0-9]+$ ]]; then
    return 1
  fi
  if ! [[ "$wait_seconds" =~ ^[0-9]+$ ]]; then
    wait_seconds=5
  fi
  if ! [[ "$verify_seconds" =~ ^[0-9]+$ ]]; then
    verify_seconds=20
  fi

  mkdir -p "$state_dir"
  key="$(sanitize_file_name_fragment "${ns}__${service_name}__${local_port}")"
  pid_file="${state_dir}/${key}.pid"
  log_file="${state_dir}/${key}.log"

  if [[ -f "$pid_file" ]]; then
    existing_pid="$(cat "$pid_file" 2>/dev/null || true)"
    if [[ "$existing_pid" =~ ^[0-9]+$ ]] && kill -0 "$existing_pid" >/dev/null 2>&1; then
      if port_forward_process_matches "$existing_pid" "$ns" "$service_name" "$local_port" "$remote_port" "$bind_address"; then
        if wait_victoria_logs_http_ready "$local_port" 2; then
          printf '%s\t%s\t%s\t%s\t%s\n' "$ns" "$service_name" "$local_port" "$existing_pid" "$log_file"
          return 0
        fi
      fi
      kill "$existing_pid" >/dev/null 2>&1 || true
    fi
    rm -f "$pid_file" >/dev/null 2>&1 || true
  fi

  nohup kubectl -n "$ns" port-forward --address "$bind_address" "svc/${service_name}" "${local_port}:${remote_port}" >"$log_file" 2>&1 &
  pf_pid="$!"
  echo "$pf_pid" >"$pid_file"

  deadline=$(( $(date +%s) + wait_seconds ))
  while :; do
    if ! kill -0 "$pf_pid" >/dev/null 2>&1; then
      rm -f "$pid_file" >/dev/null 2>&1 || true
      if [[ "$quiet" != "1" && "$quiet" != "true" ]]; then
        echo "Warning: failed to start background port-forward for ${ns}/${service_name} on localhost:${local_port}." >&2
        echo "Warning: see ${log_file}" >&2
      fi
      return 1
    fi
    if grep -q "Forwarding from" "$log_file" 2>/dev/null; then
      if ! wait_victoria_logs_http_ready "$local_port" "$verify_seconds"; then
        kill "$pf_pid" >/dev/null 2>&1 || true
        rm -f "$pid_file" >/dev/null 2>&1 || true
        if [[ "$quiet" != "1" && "$quiet" != "true" ]]; then
          echo "Warning: port-forward for ${ns}/${service_name} started on localhost:${local_port}, but VictoriaLogs endpoint is not ready." >&2
          echo "Warning: see ${log_file}" >&2
        fi
        return 1
      fi
      if ! kill -0 "$pf_pid" >/dev/null 2>&1 || ! wait_victoria_logs_http_ready "$local_port" 2; then
        kill "$pf_pid" >/dev/null 2>&1 || true
        rm -f "$pid_file" >/dev/null 2>&1 || true
        if [[ "$quiet" != "1" && "$quiet" != "true" ]]; then
          echo "Warning: port-forward for ${ns}/${service_name} became unavailable immediately after startup on localhost:${local_port}." >&2
          echo "Warning: see ${log_file}" >&2
        fi
        return 1
      fi
      printf '%s\t%s\t%s\t%s\t%s\n' "$ns" "$service_name" "$local_port" "$pf_pid" "$log_file"
      return 0
    fi
    now="$(date +%s)"
    if (( now >= deadline )); then
      kill "$pf_pid" >/dev/null 2>&1 || true
      rm -f "$pid_file" >/dev/null 2>&1 || true
      if [[ "$quiet" != "1" && "$quiet" != "true" ]]; then
        echo "Warning: timed out waiting for port-forward readiness for ${ns}/${service_name} on localhost:${local_port}." >&2
        echo "Warning: see ${log_file}" >&2
      fi
      return 1
    fi
    sleep 1
  done
}

start_victoria_logs_port_forward() {
  local ns="$1"
  local service_name="$2"
  local base_port="$3"
  local remote_port="$4"
  local bind_address="$5"
  local forward_row attempt quiet_attempt

  if ! [[ "$base_port" =~ ^[0-9]+$ ]]; then
    base_port=9428
  fi

  for ((attempt=0; attempt<25; attempt++)); do
    quiet_attempt="true"
    if (( attempt == 24 )); then
      quiet_attempt="false"
    fi
    if forward_row="$(ensure_victoria_logs_port_forward "$ns" "$service_name" "$((base_port + attempt))" "$remote_port" "$bind_address" "$quiet_attempt")"; then
      printf '%s' "$forward_row"
      return 0
    fi
  done
  return 1
}

ensure_victoria_logs_api_proxy() {
  local local_port="$1"
  local state_dir="${VICTORIA_LOGS_PORT_FORWARD_DIR}"
  local wait_seconds="${VICTORIA_LOGS_PORT_FORWARD_WAIT_SECONDS}"
  local verify_seconds="${VICTORIA_LOGS_PORT_FORWARD_VERIFY_SECONDS}"
  local pid_file log_file proxy_pid deadline now

  if ! [[ "$local_port" =~ ^[0-9]+$ ]]; then
    return 1
  fi
  if ! [[ "$wait_seconds" =~ ^[0-9]+$ ]]; then
    wait_seconds=5
  fi
  if ! [[ "$verify_seconds" =~ ^[0-9]+$ ]]; then
    verify_seconds=20
  fi

  mkdir -p "$state_dir"
  pid_file="${state_dir}/proxy-${local_port}.pid"
  log_file="${state_dir}/proxy-${local_port}.log"

  if [[ -f "$pid_file" ]]; then
    proxy_pid="$(cat "$pid_file" 2>/dev/null || true)"
    if [[ "$proxy_pid" =~ ^[0-9]+$ ]] && kill -0 "$proxy_pid" >/dev/null 2>&1; then
      if wait_kubectl_proxy_ready "$local_port" 2; then
        printf '%s\t%s\t%s\n' "$local_port" "$proxy_pid" "$log_file"
        return 0
      fi
      kill "$proxy_pid" >/dev/null 2>&1 || true
    fi
    rm -f "$pid_file" >/dev/null 2>&1 || true
  fi

  if command -v setsid >/dev/null 2>&1; then
    setsid kubectl proxy --disable-filter --address 127.0.0.1 --port "$local_port" >"$log_file" 2>&1 < /dev/null &
  else
    nohup kubectl proxy --disable-filter --address 127.0.0.1 --port "$local_port" >"$log_file" 2>&1 &
  fi
  proxy_pid="$!"
  echo "$proxy_pid" >"$pid_file"

  deadline=$(( $(date +%s) + wait_seconds ))
  while :; do
    if ! kill -0 "$proxy_pid" >/dev/null 2>&1; then
      rm -f "$pid_file" >/dev/null 2>&1 || true
      return 1
    fi
    if wait_kubectl_proxy_ready "$local_port" 1; then
      if ! wait_kubectl_proxy_ready "$local_port" "$verify_seconds"; then
        kill "$proxy_pid" >/dev/null 2>&1 || true
        rm -f "$pid_file" >/dev/null 2>&1 || true
        return 1
      fi
      printf '%s\t%s\t%s\n' "$local_port" "$proxy_pid" "$log_file"
      return 0
    fi
    now="$(date +%s)"
    if (( now >= deadline )); then
      kill "$proxy_pid" >/dev/null 2>&1 || true
      rm -f "$pid_file" >/dev/null 2>&1 || true
      return 1
    fi
    sleep 1
  done
}

ensure_victoria_logs_nodeport_access() {
  local ns="$1"
  local release_name="$2"
  local remote_port="$3"
  local service_name="kubeton-vlogs-nodeport-${release_name}"
  local node_port
  local -a node_ip_rows=()
  local row node_name node_ip ip_source
  local printed=0
  local -A seen_ip=()

  if ! [[ "$remote_port" =~ ^[0-9]+$ ]]; then
    remote_port=9428
  fi

  cat <<EOF | kubectl -n "$ns" apply -f - >/dev/null
apiVersion: v1
kind: Service
metadata:
  name: ${service_name}
  labels:
    app.kubernetes.io/name: kubeton-victoria-logs-access
    app.kubernetes.io/managed-by: kubeton
    app.kubernetes.io/part-of: kubeton-victoria-logs
spec:
  type: NodePort
  selector:
    app: server
    app.kubernetes.io/instance: ${release_name}
    app.kubernetes.io/name: victoria-logs-single
  ports:
    - name: http
      protocol: TCP
      port: ${remote_port}
      targetPort: http
EOF

  node_port="$(kubectl -n "$ns" get service "$service_name" -o jsonpath='{.spec.ports[0].nodePort}' 2>/dev/null || true)"
  node_port="$(trim_whitespace "$node_port")"
  if ! [[ "$node_port" =~ ^[0-9]+$ ]]; then
    echo "Warning: failed to resolve NodePort for VictoriaLogs access service ${ns}/${service_name}." >&2
    return 1
  fi
  echo "[victoria-metrics] VictoriaLogs NodePort service: ${ns}/${service_name} (${node_port})"

  mapfile -t node_ip_rows < <(list_node_external_ip_rows)
  for row in "${node_ip_rows[@]}"; do
    [[ -z "$row" ]] && continue
    IFS=$'\t' read -r node_name node_ip ip_source <<<"$row"
    node_name="$(trim_whitespace "$node_name")"
    node_ip="$(trim_whitespace "$node_ip")"
    ip_source="$(trim_whitespace "$ip_source")"
    [[ -z "$node_ip" ]] && continue
    if [[ -n "${seen_ip[$node_ip]:-}" ]]; then
      continue
    fi
    seen_ip["$node_ip"]=1
    ((printed+=1))
    echo "[victoria-metrics] VictoriaLogs NodePort VMUI (${ip_source} ${node_name}): http://${node_ip}:${node_port}/select/vmui/"
    echo "[victoria-metrics] VictoriaLogs NodePort query API (${ip_source} ${node_name}): http://${node_ip}:${node_port}/select/logsql/query"
  done

  if (( printed == 0 )); then
    echo "[victoria-metrics] VictoriaLogs NodePort VMUI: <node-ip>:${node_port}/select/vmui/"
    echo "[victoria-metrics] VictoriaLogs NodePort query API: <node-ip>:${node_port}/select/logsql/query"
  fi
}

build_longhorn_selector_values_file() {
  local selector="$1"
  local -a selector_pairs=()
  local values_file system_managed_selector

  parse_selector_pairs "$selector" selector_pairs || return 1
  if [[ ${#selector_pairs[@]} -eq 0 ]]; then
    echo "Error: LONGHORN_NODE_SELECTOR is set but has no valid key=value pairs." >&2
    return 1
  fi
  system_managed_selector="$(selector_pairs_to_longhorn_setting selector_pairs)"

  values_file="$(mktemp -t kubeton-longhorn-selector.XXXXXX.yaml)"
  {
    echo "global:"
    echo "  nodeSelector:"
    write_yaml_map_from_pairs selector_pairs 4
    echo "longhornManager:"
    echo "  nodeSelector:"
    write_yaml_map_from_pairs selector_pairs 4
    echo "longhornDriver:"
    echo "  nodeSelector:"
    write_yaml_map_from_pairs selector_pairs 4
    echo "longhornUI:"
    echo "  nodeSelector:"
    write_yaml_map_from_pairs selector_pairs 4
    # longhorn-csi-plugin is created dynamically by Longhorn rather than by a
    # Helm template. This setting must be present in the initial ConfigMap so
    # the manager creates CSI only on the selected nodes; applying it after
    # Longhorn is ready is too late to prevent a DiskPressure eviction.
    echo "defaultSettings:"
    echo "  systemManagedComponentsNodeSelector: $(yaml_quote "$system_managed_selector")"
  } >"$values_file"

  printf '%s' "$values_file"
}

