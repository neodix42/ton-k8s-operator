activate_tonnode_wallet_in_pod() {
  local ns="$1"
  local pod="$2"
  local wallet_name="$3"
  local output
  local exec_rc=0

  output="$(run_with_timeout "$MYTONCTRL_EXEC_TIMEOUT" kubectl -n "$ns" exec "$pod" -c ton-node -- bash -lc '
    wallet_name="$1"
    mtc_cmd="aw ${wallet_name}"
    shopt -s expand_aliases
    if [[ -f ~/.bashrc ]]; then
      source ~/.bashrc >/dev/null 2>&1 || true
    fi
    if ! command -v mytonctrl >/dev/null 2>&1; then
      echo "Error: mytonctrl command not found." >&2
      exit 127
    fi
    set +e
    mytonctrl --cmd "$mtc_cmd"
    mtc_rc=$?
    if (( mtc_rc == 2 )); then
      printf "%s\n" "$mtc_cmd" | mytonctrl
    else
      exit "$mtc_rc"
    fi
  ' _ "$wallet_name" 2>&1)" || exec_rc=$?
  output="$(strip_ansi_sequences "$output")"
  if (( exec_rc != 0 )); then
    echo "Error: mytonctrl aw failed in ${ns}/${pod} with exit code ${exec_rc}." >&2
    if (( exec_rc == 124 )); then
      echo "Error: command timed out after MYTONCTRL_EXEC_TIMEOUT=${MYTONCTRL_EXEC_TIMEOUT}." >&2
    fi
    echo "mytonctrl output from ${ns}/${pod}:" >&2
    print_prefixed_lines "  ${pod}> " "$output" >&2
    return "$exec_rc"
  fi
  if [[ -n "$output" ]]; then
    echo "mytonctrl output from ${ns}/${pod}:"
    print_prefixed_lines "  ${pod}> " "$output"
  fi
}

run_wallet_activate() {
  local target_pod_name="${1:-}"
  local target_wallet_name="${2:-validator_wallet_001}"
  local row target_ns target_pod target_node_name wallet_row
  local wallet_name status balance version workchain address
  local rc=0
  local activated_count=0
  local pending_count=0
  local skipped_count=0
  local action
  local -a pod_rows=()
  local -a table_rows=()

  target_wallet_name="$(trim_whitespace "$target_wallet_name")"
  [[ -z "$target_wallet_name" ]] && target_wallet_name="validator_wallet_001"
  if ! [[ "$target_wallet_name" =~ ^[A-Za-z0-9._-]+$ ]]; then
    echo "Error: invalid wallet name '${target_wallet_name}'." >&2
    return 1
  fi

  if [[ -n "$target_pod_name" ]]; then
    row="$(resolve_tonnode_pod_row_by_name "$target_pod_name" || true)"
    row="$(trim_whitespace "$row")"
    if [[ -z "$row" ]]; then
      echo "Error: TON pod '${target_pod_name}' not found." >&2
      return 1
    fi
    pod_rows+=("$row")
  else
    mapfile -t pod_rows < <(list_ton_pods 2>/dev/null || true)
  fi

  for row in "${pod_rows[@]}"; do
    [[ -z "$row" ]] && continue
    IFS=$'\t' read -r target_ns target_pod target_node_name <<<"$row"
    [[ -z "$target_ns" || -z "$target_pod" ]] && continue
    wallet_row="$(resolve_tonnode_wallet_row_from_pod "$target_ns" "$target_pod" "$target_wallet_name" || true)"
    wallet_row="$(trim_whitespace "$wallet_row")"
    if [[ -z "$wallet_row" ]]; then
      if [[ -n "$target_pod_name" ]]; then
        echo "Error: wallet '${target_wallet_name}' was not found in ${target_ns}/${target_pod}." >&2
        return 1
      fi
      echo "Warning: cannot resolve wallet '${target_wallet_name}' in ${target_ns}/${target_pod}; skipping." >&2
      continue
    fi
    IFS=$'\t' read -r wallet_name status balance version workchain address <<<"$wallet_row"
    if [[ "${status,,}" == "active" ]]; then
      action="already active"
    else
      action="aw ${wallet_name}"
      ((pending_count+=1))
    fi
    table_rows+=("${target_ns}"$'\t'"${target_pod}"$'\t'"${wallet_name}"$'\t'"${address}"$'\t'"${action}")
  done

  if [[ ${#table_rows[@]} -eq 0 ]]; then
    echo "Error: no TON wallets resolved for wallet name '${target_wallet_name}'." >&2
    return 1
  fi

  print_aligned_table_5col "namespace" "tonnode pod" "wallet-name" "wallet-address" "mytonctrl-command" "${table_rows[@]}"
  if (( pending_count == 0 )); then
    echo "[wallet] All ${#table_rows[@]} resolved wallet(s) are already active."
    return 0
  fi
  confirm_or_exit "Activate '${target_wallet_name}' with mytonctrl aw on ${pending_count} TON pod(s)?"

  for row in "${table_rows[@]}"; do
    IFS=$'\t' read -r target_ns target_pod wallet_name address action <<<"$row"
    if [[ "$action" == "already active" ]]; then
      ((skipped_count+=1))
      continue
    fi
    echo "[wallet] Activating ${wallet_name} in ${target_ns}/${target_pod} using: aw ${wallet_name}" >&2
    if activate_tonnode_wallet_in_pod "$target_ns" "$target_pod" "$wallet_name"; then
      ((activated_count+=1))
    else
      rc=1
    fi
  done

  if (( rc != 0 )); then
    echo "Error: activated ${activated_count}/${pending_count} wallet(s), skipped ${skipped_count} already active wallet(s); at least one mytonctrl aw command failed." >&2
    return 1
  fi
  echo "[wallet] Activated ${activated_count}/${pending_count} wallet(s) with mytonctrl aw; skipped ${skipped_count} already active wallet(s)."
}

resolve_main_wallet_receive_address() {
  local wallet_network="$1"
  local wallet_name="$2"
  local output address

  wallet_name="$(trim_whitespace "$wallet_name")"
  [[ -n "$wallet_name" ]] || return 1

  output="$(run_wallet show "$wallet_name" 2>&1)" || {
    local rc=$?
    printf '%s\n' "$output" >&2
    return "$rc"
  }
  output="$(strip_ansi_sequences "$output")"
  address="$(printf '%s\n' "$output" | awk -v wallet_name="$wallet_name" '
    $3 == wallet_name {
      if ($5 != "" && $5 != "unknown") {
        print $5
      } else if ($4 != "" && $4 != "unknown") {
        print $4
      }
      exit
    }
  ')"
  address="$(trim_whitespace "$address")"
  if [[ -z "$address" ]]; then
    echo "Error: cannot resolve receive address for main wallet '${wallet_name}'." >&2
    return 1
  fi
  if ! ton_address_valid_for_network "$address" "$wallet_network"; then
    echo "Error: resolved main-wallet address '${address}' is not valid for ${wallet_network}." >&2
    return 1
  fi

  printf '%s' "$address"
}

collect_tonnode_wallet_in_pod() {
  local ns="$1"
  local pod="$2"
  local wallet_name="$3"
  local destination_address="$4"
  local amount="$5"
  local output
  local exec_rc=0

  output="$(run_with_timeout "$MYTONCTRL_EXEC_TIMEOUT" kubectl -n "$ns" exec "$pod" -c ton-node -- bash -lc '
    wallet_name="$1"
    destination_address="$2"
    amount="$3"
    mtc_cmd="mg ${wallet_name} ${destination_address} ${amount}"
    link_dir_contents() {
      local source_dir="$1"
      local target_dir="$2"
      local f base target
      [[ -d "$source_dir" ]] || return 0
      mkdir -p "$target_dir" 2>/dev/null || return 1
      for f in "$source_dir"/*; do
        [[ -e "$f" ]] || continue
        base="${f##*/}"
        target="${target_dir}/${base}"
        [[ "$f" == "$target" ]] && continue
        if [[ ! -e "$target" ]]; then
          rm -f "$target" 2>/dev/null || true
          ln -s "$f" "$target" 2>/dev/null || cp -a "$f" "$target" 2>/dev/null || true
        fi
      done
    }
    prepare_mytonctrl_fift_env() {
      local expected_fift_dir="/usr/src/ton/crypto/fift/lib"
      local expected_smart_dir="/usr/src/ton/crypto/smartcont"
      local fift_file="" wallet_fif="" fift_dir="" smart_dir="" f

      for f in \
        "${expected_fift_dir}/Fift.fif" \
        /usr/lib/fift/Fift.fif \
        /usr/share/ton/fift/Fift.fif \
        /usr/share/ton/crypto/fift/lib/Fift.fif \
        /usr/local/lib/fift/Fift.fif \
        /usr/local/share/ton/fift/Fift.fif \
        /opt/ton/crypto/fift/lib/Fift.fif \
        /var/ton-work/ton/crypto/fift/lib/Fift.fif; do
        if [[ -f "$f" ]]; then
          fift_file="$f"
          break
        fi
      done
      if [[ -z "$fift_file" ]]; then
        fift_file="$(find /usr /opt /var/ton-work/ton -type f -name Fift.fif -print -quit 2>/dev/null || true)"
      fi

      for f in \
        "${expected_smart_dir}/wallet.fif" \
        /usr/share/ton/smartcont/wallet.fif \
        /usr/share/ton/crypto/smartcont/wallet.fif \
        /usr/local/share/ton/smartcont/wallet.fif \
        /opt/ton/crypto/smartcont/wallet.fif \
        /var/ton-work/ton/crypto/smartcont/wallet.fif; do
        if [[ -f "$f" ]]; then
          wallet_fif="$f"
          break
        fi
      done
      if [[ -z "$wallet_fif" ]]; then
        wallet_fif="$(find /usr /opt /var/ton-work/ton -type f -name wallet.fif -print -quit 2>/dev/null || true)"
      fi

      if [[ -z "$fift_file" ]]; then
        echo "Error: Fift.fif was not found in the ton-node container; mytonctrl mg can not build a transfer BOC." >&2
        return 90
      fi
      if [[ -z "$wallet_fif" ]]; then
        echo "Error: wallet.fif was not found in the ton-node container; mytonctrl mg can not build a transfer BOC." >&2
        return 90
      fi

      fift_dir="${fift_file%/*}"
      smart_dir="${wallet_fif%/*}"
      link_dir_contents "$fift_dir" "$expected_fift_dir" || return 90
      link_dir_contents "$smart_dir" "$expected_smart_dir" || return 90

      if [[ ! -f "${expected_fift_dir}/Fift.fif" ]]; then
        echo "Error: found Fift.fif at ${fift_file}, but could not expose it at ${expected_fift_dir}/Fift.fif." >&2
        return 90
      fi
      if [[ ! -f "${expected_smart_dir}/wallet.fif" ]]; then
        echo "Error: found wallet.fif at ${wallet_fif}, but could not expose it at ${expected_smart_dir}/wallet.fif." >&2
        return 90
      fi

      export FIFTPATH="${expected_fift_dir}:${expected_smart_dir}:${fift_dir}:${smart_dir}:${FIFTPATH:-}"
      return 0
    }
    shopt -s expand_aliases
    if [[ -f ~/.bashrc ]]; then
      source ~/.bashrc >/dev/null 2>&1 || true
    fi
    if ! command -v mytonctrl >/dev/null 2>&1; then
      echo "Error: mytonctrl command not found." >&2
      exit 127
    fi
    if ! prepare_mytonctrl_fift_env; then
      exit 90
    fi
    set +e
    mytonctrl --cmd "$mtc_cmd"
    mtc_rc=$?
    if (( mtc_rc == 2 )); then
      printf "%s\n" "$mtc_cmd" | mytonctrl
    else
      exit "$mtc_rc"
    fi
  ' _ "$wallet_name" "$destination_address" "$amount" 2>&1)" || exec_rc=$?
  output="$(strip_ansi_sequences "$output")"
  if (( exec_rc != 0 )); then
    echo "Error: mytonctrl mg failed in ${ns}/${pod} with exit code ${exec_rc}." >&2
    if (( exec_rc == 124 )); then
      echo "Error: command timed out after MYTONCTRL_EXEC_TIMEOUT=${MYTONCTRL_EXEC_TIMEOUT}." >&2
    fi
    echo "mytonctrl output from ${ns}/${pod}:" >&2
    print_prefixed_lines "  ${pod}> " "$output" >&2
    if (( exec_rc == 90 )) || printf '%s\n' "$output" | grep -Eq 'Fift\.fif|wallet\.fif'; then
      echo "Hint: the ton-node image mytonctrl uses is missing or misconfiguring Fift include files; fix the image or ensure Fift.fif and wallet.fif are available in the container." >&2
      return 90
    fi
    return "$exec_rc"
  fi
  if [[ -n "$output" ]]; then
    echo "mytonctrl output from ${ns}/${pod}:"
    print_prefixed_lines "  ${pod}> " "$output"
  fi
}

run_wallet_collect() {
  local wallet_network="$1"
  local main_wallet_name="$2"
  shift 2 || true
  local target_pod_name=""
  local source_wallet_name="validator_wallet_001"
  local amount="alld"
  local candidate=""
  local main_wallet_address=""
  local row target_ns target_pod target_node_name wallet_row
  local wallet_name status balance version workchain source_address status_lc
  local rc=0 collected_count=0 collect_rc=0
  local -a pod_rows=()
  local -a table_rows=()

  [[ -n "$wallet_network" && -n "$main_wallet_name" ]] || return 1

  case "$#" in
    0)
      ;;
    1)
      candidate="$(trim_whitespace "$1")"
      if [[ "$candidate" =~ ^[0-9]+([.][0-9]+)?[.]?$ || "$candidate" == "alld" ]]; then
        amount="$candidate"
      else
        target_pod_name="$candidate"
      fi
      ;;
    2)
      if resolve_tonnode_pod_row_by_name "$1" >/dev/null 2>&1; then
        target_pod_name="$(trim_whitespace "$1")"
        candidate="$(trim_whitespace "$2")"
        if [[ "$candidate" =~ ^[0-9]+([.][0-9]+)?[.]?$ || "$candidate" == "alld" ]]; then
          amount="$candidate"
        else
          source_wallet_name="$candidate"
        fi
      else
        source_wallet_name="$(trim_whitespace "$1")"
        amount="$(trim_whitespace "$2")"
      fi
      ;;
    3)
      target_pod_name="$(trim_whitespace "$1")"
      source_wallet_name="$(trim_whitespace "$2")"
      amount="$(trim_whitespace "$3")"
      ;;
    *)
      echo "Error: usage: kubeton wallet collect <mainnet|testnet> <main-wallet-name> [from-tonnode-name] [wallet-name] [amount]" >&2
      return 1
      ;;
  esac

  main_wallet_name="$(trim_whitespace "$main_wallet_name")"
  source_wallet_name="$(trim_whitespace "$source_wallet_name")"
  amount="$(trim_whitespace "$amount")"
  [[ -z "$amount" ]] && amount="alld"
  if ! [[ "$main_wallet_name" =~ ^[A-Za-z0-9._-]+$ ]]; then
    echo "Error: invalid main wallet name '${main_wallet_name}'." >&2
    return 1
  fi
  if ! [[ "$source_wallet_name" =~ ^[A-Za-z0-9._-]+$ ]]; then
    echo "Error: invalid source wallet name '${source_wallet_name}'." >&2
    return 1
  fi
  if [[ "$amount" != "alld" ]] && ! [[ "$amount" =~ ^[0-9]+([.][0-9]+)?[.]?$ ]]; then
    echo "Error: collect amount must be numeric TON amount or omitted for alld." >&2
    return 1
  fi

  main_wallet_address="$(resolve_main_wallet_receive_address "$wallet_network" "$main_wallet_name")" || return 1

  if [[ -n "$target_pod_name" ]]; then
    row="$(resolve_tonnode_pod_row_by_name "$target_pod_name" || true)"
    row="$(trim_whitespace "$row")"
    if [[ -z "$row" ]]; then
      echo "Error: TON pod '${target_pod_name}' not found." >&2
      return 1
    fi
    pod_rows+=("$row")
  else
    mapfile -t pod_rows < <(list_ton_pods 2>/dev/null || true)
  fi

  for row in "${pod_rows[@]}"; do
    [[ -z "$row" ]] && continue
    IFS=$'\t' read -r target_ns target_pod target_node_name <<<"$row"
    [[ -z "$target_ns" || -z "$target_pod" ]] && continue
    wallet_row="$(resolve_tonnode_wallet_row_from_pod "$target_ns" "$target_pod" "$source_wallet_name" || true)"
    wallet_row="$(trim_whitespace "$wallet_row")"
    if [[ -z "$wallet_row" ]]; then
      if [[ -n "$target_pod_name" ]]; then
        echo "Error: wallet '${source_wallet_name}' was not found in ${target_ns}/${target_pod}." >&2
        return 1
      fi
      echo "Warning: cannot resolve wallet '${source_wallet_name}' in ${target_ns}/${target_pod}; skipping." >&2
      continue
    fi
    IFS=$'\t' read -r wallet_name status balance version workchain source_address <<<"$wallet_row"
    status="$(trim_whitespace "$status")"
    status_lc="${status,,}"
    source_address="$(trim_whitespace "$source_address")"
    if [[ "$status_lc" != "active" ]]; then
      if [[ -n "$target_pod_name" ]]; then
        echo "Error: wallet '${source_wallet_name}' in ${target_ns}/${target_pod} is '${status:-unknown}', not active." >&2
        echo "Hint: after funding it, run: ./kubeton wallet activate ${target_pod} ${source_wallet_name}" >&2
        return 1
      fi
      echo "Warning: wallet '${source_wallet_name}' in ${target_ns}/${target_pod} is '${status:-unknown}', not active; skipping." >&2
      echo "Warning: after funding it, run: ./kubeton wallet activate ${target_pod} ${source_wallet_name}" >&2
      continue
    fi
    if [[ -z "$source_address" ]]; then
      if [[ -n "$target_pod_name" ]]; then
        echo "Error: wallet '${source_wallet_name}' in ${target_ns}/${target_pod} is active but has no address in mytonctrl wl output." >&2
        return 1
      fi
      echo "Warning: wallet '${source_wallet_name}' in ${target_ns}/${target_pod} is active but has no address; skipping." >&2
      continue
    fi
    table_rows+=("${target_ns}"$'\t'"${target_pod}"$'\t'"${wallet_name}"$'\t'"${status}"$'\t'"${balance}"$'\t'"${source_address}"$'\t'"${amount}")
  done

  if [[ ${#table_rows[@]} -eq 0 ]]; then
    echo "Error: no active TON wallets resolved for wallet name '${source_wallet_name}'." >&2
    echo "Hint: check source status with './kubeton wallet show balance' and activate funded wallets with './kubeton wallet activate [tonnode-name] ${source_wallet_name}'." >&2
    return 1
  fi

  print_aligned_table_7col "namespace" "tonnode pod" "from-wallet" "status" "balance" "wallet-address" "amount" "${table_rows[@]}"
  confirm_or_exit "Collect '${amount}' from '${source_wallet_name}' on ${#table_rows[@]} TON wallet(s) to main wallet '${main_wallet_name}' (${main_wallet_address}) on ${wallet_network}?"

  for row in "${table_rows[@]}"; do
    IFS=$'\t' read -r target_ns target_pod source_wallet_name status balance source_address amount <<<"$row"
    collect_rc=0
    echo "[wallet] Collecting ${amount} from ${source_wallet_name} in ${target_ns}/${target_pod} to ${main_wallet_address} using mytonctrl mg" >&2
    if collect_tonnode_wallet_in_pod "$target_ns" "$target_pod" "$source_wallet_name" "$main_wallet_address" "$amount"; then
      ((collected_count+=1))
    else
      collect_rc=$?
      rc=1
      if (( collect_rc == 90 )); then
        echo "Error: stopping collect because mytonctrl/Fift is not usable in ${target_ns}/${target_pod}." >&2
        break
      fi
    fi
  done

  if (( rc != 0 )); then
    echo "Error: collected ${collected_count}/${#table_rows[@]} wallet(s); at least one mytonctrl mg command failed." >&2
    return 1
  fi
  echo "[wallet] Collected ${collected_count}/${#table_rows[@]} wallet(s) with mytonctrl mg."
}

resolve_tonnode_pod_row_by_name() {
  local target_name="$1"
  local row ns pod node_name
  local exact_match=""
  local prefix_match=""
  local prefix_count=0

  target_name="$(trim_whitespace "$target_name")"
  [[ -z "$target_name" ]] && return 1

  while IFS= read -r row; do
    [[ -z "$row" ]] && continue
    IFS=$'\t' read -r ns pod node_name <<<"$row"
    [[ -z "$ns" || -z "$pod" ]] && continue
    if [[ "$pod" == "$target_name" ]]; then
      exact_match="$row"
      break
    fi
    if [[ "$pod" == "$target_name"-* ]]; then
      prefix_match="$row"
      ((prefix_count+=1))
    fi
  done < <(list_ton_pods 2>/dev/null || true)

  if [[ -n "$exact_match" ]]; then
    printf '%s' "$exact_match"
    return 0
  fi
  if (( prefix_count == 1 )) && [[ -n "$prefix_match" ]]; then
    printf '%s' "$prefix_match"
    return 0
  fi
  if (( prefix_count > 1 )); then
    echo "Error: tonnode selector '${target_name}' matches multiple TON pods. Use an exact pod name." >&2
    return 1
  fi
  return 1
}

delete_ton_pvcs_for_statefulsets() {
  local -n sts_rows_ref="$1"
  local label="${2:-cleanup}"
  local force_unresolved_local_pvcs=false
  local row ns sts
  local -a candidate_rows=()
  local -a trusted_sts_claim_rows=()
  local -a pvc_rows=()
  local -a live_ton_pod_rows=()
  local pvc_name
  local live_row live_ns live_pod live_node

  if [[ ${#sts_rows_ref[@]} -eq 0 ]]; then
    echo "[cleanup] No StatefulSet snapshot was provided; using expected TON PVC names and label selector." >&2
  fi

  for row in "${sts_rows_ref[@]}"; do
    [[ -z "$row" ]] && continue
    IFS=$'\t' read -r ns sts _ <<<"$row"
    [[ -z "$ns" || -z "$sts" ]] && continue

    while IFS= read -r pvc_name; do
      [[ -z "$pvc_name" ]] && continue
      append_unique_item "$ns"$'\t'"$pvc_name" candidate_rows
      append_unique_item "$ns"$'\t'"$pvc_name" trusted_sts_claim_rows
    done < <(
      kubectl -n "$ns" get pvc -o jsonpath='{range .items[*]}{.metadata.name}{"\n"}{end}' 2>/dev/null \
        | grep -E "^(ton-work|ton-src|mytoncore|mytonctrl|keybundle)-${sts}-" || true
    )
  done

  collect_expected_ton_pvc_rows_from_values candidate_rows
  collect_labeled_ton_pvc_rows candidate_rows
  collect_existing_kubeton_pvc_rows candidate_rows pvc_rows "$label" trusted_sts_claim_rows

  if [[ ${#pvc_rows[@]} -eq 0 ]]; then
    return 0
  fi

  mapfile -t live_ton_pod_rows < <(list_ton_pods 2>/dev/null || true)
  if [[ ${#live_ton_pod_rows[@]} -gt 0 && -n "${live_ton_pod_rows[0]:-}" ]]; then
    echo "Error: refusing to delete TON PVCs while TON pod(s) still exist:" >&2
    for live_row in "${live_ton_pod_rows[@]}"; do
      [[ -z "$live_row" ]] && continue
      IFS=$'\t' read -r live_ns live_pod live_node <<<"$live_row"
      [[ -z "$live_ns" || -z "$live_pod" ]] && continue
      echo "  - ${live_ns}/${live_pod} on ${live_node:-unknown}" >&2
    done
    echo "Wait for the pods to terminate, then rerun cleanup/uninstall." >&2
    return 1
  fi

  # Only the explicitly destructive TON commands may remove a PVC object
  # whose exact local-path owner cannot be proven. The generic helper still
  # requires a durable UID-bound PV ledger and an unmounted claim.
  case "$label" in
    uninstall|drop)
      force_unresolved_local_pvcs=true
      ;;
  esac
  delete_pvc_rows_and_backing_volumes pvc_rows "$label" "$force_unresolved_local_pvcs"
}

ton_fleet_resources_exist() {
  local -a sts_rows=()

  if cluster_has_tonnodes; then
    return 0
  fi

  mapfile -t sts_rows < <(list_ton_statefulsets 2>/dev/null || true)
  [[ ${#sts_rows[@]} -gt 0 && -n "${sts_rows[0]:-}" ]]
}

delete_stale_ton_pvcs_without_fleet() {
  local label="${1:-cleanup}"
  local force="${2:-false}"
  local -a candidate_rows=()
  local -a existing_rows=()
  local -a empty_sts_rows=()
  local row ns pvc

  if [[ "$force" != "true" ]] && ton_fleet_resources_exist; then
    return 0
  fi

  collect_expected_ton_pvc_rows_from_values candidate_rows
  collect_labeled_ton_pvc_rows candidate_rows
  collect_existing_kubeton_pvc_rows candidate_rows existing_rows "$label"

  if [[ ${#existing_rows[@]} -eq 0 ]]; then
    if [[ "$label" == "uninstall" || "$label" == "drop" ]]; then
      cleanup_recorded_local_path_data "$label" || return 1
    fi
    return 0
  fi

  if [[ "$force" == "true" ]]; then
    echo "[${label}] Found TON PVCs during forced cleanup; deleting them so bootstrap cannot reuse partial state:"
  else
    echo "[${label}] Found stale TON PVCs with no active TON fleet; deleting them so bootstrap cannot reuse partial state:"
  fi
  for row in "${existing_rows[@]}"; do
    IFS=$'\t' read -r ns pvc <<<"$row"
    [[ -z "$ns" || -z "$pvc" ]] && continue
    echo "  - ${ns}/${pvc}"
  done

  delete_ton_pvcs_for_statefulsets empty_sts_rows "$label"

  candidate_rows=()
  existing_rows=()
  collect_expected_ton_pvc_rows_from_values candidate_rows
  collect_labeled_ton_pvc_rows candidate_rows
  collect_existing_kubeton_pvc_rows candidate_rows existing_rows "$label"

  if [[ ${#existing_rows[@]} -eq 0 ]]; then
    if [[ "$label" == "uninstall" || "$label" == "drop" ]]; then
      cleanup_recorded_local_path_data "$label" || return 1
    fi
    return 0
  fi

  echo "Error: stale TON PVCs are still present after cleanup; refusing to continue with reusable partial state:" >&2
  for row in "${existing_rows[@]}"; do
    IFS=$'\t' read -r ns pvc <<<"$row"
    [[ -z "$ns" || -z "$pvc" ]] && continue
    echo "  - ${ns}/${pvc}" >&2
  done
  echo "Delete these PVCs/PVs manually or rerun kubeton uninstall/drop before starting." >&2
  return 1
}

delete_stale_ton_pvcs_before_fresh_start() {
  delete_stale_ton_pvcs_without_fleet "start"
}

set_ton_replicas() {
  local ns="$1"
  local name="$2"
  local replicas="$3"

  kubectl -n "$ns" scale statefulset "$name" --replicas="$replicas" >/dev/null
}

wait_pvc_bound() {
  local ns="$1"
  local pvc="$2"
  local timeout_seconds="${3:-300}"
  local deadline=$(( $(date +%s) + timeout_seconds ))
  local phase=""
  local deleting=""

  while (( $(date +%s) < deadline )); do
    phase="$(kubectl -n "$ns" get pvc "$pvc" -o jsonpath='{.status.phase}' 2>/dev/null || true)"
    deleting="$(kubectl -n "$ns" get pvc "$pvc" -o jsonpath='{.metadata.deletionTimestamp}' 2>/dev/null || true)"
    if [[ "$phase" == "Bound" && -z "$deleting" ]]; then
      return 0
    fi
    sleep 2
  done

  echo "Error: timeout waiting for PVC ${ns}/${pvc} to become Bound (last phase='${phase:-not-found}', deleting='${deleting:-no}')." >&2
  return 1
}

pvc_uses_wait_for_first_consumer() {
  local ns="$1"
  local pvc="$2"
  local storage_class=""
  local mode=""

  storage_class="$(kubectl -n "$ns" get pvc "$pvc" -o jsonpath='{.spec.storageClassName}' 2>/dev/null || true)"
  storage_class="$(trim_whitespace "$storage_class")"
  if [[ -z "$storage_class" ]]; then
    return 1
  fi

  mode="$(kubectl get storageclass "$storage_class" -o jsonpath='{.volumeBindingMode}' 2>/dev/null || true)"
  mode="$(trim_whitespace "$mode")"
  [[ "$mode" == "WaitForFirstConsumer" ]]
}

wait_pvc_gone() {
  local ns="$1"
  local pvc="$2"
  local timeout_seconds="${3:-600}"
  local deadline=$(( $(date +%s) + timeout_seconds ))
  local marker

  while (( $(date +%s) < deadline )); do
    if ! marker="$(kubectl -n "$ns" get pvc "$pvc" --ignore-not-found -o jsonpath='{.metadata.uid}' 2>/dev/null)"; then
      echo "Error: could not check whether PVC ${ns}/${pvc} was deleted." >&2
      return 2
    fi
    marker="$(trim_whitespace "$marker")"
    if [[ -z "$marker" ]]; then
      return 0
    fi
    sleep 2
  done

  echo "Error: timeout waiting for PVC ${ns}/${pvc} to be deleted." >&2
  return 1
}

wait_pv_gone() {
  local pv="$1"
  local timeout_seconds="${2:-300}"
  local deadline=$(( $(date +%s) + timeout_seconds ))
  local marker

  while (( $(date +%s) < deadline )); do
    if ! marker="$(kubectl get pv "$pv" --ignore-not-found -o jsonpath='{.metadata.uid}' 2>/dev/null)"; then
      echo "Error: could not check whether PV ${pv} was deleted." >&2
      return 2
    fi
    marker="$(trim_whitespace "$marker")"
    if [[ -z "$marker" ]]; then
      return 0
    fi
    sleep 2
  done

  echo "Warning: timeout waiting for PV ${pv} to be deleted." >&2
  return 1
}

wait_longhorn_volume_gone() {
  local volume="$1"
  local timeout_seconds="${2:-300}"
  local deadline=$(( $(date +%s) + timeout_seconds ))

  local namespace_marker marker
  if ! namespace_marker="$(kubectl get namespace "$LONGHORN_NAMESPACE" --ignore-not-found -o jsonpath='{.metadata.uid}' 2>/dev/null)"; then
    echo "Error: could not check Longhorn namespace ${LONGHORN_NAMESPACE}." >&2
    return 2
  fi
  namespace_marker="$(trim_whitespace "$namespace_marker")"
  if [[ -z "$namespace_marker" ]]; then
    return 0
  fi

  while (( $(date +%s) < deadline )); do
    if ! marker="$(kubectl -n "$LONGHORN_NAMESPACE" get volumes.longhorn.io "$volume" --ignore-not-found -o jsonpath='{.metadata.uid}' 2>/dev/null)"; then
      echo "Error: could not check whether Longhorn volume ${volume} was deleted." >&2
      return 2
    fi
    marker="$(trim_whitespace "$marker")"
    if [[ -z "$marker" ]]; then
      return 0
    fi
    sleep 2
  done

  echo "Warning: timeout waiting for Longhorn volume ${volume} to be deleted." >&2
  return 1
}

wait_volume_attachments_gone() {
  local pv="$1"
  local timeout_seconds="${2:-180}"
  local deadline=$(( $(date +%s) + timeout_seconds ))
  local count attachment_rows

  while (( $(date +%s) < deadline )); do
    if ! attachment_rows="$(kubectl get volumeattachments.storage.k8s.io \
      -o jsonpath='{range .items[?(@.spec.source.persistentVolumeName=="'"${pv}"'")]}{.metadata.name}{"\n"}{end}' 2>/dev/null)"; then
      echo "Error: could not check VolumeAttachment objects for PV ${pv}." >&2
      return 2
    fi
    count="$(printf '%s\n' "$attachment_rows" | awk 'NF{c++} END{print c+0}')"
    if [[ "${count:-0}" == "0" ]]; then
      return 0
    fi
    sleep 2
  done

  echo "Warning: timeout waiting for VolumeAttachment objects for PV ${pv} to be deleted." >&2
  return 1
}

# A PV must not be deleted while Kubernetes still reports an attachment.  The
# second check is intentionally authoritative: attachment API/RBAC failures
# and timeouts fail closed rather than being treated as "detached".
ensure_volume_attachments_gone_for_pv() {
  local pv="$1"
  local initial_timeout_seconds="${2:-180}"
  local recovery_timeout_seconds="${3:-60}"
  local wait_rc=0

  if wait_volume_attachments_gone "$pv" "$initial_timeout_seconds"; then
    return 0
  else
    wait_rc=$?
  fi
  if (( wait_rc == 2 )); then
    echo "Error: could not verify VolumeAttachment objects for PV ${pv}." >&2
    return 1
  fi

  echo "Warning: VolumeAttachment objects for PV ${pv} did not disappear normally; retrying forced attachment cleanup." >&2
  delete_volume_attachments_for_pv "$pv"
  if wait_volume_attachments_gone "$pv" "$recovery_timeout_seconds"; then
    return 0
  fi
  echo "Error: VolumeAttachment objects for PV ${pv} remain or cannot be verified; refusing PV deletion." >&2
  return 1
}

delete_pvc_and_wait_for_gone() {
  local ns="$1"
  local pvc="$2"
  local initial_timeout_seconds="${3:-120}"
  local recovery_timeout_seconds="${4:-60}"
  local wait_rc=0

  kubectl -n "$ns" delete pvc "$pvc" --ignore-not-found --wait=false >/dev/null 2>&1 || true
  if wait_pvc_gone "$ns" "$pvc" "$initial_timeout_seconds"; then
    return 0
  else
    wait_rc=$?
  fi
  if (( wait_rc == 2 )); then
    return 1
  fi

  if ! verify_no_pod_references_for_pvc "$ns" "$pvc"; then
    echo "Error: PVC ${ns}/${pvc} is still referenced by a pod; refusing to clear its finalizers." >&2
    return 1
  fi
  echo "Warning: PVC ${ns}/${pvc} did not delete normally; clearing finalizers for destructive cleanup." >&2
  kubectl -n "$ns" patch pvc "$pvc" --type=merge -p '{"metadata":{"finalizers":[]}}' >/dev/null 2>&1 || true
  kubectl -n "$ns" delete pvc "$pvc" --ignore-not-found --wait=false >/dev/null 2>&1 || true
  if wait_pvc_gone "$ns" "$pvc" "$recovery_timeout_seconds"; then
    return 0
  else
    wait_rc=$?
  fi
  if (( wait_rc == 2 )); then
    return 1
  fi

  echo "Error: PVC ${ns}/${pvc} still exists after destructive finalizer recovery." >&2
  return 1
}

# Used only by the explicit TON drop/uninstall path after a UID-bound PV/PVC
# ledger entry was stored, but the node-local host path could not be proven.
# Do not call this as a generic replacement for storage inventory: removing a
# PVC can cause a Delete-policy provisioner to reclaim its data.  The caller
# intentionally retains the unresolved PV in the durable ledger and reports a
# non-zero result for manual reconciliation.
force_delete_unmounted_pvc_after_unresolved_local_inventory() {
  local ns="$1"
  local pvc="$2"
  local expected_pvc_uid="$3"
  local timeout_seconds="${4:-60}"
  local pvc_uid pvc_deletion_timestamp pvc_identity wait_rc=0

  if ! [[ "$expected_pvc_uid" =~ ^[a-z0-9]([a-z0-9-]*[a-z0-9])?$ ]]; then
    echo "Error: refusing destructive finalizer recovery for PVC ${ns}/${pvc} without its recorded UID." >&2
    return 1
  fi

  if ! pvc_uid="$(kubectl -n "$ns" get pvc "$pvc" --ignore-not-found -o jsonpath='{.metadata.uid}' 2>/dev/null)"; then
    echo "Error: could not recheck PVC ${ns}/${pvc} before destructive finalizer recovery." >&2
    return 1
  fi
  pvc_uid="$(trim_whitespace "$pvc_uid")"
  [[ -n "$pvc_uid" ]] || return 0
  if [[ "$pvc_uid" != "$expected_pvc_uid" ]]; then
    echo "Error: refusing destructive finalizer recovery for PVC ${ns}/${pvc}: its UID changed after storage inventory." >&2
    return 1
  fi

  # Always request normal deletion first. A non-terminating PVC can still
  # acquire a pod reference; finalizers are only an escape hatch once the
  # expected claim is already terminating and proven unmounted.
  if ! kubectl -n "$ns" delete pvc "$pvc" --ignore-not-found --wait=false >/dev/null 2>&1; then
    echo "Error: could not request deletion of PVC ${ns}/${pvc} before finalizer recovery." >&2
    return 1
  fi
  if wait_pvc_gone "$ns" "$pvc" 5; then
    return 0
  else
    wait_rc=$?
  fi
  if (( wait_rc == 2 )); then
    echo "Error: could not verify PVC ${ns}/${pvc} after requesting deletion." >&2
    return 1
  fi

  if ! pvc_identity="$(kubectl -n "$ns" get pvc "$pvc" --ignore-not-found -o jsonpath='{.metadata.uid}{"\t"}{.metadata.deletionTimestamp}' 2>/dev/null)"; then
    echo "Error: could not recheck PVC ${ns}/${pvc} before finalizer recovery." >&2
    return 1
  fi
  IFS=$'\t' read -r pvc_uid pvc_deletion_timestamp <<<"$pvc_identity"
  pvc_uid="$(trim_whitespace "$pvc_uid")"
  pvc_deletion_timestamp="$(trim_whitespace "$pvc_deletion_timestamp")"
  [[ -n "$pvc_uid" ]] || return 0
  if [[ "$pvc_uid" != "$expected_pvc_uid" ]]; then
    echo "Error: refusing destructive finalizer recovery for PVC ${ns}/${pvc}: its UID changed after deletion was requested." >&2
    return 1
  fi
  if [[ -z "$pvc_deletion_timestamp" ]]; then
    echo "Error: PVC ${ns}/${pvc} did not enter termination after its delete request; refusing to clear finalizers." >&2
    return 1
  fi

  if ! verify_no_pod_references_for_pvc "$ns" "$pvc"; then
    echo "Error: PVC ${ns}/${pvc} is still referenced by a pod; refusing to clear its finalizers after unresolved local-path inventory." >&2
    return 1
  fi

  # Re-read immediately before the destructive patch. This avoids acting on a
  # same-name PVC that was recreated while pod references were inspected.
  if ! pvc_identity="$(kubectl -n "$ns" get pvc "$pvc" --ignore-not-found -o jsonpath='{.metadata.uid}{"\t"}{.metadata.deletionTimestamp}' 2>/dev/null)"; then
    echo "Error: could not recheck PVC ${ns}/${pvc} immediately before destructive finalizer recovery." >&2
    return 1
  fi
  IFS=$'\t' read -r pvc_uid pvc_deletion_timestamp <<<"$pvc_identity"
  pvc_uid="$(trim_whitespace "$pvc_uid")"
  pvc_deletion_timestamp="$(trim_whitespace "$pvc_deletion_timestamp")"
  [[ -n "$pvc_uid" ]] || return 0
  if [[ "$pvc_uid" != "$expected_pvc_uid" || -z "$pvc_deletion_timestamp" ]]; then
    echo "Error: refusing destructive finalizer recovery for PVC ${ns}/${pvc}: its UID changed immediately before cleanup." >&2
    return 1
  fi

  echo "Warning: clearing finalizers and force-deleting unmounted PVC ${ns}/${pvc}; its local backing path could not be proven and its storage record remains in the cleanup ledger for manual reconciliation." >&2
  # The JSON Patch `test` makes the final mutation conditional on the exact
  # UID captured in the ledger, closing the remaining same-name replacement
  # race between the recheck and patch.
  if ! kubectl -n "$ns" patch pvc "$pvc" --type=json \
    -p "[{\"op\":\"test\",\"path\":\"/metadata/uid\",\"value\":\"${expected_pvc_uid}\"},{\"op\":\"add\",\"path\":\"/metadata/finalizers\",\"value\":[]}]" >/dev/null 2>&1; then
    # A concurrent controller may have completed deletion after the recheck.
    # Verify that outcome instead of treating every patch failure as success.
    if wait_pvc_gone "$ns" "$pvc" 5; then
      return 0
    fi
    echo "Error: could not clear finalizers on PVC ${ns}/${pvc}." >&2
    return 1
  fi
  if wait_pvc_gone "$ns" "$pvc" "$timeout_seconds"; then
    return 0
  fi

  echo "Error: PVC ${ns}/${pvc} still exists after guarded destructive finalizer recovery." >&2
  return 1
}

delete_pv_and_wait_for_gone() {
  local pv="$1"
  local initial_timeout_seconds="${2:-180}"
  local recovery_timeout_seconds="${3:-60}"
  local allow_finalizer_recovery="${4:-true}"
  local wait_rc=0

  kubectl delete pv "$pv" --ignore-not-found --wait=false >/dev/null 2>&1 || true
  if wait_pv_gone "$pv" "$initial_timeout_seconds"; then
    return 0
  else
    wait_rc=$?
  fi
  if (( wait_rc == 2 )); then
    return 1
  fi
  if ! is_true "$allow_finalizer_recovery"; then
    echo "Error: PV ${pv} did not delete normally; refusing to clear finalizers for a non-local CSI volume." >&2
    return 1
  fi

  echo "Warning: PV ${pv} did not delete normally; clearing finalizers for destructive cleanup." >&2
  kubectl patch "pv/${pv}" --type=merge -p '{"metadata":{"finalizers":[]}}' >/dev/null 2>&1 || true
  kubectl delete pv "$pv" --ignore-not-found --wait=false >/dev/null 2>&1 || true
  if wait_pv_gone "$pv" "$recovery_timeout_seconds"; then
    return 0
  else
    wait_rc=$?
  fi
  if (( wait_rc == 2 )); then
    return 1
  fi

  echo "Error: PV ${pv} still exists after destructive finalizer recovery." >&2
  return 1
}

reset_add_target_pvc_if_exists() {
  local ns="$1"
  local pvc="$2"
  local pv=""

  if ! kubectl -n "$ns" get pvc "$pvc" >/dev/null 2>&1; then
    return 0
  fi

  pv="$(kubectl -n "$ns" get pvc "$pvc" -o jsonpath='{.spec.volumeName}' 2>/dev/null || true)"
  echo "Found leftover PVC ${ns}/${pvc}; deleting it for fresh replica bootstrap ..."
  kubectl -n "$ns" delete pvc "$pvc" --ignore-not-found --wait=false >/dev/null 2>&1 || true
  wait_pvc_gone "$ns" "$pvc" 300 || return 1

  if [[ -n "$pv" ]]; then
    kubectl delete pv "$pv" --ignore-not-found --wait=false >/dev/null 2>&1 || true
    kubectl -n "$LONGHORN_NAMESPACE" delete volumes.longhorn.io "$pv" --ignore-not-found --wait=false >/dev/null 2>&1 || true
  fi
}

wait_pod_ready() {
  local ns="$1"
  local pod="$2"
  local timeout_seconds="${3:-900}"
  local deadline=$(( $(date +%s) + timeout_seconds ))

  while (( $(date +%s) < deadline )); do
    if kubectl -n "$ns" wait --for=condition=Ready "pod/${pod}" --timeout=10s >/dev/null 2>&1; then
      return 0
    fi
    sleep 2
  done

  echo "Error: timeout waiting for pod ${ns}/${pod} to become Ready." >&2
  return 1
}

ton_pod_initial_bootstrap_state() {
  local ns="$1"
  local pod="$2"
  local pod_row node phase scheduled_status scheduled_reason scheduled_message
  local restart_count waiting_reason last_exit event_row event_reason event_message process_state

  if ! pod_row="$(run_with_timeout "$STATUS_EXEC_TIMEOUT" kubectl -n "$ns" get pod "$pod" --ignore-not-found \
    -o go-template='{{.spec.nodeName}}{{"\x1f"}}{{.status.phase}}{{"\x1f"}}{{range .status.conditions}}{{if eq .type "PodScheduled"}}{{.status}}{{"\x1f"}}{{.reason}}{{"\x1f"}}{{.message}}{{end}}{{end}}{{"\x1f"}}{{range .status.containerStatuses}}{{if eq .name "ton-node"}}{{.restartCount}}{{"\x1f"}}{{if .state.waiting}}{{.state.waiting.reason}}{{end}}{{"\x1f"}}{{if .lastState.terminated}}{{.lastState.terminated.exitCode}}{{end}}{{end}}' 2>/dev/null)"; then
    printf 'unknown\x1f-\x1f0\x1f\x1f\x1funable to read Pod status'
    return 0
  fi
  pod_row="$(printf '%s' "$pod_row" | tr '\t\r\n' '   ')"
  if [[ -z "$(trim_whitespace "$pod_row")" ]]; then
    printf 'waiting-for-pod\x1f-\x1f0\x1f\x1f\x1fPod has not been created'
    return 0
  fi
  IFS=$'\x1f' read -r node phase scheduled_status scheduled_reason scheduled_message restart_count waiting_reason last_exit <<<"$pod_row"
  node="$(trim_whitespace "$node")"
  phase="$(trim_whitespace "$phase")"
  scheduled_status="$(trim_whitespace "$scheduled_status")"
  scheduled_reason="$(trim_whitespace "$scheduled_reason")"
  scheduled_message="$(trim_whitespace "$scheduled_message")"
  restart_count="$(trim_whitespace "$restart_count")"
  waiting_reason="$(trim_whitespace "$waiting_reason")"
  last_exit="$(trim_whitespace "$last_exit")"
  [[ -z "$node" ]] && node="-"
  [[ "$restart_count" =~ ^[0-9]+$ ]] || restart_count=0

  if [[ "$scheduled_status" == "False" || -z "$node" || "$node" == "-" ]]; then
    event_row="$(run_with_timeout "$STATUS_EXEC_TIMEOUT" kubectl -n "$ns" get events \
      --field-selector "involvedObject.kind=Pod,involvedObject.name=${pod},type=Warning" \
      --sort-by=.lastTimestamp \
      -o custom-columns='REASON:.reason,MESSAGE:.message' --no-headers 2>/dev/null | tail -n 1 || true)"
    event_reason="${event_row%%[[:space:]]*}"
    event_message="${event_row#"$event_reason"}"
    event_reason="$(trim_whitespace "$event_reason")"
    event_message="$(trim_whitespace "$event_message")"
    [[ -z "$event_reason" ]] && event_reason="${scheduled_reason:-Pending}"
    [[ -z "$event_message" ]] && event_message="${scheduled_message:-Pod is not scheduled}"
    printf '%s\x1f%s\x1f%s\x1f%s\x1f%s\x1f%s' "$event_reason" "$node" "$restart_count" "$waiting_reason" "$last_exit" "$event_message"
    return 0
  fi

  if [[ -n "$waiting_reason" ]]; then
    printf '%s\x1f%s\x1f%s\x1f%s\x1f%s\x1fcontainer is waiting' "$waiting_reason" "$node" "$restart_count" "$waiting_reason" "$last_exit"
    return 0
  fi
  if [[ "$phase" != "Running" ]]; then
    event_row="$(run_with_timeout "$STATUS_EXEC_TIMEOUT" kubectl -n "$ns" get events \
      --field-selector "involvedObject.kind=Pod,involvedObject.name=${pod},type=Warning" \
      --sort-by=.lastTimestamp \
      -o custom-columns='REASON:.reason,MESSAGE:.message' --no-headers 2>/dev/null | tail -n 1 || true)"
    event_reason="${event_row%%[[:space:]]*}"
    event_message="${event_row#"$event_reason"}"
    event_reason="$(trim_whitespace "$event_reason")"
    event_message="$(trim_whitespace "$event_message")"
    if [[ -n "$event_reason" ]]; then
      printf '%s\x1f%s\x1f%s\x1f%s\x1f%s\x1f%s' "$event_reason" "$node" "$restart_count" "$waiting_reason" "$last_exit" "$event_message"
    else
      printf '%s\x1f%s\x1f%s\x1f%s\x1f%s\x1fPod phase is %s' "${phase:-Pending}" "$node" "$restart_count" "$waiting_reason" "$last_exit" "${phase:-unknown}"
    fi
    return 0
  fi

  if run_with_timeout "$STATUS_EXEC_TIMEOUT" kubectl -n "$ns" exec "$pod" -c ton-node -- sh -ec '
      test -f /var/ton-work/db/mtc_done
      test -s /var/ton-work/db/config.json
      test -s /var/ton-work/db/systemd-units/validator.service
      test -s /var/ton-work/db/systemd-units/mytoncore.service
    ' >/dev/null 2>&1; then
    printf 'complete\x1f%s\x1f%s\x1f%s\x1f%s\x1fMyTonCtrl bootstrap commit state is present' "$node" "$restart_count" "$waiting_reason" "$last_exit"
    return 0
  fi

  process_state="$(run_with_timeout "$STATUS_EXEC_TIMEOUT" kubectl -n "$ns" exec "$pod" -c ton-node -- sh -ec '
      args="$(ps -eo args 2>/dev/null || true)"
      if printf "%s\n" "$args" | grep -q "[a]ria2c"; then
        echo downloading
      elif printf "%s\n" "$args" | grep -Eq "[p]lzip|[t]ar -xf .*var/ton-work/db"; then
        echo extracting
      else
        echo bootstrapping
      fi
    ' 2>/dev/null || true)"
  process_state="$(trim_whitespace "$process_state")"
  case "$process_state" in
    downloading|extracting|bootstrapping) ;;
    *) process_state="bootstrapping" ;;
  esac
  printf '%s\x1f%s\x1f%s\x1f%s\x1f%s\x1fmtc_done is not committed yet' "$process_state" "$node" "$restart_count" "$waiting_reason" "$last_exit"
}

wait_ton_initial_bootstrap_complete() {
  local ns="$1"
  local tonnode_name="$2"
  local desired_replicas="$3"
  local timeout_seconds="${4:-$KUBETON_START_READY_TIMEOUT_SECONDS}"
  local status_interval fatal_restart_count deadline now started_at ordinal pod row
  local state node restarts waiting_reason last_exit detail state_key complete_count fatal_count
  local -A last_state=()
  local -A last_printed_at=()

  if ! [[ "$desired_replicas" =~ ^[1-9][0-9]*$ ]]; then
    echo "Error: invalid desired TON replica count '${desired_replicas}' for bootstrap wait." >&2
    return 1
  fi
  timeout_seconds="$(trim_whitespace "$timeout_seconds")"
  status_interval="$(trim_whitespace "${KUBETON_START_STATUS_INTERVAL_SECONDS:-60}")"
  fatal_restart_count="$(trim_whitespace "${KUBETON_START_FATAL_RESTART_COUNT:-5}")"
  if ! [[ "$timeout_seconds" =~ ^[1-9][0-9]*$ ]]; then
    echo "Error: invalid KUBETON_START_READY_TIMEOUT_SECONDS '${timeout_seconds}'." >&2
    return 1
  fi
  [[ "$status_interval" =~ ^[1-9][0-9]*$ ]] || status_interval=60
  [[ "$fatal_restart_count" =~ ^[0-9]+$ ]] || fatal_restart_count=5
  started_at="$(date +%s)"
  deadline=$((started_at + timeout_seconds))
  echo "[start] Waiting for ${desired_replicas} TON replica(s) to commit initial MyTonCtrl bootstrap (timeout ${timeout_seconds}s) ..."

  while :; do
    now="$(date +%s)"
    complete_count=0
    fatal_count=0
    for ordinal in $(seq 0 $((desired_replicas - 1))); do
      pod="${tonnode_name}-${ordinal}"
      row="$(ton_pod_initial_bootstrap_state "$ns" "$pod")"
      IFS=$'\x1f' read -r state node restarts waiting_reason last_exit detail <<<"$row"
      state="$(trim_whitespace "$state")"
      node="$(trim_whitespace "$node")"
      restarts="$(trim_whitespace "$restarts")"
      waiting_reason="$(trim_whitespace "$waiting_reason")"
      last_exit="$(trim_whitespace "$last_exit")"
      detail="$(trim_whitespace "$detail")"
      [[ "$restarts" =~ ^[0-9]+$ ]] || restarts=0
      state_key="${state}|${node}|${restarts}|${waiting_reason}|${last_exit}|${detail}"

      if [[ "${last_state[$pod]:-}" != "$state_key" ]] \
        || (( now - ${last_printed_at[$pod]:-0} >= status_interval )); then
        printf '[start] %-24s node=%-16s state=%-22s restarts=%s' "${ns}/${pod}" "${node:--}" "${state:-unknown}" "$restarts"
        [[ -n "$last_exit" ]] && printf ' lastExit=%s' "$last_exit"
        [[ -n "$detail" ]] && printf ' - %s' "$detail"
        printf '\n'
        last_state["$pod"]="$state_key"
        last_printed_at["$pod"]="$now"
      fi

      if [[ "$state" == "complete" ]]; then
        complete_count=$((complete_count + 1))
      elif [[ "$state" == "CrashLoopBackOff" ]] \
        && (( fatal_restart_count > 0 && restarts >= fatal_restart_count )) \
        && [[ -n "$last_exit" && "$last_exit" != "0" ]]; then
        fatal_count=$((fatal_count + 1))
      fi
    done

    if (( complete_count == desired_replicas )); then
      echo "[start] All ${desired_replicas} TON replica(s) committed initial MyTonCtrl bootstrap in $((now - started_at))s."
      return 0
    fi
    if (( fatal_count > 0 )); then
      echo "Error: ${fatal_count} TON replica(s) repeatedly failed with a deterministic non-zero exit; initial bootstrap did not complete." >&2
      echo "Error: inspect the launch evidence bundle printed by kubeton; the pods were left intact for diagnosis." >&2
      return 1
    fi
    if (( now >= deadline )); then
      echo "Error: timed out after ${timeout_seconds}s waiting for all TON replicas to commit initial bootstrap (${complete_count}/${desired_replicas} complete)." >&2
      echo "Error: pods and PVCs were left intact; inspect the launch evidence bundle printed by kubeton." >&2
      return 1
    fi
    sleep 5
  done
}

wait_pod_volume_stage_complete() {
  local ns="$1"
  local pod="$2"
  local timeout_seconds="${3:-$KUBETON_VOLUME_STAGE_TIMEOUT_SECONDS}"
  local deadline=$(( $(date +%s) + timeout_seconds ))
  local phase init_count container_count deleting latest_mount_warning

  while (( $(date +%s) < deadline )); do
    phase="$(kubectl -n "$ns" get pod "$pod" -o jsonpath='{.status.phase}' 2>/dev/null || true)"
    deleting="$(kubectl -n "$ns" get pod "$pod" -o jsonpath='{.metadata.deletionTimestamp}' 2>/dev/null || true)"
    init_count="$(kubectl -n "$ns" get pod "$pod" -o jsonpath='{range .status.initContainerStatuses[*]}x{"\n"}{end}' 2>/dev/null | awk 'NF{c++} END{print c+0}')"
    container_count="$(kubectl -n "$ns" get pod "$pod" -o jsonpath='{range .status.containerStatuses[*]}x{"\n"}{end}' 2>/dev/null | awk 'NF{c++} END{print c+0}')"

    if [[ -z "$deleting" ]] && [[ "$phase" == "Running" || "$phase" == "Succeeded" || "${init_count:-0}" != "0" || "${container_count:-0}" != "0" ]]; then
      return 0
    fi
    sleep 2
  done

  latest_mount_warning="$(kubectl -n "$ns" get events \
    --field-selector "involvedObject.kind=Pod,involvedObject.name=${pod},type=Warning,reason=FailedMount" \
    --sort-by=.lastTimestamp \
    -o custom-columns=MESSAGE:.message \
    --no-headers 2>/dev/null | tail -n 1 || true)"
  echo "Error: timeout waiting for pod ${ns}/${pod} to finish volume staging." >&2
  if [[ -n "$(trim_whitespace "$latest_mount_warning")" ]]; then
    echo "Latest mount warning: $(trim_whitespace "$latest_mount_warning")" >&2
  fi
  return 1
}

wait_pod_gone() {
  local ns="$1"
  local pod="$2"
  local timeout_seconds="${3:-600}"
  local deadline=$(( $(date +%s) + timeout_seconds ))

  while (( $(date +%s) < deadline )); do
    if ! kubectl -n "$ns" get pod "$pod" >/dev/null 2>&1; then
      return 0
    fi
    sleep 2
  done

  echo "Error: timeout waiting for pod ${ns}/${pod} to be deleted." >&2
  return 1
}

helper_pod_node_constraints_yaml() {
  local preferred_node="$1"
  local selector="${LONGHORN_NODE_SELECTOR:-}"
  local -a selector_pairs=()

  preferred_node="$(trim_whitespace "$preferred_node")"
  if [[ -n "$preferred_node" ]]; then
    printf '  nodeName: %s\n' "$preferred_node"
    return 0
  fi

  if ! parse_selector_pairs "$selector" selector_pairs >/dev/null 2>&1; then
    return 0
  fi
  if [[ ${#selector_pairs[@]} -eq 0 ]]; then
    return 0
  fi

  echo "  nodeSelector:"
  write_yaml_map_from_pairs selector_pairs 4
}

print_helper_pod_failure_context() {
  local ns="$1"
  local pod="$2"
  local phase node_name

  phase="$(kubectl -n "$ns" get pod "$pod" -o jsonpath='{.status.phase}' 2>/dev/null || true)"
  node_name="$(kubectl -n "$ns" get pod "$pod" -o jsonpath='{.spec.nodeName}' 2>/dev/null || true)"
  phase="$(trim_whitespace "$phase")"
  node_name="$(trim_whitespace "$node_name")"
  [[ -z "$phase" ]] && phase="unknown"
  [[ -z "$node_name" ]] && node_name="unknown"

  echo "Helper pod status: phase=${phase}, node=${node_name}" >&2
  echo "Recent warning events for ${ns}/${pod}:" >&2
  kubectl -n "$ns" get events \
    --field-selector "involvedObject.kind=Pod,involvedObject.name=${pod},type=Warning" \
    --sort-by=.lastTimestamp \
    -o custom-columns=TIME:.lastTimestamp,REASON:.reason,MESSAGE:.message \
    --no-headers 2>/dev/null | tail -n 5 >&2 || true
}

create_replica_pvc_from_ordinal0() {
  local ns="$1"
  local sts="$2"
  local claim_prefix="$3"
  local ordinal="$4"
  local source_pvc="${claim_prefix}-${sts}-0"
  local target_pvc="${claim_prefix}-${sts}-${ordinal}"
  local storage_request storage_class volume_mode access_modes_raw
  local -a access_modes=()

  if kubectl -n "$ns" get pvc "$target_pvc" >/dev/null 2>&1; then
    return 0
  fi
  if ! kubectl -n "$ns" get pvc "$source_pvc" >/dev/null 2>&1; then
    return 10
  fi

  storage_request="$(kubectl -n "$ns" get pvc "$source_pvc" -o jsonpath='{.spec.resources.requests.storage}' 2>/dev/null || true)"
  storage_class="$(kubectl -n "$ns" get pvc "$source_pvc" -o jsonpath='{.spec.storageClassName}' 2>/dev/null || true)"
  volume_mode="$(kubectl -n "$ns" get pvc "$source_pvc" -o jsonpath='{.spec.volumeMode}' 2>/dev/null || true)"
  access_modes_raw="$(kubectl -n "$ns" get pvc "$source_pvc" -o jsonpath='{.spec.accessModes[*]}' 2>/dev/null || true)"
  read -r -a access_modes <<<"$access_modes_raw"

  if [[ -z "$storage_request" ]]; then
    echo "Error: failed to derive storage request from ${ns}/${source_pvc}." >&2
    return 1
  fi
  if [[ ${#access_modes[@]} -eq 0 ]]; then
    access_modes=("ReadWriteOnce")
  fi

  {
    echo "apiVersion: v1"
    echo "kind: PersistentVolumeClaim"
    echo "metadata:"
    echo "  name: ${target_pvc}"
    echo "  namespace: ${ns}"
    echo "spec:"
    echo "  accessModes:"
    local mode
    for mode in "${access_modes[@]}"; do
      echo "  - ${mode}"
    done
    if [[ -n "$storage_class" ]]; then
      echo "  storageClassName: ${storage_class}"
    fi
    if [[ -n "$volume_mode" ]]; then
      echo "  volumeMode: ${volume_mode}"
    fi
    echo "  resources:"
    echo "    requests:"
    echo "      storage: ${storage_request}"
  } | kubectl apply -f - >/dev/null

  return 0
}

get_single_ton_statefulset() {
  local -n out_ns="$1"
  local -n out_sts="$2"
  local -n out_replicas="$3"
  local -a rows=()
  local row row_ns row_sts row_replicas count=0

  mapfile -t rows < <(list_ton_statefulsets)
  if [[ ${#rows[@]} -eq 0 || -z "${rows[0]}" ]]; then
    echo "Error: no TON StatefulSets found." >&2
    return 1
  fi

  for row in "${rows[@]}"; do
    [[ -z "$row" ]] && continue
    IFS=$'\t' read -r row_ns row_sts row_replicas <<<"$row"
    [[ -z "$row_ns" || -z "$row_sts" ]] && continue
    out_ns="$row_ns"
    out_sts="$row_sts"
    out_replicas="${row_replicas:-0}"
    ((count+=1))
  done

  if (( count == 1 )); then
    return 0
  fi

  echo "Error: found ${count} TON StatefulSets; add command requires exactly one." >&2
  for row in "${rows[@]}"; do
    [[ -z "$row" ]] && continue
    IFS=$'\t' read -r row_ns row_sts row_replicas <<<"$row"
    echo "  - ${row_ns}/${row_sts} replicas=${row_replicas:-0}" >&2
  done
  return 1
}

resolve_ton_pod_identity() {
  local pod_ref="$1"
  local -n out_ns="$2"
  local -n out_pod="$3"
  local -n out_sts="$4"
  local -n out_ordinal="$5"
  local resolved_ns="" resolved_pod="" resolved_sts="" resolved_ordinal=""
  local owner_sts=""
  local -a matches=()

  out_ns=""
  out_pod=""
  out_sts=""
  out_ordinal=""

  if [[ "$pod_ref" == */* ]]; then
    resolved_ns="${pod_ref%%/*}"
    resolved_pod="${pod_ref##*/}"
    if [[ -z "$resolved_ns" || -z "$resolved_pod" ]]; then
      echo "Error: invalid pod reference '${pod_ref}'. Use <pod-name> or <namespace>/<pod-name>." >&2
      return 1
    fi
    if ! kubectl -n "$resolved_ns" get pod "$resolved_pod" >/dev/null 2>&1; then
      echo "Error: pod ${resolved_ns}/${resolved_pod} not found." >&2
      return 1
    fi
    if ! kubectl -n "$resolved_ns" get pod "$resolved_pod" -l "$TON_POD_LABEL" --ignore-not-found -o name 2>/dev/null | grep -q '^pod/'; then
      echo "Error: pod ${resolved_ns}/${resolved_pod} is not a TON pod (label selector: ${TON_POD_LABEL})." >&2
      return 1
    fi
  else
    mapfile -t matches < <(kubectl get pods -A -l "$TON_POD_LABEL" --field-selector "metadata.name=${pod_ref}" \
      -o jsonpath='{range .items[*]}{.metadata.namespace}{"\t"}{.metadata.name}{"\n"}{end}')
    if [[ ${#matches[@]} -eq 0 || -z "${matches[0]}" ]]; then
      echo "Error: TON pod named '${pod_ref}' not found." >&2
      return 1
    fi
    if (( ${#matches[@]} > 1 )); then
      echo "Error: pod name '${pod_ref}' exists in multiple namespaces. Use namespace/pod format." >&2
      printf '%s\n' "${matches[@]}" | awk 'NF{print "  - "$0}' >&2
      return 1
    fi
    IFS=$'\t' read -r resolved_ns resolved_pod <<<"${matches[0]}"
  fi

  if [[ "$resolved_pod" =~ ^(.+)-([0-9]+)$ ]]; then
    resolved_ordinal="${BASH_REMATCH[2]}"
  else
    echo "Error: pod ${resolved_ns}/${resolved_pod} is not a StatefulSet ordinal pod (<name>-<ordinal>)." >&2
    return 1
  fi

  owner_sts="$(kubectl -n "$resolved_ns" get pod "$resolved_pod" -o jsonpath='{range .metadata.ownerReferences[?(@.kind=="StatefulSet")]}{.name}{end}' 2>/dev/null || true)"
  owner_sts="$(trim_whitespace "$owner_sts")"
  if [[ -z "$owner_sts" ]]; then
    echo "Error: pod ${resolved_ns}/${resolved_pod} is not owned by a StatefulSet." >&2
    return 1
  fi
  resolved_sts="$owner_sts"

  if [[ "$resolved_pod" != "${resolved_sts}-${resolved_ordinal}" ]]; then
    echo "Error: resolved StatefulSet ${resolved_sts} does not match pod name ${resolved_pod}." >&2
    return 1
  fi
  if ! kubectl -n "$resolved_ns" get statefulset "$resolved_sts" >/dev/null 2>&1; then
    echo "Error: StatefulSet ${resolved_ns}/${resolved_sts} not found." >&2
    return 1
  fi

  out_ns="$resolved_ns"
  out_pod="$resolved_pod"
  out_sts="$resolved_sts"
  out_ordinal="$resolved_ordinal"
}

get_annotation_value() {
  local resource="$1"
  local ns="$2"
  local name="$3"
  local key="$4"
  local escaped_key="$key"
  escaped_key="${escaped_key//\\/\\\\}"
  escaped_key="${escaped_key//\"/\\\"}"
  kubectl -n "$ns" get "$resource" "$name" \
    -o "go-template={{if .metadata.annotations}}{{index .metadata.annotations \"${escaped_key}\"}}{{end}}" 2>/dev/null || true
}

json_escape_string() {
  local value="${1:-}"
  value="${value//\\/\\\\}"
  value="${value//\"/\\\"}"
  value="${value//$'\n'/}"
  value="${value//$'\r'/}"
  printf '%s' "$value"
}

json_array_from_values() {
  local -n values_ref="$1"
  local out="" value escaped
  for value in "${values_ref[@]}"; do
    escaped="$(json_escape_string "$value")"
    [[ -n "$out" ]] && out+=","
    out+="\"${escaped}\""
  done
  printf '[%s]' "$out"
}

append_unique_item() {
  local item="$1"
  local -n values_ref="$2"
  local existing
  for existing in "${values_ref[@]}"; do
    if [[ "$existing" == "$item" ]]; then
      return 0
    fi
  done
  values_ref+=("$item")
}

max_positive_replicas() {
  local result=""
  local candidate

  for candidate in "$@"; do
    candidate="$(trim_whitespace "${candidate:-}")"
    if ! [[ "$candidate" =~ ^[1-9][0-9]*$ ]]; then
      continue
    fi
    if [[ -z "$result" ]] || (( candidate > result )); then
      result="$candidate"
    fi
  done

  printf '%s' "$result"
}

build_sts_ordinal_node_map() {
  local ns="$1"
  local sts="$2"
  local replicas="$3"
  local -a pairs=()
  local ordinal pod node_name

  if ! [[ "$replicas" =~ ^[1-9][0-9]*$ ]]; then
    return 0
  fi

  for ordinal in $(seq 0 $((replicas - 1))); do
    pod="${sts}-${ordinal}"
    node_name="$(kubectl -n "$ns" get pod "$pod" -o jsonpath='{.spec.nodeName}' 2>/dev/null || true)"
    node_name="$(trim_whitespace "$node_name")"
    if [[ -z "$node_name" ]]; then
      return 0
    fi
    pairs+=("${ordinal}=${node_name}")
  done

  if [[ ${#pairs[@]} -ne "$replicas" ]]; then
    return 0
  fi

  local IFS=,
  printf '%s' "${pairs[*]}"
}

parse_ordinal_node_map() {
  local mapping="$1"
  local -n out_nodes_ref="$2"
  local -A ordinal_to_node=()
  local -a pairs=()
  local pair ordinal node_name max_ordinal=-1 i

  out_nodes_ref=()
  mapping="$(trim_whitespace "$mapping")"
  [[ -z "$mapping" ]] && return 1

  IFS=',' read -r -a pairs <<<"$mapping"
  for pair in "${pairs[@]}"; do
    pair="$(trim_whitespace "$pair")"
    [[ -z "$pair" ]] && continue
    if [[ "$pair" != *=* ]]; then
      return 1
    fi
    ordinal="$(trim_whitespace "${pair%%=*}")"
    node_name="$(trim_whitespace "${pair#*=}")"
    if ! [[ "$ordinal" =~ ^[0-9]+$ ]]; then
      return 1
    fi
    if [[ -z "$node_name" ]]; then
      return 1
    fi
    ordinal_to_node["$ordinal"]="$node_name"
    if (( ordinal > max_ordinal )); then
      max_ordinal="$ordinal"
    fi
  done

  if (( max_ordinal < 0 )); then
    return 1
  fi

  for i in $(seq 0 "$max_ordinal"); do
    if [[ -z "${ordinal_to_node[$i]:-}" ]]; then
      return 1
    fi
    out_nodes_ref+=("${ordinal_to_node[$i]}")
  done
  return 0
}

set_statefulset_update_strategy() {
  local ns="$1"
  local sts="$2"
  local strategy_type="$3"
  local escaped_strategy
  escaped_strategy="$(json_escape_string "$strategy_type")"

  kubectl -n "$ns" patch statefulset "$sts" --type=merge \
    -p "{\"spec\":{\"updateStrategy\":{\"type\":\"${escaped_strategy}\"}}}" >/dev/null
}

patch_statefulset_hostname_affinity() {
  local ns="$1"
  local sts="$2"
  shift 2
  local -a hostnames=("$@")
  local hostnames_json

  if [[ ${#hostnames[@]} -eq 0 ]]; then
    kubectl -n "$ns" patch statefulset "$sts" --type=merge \
      -p '{"spec":{"template":{"spec":{"affinity":{"nodeAffinity":null}}}}}' >/dev/null
    return 0
  fi

  hostnames_json="$(json_array_from_values hostnames)"
  kubectl -n "$ns" patch statefulset "$sts" --type=merge \
    -p "{\"spec\":{\"template\":{\"spec\":{\"affinity\":{\"nodeAffinity\":{\"requiredDuringSchedulingIgnoredDuringExecution\":{\"nodeSelectorTerms\":[{\"matchExpressions\":[{\"key\":\"kubernetes.io/hostname\",\"operator\":\"In\",\"values\":${hostnames_json}}]}]}}}}}}}" >/dev/null
}

node_hostname_value() {
  local node="$1"
  local hostname

  node="$(trim_whitespace "$node")"
  [[ -n "$node" ]] || return 1
  hostname="$(kubectl get node "$node" -o go-template='{{ index .metadata.labels "kubernetes.io/hostname" }}' 2>/dev/null || true)"
  hostname="$(trim_whitespace "$hostname")"
  [[ -n "$hostname" ]] || hostname="$node"
  printf '%s' "$hostname"
}

statefulset_template_hostname_affinity_values() {
  local ns="$1"
  local sts="$2"

  kubectl -n "$ns" get statefulset "$sts" \
    -o jsonpath='{range .spec.template.spec.affinity.nodeAffinity.requiredDuringSchedulingIgnoredDuringExecution.nodeSelectorTerms[*].matchExpressions[?(@.key=="kubernetes.io/hostname")].values[*]}{.}{"\n"}{end}' 2>/dev/null \
    | awk 'NF' \
    | sort -u
}

statefulset_node_selector_string() {
  local ns="$1"
  local sts="$2"
  local selector=""
  local pair

  while IFS= read -r pair; do
    pair="$(trim_whitespace "$pair")"
    [[ -z "$pair" ]] && continue
    if [[ -n "$selector" ]]; then
      selector+=","
    fi
    selector+="$pair"
  done < <(
    kubectl -n "$ns" get statefulset "$sts" \
      -o go-template='{{range $k,$v := .spec.template.spec.nodeSelector}}{{printf "%s=%s\n" $k $v}}{{end}}' 2>/dev/null || true
  )

  printf '%s' "$selector"
}

list_schedulable_nodes_for_statefulset() {
  local ns="$1"
  local sts="$2"
  local selector

  selector="$(statefulset_node_selector_string "$ns" "$sts")"
  selector="$(trim_whitespace "$selector")"
  if [[ -n "$selector" ]]; then
    list_schedulable_nodes_by_selector "$selector"
    return 0
  fi

  kubectl get nodes -o jsonpath='{range .items[*]}{.metadata.name}{"\t"}{.spec.unschedulable}{"\n"}{end}' 2>/dev/null \
    | awk -F'\t' '$2!="true"{print $1}' \
    | awk 'NF' \
    | sort -u
}

node_matches_statefulset_selector() {
  local node="$1"
  local ns="$2"
  local sts="$3"
  local selector

  node="$(trim_whitespace "$node")"
  [[ -n "$node" ]] || return 1
  selector="$(statefulset_node_selector_string "$ns" "$sts")"
  selector="$(trim_whitespace "$selector")"
  if [[ -z "$selector" ]]; then
    return 0
  fi
  kubectl get node "$node" -l "$selector" >/dev/null 2>&1
}

collect_pv_hostname_affinity_nodes() {
  local pv="$1"
  local -n nodes_ref="$2"
  local node resolved_node

  pv="$(trim_whitespace "$pv")"
  [[ -n "$pv" ]] || return 0
  while IFS= read -r node; do
    node="$(trim_whitespace "$node")"
    [[ -z "$node" ]] && continue
    resolved_node="$(resolve_node_name_for_hostname_value "$node" || true)"
    resolved_node="$(trim_whitespace "$resolved_node")"
    [[ -z "$resolved_node" ]] && continue
    append_unique_item "$resolved_node" nodes_ref
  done < <(
    kubectl get pv "$pv" \
      -o jsonpath='{range .spec.nodeAffinity.required.nodeSelectorTerms[*].matchExpressions[?(@.key=="kubernetes.io/hostname")].values[*]}{.}{"\n"}{end}' 2>/dev/null || true
  )
}

diagnose_pending_ton_local_pvc_conflicts() {
  local ns="$1"
  local sts="$2"
  local -n pending_ordinals_ref="$3"
  local -A running_pods_by_node=()
  local -a ordinal_pv_nodes=()
  local other_ns other_pod phase node ordinal claim_prefix pvc pv pv_node selector occupied
  local failed=0

  while IFS=$'\t' read -r other_ns other_pod phase node; do
    other_ns="$(trim_whitespace "$other_ns")"
    other_pod="$(trim_whitespace "$other_pod")"
    phase="$(trim_whitespace "$phase")"
    node="$(trim_whitespace "$node")"
    [[ -n "$other_ns" && -n "$other_pod" && "$phase" == "Running" && -n "$node" ]] || continue
    running_pods_by_node["$node"]="${running_pods_by_node[$node]:-}${other_ns}/${other_pod} "
  done < <(
    kubectl get pods -A -l "$TON_POD_LABEL" \
      -o jsonpath='{range .items[*]}{.metadata.namespace}{"\t"}{.metadata.name}{"\t"}{.status.phase}{"\t"}{.spec.nodeName}{"\n"}{end}' 2>/dev/null || true
  )

  for ordinal in "${pending_ordinals_ref[@]}"; do
    ordinal="$(trim_whitespace "$ordinal")"
    [[ "$ordinal" =~ ^[0-9]+$ ]] || continue
    ordinal_pv_nodes=()

    for claim_prefix in ton-work ton-src mytoncore mytonctrl keybundle; do
      pvc="${claim_prefix}-${sts}-${ordinal}"
      pv="$(kubectl -n "$ns" get pvc "$pvc" -o jsonpath='{.spec.volumeName}' 2>/dev/null || true)"
      pv="$(trim_whitespace "$pv")"
      [[ -n "$pv" ]] || continue
      collect_pv_hostname_affinity_nodes "$pv" ordinal_pv_nodes
    done

    if (( ${#ordinal_pv_nodes[@]} > 1 )); then
      echo "Error: ${ns}/${sts}-${ordinal} has local PVCs pinned to different nodes: ${ordinal_pv_nodes[*]}." >&2
      echo "Kubernetes cannot schedule this pod until the PVCs are recreated or data is migrated to one node." >&2
      failed=1
      continue
    fi

    for pv_node in "${ordinal_pv_nodes[@]}"; do
      pv_node="$(trim_whitespace "$pv_node")"
      [[ -n "$pv_node" ]] || continue
      if ! node_matches_statefulset_selector "$pv_node" "$ns" "$sts"; then
        selector="$(statefulset_node_selector_string "$ns" "$sts")"
        echo "Error: ${ns}/${sts}-${ordinal} has a local PVC pinned to node ${pv_node}, but the StatefulSet nodeSelector '${selector:-<none>}' excludes that node." >&2
        echo "Fix by adding the required label to ${pv_node}, changing the TonNode nodeSelector, or recreating/migrating that PVC." >&2
        failed=1
      fi

      occupied="$(trim_whitespace "${running_pods_by_node[$pv_node]:-}")"
      if [[ -n "$occupied" ]]; then
        echo "Error: ${ns}/${sts}-${ordinal} has local-path PVC(s) pinned to ${pv_node}, but TON pod(s) already run there: ${occupied}." >&2
        echo "Because TON pods use hostPorts, Kubernetes cannot place another TON pod on that node." >&2
        echo "If ${ns}/${sts}-${ordinal} never started and has no data, keep keybundle-${sts}-${ordinal} and recreate only its local-path PVCs:" >&2
        echo "  kubectl -n ${ns} delete pod ${sts}-${ordinal} --ignore-not-found --wait=false" >&2
        echo "  kubectl -n ${ns} delete pvc ton-work-${sts}-${ordinal} ton-src-${sts}-${ordinal} mytoncore-${sts}-${ordinal} mytonctrl-${sts}-${ordinal} --wait=false" >&2
        failed=1
      fi
    done
  done

  (( failed == 0 ))
}

delete_unscheduled_statefulset_pods_for_start() {
  local ns="$1"
  local sts="$2"
  local pod phase node_name deletion_ts ordinal

  while IFS=$'\t' read -r pod phase node_name deletion_ts; do
    pod="$(trim_whitespace "$pod")"
    phase="$(trim_whitespace "$phase")"
    node_name="$(trim_whitespace "$node_name")"
    deletion_ts="$(trim_whitespace "$deletion_ts")"
    [[ -n "$pod" ]] || continue
    [[ "$pod" == "${sts}-"* ]] || continue
    ordinal="${pod#"${sts}-"}"
    [[ "$ordinal" =~ ^[0-9]+$ ]] || continue
    [[ "$phase" == "Pending" && -z "$node_name" && -z "$deletion_ts" ]] || continue

    echo "[start] Deleting unscheduled Pending pod ${ns}/${pod} so it can be recreated with current StatefulSet placement."
    kubectl -n "$ns" delete pod "$pod" --ignore-not-found --wait=false >/dev/null 2>&1 || true
  done < <(
    kubectl -n "$ns" get pods \
      -o jsonpath='{range .items[*]}{.metadata.name}{"\t"}{.status.phase}{"\t"}{.spec.nodeName}{"\t"}{.metadata.deletionTimestamp}{"\n"}{end}' 2>/dev/null || true
  )
}

repair_pending_ton_placement_after_start() {
  local -a sts_rows=()
  local -a operator_deploy_names=()
  local -a operator_deploy_replicas=()
  local operator_paused=0
  local row ns sts replicas pod phase node_name deletion_ts ordinal
  local pv pvc claim_prefix pv_node hostname node selector
  local repaired=0
  local skipped=0
  local failed=0
  local current_count
  local sts_failed
  local -a pending_ordinals=()
  local -a current_hostnames=()
  local -a final_hostnames=()
  local -a eligible_nodes=()
  local -a pv_nodes=()
  local -a ordinal_pv_nodes=()

  mapfile -t sts_rows < <(list_ton_statefulsets 2>/dev/null || true)
  if [[ ${#sts_rows[@]} -eq 0 || -z "${sts_rows[0]:-}" ]]; then
    return 0
  fi

  for row in "${sts_rows[@]}"; do
    [[ -z "$row" ]] && continue
    IFS=$'\t' read -r ns sts replicas <<<"$row"
    ns="$(trim_whitespace "$ns")"
    sts="$(trim_whitespace "$sts")"
    replicas="$(trim_whitespace "${replicas:-0}")"
    [[ -n "$ns" && -n "$sts" ]] || continue
    if ! [[ "$replicas" =~ ^[1-9][0-9]*$ ]]; then
      continue
    fi

    pending_ordinals=()
    while IFS=$'\t' read -r pod phase node_name deletion_ts; do
      pod="$(trim_whitespace "$pod")"
      phase="$(trim_whitespace "$phase")"
      node_name="$(trim_whitespace "$node_name")"
      deletion_ts="$(trim_whitespace "$deletion_ts")"
      [[ "$pod" == "${sts}-"* ]] || continue
      ordinal="${pod#"${sts}-"}"
      [[ "$ordinal" =~ ^[0-9]+$ ]] || continue
      [[ "$phase" == "Pending" && -z "$node_name" && -z "$deletion_ts" ]] || continue
      pending_ordinals+=("$ordinal")
    done < <(
      kubectl -n "$ns" get pods \
        -o jsonpath='{range .items[*]}{.metadata.name}{"\t"}{.status.phase}{"\t"}{.spec.nodeName}{"\t"}{.metadata.deletionTimestamp}{"\n"}{end}' 2>/dev/null || true
    )

    if (( ${#pending_ordinals[@]} == 0 )); then
      continue
    fi
    if ! diagnose_pending_ton_local_pvc_conflicts "$ns" "$sts" pending_ordinals; then
      ((failed+=1))
      continue
    fi

    mapfile -t current_hostnames < <(statefulset_template_hostname_affinity_values "$ns" "$sts")
    current_count="${#current_hostnames[@]}"
    if (( current_count == 0 )); then
      ((skipped+=1))
      continue
    fi
    if (( current_count >= replicas )); then
      ((skipped+=1))
      continue
    fi

    final_hostnames=()
    sts_failed=0
    for hostname in "${current_hostnames[@]}"; do
      hostname="$(trim_whitespace "$hostname")"
      [[ -z "$hostname" ]] && continue
      append_unique_item "$hostname" final_hostnames
    done

    pv_nodes=()
    for ordinal in "${pending_ordinals[@]}"; do
      ordinal_pv_nodes=()
      for claim_prefix in ton-work ton-src mytoncore mytonctrl keybundle; do
        pvc="${claim_prefix}-${sts}-${ordinal}"
        pv="$(kubectl -n "$ns" get pvc "$pvc" -o jsonpath='{.spec.volumeName}' 2>/dev/null || true)"
        pv="$(trim_whitespace "$pv")"
        [[ -n "$pv" ]] || continue
        collect_pv_hostname_affinity_nodes "$pv" ordinal_pv_nodes
      done

      if (( ${#ordinal_pv_nodes[@]} > 1 )); then
        echo "Error: ${ns}/${sts}-${ordinal} has local PVCs pinned to different nodes: ${ordinal_pv_nodes[*]}. Kubernetes cannot schedule this pod until the PVCs are recreated or data is migrated to one node." >&2
        sts_failed=1
        continue
      fi

      for pv_node in "${ordinal_pv_nodes[@]}"; do
        pv_node="$(trim_whitespace "$pv_node")"
        [[ -n "$pv_node" ]] || continue
        if ! node_matches_statefulset_selector "$pv_node" "$ns" "$sts"; then
          selector="$(statefulset_node_selector_string "$ns" "$sts")"
          echo "Error: ${ns}/${sts}-${ordinal} has a local PVC pinned to node ${pv_node}, but the StatefulSet nodeSelector '${selector:-<none>}' excludes that node." >&2
          echo "Fix by adding the required label to ${pv_node}, changing the TonNode nodeSelector, or recreating/migrating that PVC." >&2
          sts_failed=1
          continue
        fi
        append_unique_item "$pv_node" pv_nodes
        hostname="$(node_hostname_value "$pv_node" || true)"
        hostname="$(trim_whitespace "$hostname")"
        [[ -n "$hostname" ]] && append_unique_item "$hostname" final_hostnames
      done
    done

    if (( sts_failed > 0 )); then
      ((failed+=1))
      continue
    fi

    mapfile -t eligible_nodes < <(list_schedulable_nodes_for_statefulset "$ns" "$sts")
    for node in "${eligible_nodes[@]}"; do
      node="$(trim_whitespace "$node")"
      [[ -n "$node" ]] || continue
      hostname="$(node_hostname_value "$node" || true)"
      hostname="$(trim_whitespace "$hostname")"
      [[ -n "$hostname" ]] && append_unique_item "$hostname" final_hostnames
    done

    if (( ${#final_hostnames[@]} <= current_count )); then
      echo "Warning: ${ns}/${sts} has ${#pending_ordinals[@]} unscheduled Pending pod(s), but kubeton could not expand stale node affinity." >&2
      ((skipped+=1))
      continue
    fi

    if (( operator_paused == 0 )); then
      pause_operator_reconcile operator_deploy_names operator_deploy_replicas
      operator_paused=1
    fi

    echo "[start] Expanding stale TON node affinity for ${ns}/${sts} from ${current_count} to ${#final_hostnames[@]} host(s); recreating unscheduled Pending pod(s): ${pending_ordinals[*]}."
    set_statefulset_update_strategy "$ns" "$sts" "OnDelete" || {
      ((failed+=1))
      continue
    }
    patch_statefulset_hostname_affinity "$ns" "$sts" "${final_hostnames[@]}" || {
      ((failed+=1))
      continue
    }
    kubectl -n "$ns" patch statefulset "$sts" --type=merge \
      -p "{\"metadata\":{\"annotations\":{\"${STICKY_ORDINAL_NODE_MAP_ANNOTATION_KEY}\":null}}}" >/dev/null 2>&1 || true
    delete_unscheduled_statefulset_pods_for_start "$ns" "$sts" || true
    ((repaired+=1))
  done

  if (( operator_paused == 1 )); then
    resume_operator_reconcile operator_deploy_names operator_deploy_replicas
  fi

  if (( repaired > 0 || skipped > 0 || failed > 0 )); then
    echo "Pending TON placement repair summary: repaired=${repaired}, skipped=${skipped}, failed=${failed}"
  fi
  if (( failed > 0 )); then
    return 1
  fi
  return 0
}

clear_statefulset_sticky_placement_for_start() {
  local ns="$1"
  local sts="$2"

  patch_statefulset_hostname_affinity "$ns" "$sts" >/dev/null 2>&1 || true
  kubectl -n "$ns" patch statefulset "$sts" --type=merge \
    -p "{\"metadata\":{\"annotations\":{\"${STICKY_ORDINAL_NODE_MAP_ANNOTATION_KEY}\":null}}}" >/dev/null 2>&1 || true
  delete_unscheduled_statefulset_pods_for_start "$ns" "$sts" || true
}

ensure_statefulset_parallel_pod_management_for_start() {
  local ns="$1"
  local sts="$2"
  local policy replicas new_policy

  policy="$(kubectl -n "$ns" get statefulset "$sts" -o jsonpath='{.spec.podManagementPolicy}' 2>/dev/null || true)"
  policy="$(trim_whitespace "$policy")"
  if [[ -z "$policy" || "$policy" == "Parallel" ]]; then
    return 0
  fi

  replicas="$(kubectl -n "$ns" get statefulset "$sts" -o jsonpath='{.spec.replicas}' 2>/dev/null || true)"
  replicas="$(trim_whitespace "$replicas")"
  if ! [[ "$replicas" =~ ^[0-9]+$ ]]; then
    replicas=0
  fi
  if (( replicas != 0 )); then
    echo "Warning: StatefulSet ${ns}/${sts} uses podManagementPolicy=${policy}; it can be converted to Parallel only while replicas=0." >&2
    return 0
  fi
  if ! kubectl -n "$ns" get tonnodes.ton.ton.org "$sts" >/dev/null 2>&1; then
    echo "Warning: StatefulSet ${ns}/${sts} uses podManagementPolicy=${policy}, but no TonNode exists to recreate it; leaving it unchanged." >&2
    return 0
  fi

  echo "[start] Recreating stopped StatefulSet ${ns}/${sts} to enable Parallel pod management."
  kubectl -n "$ns" delete statefulset "$sts" --cascade=orphan --wait=true --timeout=120s >/dev/null || return 1
  wait_statefulset_present "$ns" "$sts" 300 || return 1

  new_policy="$(kubectl -n "$ns" get statefulset "$sts" -o jsonpath='{.spec.podManagementPolicy}' 2>/dev/null || true)"
  new_policy="$(trim_whitespace "$new_policy")"
  if [[ "$new_policy" != "Parallel" ]]; then
    echo "Warning: recreated StatefulSet ${ns}/${sts} still uses podManagementPolicy=${new_policy:-unknown}; ensure the running operator image includes Parallel StatefulSet support." >&2
  fi
}

statefulset_has_claim_template() {
  local ns="$1"
  local sts="$2"
  local claim_name="$3"

  kubectl -n "$ns" get statefulset "$sts" \
    -o jsonpath='{range .spec.volumeClaimTemplates[*]}{.metadata.name}{"\n"}{end}' 2>/dev/null \
    | grep -Fxq "$claim_name"
}

recreate_stopped_statefulsets_missing_dedicated_pvcs() {
  local -a sts_rows=()
  local row ns sts replicas
  local recreated=0
  local skipped=0

  mapfile -t sts_rows < <(list_ton_statefulsets 2>/dev/null || true)
  for row in "${sts_rows[@]}"; do
    [[ -z "$row" ]] && continue
    IFS=$'\t' read -r ns sts replicas <<<"$row"
    [[ -n "$ns" && -n "$sts" ]] || continue
    if statefulset_has_claim_template "$ns" "$sts" "ton-src" && statefulset_has_claim_template "$ns" "$sts" "mytonctrl"; then
      continue
    fi
    replicas="$(trim_whitespace "${replicas:-}")"
    if ! [[ "$replicas" =~ ^[0-9]+$ ]]; then
      echo "Warning: StatefulSet ${ns}/${sts} is missing dedicated ton-src/mytonctrl PVC templates, but kubeton cannot read replicas; leaving it unchanged." >&2
      ((skipped+=1))
      continue
    fi
    if (( replicas != 0 )); then
      echo "Warning: StatefulSet ${ns}/${sts} is missing dedicated ton-src/mytonctrl PVC templates, but replicas=${replicas}; it can only be recreated while stopped." >&2
      ((skipped+=1))
      continue
    fi

    echo "[start] Recreating stopped StatefulSet ${ns}/${sts} to add dedicated ton-src and mytonctrl PVC templates."
    kubectl -n "$ns" delete statefulset "$sts" --cascade=orphan --wait=true --timeout=120s >/dev/null || return 1
    wait_statefulset_present "$ns" "$sts" 300 || return 1
    ((recreated+=1))
  done

  if (( recreated > 0 || skipped > 0 )); then
    echo "[start] Dedicated PVC template migration summary: recreated=${recreated}, skipped=${skipped}"
  fi
}

preapply_stopped_node_mapping_for_statefulset() {
  local ns="$1"
  local sts="$2"
  local target_replicas="$3"
  local node_map escaped_node_map
  local -a expected_nodes=()
  local -a final_nodes=()

  if ! [[ "$target_replicas" =~ ^[1-9][0-9]*$ ]]; then
    return 0
  fi

  node_map="$(get_stopped_node_map_annotation "$ns" "$sts")"
  node_map="$(trim_whitespace "$node_map")"
  if [[ -z "$node_map" ]]; then
    clear_statefulset_sticky_placement_for_start "$ns" "$sts"
    return 0
  fi
  if ! parse_ordinal_node_map "$node_map" expected_nodes; then
    echo "Warning: invalid ${KUBETON_PAUSE_NODEMAP_ANNOTATION_KEY} on ${ns}/${sts}; cannot preapply stopped placement." >&2
    clear_statefulset_sticky_placement_for_start "$ns" "$sts"
    return 0
  fi
  if (( ${#expected_nodes[@]} < target_replicas )); then
    echo "Warning: ${KUBETON_PAUSE_NODEMAP_ANNOTATION_KEY} has ${#expected_nodes[@]} entries but target replicas=${target_replicas} on ${ns}/${sts}; cannot preapply stopped placement." >&2
    clear_statefulset_sticky_placement_for_start "$ns" "$sts"
    return 0
  fi

  ensure_statefulset_parallel_pod_management_for_start "$ns" "$sts" || return 1

  mapfile -t final_nodes < <(printf '%s\n' "${expected_nodes[@]:0:$target_replicas}" | awk 'NF' | sort -u)
  if (( ${#final_nodes[@]} == 0 )); then
    return 0
  fi

  echo "[start] Pre-applying stopped ordinal node map for ${ns}/${sts}: ${node_map}"
  patch_statefulset_hostname_affinity "$ns" "$sts" "${final_nodes[@]}" || return 1
  escaped_node_map="$(json_escape_string "$node_map")"
  kubectl -n "$ns" patch statefulset "$sts" --type=merge \
    -p "{\"metadata\":{\"annotations\":{\"${STICKY_ORDINAL_NODE_MAP_ANNOTATION_KEY}\":\"${escaped_node_map}\"}},\"spec\":{\"updateStrategy\":{\"type\":\"RollingUpdate\"}}}" >/dev/null || return 1
}

get_stopped_node_map_annotation() {
  local ns="$1"
  local sts="$2"
  local value=""

  if kubectl -n "$ns" get tonnodes.ton.ton.org "$sts" >/dev/null 2>&1; then
    value="$(get_annotation_value tonnodes.ton.ton.org "$ns" "$sts" "$KUBETON_PAUSE_NODEMAP_ANNOTATION_KEY")"
    value="$(trim_whitespace "$value")"
    if [[ -n "$value" ]]; then
      printf '%s' "$value"
      return 0
    fi
  fi

  value="$(get_annotation_value statefulset "$ns" "$sts" "$KUBETON_PAUSE_NODEMAP_ANNOTATION_KEY")"
  value="$(trim_whitespace "$value")"
  printf '%s' "$value"
}

clear_stopped_node_map_annotation() {
  local ns="$1"
  local sts="$2"
  if kubectl -n "$ns" get tonnodes.ton.ton.org "$sts" >/dev/null 2>&1; then
    kubectl -n "$ns" patch tonnodes.ton.ton.org "$sts" --type=merge \
      -p "{\"metadata\":{\"annotations\":{\"${KUBETON_PAUSE_NODEMAP_ANNOTATION_KEY}\":null}}}" >/dev/null 2>&1 || true
  fi
  kubectl -n "$ns" patch statefulset "$sts" --type=merge \
    -p "{\"metadata\":{\"annotations\":{\"${KUBETON_PAUSE_NODEMAP_ANNOTATION_KEY}\":null}}}" >/dev/null 2>&1 || true
}

clear_statefulset_pause_annotation() {
  local ns="$1"
  local sts="$2"
  kubectl -n "$ns" patch statefulset "$sts" --type=merge \
    -p "{\"metadata\":{\"annotations\":{\"${KUBETON_PAUSE_ANNOTATION_KEY}\":null}}}" >/dev/null 2>&1 || true
}

statefulset_matches_expected_nodes() {
  local ns="$1"
  local sts="$2"
  local -n expected_nodes_ref="$3"
  local ordinal pod current_node

  if [[ ${#expected_nodes_ref[@]} -eq 0 ]]; then
    return 1
  fi

  for ordinal in "${!expected_nodes_ref[@]}"; do
    pod="${sts}-${ordinal}"
    current_node="$(kubectl -n "$ns" get pod "$pod" -o jsonpath='{.spec.nodeName}' 2>/dev/null || true)"
    current_node="$(trim_whitespace "$current_node")"
    if [[ "$current_node" != "${expected_nodes_ref[$ordinal]}" ]]; then
      return 1
    fi
  done

  return 0
}

restore_statefulset_with_expected_nodes() {
  local ns="$1"
  local sts="$2"
  local target_replicas="$3"
  local -n expected_nodes_ref="$4"
  local -a allowed_nodes=()
  local -a final_nodes=()
  local ordinal pod expected_node current_node

  if ! [[ "$target_replicas" =~ ^[1-9][0-9]*$ ]]; then
    return 1
  fi
  if (( ${#expected_nodes_ref[@]} < target_replicas )); then
    return 1
  fi

  set_statefulset_update_strategy "$ns" "$sts" "OnDelete" || return 1
  set_ton_replicas "$ns" "$sts" 0 || return 1
  wait_statefulset_pods_gone "$ns" "$sts" || return 1

  for ordinal in $(seq 0 $((target_replicas - 1))); do
    expected_node="${expected_nodes_ref[$ordinal]}"
    append_unique_item "$expected_node" allowed_nodes
    patch_statefulset_hostname_affinity "$ns" "$sts" "${allowed_nodes[@]}" || return 1
    set_ton_replicas "$ns" "$sts" $((ordinal + 1)) || return 1
    pod="${sts}-${ordinal}"
    wait_pod_ready "$ns" "$pod" 1800 || return 1
    current_node="$(kubectl -n "$ns" get pod "$pod" -o jsonpath='{.spec.nodeName}' 2>/dev/null || true)"
    current_node="$(trim_whitespace "$current_node")"
    if [[ "$current_node" != "$expected_node" ]]; then
      echo "Error: ${ns}/${pod} expected node ${expected_node} but landed on ${current_node:-unknown}." >&2
      return 1
    fi
  done

  mapfile -t final_nodes < <(printf '%s\n' "${expected_nodes_ref[@]:0:$target_replicas}" | awk 'NF' | sort -u)
  patch_statefulset_hostname_affinity "$ns" "$sts" "${final_nodes[@]}" || true
  set_statefulset_update_strategy "$ns" "$sts" "RollingUpdate" || true
  return 0
}

enforce_stopped_node_mappings_after_start() {
  local -a sts_rows=()
  local -a operator_deploy_names=()
  local -a operator_deploy_replicas=()
  local operator_paused=0
  local row ns sts replicas node_map
  local remapped=0
  local unchanged=0
  local skipped=0
  local failed=0

  mapfile -t sts_rows < <(list_ton_statefulsets)
  if [[ ${#sts_rows[@]} -eq 0 || -z "${sts_rows[0]}" ]]; then
    return 0
  fi

  for row in "${sts_rows[@]}"; do
    [[ -z "$row" ]] && continue
    IFS=$'\t' read -r ns sts replicas <<<"$row"
    if [[ -z "$ns" || -z "$sts" ]]; then
      continue
    fi
    if ! [[ "$replicas" =~ ^[1-9][0-9]*$ ]]; then
      clear_stopped_node_map_annotation "$ns" "$sts"
      continue
    fi

    node_map="$(get_stopped_node_map_annotation "$ns" "$sts")"
    node_map="$(trim_whitespace "$node_map")"
    if [[ -z "$node_map" ]]; then
      continue
    fi

    local -a expected_nodes=()
    if ! parse_ordinal_node_map "$node_map" expected_nodes; then
      echo "Warning: invalid ${KUBETON_PAUSE_NODEMAP_ANNOTATION_KEY} on ${ns}/${sts}; skipping strict node restore." >&2
      ((skipped+=1))
      clear_stopped_node_map_annotation "$ns" "$sts"
      continue
    fi
    if (( ${#expected_nodes[@]} < replicas )); then
      echo "Warning: ${KUBETON_PAUSE_NODEMAP_ANNOTATION_KEY} has ${#expected_nodes[@]} entries but replicas=${replicas} on ${ns}/${sts}; skipping strict node restore." >&2
      ((skipped+=1))
      clear_stopped_node_map_annotation "$ns" "$sts"
      continue
    fi

    if statefulset_matches_expected_nodes "$ns" "$sts" expected_nodes; then
      ((unchanged+=1))
      clear_stopped_node_map_annotation "$ns" "$sts"
      continue
    fi

    if (( operator_paused == 0 )); then
      pause_operator_reconcile operator_deploy_names operator_deploy_replicas
      operator_paused=1
    fi

    echo "Restoring strict ordinal->node placement for ${ns}/${sts} ..."
    if restore_statefulset_with_expected_nodes "$ns" "$sts" "$replicas" expected_nodes; then
      ((remapped+=1))
      clear_stopped_node_map_annotation "$ns" "$sts"
    else
      echo "Error: failed strict node restore for ${ns}/${sts}." >&2
      ((failed+=1))
    fi
  done

  if (( operator_paused == 1 )); then
    resume_operator_reconcile operator_deploy_names operator_deploy_replicas
  fi

  if (( remapped > 0 || unchanged > 0 || skipped > 0 || failed > 0 )); then
    echo "Start node placement summary: remapped=${remapped}, already_matched=${unchanged}, skipped=${skipped}, failed=${failed}"
  fi
  return 0
}

run_add() {
  require_bin kubectl
  local ns="" sts="" replicas=""
  local new_ordinal new_replicas
  local new_pod node_name target_pvc
  local -a claim_prefixes=("ton-work" "ton-src" "mytoncore" "mytonctrl" "keybundle")
  local -a prepared_pvcs=()
  local claim_prefix pvc pv

  if [[ $# -ne 0 ]]; then
    echo "Error: usage: kubeton add" >&2
    exit 1
  fi

  get_single_ton_statefulset ns sts replicas || exit 1
  if ! [[ "$replicas" =~ ^[0-9]+$ ]]; then
    echo "Error: invalid replicas value for ${ns}/${sts}: ${replicas}" >&2
    exit 1
  fi

  new_replicas=$((replicas + 1))
  KUBETON_TARGET_TON_REPLICAS="$new_replicas"

  if should_bootstrap_baremetal; then
    ensure_auto_bootstrap_stack_if_needed
  fi
  validate_external_key_prereqs

  new_ordinal="$replicas"
  new_pod="${sts}-${new_ordinal}"
  if kubectl -n "$ns" get pod "$new_pod" >/dev/null 2>&1; then
    echo "Error: target pod ${ns}/${new_pod} already exists; cluster is not in expected pre-add state." >&2
    exit 1
  fi

  for claim_prefix in "${claim_prefixes[@]}"; do
    target_pvc="${claim_prefix}-${sts}-${new_ordinal}"
    reset_add_target_pvc_if_exists "$ns" "$target_pvc" || {
      echo "Error: failed to reset leftover PVC ${ns}/${target_pvc} before add." >&2
      exit 1
    }
  done

  echo "Preparing PVCs for new replica ${ns}/${sts}-${new_ordinal} ..."
  for claim_prefix in "${claim_prefixes[@]}"; do
    if create_replica_pvc_from_ordinal0 "$ns" "$sts" "$claim_prefix" "$new_ordinal"; then
      prepared_pvcs+=("${claim_prefix}-${sts}-${new_ordinal}")
    else
      case "$?" in
        10)
          ;;
        *)
          echo "Error: failed to prepare PVC for claim prefix ${claim_prefix}." >&2
          exit 1
          ;;
      esac
    fi
  done

  for pvc in "${prepared_pvcs[@]}"; do
    if pvc_uses_wait_for_first_consumer "$ns" "$pvc"; then
      echo "PVC ${ns}/${pvc} uses WaitForFirstConsumer; skipping pre-scale Bound wait."
    else
      wait_pvc_bound "$ns" "$pvc" 300
    fi
    pv="$(kubectl -n "$ns" get pvc "$pvc" -o jsonpath='{.spec.volumeName}' 2>/dev/null || true)"
    if [[ -n "$pv" ]]; then
      kubectl -n "$LONGHORN_NAMESPACE" get volumes.longhorn.io "$pv" >/dev/null 2>&1 || true
    fi
  done

  echo "Scaling ${ns}/${sts} from ${replicas} to ${new_replicas} ..."
  if kubectl -n "$ns" get tonnodes.ton.ton.org "$sts" >/dev/null 2>&1; then
    kubectl -n "$ns" patch tonnodes.ton.ton.org "$sts" --field-manager=helm --type=merge -p "{\"spec\":{\"replicas\":${new_replicas}}}" >/dev/null
  else
    set_ton_replicas "$ns" "$sts" "$new_replicas"
  fi

  echo "Waiting for ${ns}/${new_pod} to become Ready ..."
  wait_pod_ready "$ns" "$new_pod" 1200

  node_name="$(kubectl -n "$ns" get pod "$new_pod" -o jsonpath='{.spec.nodeName}' 2>/dev/null || true)"
  [[ -z "$node_name" ]] && node_name="N/A"
  echo "Added TON replica: ${ns}/${new_pod} on node ${node_name}."
  echo "Next step: execute ./kubeton backup-keys"
}

run_del() {
  require_bin kubectl
  if [[ $# -ne 0 ]]; then
    echo "Error: kubeton del does not take a pod name; it always removes the tail replica (highest ordinal)." >&2
    echo "Error: usage: kubeton del" >&2
    exit 1
  fi

  local ns sts replicas ordinal pod
  local -a claim_prefixes=("ton-work" "ton-src" "mytoncore" "mytonctrl" "keybundle")
  local -a pvc_names=()
  local -a pv_names=()
  local claim_prefix pvc pv

  get_single_ton_statefulset ns sts replicas || exit 1

  replicas="$(kubectl -n "$ns" get statefulset "$sts" -o jsonpath='{.spec.replicas}' 2>/dev/null || true)"
  if ! [[ "$replicas" =~ ^[0-9]+$ ]]; then
    echo "Error: cannot read replicas for ${ns}/${sts}." >&2
    exit 1
  fi
  if (( replicas <= 0 )); then
    echo "Error: StatefulSet ${ns}/${sts} has no replicas to delete." >&2
    exit 1
  fi

  ordinal=$((replicas - 1))
  pod="${sts}-${ordinal}"

  confirm_or_exit "This will remove the tail TON replica ${ns}/${pod}, delete its PVC/PV (including Longhorn volume if present), and scale ${sts} to $((replicas - 1)). Continue?"

  for claim_prefix in "${claim_prefixes[@]}"; do
    pvc="${claim_prefix}-${sts}-${ordinal}"
    pvc_names+=("$pvc")
    pv="$(kubectl -n "$ns" get pvc "$pvc" -o jsonpath='{.spec.volumeName}' 2>/dev/null || true)"
    if [[ -n "$pv" ]]; then
      pv_names+=("$pv")
    fi
  done

  echo "Scaling ${ns}/${sts} from ${replicas} to $((replicas - 1)) ..."
  if kubectl -n "$ns" get tonnodes.ton.ton.org "$sts" >/dev/null 2>&1; then
    kubectl -n "$ns" patch tonnodes.ton.ton.org "$sts" --field-manager=helm --type=merge -p "{\"spec\":{\"replicas\":$((replicas - 1))}}" >/dev/null
  else
    set_ton_replicas "$ns" "$sts" "$((replicas - 1))"
  fi
  wait_pod_gone "$ns" "$pod" 600 || true

  echo "Deleting PVCs for ${ns}/${pod} ..."
  for pvc in "${pvc_names[@]}"; do
    kubectl -n "$ns" delete pvc "$pvc" --ignore-not-found --wait=false >/dev/null 2>&1 || true
  done

  if [[ ${#pv_names[@]} -gt 0 ]]; then
    echo "Deleting PV and Longhorn volume resources ..."
  fi
  for pv in "${pv_names[@]}"; do
    kubectl delete pv "$pv" --ignore-not-found --wait=false >/dev/null 2>&1 || true
    kubectl -n "$LONGHORN_NAMESPACE" delete volumes.longhorn.io "$pv" --ignore-not-found --wait=false >/dev/null 2>&1 || true
  done

  echo "Replica ${ns}/${pod} deleted."
}

run_recreate() {
  require_bin kubectl
  require_bin sha256sum

  if [[ $# -ne 2 ]]; then
    echo "Error: usage: kubeton recreate <pod-name|namespace/pod-name> <backup-dir>" >&2
    exit 1
  fi

  local pod_ref="$1"
  local input_dir="$2"
  local ns="" pod="" sts="" ordinal=""
  local replicas=""
  local pvc_ton_work pvc_ton_src pvc_mytoncore pvc_mytonctrl pvc_keybundle
  local pv_ton_work="" pv_ton_src="" pv_mytoncore="" pv_mytonctrl=""
  local item_dir bundle_dir
  local phase=""
  local remaining=180

  if [[ ! -d "$input_dir" ]]; then
    echo "Error: backup directory not found: $input_dir" >&2
    exit 1
  fi
  input_dir="$(cd "$input_dir" && pwd)"

  if should_bootstrap_baremetal; then
    ensure_auto_bootstrap_stack_if_needed
  fi
  validate_external_key_prereqs

  resolve_ton_pod_identity "$pod_ref" ns pod sts ordinal || exit 1

  replicas="$(kubectl -n "$ns" get statefulset "$sts" -o jsonpath='{.spec.replicas}' 2>/dev/null || true)"
  if ! [[ "$replicas" =~ ^[0-9]+$ ]]; then
    echo "Error: cannot read replicas for StatefulSet ${ns}/${sts}." >&2
    exit 1
  fi
  if (( ordinal >= replicas )); then
    echo "Error: pod ordinal ${ordinal} is outside StatefulSet replicas=${replicas} for ${ns}/${sts}." >&2
    exit 1
  fi

  pvc_ton_work="ton-work-${sts}-${ordinal}"
  pvc_ton_src="ton-src-${sts}-${ordinal}"
  pvc_mytoncore="mytoncore-${sts}-${ordinal}"
  pvc_mytonctrl="mytonctrl-${sts}-${ordinal}"
  pvc_keybundle="keybundle-${sts}-${ordinal}"
  item_dir="${input_dir}/${ns}/${sts}/${ordinal}"
  bundle_dir="${item_dir}/bundle"

  if [[ ! -d "$bundle_dir" ]]; then
    echo "Error: missing backup bundle dir for ${ns}/${sts}/${ordinal}: ${bundle_dir}" >&2
    exit 1
  fi
  if ! find "$bundle_dir" -type f -print -quit | grep -q .; then
    echo "Error: backup bundle dir is empty for ${ns}/${sts}/${ordinal}: ${bundle_dir}" >&2
    exit 1
  fi
  if [[ -f "${item_dir}/SHA256SUMS" ]]; then
    if ! (cd "$item_dir" && sha256sum -c SHA256SUMS >/dev/null); then
      echo "Error: SHA256SUMS verification failed for ${item_dir}." >&2
      exit 1
    fi
  else
    echo "Warning: ${item_dir}/SHA256SUMS not found; continuing without checksum verification."
  fi

  if ! kubectl -n "$ns" get pvc "$pvc_keybundle" >/dev/null 2>&1; then
    echo "Error: required key bundle PVC ${ns}/${pvc_keybundle} not found." >&2
    exit 1
  fi

  confirm_or_exit "This will recreate ${ns}/${pod}: delete PVCs ${pvc_ton_work}, ${pvc_ton_src}, ${pvc_mytoncore}, and ${pvc_mytonctrl}, let pod run for 3 minutes, inject backup bundle from ${item_dir}, then restart pod. Continue?"

  pv_ton_work="$(kubectl -n "$ns" get pvc "$pvc_ton_work" -o jsonpath='{.spec.volumeName}' 2>/dev/null || true)"
  pv_ton_src="$(kubectl -n "$ns" get pvc "$pvc_ton_src" -o jsonpath='{.spec.volumeName}' 2>/dev/null || true)"
  pv_mytoncore="$(kubectl -n "$ns" get pvc "$pvc_mytoncore" -o jsonpath='{.spec.volumeName}' 2>/dev/null || true)"
  pv_mytonctrl="$(kubectl -n "$ns" get pvc "$pvc_mytonctrl" -o jsonpath='{.spec.volumeName}' 2>/dev/null || true)"

  echo "Deleting corrupted data PVCs for ${ns}/${pod} ..."
  kubectl -n "$ns" delete pod "$pod" --ignore-not-found --wait=false >/dev/null 2>&1 || true
  kubectl -n "$ns" delete pvc "$pvc_ton_work" "$pvc_ton_src" "$pvc_mytoncore" "$pvc_mytonctrl" --ignore-not-found --wait=false >/dev/null 2>&1 || true

  # Best-effort cleanup of previous backing volumes helps avoid stuck Terminating PVCs on bare-metal.
  if [[ -n "$pv_ton_work" ]]; then
    kubectl delete pv "$pv_ton_work" --ignore-not-found --wait=false >/dev/null 2>&1 || true
    kubectl -n "$LONGHORN_NAMESPACE" delete volumes.longhorn.io "$pv_ton_work" --ignore-not-found --wait=false >/dev/null 2>&1 || true
  fi
  if [[ -n "$pv_ton_src" ]]; then
    kubectl delete pv "$pv_ton_src" --ignore-not-found --wait=false >/dev/null 2>&1 || true
    kubectl -n "$LONGHORN_NAMESPACE" delete volumes.longhorn.io "$pv_ton_src" --ignore-not-found --wait=false >/dev/null 2>&1 || true
  fi
  if [[ -n "$pv_mytoncore" ]]; then
    kubectl delete pv "$pv_mytoncore" --ignore-not-found --wait=false >/dev/null 2>&1 || true
    kubectl -n "$LONGHORN_NAMESPACE" delete volumes.longhorn.io "$pv_mytoncore" --ignore-not-found --wait=false >/dev/null 2>&1 || true
  fi
  if [[ -n "$pv_mytonctrl" ]]; then
    kubectl delete pv "$pv_mytonctrl" --ignore-not-found --wait=false >/dev/null 2>&1 || true
    kubectl -n "$LONGHORN_NAMESPACE" delete volumes.longhorn.io "$pv_mytonctrl" --ignore-not-found --wait=false >/dev/null 2>&1 || true
  fi

  echo "Waiting for fresh PVCs to become Bound ..."
  wait_pvc_bound "$ns" "$pvc_ton_work" 1800
  wait_pvc_bound "$ns" "$pvc_ton_src" 1800
  wait_pvc_bound "$ns" "$pvc_mytoncore" 1800
  wait_pvc_bound "$ns" "$pvc_mytonctrl" 1800

  echo "Waiting for initial startup of ${ns}/${pod} ..."
  wait_pod_ready "$ns" "$pod" 1800
  echo "Initial startup complete."

  while (( remaining > 0 )); do
    phase="$(kubectl -n "$ns" get pod "$pod" -o jsonpath='{.status.phase}' 2>/dev/null || true)"
    [[ -z "$phase" ]] && phase="Unknown"
    echo "[recreate] ${ns}/${pod} is running (phase=${phase}); replacing with backup in ${remaining}s ..."
    sleep 30
    ((remaining-=30))
  done

  echo "Injecting encrypted backup bundle into ${ns}/${pod} ..."
  inject_bundle_into_running_pod "$ns" "$pod" "$bundle_dir"

  echo "Clearing bootstrap marker in ${ns}/${pod} (/var/ton-work/db/mtc_done) ..."
  if ! kubectl -n "$ns" exec "$pod" -c ton-node -- sh -ec 'rm -f /var/ton-work/db/mtc_done'; then
    echo "Error: failed to clear /var/ton-work/db/mtc_done in ${ns}/${pod}." >&2
    exit 1
  fi

  echo "Restarting ${ns}/${pod} to restore keys and mytoncore from bundle ..."
  kubectl -n "$ns" delete pod "$pod" --ignore-not-found --wait=false >/dev/null 2>&1 || true
  wait_pod_ready "$ns" "$pod" 1800

  echo "Recreate completed for ${ns}/${pod}."
}

pause_operator_reconcile() {
  local -n deploy_names_ref="$1"
  local -n deploy_replicas_ref="$2"

  mapfile -t deploy_rows < <(kubectl -n "$OP_NAMESPACE" get deploy -l "app.kubernetes.io/instance=${RELEASE_NAME}" \
    -o jsonpath='{range .items[*]}{.metadata.name}{"\t"}{.spec.replicas}{"\n"}{end}')
  if [[ ${#deploy_rows[@]} -eq 0 || -z "${deploy_rows[0]}" ]]; then
    echo "Warning: no operator deployments found in namespace ${OP_NAMESPACE}; backup/restore may race with reconciliation." >&2
    return 0
  fi

  local row name replicas
  for row in "${deploy_rows[@]}"; do
    [[ -z "$row" ]] && continue
    IFS=$'\t' read -r name replicas <<<"$row"
    [[ -z "$name" ]] && continue
    if ! [[ "$replicas" =~ ^[0-9]+$ ]]; then
      replicas=1
    fi
    deploy_names_ref+=("$name")
    deploy_replicas_ref+=("$replicas")
  done

  echo "Temporarily disabling operator reconciliation (scaling deployments in ${OP_NAMESPACE} to 0) ..."
  local i
  for i in "${!deploy_names_ref[@]}"; do
    kubectl -n "$OP_NAMESPACE" scale deployment "${deploy_names_ref[$i]}" --replicas=0 >/dev/null
  done
}

resume_operator_reconcile() {
  local -n deploy_names_ref="$1"
  local -n deploy_replicas_ref="$2"
  local i

  [[ ${#deploy_names_ref[@]} -eq 0 ]] && return 0

  echo "Restoring operator reconciliation in ${OP_NAMESPACE} ..."
  for i in "${!deploy_names_ref[@]}"; do
    kubectl -n "$OP_NAMESPACE" scale deployment "${deploy_names_ref[$i]}" --replicas="${deploy_replicas_ref[$i]}" >/dev/null 2>&1 || true
  done
}

wait_statefulset_pods_gone() {
  local ns="$1"
  local sts="$2"
  local selector="app.kubernetes.io/instance=${sts},app.kubernetes.io/name=ton-node"
  local start_ts
  local next_diag
  local deadline=$(( $(date +%s) + 900 ))
  start_ts="$(date +%s)"
  next_diag=$(( start_ts + 20 ))
  while (( $(date +%s) < deadline )); do
    local now
    local count
    now="$(date +%s)"
    count="$(kubectl -n "$ns" get pods -l "$selector" -o name 2>/dev/null | wc -l | tr -d '[:space:]')"
    if [[ "${count:-0}" == "0" ]]; then
      return 0
    fi
    if (( now >= next_diag )); then
      local elapsed
      elapsed=$(( now - start_ts ))
      echo "[wait] ${ns}/${sts}: ${count} pod(s) still terminating after ${elapsed}s ..."
      kubectl -n "$ns" get pods -l "$selector" \
        -o custom-columns=NAME:.metadata.name,PHASE:.status.phase,DELETING:.metadata.deletionTimestamp,NODE:.spec.nodeName \
        --no-headers 2>/dev/null || true
      next_diag=$(( now + 20 ))
    fi
    sleep 2
  done
  echo "Error: timeout waiting for pods of ${ns}/${sts} to terminate" >&2
  kubectl -n "$ns" get pods -l "$selector" \
    -o custom-columns=NAME:.metadata.name,PHASE:.status.phase,DELETING:.metadata.deletionTimestamp,NODE:.spec.nodeName \
    --no-headers 2>/dev/null || true
  return 1
}

scale_statefulset_rows_to_zero() {
  local -n sts_rows_ref="$1"
  local row ns sts

  for row in "${sts_rows_ref[@]}"; do
    [[ -z "$row" ]] && continue
    IFS=$'\t' read -r ns sts _ <<<"$row"
    [[ -z "$ns" || -z "$sts" ]] && continue
    kubectl -n "$ns" scale statefulset "$sts" --replicas=0 >/dev/null 2>&1 || true
  done
}

clear_stopped_metadata_for_statefulset_rows() {
  local -n sts_rows_ref="$1"
  local row ns sts

  for row in "${sts_rows_ref[@]}"; do
    [[ -z "$row" ]] && continue
    IFS=$'\t' read -r ns sts _ <<<"$row"
    [[ -z "$ns" || -z "$sts" ]] && continue
    kubectl -n "$ns" patch tonnodes.ton.ton.org "$sts" --type=merge \
      -p "{\"metadata\":{\"annotations\":{\"${KUBETON_PAUSE_ANNOTATION_KEY}\":null,\"${KUBETON_PAUSE_NODEMAP_ANNOTATION_KEY}\":null}}}" >/dev/null 2>&1 || true
    kubectl -n "$ns" patch statefulset "$sts" --type=merge \
      -p "{\"metadata\":{\"annotations\":{\"${KUBETON_PAUSE_ANNOTATION_KEY}\":null,\"${KUBETON_PAUSE_NODEMAP_ANNOTATION_KEY}\":null,\"${STICKY_ORDINAL_NODE_MAP_ANNOTATION_KEY}\":null}}}" >/dev/null 2>&1 || true
  done
}

wait_statefulset_rows_pods_gone() {
  local -n sts_rows_ref="$1"
  local row ns sts
  local failed=0
  local -a wait_pids=()
  local -a wait_targets=()
  local i

  for row in "${sts_rows_ref[@]}"; do
    [[ -z "$row" ]] && continue
    IFS=$'\t' read -r ns sts _ <<<"$row"
    [[ -z "$ns" || -z "$sts" ]] && continue
    wait_statefulset_pods_gone "$ns" "$sts" &
    wait_pids+=("$!")
    wait_targets+=("${ns}/${sts}")
  done

  for i in "${!wait_pids[@]}"; do
    if ! wait "${wait_pids[$i]}"; then
      echo "Warning: timed out waiting for pods of ${wait_targets[$i]} to terminate." >&2
      failed=1
    fi
  done

  return "$failed"
}

stop_ton_for_destructive_cleanup() {
  local sts_rows_name="$1"

  if ! run_stop_without_backup; then
    echo "Warning: failed to disable TON resources in Helm release ${RELEASE_NAME}; continuing with direct TonNode/StatefulSet cleanup." >&2
  fi

  clear_stopped_metadata_for_statefulset_rows "$sts_rows_name"
  kubectl delete tonnodes.ton.ton.org --all -A --ignore-not-found || true

  # If the operator or Helm path is unhealthy, scaling the captured StatefulSets
  # still prevents live pods from holding PVCs while deletion starts.
  scale_statefulset_rows_to_zero "$sts_rows_name"

  echo "Waiting for TON pods to terminate before PVC deletion ..."
  wait_statefulset_rows_pods_gone "$sts_rows_name"
}

wait_ton_statefulsets_present() {
  local timeout_seconds="${1:-300}"
  local deadline=$(( $(date +%s) + timeout_seconds ))
  local -a sts_rows=()

  while (( $(date +%s) < deadline )); do
    mapfile -t sts_rows < <(list_ton_statefulsets 2>/dev/null || true)
    if (( ${#sts_rows[@]} > 0 )) && [[ -n "${sts_rows[0]:-}" ]]; then
      return 0
    fi
    sleep 2
  done

  echo "Error: timeout waiting for TON StatefulSet creation." >&2
  return 1
}

wait_statefulset_present() {
  local ns="$1"
  local sts="$2"
  local timeout_seconds="${3:-300}"
  local deadline=$(( $(date +%s) + timeout_seconds ))

  while (( $(date +%s) < deadline )); do
    if kubectl -n "$ns" get statefulset "$sts" >/dev/null 2>&1; then
      return 0
    fi
    sleep 2
  done

  echo "Error: timeout waiting for StatefulSet ${ns}/${sts}." >&2
  return 1
}

set_tonnode_or_statefulset_replicas() {
  local ns="$1"
  local name="$2"
  local replicas="$3"

  if kubectl -n "$ns" get tonnodes.ton.ton.org "$name" >/dev/null 2>&1; then
    kubectl -n "$ns" patch tonnodes.ton.ton.org "$name" --field-manager=helm --type=merge \
      -p "{\"spec\":{\"replicas\":${replicas}}}" >/dev/null
    return 0
  fi

  set_ton_replicas "$ns" "$name" "$replicas"
}

should_use_sequential_ton_start() {
  local target_replicas="$1"
  local restore_from_stop_metadata="$2"

  if ! [[ "$target_replicas" =~ ^[1-9][0-9]*$ ]]; then
    return 1
  fi
  if (( target_replicas <= 1 || restore_from_stop_metadata != 0 )); then
    return 1
  fi

  if fleet_has_running_ton_pods; then
    if is_true "$KUBETON_SEQUENTIAL_TON_START"; then
      echo "Warning: KUBETON_SEQUENTIAL_TON_START=true ignored because TON pods are already Running; sequential staging would scale the fleet down during start." >&2
    fi
    return 1
  fi

  if is_true "$KUBETON_SEQUENTIAL_TON_START"; then
    return 0
  fi

  if is_true "$KUBETON_AUTO_SEQUENTIAL_LOCAL_PATH_START" && ton_storage_class_requires_sequential_start; then
    return 0
  fi

  return 1
}

sequential_start_ton_fleet() {
  local target_replicas="$1"
  local -a sts_rows=()
  local row ns sts current_replicas ordinal pod

  if ! [[ "$target_replicas" =~ ^[1-9][0-9]*$ ]]; then
    return 0
  fi
  if (( target_replicas <= 1 )); then
    return 0
  fi

  wait_ton_statefulsets_present 300 || return 1
  mapfile -t sts_rows < <(list_ton_statefulsets 2>/dev/null || true)
  if (( ${#sts_rows[@]} == 0 )) || [[ -z "${sts_rows[0]:-}" ]]; then
    echo "Error: no TON StatefulSets found for sequential start." >&2
    return 1
  fi

  echo "[start] Sequential TON volume staging enabled: scaling to ${target_replicas} one ordinal at a time."
  for ordinal in $(seq 0 $((target_replicas - 1))); do
    current_replicas=$((ordinal + 1))
    if (( ordinal > 0 )); then
      # A local-path ordinal can take several minutes to bind and stage.
      # Refuse the next scale-up if durable log coverage disappeared while
      # the preceding ordinal was being prepared.
      if ! verify_start_victoria_logs_collection_ready; then
        echo "Error: VictoriaLogs coverage was lost before TON ordinal ${ordinal}; the next Pod was not created." >&2
        return 1
      fi
    fi
    for row in "${sts_rows[@]}"; do
      [[ -z "$row" ]] && continue
      IFS=$'\t' read -r ns sts _ <<<"$row"
      [[ -z "$ns" || -z "$sts" ]] && continue
      set_tonnode_or_statefulset_replicas "$ns" "$sts" "$current_replicas"
    done

    for row in "${sts_rows[@]}"; do
      [[ -z "$row" ]] && continue
      IFS=$'\t' read -r ns sts _ <<<"$row"
      [[ -z "$ns" || -z "$sts" ]] && continue
      pod="${sts}-${ordinal}"
      echo "[start] Waiting for ${ns}/${pod} volumes to stage ..."
      wait_pod_volume_stage_complete "$ns" "$pod" "$KUBETON_VOLUME_STAGE_TIMEOUT_SECONDS" || return 1
    done
  done
}

trigger_key_backup_once() {
  local ns="$1"
  local pod="$2"
  local deadline

  if ! kubectl -n "$ns" exec "$pod" -c key-backup -- sh -ec 'rm -f /tmp/key-backup.done /tmp/key-backup.failed; : > /tmp/key-backup.request' >/dev/null 2>&1; then
    echo "Error: failed to trigger key backup in ${ns}/${pod} (container key-backup)." >&2
    return 1
  fi

  deadline=$(( $(date +%s) + 300 ))
  while (( $(date +%s) < deadline )); do
    local status
    status="$(kubectl -n "$ns" exec "$pod" -c key-backup -- sh -ec '
      if [ -s /tmp/key-backup.done ]; then
        echo done
      elif [ -s /tmp/key-backup.failed ]; then
        echo failed
      else
        echo waiting
      fi
    ' 2>/dev/null || true)"
    status="${status%%$'\n'*}"
    case "$status" in
      done)
        return 0
        ;;
      failed)
        local fail_reason
        fail_reason="$(kubectl -n "$ns" exec "$pod" -c key-backup -- sh -ec 'cat /tmp/key-backup.failed' 2>/dev/null || true)"
        fail_reason="$(printf '%s' "$fail_reason" | tr '\n' ' ' | sed -e 's/[[:space:]]\+/ /g' -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')"
        if [[ -z "$fail_reason" ]]; then
          fail_reason="backup sidecar reported failure"
        fi
        echo "Error: manual key backup failed in ${ns}/${pod}: ${fail_reason}" >&2
        return 1
        ;;
      *)
        sleep 2
        ;;
    esac
  done

  echo "Error: timeout waiting for manual key backup completion in ${ns}/${pod}" >&2
  return 1
}

pod_has_encrypted_bundle() {
  local ns="$1"
  local pod="$2"
  kubectl -n "$ns" exec "$pod" -c key-backup -- sh -ec '
    bundle_file="${KEY_BUNDLE_FILE:-keys.bundle.enc}"
    meta_file="${KEY_BUNDLE_META_FILE:-keys.bundle.meta}"
    [ -s "/var/ton-key-bundle/${bundle_file}" ] && [ -s "/var/ton-key-bundle/${meta_file}" ]
  ' >/dev/null 2>&1
}

restore_bundle_to_pvc() {
  local ns="$1"
  local pvc="$2"
  local src_bundle_dir="$3"
  local preferred_node="${4:-}"
  local helper_pod="kubeton-restore-$RANDOM-$RANDOM"
  local node_constraints_yaml=""

  node_constraints_yaml="$(helper_pod_node_constraints_yaml "$preferred_node")"

  cat <<EOF | kubectl -n "$ns" apply -f - >/dev/null
apiVersion: v1
kind: Pod
metadata:
  name: ${helper_pod}
spec:
${node_constraints_yaml}
  restartPolicy: Never
  containers:
    - name: restore
      image: busybox:1.36
      command: ["sh", "-c", "sleep 3600"]
      volumeMounts:
        - name: keybundle
          mountPath: /bundle
  volumes:
    - name: keybundle
      persistentVolumeClaim:
        claimName: ${pvc}
EOF

  if ! kubectl -n "$ns" wait --for=condition=Ready "pod/${helper_pod}" --timeout="${HELPER_POD_READY_TIMEOUT}" >/dev/null; then
    print_helper_pod_failure_context "$ns" "$helper_pod"
    kubectl -n "$ns" delete pod "$helper_pod" --ignore-not-found >/dev/null 2>&1 || true
    return 1
  fi
  if ! kubectl -n "$ns" exec "$helper_pod" -- sh -ec 'find /bundle -mindepth 1 -maxdepth 1 -exec rm -rf {} +' >/dev/null 2>&1; then
    kubectl -n "$ns" delete pod "$helper_pod" --ignore-not-found >/dev/null 2>&1 || true
    return 1
  fi
  if ! kubectl -n "$ns" cp "${src_bundle_dir}/." "${helper_pod}:/bundle" >/dev/null; then
    kubectl -n "$ns" delete pod "$helper_pod" --ignore-not-found >/dev/null 2>&1 || true
    return 1
  fi
  kubectl -n "$ns" exec "$helper_pod" -- sh -ec 'find /bundle -type f -exec chmod 600 {} +' >/dev/null 2>&1 || true
  kubectl -n "$ns" delete pod "$helper_pod" --ignore-not-found >/dev/null 2>&1 || true
}

inject_bundle_into_running_pod() {
  local ns="$1"
  local pod="$2"
  local src_bundle_dir="$3"
  local bundle_mount=""
  local container_names=""

  if [[ ! -d "$src_bundle_dir" ]]; then
    echo "Error: bundle source directory not found: $src_bundle_dir" >&2
    return 1
  fi
  if ! find "$src_bundle_dir" -type f -print -quit | grep -q .; then
    echo "Error: bundle source directory is empty: $src_bundle_dir" >&2
    return 1
  fi

  container_names="$(kubectl -n "$ns" get pod "$pod" -o jsonpath='{range .spec.containers[*]}{.name}{" "}{end}' 2>/dev/null || true)"
  if ! grep -qw "key-backup" <<<"$container_names"; then
    echo "Error: pod ${ns}/${pod} has no key-backup container." >&2
    return 1
  fi

  bundle_mount="$(kubectl -n "$ns" exec "$pod" -c key-backup -- sh -ec 'printf %s "${KEY_BUNDLE_DIR:-/var/ton-key-bundle}"' 2>/dev/null || true)"
  bundle_mount="$(trim_whitespace "$bundle_mount")"
  if [[ -z "$bundle_mount" ]]; then
    bundle_mount="/var/ton-key-bundle"
  fi

  kubectl -n "$ns" exec "$pod" -c key-backup -- sh -ec \
    "mkdir -p \"$bundle_mount\"; find \"$bundle_mount\" -mindepth 1 -maxdepth 1 -exec rm -rf {} +" >/dev/null
  kubectl -n "$ns" cp "${src_bundle_dir}/." "${ns}/${pod}:${bundle_mount}" -c key-backup >/dev/null
  kubectl -n "$ns" exec "$pod" -c key-backup -- sh -ec \
    "find \"$bundle_mount\" -type f -exec chmod 600 {} +; sync" >/dev/null 2>&1 || true
}

restore_replica_from_backup() {
  local ns="$1"
  local sts="$2"
  local ordinal="$3"
  local input_dir="$4"
  local preferred_node="${5:-}"

  local pvc="keybundle-${sts}-${ordinal}"
  local item_dir="${input_dir}/${ns}/${sts}/${ordinal}"
  local bundle_dir="${item_dir}/bundle"

  if [[ ! -d "$bundle_dir" ]]; then
    echo "Warning: missing backup bundle for ${ns}/${sts}/${ordinal}: ${bundle_dir}" >&2
    return 10
  fi

  if [[ -f "${item_dir}/SHA256SUMS" ]]; then
    if ! (cd "$item_dir" && sha256sum -c SHA256SUMS >/dev/null); then
      echo "Warning: SHA256SUMS verification failed for ${item_dir}; skipping this replica" >&2
      return 11
    fi
  else
    echo "Warning: missing ${item_dir}/SHA256SUMS; continuing without checksum verification"
  fi

  if ! kubectl -n "$ns" get pvc "$pvc" >/dev/null 2>&1; then
    echo "Warning: missing PVC ${ns}/${pvc}; skipping this replica" >&2
    return 11
  fi

  if ! restore_bundle_to_pvc "$ns" "$pvc" "$bundle_dir" "$preferred_node"; then
    echo "Warning: failed to restore ${ns}/${pvc} from ${bundle_dir}; skipping this replica" >&2
    return 11
  fi

  return 0
}

export_bundle_from_pvc() {
  local ns="$1"
  local sts="$2"
  local ordinal="$3"
  local output_dir="$4"
  local preferred_node="${5:-}"
  local pvc="keybundle-${sts}-${ordinal}"
  local item_dir="$output_dir/$ns/$sts/$ordinal"
  local bundle_dir="$item_dir/bundle"
  local helper_pod="kubeton-backup-${sts}-${ordinal}-$RANDOM-$RANDOM"
  local node_constraints_yaml=""

  node_constraints_yaml="$(helper_pod_node_constraints_yaml "$preferred_node")"

  if ! kubectl -n "$ns" get pvc "$pvc" >/dev/null 2>&1; then
    echo "Warning: missing PVC ${ns}/${pvc}, skipping"
    return 0
  fi

  mkdir -p "$bundle_dir"

  cat <<EOF | kubectl -n "$ns" apply -f - >/dev/null
apiVersion: v1
kind: Pod
metadata:
  name: ${helper_pod}
spec:
${node_constraints_yaml}
  restartPolicy: Never
  containers:
    - name: backup
      image: busybox:1.36
      command: ["sh", "-c", "sleep 3600"]
      volumeMounts:
        - name: keybundle
          mountPath: /bundle
          readOnly: true
  volumes:
    - name: keybundle
      persistentVolumeClaim:
        claimName: ${pvc}
        readOnly: true
EOF

  if ! kubectl -n "$ns" wait --for=condition=Ready "pod/${helper_pod}" --timeout="${HELPER_POD_READY_TIMEOUT}" >/dev/null; then
    print_helper_pod_failure_context "$ns" "$helper_pod"
    kubectl -n "$ns" delete pod "$helper_pod" --ignore-not-found >/dev/null 2>&1 || true
    echo "Error: helper pod ${ns}/${helper_pod} did not become Ready." >&2
    return 1
  fi

  if ! kubectl -n "$ns" cp "${helper_pod}:/bundle/." "$bundle_dir" >/dev/null; then
    kubectl -n "$ns" delete pod "$helper_pod" --ignore-not-found >/dev/null 2>&1 || true
    echo "Error: failed to copy encrypted bundle from ${ns}/${helper_pod}." >&2
    return 1
  fi

  if find "$bundle_dir" -type f -print -quit | grep -q .; then
    if ! (cd "$item_dir" && find bundle -type f -print0 | sort -z | xargs -0 sha256sum > SHA256SUMS); then
      kubectl -n "$ns" delete pod "$helper_pod" --ignore-not-found >/dev/null 2>&1 || true
      echo "Error: failed to write SHA256SUMS for ${ns}/${sts}/${ordinal}." >&2
      return 1
    fi
  else
    echo "Warning: ${ns}/${pvc} bundle directory is empty"
  fi

  kubectl -n "$ns" delete pod "$helper_pod" --ignore-not-found >/dev/null 2>&1 || true
  return 0
}

