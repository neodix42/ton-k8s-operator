}

kubeton_process_identity_from_proc() {
  local pid="$1"
  local proc_root="${KUBETON_PROCESS_PROC_ROOT:-/proc}"
  local stat_line stat_tail parsed actual_parent process_state start_time

  [[ "$pid" =~ ^[1-9][0-9]*$ ]] || return 1
  [[ -r "${proc_root%/}/${pid}/stat" ]] || return 1
  stat_line="$(awk 'NR == 1 {print; exit}' "${proc_root%/}/${pid}/stat" 2>/dev/null || true)"
  [[ -n "$stat_line" && "$stat_line" == *") "* ]] || return 1
  # The comm field is parenthesized and may itself contain spaces. Remove
  # through the final closing parenthesis before indexing the remaining
  # fields: state=1, ppid=2, and starttime=20 (field 22 in procfs).
  stat_tail="${stat_line##*) }"
  parsed="$(printf '%s\n' "$stat_tail" | awk 'NF >= 20 {print $2 "\t" substr($1, 1, 1) "\t" $20; exit}')"
  IFS=$'\t' read -r actual_parent process_state start_time <<<"$parsed"
  [[ "$actual_parent" =~ ^[0-9]+$ && "$start_time" =~ ^[0-9]+$ && -n "$process_state" ]] || return 1
  printf '%s\t%s\tproc:%s' "$actual_parent" "$process_state" "$start_time"
}

kubeton_process_identity_from_ps() {
  local pid="$1"
  local start_field row parsed actual_parent process_state start_token

  [[ "$pid" =~ ^[1-9][0-9]*$ ]] || return 1
  # lstart is available in procps and BSD ps and gives a fixed wall-clock
  # identity. Some smaller implementations expose the same fixed value as
  # start. If neither format exists, fail closed instead of signaling a PID
  # based only on its mutable command name or current parent.
  for start_field in lstart start; do
    row="$(LC_ALL=C ps -p "$pid" -o ppid= -o stat= -o "${start_field}=" 2>/dev/null || true)"
    parsed="$(printf '%s\n' "$row" | awk -v prefix="ps-${start_field}:" '
      NF >= 3 {
        parent = $1
        state = substr($2, 1, 1)
        $1 = ""
        $2 = ""
        sub(/^[[:space:]]+/, "")
        if (parent ~ /^[0-9]+$/ && state != "" && $0 != "") {
          print parent "\t" state "\t" prefix $0
          exit
        }
      }
    ')"
    IFS=$'\t' read -r actual_parent process_state start_token <<<"$parsed"
    if [[ "$actual_parent" =~ ^[0-9]+$ && -n "$process_state" && -n "$start_token" ]]; then
      printf '%s\t%s\t%s' "$actual_parent" "$process_state" "$start_token"
      return 0
    fi
  done
  return 1
}

kubeton_process_identity() {
  local pid="$1"

  kubeton_process_identity_from_proc "$pid" && return 0
  kubeton_process_identity_from_ps "$pid"
}

terminate_owned_process_tree() {
  local root_pid="$1"
  local expected_parent="${2:-}"
  local expected_identity_token="${3:-}"
  local identity actual_parent process_state identity_token identity_token_now child attempt

  [[ "$root_pid" =~ ^[1-9][0-9]*$ ]] || return 0
  identity="$(kubeton_process_identity "$root_pid" 2>/dev/null || true)"
  IFS=$'\t' read -r actual_parent process_state identity_token <<<"$identity"
  [[ "$actual_parent" =~ ^[0-9]+$ && -n "$identity_token" ]] || return 0
  if [[ -n "$expected_parent" ]]; then
    [[ "$actual_parent" == "$expected_parent" ]] || return 0
  else
    expected_parent="$actual_parent"
  fi
  if [[ -n "$expected_identity_token" && "$identity_token" != "$expected_identity_token" ]]; then
    return 0
  fi
  # Freeze each verified process before enumerating children so it cannot
  # create a new descendant between the ownership walk and termination.
  kill -STOP "$root_pid" >/dev/null 2>&1 || return 0
  identity="$(kubeton_process_identity "$root_pid" 2>/dev/null || true)"
  IFS=$'\t' read -r actual_parent process_state identity_token_now <<<"$identity"
  if [[ "$actual_parent" != "$expected_parent" || "$identity_token_now" != "$identity_token" ]]; then
    # We cannot prove this is still the process which was observed above.
    # Undo our STOP best-effort, but never TERM/KILL the changed identity.
    kill -CONT "$root_pid" >/dev/null 2>&1 || true
    return 0
  fi
  while IFS= read -r child; do
    child="$(trim_whitespace "$child")"
    [[ "$child" =~ ^[1-9][0-9]*$ ]] || continue
    terminate_owned_process_tree "$child" "$root_pid"
  done < <(ps -eo pid=,ppid= 2>/dev/null | awk -v parent="$root_pid" '$2 == parent {print $1}')
  kill -TERM "$root_pid" >/dev/null 2>&1 || true
  kill -CONT "$root_pid" >/dev/null 2>&1 || true
  for attempt in {1..10}; do
    identity="$(kubeton_process_identity "$root_pid" 2>/dev/null || true)"
    IFS=$'\t' read -r actual_parent process_state identity_token_now <<<"$identity"
    if [[ "$actual_parent" != "$expected_parent" \
      || "$identity_token_now" != "$identity_token" \
      || "$process_state" == "Z" \
      || -z "$identity" ]]; then
      return 0
    fi
    command sleep 0.05
  done
  # This is a private process tree rooted in a PID whose parent and start time
  # were verified above. Escalate so a TERM-ignoring child cannot retain a
  # transcript FIFO and hang kubeton shutdown indefinitely.
  identity="$(kubeton_process_identity "$root_pid" 2>/dev/null || true)"
  IFS=$'\t' read -r actual_parent process_state identity_token_now <<<"$identity"
  if [[ -n "$identity" \
    && "$actual_parent" == "$expected_parent" \
    && "$identity_token_now" == "$identity_token" \
    && "$process_state" != "Z" ]]; then
    kill -KILL "$root_pid" >/dev/null 2>&1 || true
  fi
}

launch_session_drain_or_stop_tee() {
  local tee_pid="$1"
  local expected_parent="$2"
  local identity actual_parent process_state identity_token identity_token_now attempt

  [[ "$tee_pid" =~ ^[1-9][0-9]*$ ]] || return 0
  identity="$(kubeton_process_identity "$tee_pid" 2>/dev/null || true)"
  IFS=$'\t' read -r actual_parent process_state identity_token <<<"$identity"
  [[ "$actual_parent" == "$expected_parent" && -n "$identity_token" ]] || return 0

  # Once command-side FIFO writers are stopped, give tee time to consume bytes
  # already queued by the kernel. This preserves the tail of an interrupted
  # command instead of killing the transcript writer immediately. Bound the
  # grace period so an escaped process which inherited the FIFO cannot hang
  # kubeton forever.
  for attempt in {1..40}; do
    identity="$(kubeton_process_identity "$tee_pid" 2>/dev/null || true)"
    IFS=$'\t' read -r actual_parent process_state identity_token_now <<<"$identity"
    if [[ -z "$identity" \
      || "$actual_parent" != "$expected_parent" \
      || "$identity_token_now" != "$identity_token" \
      || "$process_state" == "Z" ]]; then
      return 0
    fi
    command sleep 0.05
  done
  terminate_owned_process_tree "$tee_pid" "$expected_parent" "$identity_token"
}

terminate_owned_child_processes() {
  local parent_pid="$1"
  local child

  while IFS= read -r child; do
    child="$(trim_whitespace "$child")"
    [[ "$child" =~ ^[1-9][0-9]*$ ]] || continue
    terminate_owned_process_tree "$child" "$parent_pid"
  done < <(ps -eo pid=,ppid= 2>/dev/null | awk -v parent="$parent_pid" '$2 == parent {print $1}')
}

launch_session_begin() {
  local command_name="$1"
  local root run_id launch_dir context="unknown"

  root="$(trim_whitespace "${KUBETON_LAUNCH_LOG_ROOT:-}")"
  if [[ -z "$root" ]]; then
    echo "Error: KUBETON_LAUNCH_LOG_ROOT must not be empty." >&2
    return 1
  fi
  run_id="$(date -u +%Y%m%dT%H%M%SZ)-${command_name}-$$"
  launch_dir="${root%/}/${run_id}"
  if [[ -e "$launch_dir" ]]; then
    launch_dir="${launch_dir}-${RANDOM}"
  fi

  (umask 077; mkdir -p "$launch_dir/pods" "$launch_dir/final") || {
    echo "Error: cannot create launch evidence directory ${launch_dir}." >&2
    return 1
  }
  # Never chmod a caller-supplied existing root (it may be a shared directory
  # or even the workspace itself). The per-run directory is the security
  # boundary; a newly created root already inherited umask 077 above.
  chmod 700 "$launch_dir" "$launch_dir/pods" "$launch_dir/final" 2>/dev/null || true
  context="$(kubectl config current-context 2>/dev/null || true)"
  context="$(trim_whitespace "$context")"
  [[ -z "$context" ]] && context="unknown"
  (umask 077; {
    printf 'started_at=%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    printf 'command=%s\n' "$command_name"
    printf 'pid=%s\n' "$$"
    printf 'kube_context=%s\n' "$context"
    printf 'ton_values_file=%s\n' "$TON_VALUES_FILE"
  } >"$launch_dir/session.meta")
  echo "[launch] Evidence is being retained in ${launch_dir}" >&2
  printf '%s' "$launch_dir"
}

launch_session_event_watch() {
  local launch_dir="$1"
  local ns="$2"
  local stop_file="$launch_dir/.stop"
  local output_file="$launch_dir/events.log"

  umask 077
  printf '# Kubernetes events for namespace %s; watcher started %s\n' "$ns" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" >>"$output_file"

  while [[ ! -e "$stop_file" ]]; do
    # `kubectl get --watch` performs the initial list and starts its watch from
    # that list's resourceVersion inside one supported client operation. This
    # avoids a list/watch race without relying on a kubectl --resource-version
    # flag (which `kubectl get` does not expose). A real reconnect can repeat
    # retained Events, but the long-lived stream is not periodically replayed.
    printf '\n# event list/watch connected %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" >>"$output_file"
    kubectl -n "$ns" get events --watch \
      -o go-template='{{.metadata.creationTimestamp}}{{"\t"}}{{.lastTimestamp}}{{"\t"}}{{.type}}{{"\t"}}{{.reason}}{{"\t"}}{{.involvedObject.kind}}{{"/"}}{{.involvedObject.name}}{{"\t"}}{{.count}}{{"\t"}}{{.message}}{{"\n"}}' \
      >>"$output_file" 2>>"$launch_dir/watcher-errors.log" || true
    [[ -e "$stop_file" ]] || sleep 2
  done
}

# Namespace-scoped Events explain the TON workload itself, while a cluster-wide
# stream captures the dependencies that can fail before a TON Pod exists:
# scheduler/node pressure, Longhorn CSI, Vault, the operator, and VictoriaLogs.
# Events are retained by the API long enough for the initial list to close the
# small scheduling gap between launching this background watcher and the first
# bootstrap action.
launch_session_cluster_event_watch() {
  local launch_dir="$1"
  local stop_file="$launch_dir/.stop"
  local output_file="$launch_dir/events-cluster.log"

  umask 077
  printf '# Kubernetes events for all namespaces; watcher started %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" >>"$output_file"

  while [[ ! -e "$stop_file" ]]; do
    printf '\n# cluster event list/watch connected %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" >>"$output_file"
    kubectl get events --all-namespaces --watch \
      -o go-template='{{.metadata.creationTimestamp}}{{"\t"}}{{.metadata.namespace}}{{"\t"}}{{.lastTimestamp}}{{"\t"}}{{.type}}{{"\t"}}{{.reason}}{{"\t"}}{{.involvedObject.kind}}{{"/"}}{{.involvedObject.name}}{{"\t"}}{{.count}}{{"\t"}}{{.message}}{{"\n"}}' \
      >>"$output_file" 2>>"$launch_dir/watcher-errors.log" || true
    [[ -e "$stop_file" ]] || sleep 2
  done
}

launch_session_timeline_watch() {
  local launch_dir="$1"
  local ns="$2"
  local tonnode_name="$3"
  local selector stop_file interval

  selector="$(launch_session_selector "$tonnode_name")"
  stop_file="$launch_dir/.stop"
  interval="$(trim_whitespace "${KUBETON_LAUNCH_SNAPSHOT_INTERVAL_SECONDS:-15}")"
  if ! [[ "$interval" =~ ^[1-9][0-9]*$ ]]; then
    interval=15
  fi
  umask 077
  printf 'observed_at\tpod\tuid\tnode\tphase\tinitialized\tready\trestarts\twaiting_reason\tlast_exit\n' >"$launch_dir/timeline.tsv"

  while [[ ! -e "$stop_file" ]]; do
    run_with_timeout "$STATUS_EXEC_TIMEOUT" kubectl -n "$ns" get pods -l "$selector" \
      -o go-template="{{range .items}}{{printf \"%s\\t%s\\t%s\\t%s\\t%s\\t\" \"$(date -u +%Y-%m-%dT%H:%M:%SZ)\" .metadata.name .metadata.uid .spec.nodeName .status.phase}}{{range .status.conditions}}{{if eq .type \"Initialized\"}}{{.status}}{{end}}{{end}}{{printf \"\\t\"}}{{range .status.conditions}}{{if eq .type \"Ready\"}}{{.status}}{{end}}{{end}}{{printf \"\\t\"}}{{range .status.initContainerStatuses}}{{.restartCount}}{{\"+\"}}{{end}}{{range .status.containerStatuses}}{{.restartCount}}{{\"+\"}}{{end}}{{printf \"\\t\"}}{{range .status.initContainerStatuses}}{{if .state.waiting}}{{.state.waiting.reason}}{{end}}{{end}}{{range .status.containerStatuses}}{{if .state.waiting}}{{.state.waiting.reason}}{{end}}{{end}}{{printf \"\\t\"}}{{range .status.initContainerStatuses}}{{if .lastState.terminated}}{{.lastState.terminated.exitCode}}{{end}}{{end}}{{range .status.containerStatuses}}{{if .lastState.terminated}}{{.lastState.terminated.exitCode}}{{end}}{{end}}{{printf \"\\n\"}}{{end}}" \
      >>"$launch_dir/timeline.tsv" 2>>"$launch_dir/watcher-errors.log" || true
    sleep "$interval" &
    wait "$!" || true
  done
}

launch_session_init_container_completed() {
  local ns="$1"
  local pod="$2"
  local expected_uid="$3"
  local container="$4"
  local status_rows row name exit_code current_uid

  status_rows="$(run_with_timeout "$STATUS_EXEC_TIMEOUT" kubectl -n "$ns" get pod "$pod" --ignore-not-found \
    -o go-template='{{.metadata.uid}}{{"\n"}}{{range .status.initContainerStatuses}}{{.name}}{{"\x1f"}}{{if .state.terminated}}{{.state.terminated.exitCode}}{{end}}{{"\n"}}{{end}}' \
    2>/dev/null || true)"
  current_uid="$(printf '%s\n' "$status_rows" | head -n1)"
  current_uid="$(trim_whitespace "$current_uid")"
  [[ "$current_uid" == "$expected_uid" ]] || return 1
  while IFS= read -r row; do
    IFS=$'\x1f' read -r name exit_code <<<"$row"
    if [[ "$name" == "$container" && "$exit_code" == "0" ]]; then
      return 0
    fi
  done < <(printf '%s\n' "$status_rows" | tail -n +2)
  return 1
}

launch_session_follow_one_container() {
  local launch_dir="$1"
  local ns="$2"
  local pod="$3"
  local expected_uid="$4"
  local container="$5"
  local container_kind="$6"
  local safe_uid safe_container stop_file current_uid output_file error_file

  safe_uid="${expected_uid//[^a-zA-Z0-9_.-]/_}"
  safe_container="${container//[^a-zA-Z0-9_.-]/_}"
  stop_file="$launch_dir/.stop"
  output_file="$launch_dir/pods/${pod}-${safe_uid}-${safe_container}.log"
  error_file="$launch_dir/pods/${pod}-${safe_uid}-${safe_container}.errors.log"
  umask 077

  while [[ ! -e "$stop_file" ]]; do
    current_uid="$(run_with_timeout "$STATUS_EXEC_TIMEOUT" kubectl -n "$ns" get pod "$pod" --ignore-not-found -o jsonpath='{.metadata.uid}' 2>/dev/null || true)"
    current_uid="$(trim_whitespace "$current_uid")"
    if [[ -z "$current_uid" || "$current_uid" != "$expected_uid" ]]; then
      return 0
    fi
    printf '\n===== %s/%s container=%s kind=%s log connection %s =====\n' \
      "$ns" "$pod" "$container" "$container_kind" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" >>"$output_file"
    # Each container gets its own follower. A long-lived sidecar must not keep
    # kubectl open after ton-node exits and hide a later restart generation.
    # Shutdown explicitly kills the owned kubectl child, so no stream timeout
    # is needed and a long download log is not replayed every minute.
    kubectl -n "$ns" logs "$pod" -c "$container" --timestamps=true \
      --follow --pod-running-timeout=15s >>"$output_file" 2>>"$error_file" || true
    [[ -e "$stop_file" ]] && break
    printf '\n===== previous %s container=%s snapshot %s =====\n' \
      "$container_kind" "$container" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" >>"$output_file"
    run_with_timeout "$STATUS_EXEC_TIMEOUT" kubectl -n "$ns" logs "$pod" -c "$container" \
      --timestamps=true --previous >>"$output_file" 2>>"$error_file" || true
    if [[ "$container_kind" == "init" ]] \
      && launch_session_init_container_completed "$ns" "$pod" "$expected_uid" "$container"; then
      return 0
    fi
    sleep 2
  done
}

launch_session_log_supervisor() {
  local launch_dir="$1"
  local ns="$2"
  local tonnode_name="$3"
  local selector stop_file row pod uid container_kind container key
  local -A seen=()

  selector="$(launch_session_selector "$tonnode_name")"
  stop_file="$launch_dir/.stop"
  trap 'terminate_owned_child_processes "$BASHPID"' EXIT
  trap 'terminate_owned_child_processes "$BASHPID"; exit 0' INT TERM
  while [[ ! -e "$stop_file" ]]; do
    while IFS=$'\t' read -r pod uid container_kind container; do
      pod="$(trim_whitespace "$pod")"
      uid="$(trim_whitespace "$uid")"
      container_kind="$(trim_whitespace "$container_kind")"
      container="$(trim_whitespace "$container")"
      [[ -z "$pod" || -z "$uid" || -z "$container" ]] && continue
      key="${pod}/${uid}/${container_kind}/${container}"
      [[ -n "${seen[$key]:-}" ]] && continue
      seen["$key"]=1
      launch_session_follow_one_container "$launch_dir" "$ns" "$pod" "$uid" "$container" "$container_kind" &
    done < <(run_with_timeout "$STATUS_EXEC_TIMEOUT" kubectl -n "$ns" get pods -l "$selector" \
      -o go-template='{{range .items}}{{$pod := .metadata.name}}{{$uid := .metadata.uid}}{{range .spec.initContainers}}{{$pod}}{{"\t"}}{{$uid}}{{"\tinit\t"}}{{.name}}{{"\n"}}{{end}}{{range .spec.containers}}{{$pod}}{{"\t"}}{{$uid}}{{"\tapp\t"}}{{.name}}{{"\n"}}{{end}}{{end}}' \
      2>>"$launch_dir/watcher-errors.log" || true)
    sleep 2
  done
}

resolve_operator_controller_deployment_name() {
  local deployment_rows row deployment_name="" count=0

  # The Helm fullname changes with RELEASE_NAME/nameOverride. Resolve the
  # controller by immutable release/role labels instead of assuming the
  # default release's rendered name. Keep OP_CONTROLLER_DEPLOYMENT as a
  # compatibility fallback for older or externally rendered installations.
  deployment_rows="$(kubectl -n "$OP_NAMESPACE" get deployment \
    -l "app.kubernetes.io/instance=${RELEASE_NAME},control-plane=controller-manager" \
    -o go-template='{{range .items}}{{.metadata.name}}{{"\n"}}{{end}}' 2>/dev/null || true)"
  while IFS= read -r row; do
    row="$(trim_whitespace "$row")"
    [[ -z "$row" ]] && continue
    deployment_name="$row"
    count=$((count + 1))
  done <<<"$deployment_rows"
  if (( count == 1 )); then
    printf '%s' "$deployment_name"
    return 0
  fi
  if (( count > 1 )); then
    return 1
  fi
  if kubectl -n "$OP_NAMESPACE" get deployment "$OP_CONTROLLER_DEPLOYMENT" >/dev/null 2>&1; then
    printf '%s' "$OP_CONTROLLER_DEPLOYMENT"
    return 0
  fi
  return 1
}

launch_session_operator_log_watch() {
  local launch_dir="$1"
  local stop_file="$launch_dir/.stop"
  local operator_deployment=""
  umask 077
  while [[ ! -e "$stop_file" ]]; do
    operator_deployment="$(resolve_operator_controller_deployment_name || true)"
    operator_deployment="$(trim_whitespace "$operator_deployment")"
    if [[ -z "$operator_deployment" ]]; then
      sleep 2
      continue
    fi
    printf '\n===== operator log connection %s =====\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" >>"$launch_dir/operator.log"
    kubectl -n "$OP_NAMESPACE" logs "deployment/${operator_deployment}" \
      --all-containers=true --prefix=true --timestamps=true --follow --pod-running-timeout=15s \
      >>"$launch_dir/operator.log" 2>>"$launch_dir/watcher-errors.log" || true
    [[ -e "$stop_file" ]] || sleep 2
  done
}

# Capture operational status, not configuration payloads. In particular this
# intentionally does not query Secret or ConfigMap objects: their names may be
# visible through normal workload status, but no Secret data is read into a
# launch evidence bundle.
launch_session_namespace_diagnostics() {
  local destination="$1"
  local label="$2"
  local ns="$3"
  local output_file

  ns="$(trim_whitespace "$ns")"
  [[ -n "$ns" ]] || return 0
  label="${label//[^A-Za-z0-9_.-]/_}"
  [[ -n "$label" ]] || label="namespace"
  output_file="$destination/${label}-diagnostics.txt"

  umask 077
  {
    printf '# Non-secret diagnostics for namespace %s; captured %s\n' "$ns" "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    printf '\n===== namespace =====\n'
    run_with_timeout "$STATUS_EXEC_TIMEOUT" kubectl get namespace "$ns" \
      -o custom-columns='NAME:.metadata.name,PHASE:.status.phase,CREATED:.metadata.creationTimestamp' || true
    printf '\n===== pods =====\n'
    run_with_timeout "$STATUS_EXEC_TIMEOUT" kubectl -n "$ns" get pods -o wide || true
    printf '\n===== pod status and eviction/scheduling reasons =====\n'
    run_with_timeout "$STATUS_EXEC_TIMEOUT" kubectl -n "$ns" get pods \
      -o custom-columns='NAME:.metadata.name,NODE:.spec.nodeName,PHASE:.status.phase,REASON:.status.reason,MESSAGE:.status.message,DELETING:.metadata.deletionTimestamp' || true
    printf '\n===== container restart and termination status =====\n'
    run_with_timeout "$STATUS_EXEC_TIMEOUT" kubectl -n "$ns" get pods \
      -o go-template='{{range .items}}{{$pod := .metadata.name}}{{range .status.initContainerStatuses}}{{$pod}}{{"\tinit\t"}}{{.name}}{{"\trestarts="}}{{.restartCount}}{{"\twaiting="}}{{if .state.waiting}}{{.state.waiting.reason}}{{end}}{{"\tterminated="}}{{if .state.terminated}}{{.state.terminated.reason}}{{"/exit="}}{{.state.terminated.exitCode}}{{end}}{{"\tlast="}}{{if .lastState.terminated}}{{.lastState.terminated.reason}}{{"/exit="}}{{.lastState.terminated.exitCode}}{{end}}{{"\n"}}{{end}}{{range .status.containerStatuses}}{{$pod}}{{"\tapp\t"}}{{.name}}{{"\trestarts="}}{{.restartCount}}{{"\twaiting="}}{{if .state.waiting}}{{.state.waiting.reason}}{{end}}{{"\tterminated="}}{{if .state.terminated}}{{.state.terminated.reason}}{{"/exit="}}{{.state.terminated.exitCode}}{{end}}{{"\tlast="}}{{if .lastState.terminated}}{{.lastState.terminated.reason}}{{"/exit="}}{{.lastState.terminated.exitCode}}{{end}}{{"\n"}}{{end}}{{end}}' || true
    printf '\n===== workloads =====\n'
    run_with_timeout "$STATUS_EXEC_TIMEOUT" kubectl -n "$ns" get deployment,daemonset,statefulset,replicaset,job,cronjob -o wide || true
    printf '\n===== services and endpoints =====\n'
    run_with_timeout "$STATUS_EXEC_TIMEOUT" kubectl -n "$ns" get service,endpoints,endpointslice -o wide || true
    printf '\n===== persistent volume claims =====\n'
    run_with_timeout "$STATUS_EXEC_TIMEOUT" kubectl -n "$ns" get pvc -o wide || true
    printf '\n===== leases =====\n'
    run_with_timeout "$STATUS_EXEC_TIMEOUT" kubectl -n "$ns" get lease.coordination.k8s.io -o wide || true
    printf '\n===== events =====\n'
    run_with_timeout "$STATUS_EXEC_TIMEOUT" kubectl -n "$ns" get events --sort-by=.metadata.creationTimestamp \
      -o custom-columns='FIRST:.firstTimestamp,LAST:.lastTimestamp,TYPE:.type,REASON:.reason,KIND:.involvedObject.kind,OBJECT:.involvedObject.name,COUNT:.count,MESSAGE:.message' || true
  } >"$output_file" 2>&1
}

launch_session_longhorn_storage_diagnostics() {
  local destination="$1"
  local ns="$2"
  local output_file="$destination/longhorn-storage.txt"
  local resource
  local -a resources=(
    volumes.longhorn.io
    engines.longhorn.io
    replicas.longhorn.io
    nodes.longhorn.io
    engineimages.longhorn.io
    backingimages.longhorn.io
  )

  ns="$(trim_whitespace "$ns")"
  [[ -n "$ns" ]] || return 0
  umask 077
  {
    printf '# Non-secret Longhorn storage diagnostics for namespace %s; captured %s\n' "$ns" "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    for resource in "${resources[@]}"; do
      printf '\n===== %s =====\n' "$resource"
      run_with_timeout "$STATUS_EXEC_TIMEOUT" kubectl -n "$ns" get "$resource" -o wide || true
    done
    printf '\n===== storage classes =====\n'
    run_with_timeout "$STATUS_EXEC_TIMEOUT" kubectl get storageclass \
      -o custom-columns='NAME:.metadata.name,PROVISIONER:.provisioner,RECLAIM:.reclaimPolicy,BINDING:.volumeBindingMode,DEFAULT:.metadata.annotations.storageclass\.kubernetes\.io/is-default-class' || true
  } >"$output_file" 2>&1
}

launch_session_victoria_resources_diagnostics() {
  local destination="$1"
  local label="$2"
  local ns="$3"
  local output_file resource
  local -a resources=(
    vmsingles.operator.victoriametrics.com
    vmagents.operator.victoriametrics.com
    vmauths.operator.victoriametrics.com
    vmusers.operator.victoriametrics.com
    vmservicescrapes.operator.victoriametrics.com
    vmpodscrapes.operator.victoriametrics.com
    vmnodescrapes.operator.victoriametrics.com
  )

  ns="$(trim_whitespace "$ns")"
  [[ -n "$ns" ]] || return 0
  label="${label//[^A-Za-z0-9_.-]/_}"
  [[ -n "$label" ]] || label="victoria"
  output_file="$destination/${label}-resources.txt"
  umask 077
  {
    printf '# Non-secret Victoria resource diagnostics for namespace %s; captured %s\n' "$ns" "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    for resource in "${resources[@]}"; do
      printf '\n===== %s =====\n' "$resource"
      # Never use -o yaml/json here: VMUser can contain user-supplied auth
      # material in spec. Only retain generic reconciliation metadata/status.
      run_with_timeout "$STATUS_EXEC_TIMEOUT" kubectl -n "$ns" get "$resource" \
        -o custom-columns='NAME:.metadata.name,CREATED:.metadata.creationTimestamp,GENERATION:.metadata.generation,OBSERVED:.status.observedGeneration,UPDATE_STATUS:.status.updateStatus,REASON:.status.reason' || true
    done
  } >"$output_file" 2>&1
}

launch_session_victoria_namespace_diagnostics() {
  local destination="$1"
  local metrics_ns operator_ns logs_ns ns safe_ns seen_ns
  local -a namespaces=()

  metrics_ns="$(trim_whitespace "${VICTORIA_METRICS_NAMESPACE:-}")"
  operator_ns="$(trim_whitespace "${VICTORIA_METRICS_OPERATOR_NAMESPACE:-}")"
  logs_ns="$(victoria_logs_namespace 2>/dev/null || true)"
  logs_ns="$(trim_whitespace "$logs_ns")"

  for ns in "$metrics_ns" "$operator_ns" "$logs_ns"; do
    [[ -n "$ns" ]] || continue
    for seen_ns in "${namespaces[@]:-}"; do
      [[ "$seen_ns" == "$ns" ]] && continue 2
    done
    namespaces+=("$ns")
  done

  for ns in "${namespaces[@]:-}"; do
    safe_ns="${ns//[^A-Za-z0-9_.-]/_}"
    [[ -n "$safe_ns" ]] || safe_ns="namespace"
    launch_session_namespace_diagnostics "$destination" "victoria-${safe_ns}" "$ns"
    launch_session_victoria_resources_diagnostics "$destination" "victoria-${safe_ns}" "$ns"
  done
}

launch_session_snapshot() {
  local launch_dir="$1"
  local ns="$2"
  local tonnode_name="$3"
  local destination="$4"
  local selector

  selector="$(launch_session_selector "$tonnode_name")"
  (umask 077; mkdir -p "$destination") || return 1
  chmod 700 "$destination" 2>/dev/null || true
  run_with_timeout "$STATUS_EXEC_TIMEOUT" kubectl -n "$ns" get pods -l "$selector" -o wide \
    >"$destination/pods.txt" 2>&1 || true
  run_with_timeout "$STATUS_EXEC_TIMEOUT" kubectl -n "$ns" get pods -l "$selector" -o json \
    | if command -v jq >/dev/null 2>&1; then
        jq '{items:[.items[]|{metadata:{name:.metadata.name,namespace:.metadata.namespace,uid:.metadata.uid,creationTimestamp:.metadata.creationTimestamp,deletionTimestamp:.metadata.deletionTimestamp,labels:.metadata.labels,ownerReferences:.metadata.ownerReferences},spec:{nodeName:.spec.nodeName,nodeSelector:.spec.nodeSelector,affinity:.spec.affinity,volumes:.spec.volumes,initContainers:[.spec.initContainers[]?|{name,image,terminationMessagePolicy}],containers:[.spec.containers[]?|{name,image,ports,terminationMessagePolicy}]},status:.status}]}'
      else
        printf '{"warning":"jq is unavailable; redacted pod JSON was not captured"}\n'
      fi >"$destination/pods.json" 2>"$destination/pods-json.errors" || true
  run_with_timeout "$STATUS_EXEC_TIMEOUT" kubectl -n "$ns" get statefulset "$tonnode_name" \
    -o custom-columns='NAME:.metadata.name,REPLICAS:.spec.replicas,CURRENT:.status.currentReplicas,READY:.status.readyReplicas,UPDATED:.status.updatedReplicas,REVISION:.status.updateRevision' \
    >"$destination/statefulsets.txt" 2>&1 || true
  run_with_timeout "$STATUS_EXEC_TIMEOUT" kubectl -n "$ns" get tonnodes.ton.ton.org "$tonnode_name" \
    -o custom-columns='NAME:.metadata.name,GENERATION:.metadata.generation,OBSERVED:.status.observedGeneration,REPLICAS:.spec.replicas' \
    >"$destination/tonnodes.txt" 2>&1 || true
  run_with_timeout "$STATUS_EXEC_TIMEOUT" kubectl -n "$ns" get pvc -o wide >"$destination/pvcs.txt" 2>&1 || true
  run_with_timeout "$STATUS_EXEC_TIMEOUT" kubectl get pv -o custom-columns='NAME:.metadata.name,SC:.spec.storageClassName,PHASE:.status.phase,CLAIM_NS:.spec.claimRef.namespace,CLAIM:.spec.claimRef.name,NODE:.metadata.annotations.local\.path\.provisioner/selected-node,PATH:.spec.hostPath.path' \
    >"$destination/pvs.txt" 2>&1 || true
  run_with_timeout "$STATUS_EXEC_TIMEOUT" kubectl get volumeattachments.storage.k8s.io \
    -o custom-columns='NAME:.metadata.name,ATTACHER:.spec.attacher,NODE:.spec.nodeName,PV:.spec.source.persistentVolumeName,ATTACHED:.status.attached,ERROR:.status.attachError.message' \
    >"$destination/volumeattachments.txt" 2>&1 || true
  run_with_timeout "$STATUS_EXEC_TIMEOUT" kubectl get nodes \
    -o custom-columns='NAME:.metadata.name,UNSCHEDULABLE:.spec.unschedulable,TAINTS:.spec.taints,READY:.status.conditions[?(@.type=="Ready")].status,DISK_PRESSURE:.status.conditions[?(@.type=="DiskPressure")].status' \
    >"$destination/nodes.txt" 2>&1 || true
  run_with_timeout "$STATUS_EXEC_TIMEOUT" kubectl get csinode -o custom-columns='NAME:.metadata.name,DRIVERS:.spec.drivers[*].name' \
    >"$destination/csinodes.txt" 2>&1 || true
  run_with_timeout "$STATUS_EXEC_TIMEOUT" kubectl -n "$ns" get events --sort-by=.metadata.creationTimestamp >"$destination/events.txt" 2>&1 || true
  run_with_timeout "$STATUS_EXEC_TIMEOUT" kubectl get events --all-namespaces --sort-by=.metadata.creationTimestamp \
    >"$destination/events-cluster.txt" 2>&1 || true
  run_with_timeout "$STATUS_EXEC_TIMEOUT" kubectl -n "$OP_NAMESPACE" get pods -o wide >"$destination/operator-pods.txt" 2>&1 || true
  run_with_timeout "$STATUS_EXEC_TIMEOUT" kubectl -n "$LONGHORN_NAMESPACE" get pods -o wide >"$destination/longhorn-pods.txt" 2>&1 || true
  run_with_timeout "$STATUS_EXEC_TIMEOUT" kubectl -n "$VAULT_NAMESPACE" get pods -o wide >"$destination/vault-pods.txt" 2>&1 || true
  launch_session_namespace_diagnostics "$destination" operator "$OP_NAMESPACE" || true
  launch_session_namespace_diagnostics "$destination" longhorn "$LONGHORN_NAMESPACE" || true
  launch_session_namespace_diagnostics "$destination" vault "$VAULT_NAMESPACE" || true
  launch_session_longhorn_storage_diagnostics "$destination" "$LONGHORN_NAMESPACE" || true
  launch_session_victoria_namespace_diagnostics "$destination" || true
  chmod -R go-rwx "$destination" 2>/dev/null || true
}

launch_session_start_watchers() {
  local launch_dir="$1"
  local ns="$2"
  local tonnode_name="$3"

  KUBETON_LAUNCH_WATCHER_PIDS=()
  launch_session_event_watch "$launch_dir" "$ns" &
  KUBETON_LAUNCH_WATCHER_PIDS+=("$!")
  launch_session_cluster_event_watch "$launch_dir" &
  KUBETON_LAUNCH_WATCHER_PIDS+=("$!")
  launch_session_timeline_watch "$launch_dir" "$ns" "$tonnode_name" &
  KUBETON_LAUNCH_WATCHER_PIDS+=("$!")
  launch_session_log_supervisor "$launch_dir" "$ns" "$tonnode_name" &
  KUBETON_LAUNCH_WATCHER_PIDS+=("$!")
  launch_session_operator_log_watch "$launch_dir" &
  KUBETON_LAUNCH_WATCHER_PIDS+=("$!")
}

launch_session_stop_watchers() {
  local launch_dir="$1"
  local pid
  : >"$launch_dir/.stop"
  for pid in "${KUBETON_LAUNCH_WATCHER_PIDS[@]:-}"; do
    terminate_owned_process_tree "$pid" "$BASHPID"
  done
  for pid in "${KUBETON_LAUNCH_WATCHER_PIDS[@]:-}"; do
    wait "$pid" >/dev/null 2>&1 || true
  done
  KUBETON_LAUNCH_WATCHER_PIDS=()
}

run_with_launch_session() {
  local command_name="$1"
  local command_function="$2"
  shift 2
  local launch_dir ns tonnode_name replicas rc=0 tee_rc=0 interrupted_rc=0
  local stdout_fifo stderr_fifo command_pid="" stdout_tee_pid stderr_tee_pid stdout_tee_rc=0 stderr_tee_rc=0
  local caller_had_errexit=0 command_was_started=0

  [[ $- == *e* ]] && caller_had_errexit=1

  if ! is_true "$KUBETON_LAUNCH_LOGS_ENABLED"; then
    "$command_function" "$@"
    return $?
  fi

  ns="$(resolve_tonnode_namespace_from_values)"
  tonnode_name="$(resolve_tonnode_name_from_values)"
  replicas="$(resolve_ton_replicas_from_values_file "$TON_VALUES_FILE" 2>/dev/null || true)"
  launch_dir="$(launch_session_begin "$command_name")" || return 1
  KUBETON_ACTIVE_LAUNCH_DIR="$launch_dir"
  # Install signal handling before starting any watcher. The handler records
  # intent and stops only process trees whose PIDs are already known. Checks
  # on both sides of command PID assignment close the remaining spawn window.
  trap 'interrupted_rc=130; rc=130; terminate_owned_process_tree "$command_pid" "$BASHPID"; launch_session_stop_watchers "$launch_dir"' INT
  trap 'interrupted_rc=143; rc=143; terminate_owned_process_tree "$command_pid" "$BASHPID"; launch_session_stop_watchers "$launch_dir"' TERM
  trap 'interrupted_rc=129; rc=129; terminate_owned_process_tree "$command_pid" "$BASHPID"; launch_session_stop_watchers "$launch_dir"' HUP
  {
    printf 'ton_namespace=%s\n' "$ns"
    printf 'tonnode_name=%s\n' "$tonnode_name"
    printf 'desired_replicas=%s\n' "${replicas:-unknown}"
  } >>"$launch_dir/session.meta"
  launch_session_start_watchers "$launch_dir" "$ns" "$tonnode_name"
  stdout_fifo="$launch_dir/.stdout.pipe"
  stderr_fifo="$launch_dir/.stderr.pipe"
  if ! mkfifo "$stdout_fifo" "$stderr_fifo"; then
    echo "Error: cannot create launch transcript pipes in ${launch_dir}." >&2
    launch_session_stop_watchers "$launch_dir"
    trap - INT TERM HUP
    KUBETON_ACTIVE_LAUNCH_DIR=""
    return 1
  fi
  tee -a "$launch_dir/command.stdout.log" <"$stdout_fifo" &
  stdout_tee_pid="$!"
  tee -a "$launch_dir/command.stderr.log" <"$stderr_fifo" >&2 &
  stderr_tee_pid="$!"

  set +e
  if (( interrupted_rc == 0 )); then
    (set -e; "$command_function" "$@") >"$stdout_fifo" 2>"$stderr_fifo" &
    command_pid="$!"
    command_was_started=1
    # A signal can be delivered after the asynchronous command is spawned but
    # before its PID assignment becomes visible to the trap. Recheck here and
    # terminate the now-identifiable private command tree before waiting.
    if (( interrupted_rc != 0 )); then
      terminate_owned_process_tree "$command_pid" "$BASHPID"
    fi
    wait "$command_pid"
    rc=$?
    command_pid=""
  else
    rc="$interrupted_rc"
  fi
  if (( command_was_started == 1 )); then
    launch_session_drain_or_stop_tee "$stdout_tee_pid" "$BASHPID"
    launch_session_drain_or_stop_tee "$stderr_tee_pid" "$BASHPID"
  else
    terminate_owned_process_tree "$stdout_tee_pid" "$BASHPID"
    terminate_owned_process_tree "$stderr_tee_pid" "$BASHPID"
  fi
  wait "$stdout_tee_pid" || stdout_tee_rc=$?
  wait "$stderr_tee_pid" || stderr_tee_rc=$?
  rm -f "$stdout_fifo" "$stderr_fifo" >/dev/null 2>&1 || true
  if (( stdout_tee_rc != 0 )); then
    tee_rc="$stdout_tee_rc"
  elif (( stderr_tee_rc != 0 )); then
    tee_rc="$stderr_tee_rc"
  fi
  if (( tee_rc != 0 )); then
    echo "Warning: writing the launch command transcript failed with exit code ${tee_rc}; preserving the command result ${rc}." >&2
  fi

  {
    echo "===== STDOUT ====="
    cat "$launch_dir/command.stdout.log" 2>/dev/null || true
    echo "===== STDERR ====="
    cat "$launch_dir/command.stderr.log" 2>/dev/null || true
  } >"$launch_dir/command.log"

  launch_session_stop_watchers "$launch_dir"
  launch_session_snapshot "$launch_dir" "$ns" "$tonnode_name" "$launch_dir/final" || true
  if (( interrupted_rc != 0 )); then
    rc="$interrupted_rc"
  fi
  {
    printf 'finished_at=%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    printf 'exit_code=%s\n' "$rc"
  } >>"$launch_dir/session.meta"
  {
    printf 'kubeton %s exit code: %s\n' "$command_name" "$rc"
    printf 'TON target: %s/%s (desired replicas: %s)\n' "$ns" "$tonnode_name" "${replicas:-unknown}"
    printf 'Command transcript: %s/command.log\n' "$launch_dir"
    printf 'Pod/container log capture: %s/pods/\n' "$launch_dir"
    printf 'Lifecycle events: %s/events.log\n' "$launch_dir"
    printf 'Cluster-wide lifecycle events: %s/events-cluster.log\n' "$launch_dir"
    printf 'Final resource evidence: %s/final/\n' "$launch_dir"
  } >"$launch_dir/summary.txt"
  chmod -R go-rwx "$launch_dir" 2>/dev/null || true
  trap - INT TERM HUP
  echo "[launch] Evidence bundle: ${launch_dir}" >&2
  KUBETON_ACTIVE_LAUNCH_DIR=""
  if (( caller_had_errexit == 1 )); then
    set -e
  else
    set +e
  fi
  return "$rc"
}

print_prefixed_lines() {
  local prefix="$1"
  local text="${2:-}"
  if [[ -z "$text" ]]; then
    printf '%s<no output>\n' "$prefix"
    return
  fi
  printf '%s\n' "$text" | sed "s/^/${prefix}/"
}

yaml_quote() {
  local value="${1:-}"
  value="${value//\\/\\\\}"
  value="${value//\"/\\\"}"
  printf '"%s"' "$value"
}

json_quote() {
  local value="${1:-}"
  value="${value//\\/\\\\}"
  value="${value//\"/\\\"}"
  value="${value//$'\n'/\\n}"
  value="${value//$'\r'/}"
  value="${value//$'\t'/\\t}"
  printf '"%s"' "$value"
}

shell_quote() {
  local value="${1:-}"
  printf "'%s'" "$(printf '%s' "$value" | sed "s/'/'\\\\''/g")"
}

parse_selector_pairs() {
  local selector="$1"
  local -n out_pairs="$2"
  local -a tokens=()
  local token key value

  out_pairs=()
  selector="$(trim_whitespace "$selector")"
  [[ -z "$selector" ]] && return 0

  IFS=',' read -r -a tokens <<<"$selector"
  for token in "${tokens[@]}"; do
    token="$(trim_whitespace "$token")"
    [[ -z "$token" ]] && continue
    if [[ "$token" != *=* ]]; then
      echo "Error: invalid node selector token '${token}', expected key=value." >&2
      return 1
    fi
    key="$(trim_whitespace "${token%%=*}")"
    value="$(trim_whitespace "${token#*=}")"
    if [[ -z "$key" || -z "$value" ]]; then
      echo "Error: invalid node selector token '${token}', empty key or value." >&2
      return 1
    fi
    out_pairs+=("${key}=${value}")
  done
}

write_yaml_map_from_pairs() {
  local -n pairs_ref="$1"
  local indent="${2:-2}"
  local padding pair key value

  padding="$(printf '%*s' "$indent" '')"
  for pair in "${pairs_ref[@]}"; do
    key="${pair%%=*}"
    value="${pair#*=}"
    printf '%s%s: %s\n' "$padding" "$(yaml_quote "$key")" "$(yaml_quote "$value")"
  done
}

selector_pairs_to_longhorn_setting() {
  local -n pairs_ref="$1"
  local out="" pair key value

  for pair in "${pairs_ref[@]}"; do
    key="${pair%%=*}"
    value="${pair#*=}"
    [[ -n "$out" ]] && out+=";"
    out+="${key}:${value}"
  done
  printf '%s' "$out"
}

is_default_longhorn_node_selector() {
  local selector="$1"
  local -a selector_pairs=()

  parse_selector_pairs "$selector" selector_pairs || return 1
  [[ ${#selector_pairs[@]} -eq 1 && "${selector_pairs[0]}" == "node.longhorn.io/create-default-disk=true" ]]
}

desired_longhorn_node_count() {
  local desired="${KUBETON_TARGET_TON_REPLICAS:-}"
  if ! [[ "$desired" =~ ^[1-9][0-9]*$ ]]; then
    desired="${LONGHORN_DEFAULT_REPLICA_COUNT:-}"
  fi
  if ! [[ "$desired" =~ ^[1-9][0-9]*$ ]]; then
    desired="1"
  fi
  printf '%s' "$desired"
}

auto_label_default_longhorn_nodes() {
  local required_count="${1:-}"
  local -a target_nodes=()
  local -a matched_nodes=()
  local -A already_labeled=()
  local node
  local currently_labeled=0
  local labeled_now=0
  local max_count=0

  if ! [[ "$required_count" =~ ^[1-9][0-9]*$ ]]; then
    required_count="$(desired_longhorn_node_count)"
  fi

  mapfile -t matched_nodes < <(list_schedulable_nodes_by_selector 'node.longhorn.io/create-default-disk=true')
  currently_labeled="${#matched_nodes[@]}"
  if (( currently_labeled >= required_count )); then
    return 0
  fi
  for node in "${matched_nodes[@]}"; do
    [[ -z "$node" ]] && continue
    already_labeled["$node"]=1
  done

  mapfile -t target_nodes < <(list_schedulable_nodes_by_selector '!node-role.kubernetes.io/control-plane,!node-role.kubernetes.io/master')
  if [[ ${#target_nodes[@]} -eq 0 ]]; then
    mapfile -t target_nodes < <(kubectl get nodes -o jsonpath='{range .items[*]}{.metadata.name}{"\t"}{.spec.unschedulable}{"\n"}{end}' 2>/dev/null | awk -F'\t' '$2!="true"{print $1}' | awk 'NF' | sort)
  fi

  if [[ ${#target_nodes[@]} -eq 0 ]]; then
    echo "Error: automatic labeling failed; no Kubernetes nodes found." >&2
    return 1
  fi

  max_count="${#target_nodes[@]}"
  if (( required_count > max_count )); then
    echo "Warning: requested ${required_count} Longhorn node(s) for default selector but only ${max_count} node(s) are available." >&2
    required_count="$max_count"
  fi

  echo "[baremetal] Ensuring default Longhorn label on ${required_count} node(s) ..."
  for node in "${target_nodes[@]}"; do
    [[ -z "$node" ]] && continue
    if [[ -n "${already_labeled[$node]:-}" ]]; then
      continue
    fi
    if (( currently_labeled + labeled_now >= required_count )); then
      break
    fi
    kubectl label node "$node" node.longhorn.io/create-default-disk=true --overwrite >/dev/null
    ((labeled_now+=1))
  done
}

build_ton_node_selector_values_file() {
  local selector="$1"
  local -a selector_pairs=()
  local values_file

  parse_selector_pairs "$selector" selector_pairs || return 1
  if [[ ${#selector_pairs[@]} -eq 0 ]]; then
    echo "Error: LONGHORN_NODE_SELECTOR is set but has no valid key=value pairs." >&2
    return 1
  fi

  values_file="$(mktemp -t kubeton-ton-selector.XXXXXX.yaml)"
  {
    echo "tonNode:"
    echo "  nodeSelector:"
    write_yaml_map_from_pairs selector_pairs 4
  } >"$values_file"

  printf '%s' "$values_file"
}

resolve_ton_replicas_from_values_file() {
  local values_file="$1"
  local replicas=""

  [[ -f "$values_file" ]] || return 1
  replicas="$(awk '
    /^[[:space:]]*tonNode:[[:space:]]*$/ {in_ton=1; next}
    in_ton && /^[^[:space:]]/ {in_ton=0}
    in_ton && /^[[:space:]]*replicas:[[:space:]]*[0-9]+([[:space:]]|$)/ {
      sub(/.*replicas:[[:space:]]*/, "", $0)
      sub(/[[:space:]]*#.*/, "", $0)
      sub(/[[:space:]].*/, "", $0)
      print $0
      exit
    }
  ' "$values_file" 2>/dev/null || true)"

  if [[ "$replicas" =~ ^[1-9][0-9]*$ ]]; then
    printf '%s' "$replicas"
    return 0
  fi
  return 1
}

# Read one scalar from a nested tonNode value path without requiring yq. Values
# files are deliberately kept simple, and this also lets kubeton work from a
# downloaded chart directory with only standard shell tools available.
resolve_tonnode_path_scalar_from_values_file() {
  local values_file="$1"
  local target_path="$2"
  local value=""

  [[ -f "$values_file" ]] || return 1
  value="$(awk -v target_path="$target_path" '
    function trim(value) {
      sub(/^[ \t]+/, "", value)
      sub(/[ \t]+$/, "", value)
      return value
    }
    function leading_indent(value) {
      match(value, /^[ \t]*/)
      return RLENGTH
    }
    {
      line=$0
      if (line ~ /^[ \t]*$/ || line ~ /^[ \t]*#/) next

      indent=leading_indent(line)
      body=substr(line, indent + 1)
      if (body !~ /^[^:#][^:]*:/) next

      colon=index(body, ":")
      key=trim(substr(body, 1, colon - 1))
      raw_value=trim(substr(body, colon + 1))
      sub(/[ \t]+#.*/, "", raw_value)
      raw_value=trim(raw_value)

      if (!inside_ton) {
        if (indent == 0 && key == "tonNode" && raw_value == "") {
          inside_ton=1
          ton_indent=indent
          depth=0
        }
        next
      }

      if (indent <= ton_indent) exit
      while (depth > 0 && indent <= stack_indent[depth]) depth--

      if (raw_value == "") {
        depth++
        stack_indent[depth]=indent
        stack_key[depth]=key
        next
      }

      path=""
      for (i=1; i<=depth; i++) {
        path=path (path == "" ? "" : ".") stack_key[i]
      }
      path=path (path == "" ? "" : ".") key
      if (path == target_path) {
        print raw_value
        exit
      }
    }
  ' "$values_file" 2>/dev/null || true)"

  value="$(trim_whitespace "$value")"
  value="${value#\"}"
  value="${value%\"}"
  value="${value#\'}"
  value="${value%\'}"
  [[ -n "$value" ]] || return 1
  printf '%s' "$value"
}

resolve_effective_tonnode_path_scalar() {
  local target_path="$1"
  local values_file value

  for values_file in "$TON_VALUES_FILE" "$CHART_DIR/values.yaml"; do
    value="$(resolve_tonnode_path_scalar_from_values_file "$values_file" "$target_path" || true)"
    value="$(trim_whitespace "$value")"
    if [[ -n "$value" ]]; then
      printf '%s' "$value"
      return 0
    fi
  done
  return 1
}

# Helm replaces an array rather than merging its individual entries.  Treat a
# tonNode.env block in TON_VALUES_FILE the same way: once it is present, do not
# fall back to a same-named environment variable from chart defaults.
# Return 0 when a direct block-style tonNode.env override is present, 1 when
# there is no direct override, and 2 when the file uses a compact/inline env
# form that this shell parser cannot model safely. Consumers which require a
# literal value (for example requested HostPort discovery) fail closed.
tonnode_env_block_exists_in_values_file() {
  local values_file="$1"

  [[ -f "$values_file" ]] || return 1
  awk '
    function trim(value) {
      sub(/^[ \t]+/, "", value)
      sub(/[ \t]+$/, "", value)
      return value
    }
    function leading_indent(value) {
      match(value, /^[ \t]*/)
      return RLENGTH
    }
    {
      line=$0
      if (line ~ /^[ \t]*$/ || line ~ /^[ \t]*#/) next
      indent=leading_indent(line)
      body=substr(line, indent + 1)
      if (body !~ /^[^:#][^:]*:/) next
      colon=index(body, ":")
      key=trim(substr(body, 1, colon - 1))
      raw_value=trim(substr(body, colon + 1))
      sub(/[ \t]+#.*/, "", raw_value)
      raw_value=trim(raw_value)

      if (!inside_ton) {
        if (indent == 0 && key == "tonNode") {
          if (raw_value == "") {
            inside_ton=1
            ton_indent=indent
          } else if (raw_value ~ /^[{]/ && raw_value ~ /(^|[,{ \t])env[ \t]*:/) {
            unsafe=1
            exit
          }
        }
        next
      }
      if (indent <= ton_indent) exit
      if (ton_child_indent == "") ton_child_indent=indent
      if (indent == ton_child_indent && key == "env") {
        if (raw_value == "" || raw_value == "[]" || raw_value == "null" || raw_value == "~") {
          found=1
        } else {
          unsafe=1
        }
        exit
      }
    }
    END {
      if (unsafe) exit 2
      exit(found ? 0 : 1)
    }
  ' "$values_file" >/dev/null 2>&1
}

resolve_tonnode_env_value_from_values_file() {
  local values_file="$1"
  local wanted_name="$2"
  local value=""
  local awk_rc=0

  [[ -f "$values_file" ]] || return 1
  value="$(awk -v wanted_name="$wanted_name" '
    function trim(value) {
      sub(/^[ \t]+/, "", value)
      sub(/[ \t]+$/, "", value)
      return value
    }
    function unquote(value) {
      value=trim(value)
      sub(/^"/, "", value)
      sub(/"$/, "", value)
      sub(/^\047/, "", value)
      sub(/\047$/, "", value)
      return value
    }
    function leading_indent(value) {
      match(value, /^[ \t]*/)
      return RLENGTH
    }
    {
      line=$0
      if (line ~ /^[ \t]*$/ || line ~ /^[ \t]*#/) next
      indent=leading_indent(line)
      body=substr(line, indent + 1)
      if (body !~ /^[^:#][^:]*:/ && body !~ /^-[ \t]*[^:#][^:]*:/) next

      is_list_item=(body ~ /^-[ \t]*/)
      if (is_list_item) {
        sub(/^-[ \t]*/, "", body)
      }
      colon=index(body, ":")
      if (colon < 1) next
      key=trim(substr(body, 1, colon - 1))
      raw_value=trim(substr(body, colon + 1))
      sub(/[ \t]+#.*/, "", raw_value)
      raw_value=trim(raw_value)

      if (!inside_ton) {
        if (indent == 0 && key == "tonNode" && raw_value == "") {
          inside_ton=1
          ton_indent=indent
        }
        next
      }
      if (indent <= ton_indent) exit
      if (ton_child_indent == "") ton_child_indent=indent

      if (!inside_env) {
        if (indent == ton_child_indent && key == "env") {
          if (raw_value == "") {
            inside_env=1
            env_indent=indent
          }
        }
        next
      }
      if (indent <= env_indent) exit

      if (is_list_item && key == "name") {
        current_name=unquote(raw_value)
        next
      }
      if (current_name == wanted_name && key == "valueFrom") {
        saw_target=1
        unresolved=1
        found=0
        next
      }
      if (current_name == wanted_name && key == "value") {
        saw_target=1
        value=unquote(raw_value)
        found=1
        unresolved=0
      }
    }
    END {
      if (saw_target && found) {
        print value
        exit 0
      }
      if (saw_target && unresolved) exit 2
      exit 1
    }
  ' "$values_file" 2>/dev/null)" || awk_rc=$?

  if (( awk_rc == 2 )); then
    return 2
  fi
  (( awk_rc == 0 )) || return 1

  value="$(trim_whitespace "$value")"
  [[ -n "$value" ]] || return 1
  printf '%s' "$value"
}

resolve_effective_tonnode_env_value() {
  local wanted_name="$1"
  local value=""
  local resolve_rc=0 env_block_rc=0

  tonnode_env_block_exists_in_values_file "$TON_VALUES_FILE" || env_block_rc=$?
  if (( env_block_rc == 2 )); then
    return 3
  fi
  if (( env_block_rc == 0 )); then
    value="$(resolve_tonnode_env_value_from_values_file "$TON_VALUES_FILE" "$wanted_name")" || resolve_rc=$?
    (( resolve_rc == 2 )) && return 2
    (( resolve_rc == 0 )) || return 1
    value="$(trim_whitespace "$value")"
    [[ -n "$value" ]] || return 1
    printf '%s' "$value"
    return 0
  fi

  value="$(resolve_tonnode_env_value_from_values_file "$CHART_DIR/values.yaml" "$wanted_name")" || resolve_rc=$?
  (( resolve_rc == 2 )) && return 2
  (( resolve_rc == 0 )) || return 1
  value="$(trim_whitespace "$value")"
  [[ -n "$value" ]] || return 1
  printf '%s' "$value"
}

resolve_tonnode_node_selector_from_values_file() {
  local values_file="$1"
  local selector_rows=""

  [[ -f "$values_file" ]] || return 1
  selector_rows="$(awk '
    function trim(value) {
      sub(/^[ \t]+/, "", value)
      sub(/[ \t]+$/, "", value)
      return value
    }
    function leading_indent(value) {
      match(value, /^[ \t]*/)
      return RLENGTH
    }
    {
      line=$0
      if (line ~ /^[ \t]*$/ || line ~ /^[ \t]*#/) next

      indent=leading_indent(line)
      body=substr(line, indent + 1)
      if (body !~ /^[^:#][^:]*:/) next

      colon=index(body, ":")
      key=trim(substr(body, 1, colon - 1))
      raw_value=trim(substr(body, colon + 1))
      sub(/[ \t]+#.*/, "", raw_value)
      raw_value=trim(raw_value)

      if (!inside_ton) {
        if (indent == 0 && key == "tonNode" && raw_value == "") {
          inside_ton=1
          ton_indent=indent
        }
        next
      }
      if (indent <= ton_indent) exit

      if (!inside_selector) {
        if (key == "nodeSelector") {
          if (raw_value == "") {
            inside_selector=1
            selector_indent=indent
          } else if (raw_value == "{}") {
            exit
          } else if (raw_value ~ /^\{.*\}$/) {
            inline_selector=raw_value
            sub(/^\{[ \t]*/, "", inline_selector)
            sub(/[ \t]*\}$/, "", inline_selector)
            inline_count=split(inline_selector, inline_items, ",")
            for (inline_i=1; inline_i<=inline_count; inline_i++) {
              inline_item=trim(inline_items[inline_i])
              inline_colon=index(inline_item, ":")
              if (inline_colon < 2) continue
              inline_key=trim(substr(inline_item, 1, inline_colon - 1))
              inline_value=trim(substr(inline_item, inline_colon + 1))
              gsub(/^\"/, "", inline_key)
              gsub(/\"$/, "", inline_key)
              gsub(/^\047/, "", inline_key)
              gsub(/\047$/, "", inline_key)
              gsub(/^\"/, "", inline_value)
              gsub(/\"$/, "", inline_value)
              gsub(/^\047/, "", inline_value)
              gsub(/\047$/, "", inline_value)
              if (inline_key != "" && inline_value != "") print inline_key "=" inline_value
            }
            exit
          }
        }
        next
      }
      if (indent <= selector_indent) exit
      if (key ~ /^-/ || raw_value == "") next
      gsub(/^\"/, "", raw_value)
      gsub(/\"$/, "", raw_value)
      gsub(/^\047/, "", raw_value)
      gsub(/\047$/, "", raw_value)
      print key "=" raw_value
    }
  ' "$values_file" 2>/dev/null || true)"

  selector_rows="$(printf '%s\n' "$selector_rows" | awk 'NF' | sort -u)"
  [[ -n "$selector_rows" ]] || return 1
  printf '%s\n' "$selector_rows"
}

resolve_effective_tonnode_node_selector() {
  local values_file rows selector="" pair

  for values_file in "$TON_VALUES_FILE" "$CHART_DIR/values.yaml"; do
    rows="$(resolve_tonnode_node_selector_from_values_file "$values_file" || true)"
    rows="$(trim_whitespace "$rows")"
    [[ -n "$rows" ]] || continue
    while IFS= read -r pair; do
      pair="$(trim_whitespace "$pair")"
      [[ -n "$pair" ]] || continue
      [[ -n "$selector" ]] && selector+=","
      selector+="$pair"
    done <<<"$rows"
    break
  done

  printf '%s' "$selector"
}

quantity_to_millicores() {
  local quantity number suffix factor result

  quantity="$(trim_whitespace "${1:-}")"
  [[ "$quantity" == "<no value>" ]] && quantity=""
  [[ -z "$quantity" ]] && {
    printf '0'
    return 0
  }
  if ! [[ "$quantity" =~ ^([0-9]+([.][0-9]+)?|[.][0-9]+)(n|u|m)?$ ]]; then
    return 1
  fi
  number="${BASH_REMATCH[1]}"
  suffix="${BASH_REMATCH[3]:-}"
  case "$suffix" in
    n) factor="0.000001" ;;
    u) factor="0.001" ;;
    m) factor="1" ;;
    "") factor="1000" ;;
    *) return 1 ;;
  esac
  result="$(awk -v number="$number" -v factor="$factor" 'BEGIN {
    value=number*factor
    rounded=int(value)
    if (rounded < value) rounded++
    printf "%.0f", rounded
  }')"
  [[ "$result" =~ ^[0-9]+$ ]] || return 1
  printf '%s' "$result"
}

quantity_to_bytes() {
  local quantity number suffix factor result

  quantity="$(trim_whitespace "${1:-}")"
  [[ "$quantity" == "<no value>" ]] && quantity=""
  [[ -z "$quantity" ]] && {
    printf '0'
    return 0
  }
  if ! [[ "$quantity" =~ ^([0-9]+([.][0-9]+)?|[.][0-9]+)(Ki|Mi|Gi|Ti|Pi|Ei|K|M|G|T|P|E|m)?$ ]]; then
    return 1
  fi
  number="${BASH_REMATCH[1]}"
  suffix="${BASH_REMATCH[3]:-}"
  case "$suffix" in
    Ki) factor="1024" ;;
    Mi) factor="$((1024 ** 2))" ;;
    Gi) factor="$((1024 ** 3))" ;;
    Ti) factor="$((1024 ** 4))" ;;
    Pi) factor="$((1024 ** 5))" ;;
    Ei) factor="$((1024 ** 6))" ;;
    K) factor="1000" ;;
    M) factor="1000000" ;;
    G) factor="1000000000" ;;
    T) factor="1000000000000" ;;
    P) factor="1000000000000000" ;;
    E) factor="1000000000000000000" ;;
    m) factor="0.001" ;;
    "") factor="1" ;;
    *) return 1 ;;
  esac
  result="$(awk -v number="$number" -v factor="$factor" 'BEGIN {
    value=number*factor
    rounded=int(value)
    if (rounded < value) rounded++
    printf "%.0f", rounded
  }')"
  [[ "$result" =~ ^[0-9]+$ ]] || return 1
  printf '%s' "$result"
}

node_check_format_cpu() {
  local millicores="$1"
  [[ "$millicores" =~ ^[0-9]+$ ]] || {
    printf 'N/A'
    return
  }
  awk -v millicores="$millicores" 'BEGIN { printf "%.2f", millicores / 1000 }'
}

node_check_format_bytes() {
  local bytes="$1"
  [[ "$bytes" =~ ^[0-9]+$ ]] || {
    printf 'N/A'
    return
  }
  awk -v bytes="$bytes" 'BEGIN {
    if (bytes >= 1024*1024*1024*1024) {
      printf "%.2f Ti", bytes / 1024 / 1024 / 1024 / 1024
    } else if (bytes >= 1024*1024*1024) {
      printf "%.2f Gi", bytes / 1024 / 1024 / 1024
    } else if (bytes >= 1024*1024) {
      printf "%.2f Mi", bytes / 1024 / 1024
    } else {
      printf "%.0f B", bytes
    }
  }'
}

node_check_selector_join() {
  local selector="" item
  for item in "$@"; do
    item="$(trim_whitespace "$item")"
    [[ -n "$item" ]] || continue
    [[ -n "$selector" ]] && selector+=","
    selector+="$item"
  done
  printf '%s' "$selector"
}

selector_contains_selector_pairs() {
  local actual_selector="$1"
  local required_selector="$2"
  local -a actual_pairs=()
  local -a required_pairs=()
  local required_pair actual_pair found

  parse_selector_pairs "$actual_selector" actual_pairs || return 1
  parse_selector_pairs "$required_selector" required_pairs || return 1
  for required_pair in "${required_pairs[@]}"; do
    found=0
    for actual_pair in "${actual_pairs[@]}"; do
      if [[ "$actual_pair" == "$required_pair" ]]; then
        found=1
        break
      fi
    done
    (( found == 1 )) || return 1
  done
  return 0
}

node_check_prereq_label_selector() {
  printf '%s=%s' "$KUBETON_NODE_PREREQ_LABEL_KEY" "$KUBETON_NODE_PREREQ_LABEL_VALUE"
}

node_check_append_required_host_port() {
  local protocol="$1"
  local port="$2"
  local item existing

  protocol="${protocol^^}"
  case "$protocol" in
    TCP|UDP|SCTP)
      ;;
    *)
      return 1
      ;;
  esac
  if ! [[ "$port" =~ ^[0-9]+$ ]] || (( port < 1 || port > 65535 )); then
    return 1
  fi

  item="${protocol}/${port}"
  for existing in "${KUBETON_NODE_CHECK_REQUIRED_HOST_PORTS[@]}"; do
    [[ "$existing" == "$item" ]] && return 0
  done
  KUBETON_NODE_CHECK_REQUIRED_HOST_PORTS+=("$item")
}

node_check_resolve_network_host_port() {
  local path="$1"
  local default_port="$2"
  local port=""

  port="$(resolve_effective_tonnode_path_scalar "$path" || true)"
  port="$(trim_whitespace "$port")"
  port="${port:-$default_port}"
  if ! [[ "$port" =~ ^[0-9]+$ ]] || (( port < 1 || port > 65535 )); then
    echo "Error: cannot safely determine tonNode.${path} for host-port preflight." >&2
    return 1
  fi
  printf '%s' "$port"
}

# The lightweight values reader intentionally supports only block-style YAML.
# An inline tonNode/network map is valid Helm YAML but could hide a custom
# requested hostPort from this preflight, so reject it rather than fall back to
# a chart default and let kube-scheduler discover the conflict later.
tonnode_network_uses_inline_map_in_values_file() {
  local values_file="$1"

  [[ -f "$values_file" ]] || return 1
  awk '
    function trim(value) {
      sub(/^[ \t]+/, "", value)
      sub(/[ \t]+$/, "", value)
      return value
    }
    function leading_indent(value) {
      match(value, /^[ \t]*/)
      return RLENGTH
    }
    {
      line=$0
      if (line ~ /^[ \t]*$/ || line ~ /^[ \t]*#/) next
      indent=leading_indent(line)
      body=substr(line, indent + 1)
      if (body !~ /^[^:#][^:]*:/) next

      colon=index(body, ":")
      key=trim(substr(body, 1, colon - 1))
      raw_value=trim(substr(body, colon + 1))
      sub(/[ \t]+#.*/, "", raw_value)
      raw_value=trim(raw_value)

      if (!inside_ton) {
        if (indent == 0 && key == "tonNode") {
          if (raw_value == "") {
            inside_ton=1
            ton_indent=indent
          } else if (raw_value ~ /[{]/) {
            unsafe=1
            exit
          }
        }
        next
      }
      if (indent <= ton_indent) exit
      if (ton_child_indent == "") ton_child_indent=indent
      if (indent == ton_child_indent && key == "network" && raw_value != "" && raw_value ~ /[{]/) {
        unsafe=1
        exit
      }
    }
    END { exit(unsafe ? 0 : 1) }
  ' "$values_file" >/dev/null 2>&1
}

# Resolve exactly the host ports that the controller will put on the TON pod.
# The exporter port is derived from CUSTOM_PARAMETERS, just as the controller
# does.  A same-name port is deduplicated, matching appendExporterContainerPort.
node_check_resolve_host_port_requirements() {
  local configured_enabled=""
  local validator_port quic_port liteserver_port
  local custom_parameters="" custom_parameters_rc=0
  local exporter_address exporter_port
  local values_file

  KUBETON_NODE_CHECK_REQUIRED_HOST_PORTS=()
  KUBETON_NODE_CHECK_HOST_PORT_CONFLICTS=()
  KUBETON_NODE_CHECK_HOST_PORTS_ENABLED=false

  for values_file in "$TON_VALUES_FILE" "$CHART_DIR/values.yaml"; do
    if tonnode_network_uses_inline_map_in_values_file "$values_file"; then
      echo "Error: ${values_file} uses an inline tonNode/network map that kubeton cannot safely preflight requested host ports." >&2
      return 1
    fi
  done

  configured_enabled="$(resolve_effective_tonnode_path_scalar "network.hostPortsEnabled" || true)"
  configured_enabled="$(trim_whitespace "$configured_enabled")"
  configured_enabled="${configured_enabled,,}"
  case "$configured_enabled" in
    ""|true|null|"~")
      KUBETON_NODE_CHECK_HOST_PORTS_ENABLED=true
      ;;
    false)
      return 0
      ;;
    *)
      echo "Error: cannot safely determine tonNode.network.hostPortsEnabled for host-port preflight." >&2
      return 1
      ;;
  esac

  validator_port="$(node_check_resolve_network_host_port "network.validatorPort" 30001)" || return 1
  quic_port="$(node_check_resolve_network_host_port "network.quicPort" 31001)" || return 1
  liteserver_port="$(node_check_resolve_network_host_port "network.liteServerPort" 30003)" || return 1
  node_check_append_required_host_port UDP "$validator_port" || return 1
  node_check_append_required_host_port UDP "$quic_port" || return 1
  node_check_append_required_host_port TCP "$liteserver_port" || return 1

  custom_parameters="$(resolve_effective_tonnode_env_value "CUSTOM_PARAMETERS")" || custom_parameters_rc=$?
  if (( custom_parameters_rc == 3 )); then
    echo "Error: TON_VALUES_FILE uses an inline tonNode.env form that kubeton cannot safely preflight requested host ports." >&2
    return 1
  fi
  # The controller cannot derive an exporter container port from an EnvVar
  # valueFrom either (it only has the literal EnvVar Value), so it is correct
  # to omit it here as well.
  if (( custom_parameters_rc == 0 )); then
    exporter_address="$(extract_exporter_address "$custom_parameters")"
    exporter_port="$(extract_exporter_port "$exporter_address")"
    if [[ "$exporter_port" =~ ^[0-9]+$ ]]; then
      node_check_append_required_host_port TCP "$exporter_port" || return 1
    fi
  fi
}

node_check_append_host_port_conflict() {
  local node="$1"
  local detail="$2"
  local existing="${KUBETON_NODE_CHECK_HOST_PORT_CONFLICTS[$node]:-}"

  if [[ -z "$existing" ]]; then
    KUBETON_NODE_CHECK_HOST_PORT_CONFLICTS["$node"]="$detail"
  elif [[ ";${existing};" != *";${detail};"* ]]; then
    KUBETON_NODE_CHECK_HOST_PORT_CONFLICTS["$node"]+="; ${detail}"
  fi
}

# Kube-scheduler reserves hostPorts from assigned, non-terminal Pods.  Model
# that exact scheduling constraint before kubeton labels nodes and creates a
# StatefulSet. Existing Pods belonging to this same TonNode are intentionally
# ignored: they are replaceable members of the fleet being started/upgraded.
node_check_collect_host_port_conflicts() {
  local pod_rows row node phase ns pod app_name managed_by instance owners ports
  local protocol port token key
  local target_ns target_name target_sts_uid
  local -A requested=()

  (( ${#KUBETON_NODE_CHECK_REQUIRED_HOST_PORTS[@]} > 0 )) || return 0
  for key in "${KUBETON_NODE_CHECK_REQUIRED_HOST_PORTS[@]}"; do
    requested["$key"]=1
  done

  target_ns="$(resolve_tonnode_namespace_from_values)"
  target_name="$(resolve_tonnode_name_from_values)"
  if ! target_sts_uid="$(kubectl -n "$target_ns" get statefulset "$target_name" --ignore-not-found -o jsonpath='{.metadata.uid}' 2>/dev/null)"; then
    echo "Error: cannot read the configured TonNode StatefulSet identity for host-port preflight." >&2
    return 1
  fi
  target_sts_uid="$(trim_whitespace "$target_sts_uid")"
  if ! pod_rows="$(kubectl get pods -A -o go-template='{{range .items}}{{if .spec.nodeName}}{{.spec.nodeName}}{{"\x1f"}}{{.status.phase}}{{"\x1f"}}{{.metadata.namespace}}{{"\x1f"}}{{.metadata.name}}{{"\x1f"}}{{with .metadata.labels}}{{index . "app.kubernetes.io/name"}}{{end}}{{"\x1f"}}{{with .metadata.labels}}{{index . "app.kubernetes.io/managed-by"}}{{end}}{{"\x1f"}}{{with .metadata.labels}}{{index . "app.kubernetes.io/instance"}}{{end}}{{"\x1f"}}{{range .metadata.ownerReferences}}{{if .controller}}controller{{end}}{{"/"}}{{.kind}}{{"/"}}{{.name}}{{"/"}}{{.uid}}{{","}}{{end}}{{"\x1f"}}{{range .spec.initContainers}}{{range .ports}}{{.protocol}}{{"/"}}{{.hostPort}}{{","}}{{end}}{{end}}{{range .spec.containers}}{{range .ports}}{{.protocol}}{{"/"}}{{.hostPort}}{{","}}{{end}}{{end}}{{"\n"}}{{end}}{{end}}' 2>/dev/null)"; then
    echo "Error: cannot list assigned Pod hostPort reservations for node preflight." >&2
    return 1
  fi

  while IFS=$'\x1f' read -r node phase ns pod app_name managed_by instance owners ports; do
    node="$(trim_whitespace "$node")"
    phase="$(trim_whitespace "$phase")"
    ns="$(trim_whitespace "$ns")"
    pod="$(trim_whitespace "$pod")"
    app_name="$(trim_whitespace "$app_name")"
    managed_by="$(trim_whitespace "$managed_by")"
    instance="$(trim_whitespace "$instance")"
    owners="$(trim_whitespace "$owners")"
    [[ -n "$node" && -n "$ns" && -n "$pod" ]] || continue
    case "$phase" in
      Succeeded|Failed) continue ;;
    esac
    if [[ -n "$target_sts_uid" && "$ns" == "$target_ns" && "$app_name" == "ton-node" && "$managed_by" == "ton-k8s-operator" && "$instance" == "$target_name" && ",${owners}," == *",controller/StatefulSet/${target_name}/${target_sts_uid},"* ]]; then
      continue
    fi

    IFS=',' read -r -a port_tokens <<<"${ports:-}"
    for token in "${port_tokens[@]}"; do
      token="$(trim_whitespace "$token")"
      [[ -n "$token" ]] || continue
      protocol="${token%%/*}"
      port="${token#*/}"
      protocol="${protocol^^}"
      [[ -n "$protocol" ]] || protocol="TCP"
      [[ "$protocol" =~ ^(TCP|UDP|SCTP)$ && "$port" =~ ^[0-9]+$ ]] || continue
      (( port > 0 )) || continue
      key="${protocol}/${port}"
      [[ -n "${requested[$key]:-}" ]] || continue
      node_check_append_host_port_conflict "$node" "${key} by ${ns}/${pod}"
    done
  done <<<"$pod_rows"
}

resolve_ton_replicas_for_node_check() {
  local replicas=""
  replicas="$(resolve_ton_replicas_from_values_file "$TON_VALUES_FILE" || true)"
  if ! [[ "$replicas" =~ ^[1-9][0-9]*$ ]]; then
    replicas="$(resolve_ton_replicas_from_values_file "$CHART_DIR/values.yaml" || true)"
  fi
  [[ "$replicas" =~ ^[1-9][0-9]*$ ]] || return 1
  printf '%s' "$replicas"
}

resolve_node_check_requirements() {
  local ton_cpu ton_memory min_cpu min_memory work source core ctrl headroom
  local ton_cpu_milli ton_memory_bytes min_cpu_milli min_memory_bytes
  local work_bytes source_bytes core_bytes ctrl_bytes headroom_bytes

  ton_cpu="$(resolve_effective_tonnode_path_scalar "resources.requests.cpu" || true)"
  ton_memory="$(resolve_effective_tonnode_path_scalar "resources.requests.memory" || true)"
  min_cpu="$(trim_whitespace "$KUBETON_CHECK_MIN_CPU")"
  min_memory="$(trim_whitespace "$KUBETON_CHECK_MIN_MEMORY")"
  work="$(resolve_effective_tonnode_path_scalar "storage.tonWorkSize" || true)"
  source="$(resolve_effective_tonnode_path_scalar "storage.tonSourceSize" || true)"
  core="$(resolve_effective_tonnode_path_scalar "storage.myTonCoreSize" || true)"
  ctrl="$(resolve_effective_tonnode_path_scalar "storage.myTonCtrlSize" || true)"
  headroom="$(trim_whitespace "$KUBETON_CHECK_DISK_HEADROOM")"

  ton_cpu_milli="$(quantity_to_millicores "$ton_cpu" || true)"
  ton_memory_bytes="$(quantity_to_bytes "$ton_memory" || true)"
  min_cpu_milli="$(quantity_to_millicores "$min_cpu" || true)"
  min_memory_bytes="$(quantity_to_bytes "$min_memory" || true)"
  work_bytes="$(quantity_to_bytes "$work" || true)"
  source_bytes="$(quantity_to_bytes "$source" || true)"
  core_bytes="$(quantity_to_bytes "$core" || true)"
  ctrl_bytes="$(quantity_to_bytes "$ctrl" || true)"
  headroom_bytes="$(quantity_to_bytes "$headroom" || true)"

  if ! [[ "$ton_cpu_milli" =~ ^[0-9]+$ && "$ton_memory_bytes" =~ ^[0-9]+$ \
    && "$min_cpu_milli" =~ ^[0-9]+$ && "$min_memory_bytes" =~ ^[0-9]+$ \
    && "$work_bytes" =~ ^[0-9]+$ && "$source_bytes" =~ ^[0-9]+$ \
    && "$core_bytes" =~ ^[0-9]+$ && "$ctrl_bytes" =~ ^[0-9]+$ \
    && "$headroom_bytes" =~ ^[0-9]+$ ]]; then
    echo "Error: unable to parse TON node prerequisite quantities from ${TON_VALUES_FILE}." >&2
    echo "Check tonNode.resources.requests, tonNode.storage, and KUBETON_CHECK_* overrides." >&2
    return 1
  fi

  KUBETON_NODE_CHECK_REQUIRED_CPU_MILLI="$ton_cpu_milli"
  if (( min_cpu_milli > KUBETON_NODE_CHECK_REQUIRED_CPU_MILLI )); then
    KUBETON_NODE_CHECK_REQUIRED_CPU_MILLI="$min_cpu_milli"
  fi
  KUBETON_NODE_CHECK_REQUIRED_MEMORY_BYTES="$ton_memory_bytes"
  if (( min_memory_bytes > KUBETON_NODE_CHECK_REQUIRED_MEMORY_BYTES )); then
    KUBETON_NODE_CHECK_REQUIRED_MEMORY_BYTES="$min_memory_bytes"
  fi
  KUBETON_NODE_CHECK_TON_DATA_BYTES=$((work_bytes + source_bytes + core_bytes + ctrl_bytes))
  KUBETON_NODE_CHECK_DISK_HEADROOM_BYTES="$headroom_bytes"
  KUBETON_NODE_CHECK_REQUIRED_DISK_BYTES=$((KUBETON_NODE_CHECK_TON_DATA_BYTES + headroom_bytes))
}

node_filesystem_available_bytes() {
  local node="$1"
  local summary bytes

  if ! summary="$(kubectl get --raw "/api/v1/nodes/${node}/proxy/stats/summary" 2>/dev/null)"; then
    return 1
  fi
  if command -v jq >/dev/null 2>&1; then
    bytes="$(printf '%s' "$summary" | jq -r '.node.fs.availableBytes // empty' 2>/dev/null || true)"
  else
    bytes="$(printf '%s' "$summary" | tr '\n' ' ' | sed -nE 's/.*"fs"[[:space:]]*:[[:space:]]*\\{[^}]*"availableBytes"[[:space:]]*:[[:space:]]*([0-9]+).*/\1/p' | head -n1)"
  fi
  bytes="$(trim_whitespace "$bytes")"
  [[ "$bytes" =~ ^[0-9]+$ ]] || return 1
  printf '%s' "$bytes"
}

node_check_resource_pair() {
  local pair="$1"
  local -n cpu_ref="$2"
  local -n memory_ref="$3"
  local raw_cpu raw_memory parsed_cpu parsed_memory

  IFS=',' read -r raw_cpu raw_memory <<<"$pair"
  raw_cpu="$(trim_whitespace "${raw_cpu:-}")"
  raw_memory="$(trim_whitespace "${raw_memory:-}")"
  parsed_cpu="$(quantity_to_millicores "$raw_cpu" || true)"
  parsed_memory="$(quantity_to_bytes "$raw_memory" || true)"
  if ! [[ "$parsed_cpu" =~ ^[0-9]+$ && "$parsed_memory" =~ ^[0-9]+$ ]]; then
    return 1
  fi
  cpu_ref="$parsed_cpu"
  memory_ref="$parsed_memory"
}

collect_node_requested_resources() {
  local pod_rows row node phase ton_pod_label init_resources app_resources
  local pair cpu memory app_cpu app_memory init_cpu init_memory max_init_cpu max_init_memory

  KUBETON_NODE_CHECK_USED_CPU_MILLI=()
  KUBETON_NODE_CHECK_USED_MEMORY_BYTES=()
  # Use a non-whitespace separator. Bash collapses adjacent whitespace IFS
  # characters, which would otherwise shift empty labels/request columns and
  # could make an unlabelled pod's requests disappear from the calculation.
  if ! pod_rows="$(kubectl get pods -A -o go-template='{{range .items}}{{if .spec.nodeName}}{{.spec.nodeName}}{{"\x1f"}}{{.status.phase}}{{"\x1f"}}{{with .metadata.labels}}{{index . "app.kubernetes.io/name"}}{{end}}{{"\x1f"}}{{range .spec.initContainers}}{{.resources.requests.cpu}}{{","}}{{.resources.requests.memory}}{{";"}}{{end}}{{"\x1f"}}{{range .spec.containers}}{{.resources.requests.cpu}}{{","}}{{.resources.requests.memory}}{{";"}}{{end}}{{"\n"}}{{end}}{{end}}' 2>/dev/null)"; then
    echo "Error: cannot list assigned pod resource requests for node preflight." >&2
    return 1
  fi

  while IFS=$'\x1f' read -r node phase ton_pod_label init_resources app_resources; do
    node="$(trim_whitespace "$node")"
    phase="$(trim_whitespace "$phase")"
    ton_pod_label="$(trim_whitespace "${ton_pod_label:-}")"
    [[ -n "$node" ]] || continue
    case "$phase" in
      Succeeded|Failed) continue ;;
    esac
    # Existing TON pods are treated as replaceable fleet members. Their own
    # requests must not make an in-place start/upgrade fail the preflight;
    # all other assigned pod requests remain reserved.
    [[ "$ton_pod_label" == "ton-node" ]] && continue

    app_cpu=0
    app_memory=0
    IFS=';' read -r -a resource_pairs <<<"${app_resources:-}"
    for pair in "${resource_pairs[@]}"; do
      [[ -n "$pair" ]] || continue
      if ! node_check_resource_pair "$pair" cpu memory; then
        echo "Error: cannot parse resource request '${pair}' on a pod assigned to ${node}." >&2
        return 1
      fi
      app_cpu=$((app_cpu + cpu))
      app_memory=$((app_memory + memory))
    done

    max_init_cpu=0
    max_init_memory=0
    IFS=';' read -r -a resource_pairs <<<"${init_resources:-}"
    for pair in "${resource_pairs[@]}"; do
      [[ -n "$pair" ]] || continue
      if ! node_check_resource_pair "$pair" init_cpu init_memory; then
        echo "Error: cannot parse init-container resource request '${pair}' on a pod assigned to ${node}." >&2
        return 1
      fi
      (( init_cpu > max_init_cpu )) && max_init_cpu="$init_cpu"
      (( init_memory > max_init_memory )) && max_init_memory="$init_memory"
    done

    (( max_init_cpu > app_cpu )) && app_cpu="$max_init_cpu"
    (( max_init_memory > app_memory )) && app_memory="$max_init_memory"
    KUBETON_NODE_CHECK_USED_CPU_MILLI["$node"]=$(( ${KUBETON_NODE_CHECK_USED_CPU_MILLI[$node]:-0} + app_cpu ))
    KUBETON_NODE_CHECK_USED_MEMORY_BYTES["$node"]=$(( ${KUBETON_NODE_CHECK_USED_MEMORY_BYTES[$node]:-0} + app_memory ))
  done <<<"$pod_rows"
}

node_check_list_selector_nodes() {
  local selector="$1"
  local rows

  if [[ -n "$selector" ]]; then
    kubectl get nodes -l "$selector" -o jsonpath='{range .items[*]}{.metadata.name}{"\n"}{end}' 2>/dev/null
  else
    kubectl get nodes -o jsonpath='{range .items[*]}{.metadata.name}{"\n"}{end}' 2>/dev/null
  fi
}

node_check_scope_nodes() {
  local selector="$1"
  local rows node
  local -a nodes=()

  if ! rows="$(node_check_list_selector_nodes "$selector")"; then
    if [[ -n "$selector" ]]; then
      echo "Error: cannot resolve node selector '${selector}' for node preflight." >&2
    else
      echo "Error: cannot list Kubernetes nodes for node preflight." >&2
    fi
    return 1
  fi
  while IFS= read -r node; do
    node="$(trim_whitespace "$node")"
    [[ -n "$node" ]] && nodes+=("$node")
  done <<<"$rows"
  mapfile -t KUBETON_NODE_CHECK_SCOPE_NODES < <(printf '%s\n' "${nodes[@]}" | awk 'NF' | sort -u)
}

node_check_scope_contains() {
  local node="$1"
  local scope_node
  for scope_node in "${KUBETON_NODE_CHECK_SCOPE_NODES[@]}"; do
    [[ "$scope_node" == "$node" ]] && return 0
  done
  return 1
}

node_check_selector_is_all_compatible() {
  local selector="$1"
  local selector_rows node

  if ! selector_rows="$(node_check_list_selector_nodes "$selector")"; then
    echo "Error: cannot inspect nodes selected by '${selector:-all nodes}'." >&2
    return 1
  fi
  while IFS= read -r node; do
    node="$(trim_whitespace "$node")"
    [[ -n "$node" ]] || continue
    [[ "${KUBETON_NODE_CHECK_RESULT[$node]:-FAIL}" == "PASS" ]] || return 1
  done <<<"$selector_rows"
  return 0
}

run_node_prerequisite_check() {
  local required_nodes="$1"
  local selector="${2:-}"
  local node_rows row node unschedulable alloc_cpu alloc_memory conditions taints
  local basic_reason reason disk_bytes alloc_cpu_milli alloc_memory_bytes used_cpu used_memory free_cpu free_memory
  local target result cpu_display memory_display disk_display host_port_reason host_port_display

  [[ "$required_nodes" =~ ^[1-9][0-9]*$ ]] || {
    echo "Error: invalid required TON node count '${required_nodes}'." >&2
    return 1
  }
  resolve_node_check_requirements || return 1
  node_check_resolve_host_port_requirements || return 1
  node_check_scope_nodes "$selector" || return 1
  collect_node_requested_resources || return 1
  node_check_collect_host_port_conflicts || return 1

  KUBETON_NODE_CHECK_COMPATIBLE_NODES=()
  KUBETON_NODE_CHECK_RESULT=()
  KUBETON_NODE_CHECK_REASON=()
  KUBETON_NODE_CHECK_FREE_CPU_MILLI=()
  KUBETON_NODE_CHECK_FREE_MEMORY_BYTES=()
  KUBETON_NODE_CHECK_FREE_DISK_BYTES=()

  if ! node_rows="$(kubectl get nodes -o go-template='{{range .items}}{{.metadata.name}}{{"\t"}}{{.spec.unschedulable}}{{"\t"}}{{.status.allocatable.cpu}}{{"\t"}}{{.status.allocatable.memory}}{{"\t"}}{{range .status.conditions}}{{.type}}{{"="}}{{.status}}{{","}}{{end}}{{"\t"}}{{range .spec.taints}}{{.key}}{{"="}}{{.effect}}{{","}}{{end}}{{"\n"}}{{end}}' 2>/dev/null)"; then
    echo "Error: cannot read Kubernetes node status for node preflight." >&2
    return 1
  fi
  if [[ -z "$(trim_whitespace "$node_rows")" ]]; then
    echo "Error: node preflight found no Kubernetes nodes." >&2
    return 1
  fi

  echo "Node prerequisites from ${TON_VALUES_FILE}:"
  echo "  per TON pod: cpu >= $(node_check_format_cpu "$KUBETON_NODE_CHECK_REQUIRED_CPU_MILLI") cores, memory >= $(node_check_format_bytes "$KUBETON_NODE_CHECK_REQUIRED_MEMORY_BYTES")"
  echo "  local TON PVC capacity: $(node_check_format_bytes "$KUBETON_NODE_CHECK_TON_DATA_BYTES") (tonWork + tonSource + myTonCore + myTonCtrl)"
  echo "  node filesystem requirement: >= $(node_check_format_bytes "$KUBETON_NODE_CHECK_REQUIRED_DISK_BYTES") (configured local TON PVC capacity + $(node_check_format_bytes "$KUBETON_NODE_CHECK_DISK_HEADROOM_BYTES") headroom); disk data comes from the kubelet summary API"
  if [[ "$KUBETON_NODE_CHECK_HOST_PORTS_ENABLED" == "true" ]]; then
    echo "  required host ports: ${KUBETON_NODE_CHECK_REQUIRED_HOST_PORTS[*]} (other assigned Pod reservations make a node ineligible)"
  else
    echo "  required host ports: disabled"
  fi
  [[ -n "$selector" ]] && echo "  placement selector: ${selector}"
  printf '%-36s %-7s %-18s %-20s %-20s %-12s %s\n' "node" "target" "cpu free / need" "memory free / need" "node fs free / need" "host ports" "result"

  while IFS=$'\t' read -r node unschedulable alloc_cpu alloc_memory conditions taints; do
    node="$(trim_whitespace "$node")"
    [[ -n "$node" ]] || continue
    basic_reason=""
    if [[ "$unschedulable" == "true" ]]; then
      basic_reason="unschedulable"
    fi
    if [[ "$conditions" != *"Ready=True"* ]]; then
      basic_reason="${basic_reason:+${basic_reason}, }NotReady"
    fi
    for condition in DiskPressure MemoryPressure PIDPressure NetworkUnavailable; do
      if [[ "$conditions" == *"${condition}=True"* || "$conditions" == *"${condition}=Unknown"* ]]; then
        basic_reason="${basic_reason:+${basic_reason}, }${condition}"
      fi
    done
    if [[ "$taints" == *"=NoSchedule"* || "$taints" == *"=NoExecute"* ]]; then
      basic_reason="${basic_reason:+${basic_reason}, }hard taint"
    fi

    alloc_cpu_milli="$(quantity_to_millicores "$alloc_cpu" || true)"
    alloc_memory_bytes="$(quantity_to_bytes "$alloc_memory" || true)"
    used_cpu="${KUBETON_NODE_CHECK_USED_CPU_MILLI[$node]:-0}"
    used_memory="${KUBETON_NODE_CHECK_USED_MEMORY_BYTES[$node]:-0}"
    free_cpu=0
    free_memory=0
    if [[ "$alloc_cpu_milli" =~ ^[0-9]+$ ]]; then
      free_cpu=$((alloc_cpu_milli - used_cpu))
      (( free_cpu < 0 )) && free_cpu=0
    else
      basic_reason="${basic_reason:+${basic_reason}, }unreadable allocatable CPU"
    fi
    if [[ "$alloc_memory_bytes" =~ ^[0-9]+$ ]]; then
      free_memory=$((alloc_memory_bytes - used_memory))
      (( free_memory < 0 )) && free_memory=0
    else
      basic_reason="${basic_reason:+${basic_reason}, }unreadable allocatable memory"
    fi

    disk_bytes="$(node_filesystem_available_bytes "$node" || true)"
    if ! [[ "$disk_bytes" =~ ^[0-9]+$ ]]; then
      basic_reason="${basic_reason:+${basic_reason}, }unreadable node filesystem"
    fi
    if (( free_cpu < KUBETON_NODE_CHECK_REQUIRED_CPU_MILLI )); then
      basic_reason="${basic_reason:+${basic_reason}, }insufficient CPU"
    fi
    if (( free_memory < KUBETON_NODE_CHECK_REQUIRED_MEMORY_BYTES )); then
      basic_reason="${basic_reason:+${basic_reason}, }insufficient memory"
    fi
    if [[ "$disk_bytes" =~ ^[0-9]+$ ]] && (( disk_bytes < KUBETON_NODE_CHECK_REQUIRED_DISK_BYTES )); then
      basic_reason="${basic_reason:+${basic_reason}, }insufficient disk"
    fi
    host_port_reason="${KUBETON_NODE_CHECK_HOST_PORT_CONFLICTS[$node]:-}"
    if [[ "$KUBETON_NODE_CHECK_HOST_PORTS_ENABLED" == "true" ]]; then
      if [[ -n "$host_port_reason" ]]; then
        host_port_display="busy"
        basic_reason="${basic_reason:+${basic_reason}, }host ports in use (${host_port_reason})"
      else
        host_port_display="free"
      fi
    else
      host_port_display="disabled"
    fi

    KUBETON_NODE_CHECK_FREE_CPU_MILLI["$node"]="$free_cpu"
    KUBETON_NODE_CHECK_FREE_MEMORY_BYTES["$node"]="$free_memory"
    KUBETON_NODE_CHECK_FREE_DISK_BYTES["$node"]="${disk_bytes:-0}"
    target="no"
    node_check_scope_contains "$node" && target="yes"
    cpu_display="$(node_check_format_cpu "$free_cpu") / $(node_check_format_cpu "$KUBETON_NODE_CHECK_REQUIRED_CPU_MILLI")"
    memory_display="$(node_check_format_bytes "$free_memory") / $(node_check_format_bytes "$KUBETON_NODE_CHECK_REQUIRED_MEMORY_BYTES")"
    disk_display="$(node_check_format_bytes "$disk_bytes") / $(node_check_format_bytes "$KUBETON_NODE_CHECK_REQUIRED_DISK_BYTES")"

    if [[ -z "$basic_reason" ]]; then
      result="PASS"
      KUBETON_NODE_CHECK_RESULT["$node"]="PASS"
      if [[ "$target" == "yes" ]]; then
        KUBETON_NODE_CHECK_COMPATIBLE_NODES+=("$node")
      fi
    else
      result="FAIL: ${basic_reason}"
      KUBETON_NODE_CHECK_RESULT["$node"]="FAIL"
      KUBETON_NODE_CHECK_REASON["$node"]="$basic_reason"
    fi
    printf '%-36s %-7s %-18s %-20s %-20s %-12s %s\n' "$node" "$target" "$cpu_display" "$memory_display" "$disk_display" "$host_port_display" "$result"
  done <<<"$node_rows"

  # Prefer the roomiest eligible nodes so selected hosts retain the largest
  # buffer above the configured capacity requirement.
  mapfile -t KUBETON_NODE_CHECK_COMPATIBLE_NODES < <(
    for node in "${KUBETON_NODE_CHECK_COMPATIBLE_NODES[@]}"; do
      [[ -n "$node" ]] || continue
      printf '%020d\t%s\n' "${KUBETON_NODE_CHECK_FREE_DISK_BYTES[$node]:-0}" "$node"
    done | sort -r -n -k1,1 -k2,2 | awk -F'\t' 'NF >= 2 { print $2 }'
  )
  echo "Compatible target nodes: ${#KUBETON_NODE_CHECK_COMPATIBLE_NODES[@]}/${required_nodes} required."
  if (( ${#KUBETON_NODE_CHECK_COMPATIBLE_NODES[@]} < required_nodes )); then
    echo "Error: not enough compatible nodes for ${required_nodes} TON replica(s)." >&2
    echo "Each TON replica requires a distinct node because TON pods use required hostname anti-affinity." >&2
    return 1
  fi
  return 0
}

node_check_choose_compatible_nodes() {
  local required_nodes="$1"
  local -n selected_nodes_ref="$2"
  local node

  selected_nodes_ref=()
  for node in "${KUBETON_NODE_CHECK_COMPATIBLE_NODES[@]}"; do
    [[ -n "$node" ]] || continue
    selected_nodes_ref+=("$node")
    (( ${#selected_nodes_ref[@]} >= required_nodes )) && break
  done
  (( ${#selected_nodes_ref[@]} >= required_nodes ))
}

node_check_apply_managed_label() {
  local selected_nodes_name="$1"
  local -n selected_nodes_ref="$selected_nodes_name"
  local existing_rows node
  local -A selected=()

  for node in "${selected_nodes_ref[@]}"; do
    [[ -n "$node" ]] && selected["$node"]=1
  done
  if ! existing_rows="$(kubectl get nodes -l "${KUBETON_NODE_PREREQ_LABEL_KEY}=${KUBETON_NODE_PREREQ_LABEL_VALUE}" -o jsonpath='{range .items[*]}{.metadata.name}{"\n"}{end}' 2>/dev/null)"; then
    echo "Error: cannot inspect existing kubeton prerequisite node labels." >&2
    return 1
  fi
  while IFS= read -r node; do
    node="$(trim_whitespace "$node")"
    [[ -n "$node" && -z "${selected[$node]:-}" ]] || continue
    if ! kubectl label node "$node" "${KUBETON_NODE_PREREQ_LABEL_KEY}-" >/dev/null; then
      echo "Error: cannot remove stale kubeton prerequisite label from node ${node}." >&2
      return 1
    fi
  done <<<"$existing_rows"
  for node in "${selected_nodes_ref[@]}"; do
    if ! kubectl label node "$node" "${KUBETON_NODE_PREREQ_LABEL_KEY}=${KUBETON_NODE_PREREQ_LABEL_VALUE}" --overwrite >/dev/null; then
      echo "Error: cannot label compatible node ${node} for kubeton placement." >&2
      return 1
    fi
  done
}

node_check_apply_default_longhorn_label() {
  local selected_nodes_name="$1"
  local -n selected_nodes_ref="$selected_nodes_name"
  local -a selector_pairs=()
  local node pair

  parse_selector_pairs "$LONGHORN_NODE_SELECTOR" selector_pairs || return 1
  for node in "${selected_nodes_ref[@]}"; do
    for pair in "${selector_pairs[@]}"; do
      if ! kubectl label node "$node" "$pair" --overwrite >/dev/null; then
        echo "Error: cannot label compatible node ${node} for default Longhorn storage." >&2
        return 1
      fi
    done
  done
}

longhorn_daemonset_exists() {
  local daemonset="$1"
  kubectl -n "$LONGHORN_NAMESPACE" get daemonset "$daemonset" >/dev/null 2>&1
}

longhorn_manager_exists() {
  longhorn_daemonset_exists longhorn-manager
}

longhorn_daemonset_node_selector() {
  local daemonset="$1"
  local rows selector="" pair

  if ! rows="$(kubectl -n "$LONGHORN_NAMESPACE" get daemonset "$daemonset" \
    -o go-template='{{range $key,$value := .spec.template.spec.nodeSelector}}{{printf "%s=%s\n" $key $value}}{{end}}' 2>/dev/null)"; then
    return 1
  fi
  while IFS= read -r pair; do
    pair="$(trim_whitespace "$pair")"
    [[ -n "$pair" ]] || continue
    [[ -n "$selector" ]] && selector+=","
    selector+="$pair"
  done <<<"$rows"
  printf '%s' "$selector"
}

longhorn_manager_node_selector() {
  longhorn_daemonset_node_selector longhorn-manager
}

resolve_existing_longhorn_daemonset_selectors() {
  local names_name="$1"
  local selectors_name="$2"
  local -n names_ref="$names_name"
  local -n selectors_ref="$selectors_name"
  local daemonset selector

  names_ref=()
  selectors_ref=()
  for daemonset in longhorn-manager longhorn-csi-plugin; do
    if ! longhorn_daemonset_exists "$daemonset"; then
      echo "Error: existing Longhorn installation is missing daemonset ${LONGHORN_NAMESPACE}/${daemonset}." >&2
      return 1
    fi
    if ! selector="$(longhorn_daemonset_node_selector "$daemonset")"; then
      echo "Error: cannot read the node selector from existing Longhorn daemonset ${LONGHORN_NAMESPACE}/${daemonset}." >&2
      return 1
    fi
    names_ref+=("$daemonset")
    selectors_ref["$daemonset"]="$selector"
  done
}

node_check_print_failed_selector_nodes() {
  local selector="$1"
  local node

  while IFS= read -r node; do
    node="$(trim_whitespace "$node")"
    [[ -n "$node" ]] || continue
    [[ "${KUBETON_NODE_CHECK_RESULT[$node]:-FAIL}" == "PASS" ]] && continue
    echo "  - ${node}: ${KUBETON_NODE_CHECK_REASON[$node]:-failed node preflight}" >&2
  done < <(node_check_list_selector_nodes "$selector" || true)
}

node_check_verify_existing_longhorn_daemonsets() {
  local daemonset selector display_name

  for daemonset in "${KUBETON_NODE_CHECK_LONGHORN_DAEMONSETS[@]}"; do
    selector="${KUBETON_NODE_CHECK_LONGHORN_DAEMONSET_SELECTOR[$daemonset]:-}"
    if ! node_check_selector_is_all_compatible "$selector"; then
      case "$daemonset" in
        longhorn-manager) display_name="manager" ;;
        longhorn-csi-plugin) display_name="CSI plugin" ;;
        *) display_name="$daemonset" ;;
      esac
      echo "Error: an existing Longhorn ${display_name} targets node(s) that do not meet kubeton prerequisites." >&2
      node_check_print_failed_selector_nodes "$selector"
      echo "Refusing to change an existing Longhorn DaemonSet selector automatically; remediate or remove the failing node from its selector first." >&2
      return 1
    fi
  done
}

node_check_existing_longhorn_daemonsets_are_compatible() {
  local daemonset selector

  for daemonset in "${KUBETON_NODE_CHECK_LONGHORN_DAEMONSETS[@]}"; do
    selector="${KUBETON_NODE_CHECK_LONGHORN_DAEMONSET_SELECTOR[$daemonset]:-}"
    node_check_selector_is_all_compatible "$selector" || return 1
  done
}

longhorn_placement_may_be_reconfigured() {
  local volume_rows

  if ! volume_rows="$(kubectl -n "$LONGHORN_NAMESPACE" get volumes.longhorn.io -o name 2>/dev/null)"; then
    return 1
  fi
  [[ -z "$(trim_whitespace "$volume_rows")" ]]
}

node_check_required_longhorn_nodes() {
  local replicas="$1"
  local longhorn_replicas="$LONGHORN_DEFAULT_REPLICA_COUNT"

  if ! [[ "$longhorn_replicas" =~ ^[1-9][0-9]*$ ]]; then
    longhorn_replicas=1
  fi
  if (( longhorn_replicas > replicas )); then
    printf '%s' "$longhorn_replicas"
  else
    printf '%s' "$replicas"
  fi
}

resolve_workload_node_prerequisite_scope() {
  local replicas="$1"
  local use_longhorn="${2:-false}"
  local force_new_longhorn_placement="${3:-false}"
  local daemonset selector

  KUBETON_NODE_CHECK_TON_VALUES_SELECTOR="$(resolve_effective_tonnode_node_selector)"
  KUBETON_NODE_CHECK_SCOPE_SELECTOR="$KUBETON_NODE_CHECK_TON_VALUES_SELECTOR"
  KUBETON_NODE_CHECK_REQUIRED_NODES="$replicas"
  KUBETON_NODE_CHECK_EXISTING_LONGHORN=0
  KUBETON_NODE_CHECK_LONGHORN_MANAGER_SELECTOR=""
  KUBETON_NODE_CHECK_LONGHORN_DAEMONSETS=()
  KUBETON_NODE_CHECK_LONGHORN_DAEMONSET_SELECTOR=()

  if ! is_true "$use_longhorn"; then
    return 0
  fi

  KUBETON_NODE_CHECK_REQUIRED_NODES="$(node_check_required_longhorn_nodes "$replicas")"
  if longhorn_manager_exists && ! is_true "$force_new_longhorn_placement"; then
    KUBETON_NODE_CHECK_EXISTING_LONGHORN=1
    resolve_existing_longhorn_daemonset_selectors \
      KUBETON_NODE_CHECK_LONGHORN_DAEMONSETS \
      KUBETON_NODE_CHECK_LONGHORN_DAEMONSET_SELECTOR || return 1
    KUBETON_NODE_CHECK_LONGHORN_MANAGER_SELECTOR="${KUBETON_NODE_CHECK_LONGHORN_DAEMONSET_SELECTOR[longhorn-manager]:-}"
    for daemonset in "${KUBETON_NODE_CHECK_LONGHORN_DAEMONSETS[@]}"; do
      selector="${KUBETON_NODE_CHECK_LONGHORN_DAEMONSET_SELECTOR[$daemonset]:-}"
      KUBETON_NODE_CHECK_SCOPE_SELECTOR="$(node_check_selector_join "$KUBETON_NODE_CHECK_SCOPE_SELECTOR" "$selector")"
    done
  elif ! is_default_longhorn_node_selector "$LONGHORN_NODE_SELECTOR"; then
    KUBETON_NODE_CHECK_SCOPE_SELECTOR="$(node_check_selector_join "$KUBETON_NODE_CHECK_SCOPE_SELECTOR" "$LONGHORN_NODE_SELECTOR")"
  fi
}

reselect_empty_longhorn_placement() {
  local replicas="$1"

  if ! longhorn_placement_may_be_reconfigured; then
    return 1
  fi
  echo "[check] Existing Longhorn has no volumes; safely rebuilding its placement on compatible nodes."
  KUBETON_LONGHORN_PLACEMENT_RECONFIGURE=1
  resolve_workload_node_prerequisite_scope "$replicas" true true || return 1
  run_node_prerequisite_check "$KUBETON_NODE_CHECK_REQUIRED_NODES" "$KUBETON_NODE_CHECK_SCOPE_SELECTOR"
}

node_check_should_use_longhorn() {
  if longhorn_manager_exists; then
    return 0
  fi
  if storage_class_is_longhorn "$ENCRYPTED_SC_NAME"; then
    return 0
  fi
  if should_bootstrap_baremetal && ! cluster_is_k3d; then
    return 0
  fi
  return 1
}

run_node_prerequisite_check_readonly() {
  local replicas use_longhorn="false"

  replicas="$(resolve_ton_replicas_for_node_check || true)"
  if ! [[ "$replicas" =~ ^[1-9][0-9]*$ ]]; then
    echo "Error: cannot resolve tonNode.replicas from ${TON_VALUES_FILE}." >&2
    return 1
  fi
  if node_check_should_use_longhorn; then
    use_longhorn="true"
  fi
  if storage_class_is_longhorn "$ENCRYPTED_SC_NAME" && ! longhorn_manager_exists; then
    echo "Error: StorageClass ${ENCRYPTED_SC_NAME} uses driver.longhorn.io, but ${LONGHORN_NAMESPACE}/longhorn-manager is missing or unreadable." >&2
    return 1
  fi
  resolve_workload_node_prerequisite_scope "$replicas" "$use_longhorn" || return 1
  run_node_prerequisite_check "$KUBETON_NODE_CHECK_REQUIRED_NODES" "$KUBETON_NODE_CHECK_SCOPE_SELECTOR" || return 1
  if (( KUBETON_NODE_CHECK_EXISTING_LONGHORN == 1 )); then
    node_check_verify_existing_longhorn_daemonsets || return 1
    verify_ton_selected_nodes_longhorn_csi_ready "$KUBETON_NODE_CHECK_SCOPE_SELECTOR" || return 1
  fi
}

prepare_node_prerequisites_for_workload() {
  local replicas="$1"
  local use_longhorn="${2:-false}"
  local ton_selector prereq_selector
  local -a selected_nodes=()

  KUBETON_NODE_CHECK_TON_SELECTOR=""
  KUBETON_LONGHORN_PLACEMENT_RECONFIGURE=0
  if is_true "$KUBETON_SKIP_NODE_PREREQ_CHECK"; then
    echo "[check] KUBETON_SKIP_NODE_PREREQ_CHECK=true; skipping node resource and disk preflight." >&2
    return 0
  fi
  if ! [[ "$replicas" =~ ^[1-9][0-9]*$ ]]; then
    echo "Error: invalid TON replica count '${replicas}' for node preflight." >&2
    return 1
  fi

  resolve_workload_node_prerequisite_scope "$replicas" "$use_longhorn" || return 1
  if ! run_node_prerequisite_check "$KUBETON_NODE_CHECK_REQUIRED_NODES" "$KUBETON_NODE_CHECK_SCOPE_SELECTOR"; then
    if (( KUBETON_NODE_CHECK_EXISTING_LONGHORN == 1 )) && reselect_empty_longhorn_placement "$replicas"; then
      :
    else
      return 1
    fi
  fi

  if (( KUBETON_NODE_CHECK_EXISTING_LONGHORN == 1 )); then
    if node_check_existing_longhorn_daemonsets_are_compatible; then
      LONGHORN_NODE_SELECTOR="$KUBETON_NODE_CHECK_LONGHORN_MANAGER_SELECTOR"
      KUBETON_NODE_CHECK_TON_SELECTOR="$KUBETON_NODE_CHECK_SCOPE_SELECTOR"
      echo "[check] Existing Longhorn is already constrained to compatible node(s); leaving its placement unchanged."
      return 0
    fi
    if ! reselect_empty_longhorn_placement "$replicas"; then
      node_check_verify_existing_longhorn_daemonsets || return 1
    fi
  fi

  ton_selector="$KUBETON_NODE_CHECK_TON_VALUES_SELECTOR"
  if ! is_true "$use_longhorn" && ton_fleet_resources_exist; then
    echo "[check] Existing TON resources found; preserving their current node selector and local-path placement."
    return 0
  fi

  node_check_choose_compatible_nodes "$KUBETON_NODE_CHECK_REQUIRED_NODES" selected_nodes || {
    echo "Error: could not select ${KUBETON_NODE_CHECK_REQUIRED_NODES} compatible node(s)." >&2
    return 1
  }
  node_check_apply_managed_label selected_nodes || return 1
  prereq_selector="$(node_check_prereq_label_selector)"

  if is_true "$use_longhorn"; then
    if is_default_longhorn_node_selector "$LONGHORN_NODE_SELECTOR"; then
      node_check_apply_default_longhorn_label selected_nodes || return 1
    fi
    LONGHORN_NODE_SELECTOR="$(node_check_selector_join "$LONGHORN_NODE_SELECTOR" "$prereq_selector")"
    KUBETON_NODE_CHECK_TON_SELECTOR="$LONGHORN_NODE_SELECTOR"
  else
    KUBETON_NODE_CHECK_TON_SELECTOR="$(node_check_selector_join "$ton_selector" "$prereq_selector")"
  fi

  echo "[check] Selected compatible node(s): ${selected_nodes[*]}"
  echo "[check] TON placement will use: ${KUBETON_NODE_CHECK_TON_SELECTOR}"
}

run_check() {
  require_bin kubectl
  if [[ $# -ne 0 ]]; then
    echo "Error: usage: kubeton check" >&2
    return 1
  fi
  run_node_prerequisite_check_readonly
}

resolve_tonnode_scalar_from_values_file() {
  local values_file="$1"
  local key="$2"
  local value=""

  [[ -f "$values_file" ]] || return 1
  value="$(awk -v key="$key" '
    /^[[:space:]]*tonNode:[[:space:]]*$/ {in_ton=1; next}
    in_ton && /^[^[:space:]]/ {in_ton=0}
    in_ton && $0 ~ "^[[:space:]]*" key ":[[:space:]]*" {
      sub("^[[:space:]]*" key ":[[:space:]]*", "", $0)
      sub(/[[:space:]]*#.*/, "", $0)
      gsub(/^"/, "", $0)
      gsub(/"$/, "", $0)
      gsub(/^'\''/, "", $0)
      gsub(/'\''$/, "", $0)
      print $0
      exit
    }
  ' "$values_file" 2>/dev/null || true)"
  value="$(trim_whitespace "$value")"
  [[ -n "$value" ]] || return 1
  printf '%s' "$value"
}

resolve_tonnode_name_from_values() {
