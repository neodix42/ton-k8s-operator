victoria_logs_helm_release_is_gone() {
  local ns="$1"
  local release_name="$2"
  local release_rows namespace_row helm_help
  local -a helm_list_cmd=()

  if ! namespace_row="$(kubectl get namespace "$ns" --ignore-not-found -o name 2>/dev/null)"; then
    echo "Error: cannot verify namespace ${ns} while checking VictoriaLogs Helm release ${release_name}." >&2
    return 1
  fi
  namespace_row="$(trim_whitespace "$namespace_row")"
  [[ -z "$namespace_row" ]] && return 0

  # Helm's default Secret driver and legacy ConfigMap driver both label
  # release records this way. Read metadata only; never expose release data.
  if ! release_rows="$(kubectl -n "$ns" get secret,configmap \
    -l "owner=helm,name=${release_name}" --ignore-not-found \
    -o jsonpath='{range .items[*]}{.metadata.labels.name}{"\n"}{end}' 2>/dev/null)"; then
    echo "Error: cannot verify stored Helm metadata for VictoriaLogs release ${ns}/${release_name}." >&2
    return 1
  fi
  if printf '%s\n' "$release_rows" | grep -Fxq "$release_name"; then
    echo "Error: VictoriaLogs Helm release ${ns}/${release_name} still exists; retaining its cleanup ledger." >&2
    return 1
  fi

  # Also cover a non-default Helm storage driver. Helm 3 needs --all to show
  # every release state, while Helm 4 removed that flag and lists all states by
  # default. Detect the supported interface instead of pinning uninstall to
  # one Helm major version.
  if command -v helm >/dev/null 2>&1; then
    helm_list_cmd=(helm list -n "$ns" --short)
    helm_help="$(helm list --help 2>/dev/null || true)"
    if printf '%s\n' "$helm_help" | grep -Eq '(^|[[:space:]])--all([[:space:]]|$)'; then
      helm_list_cmd+=(--all)
    fi
    if ! release_rows="$("${helm_list_cmd[@]}" 2>/dev/null)"; then
      echo "Error: cannot verify whether VictoriaLogs Helm release ${ns}/${release_name} remains." >&2
      return 1
    fi
    if printf '%s\n' "$release_rows" | grep -Fxq "$release_name"; then
      echo "Error: VictoriaLogs Helm release ${ns}/${release_name} still exists; retaining its cleanup ledger." >&2
      return 1
    fi
  fi
  return 0
}

cleanup_victoria_logs_resources() {
  local ns state_ns release_name collector_release_name row
  local state_value service_name
  local access_selector='app.kubernetes.io/part-of=kubeton-victoria-logs,app.kubernetes.io/managed-by=kubeton'
  local cleanup_timeout all_backends_gone=1 all_collectors_gone=1
  local all_helm_releases_gone=1 storage_cleanup_complete=1
  local -a single_release_rows=()
  local -a collector_release_rows=()
  local -a pvc_rows=()

  ns="$(victoria_logs_namespace)"
  state_ns="$OP_NAMESPACE"
  if kubectl -n "$state_ns" get configmap "$VICTORIA_LOGS_STATE_CONFIGMAP" >/dev/null 2>&1; then
    :
  elif kubectl -n "$ns" get configmap "$VICTORIA_LOGS_STATE_CONFIGMAP" >/dev/null 2>&1; then
    state_ns="$ns"
  elif [[ -n "${VICTORIA_METRICS_OPERATOR_NAMESPACE:-}" ]] && kubectl -n "$VICTORIA_METRICS_OPERATOR_NAMESPACE" get configmap "$VICTORIA_LOGS_STATE_CONFIGMAP" >/dev/null 2>&1; then
    state_ns="$VICTORIA_METRICS_OPERATOR_NAMESPACE"
  fi
  cleanup_timeout="$(trim_whitespace "${VICTORIA_LOGS_CLEANUP_TIMEOUT_SECONDS:-300}")"
  [[ "$cleanup_timeout" =~ ^[1-9][0-9]*$ ]] || cleanup_timeout=300

  state_value="$(read_victoria_logs_state_value "$state_ns" "namespace")"
  state_value="$(trim_whitespace "$state_value")"
  if [[ -n "$state_value" ]]; then
    ns="$state_value"
  fi

  release_name="$(read_victoria_logs_state_value "$state_ns" "releaseName")"
  release_name="$(trim_whitespace "$release_name")"
  if [[ -z "$release_name" ]]; then
    release_name="$(victoria_logs_release_name)"
  fi

  collector_release_name="$(read_victoria_logs_state_value "$state_ns" "collectorReleaseName")"
  collector_release_name="$(trim_whitespace "$collector_release_name")"
  if [[ -z "$collector_release_name" ]]; then
    collector_release_name="$(victoria_logs_collector_release_name)"
  fi
  service_name="$(victoria_logs_service_name "$release_name")"
  append_unique_item "$ns"$'\t'"$release_name" single_release_rows
  append_unique_item "$ns"$'\t'"$collector_release_name" collector_release_rows
  if ! collect_victoria_logs_release_rows single_release_rows collector_release_rows; then
    KUBETON_RETAIN_VICTORIA_LOGS_GUARDS=1
    echo "Error: VictoriaLogs release inventory is incomplete; refusing destructive logging cleanup and retaining ingress protection and cleanup state." >&2
    cleanup_victoria_logs_port_forwards
    return 1
  fi

  echo "[uninstall] Disabling kubeton-managed VictoriaLogs access Services ..."
  # Keep ingress isolation in place until every unauthenticated backend Pod is
  # proven gone. Removing Service access is safe up front; removing the policy
  # before a stalled StatefulSet disappears would expose its chart Service.
  kubectl delete service -A -l "$access_selector" --ignore-not-found >/dev/null 2>&1 || true

  echo "[uninstall] Uninstalling VictoriaLogs releases ..."
  if command -v helm >/dev/null 2>&1; then
    for row in "${collector_release_rows[@]}"; do
      [[ -z "$row" ]] && continue
      IFS=$'\t' read -r ns collector_release_name <<<"$row"
      ns="$(trim_whitespace "$ns")"
      collector_release_name="$(trim_whitespace "$collector_release_name")"
      [[ -z "$ns" || -z "$collector_release_name" ]] && continue
      helm uninstall "$collector_release_name" -n "$ns" >/dev/null 2>&1 || true
    done
    for row in "${single_release_rows[@]}"; do
      [[ -z "$row" ]] && continue
      IFS=$'\t' read -r ns release_name <<<"$row"
      ns="$(trim_whitespace "$ns")"
      release_name="$(trim_whitespace "$release_name")"
      [[ -z "$ns" || -z "$release_name" ]] && continue
      helm uninstall "$release_name" -n "$ns" >/dev/null 2>&1 || true
    done
  else
    echo "Warning: helm is not installed; attempting best-effort kubectl cleanup for VictoriaLogs resources." >&2
  fi

  for row in "${collector_release_rows[@]}"; do
    [[ -z "$row" ]] && continue
    IFS=$'\t' read -r ns collector_release_name <<<"$row"
    ns="$(trim_whitespace "$ns")"
    collector_release_name="$(trim_whitespace "$collector_release_name")"
    [[ -z "$ns" || -z "$collector_release_name" ]] && continue
    kubectl -n "$ns" delete daemonset,serviceaccount -l "app.kubernetes.io/name=victoria-logs-collector,app.kubernetes.io/instance=${collector_release_name}" --ignore-not-found >/dev/null 2>&1 || true
    kubectl delete clusterrole,clusterrolebinding -l "app.kubernetes.io/name=victoria-logs-collector,app.kubernetes.io/instance=${collector_release_name}" --ignore-not-found >/dev/null 2>&1 || true
  done

  for row in "${single_release_rows[@]}"; do
    [[ -z "$row" ]] && continue
    IFS=$'\t' read -r ns release_name <<<"$row"
    ns="$(trim_whitespace "$ns")"
    release_name="$(trim_whitespace "$release_name")"
    [[ -z "$ns" || -z "$release_name" ]] && continue
    service_name="$(victoria_logs_service_name "$release_name")"
    kubectl -n "$ns" delete statefulset,service,configmap,secret -l "app.kubernetes.io/name=victoria-logs-single,app.kubernetes.io/instance=${release_name}" --ignore-not-found --wait=false >/dev/null 2>&1 || true
    collect_pvc_rows_by_prefix "server-volume-${service_name}-" pvc_rows \
      "app.kubernetes.io/name=victoria-logs-single,app.kubernetes.io/instance=${release_name}" true \
      || storage_cleanup_complete=0
  done

  for row in "${single_release_rows[@]}"; do
    [[ -z "$row" ]] && continue
    IFS=$'\t' read -r ns release_name <<<"$row"
    ns="$(trim_whitespace "$ns")"
    release_name="$(trim_whitespace "$release_name")"
    [[ -z "$ns" || -z "$release_name" ]] && continue
    wait_victoria_logs_backend_gone "$ns" "$release_name" "$cleanup_timeout" || all_backends_gone=0
  done

  for row in "${collector_release_rows[@]}"; do
    [[ -z "$row" ]] && continue
    IFS=$'\t' read -r ns collector_release_name <<<"$row"
    ns="$(trim_whitespace "$ns")"
    collector_release_name="$(trim_whitespace "$collector_release_name")"
    [[ -z "$ns" || -z "$collector_release_name" ]] && continue
    wait_victoria_logs_collector_gone "$ns" "$collector_release_name" "$cleanup_timeout" || all_collectors_gone=0
    victoria_logs_helm_release_is_gone "$ns" "$collector_release_name" || all_helm_releases_gone=0
  done

  for row in "${single_release_rows[@]}"; do
    [[ -z "$row" ]] && continue
    IFS=$'\t' read -r ns release_name <<<"$row"
    ns="$(trim_whitespace "$ns")"
    release_name="$(trim_whitespace "$release_name")"
    [[ -z "$ns" || -z "$release_name" ]] && continue
    victoria_logs_helm_release_is_gone "$ns" "$release_name" || all_helm_releases_gone=0
  done

  if (( all_backends_gone == 1 )); then
    delete_pvc_rows_and_backing_volumes pvc_rows "uninstall" || storage_cleanup_complete=0
  else
    storage_cleanup_complete=0
  fi

  if (( all_backends_gone == 1 )); then
    echo "[uninstall] VictoriaLogs backends are gone; deleting their retained ingress policies ..."
    kubectl delete networkpolicy -A -l "$access_selector" --ignore-not-found >/dev/null 2>&1 || true
  fi
  if (( all_backends_gone == 1 && all_collectors_gone == 1 \
      && all_helm_releases_gone == 1 && storage_cleanup_complete == 1 )); then
    echo "[uninstall] VictoriaLogs workloads, releases, and storage are gone; deleting their cleanup state ..."
    kubectl delete configmap -A -l 'app.kubernetes.io/name=kubeton-victoria-logs,app.kubernetes.io/managed-by=kubeton' --ignore-not-found >/dev/null 2>&1 || true
  else
    KUBETON_RETAIN_VICTORIA_LOGS_GUARDS=1
    echo "Error: VictoriaLogs cleanup is incomplete; its release ledger and any still-needed ingress NetworkPolicy were retained for a safe retry." >&2
  fi
  cleanup_victoria_logs_port_forwards
  (( all_backends_gone == 1 && all_collectors_gone == 1 \
    && all_helm_releases_gone == 1 && storage_cleanup_complete == 1 ))
}

cleanup_empty_observability_namespace() {
  local ns="$1" marker resources resource remaining item
  case "$ns" in ''|default|kube-*) return 0 ;; esac
  marker="$(kubectl get namespace "$ns" --ignore-not-found -o name)" || return 1
  [[ -n "$marker" ]] || return 0
  resources="$(kubectl api-resources --verbs=list,delete --namespaced=true -o name)" || return 1
  [[ -n "$(trim_whitespace "$resources")" ]] || return 1
  for resource in $resources; do
    case "$resource" in events|events.*) continue ;; esac
    if [[ "$resource" == configmaps* ]]; then
      remaining="$(kubectl -n "$ns" get "$resource" --ignore-not-found \
        -l 'app.kubernetes.io/name=kubeton-victoria-metrics,app.kubernetes.io/managed-by!=kubeton' -o name)" || return 1
      if [[ -n "$(trim_whitespace "$remaining")" ]]; then
        echo "[uninstall] Retaining shared observability namespace ${ns}: externally managed metrics ConfigMaps remain."
        return 0
      fi
      remaining="$(kubectl -n "$ns" get "$resource" --ignore-not-found \
        -l 'app.kubernetes.io/name!=kubeton-victoria-metrics' -o name)" || return 1
    else
      remaining="$(kubectl -n "$ns" get "$resource" --ignore-not-found -o name)" || return 1
    fi
    while IFS= read -r item; do
      case "$item" in ''|configmap/kube-root-ca.crt|serviceaccount/default) continue ;; esac
      echo "[uninstall] Retaining shared observability namespace ${ns}: ${item} remains."
      return 0
    done <<<"$remaining"
  done
  echo "[uninstall] Deleting empty recorded observability namespace ${ns} ..."
  kubectl delete namespace "$ns" --ignore-not-found --wait=true --timeout=60s >/dev/null
}

report_untracked_victoria_metrics_operator() {
  local resources="$1" candidate resource remaining operators ns name
  candidate="$(kubectl -n "$VICTORIA_METRICS_OPERATOR_NAMESPACE" get deployment "$VICTORIA_METRICS_OPERATOR_DEPLOYMENT" \
    --ignore-not-found -o name)" || {
    echo "Error: cannot inspect the configured VictoriaMetrics operator for untracked leftovers." >&2
    return 1
  }
  [[ -n "$(trim_whitespace "$candidate")" ]] || return 0
  for resource in $resources; do
    remaining="$(kubectl get "$resource" -A --ignore-not-found -o name)" || return 1
    if [[ -n "$(trim_whitespace "$remaining")" ]]; then
      echo "[uninstall] Retaining untracked shared VictoriaMetrics operator: ${resource} resources remain."
      return 0
    fi
  done
  operators="$(kubectl get deployments -A -l 'app.kubernetes.io/name=victoria-metrics-operator' \
    -o jsonpath='{range .items[*]}{.metadata.namespace}{"|"}{.metadata.name}{"\n"}{end}')" || return 1
  while IFS='|' read -r ns name; do
    [[ -n "$ns" && -n "$name" ]] || continue
    if [[ "$ns" != "$VICTORIA_METRICS_OPERATOR_NAMESPACE" || "$name" != "$VICTORIA_METRICS_OPERATOR_DEPLOYMENT" ]]; then
      echo "[uninstall] Retaining untracked VictoriaMetrics operator and shared cluster resources: another operator installation remains."
      return 0
    fi
  done <<<"$operators"
  echo "Error: unverified VictoriaMetrics operator remains at ${VICTORIA_METRICS_OPERATOR_NAMESPACE}/${VICTORIA_METRICS_OPERATOR_DEPLOYMENT}; its kubeton installation ledger and owned stack resources are missing. Ownership cannot be proven, so it was not deleted. Review this orphaned installation before retrying uninstall." >&2
  return 1
}

cleanup_victoria_metrics_resources() {
  local ns operator_ns stack_name state_ns state_name state_rows resources resource row component pvc pvc_inventory pv
  local rc=0 state_selector='app.kubernetes.io/name=kubeton-victoria-metrics,app.kubernetes.io/managed-by=kubeton'
  local selector='app.kubernetes.io/part-of=kubeton-victoria-metrics,app.kubernetes.io/managed-by=kubeton'
  local -a stacks=() operators=() namespaces=() vm_pvc_rows=() vm_exact_rows=() vm_pv_rows=()

  # Inventory all recorded installations before deleting any ledger. Current
  # environment defaults may differ from a previous invocation's namespaces.
  if ! state_rows="$(kubectl get configmap -A -l "$state_selector" \
      -o jsonpath='{range .items[*]}{.metadata.namespace}{"|"}{.metadata.name}{"|"}{.data.stackNamespace}{"|"}{.data.stackName}{"|"}{.data.operatorNamespace}{"\n"}{end}')"; then
    echo "Error: cannot inventory VictoriaMetrics cleanup state; retaining it for retry." >&2
    KUBETON_RETAIN_VICTORIA_METRICS_STATE=1
    return 1
  fi
  while IFS='|' read -r state_ns state_name ns stack_name operator_ns; do
    [[ -n "$state_ns" ]] || continue
    if [[ -z "$ns" || -z "$stack_name" ]]; then
      echo "Error: incomplete VictoriaMetrics cleanup record ${state_ns}/${state_name}; retaining it for review." >&2
      KUBETON_RETAIN_VICTORIA_METRICS_STATE=1
      return 1
    fi
    append_unique_item "$ns"$'\t'"$stack_name" stacks
    append_unique_item "${operator_ns:-$state_ns}" operators
    append_unique_item "$ns" namespaces
    append_unique_item "${operator_ns:-$state_ns}" namespaces
  done <<<"$state_rows"
  resources="$(kubectl api-resources --api-group=operator.victoriametrics.com --verbs=list --namespaced=true -o name)" || {
    KUBETON_RETAIN_VICTORIA_METRICS_STATE=1; return 1;
  }
  for resource in $resources; do
    case "$resource" in vmusers.*|vmauths.*|vmagents.*|vmsingles.*) ;; *) continue ;; esac
    if ! row="$(kubectl get "$resource" -A -l "$selector" \
        -o jsonpath='{range .items[*]}{.metadata.namespace}{"\t"}{.metadata.name}{"\n"}{end}')"; then
      KUBETON_RETAIN_VICTORIA_METRICS_STATE=1; return 1
    fi
    while IFS=$'\t' read -r ns stack_name; do
      [[ -n "$ns" && -n "$stack_name" ]] || continue
      append_unique_item "$ns"$'\t'"$stack_name" stacks
      # A previous CLI can lose its state ConfigMap while its explicitly owned
      # CRs still prove that a kubeton stack used the configured operator.
      append_unique_item "$VICTORIA_METRICS_OPERATOR_NAMESPACE" operators
      append_unique_item "$ns" namespaces
      append_unique_item "$VICTORIA_METRICS_OPERATOR_NAMESPACE" namespaces
    done <<<"$row"
  done
  cleanup_victoria_metrics_port_forwards
  cleanup_victoria_logs_resources || rc=1
  echo "[uninstall] Deleting kubeton-managed VictoriaMetrics resources ..."
  for row in "${stacks[@]}"; do
    IFS=$'\t' read -r ns stack_name <<<"$row"
    if pvc_inventory="$(kubectl -n "$ns" get pvc -l "app.kubernetes.io/name=vmsingle,app.kubernetes.io/instance=${stack_name}" \
        -o jsonpath='{range .items[*]}{.metadata.name}{"\n"}{end}')"; then
      while IFS= read -r pvc; do
        [[ -n "$pvc" ]] || continue
        append_unique_item "$ns"$'\t'"$pvc" vm_pvc_rows
        if ! pv="$(kubectl -n "$ns" get pvc "$pvc" -o jsonpath='{.spec.volumeName}')"; then
          rc=1
        elif [[ -n "$pv" ]]; then
          append_pv_cleanup_ledger_row_for_pv "$pv" "$ns/$pvc" vm_pv_rows || rc=1
          append_local_path_exact_cleanup_rows_for_pv "$pv" "$ns/$pvc" vm_exact_rows || rc=1
        fi
      done <<<"$pvc_inventory"
    else
      echo "Error: cannot inventory VictoriaMetrics storage in ${ns} for ${stack_name}." >&2
      rc=1
    fi
  done
  if (( ${#vm_pv_rows[@]} > 0 || ${#vm_exact_rows[@]} > 0 )); then
    record_local_path_cleanup_ledger vm_exact_rows vm_pv_rows || rc=1
  fi
  if (( rc != 0 )); then
    KUBETON_RETAIN_VICTORIA_METRICS_STATE=1
    echo "Error: VictoriaMetrics storage inventory or logging cleanup is incomplete; retaining metrics resources and cleanup state." >&2
    return 1
  fi
  cleanup_owned_namespaced_kinds "$selector" 'vmservicescrapes vmusers vmauths vmagents vmsingles services secrets' || rc=1
  for row in "${stacks[@]}"; do
    IFS=$'\t' read -r ns stack_name <<<"$row"
    for component in vmagent vmauth vmsingle; do
      # Children created by the VM operator carry its labels rather than
      # managed-by=kubeton. The recorded stack identity authorizes this scope.
      cleanup_owned_namespaced_kinds "app.kubernetes.io/name=${component},app.kubernetes.io/instance=${stack_name}" \
        'deployments statefulsets replicasets pods services configmaps secrets serviceaccounts' "$ns" || rc=1
    done
  done
  if (( rc == 0 )); then
    delete_pvc_rows_and_backing_volumes vm_pvc_rows "uninstall" || rc=1
  fi
  if (( ${#stacks[@]} == 0 && ${#operators[@]} == 0 )); then
    # Older teardown code could erase all ownership records before removing
    # the operator. Report that ambiguity instead of claiming full cleanup or
    # inferring permission to delete an independently installed operator.
    report_untracked_victoria_metrics_operator "$resources" || rc=1
  fi
  if (( rc == 0 )); then
    for operator_ns in "${operators[@]}"; do
      cleanup_victoria_metrics_operator "$operator_ns" || rc=1
    done
  fi
  if (( rc == 0 )); then
    for ns in "${namespaces[@]}"; do
      cleanup_empty_observability_namespace "$ns" || rc=1
    done
  fi
  if (( rc == 0 )); then
    kubectl delete configmap -A -l "$state_selector" --ignore-not-found --wait=true --timeout=60s >/dev/null || rc=1
  fi
  if (( rc != 0 )); then
    KUBETON_RETAIN_VICTORIA_METRICS_STATE=1
    echo "Error: VictoriaMetrics cleanup is incomplete; its installation state was retained for retry." >&2
  fi
  return "$rc"
}

run_uninstall_step() {
  local failures_name="$1"
  local description="$2"
  shift 2
  local -n failures_ref="$failures_name"

  echo "[uninstall] ${description}"
  if "$@"; then
    return 0
  fi

  echo "Warning: uninstall step failed: ${description}; continuing with remaining cleanup." >&2
  failures_ref+=("$description")
  return 0
}

namespace_has_retained_victoria_logs_guards() {
  local ns="$1"
  local guard_rows namespace_row
  local guard_selector='app.kubernetes.io/part-of=kubeton-victoria-logs,app.kubernetes.io/managed-by=kubeton'

  if ! namespace_row="$(kubectl get namespace "$ns" --ignore-not-found -o name 2>/dev/null)"; then
    echo "Error: cannot verify namespace ${ns} while VictoriaLogs cleanup guards are active." >&2
    return 2
  fi
  namespace_row="$(trim_whitespace "$namespace_row")"
  [[ -z "$namespace_row" ]] && return 1
  if ! guard_rows="$(kubectl -n "$ns" get networkpolicy,configmap \
      -l "$guard_selector" --ignore-not-found -o name 2>/dev/null)"; then
    echo "Error: cannot verify retained VictoriaLogs guards in namespace ${ns}." >&2
    return 2
  fi
  guard_rows="$(trim_whitespace "$guard_rows")"
  [[ -n "$guard_rows" ]]
}

refuse_guarded_namespace_deletion_if_needed() {
  local ns="$1"
  local guard_rc=0

  (( KUBETON_RETAIN_VICTORIA_LOGS_GUARDS == 1 )) || return 1
  if namespace_has_retained_victoria_logs_guards "$ns"; then
    echo "Error: retaining namespace ${ns} because it contains VictoriaLogs ingress protection or cleanup-ledger records for a backend that was not proven gone." >&2
    return 0
  else
    guard_rc=$?
  fi
  if (( guard_rc == 2 )); then
    echo "Error: refusing to delete namespace ${ns} because its VictoriaLogs guard state could not be verified." >&2
    return 0
  fi
  return 1
}

cleanup_operator_release() {
  local rc=0

  helm uninstall "$RELEASE_NAME" -n "$OP_NAMESPACE" >/dev/null 2>&1 || true
  if refuse_guarded_namespace_deletion_if_needed "$OP_NAMESPACE"; then
    return 1
  fi
  delete_namespace_with_progress "$OP_NAMESPACE" "$NAMESPACE_DELETE_PROGRESS_TIMEOUT" || rc=1
  return "$rc"
}

cleanup_vault_release() {
  local rc=0
  storage_namespace_is_release_owned "$VAULT_NAMESPACE" "$VAULT_RELEASE_NAME" vault || return 1
  if refuse_guarded_namespace_deletion_if_needed "$VAULT_NAMESPACE"; then return 1; fi
  uninstall_vault || rc=$?
  # A failed Helm request can still be recovered, but only a verified cleanup
  # may replace its failed status with success.
  cleanup_vault_force || return 1
  delete_namespace_with_progress "$VAULT_NAMESPACE" "$NAMESPACE_DELETE_PROGRESS_TIMEOUT" || return 1
  storage_release_present "$VAULT_RELEASE_NAME" "$VAULT_NAMESPACE" && return 1
  rc=$?
  (( rc == 1 )) || return 1
  return 0
}

cleanup_encrypted_storage_class() {
  local marker rows ns name storage_class
  if ! marker="$(kubectl get storageclass "$ENCRYPTED_SC_NAME" --ignore-not-found -o name 2>/dev/null)"; then
    echo "Error: cannot inspect StorageClass ${ENCRYPTED_SC_NAME} before cleanup." >&2
    return 1
  fi
  [[ -n "$(trim_whitespace "$marker")" ]] || return 0
  if ! rows="$(kubectl get pvc -A --no-headers -o custom-columns='NS:.metadata.namespace,NAME:.metadata.name,CLASS:.spec.storageClassName' 2>/dev/null)"; then
    echo "Error: cannot verify PVC users of StorageClass ${ENCRYPTED_SC_NAME}." >&2
    return 1
  fi
  while read -r ns name storage_class; do
    if [[ "$storage_class" == "$ENCRYPTED_SC_NAME" ]]; then
      echo "Error: retaining StorageClass ${ENCRYPTED_SC_NAME}: PVC ${ns}/${name} still uses it." >&2
      return 1
    fi
  done <<<"$rows"
  if ! rows="$(kubectl get pv --no-headers -o custom-columns='NAME:.metadata.name,CLASS:.spec.storageClassName' 2>/dev/null)"; then
    echo "Error: cannot verify PV users of StorageClass ${ENCRYPTED_SC_NAME}." >&2
    return 1
  fi
  while read -r name storage_class; do
    if [[ "$storage_class" == "$ENCRYPTED_SC_NAME" ]]; then
      echo "Error: retaining StorageClass ${ENCRYPTED_SC_NAME}: PersistentVolume ${name} still uses it." >&2
      return 1
    fi
  done <<<"$rows"
  if ! kubectl delete storageclass "$ENCRYPTED_SC_NAME" --ignore-not-found --wait=false >/dev/null 2>&1; then
    echo "Error: failed to delete StorageClass ${ENCRYPTED_SC_NAME}." >&2
    return 1
  fi
  if ! marker="$(kubectl get storageclass "$ENCRYPTED_SC_NAME" --ignore-not-found -o name 2>/dev/null)"; then
    echo "Error: cannot verify deletion of StorageClass ${ENCRYPTED_SC_NAME}." >&2
    return 1
  fi
  if [[ -n "$(trim_whitespace "$marker")" ]]; then
    echo "Error: StorageClass ${ENCRYPTED_SC_NAME} still exists; retry cleanup after deletion completes." >&2
    return 1
  fi
}

cleanup_longhorn_release() {
  local rc=0 ledger_rc=0
  local KUBETON_LONGHORN_OWNER_CACHE_ACTIVE=false
  local KUBETON_LONGHORN_OWNER_CACHE_NAMESPACE_UID=""
  local -A KUBETON_LONGHORN_PROVEN_OWNERS=()

  if (( KUBETON_RETAIN_VICTORIA_LOGS_GUARDS == 1 )); then
    echo "Error: refusing to uninstall Longhorn while a VictoriaLogs backend or its PVC cleanup is unresolved. Retry uninstall after VictoriaLogs is proven gone so launch evidence is not stranded." >&2
    return 1
  fi

  if storage_cleanup_ledger_has_pending_longhorn_targets; then
    echo "Error: refusing to uninstall Longhorn while the storage cleanup ledger still contains Longhorn volumes. Rerun kubeton uninstall after resolving the recorded storage cleanup." >&2
    return 1
  else
    ledger_rc=$?
  fi
  if (( ledger_rc == 2 )); then
    echo "Error: could not inspect the storage cleanup ledger before uninstalling Longhorn." >&2
    return 1
  fi

  longhorn_storage_is_unused || return 1
  if ! KUBETON_LONGHORN_OWNER_CACHE_NAMESPACE_UID="$(kubectl get namespace "$LONGHORN_NAMESPACE" --ignore-not-found -o jsonpath='{.metadata.uid}' 2>/dev/null)"; then
    echo "Error: cannot verify Longhorn namespace identity before uninstall." >&2
    return 1
  fi
  if [[ -n "$KUBETON_LONGHORN_OWNER_CACHE_NAMESPACE_UID" ]]; then
    KUBETON_LONGHORN_OWNER_CACHE_ACTIVE=true
  fi
  storage_namespace_is_release_owned "$LONGHORN_NAMESPACE" "$LONGHORN_RELEASE_NAME" longhorn || return 1
  uninstall_longhorn || rc=$?
  cleanup_longhorn_force || return 1
  delete_namespace_with_progress "$LONGHORN_NAMESPACE" "$NAMESPACE_DELETE_PROGRESS_TIMEOUT" || return 1
  storage_release_present "$LONGHORN_RELEASE_NAME" "$LONGHORN_NAMESPACE" && return 1
  rc=$?
  (( rc == 1 )) || return 1
  return 0
}

cleanup_observability_resources() {
  local rc=0

  cleanup_prometheus_resources || rc=1
  cleanup_grafana_resources || rc=1
  cleanup_victoria_metrics_resources || rc=1
  cleanup_main_wallet_resources || rc=1
  cleanup_kubeton_managed_labeled_resources || rc=1
  return "$rc"
}

collect_labeled_resource_leftovers() {
  local selector="$1"
  local rows_name="$2"
  local -n rows_ref="$rows_name"
  local resource ns name inventory resource_rows

  selector="$(trim_whitespace "$selector")"
  [[ -n "$selector" ]] || return 0

  if inventory="$(kubectl api-resources --verbs=list,delete --namespaced=true -o name 2>/dev/null)"; then
    if [[ -z "$(trim_whitespace "$inventory")" ]]; then
      append_unique_item "Namespaced resource discovery unavailable: empty inventory" rows_ref
    fi
    while IFS= read -r resource; do
      resource="$(trim_whitespace "$resource")"
      [[ -n "$resource" ]] || continue
      if ! resource_rows="$(kubectl get "$resource" -A -l "$selector" --no-headers \
          -o custom-columns='NS:.metadata.namespace,NAME:.metadata.name' 2>/dev/null)"; then
        append_unique_item "Managed-resource inventory unavailable: ${resource} across namespaces" rows_ref
        continue
      fi
      while read -r ns name; do
        [[ -n "$ns" && -n "$name" && "$name" != "<none>" ]] || continue
        append_unique_item "${resource} ${ns}/${name}" rows_ref
      done <<<"$resource_rows"
    done <<<"$inventory"
  else
    append_unique_item "Namespaced resource discovery unavailable" rows_ref
  fi

  if inventory="$(kubectl api-resources --verbs=list,delete --namespaced=false -o name 2>/dev/null)"; then
    if [[ -z "$(trim_whitespace "$inventory")" ]]; then
      append_unique_item "Cluster resource discovery unavailable: empty inventory" rows_ref
    fi
    while IFS= read -r resource; do
      resource="$(trim_whitespace "$resource")"
      [[ -n "$resource" ]] || continue
      if ! resource_rows="$(kubectl get "$resource" -l "$selector" --no-headers \
          -o custom-columns='NAME:.metadata.name' 2>/dev/null)"; then
        append_unique_item "Managed-resource inventory unavailable: ${resource} at cluster scope" rows_ref
        continue
      fi
      while IFS= read -r name; do
        name="$(trim_whitespace "$name")"
        [[ -n "$name" && "$name" != "<none>" ]] || continue
        append_unique_item "${resource} ${name}" rows_ref
      done <<<"$resource_rows"
    done <<<"$inventory"
  else
    append_unique_item "Cluster resource discovery unavailable" rows_ref
  fi
}

collect_uninstall_leftovers() {
  local rows_name="$1"
  local -n rows_ref="$rows_name"
  local ns name row release collector service_name pvc marker inventory_rc=0
  local -a candidate_pvcs=()
  local -a existing_pvcs=()
  local -a single_release_rows=()
  local -a collector_release_rows=()
  local -a vlogs_pvc_rows=()
  local -a storage_cluster_rows=()

  # Purge removes this CRD; an absent API is an idempotent success. A
  # discovery/list error is not proof that all TonNode instances disappeared.
  if marker="$(kubectl get crd tonnodes.ton.ton.org --ignore-not-found -o name 2>/dev/null)"; then
    if [[ -n "$(trim_whitespace "$marker")" ]]; then
      if row="$(kubectl get tonnodes.ton.ton.org -A -o jsonpath='{range .items[*]}{.metadata.namespace}{"\t"}{.metadata.name}{"\n"}{end}' 2>/dev/null)"; then
        while IFS=$'\t' read -r ns name; do
          [[ -n "$ns" && -n "$name" ]] || continue
          append_unique_item "TonNode ${ns}/${name}" rows_ref
        done <<<"$row"
      else
        append_unique_item "TonNode instance inventory unavailable" rows_ref
      fi
    fi
  else
    append_unique_item "TonNode CRD inventory unavailable" rows_ref
  fi

  if row="$(list_ton_statefulsets 2>/dev/null)"; then
    while IFS=$'\t' read -r ns name; do
      [[ -n "$ns" && -n "$name" ]] || continue
      append_unique_item "StatefulSet ${ns}/${name}" rows_ref
    done <<<"$row"
  else
    append_unique_item "TON StatefulSet inventory unavailable" rows_ref
  fi

  collect_expected_ton_pvc_rows_from_values candidate_pvcs
  collect_labeled_ton_pvc_rows candidate_pvcs
  collect_existing_kubeton_pvc_rows candidate_pvcs existing_pvcs "uninstall"
  for row in "${existing_pvcs[@]}"; do
    [[ -z "$row" ]] && continue
    IFS=$'\t' read -r ns pvc <<<"$row"
    [[ -n "$ns" && -n "$pvc" ]] && append_unique_item "PVC ${ns}/${pvc}" rows_ref
  done

  # A persisted ledger means host-path cleanup was not verified.  Keep this in
  # the final report so uninstall never claims success while node-local data is
  # still pending a retry.
  collect_local_path_cleanup_ledger_leftovers "$rows_name"

  for ns in "$OP_NAMESPACE" "$VAULT_NAMESPACE" "$LONGHORN_NAMESPACE"; do
    ns="$(trim_whitespace "$ns")"
    [[ -z "$ns" ]] && continue
    if marker="$(kubectl get namespace "$ns" --ignore-not-found -o name 2>/dev/null)"; then
      [[ -z "$(trim_whitespace "$marker")" ]] || append_unique_item "Namespace ${ns}" rows_ref
    else
      append_unique_item "Namespace inventory unavailable: ${ns}" rows_ref
    fi
  done

  if marker="$(kubectl get storageclass "$ENCRYPTED_SC_NAME" --ignore-not-found -o name 2>/dev/null)"; then
    [[ -z "$(trim_whitespace "$marker")" ]] || append_unique_item "StorageClass ${ENCRYPTED_SC_NAME}" rows_ref
  else
    append_unique_item "StorageClass inventory unavailable: ${ENCRYPTED_SC_NAME}" rows_ref
  fi

  if command -v helm >/dev/null 2>&1; then
    for row in "$OP_NAMESPACE"$'\t'"$RELEASE_NAME" "$VAULT_NAMESPACE"$'\t'"$VAULT_RELEASE_NAME" "$LONGHORN_NAMESPACE"$'\t'"$LONGHORN_RELEASE_NAME"; do
      IFS=$'\t' read -r ns release <<<"$row"
      if storage_release_present "$release" "$ns"; then
        append_unique_item "HelmRelease ${ns}/${release}" rows_ref
      else
        inventory_rc=$?
        if (( inventory_rc != 1 )); then append_unique_item "Helm inventory unavailable: ${ns}/${release}" rows_ref; fi
      fi
    done
  else
    append_unique_item "Helm inventory unavailable: helm is not installed" rows_ref
  fi

  if ! collect_victoria_logs_release_rows single_release_rows collector_release_rows; then
    append_unique_item "VictoriaLogs cleanup inventory unavailable" rows_ref
  fi
  for row in "${single_release_rows[@]}"; do
    [[ -z "$row" ]] && continue
    IFS=$'\t' read -r ns release <<<"$row"
    ns="$(trim_whitespace "$ns")"
    release="$(trim_whitespace "$release")"
    [[ -z "$ns" || -z "$release" ]] && continue
    if command -v helm >/dev/null 2>&1 && helm status "$release" -n "$ns" >/dev/null 2>&1; then
      append_unique_item "HelmRelease ${ns}/${release}" rows_ref
    fi
    service_name="$(victoria_logs_service_name "$release")"
    collect_pvc_rows_by_prefix "server-volume-${service_name}-" vlogs_pvc_rows "app.kubernetes.io/name=victoria-logs-single,app.kubernetes.io/instance=${release}"
  done
  for row in "${collector_release_rows[@]}"; do
    [[ -z "$row" ]] && continue
    IFS=$'\t' read -r ns collector <<<"$row"
    ns="$(trim_whitespace "$ns")"
    collector="$(trim_whitespace "$collector")"
    [[ -z "$ns" || -z "$collector" ]] && continue
    if command -v helm >/dev/null 2>&1 && helm status "$collector" -n "$ns" >/dev/null 2>&1; then
      append_unique_item "HelmRelease ${ns}/${collector}" rows_ref
    fi
  done
  for row in "${vlogs_pvc_rows[@]}"; do
    [[ -z "$row" ]] && continue
    IFS=$'\t' read -r ns pvc <<<"$row"
    [[ -n "$ns" && -n "$pvc" ]] && append_unique_item "PVC ${ns}/${pvc}" rows_ref
  done

  # Shared VictoriaMetrics CRDs are intentionally retained when another app
  # uses them. Its cleanup step reports unresolved owned state separately.
  if marker="$(kubectl get crd -o name 2>/dev/null)"; then
    while IFS= read -r name; do
      [[ "$name" == *.longhorn.io ]] || continue
      append_unique_item "CRD ${name#customresourcedefinition.apiextensions.k8s.io/}" rows_ref
    done <<<"$marker"
  else
    append_unique_item "Storage CRD inventory unavailable" rows_ref
  fi

  for row in vault$'\t'"$VAULT_NAMESPACE"$'\t'"$VAULT_RELEASE_NAME" longhorn$'\t'"$LONGHORN_NAMESPACE"$'\t'"$LONGHORN_RELEASE_NAME"; do
    IFS=$'\t' read -r name ns release <<<"$row"
    storage_cluster_rows=()
    if ! collect_storage_release_cluster_rows "$name" "$release" "$ns" storage_cluster_rows; then
      append_unique_item "Storage cluster-resource inventory unavailable: ${ns}/${release}" rows_ref
    fi
    for marker in "${storage_cluster_rows[@]}"; do
      append_unique_item "Storage resource ${marker}" rows_ref
    done
  done

  collect_labeled_resource_leftovers 'app.kubernetes.io/managed-by=kubeton' "$rows_name"
}

verify_uninstall_leftovers() {
  local -a leftovers=()
  local item

  collect_uninstall_leftovers leftovers
  if [[ ${#leftovers[@]} -eq 0 ]]; then
    echo "[uninstall] No kubeton-managed leftovers found."
    return 0
  fi

  echo "Warning: kubeton uninstall removed as much as possible, but these resources still remain:" >&2
  for item in "${leftovers[@]}"; do
    [[ -z "$item" ]] && continue
    echo "  - ${item}" >&2
  done
  echo "Run './kubeton uninstall' again after Kubernetes finishes terminating resources. If the same items remain repeatedly, inspect their finalizers/events." >&2
  return 1
}

run_uninstall_core() {
  local -a uninstall_sts_rows=()
  local -a uninstall_failures=()
  local item sts_inventory

  KUBETON_RETAIN_VICTORIA_LOGS_GUARDS=0
  KUBETON_RETAIN_VICTORIA_METRICS_STATE=0

  if sts_inventory="$(list_ton_statefulsets)"; then
    if [[ -n "$(trim_whitespace "$sts_inventory")" ]]; then
      mapfile -t uninstall_sts_rows <<<"$sts_inventory"
    fi
  else
    echo "Error: cannot inventory TON StatefulSets; cleanup will report this unresolved read failure." >&2
    uninstall_failures+=("TON StatefulSet inventory")
  fi

  run_uninstall_step uninstall_failures "Step 1/10: stopping TON resources and waiting for pods to terminate ..." \
    stop_ton_for_destructive_cleanup uninstall_sts_rows

  run_uninstall_step uninstall_failures "Step 2/10: deleting TON PVCs and backing storage ..." \
    delete_ton_pvcs_for_statefulsets uninstall_sts_rows "uninstall"

  run_uninstall_step uninstall_failures "Step 3/10: cleaning leftover kubectl debug pods ..." \
    cleanup_kubectl_debug_pods

  run_uninstall_step uninstall_failures "Step 4/10: deleting kubeton-managed observability, VictoriaLogs, and wallet helper resources ..." \
    cleanup_observability_resources

  run_uninstall_step uninstall_failures "Step 5/10: uninstalling operator Helm release ${RELEASE_NAME} ..." \
    cleanup_operator_release

  run_uninstall_step uninstall_failures "Step 6/10: uninstalling Vault release ${VAULT_RELEASE_NAME} ..." \
    cleanup_vault_release

  run_uninstall_step uninstall_failures "Step 7/10: deleting StorageClass ${ENCRYPTED_SC_NAME} ..." \
    cleanup_encrypted_storage_class

  run_uninstall_step uninstall_failures "Step 8/10: retrying any recorded TON PVC and backing-storage cleanup ..." \
    delete_stale_ton_pvcs_without_fleet "uninstall" true

  run_uninstall_step uninstall_failures "Step 9/10: uninstalling Longhorn release ${LONGHORN_RELEASE_NAME} ..." \
    cleanup_longhorn_release

  run_uninstall_step uninstall_failures "Step 10/10: final kubeton-managed resource sweep ..." \
    cleanup_kubeton_managed_labeled_resources

  cleanup_kubectl_debug_pods "uninstall" || true

  if ! verify_uninstall_leftovers; then
    if [[ ${#uninstall_failures[@]} -gt 0 ]]; then
      echo "Uninstall steps that reported errors before the leftover check:" >&2
      for item in "${uninstall_failures[@]}"; do
        [[ -z "$item" ]] && continue
        echo "  - ${item}" >&2
      done
    fi
    return 1
  fi

  if [[ ${#uninstall_failures[@]} -gt 0 ]]; then
    echo "Warning: some uninstall steps reported errors even though no Kubernetes leftovers were found:" >&2
    for item in "${uninstall_failures[@]}"; do
      [[ -z "$item" ]] && continue
      echo "  - ${item}" >&2
    done
    echo "Uninstall is not marked complete; rerun './kubeton uninstall' after resolving the reported cleanup errors." >&2
    return 1
  fi

  echo "[uninstall] Uninstall complete."
}

run_uninstall() {
  require_bin helm
  require_bin kubectl
  confirm_or_exit "WARNING: This will stop/delete TON pods and PVCs, purge known backing storage, remove kubeton-managed observability/VictoriaLogs/wallet/debug resources, uninstall operator, uninstall Longhorn release ${LONGHORN_RELEASE_NAME}, uninstall Vault release ${VAULT_RELEASE_NAME}, and delete StorageClass ${ENCRYPTED_SC_NAME}. TonNode CRD is kept. kubeton will continue cleanup after step errors and report any leftovers to rerun uninstall for. Continue?"
  run_uninstall_core
}

run_purge() {
  require_bin helm
  require_bin kubectl
  confirm_or_exit "DANGER: purge runs full uninstall (including kubeton-managed Prometheus/Grafana/VictoriaMetrics/VictoriaLogs cleanup) and deletes verified retained TON recovery volumes belonging to the configured fleet, plus CRD tonnodes.ton.ton.org (cluster-scoped). This is separated from uninstall to avoid accidental cluster-wide CRD removal. Continue?"
  # Dynamic local scope ends on every return; later uninstall/drop cannot
  # inherit permission to remove retained recovery copies.
  local KUBETON_RETAIN_PURGE_CONFIRMED=true
  local uninstall_rc=0
  local purge_rc=0
  local crd_remaining
  run_uninstall_core || uninstall_rc=$?
  echo "[purge] Deleting CRD tonnodes.ton.ton.org ..."
  kubectl delete crd tonnodes.ton.ton.org --ignore-not-found --wait=true \
    --timeout="${NAMESPACE_DELETE_PROGRESS_TIMEOUT}s" || purge_rc=1

  if ! crd_remaining="$(kubectl get crd tonnodes.ton.ton.org --ignore-not-found -o name)"; then
    echo "Error: cannot verify TonNode CRD deletion after purge." >&2
    purge_rc=1
  elif [[ -n "$(trim_whitespace "$crd_remaining")" ]]; then
    echo "Warning: TonNode CRD tonnodes.ton.ton.org still exists after purge attempted to delete it." >&2
    purge_rc=1
  fi

  if (( uninstall_rc != 0 )); then
    echo "[purge] Rechecking leftovers after TonNode CRD deletion ..."
    verify_uninstall_leftovers || true
    purge_rc=1
  fi

  if (( purge_rc != 0 )); then
    echo "Warning: purge cleanup is incomplete or could not be verified. Resolve the reported errors and rerun './kubeton purge'." >&2
    return "$purge_rc"
  fi
  echo "[purge] Completed."
}

run_verify() {
  require_bin kubectl
  echo "[verify] Operator resources (${OP_NAMESPACE})"
  kubectl -n "$OP_NAMESPACE" get deploy
  kubectl -n "$OP_NAMESPACE" get pods -o wide
  echo
  echo "[verify] TON resources (${TON_NAMESPACE})"
  kubectl -n "$TON_NAMESPACE" get tonnodes
  kubectl -n "$TON_NAMESPACE" get sts
  kubectl -n "$TON_NAMESPACE" get pods -o wide
  kubectl -n "$TON_NAMESPACE" get pvc
}

list_logs_auth_stacks() {
  local state_rows service_rows
  state_rows="$(run_with_timeout "$STATUS_EXEC_TIMEOUT" kubectl get configmaps -A \
    -l 'app.kubernetes.io/name=kubeton-victoria-metrics,app.kubernetes.io/managed-by=kubeton' \
    -o jsonpath='{range .items[*]}{.data.stackNamespace}{"\t"}{.data.stackName}{"\n"}{end}' 2>/dev/null || true)"
  # The state ConfigMap may be missing or predate automatic metrics setup.
  # Operator-created Services carry the actual VMAuth instance identity.
  if ! service_rows="$(run_with_timeout "$STATUS_EXEC_TIMEOUT" kubectl get services -A \
    -l 'app.kubernetes.io/name=vmauth' \
    -o jsonpath='{range .items[*]}{.metadata.namespace}{"\t"}{.spec.selector.app\.kubernetes\.io/instance}{"\n"}{end}')"; then
    return 1
  fi
  printf '%s\n%s\n' "$service_rows" "$state_rows" | awk -F '\t' 'NF == 2 && $1 != "" && $2 != "" && !seen[$0]++'
}

logs_dashboard_route_matches() {
  local backend_url="$1" target_urls="$2" target_url target_paths path_pattern path_regex
  local -a route_patterns=()
  while IFS=$'\t' read -r target_url target_paths; do
    [[ "${target_url%/}" == "$backend_url" ]] || continue
    read -r -a route_patterns <<<"$target_paths"
    for path_pattern in "${route_patterns[@]}"; do
      path_regex="^(${path_pattern})$"
      [[ '/select/vmui/' =~ $path_regex ]] && return 0
    done
  done <<<"$target_urls"
  return 1
}

list_logs_dashboard_access() {
  local backend_rows metrics_rows
  local logs_ns logs_service logs_port auth_ns stack_name target_urls auth_port
  local access_ns access_service access_port access_note

  if ! backend_rows="$(run_with_timeout "$STATUS_EXEC_TIMEOUT" kubectl get services -A \
    -l 'app.kubernetes.io/name=kubeton-victoria-logs-access,app.kubernetes.io/managed-by=kubeton' \
    -o jsonpath='{range .items[*]}{.metadata.namespace}{"\t"}{.metadata.name}{"\t"}{.spec.ports[0].port}{"\n"}{end}' 2>/dev/null)"; then
    return 1
  fi
  if [[ -z "$backend_rows" ]]; then
    return 0
  fi

  # Discover installed stacks rather than assuming the current environment
  # matches the names and ports used when logging was installed.
  metrics_rows="$(list_logs_auth_stacks)" || return 1
  while IFS=$'\t' read -r logs_ns logs_service logs_port; do
    [[ -n "$logs_ns" && -n "$logs_service" && "$logs_port" =~ ^[0-9]+$ ]] || continue
    access_ns="$logs_ns"
    access_service="$logs_service"
    access_port="$logs_port"
    access_note=""
    while IFS=$'\t' read -r auth_ns stack_name; do
      [[ -n "$auth_ns" && -n "$stack_name" ]] || continue
      target_urls="$(run_with_timeout "$STATUS_EXEC_TIMEOUT" kubectl -n "$auth_ns" get vmuser "$stack_name" \
        -o jsonpath='{range .spec.targetRefs[*]}{.static.url}{"\t"}{.paths[*]}{"\n"}{end}' 2>/dev/null || true)"
      if logs_dashboard_route_matches "http://${logs_service}.${logs_ns}.svc:${logs_port}" "$target_urls"; then
        auth_port="$(run_with_timeout "$STATUS_EXEC_TIMEOUT" kubectl -n "$auth_ns" get service "vmauth-${stack_name}" \
          -o jsonpath='{.spec.ports[0].port}' 2>/dev/null || true)"
        [[ "$auth_port" =~ ^[0-9]+$ ]] || continue
        access_ns="$auth_ns"
        access_service="vmauth-${stack_name}"
        access_port="$auth_port"
        access_note="; use your existing VMAuth credentials"
        break
      fi
    done <<<"$metrics_rows"

    if [[ -n "$access_note" ]]; then
      printf '%s\t%s\t%s\tauth\t%s\n' "$access_ns" "$access_service" "$access_port" "$stack_name"
    else
      printf '%s\t%s\t%s\tbackend\t-\n' "$access_ns" "$access_service" "$access_port"
    fi
  done <<<"$backend_rows"
}

ensure_logs_dashboard_auth_ingress() {
  local logs_ns="$1" logs_service="$2" auth_ns="$3" stack_name="$4"
  local pod_selector
  # Keep the existing collector rules intact. NetworkPolicy allows are
  # additive; grant only this gateway access to an already protected backend.
  if ! pod_selector="$(run_with_timeout "$STATUS_EXEC_TIMEOUT" kubectl -n "$logs_ns" \
    get networkpolicy "${logs_service}-ingress" --ignore-not-found -o jsonpath='{.spec.podSelector}')"; then
    return 1
  fi
  [[ -n "$pod_selector" ]] || return 0
  cat <<EOF | kubectl -n "$logs_ns" apply -f - >/dev/null
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: ${logs_service}-auth
  labels:
    app.kubernetes.io/name: kubeton-victoria-logs-access
    app.kubernetes.io/managed-by: kubeton
    app.kubernetes.io/part-of: kubeton-victoria-logs
spec:
  podSelector: ${pod_selector}
  policyTypes: [Ingress]
  ingress:
    - from:
        - namespaceSelector:
            matchLabels:
              kubernetes.io/metadata.name: ${auth_ns}
          podSelector:
            matchLabels:
              app.kubernetes.io/instance: ${stack_name}
              app.kubernetes.io/name: vmauth
      ports:
        - protocol: TCP
          port: http
EOF
}

ensure_logs_dashboard_auth() {
  local logs_ns="$1" logs_service="$2" logs_port="$3"
  local ns="${VICTORIA_METRICS_NAMESPACE:-vm}" stack_name candidate_ns candidate_stack candidates
  local crds auth_owner user_owner target_refs target_urls route patch_path timeout_seconds auth_port
  stack_name="$(victoria_metrics_stack_name)"
  candidates="$(list_logs_auth_stacks)" || return 1
  timeout_seconds="$(resolve_victoria_metrics_rollout_timeout_seconds)"

  if ! crds="$(run_with_timeout "$STATUS_EXEC_TIMEOUT" kubectl get crd \
    vmauths.operator.victoriametrics.com vmusers.operator.victoriametrics.com --ignore-not-found -o name)"; then
    return 1
  fi
  if [[ "$(printf '%s\n' "$crds" | awk 'NF {n++} END {print n+0}')" != 2 ]]; then
    ensure_victoria_metrics_operator "${VICTORIA_METRICS_OPERATOR_NAMESPACE:-vm}" "$stack_name" >/dev/null || return 1
  fi
  # Reuse a managed stack with its custom identity. Skip unrelated VMAuth
  # installations, and preserve existing credentials and metrics routes.
  while IFS=$'\t' read -r candidate_ns candidate_stack; do
    [[ -n "$candidate_ns" && -n "$candidate_stack" ]] || continue
    auth_owner="$(run_with_timeout "$STATUS_EXEC_TIMEOUT" kubectl -n "$candidate_ns" get vmauth "$candidate_stack" \
      --ignore-not-found -o jsonpath='{.metadata.labels.app\.kubernetes\.io/managed-by}')" || return 1
    user_owner="$(run_with_timeout "$STATUS_EXEC_TIMEOUT" kubectl -n "$candidate_ns" get vmuser "$candidate_stack" \
      --ignore-not-found -o jsonpath='{.metadata.labels.app\.kubernetes\.io/managed-by}')" || return 1
    if [[ "$auth_owner" == kubeton || "$user_owner" == kubeton ]]; then
      ns="$candidate_ns"
      stack_name="$candidate_stack"
      break
    fi
  done <<<"$candidates"
  ensure_namespace "$ns" || return 1
  if ! auth_owner="$(run_with_timeout "$STATUS_EXEC_TIMEOUT" kubectl -n "$ns" get vmauth "$stack_name" \
    --ignore-not-found -o jsonpath='{.metadata.name}{"\t"}{.metadata.labels.app\.kubernetes\.io/managed-by}')" \
    || ! user_owner="$(run_with_timeout "$STATUS_EXEC_TIMEOUT" kubectl -n "$ns" get vmuser "$stack_name" \
    --ignore-not-found -o jsonpath='{.metadata.name}{"\t"}{.metadata.labels.app\.kubernetes\.io/managed-by}')"; then
    return 1
  fi
  for candidate_stack in "$auth_owner" "$user_owner"; do
    if [[ -n "$candidate_stack" && "$candidate_stack" != "$stack_name"$'\t'kubeton ]]; then
      echo "Error: refusing to change VictoriaLogs access resources not managed by kubeton in ${ns}." >&2
      return 1
    fi
  done
  echo "[logs] Configuring authenticated access to existing VictoriaLogs ${logs_ns}/${logs_service} ..." >&2
  if [[ -z "$auth_owner" ]]; then
    cat <<EOF | kubectl -n "$ns" apply -f - >/dev/null || return 1
apiVersion: operator.victoriametrics.com/v1beta1
kind: VMAuth
metadata:
  name: ${stack_name}
  labels:
    app.kubernetes.io/name: kubeton-victoria-metrics
    app.kubernetes.io/component: auth
    app.kubernetes.io/managed-by: kubeton
    app.kubernetes.io/part-of: kubeton-victoria-metrics
spec:
  userSelector:
    matchLabels:
      app.kubernetes.io/managed-by: kubeton
EOF
  fi
  route="{\"static\":{\"url\":$(json_quote "http://${logs_service}.${logs_ns}.svc:${logs_port}")},\"paths\":[\"/select/.*\"]}"
  if [[ -z "$user_owner" ]]; then
    cat <<EOF | kubectl -n "$ns" apply -f - >/dev/null || return 1
apiVersion: operator.victoriametrics.com/v1beta1
kind: VMUser
metadata:
  name: ${stack_name}
  labels:
    app.kubernetes.io/name: kubeton-victoria-metrics-user
    app.kubernetes.io/managed-by: kubeton
    app.kubernetes.io/part-of: kubeton-victoria-metrics
spec:
  name: $(yaml_quote "${VICTORIA_METRICS_AUTH_USERNAME:-$stack_name}")
  username: $(yaml_quote "${VICTORIA_METRICS_AUTH_USERNAME:-$stack_name}")
  generatePassword: true
  targetRefs: [${route}]
EOF
  else
    target_urls="$(run_with_timeout "$STATUS_EXEC_TIMEOUT" kubectl -n "$ns" get vmuser "$stack_name" \
      -o jsonpath='{range .spec.targetRefs[*]}{.static.url}{"\t"}{.paths[*]}{"\n"}{end}')" || return 1
    if ! logs_dashboard_route_matches "http://${logs_service}.${logs_ns}.svc:${logs_port}" "$target_urls"; then
      target_refs="$(run_with_timeout "$STATUS_EXEC_TIMEOUT" kubectl -n "$ns" get vmuser "$stack_name" \
        -o jsonpath='{.spec.targetRefs}')" || return 1
      patch_path='/spec/targetRefs/-'
      if [[ -z "$target_refs" || "$target_refs" == null ]]; then
        patch_path='/spec/targetRefs'
        route="[${route}]"
      fi
      kubectl -n "$ns" patch vmuser "$stack_name" --type=json \
        -p "[{\"op\":\"add\",\"path\":\"${patch_path}\",\"value\":${route}}]" >/dev/null || return 1
    fi
  fi
  ensure_logs_dashboard_auth_ingress "$logs_ns" "$logs_service" "$ns" "$stack_name" || return 1
  # Unlike the informational start checks, exposure must fail when the gateway
  # is not ready. Never fall back to forwarding the unauthenticated backend.
  kubectl -n "$ns" wait --for=jsonpath='{.status.updateStatus}'=operational "vmuser/${stack_name}" \
    --timeout="${timeout_seconds}s" >/dev/null || return 1
  kubectl -n "$ns" wait --for=jsonpath='{.status.updateStatus}'=operational "vmauth/${stack_name}" \
    --timeout="${timeout_seconds}s" >/dev/null || return 1
  kubectl -n "$ns" rollout status "deployment/vmauth-${stack_name}" --timeout="${timeout_seconds}s" >/dev/null || return 1
  resolve_victoria_metrics_credentials "$ns" "$stack_name" '' '' >/dev/null || return 1
  auth_port="$(run_with_timeout "$STATUS_EXEC_TIMEOUT" kubectl -n "$ns" get service "vmauth-${stack_name}" \
    -o jsonpath='{.spec.ports[0].port}')" || return 1
  [[ "$auth_port" =~ ^[0-9]+$ ]] || return 1
  printf '%s\t%s\t%s\tauth\t%s\n' "$ns" "vmauth-${stack_name}" "$auth_port" "$stack_name"
}

verify_logs_dashboard_auth() {
  local ns="$1" stack_name="$2" local_port="$3"
  local verify_seconds="${VICTORIA_METRICS_PORT_FORWARD_VERIFY_SECONDS:-20}"
  local deadline credentials_row secret_name username password token anonymous_status auth_status=000 result=1
  if ! [[ "$verify_seconds" =~ ^[0-9]+$ ]] || (( verify_seconds <= 0 )); then
    verify_seconds=20
  fi
  deadline=$(( $(date +%s) + verify_seconds ))
  while :; do
    credentials_row="$(resolve_victoria_metrics_credentials "$ns" "$stack_name" '' '' "${verify_seconds}s")" || return 1
    IFS=$'\t' read -r secret_name username password <<<"$credentials_row"
    [[ -n "$username" && -n "$password" ]] || return 1
    # Never put a credential in curl's argv, environment, URL, or a file.
    # Disable curlrc/proxies/redirects and send it only over the local forward.
    token="$(printf '%s:%s' "$username" "$password" | base64 | tr -d '\r\n')"
    anonymous_status="$(curl --disable --noproxy '*' --connect-timeout 2 --max-time 3 -s \
      -o /dev/null -w '%{http_code}' "http://127.0.0.1:${local_port}/select/vmui/" || true)"
    if [[ "$anonymous_status" == 200 ]]; then
      echo "Error: VictoriaLogs dashboard accepted an unauthenticated request; public access was refused." >&2
      return 3
    fi
    if [[ "$anonymous_status" == 401 || "$anonymous_status" == 403 ]]; then
      auth_status="$(printf 'header = "Authorization: Basic %s"\n' "$token" \
        | curl --disable --noproxy '*' --connect-timeout 2 --max-time 3 -s --config - \
          -o /dev/null -w '%{http_code}' "http://127.0.0.1:${local_port}/select/vmui/" || true)"
      [[ "$auth_status" != 200 ]] || return 0
      result=1
      [[ "$auth_status" != 401 && "$auth_status" != 403 ]] || result=2
    else
      auth_status="$anonymous_status"
      result=1
    fi
    if (( $(date +%s) >= deadline )); then
      echo "Error: VictoriaLogs dashboard login check failed (HTTP ${auth_status}; credentials Secret ${ns}/vmuser-${stack_name})." >&2
      return "$result"
    fi
    sleep 1
  done
}

reconcile_logs_dashboard_auth() {
  local ns="$1" stack_name="$2" owner
  owner="$(run_with_timeout "$STATUS_EXEC_TIMEOUT" kubectl -n "$ns" get vmauth "$stack_name" \
    -o jsonpath='{.metadata.labels.app\.kubernetes\.io/managed-by}')" || return 1
  [[ "$owner" == kubeton ]] || return 1
  echo "[logs] Refreshing VMAuth configuration from its existing credentials Secret ..." >&2
  # VMAuth watches metadata updates; VMUser filters out annotation-only updates.
  # Regenerate the auth config without changing passwords or restarting TON.
  kubectl -n "$ns" annotate vmauth "$stack_name" \
    "ton.ton.org/auth-reconcile-at=$(date -u +%Y-%m-%dT%H:%M:%S.%N)" --overwrite >/dev/null
}

print_logs_dashboard_login_instructions() {
  local ns="$1" stack_name="$2"
  local template='{{printf "Username: %s\nPassword: %s\n" (.data.username | base64decode) (.data.password | base64decode)}}'
  printf '[logs] Read the browser login: kubectl -n %s get secret vmuser-%s -o go-template=%s\n' \
    "$ns" "$stack_name" "$(shell_quote "$template")"
}

print_logs_victoria_logs_info() {
  local access_rows access_ns access_service access_port access_mode stack_name access_note
  echo "[logs] Full logs can be found on the VictoriaLogs server (within its configured retention)."
  if ! access_rows="$(list_logs_dashboard_access)"; then
    echo "[logs] VictoriaLogs address unavailable: could not read logging Services."
    return 0
  fi
  if [[ -z "$access_rows" ]]; then
    echo "[logs] VictoriaLogs server was not found in this cluster."
    return 0
  fi
  while IFS=$'\t' read -r access_ns access_service access_port access_mode stack_name; do
    access_note=""
    [[ "$access_mode" != auth ]] || access_note="; use your existing VMAuth credentials"
    printf '[logs] VictoriaLogs UI (in-cluster only%s): http://%s.%s.svc:%s/select/vmui/\n' \
      "$access_note" "$access_service" "$access_ns" "$access_port"
    printf '[logs] Access from this machine: kubectl -n %s port-forward --address 127.0.0.1 service/%s %s:%s\n' \
      "$access_ns" "$access_service" "$access_port" "$access_port"
    printf '[logs] VictoriaLogs UI after port-forward: http://127.0.0.1:%s/select/vmui/\n' "$access_port"
  done <<<"$access_rows"
  echo "[logs] Expose the dashboard externally: ./kubeton logs expose"
}

resolve_logs_public_host() {
  local host="" octet
  local -a octets=()
  if command -v curl >/dev/null 2>&1; then
    host="$(curl -4 -fsS --connect-timeout 3 --max-time 5 https://api.ipify.org 2>/dev/null || true)"
  fi
  [[ "$host" =~ ^[0-9]{1,3}(\.[0-9]{1,3}){3}$ ]] || return 1
  IFS=. read -r -a octets <<<"$host"
  for octet in "${octets[@]}"; do
    (( 10#$octet <= 255 )) || return 1
  done
  printf '%s' "$host"
}

run_logs_expose() {
  local port="${VICTORIA_METRICS_AUTH_LOCAL_PORT_BASE:-8427}" public_host=""
  while (( $# > 0 )); do
    case "$1" in
      --port|--public-host)
        if (( $# < 2 )); then
          echo "Error: $1 requires a value." >&2
          return 1
        fi
        if [[ "$1" == --port ]]; then port="$2"; else public_host="$2"; fi
        shift 2
        ;;
      *)
        echo "Error: usage: kubeton logs expose [--port PORT] [--public-host HOST]" >&2
        return 1
        ;;
    esac
  done
  if ! [[ "$port" =~ ^[0-9]{1,5}$ ]] || (( 10#$port < 1 || 10#$port > 65535 )); then
    echo "Error: dashboard port must be between 1 and 65535." >&2
    return 1
  fi
  port="$((10#$port))"
  require_bin kubectl
  require_bin nohup
  require_bin curl
  require_bin base64
  if [[ -z "$public_host" ]]; then
    if ! public_host="$(resolve_logs_public_host)"; then
      echo "Error: cannot discover this server's public IP; use kubeton logs expose --public-host <public-IP-or-hostname>." >&2
      return 1
    fi
  fi
  if ! [[ "$public_host" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]] \
    || [[ "$public_host" == 0.0.0.0 ]] \
    || is_loopback_host "$public_host"; then
    echo "Error: --public-host must be the external IPv4 address or hostname of the machine running kubeton." >&2
    return 1
  fi

  local access_rows ns service remote_port mode stack_name forward_row
  local forwarded_ns forwarded_service local_port pid log_file auth_result
  if ! access_rows="$(list_logs_dashboard_access)"; then
    echo "Error: cannot discover the authenticated VictoriaLogs dashboard." >&2
    return 1
  fi
  if [[ -z "$access_rows" ]]; then
    echo "Error: VictoriaLogs backend was not found in this cluster; install logging with kubeton start." >&2
    return 1
  fi
  if ! grep -q $'\tauth\t' <<<"$access_rows"; then
    IFS=$'\t' read -r ns service remote_port mode stack_name <<<"$access_rows"
    if ! access_rows="$(ensure_logs_dashboard_auth "$ns" "$service" "$remote_port")"; then
      echo "Error: could not configure authenticated VictoriaLogs access; no public port-forward was started." >&2
      return 1
    fi
  fi
  while IFS=$'\t' read -r ns service remote_port mode stack_name; do
    [[ "$mode" == auth ]] || continue
    # Prove both authentication and backend access before binding publicly.
    if ! forward_row="$(ensure_victoria_metrics_port_forward "$ns" "$service" "$port" "$remote_port" 127.0.0.1)"; then
      echo "Error: dashboard verification port-forward failed; use --port to choose another local port." >&2
      return 1
    fi
    IFS=$'\t' read -r forwarded_ns forwarded_service local_port pid log_file <<<"$forward_row"
    if [[ "$forwarded_ns" != "$ns" || "$forwarded_service" != "$service" || "$local_port" != "$port" ]]; then
      echo "Error: dashboard verification port-forward did not report the requested endpoint." >&2
      return 1
    fi
    auth_result=0
    verify_logs_dashboard_auth "$ns" "$stack_name" "$port" || auth_result=$?
    if (( auth_result == 2 )) && reconcile_logs_dashboard_auth "$ns" "$stack_name"; then
      auth_result=0
      verify_logs_dashboard_auth "$ns" "$stack_name" "$port" || auth_result=$?
    fi
    if (( auth_result != 0 )); then
      echo "Error: VictoriaLogs authentication could not be verified; the forward remains local only." >&2
      print_logs_dashboard_login_instructions "$ns" "$stack_name" >&2
      return 1
    fi
    if ! forward_row="$(ensure_victoria_metrics_port_forward "$ns" "$service" "$port" "$remote_port" 0.0.0.0)"; then
      echo "Error: dashboard port-forward failed; use --port to choose another local port." >&2
      return 1
    fi
    IFS=$'\t' read -r forwarded_ns forwarded_service local_port pid log_file <<<"$forward_row"
    if [[ "$forwarded_ns" != "$ns" || "$forwarded_service" != "$service" || "$local_port" != "$port" ]]; then
      echo "Error: dashboard port-forward did not report the requested endpoint." >&2
      return 1
    fi
    if ! verify_logs_dashboard_auth "$ns" "$stack_name" "$port"; then
      # The Service may have selected another Pod when the forward restarted.
      # Withdraw a failed public forward instead of announcing a broken login.
      if ensure_victoria_metrics_port_forward "$ns" "$service" "$port" "$remote_port" 127.0.0.1 >/dev/null; then
        echo "Error: dashboard login failed after public forwarding; public access was withdrawn." >&2
      else
        if [[ "$pid" =~ ^[0-9]+$ ]] \
          && port_forward_process_matches "$pid" "$ns" "$service" "$port" "$remote_port" 0.0.0.0; then
          kill "$pid" >/dev/null 2>&1 || true
        fi
        echo "Error: dashboard login failed; local access could not be restored. Check that public forward PID ${pid} has stopped." >&2
      fi
      print_logs_dashboard_login_instructions "$ns" "$stack_name" >&2
      return 1
    fi
    echo "[logs] VictoriaLogs dashboard is now exposed externally: http://${public_host}:${local_port}/select/vmui/"
    echo "[logs] VMAuth authentication is required. Credentials Secret: ${ns}/vmuser-${stack_name}"
    print_logs_dashboard_login_instructions "$ns" "$stack_name"
    echo "[logs] Background port-forward: PID ${pid}; log: ${log_file}"
    echo "[logs] Allow inbound TCP ${local_port} to this server through its firewall/NAT."
    return 0
  done <<<"$access_rows"
  echo "Error: could not resolve an authenticated VictoriaLogs endpoint." >&2
  return 1
}

run_logs() {
  if [[ "${1:-}" == expose ]]; then
    shift
    run_logs_expose "$@"
    return $?
  fi
  if [[ $# -gt 1 || "${1:-}" == -* || ( $# -eq 1 && -z "${1:-}" ) ]]; then
    echo "Error: usage: kubeton logs [server-name|pod-name]" >&2
    return 1
  fi
  require_bin kubectl
  print_logs_victoria_logs_info

  local requested_target="${1:-}" pod_rows ns pod node_name failed=0 matched=0
  if ! pod_rows="$(list_ton_pods)"; then
    echo "Error: could not list TON pods for logs." >&2
    return 1
  fi
  while IFS=$'\t' read -r ns pod node_name; do
    [[ -n "$ns" && -n "$pod" ]] || continue
    [[ -z "$requested_target" || "$node_name" == "$requested_target" || "$pod" == "$requested_target" || "${ns}/${pod}" == "$requested_target" ]] || continue
    matched=$((matched + 1))
    printf '\n=== %s/%s (server: %s; last 20 lines) ===\n' "$ns" "$pod" "${node_name:-N/A}"
    if ! run_with_timeout "$STATUS_EXEC_TIMEOUT" kubectl -n "$ns" logs "$pod" -c ton-node --tail=20; then
      echo "Error: could not read logs from ${ns}/${pod}." >&2
      failed=1
    fi
    printf '\n'
  done <<<"$pod_rows"
  if (( matched == 0 )); then
    if [[ -n "$requested_target" ]]; then
      echo "No TON pods found for server or pod '${requested_target}'." >&2
      return 1
    fi
    echo "No TON pods found."
  fi
  return "$failed"
}

run_status() {
  require_bin kubectl
  mapfile -t pod_rows < <(list_ton_pods)
  if [[ ${#pod_rows[@]} -eq 0 || -z "${pod_rows[0]}" ]]; then
    echo "No TON pods found."
    return
  fi

  local status_tmp_dir=""
  local -a table_rows=()
  local -a result_files=()
  local -a fallback_rows=()
  local -a pids=()
  local row ns pod node_name result_file
  local i

  status_tmp_dir="$(mktemp -d -t kubeton-status.XXXXXX)"
  for i in "${!pod_rows[@]}"; do
    row="${pod_rows[$i]}"
    [[ -z "$row" ]] && continue
    IFS=$'\t' read -r ns pod node_name <<<"$row"
    [[ -z "$node_name" ]] && node_name="N/A"
    result_file="${status_tmp_dir}/row-${i}.tsv"
    result_files[$i]="$result_file"
    fallback_rows[$i]="$node_name"$'\t'"$pod"$'\t'"N/A"$'\t'"N/A"$'\t'"N/A"$'\t'"N/A"$'\t'"N/A"$'\t'"N/A"$'\t'"N/A"$'\t'"N/A"
    status_collect_row "$ns" "$pod" "$node_name" "$result_file" &
    pids+=("$!")
  done

  for i in "${!pids[@]}"; do
    wait "${pids[$i]}" || true
  done

  for i in "${!pod_rows[@]}"; do
    result_file="${result_files[$i]:-}"
    if [[ -n "$result_file" && -s "$result_file" ]]; then
      table_rows+=("$(cat "$result_file")")
    else
      [[ -n "${fallback_rows[$i]:-}" ]] && table_rows+=("${fallback_rows[$i]}")
    fi
  done

  rm -rf "$status_tmp_dir" >/dev/null 2>&1 || true

  print_aligned_table_10col "server name" "pod name" "TON image" "MyTonCtrl image" "date" "wallet" "ADNL address" "sync" "cell db" "archive db" "${table_rows[@]}"
}

run_prometheus_start() {
  require_bin kubectl
  require_bin nohup
  require_bin python3
  require_bin curl
  if [[ $# -ne 0 ]]; then
    echo "Error: usage: kubeton prometheus start" >&2
    exit 1
  fi
  local -a access_rows=()
  local -a forwarded_rows=()
  local row ns service_name deploy_name exporter_address forward_row log_file admin_row admin_user admin_password
  local base_port local_port remote_port bind_address remote_access_host
  local i attempt quiet_attempt

  # Close previous managed listeners while upgrading an unauthenticated install.
  cleanup_prometheus_port_forwards
  configure_prometheus_for_exporter_targets access_rows || true
  if [[ ${#access_rows[@]} -eq 0 ]]; then
    return 1
  fi

  remote_port="$PROMETHEUS_PORT"
  if ! [[ "$remote_port" =~ ^[0-9]+$ ]]; then
    remote_port=9090
  fi
  base_port="$PROMETHEUS_LOCAL_PORT_BASE"
  if ! [[ "$base_port" =~ ^[0-9]+$ ]]; then
    base_port=9090
  fi
  bind_address="$(prometheus_port_forward_address)"
  bind_address="$(trim_whitespace "$bind_address")"
  if [[ -z "$bind_address" ]]; then
    bind_address="127.0.0.1"
  fi

  echo "[metrics] Starting background local port-forward(s) ..."
  echo "[metrics] Port-forward bind address: ${bind_address}"
  for i in "${!access_rows[@]}"; do
    row="${access_rows[$i]}"
    IFS=$'\t' read -r ns service_name deploy_name exporter_address <<<"$row"
    local_port="$((base_port + i))"
    for ((attempt=0; attempt<25; attempt++)); do
      quiet_attempt="true"
      if (( attempt == 24 )); then
        quiet_attempt="false"
      fi
      if forward_row="$(ensure_prometheus_port_forward "$ns" "$service_name" "$((local_port + attempt))" "$remote_port" "$bind_address" "$quiet_attempt")"; then
        forwarded_rows+=("$forward_row")
        break
      fi
    done
  done

  if [[ ${#forwarded_rows[@]} -eq 0 ]]; then
    echo "Error: failed to start any background port-forward for Prometheus services." >&2
    return 1
  fi

  for row in "${forwarded_rows[@]}"; do
    IFS=$'\t' read -r ns service_name local_port _pid log_file <<<"$row"
    admin_row="$(dashboard_secret_credentials "$ns" "$PROMETHEUS_ADMIN_SECRET_NAME")" || return 1
    IFS=$'\t' read -r admin_user admin_password <<<"$admin_row"
    if address_list_allows_loopback "$bind_address"; then
      echo "[metrics] Background access: http://127.0.0.1:${local_port}/targets (service ${ns}/${service_name})"
    fi
    if address_list_exposes_non_loopback "$bind_address"; then
      remote_access_host="$(first_non_loopback_bind_address "$bind_address" || true)"
      remote_access_host="$(trim_whitespace "$remote_access_host")"
      if [[ -z "$remote_access_host" ]]; then
        remote_access_host="$(resolve_primary_host_address || true)"
        remote_access_host="$(trim_whitespace "$remote_access_host")"
      fi
      if [[ -n "$remote_access_host" ]]; then
        echo "[metrics] Remote access: http://${remote_access_host}:${local_port}/targets"
      fi
    fi
    echo "[metrics] Admin user: ${admin_user}"
    echo "[metrics] Admin password: ${admin_password}"
    echo "[metrics] Credentials Secret: ${ns}/${PROMETHEUS_ADMIN_SECRET_NAME}"
    echo "[metrics] Port-forward log: ${log_file}"
  done

  return 0
}

run_prometheus_stop() {
  require_bin kubectl
  if [[ $# -ne 0 ]]; then
    echo "Error: usage: kubeton prometheus stop" >&2
    exit 1
  fi

  cleanup_prometheus_resources
  echo "[metrics] kubeton-managed Prometheus resources and local port-forward(s) removed."
}

run_prometheus() {
  local subcommand="${1:-}"
  case "$subcommand" in
    start)
      shift
      run_prometheus_start "$@"
      ;;
    stop)
      shift
      run_prometheus_stop "$@"
      ;;
    "")
      echo "Error: usage: kubeton prometheus <start|stop>" >&2
      exit 1
      ;;
    *)
      echo "Error: unknown prometheus subcommand '$subcommand'." >&2
      echo "Usage: kubeton prometheus <start|stop>" >&2
      exit 1
      ;;
  esac
}

run_grafana_start() {
  require_bin kubectl
  require_bin nohup
  require_bin python3
  require_bin curl
  if [[ $# -ne 0 ]]; then
    echo "Error: usage: kubeton grafana start" >&2
    exit 1
  fi

  local -a prometheus_rows=()
  local datasources_yaml=""
  local dashboards_yaml=""
  local dashboard_json=""
  local default_datasource_name=""
  local grafana_row ns service_name deploy_name admin_user admin_password
  local -a forwarded_rows=()
  local forward_row log_file
  local base_port local_port remote_port bind_address remote_access_host dashboard_uid dashboard_path probe_host
  local attempt quiet_attempt

  dashboard_uid="$(grafana_dashboard_uid)" || return 1
  dashboard_path="/d/${dashboard_uid}"
  cleanup_grafana_port_forwards
  configure_prometheus_for_exporter_targets prometheus_rows || true
  if [[ ${#prometheus_rows[@]} -eq 0 ]]; then
    echo "Error: no kubeton-managed Prometheus service found/configured. Run 'kubeton prometheus start' first." >&2
    return 1
  fi

  datasources_yaml="$(build_grafana_datasources_yaml "${prometheus_rows[@]}")" || return 1
  if [[ -z "$datasources_yaml" || "$datasources_yaml" != *"datasources:"* ]]; then
    echo "Error: failed to build Grafana datasources provisioning config." >&2
    return 1
  fi
  dashboards_yaml="$(build_grafana_dashboards_provisioning_yaml)"
  default_datasource_name="$(first_grafana_datasource_name_from_prometheus_rows "${prometheus_rows[@]}" || true)"
  default_datasource_name="$(trim_whitespace "$default_datasource_name")"
  if [[ -z "$default_datasource_name" ]]; then
    echo "Error: failed to resolve default Grafana datasource name." >&2
    return 1
  fi
  dashboard_json="$(build_grafana_ton_overview_dashboard_json "$default_datasource_name")" || return 1
  if [[ -z "$dashboard_json" || "$dashboard_json" != *"\"panels\""* ]]; then
    echo "Error: failed to build Grafana dashboard JSON." >&2
    return 1
  fi

  if ! grafana_row="$(ensure_grafana_stack "$GRAFANA_NAMESPACE" "$datasources_yaml" "$dashboards_yaml" "$dashboard_json")"; then
    echo "Error: failed to create/update Grafana stack." >&2
    return 1
  fi
  IFS=$'\t' read -r ns service_name deploy_name admin_user admin_password <<<"$grafana_row"

  remote_port="$GRAFANA_PORT"
  if ! [[ "$remote_port" =~ ^[0-9]+$ ]]; then
    remote_port=3000
  fi
  base_port="$GRAFANA_LOCAL_PORT_BASE"
  if ! [[ "$base_port" =~ ^[0-9]+$ ]]; then
    base_port=3000
  fi
  bind_address="$(grafana_port_forward_address)"
  bind_address="$(trim_whitespace "$bind_address")"
  if [[ -z "$bind_address" ]]; then
    bind_address="127.0.0.1"
  fi

  echo "[grafana] Starting background local port-forward(s) ..."
  echo "[grafana] Port-forward bind address: ${bind_address}"
  local_port="$base_port"
  for ((attempt=0; attempt<25; attempt++)); do
    quiet_attempt="true"
    if (( attempt == 24 )); then
      quiet_attempt="false"
    fi
    if forward_row="$(ensure_grafana_port_forward "$ns" "$service_name" "$((local_port + attempt))" "$remote_port" "$bind_address" "$quiet_attempt")"; then
      forwarded_rows+=("$forward_row")
      break
    fi
  done

  if [[ ${#forwarded_rows[@]} -eq 0 ]]; then
    echo "Error: failed to start background port-forward for Grafana service." >&2
    return 1
  fi

  IFS=$'\t' read -r ns service_name local_port _pid log_file <<<"${forwarded_rows[0]}"
  probe_host=127.0.0.1
  if ! address_list_allows_loopback "$bind_address"; then
    probe_host="$(first_non_loopback_bind_address "$bind_address")" || return 1
  fi
  if ! wait_grafana_dashboard_ready "$local_port" "$GRAFANA_PORT_FORWARD_VERIFY_SECONDS" \
      "$admin_user" "$admin_password" "$dashboard_uid" "$probe_host"; then
    cleanup_grafana_port_forwards
    echo "Error: the provisioned TON dashboard is not available in Grafana; check deployment ${ns}/${deploy_name} logs." >&2
    return 1
  fi
  if address_list_allows_loopback "$bind_address"; then
    echo "[grafana] Background access: http://127.0.0.1:${local_port}${dashboard_path} (service ${ns}/${service_name})"
  fi
  if address_list_exposes_non_loopback "$bind_address"; then
    remote_access_host="$(first_non_loopback_bind_address "$bind_address" || true)"
    remote_access_host="$(trim_whitespace "$remote_access_host")"
    if [[ -z "$remote_access_host" ]]; then
      remote_access_host="$(resolve_primary_host_address || true)"
      remote_access_host="$(trim_whitespace "$remote_access_host")"
    fi
    if [[ -n "$remote_access_host" ]]; then
      echo "[grafana] Remote access: http://${remote_access_host}:${local_port}${dashboard_path}"
    fi
  fi
  echo "[grafana] Admin user: ${admin_user}"
  echo "[grafana] Admin password: ${admin_password}"
  echo "[grafana] Credentials Secret: ${ns}/${GRAFANA_ADMIN_SECRET_NAME}"
  echo "[grafana] Datasource: kubeton-managed Prometheus service(s) provisioned."
  echo "[grafana] Dashboard: TON overview provisioned and set as the home dashboard (folder: Kubeton)."
  echo "[grafana] Port-forward log: ${log_file}"
  return 0
}

run_grafana_stop() {
  require_bin kubectl
  if [[ $# -ne 0 ]]; then
    echo "Error: usage: kubeton grafana stop" >&2
    exit 1
  fi

  cleanup_grafana_resources
  echo "[grafana] kubeton-managed Grafana resources and local port-forward(s) removed."
}

run_grafana() {
  local subcommand="${1:-start}"
  case "$subcommand" in
    start)
      if [[ $# -gt 0 ]]; then
        shift
      fi
      run_grafana_start "$@"
      ;;
    stop)
      if [[ $# -gt 0 ]]; then
        shift
      fi
      run_grafana_stop "$@"
      ;;
    *)
      echo "Error: unknown grafana subcommand '$subcommand'." >&2
      echo "Usage: kubeton grafana [start|stop]" >&2
      exit 1
      ;;
  esac
}

ensure_start_victoria_metrics() {
  require_bin kubectl
  require_bin nohup
  local reuse_start_logs="${1:-false}"

  local ns operator_ns stack_name auth_username auth_password
  local timeout_seconds operator_row operator_version operator_manifest_url
  local -a scrape_rows=()
  local auth_service_name auth_deploy_name
  local credentials_row credentials_secret username password
  local base_port local_port remote_port bind_address remote_access_host="" api_proxy_base_port
  local api_proxy_row api_proxy_port api_proxy_log
  local vmsingle_service vmagent_service
  local forward_row log_file pf_ns pf_service
  local -a forwarded_rows=()
  local metrics_port_forward_ok=0
  local logs_enabled_raw logs_enabled="false"
  local logs_ns logs_release_name logs_collector_release_name
  local logs_retention_period logs_pvc_size logs_remote_port
  local logs_stack_row logs_helm_timeout_seconds logs_auth_static_url=""
  local logs_access_service logs_backend_service logs_collector_daemonset logs_remote_write_url=""
  local logs_ds_ready="" logs_ds_desired=""

  ns="$(trim_whitespace "${VICTORIA_METRICS_NAMESPACE:-vm}")"
  if [[ -z "$ns" ]]; then
    ns="vm"
  fi
  operator_ns="$(trim_whitespace "${VICTORIA_METRICS_OPERATOR_NAMESPACE:-vm}")"
  if [[ -z "$operator_ns" ]]; then
    operator_ns="vm"
  fi
  stack_name="$(victoria_metrics_stack_name)"
  auth_username="$(trim_whitespace "${VICTORIA_METRICS_AUTH_USERNAME:-}")"
  if [[ -z "$auth_username" ]]; then
    auth_username="$stack_name"
  fi
  auth_password="$(trim_whitespace "${VICTORIA_METRICS_AUTH_PASSWORD:-}")"
  timeout_seconds="$(resolve_victoria_metrics_rollout_timeout_seconds)"
  logs_enabled_raw="$(trim_whitespace "${VICTORIA_LOGS_ENABLED:-true}")"
  if is_true "$logs_enabled_raw" && is_true "$KUBETON_START_VICTORIA_LOGS_ENABLED"; then
    logs_enabled="true"
    require_bin helm
  fi
  logs_ns="$(victoria_logs_namespace)"
  logs_release_name="$(victoria_logs_release_name)"
  logs_collector_release_name="$(victoria_logs_collector_release_name)"
  logs_retention_period="$(trim_whitespace "${VICTORIA_LOGS_RETENTION_PERIOD:-30d}")"
  if [[ -z "$logs_retention_period" ]]; then
    logs_retention_period="30d"
  fi
  logs_pvc_size="$(trim_whitespace "${VICTORIA_LOGS_PVC_SIZE:-10Gi}")"
  if [[ -z "$logs_pvc_size" ]]; then
    logs_pvc_size="10Gi"
  fi
  logs_remote_port="$(trim_whitespace "${VICTORIA_LOGS_PORT:-9428}")"
  if ! [[ "$logs_remote_port" =~ ^[0-9]+$ ]]; then
    logs_remote_port=9428
  fi
  logs_access_service="$(victoria_logs_access_service_name "$logs_release_name")"
  if [[ "$logs_enabled" == "true" ]]; then
    logs_auth_static_url="http://${logs_access_service}.${logs_ns}.svc:${logs_remote_port}"
    # Stop legacy direct VictoriaLogs forwards so only VMAuth-exposed routes remain.
    cleanup_victoria_logs_port_forwards
  fi
  logs_helm_timeout_seconds="$(resolve_victoria_logs_helm_timeout_seconds)"

  if [[ "$logs_enabled" == "true" ]] && ! is_true "$reuse_start_logs"; then
    echo "[check] Refreshing node prerequisites for VictoriaLogs placement ..."
    if ! run_node_prerequisite_check_readonly; then
      restrict_existing_victoria_logs_after_failed_preflight standalone || true
      echo "Error: VictoriaLogs was not installed because no safe fresh placement set could be proven." >&2
      return 1
    fi
  elif [[ "$logs_enabled" == "true" ]]; then
    if [[ -z "$KUBETON_VICTORIA_LOGS_APPLIED_NODES" \
      || "$KUBETON_VICTORIA_LOGS_APPLIED_NODES" != "$(victoria_logs_eligible_nodes_csv)" ]]; then
      echo "Error: metrics setup requires VictoriaLogs on the current preflight-approved nodes; rerun kubeton start." >&2
      return 1
    fi
  fi

  if ! operator_row="$(ensure_victoria_metrics_operator "$operator_ns" "$stack_name")"; then
    return 1
  fi
  IFS=$'\t' read -r operator_version operator_manifest_url <<<"$operator_row"
  operator_version="$(trim_whitespace "$operator_version")"
  operator_manifest_url="$(trim_whitespace "$operator_manifest_url")"

  echo "[victoria-metrics] Applying VMSingle/VMAgent/VMAuth/VMUser stack ..."
  ensure_victoria_metrics_stack "$ns" "$stack_name" "$auth_username" "$auth_password" "$timeout_seconds" "$logs_auth_static_url" || return 1
  ensure_victoria_metrics_scrape_resources scrape_rows || return 1
  write_victoria_metrics_state "$operator_ns" "$stack_name" "$ns" "$operator_ns" "$operator_version" "$operator_manifest_url" || return 1

  if [[ "$logs_enabled" == "true" ]] && ! is_true "$reuse_start_logs"; then
    logs_collector_daemonset="$(victoria_logs_collector_daemonset_name "$logs_collector_release_name")"
    if ! write_victoria_logs_state "$OP_NAMESPACE" "$logs_ns" "$logs_release_name" \
        "$logs_collector_release_name" "$logs_access_service" "$logs_collector_daemonset"; then
      echo "Error: VictoriaLogs install intent could not be persisted; Helm was not started." >&2
      return 1
    fi
    if ! logs_stack_row="$(ensure_victoria_logs_stack "$logs_ns" "$logs_release_name" "$logs_collector_release_name" "$logs_remote_port" "$logs_retention_period" "$logs_pvc_size" "$timeout_seconds" "$logs_helm_timeout_seconds")"; then
      return 1
    fi
    IFS=$'\t' read -r logs_access_service logs_backend_service logs_collector_daemonset logs_remote_write_url logs_ds_ready logs_ds_desired <<<"$logs_stack_row"
    logs_access_service="$(trim_whitespace "$logs_access_service")"
    logs_backend_service="$(trim_whitespace "$logs_backend_service")"
    logs_collector_daemonset="$(trim_whitespace "$logs_collector_daemonset")"
    logs_remote_write_url="$(trim_whitespace "$logs_remote_write_url")"
    logs_ds_ready="$(trim_whitespace "$logs_ds_ready")"
    logs_ds_desired="$(trim_whitespace "$logs_ds_desired")"
    logs_access_service="$(trim_whitespace "$logs_access_service")"
    write_victoria_logs_state "$OP_NAMESPACE" "$logs_ns" "$logs_release_name" "$logs_collector_release_name" "$logs_access_service" "$logs_collector_daemonset"
  fi

  auth_service_name="$(resolve_victoria_metrics_auth_service_name "$ns" "$stack_name" || true)"
  auth_service_name="$(trim_whitespace "$auth_service_name")"
  if [[ -z "$auth_service_name" ]]; then
    echo "Error: failed to resolve VictoriaMetrics auth service name in namespace ${ns}." >&2
    return 1
  fi
  auth_deploy_name="vmauth-${stack_name}"

  credentials_row="$(resolve_victoria_metrics_credentials "$ns" "$stack_name" "$auth_username" "$auth_password")" || return 1
  IFS=$'\t' read -r credentials_secret username password <<<"$credentials_row"
  username="$(trim_whitespace "$username")"
  password="$(trim_whitespace "$password")"

  remote_port="$VICTORIA_METRICS_AUTH_PORT"
  if ! [[ "$remote_port" =~ ^[0-9]+$ ]]; then
    remote_port=8427
  fi
  base_port="$VICTORIA_METRICS_AUTH_LOCAL_PORT_BASE"
  if ! [[ "$base_port" =~ ^[0-9]+$ ]]; then
    base_port=8427
  fi
  api_proxy_base_port="$VICTORIA_METRICS_API_PROXY_LOCAL_PORT_BASE"
  if ! [[ "$api_proxy_base_port" =~ ^[0-9]+$ ]]; then
    api_proxy_base_port=18427
  fi
  bind_address="$(victoria_metrics_port_forward_address)"
  bind_address="$(trim_whitespace "$bind_address")"
  if [[ -z "$bind_address" ]]; then
    bind_address="127.0.0.1"
  fi

  echo "[victoria-metrics] Starting background local port-forward ..."
  echo "[victoria-metrics] Port-forward bind address: ${bind_address}"
  if forward_row="$(start_victoria_metrics_auth_port_forward "$ns" "$auth_service_name" "$base_port" "$remote_port" "$bind_address" || true)"; then
    forward_row="$(trim_whitespace "$forward_row")"
    if [[ -n "$forward_row" ]]; then
      forwarded_rows+=("$forward_row")
    fi
  fi

  if [[ ${#forwarded_rows[@]} -eq 0 ]]; then
    if kubectl -n "$ns" get deployment "$auth_deploy_name" >/dev/null 2>&1; then
      echo "Warning: failed to start port-forward for ${ns}/${auth_service_name}; restarting deployment ${auth_deploy_name} and retrying once ..." >&2
      kubectl -n "$ns" rollout restart "deployment/${auth_deploy_name}" >/dev/null 2>&1 || true
      kubectl -n "$ns" rollout status "deployment/${auth_deploy_name}" --timeout="${timeout_seconds}s" >/dev/null 2>&1 || true
      if forward_row="$(start_victoria_metrics_auth_port_forward "$ns" "$auth_service_name" "$base_port" "$remote_port" "$bind_address" || true)"; then
        forward_row="$(trim_whitespace "$forward_row")"
        if [[ -n "$forward_row" ]]; then
          forwarded_rows+=("$forward_row")
        fi
      fi
    fi
  fi

  if [[ ${#forwarded_rows[@]} -eq 0 ]]; then
    metrics_port_forward_ok=0
    echo "Warning: failed to start background port-forward for VictoriaMetrics auth service ${ns}/${auth_service_name}." >&2
    echo "Warning: VictoriaMetrics stack is installed, but local VMAuth access is unavailable (kubelet proxy likely returned 502)." >&2
    echo "Warning: check node/kubelet reachability (kubectl get nodes -o wide) and retry: ./kubeton start" >&2
    if api_proxy_row="$(ensure_victoria_metrics_api_proxy "$api_proxy_base_port" || true)"; then
      api_proxy_row="$(trim_whitespace "$api_proxy_row")"
      if [[ -n "$api_proxy_row" ]]; then
        IFS=$'\t' read -r api_proxy_port _api_proxy_pid api_proxy_log <<<"$api_proxy_row"
        api_proxy_port="$(trim_whitespace "$api_proxy_port")"
        api_proxy_log="$(trim_whitespace "$api_proxy_log")"
        if [[ -n "$api_proxy_port" ]]; then
          vmsingle_service="vmsingle-${stack_name}"
          vmagent_service="vmagent-${stack_name}"
          echo "[victoria-metrics] Local fallback VMUI (kubectl proxy): http://127.0.0.1:${api_proxy_port}/api/v1/namespaces/${ns}/services/http:${vmsingle_service}:8428/proxy/vmui/"
          echo "[victoria-metrics] Local fallback targets (kubectl proxy): http://127.0.0.1:${api_proxy_port}/api/v1/namespaces/${ns}/services/http:${vmagent_service}:8429/proxy/targets"
          echo "[victoria-metrics] Local fallback query (kubectl proxy): http://127.0.0.1:${api_proxy_port}/api/v1/namespaces/${ns}/services/http:${vmsingle_service}:8428/proxy/api/v1/query"
          if [[ "$logs_enabled" == "true" ]]; then
            echo "[victoria-metrics] Local fallback VictoriaLogs VMUI (auth via VMAuth): http://127.0.0.1:${api_proxy_port}/api/v1/namespaces/${ns}/services/http:${auth_service_name}:${remote_port}/proxy/select/vmui/"
            echo "[victoria-metrics] Local fallback VictoriaLogs query API (auth via VMAuth): http://127.0.0.1:${api_proxy_port}/api/v1/namespaces/${ns}/services/http:${auth_service_name}:${remote_port}/proxy/select/logsql/query"
          fi
          if [[ -n "$api_proxy_log" ]]; then
            echo "[victoria-metrics] Local fallback proxy log: ${api_proxy_log}"
          fi
        fi
      fi
    fi
    ensure_victoria_metrics_nodeport_access_if_enabled "$ns" "$stack_name" "$remote_port" || true
  else
    metrics_port_forward_ok=1
    IFS=$'\t' read -r pf_ns pf_service local_port _pid log_file <<<"${forwarded_rows[0]}"
    if address_list_allows_loopback "$bind_address"; then
      echo "[victoria-metrics] Background VMUI access: http://127.0.0.1:${local_port}/vmui/"
      echo "[victoria-metrics] Background targets access: http://127.0.0.1:${local_port}/targets"
    fi
    if address_list_exposes_non_loopback "$bind_address"; then
      remote_access_host="$(first_non_loopback_bind_address "$bind_address" || true)"
      remote_access_host="$(trim_whitespace "$remote_access_host")"
      if [[ -z "$remote_access_host" ]]; then
        remote_access_host="$(resolve_primary_host_address || true)"
        remote_access_host="$(trim_whitespace "$remote_access_host")"
      fi
      if [[ -n "$remote_access_host" ]]; then
        echo "[victoria-metrics] Remote VMUI access: http://${remote_access_host}:${local_port}/vmui/"
        echo "[victoria-metrics] Remote targets access: http://${remote_access_host}:${local_port}/targets"
      fi
    fi
    if [[ "$logs_enabled" == "true" ]]; then
      echo "[victoria-metrics] VictoriaLogs VMUI access (auth via VMAuth): http://127.0.0.1:${local_port}/select/vmui/"
      echo "[victoria-metrics] VictoriaLogs query API (auth via VMAuth): http://127.0.0.1:${local_port}/select/logsql/query"
      if [[ -n "$remote_access_host" ]]; then
        echo "[victoria-metrics] VictoriaLogs remote VMUI access (auth via VMAuth): http://${remote_access_host}:${local_port}/select/vmui/"
        echo "[victoria-metrics] VictoriaLogs remote query API (auth via VMAuth): http://${remote_access_host}:${local_port}/select/logsql/query"
      fi
    fi
    echo "[victoria-metrics] Query endpoint: http://127.0.0.1:${local_port}/api/v1/query"
    echo "[victoria-metrics] Port-forward log: ${log_file}"
  fi

  echo "[victoria-metrics] Username: ${username}"
  echo "[victoria-metrics] Credentials secret: ${ns}/${credentials_secret}"
  echo "[victoria-metrics] In-cluster VMAuth URL (pod/cluster only): http://${auth_service_name}.${ns}.svc:${remote_port}/"
  echo "[victoria-metrics] In-cluster query endpoint (pod/cluster only): http://${auth_service_name}.${ns}.svc:${remote_port}/api/v1/query"
  echo "[victoria-metrics] Operator namespace: ${operator_ns}"
  echo "[victoria-metrics] Operator version: ${operator_version}"
  echo "[victoria-metrics] Operator manifest: ${operator_manifest_url}"
  if [[ "$logs_enabled" == "true" ]]; then
    echo "[victoria-metrics] VictoriaLogs enabled: true"
    echo "[victoria-metrics] VictoriaLogs namespace: ${logs_ns}"
    echo "[victoria-metrics] VictoriaLogs release: ${logs_release_name}"
    echo "[victoria-metrics] VictoriaLogs collector release: ${logs_collector_release_name}"
    echo "[victoria-metrics] VictoriaLogs in-cluster URL (auth via VMAuth, pod/cluster only): http://${auth_service_name}.${ns}.svc:${remote_port}/select/vmui/"
    echo "[victoria-metrics] VictoriaLogs in-cluster query API (auth via VMAuth, pod/cluster only): http://${auth_service_name}.${ns}.svc:${remote_port}/select/logsql/query"
    echo "[victoria-metrics] VictoriaLogs backend URL (internal service): http://${logs_access_service}.${logs_ns}.svc:${logs_remote_port}/select/vmui/"
    if [[ "$logs_ds_ready" =~ ^[0-9]+$ && "$logs_ds_desired" =~ ^[0-9]+$ ]]; then
      echo "[victoria-metrics] VictoriaLogs collector readiness: ${logs_ds_ready}/${logs_ds_desired}"
    fi
    if [[ -n "$logs_remote_write_url" ]]; then
      echo "[victoria-metrics] VictoriaLogs collector remoteWrite URL: ${logs_remote_write_url}"
    fi
  else
    echo "[victoria-metrics] VictoriaLogs enabled: false (controlled by VICTORIA_LOGS_ENABLED and KUBETON_START_VICTORIA_LOGS_ENABLED)"
  fi
  if (( metrics_port_forward_ok == 0 )); then
    echo "[victoria-metrics] Query endpoint: unavailable via direct port-forward; use fallback URLs above."
  fi
  echo "[victoria-metrics] TonNode scrape resources configured: ${#scrape_rows[@]}"
}

main_wallet_timeout_seconds() {
  local action="${1:-}" recipients="${2:-1}" raw confirm_timeout budget
  raw="$(trim_whitespace "${MAIN_WALLET_POD_TIMEOUT:-}")"
  if [[ "$raw" =~ ^([0-9]+)s?$ ]]; then
    printf '%s' "${BASH_REMATCH[1]}"
    return 0
  fi
  if [[ -z "$raw" && "$action" == send ]]; then
    [[ "$recipients" =~ ^[1-9][0-9]{0,5}$ ]] || recipients=1
    confirm_timeout="$(trim_whitespace "${MAIN_WALLET_CONFIRM_TIMEOUT_SEC:-180}")"
    [[ "$confirm_timeout" =~ ^[1-9][0-9]{0,5}$ ]] || confirm_timeout=180
    # Reserve confirmation/transport for each payment and optional initial
    # deployment, plus helper startup, durable writes and encrypted backup.
    budget=$(( (recipients + 1) * (confirm_timeout + 60) + 120 ))
    if (( budget > 900 )); then
      printf '%s' "$budget"
      return 0
    fi
  fi
  printf '%s' "900"
}

find_main_wallet_template_pvc() {
  local preferred_ns="$1"
  local sts_name=""

  sts_name="$(kubectl -n "$preferred_ns" get statefulsets -l "$TON_POD_LABEL" -o jsonpath='{.items[0].metadata.name}' 2>/dev/null || true)"
  sts_name="$(trim_whitespace "$sts_name")"
  if [[ -n "$sts_name" ]] && kubectl -n "$preferred_ns" get pvc "keybundle-${sts_name}-0" >/dev/null 2>&1; then
    printf '%s\t%s\n' "$preferred_ns" "keybundle-${sts_name}-0"
    return 0
  fi

  local row ns sts
  while IFS= read -r row; do
    [[ -z "$row" ]] && continue
    IFS=$'\t' read -r ns sts _ <<<"$row"
    [[ -z "$ns" || -z "$sts" ]] && continue
    if kubectl -n "$ns" get pvc "keybundle-${sts}-0" >/dev/null 2>&1; then
      printf '%s\t%s\n' "$ns" "keybundle-${sts}-0"
      return 0
    fi
  done < <(list_ton_statefulsets 2>/dev/null || true)
  return 1
}

ensure_main_wallet_bundle_pvc() {
  local ns="$1"
  local pvc_name="$MAIN_WALLET_BUNDLE_PVC"
  local source_row source_ns source_pvc
  local storage_request storage_class volume_mode access_modes_raw
  local -a access_modes=()
  local mode

  if kubectl -n "$ns" get pvc "$pvc_name" >/dev/null 2>&1; then
    return 0
  fi

  source_row="$(find_main_wallet_template_pvc "$ns" || true)"
  source_row="$(trim_whitespace "$source_row")"
  if [[ -n "$source_row" ]]; then
    IFS=$'\t' read -r source_ns source_pvc <<<"$source_row"
    storage_request="$(kubectl -n "$source_ns" get pvc "$source_pvc" -o jsonpath='{.spec.resources.requests.storage}' 2>/dev/null || true)"
    storage_class="$(kubectl -n "$source_ns" get pvc "$source_pvc" -o jsonpath='{.spec.storageClassName}' 2>/dev/null || true)"
    volume_mode="$(kubectl -n "$source_ns" get pvc "$source_pvc" -o jsonpath='{.spec.volumeMode}' 2>/dev/null || true)"
    access_modes_raw="$(kubectl -n "$source_ns" get pvc "$source_pvc" -o jsonpath='{.spec.accessModes[*]}' 2>/dev/null || true)"
    read -r -a access_modes <<<"$access_modes_raw"
  fi

  storage_request="$(trim_whitespace "${storage_request:-}")"
  if [[ -z "$storage_request" ]]; then
    storage_request="$(trim_whitespace "$MAIN_WALLET_BUNDLE_SIZE")"
  fi
  if [[ -z "$storage_request" ]]; then
    storage_request="5Gi"
  fi

  storage_class="$(trim_whitespace "${storage_class:-}")"
  if [[ -z "$storage_class" ]]; then
    storage_class="$(trim_whitespace "$MAIN_WALLET_BUNDLE_STORAGE_CLASS")"
  fi
  ensure_main_wallet_longhorn_ready "$storage_class"

  volume_mode="$(trim_whitespace "${volume_mode:-}")"
  if [[ ${#access_modes[@]} -eq 0 ]]; then
    access_modes=("$(trim_whitespace "$MAIN_WALLET_BUNDLE_ACCESS_MODE")")
  fi
  if [[ -z "${access_modes[0]:-}" ]]; then
    access_modes=("ReadWriteOnce")
  fi

  {
    echo "apiVersion: v1"
    echo "kind: PersistentVolumeClaim"
    echo "metadata:"
    echo "  name: ${pvc_name}"
    echo "  namespace: ${ns}"
    echo "  labels:"
    echo "    app.kubernetes.io/name: kubeton-main-wallet"
    echo "    app.kubernetes.io/managed-by: kubeton"
    echo "spec:"
    echo "  accessModes:"
    for mode in "${access_modes[@]}"; do
      mode="$(trim_whitespace "$mode")"
      [[ -z "$mode" ]] && continue
      echo "  - ${mode}"
    done
    if [[ -n "$storage_class" ]]; then
      echo "  storageClassName: ${storage_class}"
    fi
    if [[ -n "$volume_mode" ]]; then
      echo "  volumeMode: ${volume_mode}"
    fi
    echo "  resources:"
    echo "    requests:"
    echo "      storage: ${storage_request}"
  } | kubectl apply -f - >/dev/null

  if pvc_uses_wait_for_first_consumer "$ns" "$pvc_name"; then
    echo "PVC ${ns}/${pvc_name} uses WaitForFirstConsumer; skipping pre-run Bound wait."
    return 0
  fi
  wait_pvc_bound "$ns" "$pvc_name" 900
}

ensure_main_wallet_script_configmap() {
  local ns="$1"
  if [[ ! -f "$MAIN_WALLET_SCRIPT_FILE" ]]; then
    echo "Error: main wallet script file not found: ${MAIN_WALLET_SCRIPT_FILE}" >&2
    return 1
  fi
  kubectl -n "$ns" create configmap "$MAIN_WALLET_SCRIPT_CONFIGMAP" \
    --from-file=main-wallet.sh="$MAIN_WALLET_SCRIPT_FILE" \
    --dry-run=client -o yaml | kubectl -n "$ns" apply -f - >/dev/null
}

main_wallet_bundle_storage_class() {
  local ns="$1"
  local pvc_name="$2"
  local storage_class=""

  storage_class="$(kubectl -n "$ns" get pvc "$pvc_name" -o jsonpath='{.spec.storageClassName}' 2>/dev/null || true)"
  storage_class="$(trim_whitespace "$storage_class")"
  if [[ -z "$storage_class" ]]; then
    storage_class="$(kubectl get storageclass -o jsonpath='{range .items[*]}{.metadata.name}{"\t"}{.metadata.annotations.storageclass\.kubernetes\.io/is-default-class}{"\n"}{end}' 2>/dev/null | awk '$2=="true"{print $1; exit}')"
    storage_class="$(trim_whitespace "$storage_class")"
  fi
  printf '%s' "$storage_class"
}

ensure_main_wallet_longhorn_ready() {
  local storage_class="$1"
  local provisioner desired ready

  storage_class="$(trim_whitespace "$storage_class")"
  [[ -z "$storage_class" ]] && return 0

  if ! kubectl get storageclass "$storage_class" >/dev/null 2>&1; then
    echo "Error: main-wallet storage class '${storage_class}' not found." >&2
    return 1
  fi

  provisioner="$(kubectl get storageclass "$storage_class" -o jsonpath='{.provisioner}' 2>/dev/null || true)"
  provisioner="$(trim_whitespace "$provisioner")"
  if [[ "$provisioner" != "driver.longhorn.io" ]]; then
    return 0
  fi

  if ! kubectl -n "$LONGHORN_NAMESPACE" get daemonset longhorn-manager >/dev/null 2>&1; then
    echo "Error: storage class '${storage_class}' uses Longhorn, but daemonset ${LONGHORN_NAMESPACE}/longhorn-manager is missing." >&2
    echo "Run './kubeton bootstrap-baremetal' or fix Longhorn before running main-wallet." >&2
    return 1
  fi

  desired="$(kubectl -n "$LONGHORN_NAMESPACE" get daemonset longhorn-manager -o jsonpath='{.status.desiredNumberScheduled}' 2>/dev/null || true)"
  ready="$(kubectl -n "$LONGHORN_NAMESPACE" get daemonset longhorn-manager -o jsonpath='{.status.numberReady}' 2>/dev/null || true)"
  desired="$(trim_whitespace "$desired")"
  ready="$(trim_whitespace "$ready")"

  if ! [[ "$desired" =~ ^[0-9]+$ && "$ready" =~ ^[0-9]+$ ]]; then
    echo "Error: cannot read Longhorn readiness for daemonset ${LONGHORN_NAMESPACE}/longhorn-manager." >&2
    return 1
  fi
  if (( desired == 0 || ready == 0 )); then
    echo "Error: Longhorn is required by storage class '${storage_class}', but longhorn-manager readiness is ${ready}/${desired}." >&2
    return 1
  fi

  if ! kubectl -n "$LONGHORN_NAMESPACE" rollout status daemonset/longhorn-manager --timeout=120s >/dev/null 2>&1; then
    echo "Error: Longhorn manager is not Ready (daemonset ${LONGHORN_NAMESPACE}/longhorn-manager)." >&2
    return 1
  fi
}

main_wallet_pod_longhorn_csi_affinity_yaml() {
  local storage_class="$1"
  local provisioner=""
  local -a longhorn_csi_nodes=()
  local node

  storage_class="$(trim_whitespace "$storage_class")"
  [[ -z "$storage_class" ]] && return 0

  provisioner="$(kubectl get storageclass "$storage_class" -o jsonpath='{.provisioner}' 2>/dev/null || true)"
  provisioner="$(trim_whitespace "$provisioner")"
  if [[ "$provisioner" != "driver.longhorn.io" ]]; then
    return 0
  fi

  mapfile -t longhorn_csi_nodes < <(list_longhorn_csi_node_names)
  if [[ ${#longhorn_csi_nodes[@]} -eq 0 ]]; then
    echo "Error: storage class '${storage_class}' uses Longhorn, but no nodes with CSI driver 'driver.longhorn.io' were found in CSINode." >&2
    return 1
  fi

  echo "  affinity:"
  echo "    nodeAffinity:"
  echo "      requiredDuringSchedulingIgnoredDuringExecution:"
  echo "        nodeSelectorTerms:"
  echo "          - matchExpressions:"
  echo "              - key: kubernetes.io/hostname"
  echo "                operator: In"
  echo "                values:"
  for node in "${longhorn_csi_nodes[@]}"; do
    node="$(trim_whitespace "$node")"
    [[ -z "$node" ]] && continue
    printf '                  - %s\n' "$(yaml_quote "$node")"
  done
}

main_wallet_helper_pod_uses_pvc() {
  local ns="$1"
  local pod="$2"
  local pvc_name="$3"
  local claim=""

  while IFS= read -r claim; do
    claim="$(trim_whitespace "$claim")"
    [[ -z "$claim" ]] && continue
    if [[ "$claim" == "$pvc_name" ]]; then
      return 0
    fi
  done < <(kubectl -n "$ns" get pod "$pod" -o jsonpath='{range .spec.volumes[*]}{.persistentVolumeClaim.claimName}{"\n"}{end}' 2>/dev/null || true)

  return 1
}

cleanup_terminated_main_wallet_helper_pods() {
  local ns="$1"
  kubectl -n "$ns" delete pod -l app.kubernetes.io/name=kubeton-main-wallet --field-selector=status.phase==Succeeded --ignore-not-found --wait=false >/dev/null 2>&1 || true
  kubectl -n "$ns" delete pod -l app.kubernetes.io/name=kubeton-main-wallet --field-selector=status.phase==Failed --ignore-not-found --wait=false >/dev/null 2>&1 || true
}

ensure_main_wallet_helper_slot() {
  local ns="$1"
  local pvc_name="$2"
  local timeout_seconds="${3:-120}"
  local deadline row pod phase deleting
  local -a conflicting_pods=()

  cleanup_terminated_main_wallet_helper_pods "$ns"
  deadline=$(( $(date +%s) + timeout_seconds ))

  while (( $(date +%s) < deadline )); do
    conflicting_pods=()
    while IFS= read -r row; do
      [[ -z "$row" ]] && continue
      IFS=$'\t' read -r pod phase deleting <<<"$row"
      pod="$(trim_whitespace "$pod")"
      phase="$(trim_whitespace "$phase")"
      deleting="$(trim_whitespace "$deleting")"
      [[ -z "$pod" ]] && continue
      [[ "$phase" == "Succeeded" || "$phase" == "Failed" ]] && continue
      if ! main_wallet_helper_pod_uses_pvc "$ns" "$pod" "$pvc_name"; then
        continue
      fi
      if [[ -n "$deleting" ]]; then
        continue
      fi
      conflicting_pods+=("${pod} (${phase:-unknown})")
    done < <(kubectl -n "$ns" get pods -l app.kubernetes.io/name=kubeton-main-wallet -o jsonpath='{range .items[*]}{.metadata.name}{"\t"}{.status.phase}{"\t"}{.metadata.deletionTimestamp}{"\n"}{end}' 2>/dev/null || true)

    if [[ ${#conflicting_pods[@]} -eq 0 ]]; then
      return 0
    fi
    sleep 2
  done

  echo "Error: another main-wallet helper pod is still active and holds PVC '${pvc_name}'." >&2
  echo "Conflicting pod(s): ${conflicting_pods[*]}" >&2
  echo "Wait for completion or delete stale helper pod(s) before retrying." >&2
  return 1
}

main_wallet_mount_conflict_event() {
  local ns="$1"
  local pod="$2"
  local message

  message="$(kubectl -n "$ns" get events \
    --field-selector "involvedObject.kind=Pod,involvedObject.name=${pod},type=Warning,reason=FailedMount" \
    --sort-by=.lastTimestamp \
    -o custom-columns=MESSAGE:.message \
    --no-headers 2>/dev/null | tail -n 1 || true)"
  message="$(trim_whitespace "$message")"

  if [[ -z "$message" ]]; then
    return 1
  fi

  if grep -Eiq 'already mapped or mounted|Cannot use device /dev/longhorn/.*in use|already mounted or mount point busy' <<<"$message"; then
    printf '%s' "$message"
    return 0
  fi
  return 1
}

wait_main_wallet_pod_completion() {
  local ns="$1"
  local pod="$2"
  local timeout_seconds="$3"
  local deadline phase exit_code mount_conflict

  deadline=$(( $(date +%s) + timeout_seconds ))
  while (( $(date +%s) < deadline )); do
    phase="$(kubectl -n "$ns" get pod "$pod" -o jsonpath='{.status.phase}' 2>/dev/null || true)"
    phase="$(trim_whitespace "$phase")"
    case "$phase" in
      Succeeded)
        return 0
        ;;
      Failed)
        exit_code="$(kubectl -n "$ns" get pod "$pod" -o jsonpath='{.status.containerStatuses[0].state.terminated.exitCode}' 2>/dev/null || true)"
        exit_code="$(trim_whitespace "$exit_code")"
        if [[ "$exit_code" =~ ^[0-9]+$ ]]; then
          return "$exit_code"
        fi
        return 1
        ;;
      "")
        ;;
      *)
        ;;
    esac
    if mount_conflict="$(main_wallet_mount_conflict_event "$ns" "$pod")"; then
      echo "Error: encrypted volume mount conflict detected for ${ns}/${pod}: ${mount_conflict}" >&2
      echo "Aborting early to avoid waiting for timeout." >&2
      return 1
    fi
    sleep 2
  done

  echo "Error: timeout waiting for pod ${ns}/${pod} completion." >&2
  return 1
}

