delete_labeled_resources_all_namespaces() {
  local selector="$1"
  local label="${2:-uninstall}"
  local resource effective_selector

  selector="$(trim_whitespace "$selector")"
  [[ -n "$selector" ]] || return 0

  while IFS= read -r resource; do
    resource="$(trim_whitespace "$resource")"
    [[ -z "$resource" ]] && continue
    effective_selector="$selector"
    if (( KUBETON_RETAIN_VICTORIA_LOGS_GUARDS == 1 )); then
      case "$resource" in
        configmaps|configmaps.*|networkpolicies|networkpolicies.*)
          effective_selector="${selector},app.kubernetes.io/part-of!=kubeton-victoria-logs"
          ;;
      esac
    fi
    kubectl delete "$resource" -A -l "$effective_selector" --ignore-not-found --wait=false >/dev/null 2>&1 || true
  done < <(kubectl api-resources --verbs=list --namespaced=true -o name 2>/dev/null || true)

  while IFS= read -r resource; do
    resource="$(trim_whitespace "$resource")"
    [[ -z "$resource" ]] && continue
    case "$resource" in
      namespaces|nodes|persistentvolumes|storageclasses.storage.k8s.io|customresourcedefinitions.apiextensions.k8s.io)
        continue
        ;;
    esac
    kubectl delete "$resource" -l "$selector" --ignore-not-found --wait=false >/dev/null 2>&1 || true
  done < <(kubectl api-resources --verbs=list --namespaced=false -o name 2>/dev/null || true)

  echo "[${label}] Requested deletion for resources matching ${selector}."
}

