    echo "  kubeton wallet collect main-wallet 10."
    echo "  kubeton wallet collect main-wallet tonnode-0 validator_wallet_001 alld"
  }

  local action="${1:-}"
  shift || true
  if [[ -z "$action" ]]; then
    wallet_usage
    return 0
  fi
  case "$action" in
    help|-h|--help)
      wallet_usage
      return 0
      ;;
    create|deploy|activate|send|collect|show|export)
      ;;
    *)
      echo "Error: unknown wallet subcommand '$action'." >&2
      wallet_usage >&2
      return 1
      ;;
  esac

  require_bin kubectl

  local -a action_args=()
  local row target_ns target_pod target_node_name target_wallet_name destination_address amount
  local from_wallet_name to_tonnode_name
  local wallet_network=""
  local legacy_network=""
  local KUBETON_WALLET_NETWORK="" KUBETON_WALLET_GLOBAL_CONFIG_JSON=""
  local -a table_rows=()
  local -a destination_addresses=()
  case "$action" in
    deploy|send|collect)
