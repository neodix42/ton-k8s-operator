cleanup_owned_namespaced_kinds() {
  local selector="$1" kinds="$2" ns="${3:-}" inventory kind resource rc=0
  local -a scope=(-A)
  [[ -z "$ns" ]] || scope=(-n "$ns")
  if ! inventory="$(kubectl api-resources --verbs=list --namespaced=true -o name)"; then
    echo "Error: cannot discover resource types during owned-resource cleanup." >&2
    return 1
  fi
  if [[ -z "$(trim_whitespace "$inventory")" ]]; then
    echo "Error: resource discovery returned no namespaced resource types during cleanup." >&2
    return 1
  fi
  for kind in $kinds; do
    resource="$(printf '%s\n' "$inventory" | awk -F. -v kind="$kind" '$1 == kind {print; exit}')"
    [[ -n "$resource" ]] || continue
    if ! kubectl delete "$resource" "${scope[@]}" -l "$selector" --ignore-not-found --cascade=foreground --wait=true --timeout=60s >/dev/null; then
      echo "Error: cleanup of ${resource} matching ${selector} did not complete." >&2
      rc=1
    fi
  done
  return "$rc"
}

