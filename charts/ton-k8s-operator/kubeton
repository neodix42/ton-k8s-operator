# Return the selected nodes which do not currently advertise Longhorn's CSI
# driver.  The scheduler checks CSINode.spec.drivers when it attaches a
# Longhorn PVC, so a healthy aggregate DaemonSet count is not enough: a
# different node can account for that count while a selected TON node is
# missing driver.longhorn.io.
ton_selected_nodes_missing_longhorn_csi() {
  local selector="$1"
  local selected_rows csi_rows ready_plugin_rows node selector_display
  local -A selected_nodes=()
  local -A csi_nodes=()
  local -A ready_plugin_nodes=()

  selector="$(trim_whitespace "$selector")"
  selector_display="${selector:-all Kubernetes nodes}"
  if ! selected_rows="$(node_check_list_selector_nodes "$selector")"; then
    echo "Error: cannot list nodes selected by '${selector_display}' for Longhorn CSI verification." >&2
    return 1
  fi
  while IFS= read -r node; do
    node="$(trim_whitespace "$node")"
    [[ -n "$node" ]] && selected_nodes["$node"]=1
  done <<<"$selected_rows"
  if (( ${#selected_nodes[@]} == 0 )); then
    echo "Error: selected TON node selector '${selector_display}' matched no nodes for Longhorn CSI verification." >&2
    return 1
  fi

  if ! csi_rows="$(list_longhorn_csi_node_names_checked)"; then
    echo "Error: cannot list CSINode objects while verifying selected TON nodes." >&2
    return 1
  fi
  while IFS= read -r node; do
    node="$(trim_whitespace "$node")"
    [[ -n "$node" ]] && csi_nodes["$node"]=1
  done <<<"$csi_rows"
  if ! ready_plugin_rows="$(list_ready_longhorn_csi_plugin_node_names_checked)"; then
    echo "Error: cannot list Ready Longhorn CSI node-plugin Pods while verifying selected TON nodes." >&2
    return 1
  fi
  while IFS= read -r node; do
    node="$(trim_whitespace "$node")"
    [[ -n "$node" ]] && ready_plugin_nodes["$node"]=1
  done <<<"$ready_plugin_rows"

  for node in "${!selected_nodes[@]}"; do
    if [[ -z "${csi_nodes[$node]:-}" || -z "${ready_plugin_nodes[$node]:-}" ]]; then
      printf '%s\n' "$node"
    fi
  done | sort
}

verify_ton_selected_nodes_longhorn_csi_ready() {
  local selector="$1"
  local missing_nodes node

  if ! missing_nodes="$(ton_selected_nodes_missing_longhorn_csi "$selector")"; then
    return 1
  fi
  if [[ -z "$(trim_whitespace "$missing_nodes")" ]]; then
    echo "[check] Longhorn CSI driver is registered and its node plugin is Ready on every selected TON node."
    return 0
  fi

  echo "Error: Longhorn CSI driver registration or Ready node plugin is missing on selected TON node(s):" >&2
  while IFS= read -r node; do
    node="$(trim_whitespace "$node")"
    [[ -n "$node" ]] && echo "  - ${node}" >&2
  done <<<"$missing_nodes"
  echo "Ensure ${LONGHORN_NAMESPACE}/longhorn-csi-plugin is scheduled and Ready on every selected node." >&2
  return 1
}

wait_ton_selected_nodes_longhorn_csi_ready() {
  local selector="$1"
  local timeout_seconds="${2:-$KUBETON_LONGHORN_READY_TIMEOUT_SECONDS}"
  local deadline missing_nodes

  if ! [[ "$timeout_seconds" =~ ^[0-9]+$ ]] || (( timeout_seconds < 1 )); then
    echo "Error: invalid Longhorn CSI readiness timeout '${timeout_seconds}'." >&2
    return 1
  fi
  deadline=$(( $(date +%s) + timeout_seconds ))
  echo "[check] Waiting for Longhorn CSI driver registration on selected TON node(s) (timeout ${timeout_seconds}s) ..."

  while :; do
    if ! missing_nodes="$(ton_selected_nodes_missing_longhorn_csi "$selector")"; then
      return 1
    fi
    if [[ -z "$(trim_whitespace "$missing_nodes")" ]]; then
      echo "[check] Longhorn CSI driver is registered and its node plugin is Ready on every selected TON node."
      return 0
    fi
    if (( $(date +%s) >= deadline )); then
      echo "Error: Longhorn CSI driver registration or Ready node plugin was not available on selected TON node(s):" >&2
      while IFS= read -r node; do
        node="$(trim_whitespace "$node")"
        [[ -n "$node" ]] && echo "  - ${node}" >&2
      done <<<"$missing_nodes"
      echo "TON deployment was not applied. Ensure ${LONGHORN_NAMESPACE}/longhorn-csi-plugin is scheduled and Ready on every selected node, then rerun kubeton start." >&2
      return 1
    fi
    sleep 2
  done
}

