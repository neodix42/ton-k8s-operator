victoria_logs_helm_release_is_gone() {
  local ns="$1"
  local release_name="$2"
  local release_rows namespace_row helm_help
  local -a helm_list_cmd=()

  if ! namespace_row="$(kubectl get namespace "$ns" --ignore-not-found -o name 2>/dev/null)"; then
    echo "Error: cannot verify namespace ${ns} while checking VictoriaLogs Helm release ${release_name}." >&2
    return 1
  fi
  namespace_row="$(trim_whitespace "$namespace_row")"
  [[ -z "$namespace_row" ]] && return 0

  # Helm's default Secret driver and legacy ConfigMap driver both label
  # release records this way. Read metadata only; never expose release data.
  if ! release_rows="$(kubectl -n "$ns" get secret,configmap \
    -l "owner=helm,name=${release_name}" --ignore-not-found \
    -o jsonpath='{range .items[*]}{.metadata.labels.name}{"\n"}{end}' 2>/dev/null)"; then
    echo "Error: cannot verify stored Helm metadata for VictoriaLogs release ${ns}/${release_name}." >&2
    return 1
  fi
  if printf '%s\n' "$release_rows" | grep -Fxq "$release_name"; then
    echo "Error: VictoriaLogs Helm release ${ns}/${release_name} still exists; retaining its cleanup ledger." >&2
    return 1
  fi

  # Also cover a non-default Helm storage driver. Helm 3 needs --all to show
  # every release state, while Helm 4 removed that flag and lists all states by
  # default. Detect the supported interface instead of pinning uninstall to
  # one Helm major version.
  if command -v helm >/dev/null 2>&1; then
    helm_list_cmd=(helm list -n "$ns" --short)
    helm_help="$(helm list --help 2>/dev/null || true)"
    if printf '%s\n' "$helm_help" | grep -Eq '(^|[[:space:]])--all([[:space:]]|$)'; then
      helm_list_cmd+=(--all)
    fi
    if ! release_rows="$("${helm_list_cmd[@]}" 2>/dev/null)"; then
      echo "Error: cannot verify whether VictoriaLogs Helm release ${ns}/${release_name} remains." >&2
      return 1
    fi
    if printf '%s\n' "$release_rows" | grep -Fxq "$release_name"; then
      echo "Error: VictoriaLogs Helm release ${ns}/${release_name} still exists; retaining its cleanup ledger." >&2
      return 1
    fi
  fi
  return 0
}

cleanup_victoria_logs_resources() {
  local ns state_ns release_name collector_release_name row
  local state_value service_name
  local access_selector='app.kubernetes.io/part-of=kubeton-victoria-logs,app.kubernetes.io/managed-by=kubeton'
  local cleanup_timeout all_backends_gone=1 all_collectors_gone=1
  local all_helm_releases_gone=1 storage_cleanup_complete=1
  local -a single_release_rows=()
  local -a collector_release_rows=()
  local -a pvc_rows=()

  ns="$(victoria_logs_namespace)"
  state_ns="$OP_NAMESPACE"
  if kubectl -n "$state_ns" get configmap "$VICTORIA_LOGS_STATE_CONFIGMAP" >/dev/null 2>&1; then
    :
  elif kubectl -n "$ns" get configmap "$VICTORIA_LOGS_STATE_CONFIGMAP" >/dev/null 2>&1; then
    state_ns="$ns"
  elif [[ -n "${VICTORIA_METRICS_OPERATOR_NAMESPACE:-}" ]] && kubectl -n "$VICTORIA_METRICS_OPERATOR_NAMESPACE" get configmap "$VICTORIA_LOGS_STATE_CONFIGMAP" >/dev/null 2>&1; then
    state_ns="$VICTORIA_METRICS_OPERATOR_NAMESPACE"
  fi
  cleanup_timeout="$(trim_whitespace "${VICTORIA_LOGS_CLEANUP_TIMEOUT_SECONDS:-300}")"
  [[ "$cleanup_timeout" =~ ^[1-9][0-9]*$ ]] || cleanup_timeout=300

  state_value="$(read_victoria_logs_state_value "$state_ns" "namespace")"
  state_value="$(trim_whitespace "$state_value")"
  if [[ -n "$state_value" ]]; then
    ns="$state_value"
  fi

  release_name="$(read_victoria_logs_state_value "$state_ns" "releaseName")"
  release_name="$(trim_whitespace "$release_name")"
  if [[ -z "$release_name" ]]; then
    release_name="$(victoria_logs_release_name)"
  fi

  collector_release_name="$(read_victoria_logs_state_value "$state_ns" "collectorReleaseName")"
  collector_release_name="$(trim_whitespace "$collector_release_name")"
  if [[ -z "$collector_release_name" ]]; then
    collector_release_name="$(victoria_logs_collector_release_name)"
  fi
  service_name="$(victoria_logs_service_name "$release_name")"
  append_unique_item "$ns"$'\t'"$release_name" single_release_rows
  append_unique_item "$ns"$'\t'"$collector_release_name" collector_release_rows
  if ! collect_victoria_logs_release_rows single_release_rows collector_release_rows; then
    KUBETON_RETAIN_VICTORIA_LOGS_GUARDS=1
    echo "Error: VictoriaLogs release inventory is incomplete; refusing destructive logging cleanup and retaining ingress protection and cleanup state." >&2
    cleanup_victoria_logs_port_forwards
    return 1
  fi

  echo "[uninstall] Disabling kubeton-managed VictoriaLogs access Services ..."
  # Keep ingress isolation in place until every unauthenticated backend Pod is
  # proven gone. Removing Service access is safe up front; removing the policy
  # before a stalled StatefulSet disappears would expose its chart Service.
  kubectl delete service -A -l "$access_selector" --ignore-not-found >/dev/null 2>&1 || true

  echo "[uninstall] Uninstalling VictoriaLogs releases ..."
  if command -v helm >/dev/null 2>&1; then
    for row in "${collector_release_rows[@]}"; do
      [[ -z "$row" ]] && continue
      IFS=$'\t' read -r ns collector_release_name <<<"$row"
      ns="$(trim_whitespace "$ns")"
      collector_release_name="$(trim_whitespace "$collector_release_name")"
      [[ -z "$ns" || -z "$collector_release_name" ]] && continue
      helm uninstall "$collector_release_name" -n "$ns" >/dev/null 2>&1 || true
    done
    for row in "${single_release_rows[@]}"; do
      [[ -z "$row" ]] && continue
      IFS=$'\t' read -r ns release_name <<<"$row"
      ns="$(trim_whitespace "$ns")"
      release_name="$(trim_whitespace "$release_name")"
      [[ -z "$ns" || -z "$release_name" ]] && continue
      helm uninstall "$release_name" -n "$ns" >/dev/null 2>&1 || true
    done
  else
    echo "Warning: helm is not installed; attempting best-effort kubectl cleanup for VictoriaLogs resources." >&2
  fi

  for row in "${collector_release_rows[@]}"; do
    [[ -z "$row" ]] && continue
    IFS=$'\t' read -r ns collector_release_name <<<"$row"
    ns="$(trim_whitespace "$ns")"
    collector_release_name="$(trim_whitespace "$collector_release_name")"
    [[ -z "$ns" || -z "$collector_release_name" ]] && continue
    kubectl -n "$ns" delete daemonset,serviceaccount -l "app.kubernetes.io/name=victoria-logs-collector,app.kubernetes.io/instance=${collector_release_name}" --ignore-not-found >/dev/null 2>&1 || true
    kubectl delete clusterrole,clusterrolebinding -l "app.kubernetes.io/name=victoria-logs-collector,app.kubernetes.io/instance=${collector_release_name}" --ignore-not-found >/dev/null 2>&1 || true
  done

  for row in "${single_release_rows[@]}"; do
    [[ -z "$row" ]] && continue
    IFS=$'\t' read -r ns release_name <<<"$row"
    ns="$(trim_whitespace "$ns")"
    release_name="$(trim_whitespace "$release_name")"
    [[ -z "$ns" || -z "$release_name" ]] && continue
    service_name="$(victoria_logs_service_name "$release_name")"
    kubectl -n "$ns" delete statefulset,service,configmap,secret -l "app.kubernetes.io/name=victoria-logs-single,app.kubernetes.io/instance=${release_name}" --ignore-not-found --wait=false >/dev/null 2>&1 || true
    collect_pvc_rows_by_prefix "server-volume-${service_name}-" pvc_rows \
      "app.kubernetes.io/name=victoria-logs-single,app.kubernetes.io/instance=${release_name}" true \
      || storage_cleanup_complete=0
  done

  for row in "${single_release_rows[@]}"; do
    [[ -z "$row" ]] && continue
    IFS=$'\t' read -r ns release_name <<<"$row"
    ns="$(trim_whitespace "$ns")"
    release_name="$(trim_whitespace "$release_name")"
    [[ -z "$ns" || -z "$release_name" ]] && continue
    wait_victoria_logs_backend_gone "$ns" "$release_name" "$cleanup_timeout" || all_backends_gone=0
  done

  for row in "${collector_release_rows[@]}"; do
    [[ -z "$row" ]] && continue
    IFS=$'\t' read -r ns collector_release_name <<<"$row"
    ns="$(trim_whitespace "$ns")"
    collector_release_name="$(trim_whitespace "$collector_release_name")"
    [[ -z "$ns" || -z "$collector_release_name" ]] && continue
    wait_victoria_logs_collector_gone "$ns" "$collector_release_name" "$cleanup_timeout" || all_collectors_gone=0
    victoria_logs_helm_release_is_gone "$ns" "$collector_release_name" || all_helm_releases_gone=0
  done

  for row in "${single_release_rows[@]}"; do
    [[ -z "$row" ]] && continue
    IFS=$'\t' read -r ns release_name <<<"$row"
    ns="$(trim_whitespace "$ns")"
    release_name="$(trim_whitespace "$release_name")"
    [[ -z "$ns" || -z "$release_name" ]] && continue
    victoria_logs_helm_release_is_gone "$ns" "$release_name" || all_helm_releases_gone=0
  done

  if (( all_backends_gone == 1 )); then
    delete_pvc_rows_and_backing_volumes pvc_rows "uninstall" || storage_cleanup_complete=0
  else
    storage_cleanup_complete=0
  fi

  if (( all_backends_gone == 1 )); then
    echo "[uninstall] VictoriaLogs backends are gone; deleting their retained ingress policies ..."
    kubectl delete networkpolicy -A -l "$access_selector" --ignore-not-found >/dev/null 2>&1 || true
  fi
  if (( all_backends_gone == 1 && all_collectors_gone == 1 \
      && all_helm_releases_gone == 1 && storage_cleanup_complete == 1 )); then
    echo "[uninstall] VictoriaLogs workloads, releases, and storage are gone; deleting their cleanup state ..."
    kubectl delete configmap -A -l 'app.kubernetes.io/name=kubeton-victoria-logs,app.kubernetes.io/managed-by=kubeton' --ignore-not-found >/dev/null 2>&1 || true
  else
    KUBETON_RETAIN_VICTORIA_LOGS_GUARDS=1
    echo "Error: VictoriaLogs cleanup is incomplete; its release ledger and any still-needed ingress NetworkPolicy were retained for a safe retry." >&2
  fi
  cleanup_victoria_logs_port_forwards
  (( all_backends_gone == 1 && all_collectors_gone == 1 \
    && all_helm_releases_gone == 1 && storage_cleanup_complete == 1 ))
}

cleanup_victoria_metrics_resources() {
  local ns="${VICTORIA_METRICS_NAMESPACE}"
  local operator_ns="${VICTORIA_METRICS_OPERATOR_NAMESPACE}"
  local stack_name state_stack_ns state_operator_ns
  local rc=0
  local selector='app.kubernetes.io/part-of=kubeton-victoria-metrics,app.kubernetes.io/managed-by=kubeton'

  state_operator_ns="$(read_victoria_metrics_state_value "$operator_ns" "operatorNamespace")"
  state_operator_ns="$(trim_whitespace "$state_operator_ns")"
  if [[ -n "$state_operator_ns" ]]; then
    operator_ns="$state_operator_ns"
  fi

  state_stack_ns="$(read_victoria_metrics_state_value "$operator_ns" "stackNamespace")"
  state_stack_ns="$(trim_whitespace "$state_stack_ns")"
  if [[ -n "$state_stack_ns" ]]; then
    ns="$state_stack_ns"
  fi

  stack_name="$(read_victoria_metrics_state_value "$operator_ns" "stackName")"
  stack_name="$(trim_whitespace "$stack_name")"
  if [[ -z "$stack_name" ]]; then
    stack_name="$(victoria_metrics_stack_name)"
  fi

  echo "[uninstall] Deleting kubeton-managed VictoriaMetrics scrape resources ..."
  kubectl delete vmservicescrape,service -A -l "$selector" --ignore-not-found >/dev/null 2>&1 || true

  echo "[uninstall] Deleting kubeton-managed VictoriaMetrics stack resources ..."
  kubectl delete vmuser,vmauth,vmagent,vmsingle -A -l "$selector" --ignore-not-found --wait=false >/dev/null 2>&1 || true
  kubectl delete secret,configmap,service -A -l "$selector" --ignore-not-found --wait=false >/dev/null 2>&1 || true
  kubectl -n "$ns" delete vmuser,vmauth,vmagent,vmsingle "$stack_name" --ignore-not-found >/dev/null 2>&1 || true
  kubectl -n "$ns" delete secret "vmuser-${stack_name}" --ignore-not-found >/dev/null 2>&1 || true
  kubectl -n "$operator_ns" delete configmap "$VICTORIA_METRICS_STATE_CONFIGMAP" --ignore-not-found >/dev/null 2>&1 || true
  kubectl delete configmap -A -l 'app.kubernetes.io/name=kubeton-victoria-metrics,app.kubernetes.io/managed-by=kubeton' --ignore-not-found >/dev/null 2>&1 || true
  cleanup_victoria_metrics_port_forwards
  cleanup_victoria_logs_resources || rc=1
  cleanup_victoria_metrics_operator "$operator_ns" || rc=1
  return "$rc"
}

run_uninstall_step() {
  local failures_name="$1"
  local description="$2"
  shift 2
  local -n failures_ref="$failures_name"

  echo "[uninstall] ${description}"
  if "$@"; then
    return 0
  fi

  echo "Warning: uninstall step failed: ${description}; continuing with remaining cleanup." >&2
  failures_ref+=("$description")
  return 0
}

namespace_has_retained_victoria_logs_guards() {
  local ns="$1"
  local guard_rows namespace_row
  local guard_selector='app.kubernetes.io/part-of=kubeton-victoria-logs,app.kubernetes.io/managed-by=kubeton'

  if ! namespace_row="$(kubectl get namespace "$ns" --ignore-not-found -o name 2>/dev/null)"; then
    echo "Error: cannot verify namespace ${ns} while VictoriaLogs cleanup guards are active." >&2
    return 2
  fi
  namespace_row="$(trim_whitespace "$namespace_row")"
  [[ -z "$namespace_row" ]] && return 1
  if ! guard_rows="$(kubectl -n "$ns" get networkpolicy,configmap \
      -l "$guard_selector" --ignore-not-found -o name 2>/dev/null)"; then
    echo "Error: cannot verify retained VictoriaLogs guards in namespace ${ns}." >&2
    return 2
  fi
  guard_rows="$(trim_whitespace "$guard_rows")"
  [[ -n "$guard_rows" ]]
}

refuse_guarded_namespace_deletion_if_needed() {
  local ns="$1"
  local guard_rc=0

  (( KUBETON_RETAIN_VICTORIA_LOGS_GUARDS == 1 )) || return 1
  if namespace_has_retained_victoria_logs_guards "$ns"; then
    echo "Error: retaining namespace ${ns} because it contains VictoriaLogs ingress protection or cleanup-ledger records for a backend that was not proven gone." >&2
    return 0
  else
    guard_rc=$?
  fi
  if (( guard_rc == 2 )); then
    echo "Error: refusing to delete namespace ${ns} because its VictoriaLogs guard state could not be verified." >&2
    return 0
  fi
  return 1
}

cleanup_operator_release() {
  local rc=0

  helm uninstall "$RELEASE_NAME" -n "$OP_NAMESPACE" >/dev/null 2>&1 || true
  if refuse_guarded_namespace_deletion_if_needed "$OP_NAMESPACE"; then
    return 1
  fi
  delete_namespace_with_progress "$OP_NAMESPACE" "$NAMESPACE_DELETE_PROGRESS_TIMEOUT" || rc=1
  return "$rc"
}

cleanup_vault_release() {
  local rc=0
  uninstall_vault || true
  cleanup_vault_force || return 1
  if refuse_guarded_namespace_deletion_if_needed "$VAULT_NAMESPACE"; then
    return 1
  fi
  delete_namespace_with_progress "$VAULT_NAMESPACE" "$NAMESPACE_DELETE_PROGRESS_TIMEOUT" || rc=1
  return "$rc"
}

cleanup_encrypted_storage_class() {
  kubectl delete storageclass "$ENCRYPTED_SC_NAME" --ignore-not-found >/dev/null 2>&1 || true
}

cleanup_longhorn_release() {
  local rc=0 ledger_rc=0

  if (( KUBETON_RETAIN_VICTORIA_LOGS_GUARDS == 1 )); then
    echo "Error: refusing to uninstall Longhorn while a VictoriaLogs backend or its PVC cleanup is unresolved. Retry uninstall after VictoriaLogs is proven gone so launch evidence is not stranded." >&2
    return 1
  fi

  if storage_cleanup_ledger_has_pending_longhorn_targets; then
    echo "Error: refusing to uninstall Longhorn while the storage cleanup ledger still contains Longhorn volumes. Rerun kubeton uninstall after resolving the recorded storage cleanup." >&2
    return 1
  else
    ledger_rc=$?
  fi
  if (( ledger_rc == 2 )); then
    echo "Error: could not inspect the storage cleanup ledger before uninstalling Longhorn." >&2
    return 1
  fi

  uninstall_longhorn || true
  cleanup_longhorn_force || true
  delete_namespace_with_progress "$LONGHORN_NAMESPACE" "$NAMESPACE_DELETE_PROGRESS_TIMEOUT" || rc=1
  return "$rc"
}

cleanup_observability_resources() {
