wallet_network_from_global_config() {
  # Stable chain identities from the official TON global configurations:
  # https://ton-blockchain.github.io/{global.config,testnet-global.config}.json
  python3 -c '
import json
import sys

try:
    state = json.load(sys.stdin)["validator"]["zero_state"]
    if not isinstance(state, dict):
        raise ValueError("invalid zero-state object")
    if any(type(state.get(key)) is not int or state[key] != expected
           for key, expected in (("workchain", -1), ("shard", -9223372036854775808), ("seqno", 0))):
        raise ValueError("invalid zero-state block identity")
    identities = {
        ("F6OpKZKqvqeFp6CQmFomXNMfMj2EnaUSOXN+Mh+wVWk=",
         "XplPz01CXAps5qeSWUtxcyBfdAo5zVb1N979KLSKD24="): "mainnet",
        ("gj+B8wb/AmlPk1z1AhVI484rhrUpgSr2oSFIh56VoSg=",
         "Z+IKwYS54DmmJmesw/nAD5DzWadnOCMzee+kdgSYDOg="): "testnet",
    }
    print(identities[(state["root_hash"], state["file_hash"])])
except (ValueError, KeyError, TypeError):
    sys.exit("Error: global.config.json does not identify a supported TON mainnet or testnet.")
'
}

