else:
 volumes.append({"name":"bundle","emptyDir":{"medium":"Memory"}}); mounts.append({"name":"bundle","mountPath":"/bundle"})
container={"name":"restore","image":image,"command":["sh","-c","sleep 86400"],"env":agent.get("env",[]),"envFrom":agent.get("envFrom",[]),"volumeMounts":mounts}
if stage=="stage": container.update(resources=main.get("resources",{}),ports=main.get("ports",[]))
p={"restartPolicy":"Never","nodeSelector":spec.get("nodeSelector",{}),"affinity":{"nodeAffinity":{"requiredDuringSchedulingIgnoredDuringExecution":{"nodeSelectorTerms":[{"matchFields":[{"key":"metadata.name","operator":"In","values":[node]}]}]}}},"containers":[container],"volumes":volumes}
for field in ("serviceAccountName", "imagePullSecrets", "securityContext", "tolerations"):
