}

ton_address_to_hex() {
  local address normalized decoded_hex wc_hex wc_dec account_hex
  local crc=0 byte_offset bit byte_value

  address="$(trim_whitespace "${1:-}")"
  if [[ "$address" =~ ^(-?[0-9]+):([0-9A-Fa-f]{64})$ ]]; then
    printf '%s:%s' "${BASH_REMATCH[1]}" "$(printf '%s' "${BASH_REMATCH[2]}" | tr '[:upper:]' '[:lower:]')"
    return 0
  fi
  if ! [[ "$address" =~ ^[A-Za-z0-9_-]{48}$ ]]; then
    return 1
  fi
  if ! command -v base64 >/dev/null 2>&1 || ! command -v od >/dev/null 2>&1; then
    return 1
  fi

  normalized="${address//-/+}"
  normalized="${normalized//_/\/}"
  while (( ${#normalized} % 4 != 0 )); do
    normalized="${normalized}="
  done

  decoded_hex="$(printf '%s' "$normalized" | base64 -d 2>/dev/null | od -An -tx1 -v 2>/dev/null | tr -d ' \n')" || return 1
  if [[ ${#decoded_hex} -ne 72 ]]; then
    return 1
  fi
  case "${decoded_hex:0:2}" in
    11|51|91|d1) ;;
    *) return 1 ;;
  esac
  for ((byte_offset=0; byte_offset<68; byte_offset+=2)); do
    byte_value=$((16#${decoded_hex:byte_offset:2}))
    crc=$((crc ^ (byte_value << 8)))
    for ((bit=0; bit<8; bit++)); do
      if (( crc & 0x8000 )); then
        crc=$((((crc << 1) ^ 0x1021) & 0xffff))
      else
        crc=$(((crc << 1) & 0xffff))
      fi
    done
  done
  [[ "$(printf '%04x' "$crc")" == "${decoded_hex:68:4}" ]] || return 1
  wc_hex="${decoded_hex:2:2}"
  account_hex="${decoded_hex:4:64}"
  if ! [[ "$wc_hex" =~ ^[0-9A-Fa-f]{2}$ && "$account_hex" =~ ^[0-9A-Fa-f]{64}$ ]]; then
    return 1
  fi

  wc_dec=$((16#$wc_hex))
  if (( wc_dec >= 128 )); then
    wc_dec=$((wc_dec - 256))
  fi
  printf '%s:%s' "$wc_dec" "$account_hex"
}

ton_address_to_non_bounceable() {
  local address network="${2:-mainnet}" workchain body_hex byte_offset byte_value
  local crc=0 bit escaped="" character

  address="$(ton_address_to_hex "${1:-}")" || return 1
  workchain="${address%%:*}"
  # The friendly format stores a signed, single-byte workchain.
  [[ "$workchain" =~ ^-?(0|[1-9][0-9]{0,2})$ ]] || return 1
  (( workchain >= -128 && workchain <= 127 )) || return 1
  case "$network" in
    mainnet) body_hex="51" ;;
    testnet) body_hex="d1" ;;
    *) return 1 ;;
  esac
  body_hex+="$(printf '%02x' "$((workchain & 255))")${address#*:}"
  for ((byte_offset=0; byte_offset<68; byte_offset+=2)); do
    byte_value=$((16#${body_hex:byte_offset:2}))
    crc=$((crc ^ (byte_value << 8)))
    for ((bit=0; bit<8; bit++)); do
      if (( crc & 0x8000 )); then
        crc=$((((crc << 1) ^ 0x1021) & 0xffff))
      else
        crc=$(((crc << 1) & 0xffff))
      fi
    done
  done
  body_hex+="$(printf '%04x' "$crc")"
  # Keep binary bytes out of shell variables; printf decodes them in the pipe.
  for ((byte_offset=0; byte_offset<72; byte_offset+=2)); do
    character="${body_hex:byte_offset:2}"
    escaped+="\\x${character}"
  done
  printf '%b' "$escaped" | base64 | tr '+/' '-_' | tr -d '\n'
}

ton_wallet_address_file_hex_to_hex() {
  local data_hex="${1,,}" wc_dec candidate="" byte_offset byte_value character
  [[ -n "$data_hex" && "$data_hex" =~ ^([0-9a-f]{2})+$ ]] || return 1
  # Fift save-address stores the account's 32 bytes followed by a signed
  # big-endian workchain. Legacy account-only files imply workchain zero.
  case "${#data_hex}" in
    64) printf '0:%s' "$data_hex"; return 0 ;;
    72)
      wc_dec=$((16#${data_hex:64:8}))
      (( wc_dec < 2147483648 )) || wc_dec=$((wc_dec - 4294967296))
      printf '%s:%s' "$wc_dec" "${data_hex:0:64}"
      return 0
      ;;
  esac
  # Text compatibility: reject non-address bytes before decoding, so binary
  # NULs or control characters never enter a Bash variable or table cell.
  for ((byte_offset=0; byte_offset<${#data_hex}; byte_offset+=2)); do
    byte_value=$((16#${data_hex:byte_offset:2}))
    if ! (( (byte_value >= 48 && byte_value <= 57) ||
            (byte_value >= 65 && byte_value <= 90) ||
            (byte_value >= 97 && byte_value <= 122) ||
            byte_value == 45 || byte_value == 95 || byte_value == 58 ||
            byte_value == 32 || byte_value == 9 || byte_value == 10 || byte_value == 13 )); then
      return 1
    fi
    printf -v character '%b' "\\x${data_hex:byte_offset:2}"
    candidate+="$character"
  done
  ton_address_to_hex "$(trim_whitespace "$candidate")"
}

