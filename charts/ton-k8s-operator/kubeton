generate_random_password() {
  python3 -c 'import secrets; print(secrets.token_urlsafe(24), end="")'
}

dashboard_credentials_from_secret_json() {
  python3 -c '
import base64, json, sys
try:
    data = json.load(sys.stdin)["data"]
    user, password = (base64.b64decode(data[key], validate=True).decode("utf-8")
                      for key in ("admin-user", "admin-password"))
    if not user or not password or ":" in user or any(c in user + password for c in "\r\n\t\0"):
        raise ValueError("invalid credentials")
    print(user + "\t" + password)
except (KeyError, TypeError, ValueError):
    sys.exit("Error: dashboard credentials Secret is incomplete or invalid; refusing to replace it automatically.")
'
}

dashboard_secret_credentials() {
  local ns="$1" secret_name="$2" secret_json
  if ! secret_json="$(kubectl -n "$ns" get secret "$secret_name" -o json)"; then
    echo "Error: cannot read dashboard credentials Secret ${ns}/${secret_name}." >&2
    return 1
  fi
  printf '%s' "$secret_json" | dashboard_credentials_from_secret_json
}

dashboard_secret_revision() {
  # Resource versions trigger rollouts without publishing a digest of a password.
  local secret_json
  secret_json="$(kubectl -n "$1" get secret "$2" -o json)" || return 1
  printf '%s' "$secret_json" | python3 -c '
import json,sys
revision = json.load(sys.stdin).get("metadata", {}).get("resourceVersion", "")
if not revision:
    sys.exit("Error: cannot resolve dashboard credentials Secret resource version.")
print(revision)
'
}

prometheus_password_hash() {
  python3 -c '
import ctypes, ctypes.util, secrets, sys
password = sys.stdin.buffer.read()
if not password or len(password) > 72:
    sys.exit("Error: Prometheus passwords must contain between 1 and 72 UTF-8 bytes.")
try:
    import bcrypt
except ImportError:
    # libcrypt remains available on ordinary Linux hosts even after Python 3.13
    # removed its crypt module. Keep the password off command-line arguments.
    try:
        library = ctypes.CDLL(ctypes.util.find_library("crypt") or None)
        library.crypt.argtypes = (ctypes.c_char_p, ctypes.c_char_p)
        library.crypt.restype = ctypes.c_char_p
        alphabet = "./ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789"
        salt = ("$2b$10$" + "".join(secrets.choice(alphabet) for _ in range(21)) + ".").encode()
        result = library.crypt(password, salt)
        if not result or not result.startswith(b"$2") or len(result) != 60:
            raise ValueError("bcrypt unsupported")
        print(result.decode())
    except (AttributeError, OSError, ValueError):
        sys.exit("Error: bcrypt hashing is unavailable; install python3-bcrypt before starting Prometheus.")
else:
    print(bcrypt.hashpw(password, bcrypt.gensalt(rounds=10)).decode())
'
}

ensure_prometheus_admin_secret() {
  ensure_dashboard_admin_secret "$1" "$2" "${PROMETHEUS_ADMIN_USER:-admin}" "${PROMETHEUS_ADMIN_PASSWORD:-}" prometheus
