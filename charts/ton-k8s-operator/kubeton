ensure_grafana_stack() {
  local ns="$1"
  local datasources_yaml="$2"
  local dashboards_yaml="$3"
  local dashboard_json="$4"
  local deploy_name="kubeton-grafana"
  local service_name="${deploy_name}"
  local datasources_configmap_name="${deploy_name}-datasources"
  local dashboards_provider_configmap_name="${deploy_name}-dashboards-provider"
  local dashboards_configmap_name="${deploy_name}-dashboards"
  local admin_secret_name="${GRAFANA_ADMIN_SECRET_NAME}"
  local admin_row admin_user admin_password
  local datasources_hash dashboards_hash

  ensure_namespace "$ns"
  admin_row="$(ensure_grafana_admin_secret "$ns" "$admin_secret_name")" || return 1
  IFS=$'\t' read -r admin_user admin_password <<<"$admin_row"
  admin_user="$(trim_whitespace "$admin_user")"
  admin_password="$(trim_whitespace "$admin_password")"
  datasources_hash="$(printf '%s' "$datasources_yaml" | cksum | awk '{print $1}')"
  dashboards_hash="$(printf '%s' "$dashboards_yaml"$'\n'"$dashboard_json" | cksum | awk '{print $1}')"

  cat <<EOF | kubectl -n "$ns" apply -f - >/dev/null
apiVersion: v1
kind: ConfigMap
metadata:
  name: ${datasources_configmap_name}
  labels:
    app.kubernetes.io/name: kubeton-grafana
    app.kubernetes.io/managed-by: kubeton
data:
  datasources.yaml: |
$(printf '%s\n' "$datasources_yaml" | sed 's/^/    /')
---
apiVersion: v1
kind: ConfigMap
metadata:
  name: ${dashboards_provider_configmap_name}
  labels:
    app.kubernetes.io/name: kubeton-grafana
    app.kubernetes.io/managed-by: kubeton
data:
  dashboards.yaml: |
$(printf '%s\n' "$dashboards_yaml" | sed 's/^/    /')
---
apiVersion: v1
kind: ConfigMap
metadata:
  name: ${dashboards_configmap_name}
  labels:
    app.kubernetes.io/name: kubeton-grafana
    app.kubernetes.io/managed-by: kubeton
data:
  ton-overview.json: |
$(printf '%s\n' "$dashboard_json" | sed 's/^/    /')
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: ${deploy_name}
  labels:
    app.kubernetes.io/name: kubeton-grafana
    app.kubernetes.io/managed-by: kubeton
spec:
  replicas: 1
  selector:
    matchLabels:
      app.kubernetes.io/name: kubeton-grafana
  template:
    metadata:
      labels:
        app.kubernetes.io/name: kubeton-grafana
      annotations:
        ton.ton.org/provisioned-by: kubeton
        ton.ton.org/datasources-checksum: $(yaml_quote "$datasources_hash")
        ton.ton.org/dashboards-checksum: $(yaml_quote "$dashboards_hash")
    spec:
      containers:
        - name: grafana
          image: ${GRAFANA_IMAGE}
          imagePullPolicy: IfNotPresent
          env:
            - name: GF_SECURITY_ADMIN_USER
              valueFrom:
                secretKeyRef:
                  name: ${admin_secret_name}
                  key: admin-user
            - name: GF_SECURITY_ADMIN_PASSWORD
              valueFrom:
                secretKeyRef:
                  name: ${admin_secret_name}
                  key: admin-password
            - name: GF_USERS_ALLOW_SIGN_UP
              value: "false"
          ports:
            - name: http
              containerPort: ${GRAFANA_PORT}
              protocol: TCP
          readinessProbe:
            httpGet:
              path: /api/health
              port: http
            initialDelaySeconds: 10
            periodSeconds: 10
          livenessProbe:
            httpGet:
              path: /api/health
              port: http
            initialDelaySeconds: 30
            periodSeconds: 15
          volumeMounts:
            - name: datasources
              mountPath: /etc/grafana/provisioning/datasources
              readOnly: true
            - name: dashboards-provider
              mountPath: /etc/grafana/provisioning/dashboards
              readOnly: true
            - name: dashboards
              mountPath: /var/lib/grafana/dashboards/kubeton
              readOnly: true
          resources:
            requests:
              cpu: 100m
              memory: 256Mi
            limits:
              cpu: 500m
              memory: 1Gi
      volumes:
        - name: datasources
          configMap:
            name: ${datasources_configmap_name}
        - name: dashboards-provider
          configMap:
            name: ${dashboards_provider_configmap_name}
        - name: dashboards
          configMap:
            name: ${dashboards_configmap_name}
---
apiVersion: v1
kind: Service
metadata:
  name: ${service_name}
  labels:
    app.kubernetes.io/name: kubeton-grafana
    app.kubernetes.io/managed-by: kubeton
spec:
  type: ClusterIP
  selector:
    app.kubernetes.io/name: kubeton-grafana
  ports:
    - name: http
      protocol: TCP
      port: ${GRAFANA_PORT}
      targetPort: http
EOF

  if ! kubectl -n "$ns" rollout status "deployment/${deploy_name}" --timeout=180s >/dev/null 2>&1; then
    echo "Warning: Grafana deployment ${ns}/${deploy_name} is not Ready yet." >&2
  fi

  printf '%s\t%s\t%s\t%s\t%s\n' "$ns" "$service_name" "$deploy_name" "$admin_user" "$admin_password"
}

