# A successful uninstall hook can remove a Longhorn CRD between discovery and
# LIST/DELETE. Only an independently verified missing CRD makes that API error
# an already-completed cleanup; permission and connectivity failures do not.
longhorn_resource_api_is_absent() {
  local resource="$1" marker
  [[ "$resource" == *.longhorn.io ]] || return 1
  if ! marker="$(kubectl get crd "$resource" --ignore-not-found -o name 2>/dev/null)"; then
    return 1
  fi
  [[ -z "$(trim_whitespace "$marker")" ]]
}

cleanup_longhorn_force() {
  local marker resources resource rows object rc=0
  local -a cluster_rows=()
  echo "[uninstall] Cleaning remaining Longhorn release resources ..."
  longhorn_storage_is_unused || return 1
  storage_namespace_is_release_owned "$LONGHORN_NAMESPACE" "$LONGHORN_RELEASE_NAME" longhorn || return 1
  if declare -F refuse_guarded_namespace_deletion_if_needed >/dev/null \
      && refuse_guarded_namespace_deletion_if_needed "$LONGHORN_NAMESPACE"; then
    return 1
  fi

  collect_storage_release_cluster_rows longhorn "$LONGHORN_RELEASE_NAME" "$LONGHORN_NAMESPACE" cluster_rows || return 1
  for object in "${cluster_rows[@]}"; do
    case "$object" in
      validatingwebhookconfiguration/*|mutatingwebhookconfiguration/*|ValidatingWebhookConfiguration/*|MutatingWebhookConfiguration/*)
        kubectl delete "$object" --ignore-not-found --wait=false >/dev/null 2>&1 || rc=1 ;;
    esac
  done
  (( rc == 0 )) || return "$rc"

  if ! marker="$(kubectl get namespace "$LONGHORN_NAMESPACE" --ignore-not-found -o name 2>/dev/null)"; then return 1; fi
  if [[ -n "$(trim_whitespace "$marker")" ]]; then
    kubectl -n "$LONGHORN_NAMESPACE" delete job longhorn-uninstall longhorn-install --ignore-not-found --wait=false >/dev/null 2>&1 || rc=1
    kubectl -n "$LONGHORN_NAMESPACE" delete all --all --ignore-not-found --wait=false >/dev/null 2>&1 || rc=1
  fi
  if ! resources="$(kubectl api-resources --api-group=longhorn.io --namespaced=true -o name 2>/dev/null)"; then return 1; fi
  for resource in $resources; do
    if ! rows="$(kubectl -n "$LONGHORN_NAMESPACE" get "$resource" -o name 2>/dev/null)"; then
      longhorn_resource_api_is_absent "$resource" || rc=1
      continue
    fi
    while IFS= read -r object; do
      [[ -n "$object" ]] || continue
      if ! kubectl -n "$LONGHORN_NAMESPACE" patch "$object" --type=merge -p '{"metadata":{"finalizers":[]}}' >/dev/null 2>&1; then
        if longhorn_resource_api_is_absent "$resource"; then
          continue
        fi
        # Controllers or an overlapping uninstall hook can finish deleting
        # this exact object after LIST. A denied/failed GET stays a failure.
        if ! marker="$(kubectl -n "$LONGHORN_NAMESPACE" get "$object" --ignore-not-found -o name 2>/dev/null)" \
          || [[ -n "$(trim_whitespace "$marker")" ]]; then
          rc=1
        fi
      fi
    done <<<"$rows"
    if ! kubectl -n "$LONGHORN_NAMESPACE" delete "$resource" --all --ignore-not-found --wait=false >/dev/null 2>&1; then
      longhorn_resource_api_is_absent "$resource" || rc=1
    fi
  done
  (( rc == 0 )) || return "$rc"
  if ! rows="$(kubectl get crd -o name 2>/dev/null)"; then return 1; fi
  while IFS= read -r object; do
    [[ "$object" == *.longhorn.io ]] || continue
    kubectl delete "$object" --ignore-not-found --wait=false >/dev/null 2>&1 || rc=1
  done <<<"$rows"
  for object in "${cluster_rows[@]}"; do
    kubectl delete "$object" --ignore-not-found --wait=false >/dev/null 2>&1 || rc=1
  done
  return "$rc"
}

uninstall_longhorn() {
  local rc=0
  if storage_release_present "$LONGHORN_RELEASE_NAME" "$LONGHORN_NAMESPACE"; then
    :
  else
    rc=$?
    (( rc == 1 )) && return 0
    return "$rc"
  fi
  longhorn_storage_is_unused || return 1
  echo "[uninstall] Running Helm uninstall for Longhorn release ${LONGHORN_RELEASE_NAME} ..."
  kubectl -n "$LONGHORN_NAMESPACE" patch settings.longhorn.io deleting-confirmation-flag --type=merge -p '{"value":"true"}' >/dev/null 2>&1 || true
  if run_with_timeout "$HELM_UNINSTALL_CMD_TIMEOUT" helm uninstall "$LONGHORN_RELEASE_NAME" -n "$LONGHORN_NAMESPACE"; then
    return 0
  else
    rc=$?
  fi
  if [[ "$rc" -eq 124 ]]; then
    echo "Warning: Longhorn Helm uninstall timed out after ${HELM_UNINSTALL_CMD_TIMEOUT}; retrying with --no-hooks." >&2
  else
    echo "Warning: Longhorn Helm uninstall failed (exit ${rc}); retrying with --no-hooks." >&2
  fi
  if run_with_timeout "$HELM_UNINSTALL_CMD_TIMEOUT" helm uninstall "$LONGHORN_RELEASE_NAME" -n "$LONGHORN_NAMESPACE" --no-hooks >/dev/null 2>&1; then
    return 0
  else
    rc=$?
  fi
  if [[ "$rc" -eq 124 ]]; then
    echo "Warning: Longhorn Helm uninstall --no-hooks timed out after ${HELM_UNINSTALL_CMD_TIMEOUT}; running forced cleanup fallback." >&2
  else
    echo "Warning: Longhorn Helm uninstall --no-hooks failed (exit ${rc}); running forced cleanup fallback." >&2
  fi
  cleanup_longhorn_force
}

