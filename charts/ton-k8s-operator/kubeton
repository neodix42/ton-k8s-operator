trim_wrapped_quotes() {
  local value
  value="$(trim_whitespace "${1:-}")"
  value="${value#\"}"
  value="${value%\"}"
  value="${value#\'}"
  value="${value%\'}"
  printf '%s' "$value"
}

resolve_operator_image_from_values_file() {
  local values_file="$1"
  local repo=""
  local tag=""
  local in_image=0
  local line value

  [[ -f "$values_file" ]] || return 1

  while IFS= read -r line; do
    if [[ "$line" =~ ^image:[[:space:]]*$ ]]; then
      in_image=1
      continue
    fi
    if (( in_image != 0 )) && [[ "$line" =~ ^[^[:space:]] ]]; then
      break
    fi
    if (( in_image == 0 )); then
      continue
    fi

    if [[ "$line" =~ ^[[:space:]]*repository:[[:space:]]*(.+)$ ]]; then
      value="${BASH_REMATCH[1]}"
      value="${value%%#*}"
      repo="$(trim_wrapped_quotes "$value")"
      continue
    fi
    if [[ "$line" =~ ^[[:space:]]*tag:[[:space:]]*(.+)$ ]]; then
      value="${BASH_REMATCH[1]}"
      value="${value%%#*}"
      tag="$(trim_wrapped_quotes "$value")"
      continue
    fi
  done < "$values_file"

  repo="$(trim_whitespace "$repo")"
  tag="$(trim_whitespace "$tag")"
  [[ -z "$repo" ]] && return 1
  if [[ -n "$tag" ]]; then
    printf '%s:%s' "$repo" "$tag"
  else
    printf '%s' "$repo"
  fi
}

