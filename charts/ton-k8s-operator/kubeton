        namespace: ${ns}
      paths:
        - "/vmui.*"
        - "/prometheus/.*"
        - "/api/v1/.*"
    - crd:
        kind: VMAgent
        name: ${stack_name}
        namespace: ${ns}
      paths:
        - "/targets"
        - "/targets/.*"
${logs_auth_target_block}
