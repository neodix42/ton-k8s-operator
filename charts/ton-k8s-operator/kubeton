delete_labeled_resources_all_namespaces() {
  local selector="$1"
  local label="${2:-uninstall}"
  local resource effective_selector namespaced_resources cluster_resources rc=0

  selector="$(trim_whitespace "$selector")"
  [[ -n "$selector" ]] || return 0
  namespaced_resources="$(kubectl api-resources --verbs=list,delete --namespaced=true -o name)" || return 1
  cluster_resources="$(kubectl api-resources --verbs=list,delete --namespaced=false -o name)" || return 1

  while IFS= read -r resource; do
    resource="$(trim_whitespace "$resource")"
    [[ -z "$resource" ]] && continue
    # PVC deletion must first record backing volumes in the durable ledger.
    # Each component's storage cleanup handles its claims before this sweep.
    [[ "$resource" != persistentvolumeclaims* ]] || continue
    effective_selector="$selector"
    if [[ "${KUBETON_RETAIN_VICTORIA_METRICS_STATE:-0}" == 1 && "$resource" == configmaps* ]]; then
      effective_selector="${effective_selector},app.kubernetes.io/name!=kubeton-victoria-metrics"
    fi
    if (( KUBETON_RETAIN_VICTORIA_LOGS_GUARDS == 1 )); then
      case "$resource" in
        configmaps|configmaps.*|networkpolicies|networkpolicies.*)
          effective_selector="${effective_selector},app.kubernetes.io/part-of!=kubeton-victoria-logs"
          ;;
      esac
    fi
    kubectl delete "$resource" -A -l "$effective_selector" --ignore-not-found --wait=false >/dev/null 2>&1 || rc=1
  done <<<"$namespaced_resources"

  while IFS= read -r resource; do
    resource="$(trim_whitespace "$resource")"
    [[ -z "$resource" ]] && continue
    case "$resource" in
      namespaces|nodes|persistentvolumes|storageclasses.storage.k8s.io|customresourcedefinitions.apiextensions.k8s.io)
        continue
        ;;
    esac
    kubectl delete "$resource" -l "$selector" --ignore-not-found --wait=false >/dev/null 2>&1 || rc=1
  done <<<"$cluster_resources"

  echo "[${label}] Requested deletion for resources matching ${selector}."
  return "$rc"
}

cleanup_kubeton_managed_labeled_resources() {
  echo "[uninstall] Deleting remaining kubeton-managed labeled resources ..."
  delete_labeled_resources_all_namespaces 'app.kubernetes.io/managed-by=kubeton' "uninstall"
}

cleanup_victoria_metrics_operator_policy() {
  local ns="$1" name="$2" component="$3" proof
  proof="$(kubectl -n "$ns" get networkpolicy "$name" --ignore-not-found \
    -o 'jsonpath={.metadata.labels.app\.kubernetes\.io/name}{"|"}{.metadata.labels.app\.kubernetes\.io/managed-by}{"|"}{.spec.podSelector.matchLabels.app\.kubernetes\.io/name}{"|"}{.spec.podSelector.matchLabels.control-plane}')" || return 1
  [[ -n "$proof" ]] || return 0
  if [[ "$proof" != "${component}|kustomize|${component}|controller-manager" ]]; then
    echo "[uninstall] Retaining NetworkPolicy ${ns}/${name}: it does not match the recorded upstream operator policy."
    return 0
  fi
  kubectl -n "$ns" delete networkpolicy "$name" --ignore-not-found --wait=true --timeout=60s >/dev/null
}

cleanup_victoria_metrics_operator() {
  local ns="$1"
  local operator_selector='app.kubernetes.io/name=victoria-metrics-operator'
  local resources resource remaining crds binding_ns other_operator_ns operator_rows rc=0 shared_operator=0

  resources="$(kubectl api-resources --api-group=operator.victoriametrics.com --verbs=list --namespaced=true -o name)" || return 1
  for resource in $resources; do
    remaining="$(kubectl get "$resource" -A --ignore-not-found -o name)" || return 1
    if [[ -n "$(trim_whitespace "$remaining")" ]]; then
      echo "[uninstall] Retaining shared VictoriaMetrics operator and CRDs: ${resource} resources remain."
      return 0
    fi
  done
  operator_rows="$(kubectl get deployments -A -l "$operator_selector" \
    -o jsonpath='{range .items[*]}{.metadata.namespace}{"\n"}{end}')" || return 1
  while IFS= read -r other_operator_ns; do
    [[ -z "$other_operator_ns" || "$other_operator_ns" == "$ns" ]] || shared_operator=1
  done <<<"$operator_rows"

  echo "[uninstall] Deleting VictoriaMetrics operator workloads ..."
  cleanup_owned_namespaced_kinds "$operator_selector" 'deployments replicasets pods services serviceaccounts roles rolebindings configmaps secrets' "$ns" || rc=1
  # The pinned upstream manifest gives its ServiceAccount a different label,
  # and leaves these RBAC objects unlabelled. The installation ledger provides
  # their scope; do not rely on a label-only sweep to find them.
  cleanup_owned_namespaced_kinds 'app.kubernetes.io/name=vm-operator' 'serviceaccounts' "$ns" || rc=1
  kubectl -n "$ns" delete role vm-leader-election-role --ignore-not-found --wait=true --timeout=60s >/dev/null || rc=1
  kubectl -n "$ns" delete rolebinding vm-leader-election-rolebinding --ignore-not-found --wait=true --timeout=60s >/dev/null || rc=1
  cleanup_victoria_metrics_operator_policy "$ns" vm-allow-metrics-traffic test || rc=1
  cleanup_victoria_metrics_operator_policy "$ns" vm-allow-webhook-traffic vm-operator || rc=1
  (( rc == 0 )) || return "$rc"
  if (( shared_operator == 1 )); then
    echo "[uninstall] Retaining shared VictoriaMetrics cluster RBAC and CRDs: another operator installation remains."
    return 0
  fi
  binding_ns="$(kubectl get clusterrolebinding vm-operator --ignore-not-found \
    -o jsonpath='{range .subjects[*]}{.namespace}{"\n"}{end}')" || return 1
  while IFS= read -r other_operator_ns; do
    if [[ -n "$other_operator_ns" && "$other_operator_ns" != "$ns" ]]; then
      echo "[uninstall] Retaining VictoriaMetrics cluster RBAC and CRDs referenced from ${other_operator_ns}."
      return 0
    fi
  done <<<"$binding_ns"
  kubectl delete clusterrolebinding vm-operator --ignore-not-found --wait=true --timeout=60s >/dev/null || rc=1
  kubectl delete clusterrole vm-operator --ignore-not-found --wait=true --timeout=60s >/dev/null || rc=1
  for resource in clusterrole clusterrolebinding validatingwebhookconfiguration mutatingwebhookconfiguration; do
    kubectl delete "$resource" -l "$operator_selector" --ignore-not-found --wait=true --timeout=60s >/dev/null 2>&1 || rc=1
  done
  (( rc == 0 )) || return "$rc"
  crds="$(kubectl get crd -o name)" || return 1
  while IFS= read -r resource; do
    [[ "$resource" == *'.operator.victoriametrics.com' ]] || continue
    kubectl delete "$resource" --ignore-not-found --wait=true --timeout=60s >/dev/null || rc=1
  done <<<"$crds"
  return "$rc"
}

wait_victoria_logs_backend_gone() {
  local ns="$1"
  local release_name="$2"
  local timeout_seconds="$3"
  local deadline namespace_row remaining
  local selector="app.kubernetes.io/name=victoria-logs-single,app.kubernetes.io/instance=${release_name}"

  timeout_seconds="$(trim_whitespace "$timeout_seconds")"
  [[ "$timeout_seconds" =~ ^[1-9][0-9]*$ ]] || timeout_seconds=300
  deadline=$(( $(date +%s) + timeout_seconds ))
  while :; do
    if ! namespace_row="$(kubectl get namespace "$ns" --ignore-not-found -o name 2>/dev/null)"; then
      echo "Error: cannot verify namespace ${ns} while waiting for VictoriaLogs backend deletion." >&2
      return 1
    fi
    namespace_row="$(trim_whitespace "$namespace_row")"
    [[ -z "$namespace_row" ]] && return 0
    if ! remaining="$(kubectl -n "$ns" get statefulset,pod -l "$selector" \
      --ignore-not-found -o name 2>/dev/null)"; then
      echo "Error: cannot verify VictoriaLogs backend resources for ${ns}/${release_name}." >&2
      return 1
    fi
    remaining="$(trim_whitespace "$remaining")"
    [[ -z "$remaining" ]] && return 0
    if (( $(date +%s) >= deadline )); then
      echo "Error: VictoriaLogs backend ${ns}/${release_name} is still present after ${timeout_seconds}s; retaining its ingress NetworkPolicy and cleanup ledger." >&2
      return 1
    fi
    sleep 2
  done
}

