victoria_logs_eligible_nodes_csv() {
  local node output=""
  local -a nodes=()

  for node in "${KUBETON_VICTORIA_LOGS_ELIGIBLE_NODES[@]}"; do
    node="$(trim_whitespace "$node")"
    [[ -n "$node" ]] || continue
    nodes+=("$node")
  done
  (( ${#nodes[@]} > 0 )) || return 0

  # Treat placement as a set. Free-space ordering can legitimately change
  # between consecutive preflight checks even when the approved hostnames do
  # not; a stable sort avoids an unnecessary reconciliation or false failure.
  while IFS= read -r node; do
    [[ -n "$node" ]] || continue
    output="${output}${output:+,}${node}"
  done < <(printf '%s\n' "${nodes[@]}" | LC_ALL=C sort -u)
  printf '%s' "$output"
}

victoria_logs_resolve_allowed_nodes() {
  local node_selector="$1"
  local require_longhorn_csi="$2"
  local output_array_name="$3"
  local -n output_nodes_ref="$output_array_name"
  local selector_rows="" csi_rows="" plugin_rows="" node
  local -A selector_nodes=()
  local -A csi_nodes=()
  local -A plugin_nodes=()
  local -a resolved_nodes=()

  output_nodes_ref=()
  node_selector="$(trim_whitespace "$node_selector")"
  if (( ${#KUBETON_VICTORIA_LOGS_ELIGIBLE_NODES[@]} == 0 )); then
    echo "Error: VictoriaLogs has no fresh node-preflight PASS set; refusing an unconstrained deployment." >&2
    echo "Error: rerun without KUBETON_SKIP_NODE_PREREQ_CHECK, or explicitly disable VictoriaLogs launch capture." >&2
    return 1
  fi

  if [[ -n "$node_selector" ]]; then
    if ! selector_rows="$(node_check_list_selector_nodes "$node_selector")"; then
      echo "Error: cannot resolve VictoriaLogs node selector '${node_selector}'." >&2
      return 1
    fi
    while IFS= read -r node; do
      node="$(trim_whitespace "$node")"
      [[ -n "$node" ]] && selector_nodes["$node"]=1
    done <<<"$selector_rows"
  fi

  if is_true "$require_longhorn_csi"; then
    if ! csi_rows="$(list_longhorn_csi_node_names_checked)"; then
      echo "Error: cannot read CSINode registrations while constraining the VictoriaLogs backend." >&2
      return 1
    fi
    if ! plugin_rows="$(list_ready_longhorn_csi_plugin_node_names_checked)"; then
      echo "Error: cannot read Ready Longhorn CSI node-plugin Pods while constraining the VictoriaLogs backend." >&2
      return 1
    fi
    while IFS= read -r node; do
      node="$(trim_whitespace "$node")"
      [[ -n "$node" ]] && csi_nodes["$node"]=1
    done <<<"$csi_rows"
    while IFS= read -r node; do
      node="$(trim_whitespace "$node")"
      [[ -n "$node" ]] && plugin_nodes["$node"]=1
    done <<<"$plugin_rows"
  fi

  for node in "${KUBETON_VICTORIA_LOGS_ELIGIBLE_NODES[@]}"; do
    node="$(trim_whitespace "$node")"
    [[ -n "$node" ]] || continue
    if [[ -n "$node_selector" && -z "${selector_nodes[$node]:-}" ]]; then
      continue
    fi
    if is_true "$require_longhorn_csi" \
      && { [[ -z "${csi_nodes[$node]:-}" ]] || [[ -z "${plugin_nodes[$node]:-}" ]]; }; then
      continue
    fi
    resolved_nodes+=("$node")
  done
  mapfile -t output_nodes_ref < <(printf '%s\n' "${resolved_nodes[@]}" | awk 'NF' | sort -u)
  if (( ${#output_nodes_ref[@]} == 0 )); then
    if is_true "$require_longhorn_csi"; then
      echo "Error: VictoriaLogs placement has no nodes after intersecting the fresh PASS set${node_selector:+ with '${node_selector}'} and Longhorn CSI readiness." >&2
    else
      echo "Error: VictoriaLogs placement has no nodes after intersecting the fresh PASS set${node_selector:+ with '${node_selector}'}." >&2
    fi
    return 1
  fi
}

victoria_logs_validate_ton_nodes_covered() {
  local allowed_nodes_array_name="$1"
  local -n allowed_nodes_ref="$allowed_nodes_array_name"
  local ton_selector selected_rows node
  local -A allowed_by_node=()
  local selected_count=0

  ton_selector="$(trim_whitespace "${KUBETON_NODE_CHECK_TON_SELECTOR:-}")"
  for node in "${allowed_nodes_ref[@]}"; do
    allowed_by_node["$node"]=1
  done
  if [[ -z "$ton_selector" ]]; then
    # With unconstrained TON placement, an additional collector selector may
    # not silently drop any host from the fresh PASS set. The collector still
    # remains fenced away from every failed node by its hostname affinity.
    if (( ${#allowed_nodes_ref[@]} != ${#KUBETON_VICTORIA_LOGS_ELIGIBLE_NODES[@]} )); then
      echo "Error: TON placement is unconstrained, but VICTORIA_LOGS_COLLECTOR_NODE_SELECTOR excludes part of the fresh preflight-approved set." >&2
      return 1
    fi
    for node in "${KUBETON_VICTORIA_LOGS_ELIGIBLE_NODES[@]}"; do
      if [[ -z "${allowed_by_node[$node]:-}" ]]; then
        echo "Error: TON placement is unconstrained, but VictoriaLogs collector placement excludes approved node ${node}." >&2
        return 1
      fi
    done
    return 0
  fi
  if ! selected_rows="$(node_check_list_selector_nodes "$ton_selector")"; then
    echo "Error: cannot resolve TON node selector '${ton_selector}' while constraining VictoriaLogs." >&2
    return 1
  fi
  while IFS= read -r node; do
    node="$(trim_whitespace "$node")"
    node="${node#node/}"
    [[ -n "$node" ]] || continue
    selected_count=$((selected_count + 1))
    if [[ -z "${allowed_by_node[$node]:-}" ]]; then
      echo "Error: VICTORIA_LOGS_COLLECTOR_NODE_SELECTOR excludes selected TON node ${node}; refusing to install a collector with incomplete coverage." >&2
      return 1
    fi
  done <<<"$selected_rows"
  if (( selected_count == 0 )); then
    echo "Error: TON selector '${ton_selector}' matches no nodes while constraining VictoriaLogs." >&2
    return 1
  fi
}

