    echo "Warning: Vault Helm uninstall timed out after ${HELM_UNINSTALL_CMD_TIMEOUT}; retrying with --no-hooks." >&2
  else
    echo "Warning: Vault Helm uninstall failed (exit ${rc}); retrying with --no-hooks." >&2
  fi
  if run_with_timeout "$HELM_UNINSTALL_CMD_TIMEOUT" helm uninstall "$VAULT_RELEASE_NAME" -n "$VAULT_NAMESPACE" --no-hooks >/dev/null 2>&1; then
    return 0
  fi
  rc=$?
  if [[ "$rc" -eq 124 ]]; then
    echo "Warning: Vault Helm uninstall --no-hooks timed out after ${HELM_UNINSTALL_CMD_TIMEOUT}; running forced cleanup fallback." >&2
  else
    echo "Warning: Vault Helm uninstall --no-hooks failed (exit ${rc}); running forced cleanup fallback." >&2
  fi
  cleanup_vault_force
}

