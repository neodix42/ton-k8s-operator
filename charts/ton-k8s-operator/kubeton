run_grafana_start() {
  require_bin kubectl
  require_bin nohup
  if [[ $# -ne 0 ]]; then
    echo "Error: usage: kubeton grafana start" >&2
    exit 1
  fi

  local -a prometheus_rows=()
  local datasources_yaml=""
  local dashboards_yaml=""
  local dashboard_json=""
  local default_datasource_name=""
  local grafana_row ns service_name deploy_name admin_user admin_password
  local -a forwarded_rows=()
  local forward_row log_file
  local base_port local_port remote_port bind_address remote_access_host
  local attempt quiet_attempt

  configure_prometheus_for_exporter_targets prometheus_rows || true
  if [[ ${#prometheus_rows[@]} -eq 0 ]]; then
    echo "Error: no kubeton-managed Prometheus service found/configured. Run 'kubeton prometheus start' first." >&2
    return 1
  fi

  datasources_yaml="$(build_grafana_datasources_yaml "${prometheus_rows[@]}")"
  if [[ -z "$datasources_yaml" || "$datasources_yaml" != *"datasources:"* ]]; then
    echo "Error: failed to build Grafana datasources provisioning config." >&2
    return 1
  fi
  dashboards_yaml="$(build_grafana_dashboards_provisioning_yaml)"
  default_datasource_name="$(first_grafana_datasource_name_from_prometheus_rows "${prometheus_rows[@]}" || true)"
  default_datasource_name="$(trim_whitespace "$default_datasource_name")"
  if [[ -z "$default_datasource_name" ]]; then
    echo "Error: failed to resolve default Grafana datasource name." >&2
    return 1
  fi
  dashboard_json="$(build_grafana_ton_overview_dashboard_json "$default_datasource_name")"
  if [[ -z "$dashboard_json" || "$dashboard_json" != *"\"panels\""* ]]; then
    echo "Error: failed to build Grafana dashboard JSON." >&2
    return 1
  fi

  if ! grafana_row="$(ensure_grafana_stack "$GRAFANA_NAMESPACE" "$datasources_yaml" "$dashboards_yaml" "$dashboard_json")"; then
    echo "Error: failed to create/update Grafana stack." >&2
    return 1
  fi
  IFS=$'\t' read -r ns service_name deploy_name admin_user admin_password <<<"$grafana_row"

  remote_port="$GRAFANA_PORT"
  if ! [[ "$remote_port" =~ ^[0-9]+$ ]]; then
    remote_port=3000
  fi
  base_port="$GRAFANA_LOCAL_PORT_BASE"
  if ! [[ "$base_port" =~ ^[0-9]+$ ]]; then
    base_port=3000
  fi
  bind_address="$(grafana_port_forward_address)"
  bind_address="$(trim_whitespace "$bind_address")"
  if [[ -z "$bind_address" ]]; then
    bind_address="127.0.0.1"
  fi

  echo "[grafana] Starting background local port-forward(s) ..."
  echo "[grafana] Port-forward bind address: ${bind_address}"
  local_port="$base_port"
  for ((attempt=0; attempt<25; attempt++)); do
    quiet_attempt="true"
    if (( attempt == 24 )); then
      quiet_attempt="false"
    fi
    if forward_row="$(ensure_grafana_port_forward "$ns" "$service_name" "$((local_port + attempt))" "$remote_port" "$bind_address" "$quiet_attempt")"; then
      forwarded_rows+=("$forward_row")
      break
    fi
  done

  if [[ ${#forwarded_rows[@]} -eq 0 ]]; then
    echo "Error: failed to start background port-forward for Grafana service." >&2
    return 1
  fi

  IFS=$'\t' read -r ns service_name local_port _pid log_file <<<"${forwarded_rows[0]}"
  if address_list_allows_loopback "$bind_address"; then
    echo "[grafana] Background access: http://127.0.0.1:${local_port}/ (service ${ns}/${service_name})"
  fi
  if address_list_exposes_non_loopback "$bind_address"; then
    remote_access_host="$(first_non_loopback_bind_address "$bind_address" || true)"
    remote_access_host="$(trim_whitespace "$remote_access_host")"
    if [[ -z "$remote_access_host" ]]; then
      remote_access_host="$(resolve_primary_host_address || true)"
      remote_access_host="$(trim_whitespace "$remote_access_host")"
    fi
    if [[ -n "$remote_access_host" ]]; then
      echo "[grafana] Remote access: http://${remote_access_host}:${local_port}/"
    fi
  fi
  echo "[grafana] Admin user: ${admin_user}"
  echo "[grafana] Admin password: ${admin_password}"
  echo "[grafana] Datasource: kubeton-managed Prometheus service(s) provisioned."
  echo "[grafana] Dashboard: starter TON overview provisioned (folder: Kubeton)."
  echo "[grafana] Port-forward log: ${log_file}"
  return 0
}

run_grafana_stop() {
  require_bin kubectl
  if [[ $# -ne 0 ]]; then
    echo "Error: usage: kubeton grafana stop" >&2
    exit 1
  fi

  cleanup_grafana_resources
  echo "[grafana] kubeton-managed Grafana resources and local port-forward(s) removed."
}

run_grafana() {
  local subcommand="${1:-start}"
  case "$subcommand" in
    start)
      if [[ $# -gt 0 ]]; then
        shift
      fi
      run_grafana_start "$@"
      ;;
    stop)
      if [[ $# -gt 0 ]]; then
        shift
      fi
      run_grafana_stop "$@"
      ;;
    *)
      echo "Error: unknown grafana subcommand '$subcommand'." >&2
      echo "Usage: kubeton grafana [start|stop]" >&2
      exit 1
      ;;
  esac
}

run_victoria_metrics_install() {
  require_bin kubectl
  require_bin nohup
  if [[ $# -ne 0 ]]; then
    echo "Error: usage: kubeton victoria-metrics install" >&2
    exit 1
  fi

  local ns operator_ns stack_name auth_username auth_password
  local timeout_seconds operator_row operator_version operator_manifest_url
  local -a scrape_rows=()
  local auth_service_name auth_deploy_name
  local credentials_row credentials_secret username password
  local base_port local_port remote_port bind_address remote_access_host api_proxy_base_port
  local api_proxy_row api_proxy_port api_proxy_log
  local vmsingle_service vmagent_service
  local forward_row log_file pf_ns pf_service
  local -a forwarded_rows=()
  local metrics_port_forward_ok=0
  local logs_enabled_raw logs_enabled="false"
  local logs_ns logs_release_name logs_collector_release_name
  local logs_retention_period logs_pvc_size logs_remote_port
  local logs_stack_row logs_helm_timeout_seconds logs_auth_static_url=""
  local logs_access_service logs_backend_service logs_collector_daemonset logs_remote_write_url
  local logs_ds_ready logs_ds_desired

  ns="$(trim_whitespace "${VICTORIA_METRICS_NAMESPACE:-vm}")"
  if [[ -z "$ns" ]]; then
    ns="vm"
  fi
  operator_ns="$(trim_whitespace "${VICTORIA_METRICS_OPERATOR_NAMESPACE:-vm}")"
  if [[ -z "$operator_ns" ]]; then
    operator_ns="vm"
  fi
  stack_name="$(victoria_metrics_stack_name)"
  auth_username="$(trim_whitespace "${VICTORIA_METRICS_AUTH_USERNAME:-}")"
  if [[ -z "$auth_username" ]]; then
    auth_username="$stack_name"
  fi
  auth_password="$(trim_whitespace "${VICTORIA_METRICS_AUTH_PASSWORD:-}")"
  timeout_seconds="$(resolve_victoria_metrics_rollout_timeout_seconds)"
  logs_enabled_raw="$(trim_whitespace "${VICTORIA_LOGS_ENABLED:-true}")"
  if is_true "$logs_enabled_raw"; then
    logs_enabled="true"
    require_bin helm
  fi
  logs_ns="$(victoria_logs_namespace)"
  logs_release_name="$(victoria_logs_release_name)"
  logs_collector_release_name="$(victoria_logs_collector_release_name)"
  logs_retention_period="$(trim_whitespace "${VICTORIA_LOGS_RETENTION_PERIOD:-30d}")"
  if [[ -z "$logs_retention_period" ]]; then
    logs_retention_period="30d"
  fi
  logs_pvc_size="$(trim_whitespace "${VICTORIA_LOGS_PVC_SIZE:-10Gi}")"
  if [[ -z "$logs_pvc_size" ]]; then
    logs_pvc_size="10Gi"
  fi
  logs_remote_port="$(trim_whitespace "${VICTORIA_LOGS_PORT:-9428}")"
  if ! [[ "$logs_remote_port" =~ ^[0-9]+$ ]]; then
    logs_remote_port=9428
  fi
  logs_access_service="$(victoria_logs_access_service_name "$logs_release_name")"
  if [[ "$logs_enabled" == "true" ]]; then
    logs_auth_static_url="http://${logs_access_service}.${logs_ns}.svc:${logs_remote_port}"
    # Stop legacy direct VictoriaLogs forwards so only VMAuth-exposed routes remain.
    cleanup_victoria_logs_port_forwards
  fi
  logs_helm_timeout_seconds="$(resolve_victoria_logs_helm_timeout_seconds)"

  if ! operator_row="$(ensure_victoria_metrics_operator "$operator_ns" "$stack_name")"; then
    return 1
  fi
  IFS=$'\t' read -r operator_version operator_manifest_url <<<"$operator_row"
  operator_version="$(trim_whitespace "$operator_version")"
  operator_manifest_url="$(trim_whitespace "$operator_manifest_url")"

  echo "[victoria-metrics] Applying VMSingle/VMAgent/VMAuth/VMUser stack ..."
  ensure_victoria_metrics_stack "$ns" "$stack_name" "$auth_username" "$auth_password" "$timeout_seconds" "$logs_auth_static_url"
  ensure_victoria_metrics_scrape_resources scrape_rows
  write_victoria_metrics_state "$operator_ns" "$stack_name" "$ns" "$operator_ns" "$operator_version" "$operator_manifest_url"

  if [[ "$logs_enabled" == "true" ]]; then
    logs_collector_daemonset="$(victoria_logs_collector_daemonset_name "$logs_collector_release_name")"
    if ! write_victoria_logs_state "$OP_NAMESPACE" "$logs_ns" "$logs_release_name" \
        "$logs_collector_release_name" "$logs_access_service" "$logs_collector_daemonset"; then
      echo "Error: VictoriaLogs install intent could not be persisted; Helm was not started." >&2
      return 1
    fi
    if ! logs_stack_row="$(ensure_victoria_logs_stack "$logs_ns" "$logs_release_name" "$logs_collector_release_name" "$logs_remote_port" "$logs_retention_period" "$logs_pvc_size" "$timeout_seconds" "$logs_helm_timeout_seconds")"; then
      return 1
    fi
    IFS=$'\t' read -r logs_access_service logs_backend_service logs_collector_daemonset logs_remote_write_url logs_ds_ready logs_ds_desired <<<"$logs_stack_row"
    logs_access_service="$(trim_whitespace "$logs_access_service")"
    logs_backend_service="$(trim_whitespace "$logs_backend_service")"
    logs_collector_daemonset="$(trim_whitespace "$logs_collector_daemonset")"
    logs_remote_write_url="$(trim_whitespace "$logs_remote_write_url")"
    logs_ds_ready="$(trim_whitespace "$logs_ds_ready")"
    logs_ds_desired="$(trim_whitespace "$logs_ds_desired")"
    logs_access_service="$(trim_whitespace "$logs_access_service")"
    write_victoria_logs_state "$OP_NAMESPACE" "$logs_ns" "$logs_release_name" "$logs_collector_release_name" "$logs_access_service" "$logs_collector_daemonset"
  fi

  auth_service_name="$(resolve_victoria_metrics_auth_service_name "$ns" "$stack_name" || true)"
  auth_service_name="$(trim_whitespace "$auth_service_name")"
  if [[ -z "$auth_service_name" ]]; then
    echo "Error: failed to resolve VictoriaMetrics auth service name in namespace ${ns}." >&2
    return 1
  fi
  auth_deploy_name="vmauth-${stack_name}"

  credentials_row="$(resolve_victoria_metrics_credentials "$ns" "$stack_name" "$auth_username" "$auth_password")" || return 1
  IFS=$'\t' read -r credentials_secret username password <<<"$credentials_row"
  username="$(trim_whitespace "$username")"
  password="$(trim_whitespace "$password")"

  remote_port="$VICTORIA_METRICS_AUTH_PORT"
  if ! [[ "$remote_port" =~ ^[0-9]+$ ]]; then
    remote_port=8427
  fi
  base_port="$VICTORIA_METRICS_AUTH_LOCAL_PORT_BASE"
  if ! [[ "$base_port" =~ ^[0-9]+$ ]]; then
    base_port=8427
  fi
  api_proxy_base_port="$VICTORIA_METRICS_API_PROXY_LOCAL_PORT_BASE"
  if ! [[ "$api_proxy_base_port" =~ ^[0-9]+$ ]]; then
    api_proxy_base_port=18427
  fi
  bind_address="$(victoria_metrics_port_forward_address)"
  bind_address="$(trim_whitespace "$bind_address")"
  if [[ -z "$bind_address" ]]; then
    bind_address="127.0.0.1"
  fi

  echo "[victoria-metrics] Starting background local port-forward ..."
  echo "[victoria-metrics] Port-forward bind address: ${bind_address}"
  if forward_row="$(start_victoria_metrics_auth_port_forward "$ns" "$auth_service_name" "$base_port" "$remote_port" "$bind_address" || true)"; then
    forward_row="$(trim_whitespace "$forward_row")"
    if [[ -n "$forward_row" ]]; then
      forwarded_rows+=("$forward_row")
    fi
  fi

  if [[ ${#forwarded_rows[@]} -eq 0 ]]; then
    if kubectl -n "$ns" get deployment "$auth_deploy_name" >/dev/null 2>&1; then
      echo "Warning: failed to start port-forward for ${ns}/${auth_service_name}; restarting deployment ${auth_deploy_name} and retrying once ..." >&2
      kubectl -n "$ns" rollout restart "deployment/${auth_deploy_name}" >/dev/null 2>&1 || true
      kubectl -n "$ns" rollout status "deployment/${auth_deploy_name}" --timeout="${timeout_seconds}s" >/dev/null 2>&1 || true
      if forward_row="$(start_victoria_metrics_auth_port_forward "$ns" "$auth_service_name" "$base_port" "$remote_port" "$bind_address" || true)"; then
        forward_row="$(trim_whitespace "$forward_row")"
        if [[ -n "$forward_row" ]]; then
          forwarded_rows+=("$forward_row")
        fi
      fi
    fi
  fi

  if [[ ${#forwarded_rows[@]} -eq 0 ]]; then
    metrics_port_forward_ok=0
    echo "Warning: failed to start background port-forward for VictoriaMetrics auth service ${ns}/${auth_service_name}." >&2
    echo "Warning: VictoriaMetrics stack is installed, but local VMAuth access is unavailable (kubelet proxy likely returned 502)." >&2
    echo "Warning: check node/kubelet reachability (kubectl get nodes -o wide) and retry: ./kubeton victoria-metrics install" >&2
    if api_proxy_row="$(ensure_victoria_metrics_api_proxy "$api_proxy_base_port" || true)"; then
      api_proxy_row="$(trim_whitespace "$api_proxy_row")"
      if [[ -n "$api_proxy_row" ]]; then
        IFS=$'\t' read -r api_proxy_port _api_proxy_pid api_proxy_log <<<"$api_proxy_row"
        api_proxy_port="$(trim_whitespace "$api_proxy_port")"
        api_proxy_log="$(trim_whitespace "$api_proxy_log")"
        if [[ -n "$api_proxy_port" ]]; then
          vmsingle_service="vmsingle-${stack_name}"
          vmagent_service="vmagent-${stack_name}"
          echo "[victoria-metrics] Local fallback VMUI (kubectl proxy): http://127.0.0.1:${api_proxy_port}/api/v1/namespaces/${ns}/services/http:${vmsingle_service}:8428/proxy/vmui/"
          echo "[victoria-metrics] Local fallback targets (kubectl proxy): http://127.0.0.1:${api_proxy_port}/api/v1/namespaces/${ns}/services/http:${vmagent_service}:8429/proxy/targets"
          echo "[victoria-metrics] Local fallback query (kubectl proxy): http://127.0.0.1:${api_proxy_port}/api/v1/namespaces/${ns}/services/http:${vmsingle_service}:8428/proxy/api/v1/query"
          if [[ "$logs_enabled" == "true" ]]; then
            echo "[victoria-metrics] Local fallback VictoriaLogs VMUI (auth via VMAuth): http://127.0.0.1:${api_proxy_port}/api/v1/namespaces/${ns}/services/http:${auth_service_name}:${remote_port}/proxy/select/vmui/"
            echo "[victoria-metrics] Local fallback VictoriaLogs query API (auth via VMAuth): http://127.0.0.1:${api_proxy_port}/api/v1/namespaces/${ns}/services/http:${auth_service_name}:${remote_port}/proxy/select/logsql/query"
          fi
          if [[ -n "$api_proxy_log" ]]; then
            echo "[victoria-metrics] Local fallback proxy log: ${api_proxy_log}"
          fi
        fi
      fi
    fi
    ensure_victoria_metrics_nodeport_access "$ns" "$stack_name" "$remote_port" || true
  else
    metrics_port_forward_ok=1
    IFS=$'\t' read -r pf_ns pf_service local_port _pid log_file <<<"${forwarded_rows[0]}"
    if address_list_allows_loopback "$bind_address"; then
      echo "[victoria-metrics] Background VMUI access: http://127.0.0.1:${local_port}/vmui/"
      echo "[victoria-metrics] Background targets access: http://127.0.0.1:${local_port}/targets"
    fi
    if address_list_exposes_non_loopback "$bind_address"; then
      remote_access_host="$(first_non_loopback_bind_address "$bind_address" || true)"
      remote_access_host="$(trim_whitespace "$remote_access_host")"
      if [[ -z "$remote_access_host" ]]; then
        remote_access_host="$(resolve_primary_host_address || true)"
        remote_access_host="$(trim_whitespace "$remote_access_host")"
      fi
      if [[ -n "$remote_access_host" ]]; then
        echo "[victoria-metrics] Remote VMUI access: http://${remote_access_host}:${local_port}/vmui/"
        echo "[victoria-metrics] Remote targets access: http://${remote_access_host}:${local_port}/targets"
      fi
    fi
    if [[ "$logs_enabled" == "true" ]]; then
      echo "[victoria-metrics] VictoriaLogs VMUI access (auth via VMAuth): http://127.0.0.1:${local_port}/select/vmui/"
      echo "[victoria-metrics] VictoriaLogs query API (auth via VMAuth): http://127.0.0.1:${local_port}/select/logsql/query"
      if [[ -n "$remote_access_host" ]]; then
        echo "[victoria-metrics] VictoriaLogs remote VMUI access (auth via VMAuth): http://${remote_access_host}:${local_port}/select/vmui/"
        echo "[victoria-metrics] VictoriaLogs remote query API (auth via VMAuth): http://${remote_access_host}:${local_port}/select/logsql/query"
      fi
    fi
    echo "[victoria-metrics] Query endpoint: http://127.0.0.1:${local_port}/api/v1/query"
    echo "[victoria-metrics] Port-forward log: ${log_file}"
  fi

  echo "[victoria-metrics] Username: ${username}"
  echo "[victoria-metrics] Password: ${password}"
  echo "[victoria-metrics] Credentials secret: ${ns}/${credentials_secret}"
  echo "[victoria-metrics] In-cluster VMAuth URL (pod/cluster only): http://${auth_service_name}.${ns}.svc:${remote_port}/"
  echo "[victoria-metrics] In-cluster query endpoint (pod/cluster only): http://${auth_service_name}.${ns}.svc:${remote_port}/api/v1/query"
  echo "[victoria-metrics] Operator namespace: ${operator_ns}"
  echo "[victoria-metrics] Operator version: ${operator_version}"
  echo "[victoria-metrics] Operator manifest: ${operator_manifest_url}"
  if [[ "$logs_enabled" == "true" ]]; then
    echo "[victoria-metrics] VictoriaLogs enabled: true"
    echo "[victoria-metrics] VictoriaLogs namespace: ${logs_ns}"
    echo "[victoria-metrics] VictoriaLogs release: ${logs_release_name}"
    echo "[victoria-metrics] VictoriaLogs collector release: ${logs_collector_release_name}"
    echo "[victoria-metrics] VictoriaLogs in-cluster URL (auth via VMAuth, pod/cluster only): http://${auth_service_name}.${ns}.svc:${remote_port}/select/vmui/"
    echo "[victoria-metrics] VictoriaLogs in-cluster query API (auth via VMAuth, pod/cluster only): http://${auth_service_name}.${ns}.svc:${remote_port}/select/logsql/query"
    echo "[victoria-metrics] VictoriaLogs backend URL (internal service): http://${logs_access_service}.${logs_ns}.svc:${logs_remote_port}/select/vmui/"
    if [[ "$logs_ds_ready" =~ ^[0-9]+$ && "$logs_ds_desired" =~ ^[0-9]+$ ]]; then
      echo "[victoria-metrics] VictoriaLogs collector readiness: ${logs_ds_ready}/${logs_ds_desired}"
    fi
    if [[ -n "$logs_remote_write_url" ]]; then
      echo "[victoria-metrics] VictoriaLogs collector remoteWrite URL: ${logs_remote_write_url}"
    fi
  else
    echo "[victoria-metrics] VictoriaLogs enabled: false (set VICTORIA_LOGS_ENABLED=true to enable)"
  fi
  if (( metrics_port_forward_ok == 0 )); then
    echo "[victoria-metrics] Query endpoint: unavailable via direct port-forward; use fallback URLs above."
  fi
  echo "[victoria-metrics] TonNode scrape resources configured: ${#scrape_rows[@]}"
}

