  then
    return 1
  fi

  if ! kubectl -n "$ns" rollout status "deployment/${deploy_name}" --timeout=180s >/dev/null 2>&1; then
    echo "Error: authenticated Prometheus deployment ${ns}/${deploy_name} is not Ready; access was not enabled." >&2
    cleanup_prometheus_port_forwards
    return 1
  fi

  printf '%s\t%s\t%s\t%s\n' "$ns" "$service_name" "$deploy_name" "$exporter_address"
