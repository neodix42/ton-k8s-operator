  explicit_image="$(trim_whitespace "${MAIN_WALLET_IMAGE:-}")"
  if [[ -n "$explicit_image" ]]; then
    printf '%s' "$explicit_image"
    return 0
  fi

  ton_image="$(resolve_tonnode_ton_image || true)"
  ton_image="$(trim_whitespace "$ton_image")"
  if [[ -z "$ton_image" ]]; then
    echo "Error: cannot resolve TonNode TON artifact image; set tonNode.tonImage or MAIN_WALLET_IMAGE explicitly." >&2
    return 1
  fi

  # Preserve a pinned digest and alternate artifact registry unless a helper
  # repository override was explicitly selected.
  if [[ "$MAIN_WALLET_IMAGE_REPOSITORY" == "ghcr.io/ton-blockchain/ton" ]]; then
    printf '%s' "$ton_image"
    return 0
  fi

  tag="$(extract_image_tag "$ton_image" || true)"
  tag="$(trim_whitespace "$tag")"
  if [[ -z "$tag" ]]; then
    echo "Error: cannot derive a helper repository tag from TON artifact image '${ton_image}'. Set MAIN_WALLET_IMAGE explicitly." >&2
    return 1
  fi
  printf '%s:%s' "$MAIN_WALLET_IMAGE_REPOSITORY" "$tag"
}

