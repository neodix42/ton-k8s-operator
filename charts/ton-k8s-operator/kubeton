grafana_datasource_uid_for_name() {
  # Match Grafana 11's implicit provisioning UID so existing data sources and
  # user-created dashboards keep the same identity when this field is added.
  printf '%s' "$1" | python3 -c 'import hashlib,sys; print("P" + hashlib.sha256(sys.stdin.buffer.read()).hexdigest()[:16].upper())'
}

grafana_dashboard_uid() {
  local uid
  uid="$(trim_whitespace "${GRAFANA_DASHBOARD_UID:-kubeton-ton-overview}")"
  [[ -n "$uid" ]] || uid=kubeton-ton-overview
  if ! [[ "$uid" =~ ^[A-Za-z0-9_-]{1,40}$ ]]; then
    echo "Error: GRAFANA_DASHBOARD_UID must contain 1-40 letters, digits, underscores or hyphens." >&2
    return 1
  fi
  printf '%s' "$uid"
}

wait_grafana_dashboard_ready() {
  local local_port="$1" verify_seconds="$2" username="$3" password="$4" uid="$5"
  local host="${6:-127.0.0.1}" authorization response deadline
  [[ "$uid" =~ ^[A-Za-z0-9_-]{1,40}$ ]] || return 1
  [[ "$verify_seconds" =~ ^[0-9]+$ ]] || verify_seconds=20
  [[ "$host" != *:* || "$host" == \[*\] ]] || host="[$host]"
  authorization="$(printf '%s:%s' "$username" "$password" | base64 | tr -d '\r\n')" || return 1
  deadline=$(( $(date +%s) + verify_seconds ))
  while :; do
    response="$(printf 'Authorization: Basic %s\n' "$authorization" | \
      curl --disable --noproxy '*' -fsS --max-time 3 --header @- \
        "http://${host}:${local_port}/api/dashboards/uid/${uid}" 2>/dev/null || true)"
    if printf '%s' "$response" | python3 -c '
import json,sys
try:
    dashboard = json.load(sys.stdin)["dashboard"]
    sys.exit(not (dashboard.get("uid") == sys.argv[1] and dashboard.get("panels")))
except (KeyError, TypeError, ValueError):
    sys.exit(1)
' "$uid"; then
      return 0
    fi
    (( $(date +%s) < deadline )) || return 1
    sleep 1
  done
}

first_grafana_datasource_name_from_prometheus_rows() {
  local row ns service_name _deploy_name _exporter_address

  for row in "$@"; do
    [[ -z "$row" ]] && continue
    IFS=$'\t' read -r ns service_name _deploy_name _exporter_address <<<"$row"
    ns="$(trim_whitespace "$ns")"
    service_name="$(trim_whitespace "$service_name")"
    if [[ -n "$ns" && -n "$service_name" ]]; then
      grafana_datasource_name_for_service "$ns" "$service_name"
      return 0
    fi
  done
  return 1
}

