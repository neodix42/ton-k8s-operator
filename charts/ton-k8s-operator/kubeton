usage() {
  cat <<'EOF'
Usage:
  kubeton <command>

Commands:
  check                Check schedulable nodes against TON CPU, memory, disk, and pressure prerequisites.
  install              Install or upgrade operator and retain a local launch evidence bundle.
  bootstrap-baremetal  Prepare key prerequisites: Longhorn+Vault on bare-metal, local StorageClass+Vault on k3d.
  start                Start TON fleet, archive launch evidence, and wait for completed MyTonCtrl bootstrap.
  prometheus start     Create/update Prometheus pod(s) for TonNode exporter targets and start local background port-forward.
  prometheus stop      Stop/drop kubeton-managed Prometheus resources and local background port-forward(s).
  grafana start        Create/update Grafana, provision kubeton Prometheus datasource(s) and starter dashboard(s), and start local background port-forward.
  grafana stop         Stop/drop kubeton-managed Grafana resources and local background port-forward(s).
  victoria-metrics install    Install VictoriaMetrics operator + VMSingle/VMAgent/VMAuth stack, configure TonNode scraping, enable VictoriaLogs collector, and start local background port-forward(s).
  victoria-metrics uninstall  Remove kubeton-managed VictoriaMetrics/VictoriaLogs resources and local background port-forward(s).
  add                  Add one fresh TON replica to the existing TON StatefulSet (resets leftover target-ordinal PVCs if present).
  del                  Delete the tail TON pod replica (highest ordinal) with its PVC/PV/Longhorn volume.
  recreate             Recreate one TON pod data volumes and restore its encrypted key bundle: kubeton recreate <pod-name|namespace/pod-name> <backup-dir>.
  backup-keys          Trigger manual encrypted backup, export key bundles, restore TON replicas.
  restore-keys         Restore encrypted key bundles from backup dir, then restart TON replicas.
  wallet               Run wallet utilities: kubeton wallet <create|deploy|activate|send|collect|show|export> [args...]
  stop                 Stop TON fleet (sets TonNode replicas to 0; keeps operator/TonNode/StatefulSet/PVC). Backup is skipped by default; set SKIP_STOP_KEY_BACKUP=false to run stop-time backup.
  drop                 Stop TON fleet + delete TonNode resources + delete TON PVCs (with confirmation).
  uninstall            Full best-effort cleanup of kubeton-managed resources (with confirmation; keeps TonNode CRD).
  purge                Full best-effort cleanup + delete TonNode CRD (separate to avoid accidental cluster-wide CRD removal).
  verify               Verify operator and TON resources (deploy, pods with node/server, tonnodes, sts, pvc).
  status               Run wallet/adnl/sync/db checks in each TON pod; print node/pod/wallet/adnl/sync/cell db/archive db.
  exec <cmd>           Run a command in each TON pod and print table with node/pod/exit code.
  exec-mtc <cmd>       Run a command in each TON pod inside mytonctrl and print table with node/pod/exit code.

Environment overrides:
  See README.md section "Environment overrides".
EOF
}

require_bin() {
  local bin="$1"
  if ! command -v "$bin" >/dev/null 2>&1; then
    echo "Error: required command not found: $bin" >&2
    exit 1
  fi
}

helm_upgrade_supports_force_conflicts() {
  local help_output

  help_output="$(helm upgrade --help 2>/dev/null || true)"
  grep -q -- '--force-conflicts' <<<"$help_output"
}

append_helm_force_conflicts_if_supported() {
  local -n helm_cmd_ref="$1"

  if helm_upgrade_supports_force_conflicts; then
    helm_cmd_ref+=(--force-conflicts)
  fi
}

sanitize_compact() {
  # Keep printable token/key characters only and remove all control/whitespace noise.
  printf '%s' "${1:-}" | tr -d '\000-\037\177' | tr -d '[:space:]'
}

trim_whitespace() {
  printf '%s' "${1:-}" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//'
}

run_with_timeout() {
  local timeout_value="$1"
  shift
  if command -v timeout >/dev/null 2>&1; then
    timeout "$timeout_value" "$@"
    return $?
  fi
  "$@"
}

launch_session_selector() {
  local tonnode_name="$1"
