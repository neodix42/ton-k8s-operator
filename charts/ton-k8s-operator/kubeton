collect_pvc_rows_by_prefix() {
  local prefix="$1"
  local -n rows_ref="$2"
  local selector="${3:-}"
  local strict="${4:-false}"
  local ns pvc pvc_inventory

  prefix="$(trim_whitespace "$prefix")"
  selector="$(trim_whitespace "$selector")"
  [[ -n "$prefix" ]] || return 0

  if [[ -n "$selector" ]]; then
    if ! pvc_inventory="$(kubectl get pvc -A -l "$selector" \
      -o jsonpath='{range .items[*]}{.metadata.namespace}{"\t"}{.metadata.name}{"\n"}{end}' 2>/dev/null)"; then
      if is_true "$strict"; then
        echo "Error: cannot inventory PVCs matching '${selector}' while resolving prefix ${prefix}." >&2
        return 1
      fi
      pvc_inventory=""
    fi
  elif ! pvc_inventory="$(kubectl get pvc -A \
    -o jsonpath='{range .items[*]}{.metadata.namespace}{"\t"}{.metadata.name}{"\n"}{end}' 2>/dev/null)"; then
    if is_true "$strict"; then
      echo "Error: cannot inventory cluster PVCs while resolving prefix ${prefix}." >&2
      return 1
    fi
    pvc_inventory=""
  fi

  while IFS=$'\t' read -r ns pvc; do
    ns="$(trim_whitespace "$ns")"
    pvc="$(trim_whitespace "$pvc")"
    [[ -z "$ns" || -z "$pvc" ]] && continue
    [[ "$pvc" == "$prefix"* ]] || continue
    append_unique_item "$ns"$'\t'"$pvc" rows_ref
  done <<<"$pvc_inventory"
}

collect_victoria_logs_release_rows() {
  local single_rows_name="$1"
  local collector_rows_name="$2"
  local -n single_rows_ref="$single_rows_name"
  local -n collector_rows_ref="$collector_rows_name"
  local default_ns default_release default_collector row state_ns ns release collector
  local state_rows single_discovery_rows collector_discovery_rows

  default_ns="$(victoria_logs_namespace)"
  default_release="$(victoria_logs_release_name)"
  default_collector="$(victoria_logs_collector_release_name)"
  append_unique_item "$default_ns"$'\t'"$default_release" single_rows_ref
  append_unique_item "$default_ns"$'\t'"$default_collector" collector_rows_ref

  if ! state_rows="$(kubectl get configmap -A \
      -l 'app.kubernetes.io/name=kubeton-victoria-logs,app.kubernetes.io/managed-by=kubeton' \
      -o jsonpath='{range .items[*]}{.metadata.namespace}{"\t"}{.data.namespace}{"\t"}{.data.releaseName}{"\t"}{.data.collectorReleaseName}{"\n"}{end}' 2>/dev/null)"; then
    echo "Error: cannot inventory the VictoriaLogs cleanup ledger across namespaces." >&2
    return 1
  fi
  while IFS=$'\t' read -r state_ns ns release collector; do
    state_ns="$(trim_whitespace "$state_ns")"
    ns="$(trim_whitespace "$ns")"
    release="$(trim_whitespace "$release")"
    collector="$(trim_whitespace "$collector")"
    [[ -z "$ns" ]] && ns="$state_ns"
    [[ -z "$release" ]] && release="$default_release"
    [[ -z "$collector" ]] && collector="$default_collector"
    [[ -n "$ns" && -n "$release" ]] && append_unique_item "$ns"$'\t'"$release" single_rows_ref
    [[ -n "$ns" && -n "$collector" ]] && append_unique_item "$ns"$'\t'"$collector" collector_rows_ref
  done <<<"$state_rows"

  if ! single_discovery_rows="$(kubectl get statefulset -A \
      -l 'app.kubernetes.io/name=victoria-logs-single' \
      -o jsonpath='{range .items[*]}{.metadata.namespace}{"\t"}{.metadata.labels.app\.kubernetes\.io/instance}{"\n"}{end}' 2>/dev/null)"; then
    echo "Error: cannot inventory VictoriaLogs StatefulSets across namespaces." >&2
    return 1
  fi
  while IFS=$'\t' read -r ns release; do
    ns="$(trim_whitespace "$ns")"
    release="$(trim_whitespace "$release")"
    [[ -z "$ns" || -z "$release" ]] && continue
    case "$release" in
      kubeton*|"${default_release}")
        append_unique_item "$ns"$'\t'"$release" single_rows_ref
        ;;
    esac
  done <<<"$single_discovery_rows"

  if ! collector_discovery_rows="$(kubectl get daemonset -A \
      -l 'app.kubernetes.io/name=victoria-logs-collector' \
      -o jsonpath='{range .items[*]}{.metadata.namespace}{"\t"}{.metadata.labels.app\.kubernetes\.io/instance}{"\n"}{end}' 2>/dev/null)"; then
    echo "Error: cannot inventory VictoriaLogs collector DaemonSets across namespaces." >&2
    return 1
  fi
  while IFS=$'\t' read -r ns collector; do
    ns="$(trim_whitespace "$ns")"
    collector="$(trim_whitespace "$collector")"
    [[ -z "$ns" || -z "$collector" ]] && continue
    case "$collector" in
      kubeton*|"${default_collector}")
        append_unique_item "$ns"$'\t'"$collector" collector_rows_ref
        ;;
    esac
  done <<<"$collector_discovery_rows"
}

