resolve_wallet_fleet_config() {
  local pod_rows ns pod node_name config network selected_network="" selected_config=""
  KUBETON_WALLET_NETWORK=""
  KUBETON_WALLET_GLOBAL_CONFIG_JSON=""
  if ! command -v python3 >/dev/null 2>&1; then
    echo "Error: python3 is required to detect the wallet network from global.config.json." >&2
    return 1
  fi
  if ! pod_rows="$(list_ton_pods)"; then
    echo "Error: cannot list TON pods to detect the wallet network." >&2
    return 1
  fi
  while IFS=$'\t' read -r ns pod node_name; do
    [[ -n "$ns" && -n "$pod" ]] || continue
    if ! config="$(read_tonnode_global_config "$ns" "$pod")"; then
      echo "Error: cannot read the active global.config.json in ${ns}/${pod}." >&2
      return 1
    fi
    if ! network="$(printf '%s' "$config" | wallet_network_from_global_config)"; then
      echo "Error: cannot detect the active network in ${ns}/${pod}." >&2
      return 1
    fi
    if [[ -n "$selected_network" && "$selected_network" != "$network" ]]; then
      echo "Error: TON pods use different networks (${selected_network} and ${network}); select a single fleet with TON_POD_LABEL." >&2
      return 1
    fi
    if [[ -z "$selected_network" ]]; then
      selected_network="$network"
      selected_config="$config"
    fi
  done <<<"$pod_rows"
  if [[ -z "$selected_network" ]]; then
    echo "Error: no TON pods with an active global.config.json were found; start the fleet before deploying or transferring funds." >&2
    return 1
  fi
  KUBETON_WALLET_NETWORK="$selected_network"
  KUBETON_WALLET_GLOBAL_CONFIG_JSON="$selected_config"
}

ton_nano_to_gram_amount() {
  local nano="$1"
  local whole frac

  if ! [[ "$nano" =~ ^[0-9]+$ ]]; then
    return 1
  fi
  whole=$((nano / 1000000000))
  frac=$((nano % 1000000000))
  printf '%s.%09d' "$whole" "$frac"
}

ton_gram_amount_to_nano() {
  local amount="$1"
  local normalized whole frac padded

  normalized="$(trim_whitespace "$amount")"
  if ! [[ "$normalized" =~ ^[0-9]+([.][0-9]+)?[.]?$ ]]; then
    return 1
  fi
  if [[ "$normalized" == *"." ]]; then
    normalized="${normalized%.}"
  fi

  whole="$normalized"
  frac=""
  if [[ "$normalized" == *"."* ]]; then
    whole="${normalized%%.*}"
    frac="${normalized#*.}"
  fi

  [[ -z "$whole" ]] && whole="0"
  [[ -z "$frac" ]] && frac="0"
  if ! [[ "$whole" =~ ^[0-9]+$ && "$frac" =~ ^[0-9]+$ ]]; then
    return 1
  fi
  if (( ${#frac} > 9 )); then
    return 1
  fi

  padded="$frac"
  while (( ${#padded} < 9 )); do
    padded="${padded}0"
  done

  printf '%s' "$((10#$whole * 1000000000 + 10#$padded))"
}

