wait_namespace_gone() {
  local ns="$1"
  local timeout_seconds="${2:-180}"
  local deadline=$(( $(date +%s) + timeout_seconds ))
  local phase
  local force_attempts=0
  local max_force_attempts=4

  while kubectl get namespace "$ns" >/dev/null 2>&1; do
    phase="$(kubectl get namespace "$ns" -o jsonpath='{.status.phase}' 2>/dev/null || true)"
    if (( $(date +%s) >= deadline )); then
      if [[ "$phase" == "Terminating" ]]; then
        if (( force_attempts >= max_force_attempts )); then
          echo "Error: namespace ${ns} is still Terminating after ${max_force_attempts} forced cleanup attempts." >&2
          return 1
        fi
        ((force_attempts+=1))
        echo "[localdev] Namespace ${ns} is stuck Terminating; clearing finalizers ..."
        kubectl patch namespace "$ns" --type=merge -p '{"spec":{"finalizers":[]}}' >/dev/null 2>&1 || true
        kubectl delete namespace "$ns" --ignore-not-found --wait=false >/dev/null 2>&1 || true
        deadline=$(( $(date +%s) + 60 ))
      else
        echo "Error: namespace ${ns} still exists after waiting ${timeout_seconds}s." >&2
        return 1
      fi
    fi
    sleep 2
  done
  return 0
}

ensure_namespace_not_terminating() {
  local ns="$1"
  local timeout_seconds="${2:-180}"
  local deadline=$(( $(date +%s) + timeout_seconds ))
  local phase
  local force_attempts=0
  local max_force_attempts=4

  while kubectl get namespace "$ns" >/dev/null 2>&1; do
    phase="$(kubectl get namespace "$ns" -o jsonpath='{.status.phase}' 2>/dev/null || true)"
    if [[ "$phase" != "Terminating" ]]; then
      return 0
    fi
    if (( $(date +%s) >= deadline )); then
      if (( force_attempts >= max_force_attempts )); then
        echo "Error: namespace ${ns} remains Terminating after ${max_force_attempts} forced cleanup attempts." >&2
        return 1
      fi
      ((force_attempts+=1))
      echo "[localdev] Namespace ${ns} is stuck Terminating; clearing finalizers ..."
      kubectl patch namespace "$ns" --type=merge -p '{"spec":{"finalizers":[]}}' >/dev/null 2>&1 || true
      kubectl delete namespace "$ns" --ignore-not-found --wait=false >/dev/null 2>&1 || true
      deadline=$(( $(date +%s) + 60 ))
    fi
    sleep 2
  done

  return 0
}

cluster_is_baremetal() {
  local provider_ids compact
  provider_ids="$(kubectl get nodes -o jsonpath='{range .items[*]}{.spec.providerID}{"\n"}{end}')"
  compact="$(printf '%s' "$provider_ids" | tr -d '[:space:]')"
  [[ -z "$compact" ]]
}

cluster_is_k3d() {
  local context node nonempty=0
  context="$(kubectl config current-context 2>/dev/null || true)"
  if [[ "$context" == k3d-* ]]; then
    return 0
  fi

  while IFS= read -r node; do
    [[ -z "$node" ]] && continue
    nonempty=1
    [[ "$node" == k3d-* ]] || return 1
  done < <(kubectl get nodes -o jsonpath='{range .items[*]}{.metadata.name}{"\n"}{end}' 2>/dev/null || true)

  [[ "$nonempty" -eq 1 ]]
}

should_bootstrap_baremetal() {
  if ! is_true "$AUTO_BAREMETAL_BOOTSTRAP"; then
    return 1
  fi
  if is_true "$FORCE_BAREMETAL_BOOTSTRAP"; then
    return 0
  fi
  if cluster_is_baremetal || cluster_is_k3d; then
    return 0
  fi
  return 1
}

resolve_localdev_storage_class() {
  local default_sc first_sc

  if [[ -n "$LOCALDEV_BASE_SC" ]] && kubectl get storageclass "$LOCALDEV_BASE_SC" >/dev/null 2>&1; then
    printf '%s\n' "$LOCALDEV_BASE_SC"
    return 0
  fi

  if kubectl get storageclass local-path >/dev/null 2>&1; then
    printf '%s\n' "local-path"
    return 0
  fi

  default_sc="$(kubectl get storageclass -o jsonpath='{range .items[*]}{.metadata.name}{"\t"}{.metadata.annotations.storageclass\.kubernetes\.io/is-default-class}{"\n"}{end}' 2>/dev/null | awk '$2=="true"{print $1; exit}')"
  if [[ -n "$default_sc" ]]; then
    printf '%s\n' "$default_sc"
    return 0
  fi

  first_sc="$(kubectl get storageclass -o jsonpath='{.items[0].metadata.name}' 2>/dev/null || true)"
  if [[ -n "$first_sc" ]]; then
    printf '%s\n' "$first_sc"
    return 0
  fi

  echo "Error: no StorageClass found; local dev bootstrap requires at least one StorageClass." >&2
  exit 1
}

ensure_helm_repo() {
  local name="$1"
  local url="$2"
  helm repo add "$name" "$url" --force-update >/dev/null
}

cleanup_longhorn_webhook_configs() {
  kubectl get validatingwebhookconfiguration,mutatingwebhookconfiguration -o name 2>/dev/null \
    | grep -Ei 'longhorn' \
    | xargs -r kubectl delete --ignore-not-found >/dev/null 2>&1 || true
}

clear_longhorn_namespace_resource_finalizers() {
  local resource
  for resource in $(kubectl api-resources --api-group=longhorn.io -o name 2>/dev/null || true); do
    kubectl -n "$LONGHORN_NAMESPACE" get "$resource" -o name 2>/dev/null \
      | xargs -r -I{} kubectl -n "$LONGHORN_NAMESPACE" patch {} --type=merge -p '{"metadata":{"finalizers":[]}}' >/dev/null 2>&1 || true
  done
}

force_finalize_namespace() {
  local ns="$1"

  kubectl patch namespace "$ns" --type=json -p='[{"op":"replace","path":"/spec/finalizers","value":[]}]' >/dev/null 2>&1 || true
  kubectl patch namespace "$ns" --type=merge -p '{"spec":{"finalizers":[]}}' >/dev/null 2>&1 || true

  if command -v jq >/dev/null 2>&1; then
    kubectl get ns "$ns" -o json 2>/dev/null \
      | jq '.spec.finalizers=[]' \
      | kubectl replace --raw "/api/v1/namespaces/${ns}/finalize" -f - >/dev/null 2>&1 || true
  fi

  kubectl delete namespace "$ns" --ignore-not-found --wait=false >/dev/null 2>&1 || true
}

recover_stuck_longhorn_namespace() {
  local phase
  if ! kubectl get namespace "$LONGHORN_NAMESPACE" >/dev/null 2>&1; then
    return 0
  fi

  phase="$(kubectl get namespace "$LONGHORN_NAMESPACE" -o jsonpath='{.status.phase}' 2>/dev/null || true)"
  if [[ "$phase" != "Terminating" ]]; then
    return 0
  fi

  echo "[baremetal] Namespace ${LONGHORN_NAMESPACE} is Terminating; cleaning stale Longhorn webhooks/finalizers ..."
  cleanup_longhorn_webhook_configs
  clear_longhorn_namespace_resource_finalizers
  force_finalize_namespace "$LONGHORN_NAMESPACE"
  wait_namespace_gone "$LONGHORN_NAMESPACE" "$NAMESPACE_DELETE_PROGRESS_TIMEOUT" || true
}

delete_volume_attachments_for_pv() {
  local pv="$1"
  local attachment

  kubectl get volumeattachments.storage.k8s.io \
    -o jsonpath='{range .items[?(@.spec.source.persistentVolumeName=="'"${pv}"'")]}{.metadata.name}{"\n"}{end}' 2>/dev/null \
    | while IFS= read -r attachment; do
        attachment="$(trim_whitespace "$attachment")"
        [[ -z "$attachment" ]] && continue
        echo "[cleanup] Deleting stale VolumeAttachment ${attachment} for PV ${pv} ..."
        kubectl delete volumeattachment "$attachment" --ignore-not-found --wait=false >/dev/null 2>&1 || true
      done
}

delete_vault_pvcs_and_backing_volumes() {
  local -a pvc_rows=()
  local namespace_marker pvc_rows_output pvc

  if ! namespace_marker="$(kubectl get namespace "$VAULT_NAMESPACE" --ignore-not-found -o jsonpath='{.metadata.uid}' 2>/dev/null)"; then
    echo "Error: could not inspect Vault namespace ${VAULT_NAMESPACE} before storage cleanup." >&2
    return 1
  fi
  namespace_marker="$(trim_whitespace "$namespace_marker")"
  if [[ -z "$namespace_marker" ]]; then
    return 0
  fi

  if ! pvc_rows_output="$(kubectl -n "$VAULT_NAMESPACE" get pvc -o jsonpath='{range .items[*]}{.metadata.name}{"\n"}{end}' 2>/dev/null)"; then
    echo "Error: could not list Vault PVCs in ${VAULT_NAMESPACE}." >&2
    return 1
  fi
  while IFS= read -r pvc; do
    pvc="$(trim_whitespace "$pvc")"
    [[ -z "$pvc" ]] && continue
    append_unique_item "$VAULT_NAMESPACE"$'\t'"$pvc" pvc_rows
  done <<<"$pvc_rows_output"

  if [[ ${#pvc_rows[@]} -eq 0 ]]; then
    return 0
  fi

  delete_pvc_rows_and_backing_volumes pvc_rows "cleanup"
}

storage_list_helm_releases() {
  local ns="$1" helm_help
  local -a list_cmd=(helm list -n "$ns" --short)
  # Helm 3 needs --all for failed/pending releases; Helm 4 lists all release
  # states by default and rejects that removed flag.
  helm_help="$(helm list --help 2>/dev/null)" || return 1
  if printf '%s\n' "$helm_help" | grep -Eq '(^|[[:space:]])--all([[:space:]]|$)'; then
    list_cmd+=(--all)
  fi
  "${list_cmd[@]}"
}

storage_release_present() {
  local release="$1" ns="$2" rows row
  if ! rows="$(storage_list_helm_releases "$ns" 2>/dev/null)"; then
    echo "Error: cannot inspect Helm releases in ${ns}." >&2
    return 2
  fi
  while IFS= read -r row; do
    [[ "$row" == "$release" ]] && return 0
  done <<<"$rows"
  return 1
}

# Longhorn creates some child objects without its managed-by/Helm labels.
# Follow live, UID-matched ownership instead of treating their name prefix as
# ownership. EngineImage references intentionally lack controller=true.
longhorn_object_has_release_owner() {
  local ns="$1" release="$2" resource="$3" object="$4"
  local expected_uid="${5:-}" depth="${6:-0}" seen="${7:-}"
  local expected_kind="${8:-}" expected_group="${9:-}"
  local rows header tag api kind object_ns name uid instance release_label helm_release helm_ns longhorn_owner app app_name helm_owner helm_name extra
  local ref_api ref_kind ref_name ref_uid parent_resource ref_group actual_group key value delimiters cache_key cache_value
  (( depth < 8 )) || return 1
  if ! rows="$(kubectl -n "$ns" get "$resource" "$object" --ignore-not-found \
      -o 'jsonpath={"META|"}{.apiVersion}{"|"}{.kind}{"|"}{.metadata.namespace}{"|"}{.metadata.name}{"|"}{.metadata.uid}{"|"}{.metadata.labels.app\.kubernetes\.io/instance}{"|"}{.metadata.labels.release}{"|"}{.metadata.annotations.meta\.helm\.sh/release-name}{"|"}{.metadata.annotations.meta\.helm\.sh/release-namespace}{"|"}{.metadata.labels.longhorn\.io/managed-by}{"|"}{.metadata.labels.app}{"|"}{.metadata.labels.app\.kubernetes\.io/name}{"|"}{.metadata.labels.owner}{"|"}{.metadata.labels.name}{"\n"}{range .metadata.ownerReferences[*]}{"OWNER|"}{.apiVersion}{"|"}{.kind}{"|"}{.name}{"|"}{.uid}{"\n"}{end}' 2>/dev/null)"; then
    return 1
  fi
  [[ "$rows" != *$'\t'* && "$rows" != *$'\r'* ]] || return 1
  header="${rows%%$'\n'*}"
  delimiters="${header//[^|]/}"
  (( ${#delimiters} == 14 )) || return 1
  IFS='|' read -r tag api kind object_ns name uid instance release_label helm_release helm_ns longhorn_owner app app_name helm_owner helm_name extra <<<"$header"
  [[ "$tag" == META && "$object_ns" == "$ns" && "$name" == "$object" && -n "$uid" && -n "$api" && -n "$kind" && -z "$extra" ]] || return 1
  [[ -z "$expected_uid" || "$uid" == "$expected_uid" ]] || return 1
  actual_group="${api%/*}"
  [[ "$api" == */* ]] || actual_group=core
  if [[ -n "$expected_kind" ]]; then
    [[ "$kind" == "$expected_kind" && "$actual_group" == "$expected_group" ]] || return 1
  fi
  key="|${actual_group}/${kind}/${name}/${uid}|"
  [[ "$seen" != *"$key"* ]] || return 1
  seen+="$key"
  # A child of this release may not carry an explicit identity for another
  # release. Evaluate these conflicts before either labels or parent links.
  for value in "$instance" "$release_label" "$helm_release"; do
    [[ -z "$value" || "$value" == "$release" ]] || return 1
  done
  [[ -z "$helm_ns" || "$helm_ns" == "$ns" ]] || return 1
  [[ "$helm_owner" != helm || -z "$helm_name" || "$helm_name" == "$release" ]] || return 1
  cache_key="${ns}/${release}/${resource}/${object}"
  cache_value="${actual_group}/${kind}/${uid}"
  # The teardown caller owns this ephemeral cache. Helm may delete parents
  # before a previously verified child finishes terminating; re-read the
  # child's UID and Helm identity above before reusing that same-call proof.
  if [[ "${KUBETON_LONGHORN_OWNER_CACHE_ACTIVE:-false}" == true \
    && "${KUBETON_LONGHORN_PROVEN_OWNERS[$cache_key]:-}" == "$cache_value" ]]; then
    return 0
  fi
  [[ "$instance" == "$release" || "$release_label" == "$release" \
    || ( "$helm_release" == "$release" && "$helm_ns" == "$ns" ) \
    || ( "$helm_owner" == helm && "$helm_name" == "$release" ) ]] && return 0
  [[ "$longhorn_owner" == longhorn-manager || "$actual_group" == longhorn.io || "$app_name" == longhorn ]] && return 0
  case "$app" in
    longhorn-manager|longhorn-driver-deployer|longhorn-ui|csi-attacher|csi-provisioner|csi-resizer|csi-snapshotter|longhorn-csi-plugin) return 0 ;;
  esac
  while IFS= read -r header; do
    [[ "$header" == OWNER\|* ]] || continue
    delimiters="${header//[^|]/}"
    (( ${#delimiters} == 4 )) || return 1
    IFS='|' read -r tag ref_api ref_kind ref_name ref_uid extra <<<"$header"
    [[ "$tag" == OWNER && -n "$ref_name" && -n "$ref_uid" && -z "$extra" ]] || continue
    parent_resource=""
    # Resolve only supported namespace-scoped parent kinds. The API group and
    # kind are checked again against the live parent returned by Kubernetes.
    case "${ref_api}/${ref_kind}" in
      apps/v1/DaemonSet) parent_resource=daemonsets.apps ;;
      apps/v1/ReplicaSet) parent_resource=replicasets.apps ;;
      apps/v1/Deployment) parent_resource=deployments.apps ;;
      batch/v1/Job) parent_resource=jobs.batch ;;
      batch/v1/CronJob) parent_resource=cronjobs.batch ;;
      v1/Service) parent_resource=services ;;
      v1/ServiceAccount) parent_resource=serviceaccounts ;;
      longhorn.io/v1beta[12]/EngineImage) parent_resource=engineimages.longhorn.io ;;
      longhorn.io/v1beta[12]/InstanceManager) parent_resource=instancemanagers.longhorn.io ;;
      longhorn.io/v1beta[12]/BackingImageManager) parent_resource=backingimagemanagers.longhorn.io ;;
      longhorn.io/v1beta[12]/BackingImageDataSource) parent_resource=backingimagedatasources.longhorn.io ;;
      longhorn.io/v1beta[12]/ShareManager) parent_resource=sharemanagers.longhorn.io ;;
      longhorn.io/v1beta[12]/SystemRestore) parent_resource=systemrestores.longhorn.io ;;
      longhorn.io/v1beta[12]/SupportBundle) parent_resource=supportbundles.longhorn.io ;;
    esac
    [[ -n "$parent_resource" ]] || continue
    ref_group="${ref_api%/*}"
    [[ "$ref_api" == */* ]] || ref_group=core
    if longhorn_object_has_release_owner "$ns" "$release" "$parent_resource" "$ref_name" "$ref_uid" "$((depth + 1))" "$seen" "$ref_kind" "$ref_group"; then
      if [[ "${KUBETON_LONGHORN_OWNER_CACHE_ACTIVE:-false}" == true ]]; then
        KUBETON_LONGHORN_PROVEN_OWNERS["$cache_key"]="$cache_value"
      fi
      return 0
    fi
  done <<<"$rows"
  return 1
}

storage_namespace_is_release_owned() {
  local ns="$1" release="$2" component="$3"
  local marker resources resource rows name instance release_label helm_release helm_ns app app_name helm_owner helm_name longhorn_owner service_name selector_owner selector_app value namespace_uid
  if ! marker="$(kubectl get namespace "$ns" --ignore-not-found -o name 2>/dev/null)"; then
    echo "Error: cannot inspect storage namespace ${ns}." >&2
    return 1
  fi
  [[ -n "$(trim_whitespace "$marker")" ]] || return 0
  if [[ "${KUBETON_LONGHORN_OWNER_CACHE_ACTIVE:-false}" == true && "$component" == longhorn ]]; then
    if ! namespace_uid="$(kubectl get namespace "$ns" --ignore-not-found -o jsonpath='{.metadata.uid}' 2>/dev/null)" \
      || [[ -z "${KUBETON_LONGHORN_OWNER_CACHE_NAMESPACE_UID:-}" \
        || "$namespace_uid" != "$KUBETON_LONGHORN_OWNER_CACHE_NAMESPACE_UID" ]]; then
      echo "Error: storage namespace ${ns} changed during teardown; refusing to reuse prior ownership evidence." >&2
      return 1
    fi
  fi
  if ! rows="$(storage_list_helm_releases "$ns" 2>/dev/null)"; then
    echo "Error: cannot verify whether storage namespace ${ns} is shared with other Helm releases." >&2
    return 1
  fi
  while IFS= read -r name; do
    [[ -z "$name" || "$name" == "$release" ]] && continue
    echo "Error: retaining shared namespace ${ns}: Helm release ${name} is not ${release}." >&2
    return 1
  done <<<"$rows"
  if ! resources="$(kubectl api-resources --verbs=list,delete --namespaced=true -o name 2>/dev/null)"; then
    echo "Error: cannot inventory namespace ${ns} before forced storage cleanup." >&2
    return 1
  fi
  while IFS= read -r resource; do
    [[ -n "$resource" ]] || continue
    case "$resource" in events|events.events.k8s.io) continue ;; esac
    if ! rows="$(kubectl -n "$ns" get "$resource" --ignore-not-found --no-headers \
        -o custom-columns='NAME:.metadata.name,INSTANCE:.metadata.labels.app\.kubernetes\.io/instance,RELEASE:.metadata.labels.release,HELM:.metadata.annotations.meta\.helm\.sh/release-name,HELMNS:.metadata.annotations.meta\.helm\.sh/release-namespace,APP:.metadata.labels.app,APPNAME:.metadata.labels.app\.kubernetes\.io/name,OWNER:.metadata.labels.owner,HELMNAME:.metadata.labels.name,LONGHORN:.metadata.labels.longhorn\.io/managed-by,SERVICE:.metadata.labels.kubernetes\.io/service-name,SELECTOROWNER:.spec.selector.matchLabels.longhorn\.io/managed-by,SELECTORAPP:.spec.selector.matchLabels.app' 2>/dev/null)"; then
      if [[ "$component" == longhorn ]] && longhorn_resource_api_is_absent "$resource"; then
        continue
      fi
      echo "Error: cannot inspect ${resource} in ${ns}; refusing namespace-wide storage cleanup." >&2
      return 1
    fi
    while read -r name instance release_label helm_release helm_ns app app_name helm_owner helm_name longhorn_owner service_name selector_owner selector_app; do
      [[ -n "$name" ]] || continue
      if [[ "$component" == longhorn ]]; then
        for value in "$instance" "$release_label" "$helm_release"; do
          if [[ -n "$value" && "$value" != '<none>' && "$value" != "$release" ]]; then
            echo "Error: retaining shared namespace ${ns}: ${resource}/${name} belongs to Helm release ${value}, not ${release}." >&2
            return 1
          fi
        done
        if [[ ( -n "$helm_ns" && "$helm_ns" != '<none>' && "$helm_ns" != "$ns" ) \
          || ( "$helm_owner" == helm && -n "$helm_name" && "$helm_name" != '<none>' && "$helm_name" != "$release" ) ]]; then
          echo "Error: retaining shared namespace ${ns}: ${resource}/${name} has conflicting Helm ownership." >&2
          return 1
        fi
      fi
      [[ "$helm_owner" == helm && "$helm_name" == "$release" ]] && continue
      [[ "$instance" == "$release" || "$release_label" == "$release" ]] && continue
      [[ "$helm_release" == "$release" && "$helm_ns" == "$ns" ]] && continue
      case "${resource}/${name}" in
        serviceaccounts/default|configmaps/kube-root-ca.crt) continue ;;
      esac
      if [[ "$component" == vault ]]; then
        # Legacy standalone Vault PVCs and the kubeton initialization Secret
        # predate release labels. Their identities are tied to this release.
        if [[ "$resource" == persistentvolumeclaims && "$name" == "data-${release}-"* && "${name#"data-${release}-"}" =~ ^[0-9]+$ ]]; then continue; fi
        [[ "$resource" == secrets && "$name" == "$VAULT_BOOTSTRAP_SECRET" ]] && continue
      elif [[ "$component" == longhorn ]]; then
        [[ "$resource" == *.longhorn.io || "$longhorn_owner" == longhorn-manager ]] && continue
        if [[ "$resource" == poddisruptionbudgets.policy ]]; then
          [[ "$selector_owner" == longhorn-manager ]] && continue
          case "$selector_app" in csi-attacher|csi-provisioner|csi-resizer|csi-snapshotter) continue ;; esac
        fi
        case "${resource}/${name}" in
          secrets/longhorn-webhook-ca|secrets/longhorn-webhook-tls|secrets/longhorn-grpc-tls|leases.coordination.k8s.io/longhorn-manager-upgrade-lock|leases.coordination.k8s.io/longhorn-manager-webhook-lock|leases.coordination.k8s.io/driver-longhorn-io|leases.coordination.k8s.io/external-attacher-leader-driver-longhorn-io|leases.coordination.k8s.io/external-resizer-driver-longhorn-io|leases.coordination.k8s.io/external-snapshotter-leader-driver-longhorn-io) continue ;;
        esac
        if [[ "$resource" == endpointslices.discovery.k8s.io ]]; then
          case "$service_name" in longhorn-admission-webhook|longhorn-conversion-webhook|longhorn-recovery-backend) continue ;; esac
        fi
        case "$app" in
          longhorn-manager|longhorn-driver-deployer|longhorn-ui|csi-attacher|csi-provisioner|csi-resizer|csi-snapshotter|longhorn-csi-plugin) continue ;;
        esac
        [[ "$app_name" == longhorn ]] && continue
        [[ "$resource" == secrets && "$name" == "$LONGHORN_CRYPTO_SECRET_NAME" ]] && continue
        if longhorn_object_has_release_owner "$ns" "$release" "$resource" "$name"; then
          continue
        fi
      fi
      echo "Error: retaining shared namespace ${ns}: ownership of ${resource}/${name} by ${release} is not proven." >&2
      return 1
    done <<<"$rows"
  done <<<"$resources"
}

longhorn_storage_is_unused() {
  local rows marker name driver ns claim sc provisioner
  local -A classes=()
  if ! rows="$(kubectl get daemonsets -A -l app=longhorn-manager --no-headers -o custom-columns='NS:.metadata.namespace,NAME:.metadata.name' 2>/dev/null)"; then
    echo "Error: cannot inspect Longhorn managers before uninstall." >&2
    return 1
  fi
  while read -r ns name; do
    if [[ -n "$ns" && "$ns" != "$LONGHORN_NAMESPACE" ]]; then
      echo "Error: retaining shared Longhorn infrastructure: manager ${ns}/${name} is outside ${LONGHORN_NAMESPACE}." >&2
      return 1
    fi
  done <<<"$rows"
  if ! rows="$(kubectl get pv --no-headers -o custom-columns='NAME:.metadata.name,DRIVER:.spec.csi.driver' 2>/dev/null)"; then
    echo "Error: cannot inspect PersistentVolumes before Longhorn uninstall." >&2
    return 1
  fi
  while read -r name driver; do
    if [[ "$driver" == driver.longhorn.io ]]; then
      echo "Error: retaining Longhorn: PersistentVolume ${name} still uses it. Remove only the intended claims and retry." >&2
      return 1
    fi
  done <<<"$rows"
  if ! rows="$(kubectl get storageclass --no-headers -o custom-columns='NAME:.metadata.name,PROVISIONER:.provisioner' 2>/dev/null)"; then
    echo "Error: cannot inspect StorageClasses before Longhorn uninstall." >&2
    return 1
  fi
  while read -r sc provisioner; do
    [[ "$provisioner" == driver.longhorn.io ]] && classes["$sc"]=1
  done <<<"$rows"
  if ! rows="$(kubectl get pvc -A --no-headers -o custom-columns='NS:.metadata.namespace,NAME:.metadata.name,CLASS:.spec.storageClassName' 2>/dev/null)"; then
    echo "Error: cannot inspect PersistentVolumeClaims before Longhorn uninstall." >&2
    return 1
  fi
  while read -r ns claim sc; do
    if [[ -n "$sc" && -n "${classes[$sc]:-}" ]]; then
      echo "Error: retaining Longhorn: PVC ${ns}/${claim} still requests Longhorn storage." >&2
      return 1
    fi
  done <<<"$rows"
  if ! marker="$(kubectl get crd volumes.longhorn.io --ignore-not-found -o name 2>/dev/null)"; then
    echo "Error: cannot inspect the Longhorn volume API before uninstall." >&2
    return 1
  fi
  [[ -n "$(trim_whitespace "$marker")" ]] || return 0
  if ! rows="$(kubectl get volumes.longhorn.io -A -o name 2>/dev/null)"; then
    echo "Error: cannot verify that Longhorn backend volumes are gone." >&2
    return 1
  fi
  if [[ -n "$(trim_whitespace "$rows")" ]]; then
    echo "Error: retaining Longhorn while backend volumes remain; deleting its CRDs could strand or destroy shared storage." >&2
    return 1
  fi
}

collect_storage_release_cluster_rows() {
  local component="$1" release="$2" ns="$3" rows_name="$4"
  local -n cluster_rows_ref="$rows_name"
  local rows kind name owner owner_ns marker reference other_manager=0
  if ! rows="$(kubectl get clusterrole,clusterrolebinding,csidriver,validatingwebhookconfiguration,mutatingwebhookconfiguration,storageclass,priorityclass --no-headers \
      -o custom-columns='KIND:.kind,NAME:.metadata.name,RELEASE:.metadata.annotations.meta\.helm\.sh/release-name,NS:.metadata.annotations.meta\.helm\.sh/release-namespace' 2>/dev/null)"; then
    echo "Error: cannot inventory cluster resources for storage release ${ns}/${release}." >&2
    return 1
  fi
  while read -r kind name owner owner_ns; do
    [[ "$owner" == "$release" && "$owner_ns" == "$ns" ]] || continue
    append_unique_item "${kind}/${name}" cluster_rows_ref
  done <<<"$rows"
  [[ "$component" == longhorn ]] || return 0

  if ! rows="$(kubectl get daemonsets -A -l app=longhorn-manager --no-headers -o custom-columns='NS:.metadata.namespace,NAME:.metadata.name' 2>/dev/null)"; then return 1; fi
  while read -r owner_ns name; do
    [[ -z "$owner_ns" || "$owner_ns" == "$ns" ]] || other_manager=1
  done <<<"$rows"
  # These objects are created dynamically without Helm annotations in 1.10.
  # Another installation's manager excludes them from this release's scope.
  (( other_manager == 0 )) || return 0
  if ! marker="$(kubectl get csidriver driver.longhorn.io --ignore-not-found -o name 2>/dev/null)"; then return 1; fi
  [[ -z "$(trim_whitespace "$marker")" ]] || append_unique_item "${marker}" cluster_rows_ref
  for name in longhorn longhorn-static; do
    if ! marker="$(kubectl get storageclass "$name" --ignore-not-found -o jsonpath='{.provisioner}' 2>/dev/null)"; then return 1; fi
    [[ "$marker" != driver.longhorn.io ]] || append_unique_item "storageclass/${name}" cluster_rows_ref
  done
  for kind in validatingwebhookconfiguration mutatingwebhookconfiguration; do
    if [[ "$kind" == validatingwebhookconfiguration ]]; then name=longhorn-webhook-validator; else name=longhorn-webhook-mutator; fi
    if ! rows="$(kubectl get "$kind" "$name" --ignore-not-found \
        -o jsonpath='{range .webhooks[*]}{.clientConfig.service.namespace}{"\n"}{end}' 2>/dev/null)"; then return 1; fi
    marker=0
    while IFS= read -r reference; do
      [[ -n "$reference" ]] || continue
      if [[ "$reference" != "$ns" ]]; then marker=2; break; fi
      marker=1
    done <<<"$rows"
    (( marker != 1 )) || append_unique_item "${kind}/${name}" cluster_rows_ref
  done
}

cleanup_vault_force() {
  local marker resources resource rows object rc=0
  local -a cluster_rows=()
  echo "[uninstall] Cleaning remaining Vault release resources ..."
  if ! marker="$(kubectl get namespace "$VAULT_NAMESPACE" --ignore-not-found -o name 2>/dev/null)"; then
    echo "Error: cannot inspect Vault namespace ${VAULT_NAMESPACE}." >&2
    return 1
  fi
  if [[ -z "$(trim_whitespace "$marker")" ]]; then
    collect_storage_release_cluster_rows vault "$VAULT_RELEASE_NAME" "$VAULT_NAMESPACE" cluster_rows || return 1
    for object in "${cluster_rows[@]}"; do
      kubectl delete "$object" --ignore-not-found --wait=false >/dev/null 2>&1 || rc=1
    done
    return "$rc"
  fi
  storage_namespace_is_release_owned "$VAULT_NAMESPACE" "$VAULT_RELEASE_NAME" vault || return 1
  if declare -F refuse_guarded_namespace_deletion_if_needed >/dev/null \
      && refuse_guarded_namespace_deletion_if_needed "$VAULT_NAMESPACE"; then
    return 1
  fi

  # Ownership was checked before removing any namespace-wide resources.
  kubectl -n "$VAULT_NAMESPACE" delete statefulset "$VAULT_RELEASE_NAME" --ignore-not-found --wait=false >/dev/null 2>&1 || rc=1
  kubectl -n "$VAULT_NAMESPACE" delete pod --all --ignore-not-found --grace-period=0 --force >/dev/null 2>&1 || rc=1
  if ! delete_vault_pvcs_and_backing_volumes; then
    echo "Error: Vault backing storage cleanup did not complete; keeping ${VAULT_NAMESPACE} for a safe retry." >&2
    return 1
  fi
  (( rc == 0 )) || return "$rc"
  if ! resources="$(kubectl api-resources --verbs=list,delete --namespaced=true -o name 2>/dev/null)"; then return 1; fi
  for resource in $resources; do
    if ! rows="$(kubectl -n "$VAULT_NAMESPACE" get "$resource" -o name 2>/dev/null)"; then rc=1; continue; fi
    while IFS= read -r object; do
      [[ -n "$object" ]] || continue
      kubectl -n "$VAULT_NAMESPACE" patch "$object" --type=merge -p '{"metadata":{"finalizers":[]}}' >/dev/null 2>&1 || rc=1
    done <<<"$rows"
    kubectl -n "$VAULT_NAMESPACE" delete "$resource" --all --ignore-not-found --wait=false >/dev/null 2>&1 || rc=1
  done
  collect_storage_release_cluster_rows vault "$VAULT_RELEASE_NAME" "$VAULT_NAMESPACE" cluster_rows || return 1
  for object in "${cluster_rows[@]}"; do
    kubectl delete "$object" --ignore-not-found --wait=false >/dev/null 2>&1 || rc=1
  done
  return "$rc"
}

recover_stuck_vault_namespace() {
  local phase
  if ! kubectl get namespace "$VAULT_NAMESPACE" >/dev/null 2>&1; then
    return 0
  fi

  phase="$(kubectl get namespace "$VAULT_NAMESPACE" -o jsonpath='{.status.phase}' 2>/dev/null || true)"
  if [[ "$phase" != "Terminating" ]]; then
    return 0
  fi

  echo "[baremetal] Namespace ${VAULT_NAMESPACE} is Terminating; cleaning stuck Vault pods/PVC/finalizers ..."
  cleanup_vault_force
}

delete_namespace_with_progress() {
  local ns="$1"
  local timeout_seconds="${2:-$NAMESPACE_DELETE_PROGRESS_TIMEOUT}"
  local start_ts now_ts elapsed phase pods marker
  local force_attempts=0
  local max_force_attempts=3

  if ! marker="$(kubectl get namespace "$ns" --ignore-not-found -o name 2>/dev/null)"; then
    echo "Error: cannot inspect namespace ${ns} before deletion." >&2
    return 1
  fi
  if [[ -z "$(trim_whitespace "$marker")" ]]; then
    echo "[uninstall] Namespace ${ns} already absent."
    return 0
  fi

  # Some bootstrap recovery callers also use this helper after a failed
  # cleanup attempt. Recheck storage ownership here so a swallowed caller
  # error cannot turn into deletion of a shared namespace.
  if [[ "$ns" == "$LONGHORN_NAMESPACE" ]]; then
    longhorn_storage_is_unused || return 1
    storage_namespace_is_release_owned "$ns" "$LONGHORN_RELEASE_NAME" longhorn || return 1
  elif [[ "$ns" == "$VAULT_NAMESPACE" ]]; then
    storage_namespace_is_release_owned "$ns" "$VAULT_RELEASE_NAME" vault || return 1
  fi
  if declare -F refuse_guarded_namespace_deletion_if_needed >/dev/null \
      && refuse_guarded_namespace_deletion_if_needed "$ns"; then
    return 1
  fi

  echo "[uninstall] Deleting namespace ${ns} ..."
  if ! kubectl delete namespace "$ns" --ignore-not-found --wait=false >/dev/null 2>&1; then
    echo "Error: failed to request deletion of namespace ${ns}." >&2
    return 1
  fi

  start_ts="$(date +%s)"
  while true; do
    if ! marker="$(kubectl get namespace "$ns" --ignore-not-found -o name 2>/dev/null)"; then
      echo "Error: cannot verify deletion of namespace ${ns}; retry cleanup when the Kubernetes API is reachable." >&2
      return 1
    fi
    [[ -n "$(trim_whitespace "$marker")" ]] || break
    now_ts="$(date +%s)"
    elapsed=$((now_ts - start_ts))
    phase="$(kubectl get namespace "$ns" -o jsonpath='{.status.phase}' 2>/dev/null || true)"
    pods="$(kubectl -n "$ns" get pods --no-headers 2>/dev/null | awk 'NF{c++} END{print c+0}')" || pods=unknown
    echo "[progress] namespace ${ns}: phase=${phase:-unknown}, pods=${pods:-unknown} (elapsed ${elapsed}s)"

    if (( elapsed >= timeout_seconds )); then
      if (( force_attempts >= max_force_attempts )); then
        echo "Error: namespace ${ns} still exists after ${max_force_attempts} forced cleanup attempts; uninstall is incomplete." >&2
        return 1
      fi
      ((force_attempts+=1))
      echo "Warning: namespace ${ns} still exists after ${timeout_seconds}s; retrying cleanup." >&2
      if [[ "$ns" == "$LONGHORN_NAMESPACE" ]]; then
        cleanup_longhorn_force || return 1
      elif [[ "$ns" == "$VAULT_NAMESPACE" ]]; then
        cleanup_vault_force || return 1
      else
        kubectl patch namespace "$ns" --type=merge -p '{"spec":{"finalizers":[]}}' >/dev/null 2>&1 || return 1
        kubectl delete namespace "$ns" --ignore-not-found --wait=false >/dev/null 2>&1 || return 1
      fi
      start_ts="$(date +%s)"
    fi
    sleep 10
  done

  echo "[uninstall] Namespace ${ns} removed."
  return 0
}

run_with_namespace_progress() {
  local label="$1"
  local ns="$2"
  shift 2

  "$@" &
  local cmd_pid=$!
  local start_ts now_ts elapsed pods total ready
  start_ts="$(date +%s)"

  while kill -0 "$cmd_pid" >/dev/null 2>&1; do
    sleep 10
    if ! kill -0 "$cmd_pid" >/dev/null 2>&1; then
      break
    fi
    now_ts="$(date +%s)"
    elapsed=$((now_ts - start_ts))
    pods="$(kubectl -n "$ns" get pods --no-headers 2>/dev/null || true)"
    if [[ -n "$pods" ]]; then
      total="$(printf '%s\n' "$pods" | awk 'NF{c++} END{print c+0}')"
      ready="$(printf '%s\n' "$pods" | awk 'NF{split($2,a,"/"); if (a[1]==a[2]) c++} END{print c+0}')"
      echo "[progress] ${label}: ${ready}/${total} pods ready (elapsed ${elapsed}s)"
    else
      echo "[progress] ${label}: waiting for first pods (elapsed ${elapsed}s)"
    fi
  done

  wait "$cmd_pid"
}

longhorn_release_status() {
  helm status "$LONGHORN_RELEASE_NAME" -n "$LONGHORN_NAMESPACE" 2>/dev/null \
    | awk -F': ' '/^STATUS:/ {print tolower($2); exit}'
}

longhorn_latest_deployed_revision() {
  helm history "$LONGHORN_RELEASE_NAME" -n "$LONGHORN_NAMESPACE" 2>/dev/null \
    | awk '$1 ~ /^[0-9]+$/ && $0 ~ /[[:space:]]deployed[[:space:]]/ {rev=$1} END{if (rev != "") print rev}'
}

longhorn_daemonset_ready_quick() {
  local name="$1"
  local desired ready updated

  if ! kubectl -n "$LONGHORN_NAMESPACE" get daemonset "$name" >/dev/null 2>&1; then
    return 1
  fi

  desired="$(kubectl -n "$LONGHORN_NAMESPACE" get daemonset "$name" -o jsonpath='{.status.desiredNumberScheduled}' 2>/dev/null || true)"
  ready="$(kubectl -n "$LONGHORN_NAMESPACE" get daemonset "$name" -o jsonpath='{.status.numberReady}' 2>/dev/null || true)"
  updated="$(kubectl -n "$LONGHORN_NAMESPACE" get daemonset "$name" -o jsonpath='{.status.updatedNumberScheduled}' 2>/dev/null || true)"

  [[ "$desired" =~ ^[0-9]+$ && "$ready" =~ ^[0-9]+$ && "$updated" =~ ^[0-9]+$ ]] || return 1
  (( desired > 0 && ready == desired && updated == desired ))
}

longhorn_deployment_ready_quick() {
  local name="$1"
  local desired available updated

  if ! kubectl -n "$LONGHORN_NAMESPACE" get deployment "$name" >/dev/null 2>&1; then
    return 1
  fi

  desired="$(kubectl -n "$LONGHORN_NAMESPACE" get deployment "$name" -o jsonpath='{.spec.replicas}' 2>/dev/null || true)"
  available="$(kubectl -n "$LONGHORN_NAMESPACE" get deployment "$name" -o jsonpath='{.status.availableReplicas}' 2>/dev/null || true)"
  updated="$(kubectl -n "$LONGHORN_NAMESPACE" get deployment "$name" -o jsonpath='{.status.updatedReplicas}' 2>/dev/null || true)"
  [[ -z "$desired" ]] && desired="1"
  [[ -z "$available" ]] && available="0"
  [[ -z "$updated" ]] && updated="0"

  [[ "$desired" =~ ^[0-9]+$ && "$available" =~ ^[0-9]+$ && "$updated" =~ ^[0-9]+$ ]] || return 1
  (( available >= desired && updated >= desired ))
}

longhorn_storage_ready_quick() {
  local storage_class="${1:-longhorn}"
  local provisioner expected_ready csi_nodes_count dep

  provisioner="$(storage_class_provisioner "$storage_class")"
  [[ "$provisioner" == "driver.longhorn.io" ]] || return 1

  longhorn_daemonset_ready_quick longhorn-manager || return 1
  longhorn_daemonset_ready_quick longhorn-csi-plugin || return 1

  for dep in csi-attacher csi-provisioner csi-resizer csi-snapshotter longhorn-driver-deployer; do
    longhorn_deployment_ready_quick "$dep" || return 1
  done

  expected_ready="$(kubectl -n "$LONGHORN_NAMESPACE" get daemonset longhorn-csi-plugin -o jsonpath='{.status.desiredNumberScheduled}' 2>/dev/null || true)"
  csi_nodes_count="$(list_longhorn_csi_node_names | awk 'NF{c++} END{print c+0}')"
  [[ "$expected_ready" =~ ^[0-9]+$ && "$csi_nodes_count" =~ ^[0-9]+$ ]] || return 1
  (( expected_ready > 0 && csi_nodes_count >= expected_ready ))
}

longhorn_release_metadata_present() {
  local count
  count="$(kubectl -n "$LONGHORN_NAMESPACE" get secret,configmap -l "owner=helm,name=${LONGHORN_RELEASE_NAME}" --no-headers 2>/dev/null | awk 'NF{c++} END{print c+0}' || true)"
  [[ "${count:-0}" != "0" ]]
}

storage_class_provisioner() {
  local storage_class="$1"
  kubectl get storageclass "$storage_class" -o jsonpath='{.provisioner}' 2>/dev/null | tr -d '[:space:]'
}

storage_class_is_longhorn() {
  local storage_class="$1"
  [[ "$(storage_class_provisioner "$storage_class")" == "driver.longhorn.io" ]]
}

longhorn_selector_to_kubectl_selector() {
  local selector="$1"
  local -a selector_pairs=()
  local kubectl_selector=""
  local pair

  parse_selector_pairs "$selector" selector_pairs || return 1
  for pair in "${selector_pairs[@]}"; do
    if [[ -n "$kubectl_selector" ]]; then
      kubectl_selector+=","
    fi
    kubectl_selector+="$pair"
  done
  printf '%s' "$kubectl_selector"
}

wait_longhorn_storage_ready() {
  local storage_class="${1:-longhorn}"
  local timeout_seconds="${2:-$KUBETON_LONGHORN_READY_TIMEOUT_SECONDS}"
  local deadline=$(( $(date +%s) + timeout_seconds ))
  local provisioner=""
  local expected_ready=0
  local csi_nodes_count=0
  local dep

  echo "[baremetal] Waiting for Longhorn CSI/storage readiness (timeout ${timeout_seconds}s) ..."

  while (( $(date +%s) < deadline )); do
    provisioner="$(storage_class_provisioner "$storage_class")"
    if [[ "$provisioner" == "driver.longhorn.io" ]]; then
      break
    fi
    sleep 2
  done
  if [[ "$provisioner" != "driver.longhorn.io" ]]; then
    echo "Error: StorageClass ${storage_class} is not available with Longhorn provisioner driver.longhorn.io." >&2
    return 1
  fi

  if kubectl -n "$LONGHORN_NAMESPACE" get daemonset longhorn-manager >/dev/null 2>&1; then
    kubectl -n "$LONGHORN_NAMESPACE" rollout status daemonset/longhorn-manager --timeout="${timeout_seconds}s" >/dev/null || return $?
  fi

  while (( $(date +%s) < deadline )); do
    if kubectl -n "$LONGHORN_NAMESPACE" get daemonset longhorn-csi-plugin >/dev/null 2>&1; then
      break
    fi
    sleep 2
  done
  if ! kubectl -n "$LONGHORN_NAMESPACE" get daemonset longhorn-csi-plugin >/dev/null 2>&1; then
    echo "Error: Longhorn CSI daemonset ${LONGHORN_NAMESPACE}/longhorn-csi-plugin was not created." >&2
    return 1
  fi
  kubectl -n "$LONGHORN_NAMESPACE" rollout status daemonset/longhorn-csi-plugin --timeout="${timeout_seconds}s" >/dev/null || return $?

  for dep in csi-attacher csi-provisioner csi-resizer csi-snapshotter longhorn-driver-deployer; do
    if kubectl -n "$LONGHORN_NAMESPACE" get deployment "$dep" >/dev/null 2>&1; then
      kubectl -n "$LONGHORN_NAMESPACE" rollout status "deployment/${dep}" --timeout="${timeout_seconds}s" >/dev/null || return $?
    fi
  done

  while (( $(date +%s) < deadline )); do
    expected_ready="$(kubectl -n "$LONGHORN_NAMESPACE" get daemonset longhorn-csi-plugin -o jsonpath='{.status.desiredNumberScheduled}' 2>/dev/null || true)"
    csi_nodes_count="$(list_longhorn_csi_node_names | awk 'NF{c++} END{print c+0}')"
    if [[ "${expected_ready:-0}" != "0" && "${csi_nodes_count:-0}" -ge "${expected_ready:-0}" ]]; then
      verify_longhorn_multipathd_safe || return $?
      return 0
    fi
    sleep 2
  done

  echo "Error: timeout waiting for Longhorn CSI registration in CSINode objects (${csi_nodes_count:-0}/${expected_ready:-0})." >&2
  return 1
}

longhorn_setting_value_matches() {
  local current_value="$1"
  local desired_value="$2"
  local compact_current

  current_value="$(trim_whitespace "$current_value")"
  desired_value="$(trim_whitespace "$desired_value")"
  if [[ "$current_value" == "$desired_value" ]]; then
    return 0
  fi

  # Longhorn 1.10 can normalize some numeric settings into a v1/v2 JSON string,
  # for example default-replica-count: {"v1":"3","v2":"3"}.
  if [[ "$desired_value" =~ ^[0-9]+$ ]]; then
    compact_current="${current_value//[[:space:]]/}"
    if [[ "$compact_current" == "{\"v1\":\"${desired_value}\",\"v2\":\"${desired_value}\"}" ]] \
      || [[ "$compact_current" == "{\"v2\":\"${desired_value}\",\"v1\":\"${desired_value}\"}" ]] \
      || [[ "$compact_current" == "{\"v1\":${desired_value},\"v2\":${desired_value}}" ]] \
      || [[ "$compact_current" == "{\"v2\":${desired_value},\"v1\":${desired_value}}" ]]; then
      return 0
    fi
  fi

  return 1
}

apply_longhorn_setting_value() {
  local setting_name="$1"
  local desired_value="$2"
  local timeout_seconds="${3:-120}"
  local deadline=$(( $(date +%s) + timeout_seconds ))
  local current_value escaped_desired

  setting_name="$(trim_whitespace "$setting_name")"
  desired_value="$(trim_whitespace "$desired_value")"
  if [[ -z "$setting_name" ]]; then
    echo "Error: internal Longhorn setting name is empty." >&2
    return 1
  fi

  while (( $(date +%s) < deadline )); do
    current_value="$(kubectl -n "$LONGHORN_NAMESPACE" get settings.longhorn.io "$setting_name" -o jsonpath='{.value}' 2>/dev/null || true)"
    current_value="$(trim_whitespace "$current_value")"
    if longhorn_setting_value_matches "$current_value" "$desired_value"; then
      return 0
    fi

    escaped_desired="$(json_escape_string "$desired_value")"
    if kubectl -n "$LONGHORN_NAMESPACE" patch settings.longhorn.io "$setting_name" --type=merge \
      -p "{\"value\":\"${escaped_desired}\"}" >/dev/null 2>&1; then
      current_value="$(kubectl -n "$LONGHORN_NAMESPACE" get settings.longhorn.io "$setting_name" -o jsonpath='{.value}' 2>/dev/null || true)"
      current_value="$(trim_whitespace "$current_value")"
      if longhorn_setting_value_matches "$current_value" "$desired_value"; then
        return 0
      fi
    else
      sleep 2
      continue
    fi
    sleep 2
  done

  current_value="$(kubectl -n "$LONGHORN_NAMESPACE" get settings.longhorn.io "$setting_name" -o jsonpath='{.value}' 2>/dev/null || true)"
  current_value="$(trim_whitespace "$current_value")"
  echo "Error: timeout setting Longhorn ${setting_name}=${desired_value}; current value is '${current_value:-unknown}'." >&2
  return 1
}

apply_longhorn_post_start_settings() {
  local system_managed_selector_value="${1:-}"

  if [[ "$LONGHORN_DEFAULT_REPLICA_COUNT" =~ ^[0-9]+$ ]]; then
    echo "[baremetal] Setting Longhorn default-replica-count=${LONGHORN_DEFAULT_REPLICA_COUNT} after manager startup ..."
    apply_longhorn_setting_value "default-replica-count" "$LONGHORN_DEFAULT_REPLICA_COUNT" || return 1
  fi

  system_managed_selector_value="$(trim_whitespace "$system_managed_selector_value")"
  if [[ -n "$system_managed_selector_value" ]]; then
    echo "[baremetal] Setting Longhorn system-managed-components-node-selector after manager startup ..."
    apply_longhorn_setting_value "system-managed-components-node-selector" "$system_managed_selector_value" || return 1
  fi
}

selector_pairs_to_json_object() {
  local selector="$1"
  local -a selector_pairs=()
  local pair key value json_object="" first=1

  parse_selector_pairs "$selector" selector_pairs || return 1
  [[ ${#selector_pairs[@]} -gt 0 ]] || return 1
  json_object="{"
  for pair in "${selector_pairs[@]}"; do
    key="${pair%%=*}"
    value="${pair#*=}"
    (( first == 1 )) || json_object+=","
    json_object+="$(json_quote "$key"):$(json_quote "$value")"
    first=0
  done
  json_object+="}"
  printf '%s' "$json_object"
}

patch_longhorn_daemonset_node_selector() {
  local daemonset="$1"
  local selector="$2"
  local selector_json patch

  selector_json="$(selector_pairs_to_json_object "$selector")" || return 1
  patch="{\"spec\":{\"template\":{\"spec\":{\"nodeSelector\":${selector_json}}}}}"
  kubectl -n "$LONGHORN_NAMESPACE" patch daemonset "$daemonset" --type=merge -p "$patch" >/dev/null
}

ensure_longhorn_daemonsets_constrained() {
  local selector="$1"
  local timeout_seconds="${2:-180}"
  local deadline=$(( $(date +%s) + timeout_seconds ))
  local daemonset actual_selector all_constrained mismatch_since=0 now
  local -a selector_validation_pairs=()
  local -A patched=()

  selector="$(trim_whitespace "$selector")"
  [[ -n "$selector" ]] || return 0
  parse_selector_pairs "$selector" selector_validation_pairs || return 1

  while (( $(date +%s) < deadline )); do
    all_constrained=1
    for daemonset in longhorn-manager longhorn-csi-plugin; do
      if ! longhorn_daemonset_exists "$daemonset"; then
        all_constrained=0
        continue
      fi
      actual_selector="$(longhorn_daemonset_node_selector "$daemonset" || true)"
      if selector_contains_selector_pairs "$actual_selector" "$selector"; then
        continue
      fi
      all_constrained=0
      now="$(date +%s)"
      if (( mismatch_since == 0 )); then
        mismatch_since="$now"
      fi
      # Let Longhorn reconcile the Setting first. A direct DaemonSet patch is
      # only a no-volume recovery fallback for a previously failed install.
      if (( now - mismatch_since >= 15 )) \
        && [[ -z "${patched[$daemonset]:-}" ]] \
        && longhorn_placement_may_be_reconfigured; then
        echo "[baremetal] Repairing Longhorn ${daemonset} placement selector before storage readiness ..."
        patch_longhorn_daemonset_node_selector "$daemonset" "$selector" || return 1
        patched["$daemonset"]=1
      fi
    done
    (( all_constrained == 1 )) && return 0
    sleep 2
  done

  echo "Error: Longhorn manager/CSI DaemonSets did not adopt LONGHORN_NODE_SELECTOR='${selector}'." >&2
  echo "Refusing to wait for CSI on nodes excluded by the kubeton preflight." >&2
  return 1
}

verify_longhorn_multipathd_safe() {
  if ! is_true "$KUBETON_FAIL_ON_LONGHORN_MULTIPATHD"; then
    return 0
  fi
  if ! kubectl get namespace "$LONGHORN_NAMESPACE" >/dev/null 2>&1; then
    return 0
  fi
  if ! kubectl -n "$LONGHORN_NAMESPACE" get nodes.longhorn.io >/dev/null 2>&1; then
    return 0
  fi

  local selector=""
  local selected_count=0
  local node status reason message row
  local -A selected_nodes=()
  local -a bad_nodes=()

  if [[ -n "${LONGHORN_NODE_SELECTOR:-}" ]]; then
    selector="$(longhorn_selector_to_kubectl_selector "$LONGHORN_NODE_SELECTOR")" || return 1
    while IFS= read -r node; do
      node="$(trim_whitespace "$node")"
      [[ -z "$node" ]] && continue
      selected_nodes["$node"]=1
      ((selected_count+=1))
    done < <(list_schedulable_nodes_by_selector "$selector" || true)
    if (( selected_count == 0 )); then
      echo "Error: LONGHORN_NODE_SELECTOR='${LONGHORN_NODE_SELECTOR}' matched no schedulable Kubernetes nodes." >&2
      echo "Cordoned nodes are ignored for Vault/TON mount preflight because workloads cannot schedule there." >&2
      return 1
    fi
  fi

  while IFS=$'\t' read -r node status reason message; do
    node="$(trim_whitespace "$node")"
    status="$(trim_whitespace "$status")"
    reason="$(trim_whitespace "$reason")"
    message="$(trim_whitespace "$message")"
    [[ -z "$node" ]] && continue
    if (( selected_count > 0 )) && [[ -z "${selected_nodes[$node]:-}" ]]; then
      continue
    fi
    if [[ "$status" == "False" || "$reason" == "MultipathdIsRunning" ]]; then
      row="$node"
      [[ -n "$reason" ]] && row+=" (${reason})"
      [[ -n "$message" ]] && row+=": ${message}"
      bad_nodes+=("$row")
    fi
  done < <(
    kubectl -n "$LONGHORN_NAMESPACE" get nodes.longhorn.io \
      -o go-template='{{range .items}}{{ $node := .metadata.name }}{{range .status.conditions}}{{if eq .type "Multipathd"}}{{$node}}{{"\t"}}{{.status}}{{"\t"}}{{.reason}}{{"\t"}}{{.message}}{{"\n"}}{{end}}{{end}}{{end}}' 2>/dev/null || true
  )

  if [[ ${#bad_nodes[@]} -eq 0 ]]; then
    return 0
  fi

  echo "Error: Longhorn reports multipathd running on selected storage node(s)." >&2
  printf '  - %s\n' "${bad_nodes[@]}" >&2
  echo "Longhorn volumes can be claimed by multipathd and fail first mount with:" >&2
  echo "  /dev/longhorn/pvc-* is apparently in use by the system; will not make a filesystem here" >&2
  echo "Fix the host OS before running kubeton start: disable multipathd if unused, or blacklist Longhorn devices in /etc/multipath.conf." >&2
  echo "Temporary bypass: KUBETON_FAIL_ON_LONGHORN_MULTIPATHD=false, but Vault/TON mounts may fail." >&2
  return 1
}

repair_stale_longhorn_release() {
  local status="$1"
  local reason

  if [[ -n "$status" ]]; then
    reason="status=${status}"
  else
    reason="orphaned_helm_metadata"
  fi

  if ! is_true "$ALLOW_DESTRUCTIVE_LONGHORN_REPAIR"; then
    echo "Error: detected stale Longhorn release (${reason}), but destructive auto-repair is disabled." >&2
    echo "Refusing to delete Longhorn resources during start/bootstrap." >&2
    echo "If you really want this automatic cleanup, rerun with: ALLOW_DESTRUCTIVE_LONGHORN_REPAIR=true ./kubeton start" >&2
    return 1
  fi

  if [[ -n "$status" ]]; then
    echo "[baremetal] Longhorn Helm release is in state '${status}', resetting stale release state ..."
  else
    echo "[baremetal] Longhorn Helm metadata exists without a healthy deployed release; resetting stale release state ..."
  fi

  # Uninstall hook can fail when deleting-confirmation-flag is false.
  helm uninstall "$LONGHORN_RELEASE_NAME" -n "$LONGHORN_NAMESPACE" --no-hooks >/dev/null 2>&1 || true
  kubectl -n "$LONGHORN_NAMESPACE" delete secret,configmap -l "owner=helm,name=${LONGHORN_RELEASE_NAME}" --ignore-not-found >/dev/null 2>&1 || true
  cleanup_longhorn_force || true
}

recover_longhorn_release_non_destructive() {
  local status="$1"
  local deployed_revision post_status

  case "$status" in
    failed|pending-install|pending-upgrade|pending-rollback) ;;
    *) return 1 ;;
  esac

  deployed_revision="$(longhorn_latest_deployed_revision || true)"
  deployed_revision="$(trim_whitespace "$deployed_revision")"
  if [[ -z "$deployed_revision" ]]; then
    echo "Warning: Longhorn Helm release is '${status}', but no deployed revision was found for non-destructive recovery." >&2
    return 1
  fi

  echo "[baremetal] Longhorn Helm release is '${status}'; rolling back to deployed revision ${deployed_revision} ..."
  if ! helm rollback "$LONGHORN_RELEASE_NAME" "$deployed_revision" -n "$LONGHORN_NAMESPACE" --wait --timeout 20m; then
    echo "Warning: non-destructive Longhorn rollback to revision ${deployed_revision} failed." >&2
    return 1
  fi

  post_status="$(longhorn_release_status || true)"
  if [[ "$post_status" != "deployed" ]]; then
    echo "Warning: Longhorn rollback completed but Helm status is '${post_status:-unknown}', not deployed." >&2
    return 1
  fi

  return 0
}

ensure_longhorn_installed() {
  require_bin helm
  require_bin kubectl
  if [[ ! "$LONGHORN_CHART_VERSION" =~ ^1\. ]]; then
    echo "Error: LONGHORN_CHART_VERSION must be a v1.x release, got: $LONGHORN_CHART_VERSION" >&2
    exit 1
  fi

  recover_stuck_longhorn_namespace || return $?

  # Previous failed uninstall can leave namespace in Terminating state.
  # Helm install cannot create release secrets there until namespace recovers.
  ensure_namespace_not_terminating "$LONGHORN_NAMESPACE" 240 || return $?

  local lh_status=""
  lh_status="$(longhorn_release_status || true)"
  if [[ -n "$lh_status" && "$lh_status" != "deployed" ]]; then
    if recover_longhorn_release_non_destructive "$lh_status"; then
      lh_status="$(longhorn_release_status || true)"
    else
      repair_stale_longhorn_release "$lh_status" || return $?
      recover_stuck_longhorn_namespace || return $?
      ensure_namespace_not_terminating "$LONGHORN_NAMESPACE" 240 || return $?
      lh_status="$(longhorn_release_status || true)"
    fi
  elif [[ -z "$lh_status" ]] && kubectl get namespace "$LONGHORN_NAMESPACE" >/dev/null 2>&1 && longhorn_release_metadata_present; then
    repair_stale_longhorn_release "" || return $?
    recover_stuck_longhorn_namespace || return $?
    ensure_namespace_not_terminating "$LONGHORN_NAMESPACE" 240 || return $?
  fi

  local -a longhorn_selector_pairs=()
  local longhorn_system_managed_selector_setting=""
  if [[ -n "${LONGHORN_NODE_SELECTOR:-}" ]]; then
    parse_selector_pairs "$LONGHORN_NODE_SELECTOR" longhorn_selector_pairs || return 1
    if [[ ${#longhorn_selector_pairs[@]} -eq 0 ]]; then
      echo "Error: LONGHORN_NODE_SELECTOR is set but has no valid key=value pairs." >&2
      return 1
    fi
    longhorn_system_managed_selector_setting="$(selector_pairs_to_longhorn_setting longhorn_selector_pairs)"
  fi

  if [[ "$lh_status" == "deployed" ]] \
    && ! is_true "$KUBETON_LONGHORN_PLACEMENT_RECONFIGURE" \
    && is_true "$KUBETON_SKIP_LONGHORN_HELM_UPGRADE_WHEN_READY" \
    && longhorn_storage_ready_quick "longhorn"; then
    apply_longhorn_post_start_settings "$longhorn_system_managed_selector_setting" || return 1
    ensure_longhorn_daemonsets_constrained "$LONGHORN_NODE_SELECTOR" || return 1
    wait_longhorn_storage_ready "longhorn" || return $?
    verify_longhorn_multipathd_safe || return $?
    echo "[baremetal] Longhorn is already deployed and CSI/storage are Ready; skipping Helm upgrade."
    return 0
  fi

  ensure_helm_repo "longhorn" "https://charts.longhorn.io" || return $?
  helm repo update longhorn >/dev/null || return $?

  local longhorn_selector_values_file=""
  local -a longhorn_extra_args=()
  if [[ -n "${LONGHORN_NODE_SELECTOR:-}" ]]; then
    local kubectl_selector=""
    local pair
    local matched_nodes=0
    local desired_nodes=0

    for pair in "${longhorn_selector_pairs[@]}"; do
      if [[ -n "$kubectl_selector" ]]; then
        kubectl_selector+=","
      fi
      kubectl_selector+="$pair"
    done

    matched_nodes="$(list_schedulable_nodes_by_selector "$kubectl_selector" | awk 'NF{c++} END{print c+0}')"
    if is_default_longhorn_node_selector "$LONGHORN_NODE_SELECTOR"; then
      desired_nodes="$(desired_longhorn_node_count)"
      if (( matched_nodes < desired_nodes )); then
        auto_label_default_longhorn_nodes "$desired_nodes" || true
      fi
      matched_nodes="$(list_schedulable_nodes_by_selector "$kubectl_selector" | awk 'NF{c++} END{print c+0}')"
    fi
    if [[ "${matched_nodes:-0}" == "0" ]]; then
      echo "Error: LONGHORN_NODE_SELECTOR='${LONGHORN_NODE_SELECTOR}' matched 0 Kubernetes nodes." >&2
      if is_default_longhorn_node_selector "$LONGHORN_NODE_SELECTOR"; then
        echo "Auto-labeling was attempted but no matching nodes are available yet." >&2
      else
        echo "Label at least one node and retry. Example:" >&2
        echo "  kubectl label node <node-name> node.longhorn.io/create-default-disk=true" >&2
      fi
      return 1
    fi
    if [[ "$LONGHORN_DEFAULT_REPLICA_COUNT" =~ ^[0-9]+$ ]] && (( matched_nodes < LONGHORN_DEFAULT_REPLICA_COUNT )); then
      echo "Warning: LONGHORN_NODE_SELECTOR matches ${matched_nodes} nodes, which is less than LONGHORN_DEFAULT_REPLICA_COUNT=${LONGHORN_DEFAULT_REPLICA_COUNT}." >&2
    fi

    longhorn_selector_values_file="$(build_longhorn_selector_values_file "$LONGHORN_NODE_SELECTOR")" || return $?
    longhorn_extra_args+=(-f "$longhorn_selector_values_file")
    echo "[baremetal] Restricting Longhorn components to schedulable nodes: ${LONGHORN_NODE_SELECTOR} (matched ${matched_nodes} node(s))"
  fi

  echo "[baremetal] Installing/ensuring Longhorn ${LONGHORN_CHART_VERSION} ..."
  echo "[baremetal] Waiting for Longhorn components to become Ready (timeout 40m) ..."
  local install_rc=0
  # Longhorn managers apply defaultSettings during daemon startup. Passing those
  # through Helm makes every manager race on the same Setting objects.
  run_with_namespace_progress "longhorn" "$LONGHORN_NAMESPACE" \
    helm upgrade --install "$LONGHORN_RELEASE_NAME" "$LONGHORN_CHART" \
    "${longhorn_extra_args[@]}" \
    --version "$LONGHORN_CHART_VERSION" \
    -n "$LONGHORN_NAMESPACE" \
    --create-namespace \
    --reset-values \
    --set "persistence.defaultClassReplicaCount=${LONGHORN_DEFAULT_REPLICA_COUNT}" \
    --disable-openapi-validation \
    --wait \
    --timeout 40m || install_rc=$?

  if [[ -n "$longhorn_selector_values_file" ]]; then
    rm -f "$longhorn_selector_values_file" >/dev/null 2>&1 || true
  fi
  if (( install_rc != 0 )); then
    return "$install_rc"
  fi

  apply_longhorn_post_start_settings "$longhorn_system_managed_selector_setting" || return 1
  ensure_longhorn_daemonsets_constrained "$LONGHORN_NODE_SELECTOR" || return 1
  wait_longhorn_storage_ready "longhorn"
}

ensure_longhorn_crypto_secret() {
  require_bin openssl
  local crypto_key
  if kubectl -n "$LONGHORN_NAMESPACE" get secret "$LONGHORN_CRYPTO_SECRET_NAME" >/dev/null 2>&1; then
    return
  fi

  echo "[baremetal] Creating Longhorn encryption secret ${LONGHORN_CRYPTO_SECRET_NAME} ..."
  crypto_key="$(openssl rand -base64 48)" || return $?
  if [[ -z "$crypto_key" ]]; then
    echo "Error: generated Longhorn encryption key is empty." >&2
    return 1
  fi
  kubectl -n "$LONGHORN_NAMESPACE" create secret generic "$LONGHORN_CRYPTO_SECRET_NAME" \
    --from-literal=CRYPTO_KEY_VALUE="$crypto_key" \
    --from-literal=CRYPTO_KEY_PROVIDER=secret \
    --from-literal=CRYPTO_KEY_CIPHER=aes-xts-plain64 \
    --from-literal=CRYPTO_KEY_HASH=sha256 \
    --from-literal=CRYPTO_KEY_SIZE=256 \
    --from-literal=CRYPTO_PBKDF=argon2i >/dev/null
}

ensure_encrypted_storage_class() {
  echo "[baremetal] Applying encrypted StorageClass ${ENCRYPTED_SC_NAME} ..."
  cat <<EOF | kubectl apply -f - >/dev/null
apiVersion: storage.k8s.io/v1
kind: StorageClass
metadata:
  name: ${ENCRYPTED_SC_NAME}
provisioner: driver.longhorn.io
allowVolumeExpansion: true
reclaimPolicy: Delete
volumeBindingMode: Immediate
parameters:
  numberOfReplicas: "${LONGHORN_DEFAULT_REPLICA_COUNT}"
  staleReplicaTimeout: "2880"
  encrypted: "true"
  csi.storage.k8s.io/provisioner-secret-name: "${LONGHORN_CRYPTO_SECRET_NAME}"
  csi.storage.k8s.io/provisioner-secret-namespace: "${LONGHORN_NAMESPACE}"
  csi.storage.k8s.io/node-publish-secret-name: "${LONGHORN_CRYPTO_SECRET_NAME}"
  csi.storage.k8s.io/node-publish-secret-namespace: "${LONGHORN_NAMESPACE}"
  csi.storage.k8s.io/node-stage-secret-name: "${LONGHORN_CRYPTO_SECRET_NAME}"
  csi.storage.k8s.io/node-stage-secret-namespace: "${LONGHORN_NAMESPACE}"
  csi.storage.k8s.io/node-expand-secret-name: "${LONGHORN_CRYPTO_SECRET_NAME}"
  csi.storage.k8s.io/node-expand-secret-namespace: "${LONGHORN_NAMESPACE}"
EOF
}

ensure_localdev_encrypted_storage_class() {
  local base_sc="$1"
  local provisioner reclaim_policy volume_binding_mode allow_expand existing_provisioner

  provisioner="$(kubectl get storageclass "$base_sc" -o jsonpath='{.provisioner}')"
  reclaim_policy="$(kubectl get storageclass "$base_sc" -o jsonpath='{.reclaimPolicy}')"
  volume_binding_mode="$(kubectl get storageclass "$base_sc" -o jsonpath='{.volumeBindingMode}')"
  allow_expand="$(kubectl get storageclass "$base_sc" -o jsonpath='{.allowVolumeExpansion}')"

  [[ -z "$provisioner" ]] && { echo "Error: failed to read provisioner for StorageClass $base_sc" >&2; exit 1; }

  if kubectl get storageclass "$ENCRYPTED_SC_NAME" >/dev/null 2>&1; then
    existing_provisioner="$(kubectl get storageclass "$ENCRYPTED_SC_NAME" -o jsonpath='{.provisioner}')"
    if [[ "$existing_provisioner" == "$provisioner" ]]; then
      return
    fi
    echo "[localdev] Replacing StorageClass ${ENCRYPTED_SC_NAME} (old provisioner=${existing_provisioner}, new provisioner=${provisioner}) ..."
    kubectl delete storageclass "$ENCRYPTED_SC_NAME" --ignore-not-found >/dev/null
  fi

  [[ -z "$reclaim_policy" ]] && reclaim_policy="Delete"
  [[ -z "$volume_binding_mode" ]] && volume_binding_mode="Immediate"
  [[ -z "$allow_expand" ]] && allow_expand="true"

  echo "[localdev] Applying StorageClass ${ENCRYPTED_SC_NAME} (provisioner=${provisioner}, base=${base_sc}) ..."
  cat <<EOF | kubectl apply -f - >/dev/null
apiVersion: storage.k8s.io/v1
kind: StorageClass
metadata:
  name: ${ENCRYPTED_SC_NAME}
provisioner: ${provisioner}
allowVolumeExpansion: ${allow_expand}
reclaimPolicy: ${reclaim_policy}
volumeBindingMode: ${volume_binding_mode}
EOF
}

run_vault_helm_install() {
  local vault_storage_class="$1"
  local -n rc_ref="$2"
  local -a selector_files=("${@:3}")
  local -a helm_args=(
    helm upgrade --install "$VAULT_RELEASE_NAME" "$VAULT_CHART"
    "${selector_files[@]}"
    --version "$VAULT_CHART_VERSION"
    -n "$VAULT_NAMESPACE"
    --create-namespace
    --set "server.ha.enabled=false"
    --set "server.standalone.enabled=true"
    --set "server.dataStorage.enabled=true"
    --set-string "server.dataStorage.storageClass=${vault_storage_class}"
    --set "injector.enabled=false"
    --timeout 30m
  )

  echo "[bootstrap] Installing/ensuring Vault chart ${VAULT_CHART_VERSION} ..."

  rc_ref=0
  run_with_namespace_progress "vault" "$VAULT_NAMESPACE" "${helm_args[@]}" || rc_ref=$?
}

vault_mount_conflict_event() {
  local message

  message="$(kubectl -n "$VAULT_NAMESPACE" get events \
    --field-selector "involvedObject.kind=Pod,involvedObject.name=${VAULT_RELEASE_NAME}-0,type=Warning,reason=FailedMount" \
    --sort-by=.lastTimestamp \
    -o custom-columns=MESSAGE:.message \
    --no-headers 2>/dev/null | tail -n 1 || true)"
  message="$(trim_whitespace "$message")"

  if [[ -z "$message" ]]; then
    return 1
  fi

  if grep -Eiq 'already mapped or mounted|Cannot use device /dev/longhorn/.*in use|is apparently in use by the system|already mounted or mount point busy' <<<"$message"; then
    printf '%s' "$message"
    return 0
  fi
  return 1
}

wait_vault_status_or_mount_conflict() {
  local timeout_seconds="${1:-$KUBETON_VOLUME_STAGE_TIMEOUT_SECONDS}"
  local deadline=$(( $(date +%s) + timeout_seconds ))
  local phase conflict_message status initialized sealed

  while (( $(date +%s) < deadline )); do
    if conflict_message="$(vault_mount_conflict_event)"; then
      echo "Warning: detected Vault Longhorn mount conflict: ${conflict_message}" >&2
      return 2
    fi

    phase="$(kubectl -n "$VAULT_NAMESPACE" get pod "${VAULT_RELEASE_NAME}-0" -o jsonpath='{.status.phase}' 2>/dev/null || true)"
    phase="$(trim_whitespace "$phase")"
    if [[ "$phase" == "Running" ]]; then
      status="$(kubectl -n "$VAULT_NAMESPACE" exec "${VAULT_RELEASE_NAME}-0" -- vault status 2>&1 || true)"
      initialized="$(printf '%s\n' "$status" | awk '/^Initialized[[:space:]]+/ {print tolower($2); exit}')"
      sealed="$(printf '%s\n' "$status" | awk '/^Sealed[[:space:]]+/ {print tolower($2); exit}')"
      if [[ "$initialized" == "true" || "$initialized" == "false" ]]; then
        echo "[bootstrap] Vault status is reachable (initialized=${initialized}, sealed=${sealed:-unknown})."
        return 0
      fi
    fi

    if [[ "$phase" == "Failed" ]]; then
      echo "Error: Vault pod ${VAULT_NAMESPACE}/${VAULT_RELEASE_NAME}-0 failed." >&2
      kubectl -n "$VAULT_NAMESPACE" describe pod "${VAULT_RELEASE_NAME}-0" >&2 || true
      return 1
    fi
    sleep 3
  done

  echo "Error: timeout waiting for Vault status from ${VAULT_NAMESPACE}/${VAULT_RELEASE_NAME}-0." >&2
  if conflict_message="$(vault_mount_conflict_event)"; then
    echo "Last Vault mount conflict: ${conflict_message}" >&2
    return 2
  fi
  kubectl -n "$VAULT_NAMESPACE" describe pod "${VAULT_RELEASE_NAME}-0" >&2 || true
  return 1
}

ensure_vault_installed() {
  local vault_storage_class="${1:-longhorn}"
  local vault_selector_values_file=""
  local vault_csi_affinity_values_file=""
  local -a vault_selector_values_files=()
  local -a vault_extra_args=()
  local -a longhorn_csi_nodes=()
  local k3d_selector=""
  local k3d_matched_nodes=0
  local attempt=1
  local max_attempts="$KUBETON_VAULT_MOUNT_RECOVERY_ATTEMPTS"
  local install_rc=0
  local wait_rc=0
  require_bin helm
  if ! [[ "$max_attempts" =~ ^[0-9]+$ ]] || (( max_attempts < 1 )); then
    max_attempts=1
  fi
  ensure_namespace_not_terminating "$VAULT_NAMESPACE" 240 || return $?
  ensure_helm_repo "hashicorp" "https://helm.releases.hashicorp.com" || return $?
  helm repo update hashicorp >/dev/null || return $?

  if cluster_is_k3d; then
    k3d_selector="$(trim_whitespace "${VAULT_LOCALDEV_NODE_SELECTOR:-}")"
    if [[ -n "$k3d_selector" ]]; then
      k3d_matched_nodes="$(kubectl get nodes -l "$k3d_selector" --no-headers 2>/dev/null | awk 'NF{c++} END{print c+0}')"
      if [[ "${k3d_matched_nodes:-0}" == "0" ]]; then
        echo "Warning: VAULT_LOCALDEV_NODE_SELECTOR='${k3d_selector}' matched 0 nodes; continuing without Vault node selector." >&2
      else
        vault_selector_values_file="$(build_vault_selector_values_file "$k3d_selector")" || return $?
        vault_selector_values_files+=("$vault_selector_values_file")
        vault_extra_args+=(-f "$vault_selector_values_file")
        echo "[localdev] Restricting Vault server to nodes: ${k3d_selector} (matched ${k3d_matched_nodes} node(s))"
      fi
    fi
  fi

  if ! cluster_is_k3d && [[ -n "${LONGHORN_NODE_SELECTOR:-}" ]]; then
    local -a selector_pairs=()
    local kubectl_selector=""
    local pair
    local matched_nodes=0

    parse_selector_pairs "$LONGHORN_NODE_SELECTOR" selector_pairs || return 1
    for pair in "${selector_pairs[@]}"; do
      if [[ -n "$kubectl_selector" ]]; then
        kubectl_selector+=","
      fi
      kubectl_selector+="$pair"
    done
    matched_nodes="$(list_schedulable_nodes_by_selector "$kubectl_selector" | awk 'NF{c++} END{print c+0}')"
    if [[ "${matched_nodes:-0}" == "0" ]]; then
      echo "Error: Vault cannot be scheduled because LONGHORN_NODE_SELECTOR='${LONGHORN_NODE_SELECTOR}' matched 0 schedulable nodes." >&2
      return 1
    fi

    vault_selector_values_file="$(build_vault_selector_values_file "$LONGHORN_NODE_SELECTOR")" || return $?
    vault_selector_values_files+=("$vault_selector_values_file")
    vault_extra_args+=(-f "$vault_selector_values_file")
    echo "[baremetal] Restricting Vault server to schedulable Longhorn nodes: ${LONGHORN_NODE_SELECTOR} (matched ${matched_nodes} node(s))"
  fi

  if storage_class_is_longhorn "$vault_storage_class"; then
    wait_longhorn_storage_ready "$vault_storage_class" || return $?
    mapfile -t longhorn_csi_nodes < <(list_longhorn_csi_node_names)
    if [[ ${#longhorn_csi_nodes[@]} -eq 0 ]]; then
      echo "Error: storage class '${vault_storage_class}' uses Longhorn, but no CSINode reports driver.longhorn.io." >&2
      return 1
    fi
    vault_csi_affinity_values_file="$(build_vault_csi_affinity_values_file longhorn_csi_nodes)" || return $?
    vault_selector_values_files+=("$vault_csi_affinity_values_file")
    vault_extra_args+=(-f "$vault_csi_affinity_values_file")
    echo "[bootstrap] Vault Longhorn CSI nodeAffinity enabled for ${#longhorn_csi_nodes[@]} node(s)."
  fi

  echo "[bootstrap] Waiting for Vault status to become reachable (timeout ${KUBETON_VOLUME_STAGE_TIMEOUT_SECONDS}s) ..."
  while (( attempt <= max_attempts )); do
    install_rc=0
    wait_rc=0
    run_vault_helm_install "$vault_storage_class" install_rc "${vault_extra_args[@]}"
    if (( install_rc != 0 )); then
      break
    fi

    wait_vault_status_or_mount_conflict "$KUBETON_VOLUME_STAGE_TIMEOUT_SECONDS" || wait_rc=$?
    if (( wait_rc == 0 )); then
      break
    fi
    if (( wait_rc != 2 || attempt >= max_attempts )); then
      install_rc="$wait_rc"
      break
    fi

    echo "[bootstrap] Recreating Vault after Longhorn mount conflict (attempt ${attempt}/${max_attempts}) ..."
    uninstall_vault || true
    cleanup_vault_force || true
    delete_namespace_with_progress "$VAULT_NAMESPACE" "$NAMESPACE_DELETE_PROGRESS_TIMEOUT" || true
    ensure_namespace_not_terminating "$VAULT_NAMESPACE" 240 || return $?
    ((attempt+=1))
  done

  for vault_selector_values_file in "${vault_selector_values_files[@]}"; do
    [[ -n "$vault_selector_values_file" ]] || continue
    rm -f "$vault_selector_values_file" >/dev/null 2>&1 || true
  done
  if (( install_rc != 0 )); then
    return "$install_rc"
  fi
}

vault_exec() {
  kubectl -n "$VAULT_NAMESPACE" exec "${VAULT_RELEASE_NAME}-0" -- "$@"
}

reset_localdev_vault() {
  echo "[localdev] Resetting Vault release/namespace for local recovery ..."
  helm uninstall "$VAULT_RELEASE_NAME" -n "$VAULT_NAMESPACE" >/dev/null 2>&1 || true
  kubectl delete namespace "$VAULT_NAMESPACE" --ignore-not-found >/dev/null 2>&1 || true
  wait_namespace_gone "$VAULT_NAMESPACE" 240 || true
}

vault_status_with_retry() {
  local deadline=$(( $(date +%s) + 180 ))
  local status initialized
  while (( $(date +%s) < deadline )); do
    status="$(vault_exec vault status 2>&1 || true)"
    initialized="$(printf '%s\n' "$status" | awk '/^Initialized[[:space:]]+/ {print tolower($2); exit}')"
    if [[ "$initialized" == "true" || "$initialized" == "false" ]]; then
      printf '%s' "$status"
      return 0
    fi
    sleep 3
  done
  printf '%s' "${status:-}"
  return 1
}

verify_vault_data_path_writable() {
  local check_out
  check_out="$(vault_exec sh -ec '
    test -d /vault/data
    touch /vault/data/.kubeton-rw-test
    rm -f /vault/data/.kubeton-rw-test
  ' 2>&1)" && return 0

  echo "Error: Vault data path /vault/data is not writable in ${VAULT_NAMESPACE}/${VAULT_RELEASE_NAME}-0." >&2
  if [[ -n "$check_out" ]]; then
    echo "Detail: $(printf '%s' "$check_out" | tr '\n' ' ')" >&2
  fi
  echo "This usually means the underlying PVC/PV/Longhorn volume is unhealthy (for example I/O error)." >&2
  echo "Check: kubectl -n ${VAULT_NAMESPACE} describe pod ${VAULT_RELEASE_NAME}-0 ; kubectl -n ${VAULT_NAMESPACE} get pvc ; kubectl -n longhorn-system get volumes.longhorn.io -o wide" >&2
  return 1
}

ensure_vault_bootstrap_secret_from_env() {
  local env_unseal_key env_root_token
  if [[ -z "$VAULT_BOOTSTRAP_UNSEAL_KEY" || -z "$VAULT_BOOTSTRAP_ROOT_TOKEN" ]]; then
    return 1
  fi
  env_unseal_key="$(sanitize_compact "$VAULT_BOOTSTRAP_UNSEAL_KEY")"
  env_root_token="$(sanitize_compact "$VAULT_BOOTSTRAP_ROOT_TOKEN")"
  if [[ -z "$env_unseal_key" || -z "$env_root_token" ]]; then
    echo "Error: provided Vault bootstrap credentials are empty after sanitization." >&2
    return 1
  fi
  echo "[baremetal] Recreating missing Vault bootstrap secret ${VAULT_BOOTSTRAP_SECRET} from environment ..."
  kubectl -n "$VAULT_NAMESPACE" create secret generic "$VAULT_BOOTSTRAP_SECRET" \
    --from-literal=unseal_key="$env_unseal_key" \
    --from-literal=root_token="$env_root_token" \
    --dry-run=client -o yaml | kubectl apply -f - >/dev/null
}

initialize_and_unseal_vault() {
  local status init_out unseal_key root_token initialized sealed

  if ! status="$(vault_status_with_retry)"; then
    echo "Error: failed to get parseable Vault status from ${VAULT_NAMESPACE}/${VAULT_RELEASE_NAME}-0." >&2
    if [[ -n "${status:-}" ]]; then
      echo "Last vault status output:" >&2
      printf '%s\n' "$status" >&2
    fi
    echo "Check pod logs: kubectl -n ${VAULT_NAMESPACE} logs ${VAULT_RELEASE_NAME}-0" >&2
    echo "Check pod events: kubectl -n ${VAULT_NAMESPACE} describe pod ${VAULT_RELEASE_NAME}-0" >&2
    exit 1
  fi
  initialized="$(printf '%s\n' "$status" | awk '/^Initialized[[:space:]]+/ {print tolower($2); exit}')"
  if [[ "$initialized" == "false" ]]; then
    echo "[baremetal] Initializing Vault ..." >&2
    init_out="$(vault_exec vault operator init -key-shares=1 -key-threshold=1)" || return $?
    unseal_key="$(printf '%s\n' "$init_out" | awk -F': ' '/Unseal Key 1:/ {print $2; exit}')"
    root_token="$(printf '%s\n' "$init_out" | awk -F': ' '/Initial Root Token:/ {print $2; exit}')"
    unseal_key="$(sanitize_compact "$unseal_key")"
    root_token="$(sanitize_compact "$root_token")"
    if [[ -z "$unseal_key" || -z "$root_token" ]]; then
      echo "Error: failed to parse Vault init output." >&2
      exit 1
    fi
    kubectl -n "$VAULT_NAMESPACE" create secret generic "$VAULT_BOOTSTRAP_SECRET" \
      --from-literal=unseal_key="$unseal_key" \
      --from-literal=root_token="$root_token" \
      --dry-run=client -o yaml | kubectl apply -f - >/dev/null || return $?
  elif [[ "$initialized" != "true" ]]; then
    echo "Error: unable to parse Vault initialized state." >&2
    echo "Vault status output:" >&2
    printf '%s\n' "$status" >&2
    exit 1
  fi

  if ! kubectl -n "$VAULT_NAMESPACE" get secret "$VAULT_BOOTSTRAP_SECRET" >/dev/null 2>&1; then
    if [[ "$initialized" == "true" ]] && ensure_vault_bootstrap_secret_from_env; then
      :
    else
      echo "Error: missing Vault bootstrap secret $VAULT_BOOTSTRAP_SECRET in namespace $VAULT_NAMESPACE" >&2
      if [[ "$initialized" == "true" ]]; then
        echo "Vault is already initialized. Provide existing credentials via:" >&2
        echo "  VAULT_BOOTSTRAP_UNSEAL_KEY=<unseal-key> VAULT_BOOTSTRAP_ROOT_TOKEN=<root-token> ./kubeton start" >&2
      fi
      exit 1
    fi
  fi

  unseal_key="$(kubectl -n "$VAULT_NAMESPACE" get secret "$VAULT_BOOTSTRAP_SECRET" -o jsonpath='{.data.unseal_key}' | base64 -d)" || return $?
  root_token="$(kubectl -n "$VAULT_NAMESPACE" get secret "$VAULT_BOOTSTRAP_SECRET" -o jsonpath='{.data.root_token}' | base64 -d)" || return $?
  unseal_key="$(sanitize_compact "$unseal_key")"
  root_token="$(sanitize_compact "$root_token")"
  if [[ -z "$unseal_key" || -z "$root_token" ]]; then
    echo "Error: Vault bootstrap secret ${VAULT_BOOTSTRAP_SECRET} is missing required keys." >&2
    exit 1
  fi

  status="$(vault_status_with_retry)" || return $?
  sealed="$(printf '%s\n' "$status" | awk '/^Sealed[[:space:]]+/ {print tolower($2); exit}')"
  if [[ "$sealed" == "true" ]]; then
    echo "[baremetal] Unsealing Vault ..." >&2
    vault_exec vault operator unseal "$unseal_key" >/dev/null || return $?
  elif [[ "$sealed" != "false" ]]; then
    echo "Error: unable to parse Vault sealed state; refusing to continue bootstrap." >&2
    return 1
  fi

  printf '%s' "$root_token"
}

configure_vault_for_ton() {
  local root_token="$1"
  local ton_token

  root_token="$(sanitize_compact "$root_token")"
  if [[ -z "$root_token" ]]; then
    echo "Error: empty root token for Vault configuration." >&2
    return 1
  fi
  verify_vault_data_path_writable || return 1

  echo "[baremetal] Configuring Vault Transit key and policy ..."
  vault_exec sh -ec "export VAULT_TOKEN='${root_token}'; vault secrets list | grep -q '^transit/' || vault secrets enable -path=transit transit" || return 1
  vault_exec sh -ec "export VAULT_TOKEN='${root_token}'; vault read transit/keys/${VAULT_TRANSIT_KEY} >/dev/null 2>&1 || vault write -f transit/keys/${VAULT_TRANSIT_KEY}" || return 1
  vault_exec sh -ec "export VAULT_TOKEN='${root_token}'; printf '%s\n' 'path \"transit/encrypt/${VAULT_TRANSIT_KEY}\" { capabilities = [\"update\"] }' 'path \"transit/decrypt/${VAULT_TRANSIT_KEY}\" { capabilities = [\"update\"] }' | vault policy write ${VAULT_TON_POLICY_NAME} -" || return 1
  ton_token="$(vault_exec sh -ec "export VAULT_TOKEN='${root_token}'; vault token create -policy=${VAULT_TON_POLICY_NAME} -period=${VAULT_TOKEN_PERIOD} -orphan -field=token")" || return 1
  ton_token="$(sanitize_compact "$ton_token")"
  if [[ -z "$ton_token" ]]; then
    echo "Error: failed to create TON Vault token." >&2
    return 1
  fi

  ensure_namespace "$TON_NAMESPACE" || return $?
  kubectl -n "$TON_NAMESPACE" create secret generic "$TON_VAULT_CREDS_SECRET" \
    --from-literal=VAULT_ADDR="$VAULT_ADDR_INTERNAL" \
    --from-literal=VAULT_TOKEN="$ton_token" \
    --dry-run=client -o yaml | kubectl apply -f - >/dev/null || return 1

  return 0
}

ensure_baremetal_stack() {
  require_bin kubectl
  require_bin helm
  require_bin openssl
  require_bin base64

  ensure_longhorn_installed || return $?
  ensure_longhorn_crypto_secret || return $?
  ensure_encrypted_storage_class || return $?
  ensure_vault_installed "longhorn" || return $?
  local root_token
  root_token="$(initialize_and_unseal_vault)" || return $?
  configure_vault_for_ton "$root_token"
}

ensure_localdev_stack() {
  require_bin kubectl
  require_bin helm
  require_bin base64

  local base_sc
  local root_token
  base_sc="$(resolve_localdev_storage_class)" || return $?
  ensure_localdev_encrypted_storage_class "$base_sc" || return $?
  ensure_vault_installed "$base_sc" || return $?
  root_token="$(initialize_and_unseal_vault)" || return $?

  if ! configure_vault_for_ton "$root_token"; then
    echo "[localdev] Vault configuration failed; reinstalling Vault and reinitializing ..." >&2
    reset_localdev_vault || return $?
    ensure_vault_installed "$base_sc" || return $?
    root_token="$(initialize_and_unseal_vault)" || return $?
    if ! configure_vault_for_ton "$root_token"; then
      echo "Error: Vault configuration is still failing after local recovery." >&2
      exit 1
    fi
  fi
}

ensure_auto_bootstrap_stack() {
  if cluster_is_k3d; then
    ensure_localdev_stack
    return $?
  fi
  ensure_baremetal_stack
}

vault_runtime_ready() {
  if ! kubectl -n "$VAULT_NAMESPACE" get pod "${VAULT_RELEASE_NAME}-0" >/dev/null 2>&1; then
    return 1
  fi
  kubectl -n "$VAULT_NAMESPACE" wait --for=condition=Ready "pod/${VAULT_RELEASE_NAME}-0" --timeout=5s >/dev/null 2>&1
}

ensure_auto_bootstrap_stack_if_needed() {
  local missing_reasons=()

  if ! kubectl get storageclass "$ENCRYPTED_SC_NAME" >/dev/null 2>&1; then
    missing_reasons+=("StorageClass ${ENCRYPTED_SC_NAME} is missing")
  fi
  if ! kubectl -n "$TON_NAMESPACE" get secret "$TON_VAULT_CREDS_SECRET" >/dev/null 2>&1; then
    missing_reasons+=("secret ${TON_NAMESPACE}/${TON_VAULT_CREDS_SECRET} is missing")
  fi
  if ! vault_runtime_ready; then
    missing_reasons+=("Vault pod ${VAULT_NAMESPACE}/${VAULT_RELEASE_NAME}-0 is not Ready")
  fi

  if (( ${#missing_reasons[@]} == 0 )); then
    echo "[bootstrap] Reusing existing Vault/StorageClass prerequisites."
    return 0
  fi

  printf '[bootstrap] Prerequisites missing/unhealthy, running bootstrap: %s\n' "$(IFS='; '; echo "${missing_reasons[*]}")"
  ensure_auto_bootstrap_stack
}

validate_external_key_prereqs() {
  if is_true "$SKIP_KEY_PREREQ_CHECK"; then
    return
  fi
  if ! kubectl get storageclass "$ENCRYPTED_SC_NAME" >/dev/null 2>&1; then
    echo "Error: missing StorageClass $ENCRYPTED_SC_NAME. Configure cloud/bare-metal prerequisite first." >&2
    exit 1
  fi
  if ! kubectl -n "$TON_NAMESPACE" get secret "$TON_VAULT_CREDS_SECRET" >/dev/null 2>&1; then
    echo "Error: missing secret $TON_VAULT_CREDS_SECRET in namespace $TON_NAMESPACE." >&2
    echo "Configure Vault/KMS prerequisites first or enable AUTO_BAREMETAL_BOOTSTRAP for bare-metal/local k3d." >&2
    exit 1
  fi
}

append_baremetal_key_overrides() {
  local -n target="$1"
  target+=(--set "tonNode.keyManagement.enabled=true")
  target+=(--set-string "tonNode.keyManagement.provider=vault")
  target+=(--set-string "tonNode.keyManagement.credentialsSecretRef=${TON_VAULT_CREDS_SECRET}")
  target+=(--set-string "tonNode.keyManagement.vaultTransitKey=${VAULT_TRANSIT_KEY}")
  target+=(--set-string "tonNode.keyManagement.encryptedBundle.storageClassName=${ENCRYPTED_SC_NAME}")
}

ton_storage_class_name() {
  trim_whitespace "${TON_STORAGE_CLASS_NAME:-local-path}"
}

ton_storage_class_auto() {
  [[ "$(ton_storage_class_name)" == "auto" ]]
}

ensure_ton_storage_class_available() {
  local storage_class

  if ton_storage_class_auto; then
    return 0
  fi

  storage_class="$(ton_storage_class_name)"
  if [[ -z "$storage_class" ]]; then
    echo "Error: TON_STORAGE_CLASS_NAME is empty. Use a local StorageClass name such as local-path, or set TON_STORAGE_CLASS_NAME=auto." >&2
    return 1
  fi

  if kubectl get storageclass "$storage_class" >/dev/null 2>&1; then
    return 0
  fi

  echo "Error: TON data StorageClass '${storage_class}' was not found." >&2
  echo "/var/ton-work/db is stored in the ton-work PVC, so kubeton now requires a local TON StorageClass by default." >&2
  echo "Install/provide a local provisioner, for example local-path, or override:" >&2
  echo "  TON_STORAGE_CLASS_NAME=<your-local-storage-class> ./kubeton start" >&2
  echo "Use TON_STORAGE_CLASS_NAME=auto only if you intentionally want operator auto-detection." >&2
  return 1
}

append_ton_storage_overrides() {
  local -n target="$1"
  local storage_class

  if ton_storage_class_auto; then
    echo "[start] TON storageClassName override disabled (TON_STORAGE_CLASS_NAME=auto); operator will auto-detect storage." >&2
    return 0
  fi

  storage_class="$(ton_storage_class_name)"
  target+=(--set-string "tonNode.storage.storageClassName=${storage_class}")
  echo "[start] Using TON data StorageClass '${storage_class}' for /var/ton-work and /var/ton-work/db." >&2
}

ton_storage_class_requires_sequential_start() {
  local storage_class
  local provisioner

  if ton_storage_class_auto; then
    return 1
  fi

  storage_class="$(ton_storage_class_name)"
  storage_class="$(trim_whitespace "$storage_class")"
  [[ -n "$storage_class" ]] || return 1

  provisioner="$(storage_class_provisioner "$storage_class")"
  provisioner="$(trim_whitespace "$provisioner")"

  [[ "$storage_class" == "local-path" ]] && return 0
  [[ "$provisioner" == "rancher.io/local-path" ]] && return 0
  [[ "$provisioner" == *"local-path"* ]]
}

list_ton_pods() {
  kubectl get pods -A -l "$TON_POD_LABEL" \
    -o jsonpath='{range .items[*]}{.metadata.namespace}{"\t"}{.metadata.name}{"\t"}{.spec.nodeName}{"\n"}{end}'
}

fleet_has_running_ton_pods() {
  local marker

  marker="$(kubectl get pods -A -l "$TON_POD_LABEL" \
    -o jsonpath='{range .items[?(@.status.phase=="Running")]}x{"\n"}{end}' 2>/dev/null || true)"
  [[ -n "$(trim_whitespace "$marker")" ]]
}

list_ton_statefulsets() {
  kubectl get statefulsets -A -l "$TON_POD_LABEL" \
    -o jsonpath='{range .items[*]}{.metadata.namespace}{"\t"}{.metadata.name}{"\t"}{.spec.replicas}{"\n"}{end}'
}

list_node_names() {
  kubectl get nodes -o jsonpath='{range .items[*]}{.metadata.name}{"\n"}{end}' 2>/dev/null \
    | awk 'NF' \
    | sort -u
}

local_path_provisioner_root() {
  local root
  root="$(trim_whitespace "${LOCAL_PATH_PROVISIONER_ROOT:-/opt/local-path-provisioner}")"
  root="${root%/}"
  if [[ -z "$root" || "$root" == "/" || "$root" != /* ]]; then
    echo "Error: invalid LOCAL_PATH_PROVISIONER_ROOT='${LOCAL_PATH_PROVISIONER_ROOT}'." >&2
    return 1
  fi
  printf '%s' "$root"
}

local_path_relative_target() {
  local path="$1"
  local root rel
  root="$(local_path_provisioner_root)" || return 1
  path="$(trim_whitespace "$path")"
  path="${path%/}"
  if [[ -z "$path" || "$path" == "$root" || "$path" != "$root"/* ]]; then
    return 1
  fi
  rel="${path#"$root"/}"
  case "$rel" in
    ""|"."|".."|/*|../*|*/../*|*//*) return 1 ;;
  esac
  printf '%s' "$rel"
}

# Exact PV paths are authoritative for a bound local-path PV.  Unlike the
# optional orphan-pattern fallback below, they do not depend on the configured
# local-path provisioner root: clusters commonly use a custom root.
local_path_absolute_target() {
  local path="$1"

  path="$(trim_whitespace "$path")"
  case "$path" in
    *//*|*$'\t'*|*$'\n'*|*$'\r'*) return 1 ;;
  esac
  path="${path%/}"
  case "$path" in
    ""|/|/..|/../*|*/..|*/../*|/.|/./*|*/.|*/./*) return 1 ;;
  esac
  [[ "$path" == /* ]] || return 1
  printf '%s' "$path"
}

local_path_safe_name_component() {
  [[ "${1:-}" =~ ^[A-Za-z0-9._-]+$ ]]
}

local_path_cleanup_namespaces() {
  local ns phase
  local -a seen=()

  # A privileged host-root cleanup Pod is often rejected in an application
  # namespace by Pod Security admission, while kube-system is allowed.  Keep
  # an explicit choice first, but emit every usable fallback so the caller can
  # retry if creation is denied in the first namespace.
  for ns in "$KUBETON_LOCAL_PATH_CLEANUP_NAMESPACE" kube-system "$TON_NAMESPACE" default; do
    ns="$(trim_whitespace "$ns")"
    [[ -z "$ns" ]] && continue
    if [[ " ${seen[*]} " == *" ${ns} "* ]]; then
      continue
    fi
    seen+=("$ns")
    if ! kubectl get namespace "$ns" >/dev/null 2>&1; then
      continue
    fi
    phase="$(kubectl get namespace "$ns" -o jsonpath='{.status.phase}' 2>/dev/null || true)"
    if [[ "$phase" != "Terminating" ]]; then
      printf '%s\n' "$ns"
    fi
  done
}

local_path_cleanup_namespace() {
  local -a namespaces=()

  mapfile -t namespaces < <(local_path_cleanup_namespaces)
  if [[ ${#namespaces[@]} -gt 0 ]]; then
    printf '%s' "${namespaces[0]}"
    return 0
  fi
  echo "Error: no usable namespace found for local-path cleanup pod." >&2
  return 1
}

local_path_pv_host_path() {
  local pv="$1"
  local path
  if ! path="$(kubectl get pv "$pv" --ignore-not-found -o jsonpath='{.spec.hostPath.path}' 2>/dev/null)"; then
    echo "Error: could not inspect host path for PV ${pv}." >&2
    return 1
  fi
  path="$(trim_whitespace "$path")"
  if [[ -z "$path" ]]; then
    if ! path="$(kubectl get pv "$pv" --ignore-not-found -o jsonpath='{.spec.local.path}' 2>/dev/null)"; then
      echo "Error: could not inspect local path for PV ${pv}." >&2
      return 1
    fi
    path="$(trim_whitespace "$path")"
  fi
  printf '%s' "$path"
}

local_path_pv_matches_claim() {
  local pv="$1"
  local pvc_ref="$2"
  local expected_ns expected_pvc expected_uid actual_ns actual_pvc actual_uid

  IFS=/ read -r expected_ns expected_pvc <<<"$pvc_ref"
  [[ -n "$expected_ns" && -n "$expected_pvc" ]] || return 1
  actual_ns="$(kubectl get pv "$pv" -o jsonpath='{.spec.claimRef.namespace}' 2>/dev/null || true)"
  actual_pvc="$(kubectl get pv "$pv" -o jsonpath='{.spec.claimRef.name}' 2>/dev/null || true)"
  expected_uid="$(kubectl -n "$expected_ns" get pvc "$expected_pvc" -o jsonpath='{.metadata.uid}' 2>/dev/null || true)"
  actual_uid="$(kubectl get pv "$pv" -o jsonpath='{.spec.claimRef.uid}' 2>/dev/null || true)"
  actual_ns="$(trim_whitespace "$actual_ns")"
  actual_pvc="$(trim_whitespace "$actual_pvc")"
  expected_uid="$(trim_whitespace "$expected_uid")"
  actual_uid="$(trim_whitespace "$actual_uid")"
  [[ "$actual_ns" == "$expected_ns" && "$actual_pvc" == "$expected_pvc" ]] || return 1
  [[ -n "$expected_uid" && -n "$actual_uid" && "$actual_uid" == "$expected_uid" ]]
}

local_path_pv_is_provisioned_by_local_path() {
  local pv="$1"
  local storage_class provisioner pv_provisioner

  storage_class="$(kubectl get pv "$pv" -o jsonpath='{.spec.storageClassName}' 2>/dev/null || true)"
  storage_class="$(trim_whitespace "$storage_class")"
  provisioner="$(storage_class_provisioner "$storage_class")"
  pv_provisioner="$(kubectl get pv "$pv" -o jsonpath='{.metadata.annotations.pv\.kubernetes\.io/provisioned-by}' 2>/dev/null || true)"
  pv_provisioner="$(trim_whitespace "$pv_provisioner")"

  [[ "$provisioner" == "rancher.io/local-path" || "$provisioner" == *"local-path"* ]] || return 1
  [[ "$pv_provisioner" == "rancher.io/local-path" || "$pv_provisioner" == *"local-path"* ]]
}

resolve_node_name_for_hostname_value() {
  local hostname_value="$1"
  local node node_rows
  local -a nodes=()
  hostname_value="$(trim_whitespace "$hostname_value")"
  [[ -n "$hostname_value" ]] || return 1

  # This value came from the kubernetes.io/hostname *label* in PV affinity.
  # Do not treat an equal node name as proof: a cluster can legitimately have
  # node foo with hostname label bar while another node has hostname foo.
  # Resolve the label itself and require one exact current owner.
  if ! node_rows="$(kubectl get nodes -l "kubernetes.io/hostname=${hostname_value}" -o jsonpath='{range .items[*]}{.metadata.name}{"\n"}{end}' 2>/dev/null)"; then
    return 1
  fi
  while IFS= read -r node; do
    node="$(trim_whitespace "$node")"
    [[ -n "$node" ]] || continue
    append_unique_item "$node" nodes
  done <<<"$node_rows"
  [[ ${#nodes[@]} -eq 1 ]] || return 1
  printf '%s' "${nodes[0]}"
}

collect_local_path_nodes_for_pv() {
  local pv="$1"
  local -n nodes_ref="$2"
  local node resolved_node affinity_rows affinity_operator affinity_values selected_node
  local term_count=0 term_has_hostname=0 term_invalid=0 affinity_fully_resolved=1
  local affinity_reason=""
  local -a affinity_nodes=()
  local -a term_nodes=()
  local -a affinity_values_array=()

  # nodeSelectorTerms are ORed.  Do not mistake one hostname-constrained term
  # for an ownership proof when another term can match a different node.  A
  # record separator after *every* term lets us require each alternative to
  # resolve to the same exact hostname owner.  When that cannot be proven,
  # Rancher's selected-node annotation below is the only acceptable fallback.
  if ! affinity_rows="$(kubectl get pv "$pv" --ignore-not-found \
    -o jsonpath='{range .spec.nodeAffinity.required.nodeSelectorTerms[*]}{range .matchExpressions[?(@.key=="kubernetes.io/hostname")]}{.operator}{"\t"}{range .values[*]}{.}{"|"}{end}{"\n"}{end}{"__KUBETON_TERM_END__\n"}{end}' 2>/dev/null)"; then
    echo "Error: could not inspect node affinity for local-path PV ${pv}." >&2
    return 1
  fi
  while IFS=$'\t' read -r affinity_operator affinity_values; do
    affinity_operator="$(trim_whitespace "$affinity_operator")"
    affinity_values="$(trim_whitespace "$affinity_values")"
    if [[ "$affinity_operator" == "__KUBETON_TERM_END__" && -z "$affinity_values" ]]; then
      ((term_count+=1))
      if (( term_has_hostname == 0 || term_invalid != 0 || ${#term_nodes[@]} != 1 )); then
        affinity_fully_resolved=0
      else
        append_unique_item "${term_nodes[0]}" affinity_nodes
      fi
      term_has_hostname=0
      term_invalid=0
      term_nodes=()
      continue
    fi
    [[ -n "$affinity_operator" || -n "$affinity_values" ]] || continue
    term_has_hostname=1
    if [[ "$affinity_operator" != "In" ]]; then
      term_invalid=1
      affinity_reason="hostname affinity uses unsupported operator ${affinity_operator:-unknown}"
      continue
    fi
    IFS='|' read -r -a affinity_values_array <<<"$affinity_values"
    if [[ ${#affinity_values_array[@]} -eq 0 ]]; then
      term_invalid=1
      affinity_reason="hostname affinity has no node value"
      continue
    fi
    for node in "${affinity_values_array[@]}"; do
      node="$(trim_whitespace "$node")"
      if [[ -z "$node" ]]; then
        term_invalid=1
        affinity_reason="hostname affinity has an empty node value"
        continue
      fi
      resolved_node="$(resolve_node_name_for_hostname_value "$node" || true)"
      resolved_node="$(trim_whitespace "$resolved_node")"
      if [[ -z "$resolved_node" ]]; then
        term_invalid=1
        affinity_reason="hostname affinity value ${node} does not resolve to exactly one live node"
        continue
      fi
      append_unique_item "$resolved_node" term_nodes
    done
  done <<<"$affinity_rows"

  if (( term_count == 0 || ${#affinity_nodes[@]} != 1 )); then
    affinity_fully_resolved=0
  fi

  # Rancher local-path writes the provisioning node as a PV annotation.  It is
  # the authoritative fallback for older hostPath PVs that lack nodeAffinity
  # and for installations configured with a non-hostname nodeAffinityKey.
  if ! selected_node="$(kubectl get pv "$pv" --ignore-not-found \
    -o jsonpath='{.metadata.annotations.local\.path\.provisioner/selected-node}' 2>/dev/null)"; then
    echo "Error: could not inspect selected-node provenance for local-path PV ${pv}." >&2
    return 1
  fi
  selected_node="$(trim_whitespace "$selected_node")"
  if [[ -n "$selected_node" ]]; then
    if ! [[ "$selected_node" =~ ^[a-z0-9]([a-z0-9.-]*[a-z0-9])?$ && ${#selected_node} -le 253 ]]; then
      echo "Error: refusing local-path host cleanup for PV ${pv}: its selected-node annotation is invalid." >&2
      return 1
    fi
    if ! kubectl get node "$selected_node" >/dev/null 2>&1; then
      echo "Error: refusing local-path host cleanup for PV ${pv}: selected-node ${selected_node} is no longer a live Kubernetes node." >&2
      return 1
    fi
    if (( affinity_fully_resolved == 1 )) && [[ "${affinity_nodes[0]}" != "$selected_node" ]]; then
      echo "Error: refusing local-path host cleanup for PV ${pv}: node affinity and selected-node provenance disagree." >&2
      return 1
    fi
    append_unique_item "$selected_node" nodes_ref
  elif (( affinity_fully_resolved == 1 )); then
    append_unique_item "${affinity_nodes[0]}" nodes_ref
  else
    echo "Error: refusing local-path host cleanup for PV ${pv}: node affinity does not uniquely resolve every selector term${affinity_reason:+ (${affinity_reason})}, and Rancher selected-node provenance is unavailable." >&2
    return 1
  fi

  [[ ${#nodes_ref[@]} -eq 1 ]]
}

append_local_path_exact_cleanup_rows_for_pv() {
  local pv="$1"
  local pvc_ref="$2"
  local -n rows_ref="$3"
  local path node pv_uid pvc_uid pvc_ns pvc_name
  local -a nodes=()

  is_true "$KUBETON_LOCAL_PATH_CLEANUP" || return 0
  [[ -n "$pv" ]] || return 0

  if ! path="$(local_path_pv_host_path "$pv")"; then
    echo "Error: refusing local-path cleanup for PV ${pv}: its host path could not be inspected." >&2
    return 1
  fi
  # Non-hostPath PVs (for example Longhorn CSI) are handled by their own
  # deletion path and never become host cleanup targets.
  [[ -n "$path" ]] || return 0

  if ! local_path_pv_matches_claim "$pv" "$pvc_ref"; then
    echo "Error: refusing local-path cleanup for PV ${pv}: its claimRef does not match ${pvc_ref}." >&2
    return 1
  fi
  if ! local_path_pv_is_provisioned_by_local_path "$pv"; then
    echo "Error: refusing host cleanup for PV ${pv}: it has hostPath data but is not a verified local-path PV." >&2
    return 1
  fi

  path="$(local_path_absolute_target "$path" 2>/dev/null || true)"
  if [[ -z "$path" ]]; then
    echo "Error: refusing unsafe local-path cleanup target reported by PV ${pv}." >&2
    return 1
  fi

  if ! collect_local_path_nodes_for_pv "$pv" nodes; then
    # The PV, claim, provisioner, and host path were all verified above; only
    # its owner node is unresolved. Callers that are explicitly tearing down
    # TON may retain the UID-bound record and force-remove the unmounted PVC
    # object, but must never host-clean this path.
    return 2
  fi
  if [[ ${#nodes[@]} -ne 1 ]]; then
    echo "Error: refusing local-path host cleanup for PV ${pv}: exactly one owning node is required." >&2
    return 2
  fi
  IFS=/ read -r pvc_ns pvc_name <<<"$pvc_ref"
  pv_uid="$(kubectl get pv "$pv" -o jsonpath='{.metadata.uid}' 2>/dev/null || true)"
  pvc_uid="$(kubectl -n "$pvc_ns" get pvc "$pvc_name" -o jsonpath='{.metadata.uid}' 2>/dev/null || true)"
  pv_uid="$(trim_whitespace "$pv_uid")"
  pvc_uid="$(trim_whitespace "$pvc_uid")"
  if [[ -z "$pv_uid" || -z "$pvc_uid" ]]; then
    echo "Error: refusing local-path cleanup for PV ${pv}: missing PV or PVC identity." >&2
    return 1
  fi
  for node in "${nodes[@]}"; do
    node="$(trim_whitespace "$node")"
    [[ -z "$node" ]] && continue
    append_unique_item "$node"$'\t'"$path"$'\t'"$pv"$'\t'"$pvc_ref"$'\t'"$pv_uid"$'\t'"$pvc_uid" rows_ref
  done
}

# Record every bound PV, not only a local-path PV.  Kubernetes objects can be
# removed between uninstall attempts, so the UID-bound record is what lets a
# retry safely finish an encrypted/CSI volume without guessing from a PVC
# name.  Local-path PVs additionally get an exact host-path target above.
append_pv_cleanup_ledger_row_for_pv() {
  local pv="$1"
  local pvc_ref="$2"
  local -n rows_ref="$3"
  local pvc_ns pvc_name pv_identity pv_uid claim_ns claim_name claim_uid pvc_uid reclaim_policy csi_driver volume_handle longhorn_ns longhorn_uid

  [[ -n "$pv" && -n "$pvc_ref" ]] || return 1
  IFS=/ read -r pvc_ns pvc_name <<<"$pvc_ref"
  [[ -n "$pvc_ns" && -n "$pvc_name" ]] || return 1

  if ! pv_identity="$(kubectl get pv "$pv" --ignore-not-found \
    -o jsonpath='{.metadata.uid}{"\t"}{.spec.claimRef.namespace}{"\t"}{.spec.claimRef.name}{"\t"}{.spec.claimRef.uid}{"\t"}{.spec.persistentVolumeReclaimPolicy}{"\t"}{.spec.csi.driver}{"\t"}{.spec.csi.volumeHandle}' 2>/dev/null)"; then
    echo "Error: could not inspect PV ${pv} before recording cleanup state." >&2
    return 1
  fi
  IFS=$'\t' read -r pv_uid claim_ns claim_name claim_uid reclaim_policy csi_driver volume_handle <<<"$pv_identity"
  pv_uid="$(trim_whitespace "$pv_uid")"
  claim_ns="$(trim_whitespace "$claim_ns")"
  claim_name="$(trim_whitespace "$claim_name")"
  claim_uid="$(trim_whitespace "$claim_uid")"
  reclaim_policy="$(trim_whitespace "$reclaim_policy")"
  csi_driver="$(trim_whitespace "$csi_driver")"
  volume_handle="$(trim_whitespace "$volume_handle")"
  if [[ -z "$pv_uid" || -z "$reclaim_policy" ]]; then
    echo "Error: bound PV ${pv} disappeared before cleanup state could be recorded." >&2
    return 1
  fi
  if ! pvc_uid="$(kubectl -n "$pvc_ns" get pvc "$pvc_name" --ignore-not-found -o jsonpath='{.metadata.uid}' 2>/dev/null)"; then
    echo "Error: could not inspect PVC ${pvc_ref} before recording cleanup state." >&2
    return 1
  fi
  pvc_uid="$(trim_whitespace "$pvc_uid")"
  if [[ -z "$pvc_uid" || "$claim_ns" != "$pvc_ns" || "$claim_name" != "$pvc_name" || "$claim_uid" != "$pvc_uid" ]]; then
    echo "Error: refusing to record PV ${pv}: its claimRef does not match PVC ${pvc_ref}." >&2
    return 1
  fi

  longhorn_uid=""
  # A Longhorn CSI volume is identified by its CSI volumeHandle, not by the
  # Kubernetes PV name.  Store that immutable mapping and the Volume UID so a
  # later retry cannot delete a different Longhorn volume that reused a name.
  if [[ "$csi_driver" == "driver.longhorn.io" ]]; then
    if [[ -z "$volume_handle" ]]; then
      echo "Error: refusing to record Longhorn PV ${pv} without a CSI volume handle." >&2
      return 1
    fi
    if ! longhorn_ns="$(kubectl get namespace "$LONGHORN_NAMESPACE" --ignore-not-found -o jsonpath='{.metadata.uid}' 2>/dev/null)"; then
      echo "Error: could not inspect Longhorn namespace ${LONGHORN_NAMESPACE} before recording PV ${pv}." >&2
      return 1
    fi
    longhorn_ns="$(trim_whitespace "$longhorn_ns")"
    if [[ -n "$longhorn_ns" ]]; then
      if ! longhorn_uid="$(kubectl -n "$LONGHORN_NAMESPACE" get volumes.longhorn.io "$volume_handle" --ignore-not-found -o jsonpath='{.metadata.uid}' 2>/dev/null)"; then
        echo "Error: could not inspect Longhorn volume ${volume_handle} before recording cleanup state." >&2
        return 1
      fi
      longhorn_uid="$(trim_whitespace "$longhorn_uid")"
    fi
  fi

  if [[ "$pv$pvc_ref$pv_uid$pvc_uid$reclaim_policy$csi_driver$volume_handle$longhorn_uid" == *$'\t'* || "$pv$pvc_ref$pv_uid$pvc_uid$reclaim_policy$csi_driver$volume_handle$longhorn_uid" == *$'\n'* ]]; then
    echo "Error: refusing to record an unsafe PV cleanup ledger field for ${pv}." >&2
    return 1
  fi
  append_unique_item "$pv"$'\t'"$pvc_ref"$'\t'"$pv_uid"$'\t'"$pvc_uid"$'\t'"$reclaim_policy"$'\t'"$csi_driver"$'\t'"$volume_handle"$'\t'"$longhorn_uid" rows_ref
}

local_path_pattern_cleanup_enabled() {
  is_true "$KUBETON_LOCAL_PATH_PATTERN_CLEANUP"
}

collect_local_path_pattern_cleanup_rows_for_pvcs() {
  local -n pvc_rows_ref="$1"
  local -n rows_ref="$2"
  local row ns pvc node
  local -a nodes=()

  is_true "$KUBETON_LOCAL_PATH_CLEANUP" || return 0
  local_path_pattern_cleanup_enabled || return 0
  mapfile -t nodes < <(list_node_names)
  [[ ${#nodes[@]} -gt 0 ]] || return 0

  for row in "${pvc_rows_ref[@]}"; do
    [[ -z "$row" ]] && continue
    IFS=$'\t' read -r ns pvc <<<"$row"
    ns="$(trim_whitespace "$ns")"
    pvc="$(trim_whitespace "$pvc")"
    [[ -z "$ns" || -z "$pvc" ]] && continue
    local_path_safe_name_component "$ns" || continue
    local_path_safe_name_component "$pvc" || continue
    for node in "${nodes[@]}"; do
      node="$(trim_whitespace "$node")"
      [[ -z "$node" ]] && continue
      append_unique_item "$node"$'\t'"$ns"$'\t'"$pvc" rows_ref
    done
  done
}

build_local_path_cleanup_script() {
  local node="$1"
  local root="$2"
  local exact_rows_name="$3"
  local pattern_rows_name="$4"
  local -n exact_rows_ref="$exact_rows_name"
  local -n pattern_rows_ref="$pattern_rows_name"
  local row row_node path pv pvc_ref ns pvc pattern
  local emitted=0

  {
    printf 'set -eu\n'
    printf 'host_root=/host\n'
    printf 'root=%s\n' "$(shell_quote "/host${root}")"
    printf 'remaining=0\n'
    printf 'rm_errors="/tmp/kubeton-local-path-rm.err"\n'
    printf 'remove_path_if_present() {\n'
    printf '  target="$1"\n'
    printf '  label="$2"\n'
    printf '  [ -e "$target" ] || return 0\n'
    printf '  echo "[cleanup] Removing local-path PV directory: ${label}"\n'
    printf '  : > "$rm_errors"\n'
    printf '  rm -rf -- "$target" 2>"$rm_errors" || true\n'
    printf '  if [ -e "$target" ]; then\n'
    printf '    echo "Error: local-path PV directory still exists: ${label}" >&2\n'
    printf '    if [ -s "$rm_errors" ]; then cat "$rm_errors" >&2; fi\n'
    printf '    remaining=1\n'
    printf '  fi\n'
    printf '  rm -f "$rm_errors" >/dev/null 2>&1 || true\n'
    printf '}\n'
    printf 'remove_pattern_matches() {\n'
    printf '  pattern="$1"\n'
    printf '  label="$2"\n'
    printf '  if [ ! -d "$root" ]; then\n'
    printf '    echo "Error: local-path provisioner root is unavailable: ${root}" >&2\n'
    printf '    remaining=1\n'
    printf '    return 0\n'
    printf '  fi\n'
    printf '  : > "$rm_errors"\n'
    printf '  find "$root" -mindepth 1 -maxdepth 1 -type d -name "$pattern" -exec rm -rf -- {} + 2>"$rm_errors" || true\n'
    printf '  if [ -n "$(find "$root" -mindepth 1 -maxdepth 1 -type d -name "$pattern" -print -quit)" ]; then\n'
    printf '    echo "Error: local-path directory matching ${label} still exists" >&2\n'
    printf '    if [ -s "$rm_errors" ]; then cat "$rm_errors" >&2; fi\n'
    printf '    remaining=1\n'
    printf '  fi\n'
    printf '  rm -f "$rm_errors" >/dev/null 2>&1 || true\n'
    printf '}\n'

    for row in "${exact_rows_ref[@]}"; do
      [[ -z "$row" ]] && continue
      IFS=$'\t' read -r row_node path pv pvc_ref <<<"$row"
      [[ "$row_node" == "$node" ]] || continue
      path="$(local_path_absolute_target "$path" 2>/dev/null || true)"
      [[ -n "$path" ]] || continue
      printf 'target="$host_root"%s\n' "$(shell_quote "$path")"
      printf 'remove_path_if_present "$target" "${target#$host_root/}"\n'
      emitted=1
    done

    for row in "${pattern_rows_ref[@]}"; do
      [[ -z "$row" ]] && continue
      IFS=$'\t' read -r row_node ns pvc <<<"$row"
      [[ "$row_node" == "$node" ]] || continue
      local_path_safe_name_component "$ns" || continue
      local_path_safe_name_component "$pvc" || continue
      pattern="*_${ns}_${pvc}"
      printf 'remove_pattern_matches %s %s\n' "$(shell_quote "$pattern")" "$(shell_quote "$pattern")"
      emitted=1
    done

    printf 'exit "$remaining"\n'
  } || return 1

  (( emitted == 1 ))
}

wait_local_path_cleanup_pod_done() {
  local ns="$1"
  local pod="$2"
  local timeout_seconds="$3"
  local deadline=$(( $(date +%s) + timeout_seconds ))
  local phase

  while (( $(date +%s) < deadline )); do
    phase="$(kubectl -n "$ns" get pod "$pod" -o jsonpath='{.status.phase}' 2>/dev/null || true)"
    case "$phase" in
      Succeeded)
        return 0
        ;;
      Failed)
        echo "Error: local-path cleanup pod ${ns}/${pod} failed." >&2
        kubectl -n "$ns" logs "$pod" >&2 || true
        return 1
        ;;
    esac
    sleep 2
  done

  echo "Error: timeout waiting for local-path cleanup pod ${ns}/${pod}." >&2
  kubectl -n "$ns" logs "$pod" >&2 || true
  return 1
}

run_local_path_cleanup_pod_for_node() {
  local cleanup_ns="$1"
  local node="$2"
  local root="$3"
  local label="$4"
  local exact_rows_name="$5"
  local pattern_rows_name="$6"
  local script pod node_fragment timeout_seconds rc=0

  script="$(build_local_path_cleanup_script "$node" "$root" "$exact_rows_name" "$pattern_rows_name")" || return 0
  node_fragment="$(sanitize_k8s_name_fragment "$node")"
  node_fragment="${node_fragment:0:32}"
  [[ -z "$node_fragment" ]] && node_fragment="node"
  pod="kubeton-lpp-clean-${node_fragment}-${RANDOM}-${RANDOM}"
  timeout_seconds="$(trim_whitespace "${KUBETON_LOCAL_PATH_CLEANUP_TIMEOUT_SECONDS:-180}")"
  if ! [[ "$timeout_seconds" =~ ^[0-9]+$ ]] || (( timeout_seconds < 30 )); then
    timeout_seconds=180
  fi

  if [[ -n "$root" ]]; then
    echo "[${label}] Purging local-path data on node ${node} under ${root} ..."
  else
    echo "[${label}] Purging exact local-path PV data on node ${node} ..."
  fi
  if ! cat <<EOF | kubectl -n "$cleanup_ns" apply -f - >/dev/null; then
apiVersion: v1
kind: Pod
metadata:
  name: ${pod}
  labels:
    app.kubernetes.io/name: kubeton-local-path-cleanup
    app.kubernetes.io/managed-by: kubeton
spec:
  restartPolicy: Never
  nodeName: $(yaml_quote "$node")
  tolerations:
    - operator: Exists
  containers:
    - name: cleanup
      image: ${KUBETON_LOCAL_PATH_CLEANUP_IMAGE}
      imagePullPolicy: IfNotPresent
      command:
        - /bin/sh
        - -ec
      args:
        - |
$(printf '%s\n' "$script" | sed 's/^/          /')
      securityContext:
        privileged: true
        runAsUser: 0
        allowPrivilegeEscalation: true
      volumeMounts:
        - name: host-root
          mountPath: /host
  volumes:
    - name: host-root
      hostPath:
        path: /
        type: Directory
EOF
    echo "Warning: could not create local-path cleanup pod ${cleanup_ns}/${pod}." >&2
    kubectl -n "$cleanup_ns" delete pod "$pod" --ignore-not-found --wait=false >/dev/null 2>&1 || true
    return 1
  fi

  if ! wait_local_path_cleanup_pod_done "$cleanup_ns" "$pod" "$timeout_seconds"; then
    rc=1
  fi
  kubectl -n "$cleanup_ns" delete pod "$pod" --ignore-not-found --wait=false >/dev/null 2>&1 || true
  return "$rc"
}

run_local_path_cleanup_pod_for_node_with_fallback() {
  local namespaces_name="$1"
  local node="$2"
  local root="$3"
  local label="$4"
  local exact_rows_name="$5"
  local pattern_rows_name="$6"
  local -n namespaces_ref="$namespaces_name"
  local cleanup_ns

  for cleanup_ns in "${namespaces_ref[@]}"; do
    if run_local_path_cleanup_pod_for_node "$cleanup_ns" "$node" "$root" "$label" "$exact_rows_name" "$pattern_rows_name"; then
      return 0
    fi
    echo "Warning: local-path ${label} cleanup could not run in namespace ${cleanup_ns}; trying another eligible namespace." >&2
  done
  return 1
}

cleanup_local_path_provisioner_data() {
  local exact_rows_name="$1"
  local pattern_rows_name="$2"
  local label="${3:-cleanup}"
  local -n exact_rows_ref="$exact_rows_name"
  local -n pattern_rows_ref="$pattern_rows_name"
  local root row node rc=0
  local -a nodes=()
  local -a cleanup_namespaces=()
  local -a cleanup_pids=()
  local -a cleanup_nodes=()
  local i

  is_true "$KUBETON_LOCAL_PATH_CLEANUP" || return 0
  if [[ ${#exact_rows_ref[@]} -eq 0 && ${#pattern_rows_ref[@]} -eq 0 ]]; then
    return 0
  fi

  # Exact PV targets come from the bound PV itself and may live under a custom
  # local-path root.  The configured root is needed only for optional wildcard
  # orphan cleanup.
  root=""
  if [[ ${#pattern_rows_ref[@]} -gt 0 ]]; then
    root="$(local_path_provisioner_root)" || return 1
  fi
  mapfile -t cleanup_namespaces < <(local_path_cleanup_namespaces)
  if [[ ${#cleanup_namespaces[@]} -eq 0 ]]; then
    echo "Error: no usable namespace found for local-path cleanup pod." >&2
    return 1
  fi

  for row in "${exact_rows_ref[@]}"; do
    [[ -z "$row" ]] && continue
    IFS=$'\t' read -r node _ <<<"$row"
    node="$(trim_whitespace "$node")"
    [[ -z "$node" ]] && continue
    append_unique_item "$node" nodes
  done
  for row in "${pattern_rows_ref[@]}"; do
    [[ -z "$row" ]] && continue
    IFS=$'\t' read -r node _ <<<"$row"
    node="$(trim_whitespace "$node")"
    [[ -z "$node" ]] && continue
    append_unique_item "$node" nodes
  done

  for node in "${nodes[@]}"; do
    [[ -z "$node" ]] && continue
    run_local_path_cleanup_pod_for_node_with_fallback cleanup_namespaces "$node" "$root" "$label" "$exact_rows_name" "$pattern_rows_name" &
    cleanup_pids+=("$!")
    cleanup_nodes+=("$node")
  done

  for i in "${!cleanup_pids[@]}"; do
    if ! wait "${cleanup_pids[$i]}"; then
      echo "Warning: local-path ${label} cleanup failed on node ${cleanup_nodes[$i]}." >&2
      rc=1
    fi
  done
  return "$rc"
}

# PVC/PV objects can disappear before a host cleanup pod gets a chance to run.
# Persist the exact, verified host paths first, so a later `kubeton uninstall`
# can finish the cleanup without guessing from a broad directory pattern.
local_path_cleanup_ledger_id() {
  local raw base primary_hash secondary_hash

  raw="${RELEASE_NAME}-${TON_NAMESPACE}"
  base="$(sanitize_k8s_name_fragment "$raw")"
  # cksum is part of POSIX userlands, unlike sha256sum. Use two independent
  # deterministic inputs so every host computes the same, collision-resistant
  # ledger identity without a runtime tool dependency.
  primary_hash="$(printf '%s' "$raw" | cksum | awk '{print $1}')"
  secondary_hash="$(printf '%s:%s' "$raw" "${#raw}" | cksum | awk '{print $1}')"
  printf '%s-%s-%s' "${base:0:8}" "$primary_hash" "$secondary_hash"
}

local_path_cleanup_ledger_name() {
  local name
  name="$(trim_whitespace "${KUBETON_LOCAL_PATH_CLEANUP_LEDGER_NAME:-}")"
  if [[ -n "$name" ]]; then
    if ! [[ "$name" =~ ^[a-z0-9]([a-z0-9.-]*[a-z0-9])?$ ]]; then
      echo "Error: invalid KUBETON_LOCAL_PATH_CLEANUP_LEDGER_NAME='${KUBETON_LOCAL_PATH_CLEANUP_LEDGER_NAME}'." >&2
      return 1
    fi
    if (( ${#name} > 63 )); then
      echo "Error: KUBETON_LOCAL_PATH_CLEANUP_LEDGER_NAME must be at most 63 characters." >&2
      return 1
    fi
    printf '%s' "$name"
    return 0
  fi
  printf 'kubeton-local-path-cleanup-%s' "$(local_path_cleanup_ledger_id)"
}

local_path_cleanup_ledger_namespace() {
  local configured ns phase

  configured="$(trim_whitespace "${KUBETON_LOCAL_PATH_CLEANUP_LEDGER_NAMESPACE:-}")"
  if [[ -n "$configured" ]]; then
    case "$configured" in
      "$OP_NAMESPACE"|"$VAULT_NAMESPACE"|"$LONGHORN_NAMESPACE")
        echo "Error: KUBETON_LOCAL_PATH_CLEANUP_LEDGER_NAMESPACE=${configured} is deleted by kubeton uninstall and cannot retain cleanup state." >&2
        return 1
        ;;
    esac
    if ! kubectl get namespace "$configured" >/dev/null 2>&1; then
      echo "Error: cleanup-ledger namespace ${configured} does not exist." >&2
      return 1
    fi
    phase="$(kubectl get namespace "$configured" -o jsonpath='{.status.phase}' 2>/dev/null || true)"
    if [[ "$phase" == "Terminating" ]]; then
      echo "Error: cleanup-ledger namespace ${configured} is terminating." >&2
      return 1
    fi
    printf '%s' "$configured"
    return 0
  fi

  # This ConfigMap is an authorization boundary for a privileged host cleanup
  # pod. Keep it in kube-system by default rather than an application
  # namespace where a workload may be able to write arbitrary ConfigMaps.
  for ns in kube-system; do
    case "$ns" in
      "$OP_NAMESPACE"|"$VAULT_NAMESPACE"|"$LONGHORN_NAMESPACE") continue ;;
    esac
    kubectl get namespace "$ns" >/dev/null 2>&1 || continue
    phase="$(kubectl get namespace "$ns" -o jsonpath='{.status.phase}' 2>/dev/null || true)"
    [[ "$phase" == "Terminating" ]] && continue
    printf '%s' "$ns"
    return 0
  done

  echo "Error: no durable protected namespace is available for the local-path cleanup ledger. Set KUBETON_LOCAL_PATH_CLEANUP_LEDGER_NAMESPACE to an existing admin-only namespace that kubeton uninstall does not delete." >&2
  return 1
}

list_local_path_cleanup_ledger_locations() {
  local ns name found purpose ledger_id found_ledger_id

  ns="$(local_path_cleanup_ledger_namespace)" || return 1
  name="$(local_path_cleanup_ledger_name)" || return 1
  if ! found="$(kubectl -n "$ns" get configmap "$name" --ignore-not-found -o jsonpath='{.metadata.name}' 2>/dev/null)"; then
    echo "Error: could not inspect local-path cleanup ledger ${ns}/${name}." >&2
    return 1
  fi
  found="$(trim_whitespace "$found")"
  [[ -n "$found" ]] || return 0
  purpose="$(kubectl -n "$ns" get configmap "$name" -o jsonpath='{.metadata.labels.app\.kubernetes\.io/name}' 2>/dev/null || true)"
  found_ledger_id="$(kubectl -n "$ns" get configmap "$name" -o jsonpath='{.metadata.labels.ton\.ton\.org/kubeton-storage-cleanup}' 2>/dev/null || true)"
  ledger_id="$(local_path_cleanup_ledger_id)"
  if [[ "$purpose" != "kubeton-local-path-cleanup-ledger" || "$found_ledger_id" != "$ledger_id" ]]; then
    echo "Error: refusing to use ConfigMap ${ns}/${name} as a local-path cleanup ledger because its ownership labels do not match." >&2
    return 1
  fi
  printf '%s\t%s\n' "$ns" "$name"
}

collect_local_path_cleanup_ledger_rows() {
  local -n rows_ref="$1"
  local ns name contents row node path pv pvc_ref pv_uid pvc_uid extra locations

  locations="$(list_local_path_cleanup_ledger_locations)" || return 1
  [[ -n "$locations" ]] || return 0
  while IFS=$'\t' read -r ns name; do
    ns="$(trim_whitespace "$ns")"
    name="$(trim_whitespace "$name")"
    [[ -n "$ns" && -n "$name" ]] || continue
    if ! contents="$(kubectl -n "$ns" get configmap "$name" -o jsonpath='{.data.targets}' 2>/dev/null)"; then
      echo "Error: could not read local-path cleanup ledger ${ns}/${name}." >&2
      return 1
    fi
    while IFS= read -r row; do
      [[ -n "$row" ]] || continue
      IFS=$'\t' read -r node path pv pvc_ref pv_uid pvc_uid extra <<<"$row"
      node="$(trim_whitespace "$node")"
      path="$(local_path_absolute_target "$path" 2>/dev/null || true)"
      pv="$(trim_whitespace "$pv")"
      pvc_ref="$(trim_whitespace "$pvc_ref")"
      pv_uid="$(trim_whitespace "$pv_uid")"
      pvc_uid="$(trim_whitespace "$pvc_uid")"
      if [[ -n "$extra" || -z "$node" || -z "$path" || -z "$pv" || -z "$pvc_ref" || -z "$pv_uid" || -z "$pvc_uid" ]]; then
        echo "Error: local-path cleanup ledger ${ns}/${name} contains an invalid target record." >&2
        return 1
      fi
      append_unique_item "$node"$'\t'"$path"$'\t'"$pv"$'\t'"$pvc_ref"$'\t'"$pv_uid"$'\t'"$pvc_uid" rows_ref
    done <<<"$contents"
  done <<<"$locations"
}

# `pv-targets` tracks every backed PVC, including CSI volumes with no host
# path. It is deliberately a separate ConfigMap key so existing targets-only
# ledgers remain readable across upgrades.
collect_pv_cleanup_ledger_rows() {
  local -n rows_ref="$1"
  local ns name contents row pv pvc_ref pv_uid pvc_uid reclaim_policy csi_driver volume_handle longhorn_uid extra locations

  locations="$(list_local_path_cleanup_ledger_locations)" || return 1
  [[ -n "$locations" ]] || return 0
  while IFS=$'\t' read -r ns name; do
    ns="$(trim_whitespace "$ns")"
    name="$(trim_whitespace "$name")"
    [[ -n "$ns" && -n "$name" ]] || continue
    if ! contents="$(kubectl -n "$ns" get configmap "$name" -o jsonpath='{.data.pv-targets}' 2>/dev/null)"; then
      echo "Error: could not read PV cleanup targets from ledger ${ns}/${name}." >&2
      return 1
    fi
    while IFS= read -r row; do
      [[ -n "$row" ]] || continue
      IFS=$'\t' read -r pv pvc_ref pv_uid pvc_uid reclaim_policy csi_driver volume_handle longhorn_uid extra <<<"$row"
      pv="$(trim_whitespace "$pv")"
      pvc_ref="$(trim_whitespace "$pvc_ref")"
      pv_uid="$(trim_whitespace "$pv_uid")"
      pvc_uid="$(trim_whitespace "$pvc_uid")"
      reclaim_policy="$(trim_whitespace "$reclaim_policy")"
      csi_driver="$(trim_whitespace "$csi_driver")"
      volume_handle="$(trim_whitespace "$volume_handle")"
      longhorn_uid="$(trim_whitespace "$longhorn_uid")"
      if [[ -n "$extra" || -z "$pv" || -z "$pvc_ref" || -z "$pv_uid" || -z "$pvc_uid" || -z "$reclaim_policy" ]]; then
        echo "Error: local-path cleanup ledger ${ns}/${name} contains an invalid PV target record." >&2
        return 1
      fi
      if [[ "$csi_driver" == "driver.longhorn.io" && -z "$volume_handle" ]]; then
        echo "Error: local-path cleanup ledger ${ns}/${name} has a Longhorn PV target without a volume handle." >&2
        return 1
      fi
      append_unique_item "$pv"$'\t'"$pvc_ref"$'\t'"$pv_uid"$'\t'"$pvc_uid"$'\t'"$reclaim_policy"$'\t'"$csi_driver"$'\t'"$volume_handle"$'\t'"$longhorn_uid" rows_ref
    done <<<"$contents"
  done <<<"$locations"
}

# This separate protected-ledger key authorizes only exact retained TON
# identities explicitly discovered during a confirmed purge. It is never an
# instruction to erase arbitrary Retain rows already present in older ledgers.
collect_retained_purge_authorization_rows() {
  local -n rows_ref="$1"
  local locations ns name contents row pv pvc_ref pv_uid pvc_uid reclaim driver handle backend_uid node path extra separators
  locations="$(list_local_path_cleanup_ledger_locations)" || return 1
  [[ -n "$locations" ]] || return 0
  while IFS=$'\t' read -r ns name; do
    [[ -n "$ns" && -n "$name" ]] || continue
    if ! contents="$(kubectl -n "$ns" get configmap "$name" -o jsonpath='{.data.retained-purge-targets}' 2>/dev/null)"; then
      echo "Error: could not read retained-volume purge authorization from ${ns}/${name}." >&2
      return 1
    fi
    while IFS= read -r row; do
      [[ -n "$row" ]] || continue
      IFS='|' read -r pv pvc_ref pv_uid pvc_uid reclaim driver handle backend_uid node path extra <<<"$row"
      separators="${row//[^|]/}"
      if [[ ${#separators} -ne 9 || "$row" == *$'\t'* || "$row" == *$'\r'* || -n "$extra" || -z "$pv_uid" || -z "$pvc_uid" || "$pv" != "pvc-${pvc_uid}" || "$reclaim" != Retain ]] \
        || ! pvc_is_configured_ton_claim_template "${pvc_ref%%/*}" "${pvc_ref#*/}" \
        || { [[ "$driver" == driver.longhorn.io ]] && [[ -z "$handle" || -n "$node$path" ]]; } \
        || { [[ "$driver" != driver.longhorn.io ]] && [[ -n "$driver$handle$backend_uid" || -z "$node" || -z "$path" ]]; } \
        || { [[ -z "$driver" ]] && { ! local_path_safe_name_component "$node" || ! local_path_absolute_target "$path" >/dev/null; }; }; then
        echo "Error: invalid retained-volume purge authorization in ${ns}/${name}." >&2
        return 1
      fi
      append_unique_item "$row" rows_ref
    done <<<"$contents"
  done <<<"$locations"
}

retained_purge_record_is_authorized() {
  [[ "${KUBETON_RETAIN_PURGE_CONFIRMED:-false}" == true ]] || return 1
  local pv="$1" pvc_ref="$2" pv_uid="$3" pvc_uid="$4" driver="${5:-}" handle="${6:-}" backend_uid="${7:-}" node="${8:-}" path="${9:-}"
  local row expected
  local -a authorization_rows=()
  pvc_is_configured_ton_claim_template "${pvc_ref%%/*}" "${pvc_ref#*/}" || return 1
  expected="${pv}|${pvc_ref}|${pv_uid}|${pvc_uid}|Retain|${driver}|${handle}|${backend_uid}|${node}|${path}"
  collect_retained_purge_authorization_rows authorization_rows || return 1
  for row in "${authorization_rows[@]}"; do
    [[ "$row" == "$expected" ]] && return 0
  done
  return 1
}

retained_purge_longhorn_is_detached() {
  local handle="$1" expected_uid="$2" identity uid state node current_node namespace_uid
  namespace_uid="$(kubectl get namespace "$LONGHORN_NAMESPACE" --ignore-not-found -o jsonpath='{.metadata.uid}' 2>/dev/null)" || return 1
  [[ -n "$namespace_uid" ]] || return 0
  identity="$(kubectl -n "$LONGHORN_NAMESPACE" get volumes.longhorn.io "$handle" --ignore-not-found \
    -o jsonpath='{.metadata.uid}{"|"}{.status.state}{"|"}{.spec.nodeID}{"|"}{.status.currentNodeID}' 2>/dev/null)" || return 1
  IFS='|' read -r uid state node current_node <<<"$identity"
  [[ -z "$uid" ]] && return 0
  [[ "$uid" == "$expected_uid" && "$state" == detached && -z "$node$current_node" ]]
}

storage_cleanup_ledger_has_pending_longhorn_targets() {
  local -a pv_rows=()
  local row pv pvc_ref pv_uid pvc_uid reclaim_policy csi_driver volume_handle longhorn_uid

  collect_pv_cleanup_ledger_rows pv_rows || return 2
  for row in "${pv_rows[@]}"; do
    [[ -n "$row" ]] || continue
    IFS=$'\t' read -r pv pvc_ref pv_uid pvc_uid reclaim_policy csi_driver volume_handle longhorn_uid <<<"$row"
    [[ "$csi_driver" == "driver.longhorn.io" ]] && return 0
  done
  return 1
}

record_local_path_cleanup_ledger() {
  local exact_rows_name="$1"
  local pv_rows_name="${2:-}"
  local authorization_rows_name="${3:-}"
  local -n exact_rows_ref="$exact_rows_name"
  local -a retained_authorization_rows=()
  local -a ledger_rows=()
  local -a pv_ledger_rows=()
  local row ledger_ns ledger_name targets_file pv_targets_file authorization_file ledger_id existing_name existing_purpose existing_id

  collect_local_path_cleanup_ledger_rows ledger_rows || return 1
  collect_pv_cleanup_ledger_rows pv_ledger_rows || return 1
  collect_retained_purge_authorization_rows retained_authorization_rows || return 1
  if [[ -n "$authorization_rows_name" ]]; then
    [[ "${KUBETON_RETAIN_PURGE_CONFIRMED:-false}" == true ]] || return 1
    local -n requested_authorization_rows_ref="$authorization_rows_name"
    for row in "${requested_authorization_rows_ref[@]}"; do
      [[ -n "$row" ]] && append_unique_item "$row" retained_authorization_rows
    done
  fi
  for row in "${exact_rows_ref[@]}"; do
    [[ -n "$row" ]] && append_unique_item "$row" ledger_rows
  done
  if [[ -n "$pv_rows_name" ]]; then
    local -n requested_pv_rows_ref="$pv_rows_name"
    for row in "${requested_pv_rows_ref[@]}"; do
      [[ -n "$row" ]] && append_unique_item "$row" pv_ledger_rows
    done
  fi
  [[ ${#ledger_rows[@]} -gt 0 || ${#pv_ledger_rows[@]} -gt 0 ]] || return 0

  ledger_ns="$(local_path_cleanup_ledger_namespace)" || return 1
  ledger_name="$(local_path_cleanup_ledger_name)" || return 1
  ledger_id="$(local_path_cleanup_ledger_id)"

  targets_file="$(mktemp "${TMPDIR:-/tmp}/kubeton-local-path-ledger-targets.XXXXXX")" || return 1
  pv_targets_file="$(mktemp "${TMPDIR:-/tmp}/kubeton-local-path-ledger-pvs.XXXXXX")" || {
    rm -f "$targets_file"
    return 1
  }
  authorization_file="$(mktemp "${TMPDIR:-/tmp}/kubeton-retained-purge-ledger.XXXXXX")" || {
    rm -f "$targets_file" "$pv_targets_file" "${authorization_file:-}"
    return 1
  }
  printf '%s\n' "${retained_authorization_rows[@]}" >"$authorization_file"
  printf '%s\n' "${ledger_rows[@]}" >"$targets_file"
  printf '%s\n' "${pv_ledger_rows[@]}" >"$pv_targets_file"
  if ! existing_name="$(kubectl -n "$ledger_ns" get configmap "$ledger_name" --ignore-not-found -o jsonpath='{.metadata.name}' 2>/dev/null)"; then
    rm -f "$targets_file" "$pv_targets_file" "${authorization_file:-}"
    echo "Error: could not inspect local-path cleanup ledger ${ledger_ns}/${ledger_name}; leaving PVCs intact." >&2
    return 1
  fi
  existing_name="$(trim_whitespace "$existing_name")"
  if [[ -n "$existing_name" ]]; then
    existing_purpose="$(kubectl -n "$ledger_ns" get configmap "$ledger_name" -o jsonpath='{.metadata.labels.app\.kubernetes\.io/name}' 2>/dev/null || true)"
    existing_id="$(kubectl -n "$ledger_ns" get configmap "$ledger_name" -o jsonpath='{.metadata.labels.ton\.ton\.org/kubeton-storage-cleanup}' 2>/dev/null || true)"
    if [[ "$existing_purpose" != "kubeton-local-path-cleanup-ledger" || "$existing_id" != "$ledger_id" ]]; then
      rm -f "$targets_file" "$pv_targets_file" "${authorization_file:-}"
      echo "Error: refusing to overwrite non-kubeton ConfigMap ${ledger_ns}/${ledger_name} with cleanup state." >&2
      return 1
    fi
  elif kubectl -n "$ledger_ns" create configmap "$ledger_name" --from-file=targets="$targets_file" --from-file=pv-targets="$pv_targets_file" --from-file=retained-purge-targets="$authorization_file" --dry-run=client -o yaml \
    | kubectl label --local -f - \
      app.kubernetes.io/name=kubeton-local-path-cleanup-ledger \
      "ton.ton.org/kubeton-storage-cleanup=${ledger_id}" --overwrite -o yaml \
    | kubectl -n "$ledger_ns" create -f - >/dev/null; then
    rm -f "$targets_file" "$pv_targets_file" "${authorization_file:-}"
    return 0
  else
    rm -f "$targets_file" "$pv_targets_file" "${authorization_file:-}"
    echo "Error: could not create local-path cleanup ledger ${ledger_ns}/${ledger_name}; leaving PVCs intact." >&2
    return 1
  fi

  if ! kubectl -n "$ledger_ns" create configmap "$ledger_name" --from-file=targets="$targets_file" --from-file=pv-targets="$pv_targets_file" --from-file=retained-purge-targets="$authorization_file" --dry-run=client -o yaml \
    | kubectl label --local -f - \
      app.kubernetes.io/name=kubeton-local-path-cleanup-ledger \
      "ton.ton.org/kubeton-storage-cleanup=${ledger_id}" --overwrite -o yaml \
    | kubectl apply -f - >/dev/null; then
    rm -f "$targets_file" "$pv_targets_file" "${authorization_file:-}"
    echo "Error: could not persist local-path cleanup ledger ${ledger_ns}/${ledger_name}; leaving PVCs intact." >&2
    return 1
  fi
  rm -f "$targets_file" "$pv_targets_file" "${authorization_file:-}"
}

# Make sure a recorded directory is not referenced by any other current
# hostPath/local PV before the privileged cleanup pod removes it.  This is
# needed whether the recorded PV is already gone or is still present: a static
# or rebound PV can share the same directory in either case.
local_path_target_is_exclusive_to_recorded_pv() {
  local expected_path="$1"
  local expected_pv="$2"
  local expected_pv_uid="$3"
  local pv_names candidate_pv candidate_uid candidate_path

  if ! pv_names="$(kubectl get pv -o jsonpath='{range .items[*]}{.metadata.name}{"\n"}{end}' 2>/dev/null)"; then
    echo "Error: could not check whether local-path target ${expected_path} was rebound to another PV." >&2
    return 1
  fi
  while IFS= read -r candidate_pv; do
    candidate_pv="$(trim_whitespace "$candidate_pv")"
    [[ -n "$candidate_pv" ]] || continue
    if ! candidate_uid="$(kubectl get pv "$candidate_pv" --ignore-not-found -o jsonpath='{.metadata.uid}' 2>/dev/null)"; then
      echo "Error: could not inspect PV ${candidate_pv} while checking local-path target ${expected_path}." >&2
      return 1
    fi
    candidate_uid="$(trim_whitespace "$candidate_uid")"
    [[ -n "$candidate_uid" ]] || continue
    if ! candidate_path="$(local_path_pv_host_path "$candidate_pv")"; then
      return 1
    fi
    candidate_path="$(local_path_absolute_target "$candidate_path" 2>/dev/null || true)"
    [[ "$candidate_path" == "$expected_path" ]] || continue
    if [[ "$candidate_pv" == "$expected_pv" && "$candidate_uid" == "$expected_pv_uid" ]]; then
      continue
    fi
    echo "Error: refusing to remove local-path target ${expected_path}: it is currently referenced by PV ${candidate_pv} (UID ${candidate_uid})." >&2
    return 1
  done <<<"$pv_names"
  return 0
}

local_path_recorded_pv_can_be_deleted() {
  local pv="$1"
  local expected_path="$2"
  local pvc_ref="$3"
  local expected_pv_uid="$4"
  local expected_pvc_uid="$5"
  local expected_node="$6"
  local discovery_reclaim="${7:-}"
  local actual_path actual_identity actual_pv_uid actual_reclaim_policy expected_ns expected_pvc actual_ns actual_pvc actual_pvc_uid live_pvc_uid namespace_marker claim_ref node
  local -a pv_nodes=()

  if ! actual_identity="$(kubectl get pv "$pv" --ignore-not-found -o jsonpath='{.metadata.uid}{"\t"}{.spec.persistentVolumeReclaimPolicy}' 2>/dev/null)"; then
    echo "Error: could not verify recorded PV ${pv} before local-path cleanup." >&2
    return 1
  fi
  IFS=$'\t' read -r actual_pv_uid actual_reclaim_policy <<<"$actual_identity"
  actual_pv_uid="$(trim_whitespace "$actual_pv_uid")"
  actual_reclaim_policy="$(trim_whitespace "$actual_reclaim_policy")"
  if [[ -z "$actual_pv_uid" ]]; then
    local_path_target_is_exclusive_to_recorded_pv "$expected_path" "$pv" "$expected_pv_uid"
    return $?
  fi
  if [[ -z "$actual_pv_uid" || "$actual_pv_uid" != "$expected_pv_uid" ]]; then
    echo "Error: refusing to delete PV ${pv}: its UID no longer matches the cleanup ledger." >&2
    return 1
  fi
  if [[ "$actual_reclaim_policy" != Delete ]]; then
    if [[ "$actual_reclaim_policy" != Retain ]] || {
      ! retained_purge_record_is_authorized "$pv" "$pvc_ref" "$expected_pv_uid" "$expected_pvc_uid" "" "" "" "$expected_node" "$expected_path" && {
        [[ "$discovery_reclaim" != Retain || "${KUBETON_RETAIN_PURGE_CONFIRMED:-false}" != true ]] ||
          ! pvc_is_configured_ton_claim_template "${pvc_ref%%/*}" "${pvc_ref#*/}"
      }
    }; then
      echo "Error: refusing local-path cleanup for PV ${pv}: reclaimPolicy ${actual_reclaim_policy:-unknown} lacks exact confirmed-purge authorization." >&2
      return 1
    fi
  fi
  if ! actual_path="$(local_path_pv_host_path "$pv")"; then
    return 1
  fi
  actual_path="$(local_path_absolute_target "$actual_path" 2>/dev/null || true)"
  if [[ -z "$actual_path" || "$actual_path" != "$expected_path" ]]; then
    echo "Error: refusing to delete PV ${pv}: its host path no longer matches the cleanup ledger." >&2
    return 1
  fi
  if ! local_path_pv_is_provisioned_by_local_path "$pv"; then
    echo "Error: refusing to delete PV ${pv}: it is no longer a verified local-path PV." >&2
    return 1
  fi
  if ! collect_local_path_nodes_for_pv "$pv" pv_nodes || [[ ${#pv_nodes[@]} -ne 1 ]]; then
    echo "Error: refusing to delete PV ${pv}: its local-path node affinity is no longer uniquely resolvable." >&2
    return 1
  fi
  node="${pv_nodes[0]}"
  if [[ "$node" != "$expected_node" ]]; then
    echo "Error: refusing to delete PV ${pv}: its local-path node no longer matches the cleanup ledger." >&2
    return 1
  fi

  IFS=/ read -r expected_ns expected_pvc <<<"$pvc_ref"
  if ! claim_ref="$(kubectl get pv "$pv" -o jsonpath='{.spec.claimRef.namespace}{"\t"}{.spec.claimRef.name}{"\t"}{.spec.claimRef.uid}' 2>/dev/null)"; then
    echo "Error: could not verify claimRef for recorded PV ${pv}." >&2
    return 1
  fi
  IFS=$'\t' read -r actual_ns actual_pvc actual_pvc_uid <<<"$claim_ref"
  actual_ns="$(trim_whitespace "$actual_ns")"
  actual_pvc="$(trim_whitespace "$actual_pvc")"
  actual_pvc_uid="$(trim_whitespace "$actual_pvc_uid")"
  if [[ -n "$actual_ns" || -n "$actual_pvc" || -n "$actual_pvc_uid" ]]; then
    if [[ "$actual_ns" != "$expected_ns" || "$actual_pvc" != "$expected_pvc" || "$actual_pvc_uid" != "$expected_pvc_uid" ]]; then
      echo "Error: refusing to delete PV ${pv}: its claimRef no longer matches the cleanup ledger." >&2
      return 1
    fi
  fi
  if ! namespace_marker="$(kubectl get namespace "$expected_ns" --ignore-not-found -o jsonpath='{.metadata.uid}' 2>/dev/null)"; then
    echo "Error: could not verify namespace ${expected_ns} before local-path cleanup." >&2
    return 1
  fi
  namespace_marker="$(trim_whitespace "$namespace_marker")"
  if [[ -n "$namespace_marker" ]]; then
    if ! live_pvc_uid="$(kubectl -n "$expected_ns" get pvc "$expected_pvc" --ignore-not-found -o jsonpath='{.metadata.uid}' 2>/dev/null)"; then
      echo "Error: could not verify PVC ${expected_ns}/${expected_pvc} before local-path cleanup." >&2
      return 1
    fi
    live_pvc_uid="$(trim_whitespace "$live_pvc_uid")"
  else
    live_pvc_uid=""
  fi
  if [[ -n "$live_pvc_uid" ]]; then
    echo "Error: refusing to delete PV ${pv}: PVC ${expected_ns}/${expected_pvc} exists again." >&2
    return 1
  fi
  if ! local_path_target_is_exclusive_to_recorded_pv "$expected_path" "$pv" "$expected_pv_uid"; then
    return 1
  fi
  return 0
}

pvc_has_pod_references() {
  local ns="$1"
  local pvc="$2"
  local pod claims claim rows namespace_name namespace_phase
  local -a referenced_pods=()
  local -a claim_rows=()

  if ! namespace_name="$(kubectl get namespace "$ns" --ignore-not-found -o jsonpath='{.metadata.name}' 2>/dev/null)"; then
    echo "Error: could not verify namespace ${ns} before local-path cleanup." >&2
    return 0
  fi
  namespace_name="$(trim_whitespace "$namespace_name")"
  # A deleted namespace cannot contain a pod still mounting the old PVC.
  [[ -n "$namespace_name" ]] || return 1
  namespace_phase="$(kubectl get namespace "$ns" -o jsonpath='{.status.phase}' 2>/dev/null || true)"
  if [[ "$namespace_phase" == "Terminating" ]]; then
    echo "Error: namespace ${ns} is terminating; cannot verify pod references for PVC ${ns}/${pvc}." >&2
    return 0
  fi
  if ! rows="$(kubectl -n "$ns" get pods \
    -o jsonpath='{range .items[*]}{.metadata.name}{"\t"}{range .spec.volumes[*]}{.persistentVolumeClaim.claimName}{","}{end}{"\n"}{end}' 2>/dev/null)"; then
    echo "Error: could not verify pod references for PVC ${ns}/${pvc}." >&2
    return 0
  fi
  while IFS=$'\t' read -r pod claims; do
    pod="$(trim_whitespace "$pod")"
    [[ -n "$pod" ]] || continue
    IFS=',' read -r -a claim_rows <<<"$claims"
    for claim in "${claim_rows[@]}"; do
      claim="$(trim_whitespace "$claim")"
      [[ "$claim" == "$pvc" ]] && append_unique_item "$pod" referenced_pods
    done
  done <<<"$rows"

  if [[ ${#referenced_pods[@]} -eq 0 ]]; then
    return 1
  fi
  echo "Error: refusing destructive PVC/host cleanup while pod(s) still reference ${ns}/${pvc}: ${referenced_pods[*]}" >&2
  return 0
}

verify_no_pod_references_for_pvc() {
  local ns="$1"
  local pvc="$2"

  if pvc_has_pod_references "$ns" "$pvc"; then
    return 1
  fi
  return 0
}

# Host data is destructive to remove, so a local-path target requires a Delete
# record or exact retained-volume authorization from a confirmed purge. Older
# ledgers without a PV record require the still-live PV to prove Delete.
verify_recorded_local_path_targets_use_delete_reclaim_policy() {
  local exact_rows_name="$1"
  local pv_rows_name="$2"
  local -n exact_rows_ref="$exact_rows_name"
  local -n pv_rows_ref="$pv_rows_name"
  local row pv_row node path pv pvc_ref pv_uid pvc_uid recorded_pv recorded_pvc_ref recorded_pv_uid recorded_pvc_uid recorded_reclaim matching_rows same_name_rows current_reclaim
  local -A exact_identities=()

  for row in "${exact_rows_ref[@]}"; do
    [[ -n "$row" ]] || continue
    IFS=$'\t' read -r node path pv pvc_ref pv_uid pvc_uid <<<"$row"
    pv="$(trim_whitespace "$pv")"
    [[ -n "$pv" ]] || return 1
    local exact_identity="${pvc_ref}|${pv_uid}|${pvc_uid}|${path}"
    if [[ -n "${exact_identities[$pv]+present}" && "${exact_identities[$pv]}" != "$exact_identity" ]]; then
      echo "Error: refusing local-path cleanup for reused PV name ${pv}: the cleanup ledger has multiple target identities." >&2
      return 1
    fi
    exact_identities[$pv]="$exact_identity"
  done

  for row in "${exact_rows_ref[@]}"; do
    [[ -n "$row" ]] || continue
    IFS=$'\t' read -r node path pv pvc_ref pv_uid pvc_uid <<<"$row"
    pv="$(trim_whitespace "$pv")"
    [[ -n "$pv" ]] || return 1
    matching_rows=0
    same_name_rows=0
    recorded_reclaim=""
    for pv_row in "${pv_rows_ref[@]}"; do
      [[ -n "$pv_row" ]] || continue
      IFS=$'\t' read -r recorded_pv recorded_pvc_ref recorded_pv_uid recorded_pvc_uid recorded_reclaim _ <<<"$pv_row"
      recorded_pv="$(trim_whitespace "$recorded_pv")"
      [[ "$recorded_pv" == "$pv" ]] || continue
      ((same_name_rows+=1))
      if [[ "$recorded_pvc_ref" != "$pvc_ref" || "$recorded_pv_uid" != "$pv_uid" || "$recorded_pvc_uid" != "$pvc_uid" ]]; then
        continue
      fi
      ((matching_rows+=1))
      recorded_reclaim="$(trim_whitespace "$recorded_reclaim")"
    done
    if (( same_name_rows > 1 )); then
      echo "Error: refusing local-path cleanup for PV ${pv}: the cleanup ledger has multiple lifetimes for that PV name." >&2
      return 1
    fi
    if (( matching_rows == 1 )); then
      if [[ "$recorded_reclaim" != Delete ]] && {
        [[ "$recorded_reclaim" != Retain ]] || ! retained_purge_record_is_authorized "$pv" "$pvc_ref" "$pv_uid" "$pvc_uid" "" "" "" "$node" "$path";
      }; then
        echo "Error: refusing local-path cleanup for PV ${pv}: cleanup ledger recorded reclaimPolicy ${recorded_reclaim:-unknown} without exact confirmed-purge authorization." >&2
        return 1
      fi
      continue
    fi
    if (( same_name_rows == 1 )); then
      echo "Error: refusing local-path cleanup for PV ${pv}: its PV/PVC identity does not match the cleanup ledger." >&2
      return 1
    fi

    if ! current_reclaim="$(kubectl get pv "$pv" --ignore-not-found -o jsonpath='{.spec.persistentVolumeReclaimPolicy}' 2>/dev/null)"; then
      echo "Error: cannot verify reclaimPolicy for legacy local-path target PV ${pv}." >&2
      return 1
    fi
    current_reclaim="$(trim_whitespace "$current_reclaim")"
    if [[ "$current_reclaim" != "Delete" ]]; then
      echo "Error: refusing local-path cleanup for legacy target PV ${pv}: reclaimPolicy is ${current_reclaim:-unknown}, not Delete." >&2
      return 1
    fi
  done
  return 0
}

verify_recorded_local_path_targets_safe_for_host_cleanup() {
  local exact_rows_name="$1"
  local -n exact_rows_ref="$exact_rows_name"
  local row node path pv pvc_ref pv_uid pvc_uid ns pvc live_pvc_uid namespace_marker

  for row in "${exact_rows_ref[@]}"; do
    [[ -n "$row" ]] || continue
    IFS=$'\t' read -r node path pv pvc_ref pv_uid pvc_uid <<<"$row"
    IFS=/ read -r ns pvc <<<"$pvc_ref"
    ns="$(trim_whitespace "$ns")"
    pvc="$(trim_whitespace "$pvc")"
    if [[ -z "$ns" || -z "$pvc" ]]; then
      echo "Error: cleanup ledger has an invalid PVC reference for PV ${pv}." >&2
      return 1
    fi
    if ! namespace_marker="$(kubectl get namespace "$ns" --ignore-not-found -o jsonpath='{.metadata.uid}' 2>/dev/null)"; then
      echo "Error: could not verify namespace ${ns} before local-path cleanup." >&2
      return 1
    fi
    namespace_marker="$(trim_whitespace "$namespace_marker")"
    if [[ -n "$namespace_marker" ]]; then
      if ! live_pvc_uid="$(kubectl -n "$ns" get pvc "$pvc" --ignore-not-found -o jsonpath='{.metadata.uid}' 2>/dev/null)"; then
        echo "Error: could not verify PVC ${ns}/${pvc} before local-path cleanup." >&2
        return 1
      fi
      live_pvc_uid="$(trim_whitespace "$live_pvc_uid")"
    else
      live_pvc_uid=""
    fi
    if [[ -n "$live_pvc_uid" ]]; then
      echo "Error: refusing local-path host cleanup: PVC ${ns}/${pvc} exists again." >&2
      return 1
    fi
    if ! verify_no_pod_references_for_pvc "$ns" "$pvc"; then
      return 1
    fi
    if ! local_path_recorded_pv_can_be_deleted "$pv" "$path" "$pvc_ref" "$pv_uid" "$pvc_uid" "$node"; then
      return 1
    fi
  done
}

delete_recorded_local_path_pvs() {
  local exact_rows_name="$1"
  local label="${2:-cleanup}"
  local -n exact_rows_ref="$exact_rows_name"
  local row node path pv pvc_ref expected_pv_uid pvc_uid actual_pv_uid final_pv_uid rc=0
  local -a processed_pvs=()

  for row in "${exact_rows_ref[@]}"; do
    [[ -n "$row" ]] || continue
    IFS=$'\t' read -r node path pv pvc_ref expected_pv_uid pvc_uid <<<"$row"
    pv="$(trim_whitespace "$pv")"
    [[ -n "$pv" ]] || { rc=1; continue; }
    if [[ " ${processed_pvs[*]} " == *" ${pv} "* ]]; then
      continue
    fi
    processed_pvs+=("$pv")
    if ! local_path_recorded_pv_can_be_deleted "$pv" "$path" "$pvc_ref" "$expected_pv_uid" "$pvc_uid" "$node"; then
      rc=1
      continue
    fi
    if ! actual_pv_uid="$(kubectl get pv "$pv" --ignore-not-found -o jsonpath='{.metadata.uid}' 2>/dev/null)"; then
      echo "Error: could not verify recorded PV ${pv} before deletion." >&2
      rc=1
      continue
    fi
    actual_pv_uid="$(trim_whitespace "$actual_pv_uid")"
    if [[ -z "$actual_pv_uid" ]]; then
      continue
    fi
    if [[ "$actual_pv_uid" != "$expected_pv_uid" ]]; then
      echo "Error: refusing to delete PV ${pv}: its UID changed after local-path cleanup was verified." >&2
      rc=1
      continue
    fi
    if ! ensure_volume_attachments_gone_for_pv "$pv"; then
      rc=1
      continue
    fi
    # The attachment wait can take long enough for a name to be reused. Check
    # immediately before the destructive API call rather than deleting by a
    # stale PV name alone.
    if ! final_pv_uid="$(kubectl get pv "$pv" --ignore-not-found -o jsonpath='{.metadata.uid}' 2>/dev/null)"; then
      echo "Error: could not recheck recorded PV ${pv} immediately before deletion." >&2
      rc=1
      continue
    fi
    final_pv_uid="$(trim_whitespace "$final_pv_uid")"
    if [[ -z "$final_pv_uid" ]]; then
      continue
    fi
    if [[ "$final_pv_uid" != "$expected_pv_uid" ]]; then
      echo "Error: refusing to delete PV ${pv}: its UID changed immediately before deletion." >&2
      rc=1
      continue
    fi
    echo "[${label}] Deleting verified local-path PV ${pv} ..."
    if ! delete_pv_and_wait_for_gone "$pv" 180 60; then
      rc=1
    fi
  done
  return "$rc"
}

recorded_pvc_is_absent_and_unmounted() {
  local pvc_ref="$1"
  local expected_pvc_uid="$2"
  local ns pvc namespace_marker live_pvc_uid

  IFS=/ read -r ns pvc <<<"$pvc_ref"
  ns="$(trim_whitespace "$ns")"
  pvc="$(trim_whitespace "$pvc")"
  if [[ -z "$ns" || -z "$pvc" || -z "$expected_pvc_uid" ]]; then
    echo "Error: cleanup ledger has an invalid PVC identity." >&2
    return 1
  fi
  if ! namespace_marker="$(kubectl get namespace "$ns" --ignore-not-found -o jsonpath='{.metadata.uid}' 2>/dev/null)"; then
    echo "Error: could not verify namespace ${ns} before storage cleanup." >&2
    return 1
  fi
  namespace_marker="$(trim_whitespace "$namespace_marker")"
  if [[ -n "$namespace_marker" ]]; then
    if ! live_pvc_uid="$(kubectl -n "$ns" get pvc "$pvc" --ignore-not-found -o jsonpath='{.metadata.uid}' 2>/dev/null)"; then
      echo "Error: could not verify PVC ${ns}/${pvc} before storage cleanup." >&2
      return 1
    fi
    live_pvc_uid="$(trim_whitespace "$live_pvc_uid")"
    if [[ -n "$live_pvc_uid" ]]; then
      echo "Error: refusing storage cleanup: PVC ${ns}/${pvc} exists again (UID ${live_pvc_uid})." >&2
      return 1
    fi
  fi
  if ! verify_no_pod_references_for_pvc "$ns" "$pvc"; then
    return 1
  fi
  return 0
}

recorded_pv_matches_cleanup_ledger() {
  local pv="$1"
  local pvc_ref="$2"
  local expected_pv_uid="$3"
  local expected_pvc_uid="$4"
  local expected_reclaim_policy="$5"
  local expected_csi_driver="$6"
  local expected_volume_handle="$7"
  local pv_identity actual_pv_uid actual_ns actual_pvc actual_pvc_uid actual_reclaim_policy actual_csi_driver actual_volume_handle

  if ! recorded_pvc_is_absent_and_unmounted "$pvc_ref" "$expected_pvc_uid"; then
    return 1
  fi
  if ! pv_identity="$(kubectl get pv "$pv" --ignore-not-found \
    -o jsonpath='{.metadata.uid}{"\t"}{.spec.claimRef.namespace}{"\t"}{.spec.claimRef.name}{"\t"}{.spec.claimRef.uid}{"\t"}{.spec.persistentVolumeReclaimPolicy}{"\t"}{.spec.csi.driver}{"\t"}{.spec.csi.volumeHandle}' 2>/dev/null)"; then
    echo "Error: could not verify recorded PV ${pv} before cleanup." >&2
    return 1
  fi
  IFS=$'\t' read -r actual_pv_uid actual_ns actual_pvc actual_pvc_uid actual_reclaim_policy actual_csi_driver actual_volume_handle <<<"$pv_identity"
  actual_pv_uid="$(trim_whitespace "$actual_pv_uid")"
  # The PV may already have been deleted during an earlier partial teardown.
  [[ -n "$actual_pv_uid" ]] || return 0
  actual_ns="$(trim_whitespace "$actual_ns")"
  actual_pvc="$(trim_whitespace "$actual_pvc")"
  actual_pvc_uid="$(trim_whitespace "$actual_pvc_uid")"
  actual_reclaim_policy="$(trim_whitespace "$actual_reclaim_policy")"
  actual_csi_driver="$(trim_whitespace "$actual_csi_driver")"
  actual_volume_handle="$(trim_whitespace "$actual_volume_handle")"
  if [[ "$actual_pv_uid" != "$expected_pv_uid" ]]; then
    echo "Error: refusing to delete PV ${pv}: its UID no longer matches the cleanup ledger." >&2
    return 1
  fi
  if [[ "$actual_reclaim_policy" != "$expected_reclaim_policy" || "$actual_csi_driver" != "$expected_csi_driver" || "$actual_volume_handle" != "$expected_volume_handle" ]]; then
    echo "Error: refusing to delete PV ${pv}: its storage identity no longer matches the cleanup ledger." >&2
    return 1
  fi
  if [[ -n "$actual_ns$actual_pvc$actual_pvc_uid" ]]; then
    local expected_ns expected_pvc
    IFS=/ read -r expected_ns expected_pvc <<<"$pvc_ref"
    if [[ "$actual_ns" != "$expected_ns" || "$actual_pvc" != "$expected_pvc" || "$actual_pvc_uid" != "$expected_pvc_uid" ]]; then
      echo "Error: refusing to delete PV ${pv}: its claimRef no longer matches the cleanup ledger." >&2
      return 1
    fi
  fi
  return 0
}

recorded_longhorn_volume_matches_cleanup_ledger() {
  local csi_driver="$1"
  local volume_handle="$2"
  local expected_volume_uid="$3"
  local namespace_marker actual_volume_uid

  [[ "$csi_driver" == "driver.longhorn.io" ]] || return 0
  [[ -n "$volume_handle" ]] || return 1
  if ! namespace_marker="$(kubectl get namespace "$LONGHORN_NAMESPACE" --ignore-not-found -o jsonpath='{.metadata.uid}' 2>/dev/null)"; then
    echo "Error: could not verify Longhorn namespace ${LONGHORN_NAMESPACE}." >&2
    return 1
  fi
  namespace_marker="$(trim_whitespace "$namespace_marker")"
  # If Longhorn itself is gone, its Volume CRs are gone as well.
  [[ -n "$namespace_marker" ]] || return 0
  if ! actual_volume_uid="$(kubectl -n "$LONGHORN_NAMESPACE" get volumes.longhorn.io "$volume_handle" --ignore-not-found -o jsonpath='{.metadata.uid}' 2>/dev/null)"; then
    echo "Error: could not verify Longhorn volume ${volume_handle}." >&2
    return 1
  fi
  actual_volume_uid="$(trim_whitespace "$actual_volume_uid")"
  if [[ -z "$expected_volume_uid" ]]; then
    if [[ -n "$actual_volume_uid" ]]; then
      echo "Error: refusing to delete Longhorn volume ${volume_handle}: it did not exist when cleanup state was recorded." >&2
      return 1
    fi
    return 0
  fi
  if [[ -n "$actual_volume_uid" && "$actual_volume_uid" != "$expected_volume_uid" ]]; then
    echo "Error: refusing to delete Longhorn volume ${volume_handle}: its UID no longer matches the cleanup ledger." >&2
    return 1
  fi
  return 0
}

# A CSI volumeHandle is a backend identity, but an old PV can disappear while
# a different static/rebound PV starts using the same handle. Never ask a CSI
# controller to delete a PV unless that handle is still exclusive to the
# recorded PV. This applies to generic CSI drivers as well as Longhorn.
csi_volume_handle_is_exclusive_to_recorded_pv() {
  local expected_pv="$1"
  local expected_pv_uid="$2"
  local csi_driver="$3"
  local volume_handle="$4"
  local recorded_pv_current_uid="${5:-}"
  local rows row pv pv_uid current_driver current_handle

  [[ -n "$csi_driver" && -n "$volume_handle" ]] || return 0
  if ! rows="$(kubectl get pv -o jsonpath='{range .items[*]}{.metadata.name}{"\t"}{.metadata.uid}{"\t"}{.spec.csi.driver}{"\t"}{.spec.csi.volumeHandle}{"\n"}{end}' 2>/dev/null)"; then
    echo "Error: could not check whether CSI volume handle ${volume_handle} (${csi_driver}) is referenced by another PV." >&2
    return 1
  fi
  while IFS=$'\t' read -r pv pv_uid current_driver current_handle; do
    pv="$(trim_whitespace "$pv")"
    pv_uid="$(trim_whitespace "$pv_uid")"
    current_driver="$(trim_whitespace "$current_driver")"
    current_handle="$(trim_whitespace "$current_handle")"
    [[ "$current_driver" == "$csi_driver" && "$current_handle" == "$volume_handle" ]] || continue
    if [[ -z "$recorded_pv_current_uid" || "$pv" != "$expected_pv" || "$pv_uid" != "$expected_pv_uid" ]]; then
      echo "Error: refusing to delete CSI volume handle ${volume_handle} (${csi_driver}): it is now referenced by PV ${pv} (UID ${pv_uid})." >&2
      return 1
    fi
  done <<<"$rows"
  return 0
}

# Retain the narrower helper name for Longhorn-specific callers and tests;
# its safety check is shared with every CSI driver above.
longhorn_volume_handle_is_exclusive_to_recorded_pv() {
  csi_volume_handle_is_exclusive_to_recorded_pv "$1" "$2" driver.longhorn.io "$3" "${4:-}"
}

delete_recorded_pv_cleanup_targets() {
  local rows_name="$1"
  local label="${2:-cleanup}"
  local local_rows_name="${3:-}"
  local -n rows_ref="$rows_name"
  local row pv pvc_ref pv_uid pvc_uid reclaim_policy csi_driver volume_handle longhorn_uid actual_pv_uid final_pv_uid actual_longhorn_uid longhorn_namespace_uid rc=0
  local -a processed_pvs=()
  local -a local_pvs=()
  local -A pv_identities=()
  local -A csi_volume_handle_identities=()

  if [[ -n "$local_rows_name" ]]; then
    local -n local_rows_ref="$local_rows_name"
    local local_row local_pv
    for local_row in "${local_rows_ref[@]}"; do
      [[ -n "$local_row" ]] || continue
      IFS=$'\t' read -r _ _ local_pv _ <<<"$local_row"
      local_pv="$(trim_whitespace "$local_pv")"
      [[ -n "$local_pv" ]] && append_unique_item "$local_pv" local_pvs
    done
  fi

  # A name can be reused across PVC/PV lifetimes. Treat differing ledger
  # identities for the same name as a conflict instead of picking one row and
  # silently clearing the other backend volume.
  for row in "${rows_ref[@]}"; do
    [[ -n "$row" ]] || continue
    IFS=$'\t' read -r pv pvc_ref pv_uid pvc_uid reclaim_policy csi_driver volume_handle longhorn_uid <<<"$row"
    pv="$(trim_whitespace "$pv")"
    [[ -n "$pv" ]] || { rc=1; continue; }
    local identity="${pv_uid}|${pvc_ref}|${pvc_uid}|${reclaim_policy}|${csi_driver}|${volume_handle}|${longhorn_uid}"
    if [[ -n "${pv_identities[$pv]+present}" && "${pv_identities[$pv]}" != "$identity" ]]; then
      echo "Error: cleanup ledger has conflicting identities for reused PV name ${pv}; retaining it for manual review." >&2
      return 1
    fi
    pv_identities[$pv]="$identity"
    if [[ -n "$csi_driver" && -n "$volume_handle" ]]; then
      local handle_key="${csi_driver}|${volume_handle}"
      local handle_identity="${pv}|${pv_uid}|${pvc_ref}|${pvc_uid}|${reclaim_policy}|${longhorn_uid}"
      if [[ -n "${csi_volume_handle_identities[$handle_key]+present}" && "${csi_volume_handle_identities[$handle_key]}" != "$handle_identity" ]]; then
        echo "Error: cleanup ledger has conflicting identities for CSI volume handle ${volume_handle} (${csi_driver}); retaining it for manual review." >&2
        return 1
      fi
      csi_volume_handle_identities[$handle_key]="$handle_identity"
    fi
  done

  for row in "${rows_ref[@]}"; do
    [[ -n "$row" ]] || continue
    IFS=$'\t' read -r pv pvc_ref pv_uid pvc_uid reclaim_policy csi_driver volume_handle longhorn_uid <<<"$row"
    pv="$(trim_whitespace "$pv")"
    [[ -n "$pv" ]] || { rc=1; continue; }
    if [[ " ${processed_pvs[*]} " == *" ${pv} "* ]]; then
      continue
    fi
    processed_pvs+=("$pv")
    if [[ " ${local_pvs[*]} " == *" ${pv} "* ]]; then
      # This PV was already verified and removed by the host-path phase.
      continue
    fi

    if [[ "$reclaim_policy" != Delete ]] && {
      [[ "$reclaim_policy" != Retain || "$csi_driver" != driver.longhorn.io ]] ||
        ! retained_purge_record_is_authorized "$pv" "$pvc_ref" "$pv_uid" "$pvc_uid" "$csi_driver" "$volume_handle" "$longhorn_uid" ||
        ! retained_purge_longhorn_is_detached "$volume_handle" "$longhorn_uid";
    }; then
      echo "Error: cleanup of PV ${pv} with reclaimPolicy ${reclaim_policy} requires exact confirmed-purge authorization and a verified detached Longhorn backend; retaining its cleanup ledger for retry or manual storage removal." >&2
      rc=1
      continue
    fi
    if [[ -z "$csi_driver" ]]; then
      echo "Error: PV ${pv} has no CSI driver and is not a recorded local-path target; retaining its cleanup ledger for manual review." >&2
      rc=1
      continue
    fi

    if ! recorded_pv_matches_cleanup_ledger "$pv" "$pvc_ref" "$pv_uid" "$pvc_uid" "$reclaim_policy" "$csi_driver" "$volume_handle"; then
      rc=1
      continue
    fi
    if ! actual_pv_uid="$(kubectl get pv "$pv" --ignore-not-found -o jsonpath='{.metadata.uid}' 2>/dev/null)"; then
      echo "Error: could not verify recorded PV ${pv} before deletion." >&2
      rc=1
      continue
    fi
    actual_pv_uid="$(trim_whitespace "$actual_pv_uid")"
    if [[ -n "$actual_pv_uid" && "$actual_pv_uid" != "$pv_uid" ]]; then
      echo "Error: refusing to delete PV ${pv}: its UID changed after cleanup was verified." >&2
      rc=1
      continue
    fi

    if [[ -n "$actual_pv_uid" ]]; then
      if ! ensure_volume_attachments_gone_for_pv "$pv"; then
        rc=1
        continue
      fi
    fi

    # A stale VolumeAttachment can outlive its PV object. Longhorn backend
    # deletion is therefore gated even on a ledger-only retry where the PV is
    # already absent.
    if [[ "$csi_driver" == "driver.longhorn.io" && -z "$actual_pv_uid" ]]; then
      if ! ensure_volume_attachments_gone_for_pv "$pv"; then
        rc=1
        continue
      fi
    fi

    if [[ "$csi_driver" == "driver.longhorn.io" ]]; then
      if ! longhorn_volume_handle_is_exclusive_to_recorded_pv "$pv" "$pv_uid" "$volume_handle" "$actual_pv_uid"; then
        rc=1
        continue
      fi
    elif ! csi_volume_handle_is_exclusive_to_recorded_pv "$pv" "$pv_uid" "$csi_driver" "$volume_handle" "$actual_pv_uid"; then
      rc=1
      continue
    fi

    if ! recorded_longhorn_volume_matches_cleanup_ledger "$csi_driver" "$volume_handle" "$longhorn_uid"; then
      rc=1
      continue
    fi
    if [[ "$csi_driver" == "driver.longhorn.io" && -n "$longhorn_uid" ]]; then
      if ! longhorn_namespace_uid="$(kubectl get namespace "$LONGHORN_NAMESPACE" --ignore-not-found -o jsonpath='{.metadata.uid}' 2>/dev/null)"; then
        echo "Error: could not verify Longhorn namespace ${LONGHORN_NAMESPACE} before deleting volume ${volume_handle}." >&2
        rc=1
        continue
      fi
      longhorn_namespace_uid="$(trim_whitespace "$longhorn_namespace_uid")"
      if [[ -n "$longhorn_namespace_uid" ]]; then
        if ! actual_longhorn_uid="$(kubectl -n "$LONGHORN_NAMESPACE" get volumes.longhorn.io "$volume_handle" --ignore-not-found -o jsonpath='{.metadata.uid}' 2>/dev/null)"; then
          echo "Error: could not verify Longhorn volume ${volume_handle} before deletion." >&2
          rc=1
          continue
        fi
        actual_longhorn_uid="$(trim_whitespace "$actual_longhorn_uid")"
        if [[ -n "$actual_longhorn_uid" && "$actual_longhorn_uid" != "$longhorn_uid" ]]; then
          echo "Error: refusing to delete Longhorn volume ${volume_handle}: its UID changed after cleanup was verified." >&2
          rc=1
          continue
        fi
        if [[ -n "$actual_longhorn_uid" ]]; then
          if [[ "$reclaim_policy" == Retain ]] && ! retained_purge_longhorn_is_detached "$volume_handle" "$longhorn_uid"; then
            echo "Error: retained Longhorn volume ${volume_handle} is no longer verified detached; keeping its purge authorization for retry." >&2
            rc=1
            continue
          fi
          echo "[${label}] Deleting verified Longhorn volume ${volume_handle} ..."
          kubectl -n "$LONGHORN_NAMESPACE" delete volumes.longhorn.io "$volume_handle" --ignore-not-found --wait=false >/dev/null 2>&1 || true
        fi
        if ! wait_longhorn_volume_gone "$volume_handle" 300; then
          rc=1
          continue
        fi
      fi
    fi

    # Re-read the UID immediately before deletion. A PV that disappeared then
    # reappeared under the same name must leave the ledger intact rather than
    # being deleted by name.
    if ! final_pv_uid="$(kubectl get pv "$pv" --ignore-not-found -o jsonpath='{.metadata.uid}' 2>/dev/null)"; then
      echo "Error: could not recheck recorded PV ${pv} immediately before deletion." >&2
      rc=1
      continue
    fi
    final_pv_uid="$(trim_whitespace "$final_pv_uid")"
    if [[ -n "$final_pv_uid" && "$final_pv_uid" != "$pv_uid" ]]; then
      echo "Error: refusing to delete PV ${pv}: its UID changed immediately before deletion." >&2
      rc=1
      continue
    fi

    if [[ -n "$final_pv_uid" ]]; then
      echo "[${label}] Deleting recorded PV ${pv} ..."
      if [[ "$csi_driver" == "driver.longhorn.io" ]]; then
        # Longhorn's recorded Volume CR has already been verified gone.
        delete_pv_and_wait_for_gone "$pv" 180 60 true || rc=1
      else
        # For a generic CSI driver, never strip PV finalizers: that could
        # remove the Kubernetes object while leaking a cloud disk.
        delete_pv_and_wait_for_gone "$pv" 180 60 false || rc=1
      fi
    fi
  done
  return "$rc"
}

clear_local_path_cleanup_ledgers() {
  local ns name locations

  locations="$(list_local_path_cleanup_ledger_locations)" || return 1
  [[ -n "$locations" ]] || return 0
  while IFS=$'\t' read -r ns name; do
    ns="$(trim_whitespace "$ns")"
    name="$(trim_whitespace "$name")"
    [[ -n "$ns" && -n "$name" ]] || continue
    if ! kubectl -n "$ns" delete configmap "$name" --ignore-not-found --wait=true >/dev/null; then
      echo "Error: could not remove completed local-path cleanup ledger ${ns}/${name}." >&2
      return 1
    fi
  done <<<"$locations"
}

cleanup_recorded_local_path_data() {
  local label="${1:-cleanup}"
  local -a exact_rows=()
  local -a pv_rows=()
  local -a pattern_rows=()

  collect_local_path_cleanup_ledger_rows exact_rows || return 1
  collect_pv_cleanup_ledger_rows pv_rows || return 1
  [[ ${#exact_rows[@]} -gt 0 || ${#pv_rows[@]} -gt 0 ]] || return 0

  if [[ ${#exact_rows[@]} -gt 0 ]]; then
    if ! is_true "$KUBETON_LOCAL_PATH_CLEANUP"; then
      echo "Error: local-path cleanup is disabled while the cleanup ledger still has host-path targets." >&2
      return 1
    fi
    if ! verify_recorded_local_path_targets_use_delete_reclaim_policy exact_rows pv_rows; then
      echo "Error: local-path cleanup ledger has a Retain or unverifiable host-path target; it will be retained for manual cleanup." >&2
      return 1
    fi
    if ! verify_recorded_local_path_targets_safe_for_host_cleanup exact_rows; then
      echo "Error: local-path cleanup ledger has active or changed storage; it will be retained for retry." >&2
      return 1
    fi
    if ! cleanup_local_path_provisioner_data exact_rows pattern_rows "$label"; then
      echo "Error: local-path cleanup ledger still has unresolved host data; it will be retained for retry." >&2
      return 1
    fi
    if ! delete_recorded_local_path_pvs exact_rows "$label"; then
      echo "Error: local-path cleanup ledger still has unresolved PV data; it will be retained for retry." >&2
      return 1
    fi
  fi
  if ! delete_recorded_pv_cleanup_targets pv_rows "$label" exact_rows; then
    echo "Error: cleanup ledger still has unresolved PV or backend-volume data; it will be retained for retry." >&2
    return 1
  fi
  clear_local_path_cleanup_ledgers
}

collect_local_path_cleanup_ledger_leftovers() {
  local -n rows_ref="$1"
  local ns name locations

  if ! locations="$(list_local_path_cleanup_ledger_locations)"; then
    append_unique_item "LocalPathCleanupLedger lookup failed" rows_ref
    return 0
  fi
  [[ -n "$locations" ]] || return 0
  while IFS=$'\t' read -r ns name; do
    ns="$(trim_whitespace "$ns")"
    name="$(trim_whitespace "$name")"
    [[ -n "$ns" && -n "$name" ]] || continue
    append_unique_item "LocalPathCleanupLedger ${ns}/${name}" rows_ref
  done <<<"$locations"
}

delete_pvc_rows_and_backing_volumes() {
  local pvc_rows_name="$1"
  local label="${2:-cleanup}"
  # A missing local-path owner is normally a hard stop: deleting a PVC can
  # make its provisioner remove the backing directory before kubeton can
  # verify it.  Explicit TON drop/uninstall may opt into removing *only* the
  # PVC object after a UID-bound PV ledger was persisted and no pod references
  # the claim.  The unresolved storage record remains in that ledger.
  local force_unresolved_local_pvcs="${3:-false}"
  # Confirmed fleet purge may discover retained recovery PVs after deleting
  # their claims, before ordinary ledger reconciliation would reject Retain.
  local legacy_sts_rows_name="${4:-}"
  local -n pvc_rows_ref="$pvc_rows_name"
  local -a local_path_exact_rows=()
  local -a recorded_pv_rows=()
  local -a local_path_pattern_rows=()
  local -a empty_local_path_exact_rows=()
  local -a normally_deletable_pvc_rows=()
  local -a unresolved_local_pvc_rows=()
  local -a failed_pvc_rows=()
  local row ns pvc_name volume failed_row ledger_row ledger_pvc_ref ledger_pvc_uid expected_pvc_uid recorded_pvc_matches
  local -a wait_pids=()
  local -a wait_rows=()
  local i exact_inventory_rc=0 generic_inventory_rc=0 hard_inventory_rc=0 unresolved_local_rc=0 delete_rc=0 cleanup_rc=0

  if [[ ${#pvc_rows_ref[@]} -eq 0 ]]; then
    return 0
  fi

  for row in "${pvc_rows_ref[@]}"; do
    IFS=$'\t' read -r ns pvc_name <<<"$row"
    [[ -z "$ns" || -z "$pvc_name" ]] && continue
    if ! volume="$(kubectl -n "$ns" get pvc "$pvc_name" --ignore-not-found -o jsonpath='{.spec.volumeName}' 2>/dev/null)"; then
      echo "Error: could not inspect PVC ${ns}/${pvc_name} before deleting backing storage." >&2
      hard_inventory_rc=1
      continue
    fi
    volume="$(trim_whitespace "$volume")"
    if [[ -z "$volume" ]]; then
      append_unique_item "$ns"$'\t'"$pvc_name" normally_deletable_pvc_rows
      continue
    fi

    exact_inventory_rc=0
    generic_inventory_rc=0
    # Record the UID-bound PV/PVC identity first. If this fails, do not even
    # retain an exact path row: it would be unsafe to reconcile a host path
    # without the immutable ownership record that binds it to this PVC.
    if ! append_pv_cleanup_ledger_row_for_pv "$volume" "${ns}/${pvc_name}" recorded_pv_rows; then
      generic_inventory_rc=1
    fi

    # Without an immutable PV/PVC record, no later retry can establish that a
    # reused PV belongs to this claim.  Keep this PVC intact rather than
    # forcing its finalizers away.
    if (( generic_inventory_rc != 0 )); then
      echo "Error: could not record verified backing-storage cleanup state for PVC ${ns}/${pvc_name}; leaving that PVC intact." >&2
      hard_inventory_rc=1
      continue
    fi

    # Carry the recorded PVC UID into the force-only path. A same-name PVC
    # may be recreated between inventory and finalizer removal; never remove
    # finalizers from that different claim.
    expected_pvc_uid=""
    recorded_pvc_matches=0
    for ledger_row in "${recorded_pv_rows[@]}"; do
      [[ -n "$ledger_row" ]] || continue
      IFS=$'\t' read -r _ ledger_pvc_ref _ ledger_pvc_uid _ <<<"$ledger_row"
      if [[ "$ledger_pvc_ref" == "${ns}/${pvc_name}" ]]; then
        expected_pvc_uid="$(trim_whitespace "$ledger_pvc_uid")"
        ((recorded_pvc_matches+=1))
      fi
    done
    if [[ -z "$expected_pvc_uid" || "$recorded_pvc_matches" != "1" ]]; then
      echo "Error: could not recover the recorded PVC identity for ${ns}/${pvc_name}; leaving that PVC intact." >&2
      hard_inventory_rc=1
      continue
    fi

    if append_local_path_exact_cleanup_rows_for_pv "$volume" "${ns}/${pvc_name}" local_path_exact_rows; then
      exact_inventory_rc=0
    else
      exact_inventory_rc=$?
    fi

    if (( exact_inventory_rc != 0 )); then
      if (( exact_inventory_rc == 2 )) && is_true "$force_unresolved_local_pvcs"; then
        echo "Warning: exact local-path ownership for PVC ${ns}/${pvc_name} could not be proven. Its UID-bound storage record will be retained; uninstall may remove only the unmounted PVC object." >&2
        append_unique_item "$ns"$'\t'"$pvc_name"$'\t'"$expected_pvc_uid" unresolved_local_pvc_rows
        unresolved_local_rc=1
      else
        echo "Error: exact local-path safety checks failed for PVC ${ns}/${pvc_name}; leaving that PVC intact." >&2
        hard_inventory_rc=1
        continue
      fi
    else
      append_unique_item "$ns"$'\t'"$pvc_name" normally_deletable_pvc_rows
    fi
  done

  # Keep the non-destructive start/cleanup behavior unchanged: it must not
  # alter any PVC when a local backing directory cannot be proven. Explicit
  # TON uninstall/drop continues per PVC after the durable ledger is written.
  if (( hard_inventory_rc != 0 || unresolved_local_rc != 0 )) && ! is_true "$force_unresolved_local_pvcs"; then
    echo "Error: could not safely inventory all local-path backing directories; leaving PVCs intact." >&2
    return 1
  fi
  if ! record_local_path_cleanup_ledger local_path_exact_rows recorded_pv_rows; then
    return 1
  fi

  # Pattern cleanup is intentionally limited to fully verified PVCs. A
  # wildcard match must never compensate for missing exact host-path
  # provenance on an unresolved local-path record.
  collect_local_path_pattern_cleanup_rows_for_pvcs normally_deletable_pvc_rows local_path_pattern_rows

  if [[ ${#normally_deletable_pvc_rows[@]} -gt 0 ]]; then
    echo "[${label}] Deleting PVCs ..."
  fi
  for row in "${normally_deletable_pvc_rows[@]}"; do
    IFS=$'\t' read -r ns pvc_name <<<"$row"
    [[ -z "$ns" || -z "$pvc_name" ]] && continue
    kubectl -n "$ns" delete pvc "$pvc_name" --ignore-not-found --wait=false >/dev/null 2>&1 || true
  done

  for row in "${normally_deletable_pvc_rows[@]}"; do
    IFS=$'\t' read -r ns pvc_name <<<"$row"
    [[ -z "$ns" || -z "$pvc_name" ]] && continue
    wait_pvc_gone "$ns" "$pvc_name" 120 &
    wait_pids+=("$!")
    wait_rows+=("$row")
  done
  for i in "${!wait_pids[@]}"; do
    if ! wait "${wait_pids[$i]}"; then
      failed_row="${wait_rows[$i]:-}"
      [[ -n "$failed_row" ]] && failed_pvc_rows+=("$failed_row")
    fi
  done
  wait_pids=()
  wait_rows=()

  for failed_row in "${failed_pvc_rows[@]}"; do
    IFS=$'\t' read -r ns pvc_name <<<"$failed_row"
    [[ -z "$ns" || -z "$pvc_name" ]] && continue
    if ! delete_pvc_and_wait_for_gone "$ns" "$pvc_name" 60 60; then
      delete_rc=1
    fi
  done

  # The exact host directory is unknown for these claims, but their generic
  # PV/PVC identity is now durable.  Remove a stuck PVC only after proving it
  # is not mounted.  The subsequent ledger reconciliation deliberately
  # refuses to guess at a host path or strip a PV finalizer.
  for row in "${unresolved_local_pvc_rows[@]}"; do
    IFS=$'\t' read -r ns pvc_name expected_pvc_uid <<<"$row"
    [[ -z "$ns" || -z "$pvc_name" ]] && continue
    if ! force_delete_unmounted_pvc_after_unresolved_local_inventory "$ns" "$pvc_name" "$expected_pvc_uid" 60; then
      delete_rc=1
    fi
  done

  if [[ -n "$legacy_sts_rows_name" ]]; then
    if [[ "${KUBETON_RETAIN_PURGE_CONFIRMED:-false}" != true || "$label" != uninstall ]]; then
      echo "Error: retained-volume discovery requires a confirmed fleet purge." >&2
      cleanup_rc=1
    elif ! cleanup_legacy_ton_pvs_for_statefulsets "$legacy_sts_rows_name" "$label"; then
      cleanup_rc=1
    fi
  fi

  # The PVC is gone now, so no Kubernetes pod can still mount its RWO
  # filesystem.  The persisted ledger makes this retryable if the privileged
  # cleanup pod cannot remove the host directory on this attempt.
  if ! cleanup_recorded_local_path_data "$label"; then
    cleanup_rc=1
  fi
  if (( cleanup_rc == 0 )) && ! cleanup_local_path_provisioner_data empty_local_path_exact_rows local_path_pattern_rows "$label"; then
    cleanup_rc=1
  fi
  if (( hard_inventory_rc != 0 )); then
    echo "Error: one or more PVCs were retained because their backing storage could not be safely inventoried." >&2
  fi
  if (( unresolved_local_rc != 0 )); then
    echo "Warning: one or more unmounted PVC objects were force-deleted, but their unverified local-path storage records remain for manual reconciliation." >&2
  fi
  (( hard_inventory_rc == 0 && unresolved_local_rc == 0 && delete_rc == 0 && cleanup_rc == 0 ))
}

collect_expected_ton_pvc_rows_from_values() {
  local -n rows_ref="$1"
  local ns sts replicas claim_prefix ordinal pvc_name
  local -a claim_prefixes=("ton-work" "ton-src" "mytoncore" "mytonctrl" "keybundle")

  ns="$(resolve_tonnode_namespace_from_values)"
  sts="$(resolve_tonnode_name_from_values)"
  replicas="$(resolve_ton_replicas_from_values_file "$TON_VALUES_FILE" || true)"
  if ! [[ "$replicas" =~ ^[1-9][0-9]*$ ]]; then
    replicas="$(resolve_ton_replicas_from_values_file "$CHART_DIR/values.yaml" || true)"
  fi
  if ! [[ "$replicas" =~ ^[1-9][0-9]*$ ]]; then
    replicas=1
  fi

  for claim_prefix in "${claim_prefixes[@]}"; do
    for ((ordinal=0; ordinal<replicas; ordinal++)); do
      append_unique_item "$ns"$'\t'"${claim_prefix}-${sts}-${ordinal}" rows_ref
    done
  done

  # Also include any higher ordinals from an older replica count.
  while IFS= read -r pvc_name; do
    [[ -z "$pvc_name" ]] && continue
    append_unique_item "$ns"$'\t'"$pvc_name" rows_ref
  done < <(
    kubectl -n "$ns" get pvc -o jsonpath='{range .items[*]}{.metadata.name}{"\n"}{end}' 2>/dev/null \
      | grep -E "^(ton-work|ton-src|mytoncore|mytonctrl|keybundle)-${sts}-" || true
  )
}

collect_labeled_ton_pvc_rows() {
  local -n rows_ref="$1"
  local ns pvc

  while IFS=$'\t' read -r ns pvc; do
    [[ -z "$ns" || -z "$pvc" ]] && continue
    append_unique_item "$ns"$'\t'"$pvc" rows_ref
  done < <(
    kubectl get pvc -A -l 'app.kubernetes.io/name=ton-node,app.kubernetes.io/managed-by=ton-k8s-operator' -o jsonpath='{range .items[*]}{.metadata.namespace}{"\t"}{.metadata.name}{"\n"}{end}' 2>/dev/null || true
  )
}

pvc_has_kubeton_attribution() {
  local ns="$1"
  local pvc="$2"
  local managed_by app_name

  if ! kubectl -n "$ns" get pvc "$pvc" >/dev/null 2>&1; then
    return 1
  fi

  managed_by="$(kubectl -n "$ns" get pvc "$pvc" -o jsonpath='{.metadata.labels.app\.kubernetes\.io/managed-by}' 2>/dev/null || true)"
  app_name="$(kubectl -n "$ns" get pvc "$pvc" -o jsonpath='{.metadata.labels.app\.kubernetes\.io/name}' 2>/dev/null || true)"
  managed_by="$(trim_whitespace "$managed_by")"
  app_name="$(trim_whitespace "$app_name")"

  [[ "$managed_by" == "kubeton" ]] && return 0
  [[ "$managed_by" == "ton-k8s-operator" && "$app_name" == "ton-node" ]] && return 0

  return 1
}

# Older chart/controller versions did not always preserve the labels carried by
# a StatefulSet VolumeClaimTemplate.  During an explicitly destructive TON
# cleanup, the configured claim-template names are still a narrow and useful
# ownership signal: a PVC named mytoncore-<configured-tonnode>-<ordinal> cannot
# coexist with that StatefulSet's claim for the same ordinal.  Do not use this
# fallback during normal start/repair flows; those must continue to require
# Kubernetes ownership labels.
pvc_is_configured_ton_claim_template() {
  local ns="$1"
  local pvc="$2"
  local configured_ns configured_sts claim_prefix prefix ordinal
  local -a claim_prefixes=("ton-work" "ton-src" "mytoncore" "mytonctrl" "keybundle")

  configured_ns="$(resolve_tonnode_namespace_from_values)"
  configured_sts="$(resolve_tonnode_name_from_values)"
  [[ -n "$configured_ns" && -n "$configured_sts" && "$ns" == "$configured_ns" ]] || return 1

  for claim_prefix in "${claim_prefixes[@]}"; do
    prefix="${claim_prefix}-${configured_sts}-"
    [[ "$pvc" == "$prefix"* ]] || continue
    ordinal="${pvc#"$prefix"}"
    [[ "$ordinal" =~ ^(0|[1-9][0-9]*)$ ]] && return 0
  done
  return 1
}

# A current StatefulSet selected with TON_POD_LABEL is an additional trusted
# provenance source for an unlabelled legacy claim.  This lets uninstall clean
# a fleet whose values file was renamed after deployment, while limiting the
# fallback to names captured from that particular StatefulSet.
pvc_row_has_trusted_ton_statefulset_provenance() {
  local ns="$1"
  local pvc="$2"
  local trusted_rows_name="${3:-}"
  local expected_row row

  [[ -n "$trusted_rows_name" ]] || return 1
  local -n trusted_rows_ref="$trusted_rows_name"
  expected_row="${ns}"$'\t'"${pvc}"
  for row in "${trusted_rows_ref[@]}"; do
    [[ "$row" == "$expected_row" ]] && return 0
  done
  return 1
}

# A previous uninstall can remove both the PVC and StatefulSet before their
# PVs are deleted. Recover dynamically provisioned TON claims from that
# partial teardown; Retain copies require an explicitly confirmed purge. Exact claimRef names are an explicit
# uninstall/drop fallback; ordinary start/repair must never adopt these PVs.
cleanup_legacy_ton_pvs_for_statefulsets() {
  local trusted_sts_rows_name="$1"
  local label="${2:-cleanup}"
  local -n trusted_sts_rows_ref="$trusted_sts_rows_name"
  local snapshot row rechecked pv pv_uid ns pvc pvc_uid reclaim driver handle provisioner managed_by app_name resource_policy extra
  local sts_row sts_ns sts_name prefix ordinal trusted live_uid path node longhorn_identity longhorn_uid longhorn_state longhorn_node longhorn_current_node rc=0
  local -a exact_rows=() pv_rows=() local_nodes=() retained_authorizations=()
  local rejection_reason field_separators claim_identity
  local -A pv_snapshot_counts=() pv_snapshot_uids=() conflicting_pv_names=() claim_uid_pvs=() conflicting_claim_uids=() pv_uid_names=() conflicting_pv_uids=()
  local snapshot_path='{.metadata.name}{"|"}{.metadata.uid}{"|"}{.spec.claimRef.namespace}{"|"}{.spec.claimRef.name}{"|"}{.spec.claimRef.uid}{"|"}{.spec.persistentVolumeReclaimPolicy}{"|"}{.spec.csi.driver}{"|"}{.spec.csi.volumeHandle}{"|"}{.metadata.annotations.pv\.kubernetes\.io/provisioned-by}{"|"}{.metadata.labels.app\.kubernetes\.io/managed-by}{"|"}{.metadata.labels.app\.kubernetes\.io/name}{"|"}{.metadata.annotations.helm\.sh/resource-policy}'
  local -a candidate_rows=()

  case "$label" in uninstall|drop) ;; *) return 0 ;; esac
  if ! snapshot="$(kubectl get pv -o "jsonpath={range .items[*]}${snapshot_path}{\"\\n\"}{end}" 2>/dev/null)"; then
    echo "Error: could not inspect legacy TON PVs left by a partial ${label}." >&2
    return 1
  fi
  while IFS= read -r row; do
    [[ -n "$row" ]] || continue
    IFS='|' read -r pv pv_uid ns pvc pvc_uid reclaim driver handle provisioner managed_by app_name resource_policy extra <<<"$row"
    # A PVC name may have several historical lifetimes. Their immutable UIDs
    # and distinct backend identities decide whether they can be recovered;
    # counting namespace/name alone incorrectly retained legitimate old PVs.
    if [[ -n "$pv" ]]; then
      pv_snapshot_counts["$pv"]=$(( ${pv_snapshot_counts["$pv"]:-0} + 1 ))
      if [[ -n "${pv_snapshot_uids["$pv"]+present}" && "${pv_snapshot_uids["$pv"]}" != "$pv_uid" ]]; then
        conflicting_pv_names["$pv"]=true
      fi
      pv_snapshot_uids["$pv"]="$pv_uid"
      if [[ -n "$pvc_uid" ]]; then
        claim_identity="${pv}|${pv_uid}"
        if [[ -n "${claim_uid_pvs["$pvc_uid"]+present}" && "${claim_uid_pvs["$pvc_uid"]}" != "$claim_identity" ]]; then
          conflicting_claim_uids["$pvc_uid"]=true
        fi
        claim_uid_pvs["$pvc_uid"]="$claim_identity"
      fi
      if [[ -n "$pv_uid" ]]; then
        if [[ -n "${pv_uid_names["$pv_uid"]+present}" && "${pv_uid_names["$pv_uid"]}" != "$pv" ]]; then
          conflicting_pv_uids["$pv_uid"]=true
        fi
        pv_uid_names["$pv_uid"]="$pv"
      fi
    fi
    [[ -n "$pv" && -n "$ns" && -n "$pvc" ]] || continue
    trusted=false
    if pvc_is_configured_ton_claim_template "$ns" "$pvc"; then
      trusted=true
    else
      for sts_row in "${trusted_sts_rows_ref[@]}"; do
        IFS=$'\t' read -r sts_ns sts_name _ <<<"$sts_row"
        [[ -n "$sts_name" && "$ns" == "$sts_ns" ]] || continue
        for prefix in ton-work ton-src mytoncore mytonctrl keybundle; do
          prefix="${prefix}-${sts_name}-"
          [[ "$pvc" == "$prefix"* ]] || continue
          ordinal="${pvc#"$prefix"}"
          [[ "$ordinal" =~ ^(0|[1-9][0-9]*)$ ]] && trusted=true
        done
      done
    fi
    [[ "$trusted" == true ]] || continue
    candidate_rows+=("$row")
  done <<<"$snapshot"

  for row in "${candidate_rows[@]}"; do
    IFS='|' read -r pv pv_uid ns pvc pvc_uid reclaim driver handle provisioner managed_by app_name resource_policy extra <<<"$row"
    if ! live_uid="$(kubectl -n "$ns" get pvc "$pvc" --ignore-not-found -o jsonpath='{.metadata.uid}' 2>/dev/null)"; then
      echo "Error: could not inspect PVC ${ns}/${pvc} before legacy PV cleanup." >&2
      rc=1
      continue
    fi
    # Live claims belong to the normal PVC cleanup path. In particular, never
    # adopt an old PV when a same-name claim has since been recreated.
    [[ -z "$live_uid" ]] || continue
    rejection_reason=""
    field_separators="${row//[^|]/}"
    if [[ ${#field_separators} -ne 11 || -n "$extra" ]]; then
      rejection_reason="malformed PV inventory: expected 12 fields, received $(( ${#field_separators} + 1 ))"
    elif [[ -z "$pv_uid" ]]; then
      rejection_reason="metadata.uid is empty"
    elif [[ -z "$pvc_uid" ]]; then
      rejection_reason="spec.claimRef.uid is empty"
    elif [[ "${conflicting_pv_names["$pv"]:-false}" == true ]]; then
      rejection_reason="metadata.uid conflicts between inventory entries for PV ${pv}"
    elif [[ "${pv_snapshot_counts["$pv"]:-0}" != 1 ]]; then
      rejection_reason="malformed PV inventory: metadata.name ${pv} appears more than once"
    elif [[ "${conflicting_pv_uids["$pv_uid"]:-false}" == true ]]; then
      rejection_reason="metadata.uid ${pv_uid} is shared by different PV names"
    elif [[ "${conflicting_claim_uids["$pvc_uid"]:-false}" == true ]]; then
      rejection_reason="spec.claimRef.uid ${pvc_uid} is shared by different PV identities"
    elif [[ "$pv" != "pvc-${pvc_uid}" ]]; then
      rejection_reason="metadata.name ${pv} does not match dynamically provisioned claim UID ${pvc_uid} (expected pvc-${pvc_uid})"
    elif [[ "$reclaim" != Delete ]] && {
      [[ "$reclaim" != Retain || "${KUBETON_RETAIN_PURGE_CONFIRMED:-false}" != true ]] ||
        ! pvc_is_configured_ton_claim_template "$ns" "$pvc";
    }; then
      rejection_reason="spec.persistentVolumeReclaimPolicy is '${reclaim:-<empty>}' (Retain requires confirmed purge of the configured fleet)"
    elif [[ "$resource_policy" == keep ]]; then
      rejection_reason="metadata.annotations[helm.sh/resource-policy] is keep"
    elif [[ -n "$managed_by" && "$managed_by" != kubeton && "$managed_by" != ton-k8s-operator ]]; then
      rejection_reason="metadata.labels[app.kubernetes.io/managed-by] is '${managed_by}'"
    elif [[ -n "$app_name" && "$app_name" != ton-node ]]; then
      rejection_reason="metadata.labels[app.kubernetes.io/name] is '${app_name}'"
    fi
    if [[ -n "$rejection_reason" ]]; then
      echo "Error: retaining legacy TON PV ${pv} (${ns}/${pvc}): ${rejection_reason}." >&2
      rc=1
      continue
    fi
    # Re-read all provenance before adopting the immutable record. Missing or
    # changed objects must not become a newly invented cleanup authorization.
    if ! rechecked="$(kubectl get pv "$pv" --ignore-not-found -o "jsonpath=${snapshot_path}" 2>/dev/null)" \
      || [[ "$rechecked" != "$row" ]]; then
      echo "Error: retaining legacy TON PV ${pv}: its identity or provisioning metadata changed during discovery." >&2
      rc=1
      continue
    fi
    if ! recorded_pv_matches_cleanup_ledger "$pv" "$ns/$pvc" "$pv_uid" "$pvc_uid" "$reclaim" "$driver" "$handle" \
      || ! wait_volume_attachments_gone "$pv" 1; then
      echo "Error: retaining legacy TON PV ${pv}: its absent claim and detached state could not be verified." >&2
      rc=1
      continue
    fi

    path=""
    node=""
    longhorn_uid=""
    if [[ "$driver" == driver.longhorn.io && "$provisioner" == driver.longhorn.io && -n "$handle" ]]; then
      if ! csi_volume_handle_is_exclusive_to_recorded_pv "$pv" "$pv_uid" "$driver" "$handle" "$pv_uid"; then
        rc=1
        continue
      fi
      if ! longhorn_identity="$(kubectl -n "$LONGHORN_NAMESPACE" get volumes.longhorn.io "$handle" --ignore-not-found \
        -o jsonpath='{.metadata.uid}{"|"}{.status.state}{"|"}{.spec.nodeID}{"|"}{.status.currentNodeID}' 2>/dev/null)"; then
        echo "Error: could not inspect Longhorn volume ${handle} for legacy TON PV ${pv}." >&2
        rc=1
        continue
      fi
      IFS='|' read -r longhorn_uid longhorn_state longhorn_node longhorn_current_node <<<"$longhorn_identity"
      if [[ -n "$longhorn_uid" && ( "$longhorn_state" != detached || -n "$longhorn_node$longhorn_current_node" ) ]]; then
        echo "Error: retaining Longhorn volume ${handle}: it is not verified detached." >&2
        rc=1
        continue
      fi
    elif [[ -z "$driver" && -z "$handle" ]] && local_path_pv_is_provisioned_by_local_path "$pv"; then
      if ! is_true "$KUBETON_LOCAL_PATH_CLEANUP" \
        || ! path="$(local_path_pv_host_path "$pv")" \
        || ! path="$(local_path_absolute_target "$path")"; then
        echo "Error: retaining legacy local-path PV ${pv}: exact host cleanup is disabled or its path is unsafe." >&2
        rc=1
        continue
      fi
      local_nodes=()
      if ! collect_local_path_nodes_for_pv "$pv" local_nodes || [[ ${#local_nodes[@]} -ne 1 ]]; then
        echo "Error: retaining legacy local-path PV ${pv}: its owning node cannot be proven." >&2
        rc=1
        continue
      fi
      node="${local_nodes[0]}"
      if ! local_path_recorded_pv_can_be_deleted "$pv" "$path" "$ns/$pvc" "$pv_uid" "$pvc_uid" "$node" "$reclaim"; then
        rc=1
        continue
      fi
      append_unique_item "$node"$'\t'"$path"$'\t'"$pv"$'\t'"$ns/$pvc"$'\t'"$pv_uid"$'\t'"$pvc_uid" exact_rows
    else
      echo "Error: retaining legacy TON PV ${pv}: dynamic Longhorn/local-path provisioning could not be proven (spec.csi.driver='${driver:-<empty>}', spec.csi.volumeHandle='${handle:-<empty>}', metadata.annotations[pv.kubernetes.io/provisioned-by]='${provisioner:-<empty>}')." >&2
      rc=1
      continue
    fi
    if [[ "$reclaim" == Retain ]]; then
      retained_authorizations+=("${pv}|${ns}/${pvc}|${pv_uid}|${pvc_uid}|Retain|${driver}|${handle}|${longhorn_uid}|${node}|${path}")
      echo "[purge] Including verified retained TON recovery volume ${pv}, formerly ${ns}/${pvc}."
    fi
    echo "[${label}] Recovering cleanup state for legacy TON PV ${pv}, formerly ${ns}/${pvc}."
    append_unique_item "$pv"$'\t'"$ns/$pvc"$'\t'"$pv_uid"$'\t'"$pvc_uid"$'\t'"$reclaim"$'\t'"$driver"$'\t'"$handle"$'\t'"$longhorn_uid" pv_rows
  done

  if [[ ${#pv_rows[@]} -gt 0 ]]; then
    # Persist before either a host directory or a CSI backend is deleted, then
    # use the same retry/UID/handle checks as ordinary PVC cleanup.
    if [[ ${#retained_authorizations[@]} -gt 0 ]]; then
      record_local_path_cleanup_ledger exact_rows pv_rows retained_authorizations || return 1
    else
      record_local_path_cleanup_ledger exact_rows pv_rows || return 1
    fi
    cleanup_recorded_local_path_data "$label" || rc=1
  fi
  return "$rc"
}

collect_existing_pvc_rows() {
  local -n candidate_rows_ref="$1"
  local -n existing_rows_ref="$2"
  local row ns pvc

  for row in "${candidate_rows_ref[@]}"; do
    [[ -z "$row" ]] && continue
    IFS=$'\t' read -r ns pvc <<<"$row"
    [[ -z "$ns" || -z "$pvc" ]] && continue
    if kubectl -n "$ns" get pvc "$pvc" >/dev/null 2>&1; then
      append_unique_item "$ns"$'\t'"$pvc" existing_rows_ref
    fi
  done
}

collect_existing_kubeton_pvc_rows() {
  local -n candidate_rows_ref="$1"
  local -n existing_rows_ref="$2"
  local label="${3:-cleanup}"
  local trusted_rows_name="${4:-}"
  local row ns pvc

  for row in "${candidate_rows_ref[@]}"; do
    [[ -z "$row" ]] && continue
    IFS=$'\t' read -r ns pvc <<<"$row"
    [[ -z "$ns" || -z "$pvc" ]] && continue
    if ! kubectl -n "$ns" get pvc "$pvc" >/dev/null 2>&1; then
      continue
    fi
    if pvc_has_kubeton_attribution "$ns" "$pvc"; then
      append_unique_item "$ns"$'\t'"$pvc" existing_rows_ref
    elif [[ "$label" == "uninstall" || "$label" == "drop" ]] \
      && { pvc_is_configured_ton_claim_template "$ns" "$pvc" \
        || pvc_row_has_trusted_ton_statefulset_provenance "$ns" "$pvc" "$trusted_rows_name"; }; then
      echo "[${label}] Accepting legacy unlabelled PVC ${ns}/${pvc}: it matches a configured or captured TON claim template." >&2
      append_unique_item "$ns"$'\t'"$pvc" existing_rows_ref
    else
      echo "[${label}] Skipping PVC ${ns}/${pvc}: missing kubeton/ton-k8s-operator ownership labels." >&2
    fi
  done
}

strip_ansi_sequences() {
  local text="${1:-}"
  text="${text//$'\r'/}"
  printf '%s' "$text" | sed -E $'s/\x1B\\[[0-9;]*[[:alpha:]]//g'
}

resolve_tonnode_wallet_address_from_pod() {
  local ns="$1"
  local pod="$2"
  local wallet_name="$3"
  local network="${4:-mainnet}"
  local wallet_row address raw_address status balance version workchain

  [[ "$wallet_name" =~ ^[A-Za-z0-9._-]+$ ]] || return 1
  # Account identity is local data. Do not make funding a validator depend on
  # a successful live balance query (especially while its node is syncing).
  if raw_address="$(read_tonnode_wallet_address_file_from_pod "$ns" "$pod" "$wallet_name")"; then
    ton_address_to_non_bounceable "$raw_address" "$network"
    return $?
  fi

  # Compatibility for installations whose address is available only via wl.
  wallet_row="$(resolve_tonnode_wallet_row_from_pod "$ns" "$pod" "$wallet_name")" || return 1
  IFS=$'\t' read -r wallet_name status balance version workchain address <<<"$wallet_row"
  address="$(trim_whitespace "$address")"
  ton_address_to_hex "$address" >/dev/null || return 1
  ton_address_valid_for_network "$address" "$network" || return 1
  printf '%s' "$address"
}

tonnode_wallet_query_script() {
  cat <<'PY'
import base64
import binascii
import http.client
import json
import pathlib
import re
import shutil
import subprocess
import sys
import time
import urllib.error
import urllib.parse
import urllib.request


def form(text):
    text = text.lstrip()
    if not text.startswith("("):
        token = re.match(r"[^\s()]+", text)
        if not token:
            raise ValueError("missing field value")
        return token.group()
    depth = 0
    for index, character in enumerate(text):
        if character == "(":
            depth += 1
        elif character == ")":
            depth -= 1
            if depth == 0:
                return text[:index + 1]
    raise ValueError("incomplete account state")


def field(text, name):
    match = re.search(r"(?<![A-Za-z0-9_])" + name + r":\s*", text)
    if not match:
        raise ValueError("missing account field")
    return form(text[match.end():])


def account_state(output):
    marker = re.search(r"(?m)^\s*account state is[ \t]*", output)
    if not marker:
        raise ValueError("no verified account state")
    content = output[marker.end():].lstrip()
    if re.match(r"empty[ \t]*(?:\r?\n|$)", content):
        return "empty", 0
    account = form(content)
    if account == "account_none" or re.fullmatch(r"\(account_none\s*\)", account):
        return "empty", 0
    if not re.match(r"\(account\s", account):
        raise ValueError("invalid account record")
    storage = field(account, "storage")
    if not re.match(r"\(account_storage\s", storage):
        raise ValueError("invalid account storage")
    state = field(storage, "state").lstrip("(")
    state = re.match(r"account_(active|uninit|frozen)(?=\s|\)|$)", state)
    if not state:
        raise ValueError("unrecognized account state")
    amount = field(field(field(storage, "balance"), "grams"), "amount")
    if not re.match(r"\(var_uint\s", amount):
        raise ValueError("invalid balance record")
    value = field(amount, "value")
    if not re.fullmatch(r"[0-9]+", value):
        raise ValueError("invalid account balance")
    return state[1], int(value)


def friendly(raw, bounceable=False):
    workchain, account = raw.split(":")
    workchain = int(workchain)
    if not -128 <= workchain <= 127:
        return raw
    body = bytes([0x11 if bounceable else 0x51, workchain & 255]) + bytes.fromhex(account)
    return base64.urlsafe_b64encode(body + binascii.crc_hqx(body, 0).to_bytes(2, "big")).decode()


def account_none_cell(encoded):
    blob = base64.b64decode(encoded, validate=True)
    if len(blob) < 8 or blob[:4] != bytes.fromhex("b5ee9c72"):
        raise ValueError("invalid account BOC")
    flags, offset_size = blob[4:6]
    size = flags & 7
    if flags & 0x38 or not 1 <= size <= 4 or not 1 <= offset_size <= 8:
        raise ValueError("unsupported account BOC")
    end = len(blob) - (4 if flags & 0x40 else 0)
    if flags & 0x40:
        crc = 0xffffffff
        for byte in blob[:end]:
            crc ^= byte
            for _ in range(8):
                crc = (crc >> 1) ^ (0x82f63b78 if crc & 1 else 0)
        if (crc ^ 0xffffffff).to_bytes(4, "little") != blob[end:]:
            raise ValueError("invalid account BOC checksum")
    cursor = 6

    def number(width):
        nonlocal cursor
        if cursor + width > end:
            raise ValueError("truncated account BOC")
        value = int.from_bytes(blob[cursor:cursor + width], "big")
        cursor += width
        return value

    count, roots, absent, total = number(size), number(size), number(size), number(offset_size)
    if not 1 <= count <= 4096 or roots != 1 or absent != 0:
        raise ValueError("invalid account BOC roots")
    root = number(size)
    if flags & 0x80:
        for _ in range(count):
            number(offset_size)
    if cursor + total != end:
        raise ValueError("invalid account BOC length")
    cells = []
    for _ in range(count):
        descriptor, bits = number(1), number(1)
        refs = descriptor & 7
        if descriptor & 0xf8 or refs > 4:
            raise ValueError("unsupported account BOC cell")
        length = (bits + 1) // 2
        if cursor + length > end:
            raise ValueError("truncated account BOC cell")
        data = blob[cursor:cursor + length]
        cursor += length
        references = [number(size) for _ in range(refs)]
        cells.append((bits, data, references))
    if cursor != end or root >= count or any(ref >= count for _, _, refs in cells for ref in refs):
        raise ValueError("invalid account BOC references")
    bits, data, refs = cells[root]
    if bits != 80 or len(data) != 40 or len(refs) != 1:
        raise ValueError("invalid ShardAccount cell")
    account_bits, account_data, account_refs = cells[refs[0]]
    if not account_data:
        raise ValueError("missing Account constructor")
    if account_data[0] & 0x80:
        return False
    if account_bits != 1 or account_data != b"\x40" or account_refs or any(data):
        raise ValueError("invalid account_none cell")
    return True


def https_endpoint(config):
    validator = config.get("validator", {})
    state = validator.get("zero_state", {}) if isinstance(validator, dict) else {}
    if not isinstance(state, dict):
        return None
    if any(type(state.get(key)) is not int or state[key] != expected
           for key, expected in (("workchain", -1), ("shard", -9223372036854775808), ("seqno", 0))):
        return None
    identities = {
        ("F6OpKZKqvqeFp6CQmFomXNMfMj2EnaUSOXN+Mh+wVWk=", "XplPz01CXAps5qeSWUtxcyBfdAo5zVb1N979KLSKD24="): "https://toncenter.com",
        ("gj+B8wb/AmlPk1z1AhVI484rhrUpgSr2oSFIh56VoSg=", "Z+IKwYS54DmmJmesw/nAD5DzWadnOCMzee+kdgSYDOg="): "https://testnet.toncenter.com",
    }
    root_hash, file_hash = state.get("root_hash"), state.get("file_hash")
    if not isinstance(root_hash, str) or not isinstance(file_hash, str):
        return None
    return identities.get((root_hash, file_hash))


def https_account_state(endpoint, raw):
    last_request = None

    def request(method, **parameters):
        nonlocal last_request
        url = endpoint + "/api/v2/" + method + "?" + urllib.parse.urlencode({"address": raw, **parameters})
        for attempt in range(3):
            if last_request is not None:
                time.sleep(max(0, 1.05 - (time.monotonic() - last_request)))
            last_request = time.monotonic()
            try:
                query = urllib.request.Request(url, headers={"Accept": "application/json", "User-Agent": "kubeton/wallet-state"})
                with urllib.request.urlopen(query, timeout=10) as response:
                    body = response.read(1048577)
                    if len(body) > 1048576:
                        raise ValueError("oversized HTTPS account response")
                    result = json.loads(body)
                if not isinstance(result, dict) or result.get("ok") is not True or not isinstance(result.get("result"), dict):
                    raise ValueError("HTTPS account API rejected the query")
                return result["result"]
            except urllib.error.HTTPError as error:
                if (error.code == 429 or 500 <= error.code < 600) and attempt < 2:
                    continue
                raise
        raise ValueError("HTTPS account API retry limit reached")

    result = request("getAddressInformation")
    balance, state = result.get("balance"), result.get("state")
    if not isinstance(balance, str) or not re.fullmatch(r"[0-9]+", balance) or state not in ("active", "frozen", "uninitialized"):
        raise ValueError("invalid HTTPS account state or balance")
    nano = int(balance)
    if state != "uninitialized":
        return state, nano
    transaction = result.get("last_transaction_id", {})
    possible_empty = (nano == 0 and result.get("code") == "" and result.get("data") == ""
                      and result.get("frozen_hash") == "" and result.get("extra_currencies") == []
                      and isinstance(transaction, dict) and transaction.get("lt") == "0"
                      and transaction.get("hash") == "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=")
    if possible_empty:
        block = result.get("block_id", {})
        if not isinstance(block, dict) or block.get("workchain") != -1 or type(block.get("seqno")) is not int or block["seqno"] <= 0:
            raise ValueError("missing HTTPS account snapshot block")
        cell = request("getShardAccountCell", seqno=block["seqno"])
        if cell.get("@type") != "tvm.cell" or not isinstance(cell.get("bytes"), str):
            raise ValueError("missing HTTPS ShardAccount cell")
        if account_none_cell(cell["bytes"]):
            return "empty", 0
    return "uninit", nano


def emit_row(name, raw, version, state, nano):
    balance = str(nano // 1_000_000_000) + "." + str(nano % 1_000_000_000).zfill(9)
    print("\t".join((name, state, balance, version, raw.split(":")[0], friendly(raw))))


def main():
    name, raw, attempts, timeout = sys.argv[1:5]
    mode = sys.argv[5] if len(sys.argv) > 5 else "--auto"
    if mode not in ("--auto", "--https-only", "--rpc-only"):
        return 1
    if not re.fullmatch(r"[A-Za-z0-9._-]+", name) or not re.fullmatch(r"-?[0-9]+:[0-9a-fA-F]{64}", raw):
        return 1
    attempts, timeout = int(attempts), int(timeout)
    if not 1 <= attempts <= 10 or not 1 <= timeout <= 60:
        return 1
    config_path = pathlib.Path("/var/ton-work/controller/global.config.json")
    try:
        config = json.load(sys.stdin) if mode == "--https-only" else json.loads(config_path.read_text())
        if not isinstance(config, dict):
            return 1
    except FileNotFoundError:
        return 78
    except (OSError, ValueError, KeyError, TypeError):
        return 1
    try:
        database = {} if mode == "--https-only" else json.loads(pathlib.Path("/var/ton-work/controller/mytoncore/mytoncore.db").read_text())
        if not isinstance(database, dict):
            database = {}
    except (OSError, ValueError):
        database = {}
    versions = database.get("walletsVersionList", {})
    version = (sys.argv[6] if len(sys.argv) > 6 else "unknown") if mode == "--https-only" else (
        versions.get(friendly(raw, True), "unknown") if isinstance(versions, dict) else "unknown")
    if not isinstance(version, str) or not re.fullmatch(r"[A-Za-z0-9._-]{1,32}", version):
        version = "unknown"
    errors = []
    endpoint = https_endpoint(config)
    if mode != "--rpc-only" and endpoint:
        try:
            if mode == "--https-only":
                # Separate host queries run sequentially for fleet wallets.
                # Pace their first requests too, without persisting balances.
                time.sleep(1.05)
            state, nano = https_account_state(endpoint, raw)
            emit_row(name, raw, version, state, nano)
            return 0
        except (OSError, ValueError, http.client.HTTPException, urllib.error.URLError) as error:
            errors.append("HTTPS: " + str(error))
    if mode == "--https-only":
        print("; ".join(errors) if errors else "HTTPS queries require a supported mainnet or testnet zero-state identity", file=sys.stderr)
        return 1
    servers = config.get("liteservers")
    if not isinstance(servers, list) or not servers:
        print("active global.config.json has no lite servers", file=sys.stderr)
        return 1
    client = database.get("liteClient", {})
    configured_binary = client.get("appPath") if isinstance(client, dict) else None
    candidates = [configured_binary, "lite-client", "/usr/bin/ton/lite-client/lite-client", "/usr/local/bin/lite-client"]
    binary = next((found for candidate in candidates if isinstance(candidate, str) and candidate
                   for found in [shutil.which(candidate)] if found), None)
    if not binary:
        print("lite-client executable is unavailable" + ("; " + "; ".join(errors) if errors else ""), file=sys.stderr)
        return 78
    indexes = list(range(len(servers)))
    preferred = database.get("liteServers", [])
    if not isinstance(preferred, list):
        preferred = []
    preferred = {index for index in preferred if type(index) is int and 0 <= index < len(servers)}
    preferred = [index for index in indexes if index in preferred]
    # Retain healthy-server preference while escaping a stale cached list.
    remaining = [index for index in indexes if index not in preferred]
    indexes = preferred[:2] + remaining + preferred[2:]
    for attempt in range(attempts):
        index = indexes[attempt % len(indexes)]
        try:
            result = subprocess.run(
                [binary, "-C", str(config_path), "-v", "1", "-i", str(index), "-c", "getaccount " + raw],
                stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                text=True, errors="replace", timeout=timeout, check=False,
            )
            if result.returncode != 0:
                detail = re.sub(r"\s+", " ", result.stderr).strip()[:240]
                errors.append(f"lite server #{index}: exit {result.returncode}" + (": " + detail if detail else ""))
                continue
            state, nano = account_state(result.stdout)
        except subprocess.TimeoutExpired:
            errors.append(f"lite server #{index}: timed out after {timeout}s during client startup/account query")
            continue
        except (OSError, ValueError) as error:
            errors.append(f"lite server #{index}: {error}")
            continue
        emit_row(name, raw, version, state, nano)
        return 0
    print("Wallet state query failed: " + "; ".join(errors), file=sys.stderr)
    return 1


try:
    sys.exit(main())
except (ValueError, TypeError, OverflowError):
    sys.exit(1)
PY
}

# An activation postcheck shares one deadline across metadata, HTTPS and RPC.
# Other wallet queries keep their existing timeout values.
wallet_query_command_timeout() {
  local configured="$1" remaining configured_seconds
  if [[ -z "${KUBETON_WALLET_QUERY_DEADLINE:-}" ]]; then
    printf '%s' "$configured"
    return 0
  fi
  remaining=$((KUBETON_WALLET_QUERY_DEADLINE - $(date +%s)))
  (( remaining > 0 )) || return 1
  if [[ "$configured" =~ ^([0-9]+)s?$ ]]; then
    configured_seconds="${BASH_REMATCH[1]}"
    (( configured_seconds == 0 || configured_seconds >= remaining )) || remaining="$configured_seconds"
  fi
  printf '%ss' "$remaining"
}

read_tonnode_wallet_state_from_pod() {
  local ns="$1" pod="$2" wallet_name="$3" raw_address="$4"
  local script config version="unknown" https_output="" rpc_output="" rpc_rc=0 query_timeout
  local -a https_command=(python3)
  script="$(tonnode_wallet_query_script)"
  if command -v python3 >/dev/null 2>&1; then
    if config="$(read_tonnode_global_config "$ns" "$pod" 2>/dev/null)"; then
      version="$(read_tonnode_wallet_version_from_pod "$ns" "$pod" "$raw_address" 2>/dev/null || true)"
      [[ -n "$version" ]] || version="unknown"
      if [[ -n "${KUBETON_WALLET_QUERY_DEADLINE:-}" ]]; then
        query_timeout="$(wallet_query_command_timeout "$MYTONCTRL_EXEC_TIMEOUT")" || return 124
        https_command=(run_with_timeout "$query_timeout" python3)
      fi
      if https_output="$(printf '%s' "$config" | "${https_command[@]}" -c "$script" "$wallet_name" "$raw_address" \
          "$WALLET_QUERY_ATTEMPTS" "$WALLET_QUERY_TIMEOUT_SECONDS" --https-only "$version" 2>&1)"; then
        printf '%s' "$https_output"
        return 0
      fi
    else
      https_output="cannot read the pod's active global.config.json for the HTTPS query"
    fi
  else
    https_output="local python3 is unavailable for the HTTPS query"
  fi
  query_timeout="$(wallet_query_command_timeout "$MYTONCTRL_EXEC_TIMEOUT")" || return 124
  rpc_output="$(run_with_timeout "$query_timeout" kubectl -n "$ns" exec "$pod" -c ton-node -- \
    python3 -c "$script" "$wallet_name" "$raw_address" "$WALLET_QUERY_ATTEMPTS" "$WALLET_QUERY_TIMEOUT_SECONDS" --rpc-only 2>&1)" || rpc_rc=$?
  if (( rpc_rc == 0 )); then
    [[ -n "$rpc_output" ]] || return 1
    printf '%s' "$rpc_output"
    return 0
  fi
  [[ -z "$https_output" ]] || print_prefixed_lines "[wallet ${ns}/${pod}] " "$https_output" >&2
  if [[ -n "$rpc_output" ]]; then
    print_prefixed_lines "[wallet ${ns}/${pod}] " "$rpc_output" >&2
  elif (( rpc_rc == 124 )); then
    echo "[wallet ${ns}/${pod}] Pod query timed out after ${MYTONCTRL_EXEC_TIMEOUT}." >&2
  else
    echo "[wallet ${ns}/${pod}] Pod query failed with exit ${rpc_rc}." >&2
  fi
  return "$rpc_rc"
}

resolve_tonnode_wallet_row_from_pod() {
  local ns="$1"
  local pod="$2"
  local wallet_name="$3"
  local output row raw_address query_rc=0 query_timeout

  [[ "$wallet_name" =~ ^[A-Za-z0-9._-]+$ ]] || return 1
  if raw_address="$(read_tonnode_wallet_address_file_from_pod "$ns" "$pod" "$wallet_name")"; then
    output="$(read_tonnode_wallet_state_from_pod "$ns" "$pod" "$wallet_name" "$raw_address")" || query_rc=$?
    if (( query_rc == 0 )); then
      [[ -n "$output" ]] || return 1
      printf '%s' "$output"
      return 0
    fi
    # A real RPC failure must not fall back to wl's inferred empty/zero state.
    # Exit 78 is reserved for missing prerequisites in older installations.
    (( query_rc == 78 || query_rc == 127 )) || return 1
  fi
  query_timeout="$(wallet_query_command_timeout "$MYTONCTRL_EXEC_TIMEOUT")" || return 124
  output="$(run_with_timeout "$query_timeout" kubectl -n "$ns" exec "$pod" -c ton-node -- bash -c '
    if command -v mytonctrl >/dev/null 2>&1; then
      mytonctrl --cmd wl
    else
      exit 127
    fi
  ' 2>/dev/null)" || return 1
  output="$(strip_ansi_sequences "$output")"
  row="$(printf '%s\n' "$output" | awk -v wallet_name="$wallet_name" '
    $1 == wallet_name && NF >= 6 {
      print $1 "\t" $2 "\t" $3 "\t" $4 "\t" $5 "\t" $NF
      exit
    }
  ')"
  row="$(trim_whitespace "$row")"
  if [[ -z "$row" ]]; then
    return 1
  fi
  printf '%s' "$row"
}

list_tonnode_wallet_names_from_pod() {
  local ns="$1"
  local pod="$2"
  local strict="${3:-false}"
  local output

  output="$(run_with_timeout "$STATUS_EXEC_TIMEOUT" kubectl -n "$ns" exec "$pod" -c ton-node -- bash -lc '
    set -o pipefail
    strict="$1"
    wallet_dir="/var/ton-work/controller/mytoncore/wallets"
    if [[ ! -d "$wallet_dir" || ! -r "$wallet_dir" || ! -x "$wallet_dir" ]]; then
      [[ "$strict" != true ]] || exit 1
      exit 0
    fi
    shopt -s nullglob
    files=("$wallet_dir"/*.pk)
    # Deletion checks also include address-only wallets, even if their key
    # file is missing. Never read private key contents for this inventory.
    [[ "$strict" != true ]] || files+=("$wallet_dir"/*.addr)
    for f in "${files[@]}"; do
      base="${f##*/}"
      printf "%s\n" "${base%.*}"
    done | sort -u
  ' _ "$strict" 2>/dev/null)" || return 1
  output="$(strip_ansi_sequences "$output")"
  printf '%s\n' "$output" | awk 'NF'
}

read_tonnode_wallet_address_file_from_pod() {
  local ns="$1"
  local pod="$2"
  local wallet_name="$3"
  local output query_timeout

  query_timeout="$(wallet_query_command_timeout "$STATUS_EXEC_TIMEOUT")" || return 124
  output="$(run_with_timeout "$query_timeout" kubectl -n "$ns" exec "$pod" -c ton-node -- bash -lc '
    wallet_name="$1"
    wallet_dir="/var/ton-work/controller/mytoncore/wallets"
    set -o pipefail
    if ! [[ "$wallet_name" =~ ^[A-Za-z0-9._-]+$ ]]; then
      exit 2
    fi
    addr_file="${wallet_dir}/${wallet_name}.addr"
    [[ -r "$addr_file" ]] || exit 1
    LC_ALL=C od -An -tx1 -v "$addr_file" | tr -d " \n"
  ' _ "$wallet_name" 2>/dev/null)" || return 1
  ton_wallet_address_file_hex_to_hex "$output"
}

read_tonnode_wallet_version_from_pod() {
  local ns="$1"
  local pod="$2"
  local raw_address="$3"
  local output query_timeout

  [[ "$raw_address" =~ ^-?[0-9]+:[[:xdigit:]]{64}$ ]] || return 1
  query_timeout="$(wallet_query_command_timeout "$STATUS_EXEC_TIMEOUT")" || return 124
  output="$(run_with_timeout "$query_timeout" kubectl -n "$ns" exec "$pod" -c ton-node -- python3 -c '
import base64
import binascii
import json
import pathlib
import re
import sys

try:
    workchain, account = sys.argv[1].split(":")
    workchain = int(workchain)
    if not -128 <= workchain <= 127:
        sys.exit(1)
    body = bytes([0x11, workchain & 255]) + bytes.fromhex(account)
    key = base64.urlsafe_b64encode(body + binascii.crc_hqx(body, 0).to_bytes(2, "big")).decode()
    database = json.loads(pathlib.Path("/var/ton-work/controller/mytoncore/mytoncore.db").read_text())
    versions = database.get("walletsVersionList", {})
    version = versions.get(key) if isinstance(versions, dict) else None
    if not isinstance(version, str) or not re.fullmatch(r"[A-Za-z0-9._-]{1,32}", version):
        sys.exit(1)
    print(version)
except (OSError, ValueError, TypeError, AttributeError):
    sys.exit(1)
' "$raw_address" 2>/dev/null)" || return 1
  [[ "$output" =~ ^[A-Za-z0-9._-]{1,32}$ ]] || return 1
  printf '%s' "$output"
}

read_tonnode_wallet_private_key_hex_from_pod() {
  local ns="$1"
  local pod="$2"
  local wallet_name="$3"
  local output
  local exec_rc=0

  output="$(run_with_timeout "$STATUS_EXEC_TIMEOUT" kubectl -n "$ns" exec "$pod" -c ton-node -- bash -lc '
    wallet_name="$1"
    wallet_dir="/var/ton-work/controller/mytoncore/wallets"
    if ! [[ "$wallet_name" =~ ^[A-Za-z0-9._-]+$ ]]; then
      echo "Error: invalid wallet name ${wallet_name}." >&2
      exit 2
    fi
    pk_file="${wallet_dir}/${wallet_name}.pk"
    if [[ ! -r "$pk_file" ]]; then
      echo "Error: private key file not found or not readable: ${pk_file}" >&2
      exit 1
    fi
    if ! command -v od >/dev/null 2>&1; then
      echo "Error: od command not found." >&2
      exit 127
    fi
    LC_ALL=C od -An -tx1 -v "$pk_file" | tr -d " \n"
    printf "\n"
  ' _ "$wallet_name" 2>&1)" || exec_rc=$?
  output="$(strip_ansi_sequences "$output")"
  output="$(trim_whitespace "$output")"
  if (( exec_rc != 0 )); then
    echo "Error: failed to read private key for '${wallet_name}' in ${ns}/${pod} (exit ${exec_rc})." >&2
    if [[ -n "$output" ]]; then
      print_prefixed_lines "  ${pod}> " "$output" >&2
    fi
    return "$exec_rc"
  fi
  if ! [[ "$output" =~ ^[0-9A-Fa-f]+$ ]]; then
    echo "Error: private key output for '${wallet_name}' in ${ns}/${pod} was not hex." >&2
    return 1
  fi
  printf '%s' "$(printf '%s' "$output" | tr '[:upper:]' '[:lower:]')"
}

run_wallet_export_tonnode() {
  local target_pod_name="${1:-}"
  local target_wallet_name="${2:-}"
  local row target_ns target_pod target_node_name wallet_name wallet_row
  local status balance version workchain address address_hex listed_address_hex file_address private_key_hex
  local rc=0
  local -a pod_rows=()
  local -a wallet_names=()
  local -a candidate_rows=()
  local -a table_rows=()

  target_pod_name="$(trim_whitespace "$target_pod_name")"
  target_wallet_name="$(trim_whitespace "$target_wallet_name")"
  if [[ -n "$target_wallet_name" ]] && ! [[ "$target_wallet_name" =~ ^[A-Za-z0-9._-]+$ ]]; then
    echo "Error: invalid wallet name '${target_wallet_name}'." >&2
    return 1
  fi

  if [[ -n "$target_pod_name" ]]; then
    row="$(resolve_tonnode_pod_row_by_name "$target_pod_name" || true)"
    row="$(trim_whitespace "$row")"
    if [[ -z "$row" ]]; then
      echo "Error: TON pod '${target_pod_name}' not found." >&2
      return 1
    fi
    pod_rows+=("$row")
  else
    mapfile -t pod_rows < <(list_ton_pods 2>/dev/null || true)
  fi

  for row in "${pod_rows[@]}"; do
    [[ -z "$row" ]] && continue
    IFS=$'\t' read -r target_ns target_pod target_node_name <<<"$row"
    [[ -z "$target_ns" || -z "$target_pod" ]] && continue
    if [[ -z "$(trim_whitespace "$target_node_name")" ]]; then
      if [[ -n "$target_pod_name" ]]; then
        echo "Error: pod ${target_ns}/${target_pod} does not have a host assigned; cannot exec into it." >&2
        return 1
      fi
      echo "Warning: pod ${target_ns}/${target_pod} does not have a host assigned; skipping." >&2
      continue
    fi

    wallet_names=()
    if [[ -n "$target_wallet_name" ]]; then
      wallet_names+=("$target_wallet_name")
    else
      mapfile -t wallet_names < <(list_tonnode_wallet_names_from_pod "$target_ns" "$target_pod" || true)
    fi
    if [[ ${#wallet_names[@]} -eq 0 ]]; then
      echo "Warning: no wallet private key files found in ${target_ns}/${target_pod}." >&2
      continue
    fi

    for wallet_name in "${wallet_names[@]}"; do
      wallet_name="$(trim_whitespace "$wallet_name")"
      [[ -z "$wallet_name" ]] && continue
      if ! [[ "$wallet_name" =~ ^[A-Za-z0-9._-]+$ ]]; then
        echo "Warning: invalid wallet name '${wallet_name}' in ${target_ns}/${target_pod}; skipping." >&2
        continue
      fi

      address=""
      wallet_row="$(resolve_tonnode_wallet_row_from_pod "$target_ns" "$target_pod" "$wallet_name" || true)"
      wallet_row="$(trim_whitespace "$wallet_row")"
      if [[ -n "$wallet_row" ]]; then
        IFS=$'\t' read -r wallet_name status balance version workchain address <<<"$wallet_row"
      fi
      address="$(trim_whitespace "$address")"
      listed_address_hex="$(ton_address_to_hex "$address" || true)"
      file_address="$(read_tonnode_wallet_address_file_from_pod "$target_ns" "$target_pod" "$wallet_name" || true)"
      if [[ -n "$file_address" ]]; then
        address_hex="$file_address"
        # Retain a friendly representation only when it names the account
        # actually recorded in the wallet file.
        [[ "$listed_address_hex" == "$file_address" ]] || address="$file_address"
      elif [[ -n "$listed_address_hex" ]]; then
        address_hex="$listed_address_hex"
      else
        address="unknown"
        address_hex="unknown"
        echo "Warning: cannot resolve wallet address for '${wallet_name}' in ${target_ns}/${target_pod}; exporting private key with unknown address." >&2
      fi
      candidate_rows+=("${target_ns}"$'\t'"${target_pod}"$'\t'"${wallet_name}"$'\t'"${address}"$'\t'"${address_hex}")
    done
  done

  if [[ ${#candidate_rows[@]} -eq 0 ]]; then
    echo "Error: no TON pod wallets found to export." >&2
    return 1
  fi

  if [[ -n "$target_pod_name" ]]; then
    confirm_or_exit "This will print private key hex for wallet '${target_wallet_name}' in '${target_pod_name}'. Continue?"
  else
    confirm_or_exit "This will print private key hex for ${#candidate_rows[@]} wallet(s) from all TON pods. Continue?"
  fi

  for row in "${candidate_rows[@]}"; do
    IFS=$'\t' read -r target_ns target_pod wallet_name address address_hex <<<"$row"
    private_key_hex="$(read_tonnode_wallet_private_key_hex_from_pod "$target_ns" "$target_pod" "$wallet_name" || true)"
    private_key_hex="$(trim_whitespace "$private_key_hex")"
    if [[ -z "$private_key_hex" ]]; then
      rc=1
      continue
    fi
    table_rows+=("${target_ns}"$'\t'"${target_pod}"$'\t'"${wallet_name}"$'\t'"${address}"$'\t'"${address_hex}"$'\t'"${private_key_hex}")
  done

  if [[ ${#table_rows[@]} -eq 0 ]]; then
    echo "Error: no private keys were exported." >&2
    return 1
  fi
  print_aligned_table_6col "namespace" "tonnode pod" "wallet-name" "wallet-address" "address-hex" "private-key-hex" "${table_rows[@]}"
  return "$rc"
}

run_wallet_balance_show() {
  local target_pod_name="${1:-}"
  local target_wallet_name="${2:-validator_wallet_001}"
  local row target_ns target_pod target_node_name wallet_row
  local wallet_name status balance version workchain address raw_address pod_inventory
  local live_state_available
  local -a pod_rows=()
  local -a table_rows=()

  target_wallet_name="$(trim_whitespace "$target_wallet_name")"
  [[ -z "$target_wallet_name" ]] && target_wallet_name="validator_wallet_001"
  if ! [[ "$target_wallet_name" =~ ^[A-Za-z0-9._-]+$ ]]; then
    echo "Error: invalid wallet name '${target_wallet_name}'." >&2
    return 1
  fi

  if [[ -n "$target_pod_name" ]]; then
    row="$(resolve_tonnode_pod_row_by_name "$target_pod_name" || true)"
    row="$(trim_whitespace "$row")"
    if [[ -z "$row" ]]; then
      echo "Error: TON pod '${target_pod_name}' not found." >&2
      return 1
    fi
    pod_rows+=("$row")
  else
    if ! pod_inventory="$(list_ton_pods)"; then
      echo "Error: cannot list all TON pods for wallet balances." >&2
      return 1
    fi
    mapfile -t pod_rows <<<"$pod_inventory"
  fi

  for row in "${pod_rows[@]}"; do
    [[ -z "$row" ]] && continue
    IFS=$'\t' read -r target_ns target_pod target_node_name <<<"$row"
    [[ -z "$target_ns" || -z "$target_pod" ]] && continue
    wallet_name="$target_wallet_name"
    status="unknown" balance="unknown" version="unknown" workchain="unknown" address="unknown"
    live_state_available=0
    if wallet_row="$(resolve_tonnode_wallet_row_from_pod "$target_ns" "$target_pod" "$target_wallet_name")" && [[ -n "$wallet_row" ]]; then
      IFS=$'\t' read -r wallet_name status balance version workchain address <<<"$wallet_row"
      live_state_available=1
    else
      echo "Warning: live balance unavailable for wallet '${target_wallet_name}' in ${target_ns}/${target_pod}; showing unknown." >&2
    fi
    # Retain the row even when wl fails. A local address does not establish
    # whether the wallet is active or funded, so those fields remain unknown.
    if ! ton_address_to_hex "$address" >/dev/null 2>&1; then
      address="unknown"
      if raw_address="$(read_tonnode_wallet_address_file_from_pod "$target_ns" "$target_pod" "$target_wallet_name")"; then
        workchain="${raw_address%%:*}"
        address="$(ton_address_to_non_bounceable "$raw_address" || printf '%s' "$raw_address")"
        if (( live_state_available == 0 )); then
          if ! version="$(read_tonnode_wallet_version_from_pod "$target_ns" "$target_pod" "$raw_address")"; then
            version="unknown"
          fi
        fi
      fi
    fi
    table_rows+=("${target_ns}"$'\t'"${target_pod}"$'\t'"${wallet_name}"$'\t'"${status}"$'\t'"${balance}"$'\t'"${version}"$'\t'"${workchain}"$'\t'"${address}")
  done

  if [[ ${#table_rows[@]} -eq 0 ]]; then
    echo "Error: no TON wallet balances resolved for wallet name '${target_wallet_name}'." >&2
    return 1
  fi
  print_aligned_table_8col "namespace" "tonnode pod" "wallet-name" "status" "balance" "ver" "wch" "wallet-address" "${table_rows[@]}"
}

wait_for_tonnode_wallet_active() (
  local ns="$1" pod="$2" wallet_name="$3" expected_address="$4"
  local attempts="$WALLET_ACTIVATION_CONFIRM_ATTEMPTS" delay="$WALLET_ACTIVATION_CONFIRM_DELAY_SECONDS"
  local timeout_seconds="$WALLET_ACTIVATION_CONFIRM_TIMEOUT_SECONDS" attempt row returned_name status balance version workchain address actual_raw remaining
  local last_error="no live state response" last_query_error="" error_file
  [[ "$attempts" =~ ^[1-9][0-9]?$ ]] || attempts=6
  [[ "$delay" =~ ^[0-9]{1,3}$ ]] || delay=2
  [[ "$timeout_seconds" =~ ^[1-9][0-9]{0,3}$ ]] || timeout_seconds=60
  expected_address="$(ton_address_to_hex "$expected_address")" || return 1
  local KUBETON_WALLET_QUERY_DEADLINE="$(($(date +%s) + timeout_seconds))"
  error_file="$(mktemp)" || return 1
  trap 'rm -f "$error_file"' EXIT
  for ((attempt = 1; attempt <= attempts; attempt++)); do
    remaining=$((KUBETON_WALLET_QUERY_DEADLINE - $(date +%s)))
    (( remaining > 0 )) || break
    if row="$(resolve_tonnode_wallet_row_from_pod "$ns" "$pod" "$wallet_name" 2>"$error_file")"; then
      IFS=$'\t' read -r returned_name status balance version workchain address <<<"$row"
      actual_raw="$(ton_address_to_hex "$address" 2>/dev/null || true)"
      if [[ "$returned_name" != "$wallet_name" || "$actual_raw" != "$expected_address" ]]; then
        echo "Error: activation state query returned a different wallet identity for ${ns}/${pod}; refusing to count it as activated." >&2
        return 1
      fi
      if [[ "${status,,}" == active ]]; then return 0; fi
      last_error="last verified wallet state: ${status:-unknown}"
      last_query_error=""
    else
      last_error="live wallet state could not be read"
      last_query_error="$(<"$error_file")"
    fi
    remaining=$((KUBETON_WALLET_QUERY_DEADLINE - $(date +%s)))
    if (( attempt < attempts && delay > 0 && remaining > 0 )); then
      (( delay <= remaining )) || delay="$remaining"
      sleep "$delay"
    fi
  done
  echo "Error: activation was not confirmed for '${wallet_name}' in ${ns}/${pod} (${last_error})." >&2
  [[ -z "$last_query_error" ]] || print_prefixed_lines "  ${pod}> " "$last_query_error" >&2
  return 1
)

activate_tonnode_wallet_in_pod() {
  local ns="$1" pod="$2" wallet_name="$3" expected_address="${4:-}"
  local output verification_output exec_rc=0
  if [[ -z "$expected_address" ]]; then
    expected_address="$(read_tonnode_wallet_address_file_from_pod "$ns" "$pod" "$wallet_name")" || {
      echo "Error: cannot establish the wallet identity for '${wallet_name}' in ${ns}/${pod}; no activation submitted." >&2
      return 1
    }
  fi
  expected_address="$(ton_address_to_hex "$expected_address")" || return 1
  output="$(run_with_timeout "$MYTONCTRL_EXEC_TIMEOUT" kubectl -n "$ns" exec "$pod" -c ton-node -- bash -c '
    wallet_name="$1"
    mtc_cmd="aw ${wallet_name}"
    if ! command -v mytonctrl >/dev/null 2>&1; then
      echo "Error: mytonctrl command not found." >&2
      exit 127
    fi
    set +e
    mytonctrl --cmd "$mtc_cmd"
    mtc_rc=$?
    if (( mtc_rc == 2 )); then
      printf "%s\n" "$mtc_cmd" | mytonctrl
    else
      exit "$mtc_rc"
    fi
  ' _ "$wallet_name" 2>&1)" || exec_rc=$?
  output="$(strip_ansi_sequences "$output")"
  # MyTonCtrl broadcasts redundant copies before waiting for seqno. A later
  # copy can be rejected after activation has already succeeded. Classify the
  # outcome from the named account's live state, never from console text/rc.
  if verification_output="$(wait_for_tonnode_wallet_active "$ns" "$pod" "$wallet_name" "$expected_address" 2>&1)"; then
    echo "[wallet] Wallet '${wallet_name}' in ${ns}/${pod} is active (confirmed on chain)."
    return 0
  fi
  if (( exec_rc != 0 )); then
    echo "Error: mytonctrl aw failed in ${ns}/${pod} with exit code ${exec_rc}." >&2
    if (( exec_rc == 124 )); then
      echo "Error: command timed out after MYTONCTRL_EXEC_TIMEOUT=${MYTONCTRL_EXEC_TIMEOUT}." >&2
    fi
  fi
  [[ -z "$verification_output" ]] || printf '%s\n' "$verification_output" >&2
  if [[ -n "$output" ]]; then
    echo "mytonctrl output from ${ns}/${pod}:" >&2
    print_prefixed_lines "  ${pod}> " "$output" >&2
  fi
  (( exec_rc != 0 )) || exec_rc=1
  return "$exec_rc"
}

run_wallet_activate() {
  local target_pod_name="${1:-}"
  local target_wallet_name="${2:-validator_wallet_001}"
  local row target_ns target_pod target_node_name wallet_row
  local wallet_name status balance version workchain address
  local rc=0
  local activated_count=0
  local pending_count=0
  local skipped_count=0
  local action
  local -a pod_rows=()
  local -a table_rows=()

  target_wallet_name="$(trim_whitespace "$target_wallet_name")"
  [[ -z "$target_wallet_name" ]] && target_wallet_name="validator_wallet_001"
  if ! [[ "$target_wallet_name" =~ ^[A-Za-z0-9._-]+$ ]]; then
    echo "Error: invalid wallet name '${target_wallet_name}'." >&2
    return 1
  fi

  if [[ -n "$target_pod_name" ]]; then
    row="$(resolve_tonnode_pod_row_by_name "$target_pod_name" || true)"
    row="$(trim_whitespace "$row")"
    if [[ -z "$row" ]]; then
      echo "Error: TON pod '${target_pod_name}' not found." >&2
      return 1
    fi
    pod_rows+=("$row")
  else
    mapfile -t pod_rows < <(list_ton_pods 2>/dev/null || true)
  fi

  for row in "${pod_rows[@]}"; do
    [[ -z "$row" ]] && continue
    IFS=$'\t' read -r target_ns target_pod target_node_name <<<"$row"
    [[ -z "$target_ns" || -z "$target_pod" ]] && continue
    wallet_row="$(resolve_tonnode_wallet_row_from_pod "$target_ns" "$target_pod" "$target_wallet_name" || true)"
    wallet_row="$(trim_whitespace "$wallet_row")"
    if [[ -z "$wallet_row" ]]; then
      if [[ -n "$target_pod_name" ]]; then
        echo "Error: wallet '${target_wallet_name}' was not found in ${target_ns}/${target_pod}." >&2
        return 1
      fi
      echo "Warning: cannot resolve wallet '${target_wallet_name}' in ${target_ns}/${target_pod}; skipping." >&2
      continue
    fi
    IFS=$'\t' read -r wallet_name status balance version workchain address <<<"$wallet_row"
    if [[ "${status,,}" == "active" ]]; then
      action="already active"
    else
      action="aw ${wallet_name}"
      ((pending_count+=1))
    fi
    table_rows+=("${target_ns}"$'\t'"${target_pod}"$'\t'"${wallet_name}"$'\t'"${address}"$'\t'"${action}")
  done

  if [[ ${#table_rows[@]} -eq 0 ]]; then
    echo "Error: no TON wallets resolved for wallet name '${target_wallet_name}'." >&2
    return 1
  fi

  print_aligned_table_5col "namespace" "tonnode pod" "wallet-name" "wallet-address" "mytonctrl-command" "${table_rows[@]}"
  if (( pending_count == 0 )); then
    echo "[wallet] All ${#table_rows[@]} resolved wallet(s) are already active."
    return 0
  fi
  confirm_or_exit "Activate '${target_wallet_name}' with mytonctrl aw on ${pending_count} TON pod(s)?"

  for row in "${table_rows[@]}"; do
    IFS=$'\t' read -r target_ns target_pod wallet_name address action <<<"$row"
    if [[ "$action" == "already active" ]]; then
      ((skipped_count+=1))
      continue
    fi
    echo "[wallet] Activating ${wallet_name} in ${target_ns}/${target_pod} using: aw ${wallet_name}" >&2
    if activate_tonnode_wallet_in_pod "$target_ns" "$target_pod" "$wallet_name" "$address"; then
      ((activated_count+=1))
    else
      rc=1
    fi
  done

  if (( rc != 0 )); then
    echo "Error: activated ${activated_count}/${pending_count} wallet(s), skipped ${skipped_count} already active wallet(s); at least one activation could not be verified." >&2
    return 1
  fi
  echo "[wallet] Activated ${activated_count}/${pending_count} wallet(s) with mytonctrl aw; skipped ${skipped_count} already active wallet(s)."
}

resolve_main_wallet_receive_address() {
  local wallet_network="$1"
  local wallet_name="$2"
  local output address address_row saved_network

  wallet_name="$(trim_whitespace "$wallet_name")"
  [[ -n "$wallet_name" ]] || return 1

  output="$(run_wallet show "$wallet_name" 2>&1)" || {
    local rc=$?
    printf '%s\n' "$output" >&2
    return "$rc"
  }
  output="$(strip_ansi_sequences "$output")"
  address_row="$(printf '%s\n' "$output" | awk -v wallet_name="$wallet_name" '
    $1 == "workchain" && $2 == "wallet-id" {
      for (i = 1; i <= NF; i++) column[$i] = i
      next
    }
    column["wallet-name"] && $(column["wallet-name"]) == wallet_name {
      network = column["network"] ? $(column["network"]) : "unknown"
      address = $(column["non-bounceable"])
      if (address == "" || address == "unknown") {
        address = $(column["wallet-address"])
      }
      if (address != "" && address != "unknown") print network "\t" address
      exit
    }
  ')"
  IFS=$'\t' read -r saved_network address <<<"$address_row"
  address="$(trim_whitespace "$address")"
  if [[ -z "$address" ]]; then
    echo "Error: cannot resolve receive address for main wallet '${wallet_name}'." >&2
    return 1
  fi
  if [[ -n "$saved_network" && "$saved_network" != unknown && "$saved_network" != "$wallet_network" ]]; then
    echo "Error: main wallet '${wallet_name}' is saved for ${saved_network}, but the active fleet uses ${wallet_network}." >&2
    return 1
  fi
  if ! ton_address_valid_for_network "$address" "$wallet_network"; then
    echo "Error: resolved main-wallet address '${address}' is not valid for ${wallet_network}." >&2
    return 1
  fi

  printf '%s' "$address"
}

tonnode_wallet_collect_script() {
  cat <<'PY'
import base64
import binascii
import fcntl
import hashlib
import json
import os
import pathlib
import re
import resource
import secrets
import signal
import shutil
import subprocess
import sys
import tempfile
import time
import urllib.error
import urllib.parse
import urllib.request
import uuid

JOURNAL_ROOT = pathlib.Path('/var/ton-work/controller/.kubeton-collect')
WALLET_ROOT = pathlib.Path('/var/ton-work/controller/mytoncore/wallets')
CONFIG_PATH = pathlib.Path('/var/ton-work/controller/global.config.json')
ACTIVE_ROOT = pathlib.Path('/run/ton-active')
CHECKPOINT_REQUEST_ROOT = pathlib.Path('/tmp/key-backup.requests')
CHECKPOINT_ACK_ROOT = pathlib.Path('/tmp/key-backup.acks')


def normalize_address(address):
    if not isinstance(address, str):
        raise ValueError('invalid TON address')
    match = re.fullmatch(r'(-?[0-9]+):([0-9A-Fa-f]{64})', address)
    if match:
        workchain = int(match[1])
        if not -(2**31) <= workchain < 2**31:
            raise ValueError('invalid TON workchain')
        return str(workchain) + ':' + match[2].lower()
    if not re.fullmatch(r'[A-Za-z0-9_+/=-]{48}', address):
        raise ValueError('invalid friendly TON address')
    data = base64.b64decode(address.replace('-', '+').replace('_', '/'), validate=True)
    if len(data) != 36 or data[0] & 0x7f not in (0x11, 0x51):
        raise ValueError('invalid friendly TON address header')
    if binascii.crc_hqx(data[:34], 0).to_bytes(2, 'big') != data[34:]:
        raise ValueError('invalid friendly TON address checksum')
    return str(int.from_bytes(data[1:2], 'big', signed=True)) + ':' + data[2:34].hex()


def nano_amount(value):
    if not isinstance(value, str) or not re.fullmatch(r'[0-9]+(?:\.[0-9]*)?', value):
        raise ValueError('invalid TON amount')
    whole, separator, fraction = value.partition('.')
    if len(fraction) > 9 or len(whole) > 37:
        raise ValueError('TON amount must have at most nine decimal places')
    amount = int(whole) * 1_000_000_000 + int((fraction + '000000000')[:9])
    if amount >= 2**120:
        raise ValueError('TON amount is out of range')
    return amount


def comment_body(encoded):
    # TonUtil stores long text as SnakeData. Validate every ordinary cell and
    # the complete reference chain before accepting the exact comment.
    blob = base64.b64decode(encoded, validate=True)
    if len(blob) < 11 or blob[:4] != bytes.fromhex('b5ee9c72'):
        raise ValueError('invalid comment BOC')
    flags, width = blob[4:6]
    size = flags & 7
    if flags & 0x38 or not 1 <= size <= 4 or not 1 <= width <= 8:
        raise ValueError('unsupported comment BOC')
    end = len(blob) - (4 if flags & 0x40 else 0)
    if flags & 0x40:
        crc = 0xffffffff
        for byte in blob[:end]:
            crc ^= byte
            for _ in range(8):
                crc = (crc >> 1) ^ (0x82f63b78 if crc & 1 else 0)
        if (crc ^ 0xffffffff).to_bytes(4, 'little') != blob[end:]:
            raise ValueError('invalid comment BOC checksum')
    cursor = 6

    def number(length):
        nonlocal cursor
        if cursor + length > end:
            raise ValueError('truncated comment BOC')
        result = int.from_bytes(blob[cursor:cursor + length], 'big')
        cursor += length
        return result

    count, roots, absent, total = number(size), number(size), number(size), number(width)
    root = number(size)
    if not 1 <= count <= 32 or roots != 1 or absent != 0 or root >= count:
        raise ValueError('unsupported comment BOC roots')
    if flags & 0x80:
        for _ in range(count):
            number(width)
    if cursor + total != end:
        raise ValueError('invalid comment BOC length')
    cells = []
    for _ in range(count):
        descriptor, bits = number(1), number(1)
        refs = descriptor & 7
        if descriptor & 0xf8 or refs > 1 or bits & 1 or cursor + bits // 2 > end:
            raise ValueError('invalid comment BOC cell')
        data = blob[cursor:cursor + bits // 2]
        cursor += bits // 2
        references = [number(size) for _ in range(refs)]
        cells.append((data, references))
    if cursor != end:
        raise ValueError('invalid comment BOC cell length')
    body, seen = b'', set()
    index = root
    while True:
        if index >= count or index in seen:
            raise ValueError('invalid comment BOC references')
        seen.add(index)
        data, refs = cells[index]
        body += data
        if not refs:
            break
        index = refs[0]
    if len(seen) != count:
        raise ValueError('unused comment BOC cells')
    if body[:4] != b'\x00\x00\x00\x00':
        raise ValueError('message is not a text comment')
    return body[4:].decode('utf-8')


def message_comment(message):
    data = message.get('msg_data')
    if not isinstance(data, dict):
        raise ValueError('missing transfer comment payload')
    kind = data.get('@type')
    if kind == 'msg.dataText':
        decoded = base64.b64decode(data.get('text', ''), validate=True).decode('utf-8')
    elif kind == 'msg.dataRaw':
        decoded = comment_body(data.get('body', ''))
    else:
        raise ValueError('unsupported transfer comment payload')
    # The API's message field is decoded text for dataText and base64 cell
    # contents for dataRaw. The structured payload above is authoritative.
    if kind == 'msg.dataText' and message.get('message', decoded) != decoded:
        raise ValueError('inconsistent transfer comment')
    return decoded


def transaction_succeeded(encoded, expected_account=None, expected_lt=None, allow_uninit=True):
    """Fail closed unless a V2 transaction BOC proves an ordinary wallet credit."""
    try:
        raw = base64.b64decode(encoded, validate=True)
        if not (12 <= len(raw) <= 1048576) or raw[:4] != bytes.fromhex('b5ee9c72'):
            return False
        flags, offset_size = raw[4:6]
        size = flags & 7
        if flags & 0x38 or not 1 <= size <= 4 or not 1 <= offset_size <= 8:
            return False
        has_index, has_crc = bool(flags & 0x80), bool(flags & 0x40)
        pos = 6

        def number(width):
            nonlocal pos
            if pos + width > len(raw):
                raise ValueError('truncated BOC header')
            value = int.from_bytes(raw[pos:pos + width], 'big')
            pos += width
            return value

        count, roots, absent = number(size), number(size), number(size)
        total = number(offset_size)
        if not 1 <= count <= 10000 or roots != 1 or absent:
            return False
        root = number(size)
        if root >= count:
            return False
        if has_index:
            previous = 0
            for unused in range(count):
                end = number(offset_size)
                if not previous <= end <= total:
                    return False
                previous = end
        data_end = pos + total
        if data_end + (4 if has_crc else 0) != len(raw):
            return False
        if has_crc:
            crc = 0xffffffff
            for byte in raw[:-4]:
                crc ^= byte
                for unused in range(8):
                    crc = (crc >> 1) ^ (0x82f63b78 if crc & 1 else 0)
            if ((crc ^ 0xffffffff).to_bytes(4, 'little') != raw[-4:]):
                return False
        cells = []
        for cell_index in range(count):
            if pos + 2 > data_end:
                return False
            descriptor, bits_descriptor = raw[pos:pos + 2]
            pos += 2
            references = descriptor & 7
            if references > 4 or descriptor & 0xf8:
                return False
            byte_count = (bits_descriptor + 1) // 2
            if pos + byte_count + references * size > data_end:
                return False
            payload = raw[pos:pos + byte_count]
            pos += byte_count
            bits = byte_count * 8
            if bits_descriptor & 1:
                if not payload or not payload[-1]:
                    return False
                trailing = (payload[-1] & -payload[-1]).bit_length() - 1
                if trailing >= 7:
                    return False
                bits -= trailing + 1
            refs = [number(size) for unused in range(references)]
            if any(index <= cell_index or index >= count for index in refs):
                return False
            cells.append((int.from_bytes(payload, 'big'), bits, byte_count * 8, refs))
        if pos != data_end:
            return False

        class Slice:
            def __init__(self, index):
                self.value, self.length, self.width, self.refs = cells[index]
                self.pos = self.refpos = 0

            def uint(self, width):
                if width < 0 or self.pos + width > self.length:
                    raise ValueError('truncated TL-B field')
                value = (self.value >> (self.width - self.pos - width)) & ((1 << width) - 1)
                self.pos += width
                return value

            def ref(self):
                if self.refpos >= len(self.refs):
                    raise ValueError('missing TL-B reference')
                result = Slice(self.refs[self.refpos])
                self.refpos += 1
                return result

            def varuint(self, bound):
                width = self.uint((bound - 1).bit_length())
                if width >= bound:
                    raise ValueError('invalid VarUInteger')
                return self.uint(width * 8)

            def done(self):
                if self.pos != self.length or self.refpos != len(self.refs):
                    raise ValueError('unconsumed TL-B data')

        def currency(s):
            grams = s.varuint(16)
            if s.uint(1):
                s.ref()  # ExtraCurrencyCollection dictionary
            return grams

        def status_change(s):
            if s.uint(1):
                s.uint(1)

        tx = Slice(root)
        if tx.uint(4) != 7:
            return False
        account, lt = tx.uint(256), tx.uint(64)
        if expected_account is not None:
            if account != int(expected_account.split(':', 1)[1], 16):
                return False
        if expected_lt is not None and lt != int(expected_lt):
            return False
        tx.uint(256)  # previous transaction hash
        tx.uint(64)   # previous transaction LT
        tx.uint(32)   # creation time
        out_count = tx.uint(15)
        tx.uint(2)    # original account status
        end_status = tx.uint(2)
        messages = tx.ref()
        currency(tx)
        state_update = tx.ref()
        description = tx.ref()
        tx.done()
        if state_update.uint(8) != 0x72:
            return False
        state_update.uint(512)
        state_update.done()
        # A collection must credit the destination without creating a return
        # message. A non-bounceable deposit into an undeployed wallet is also
        # valid even though the missing code prevents execution of a getter.
        if out_count != 0 or end_status not in (0, 2) or messages.uint(1) != 1:
            return False
        incoming = messages.ref()
        if messages.uint(1) != 0:
            return False
        messages.done()
        if incoming.uint(1) != 0:  # int_msg_info$0
            return False
        incoming.uint(1)  # IHR disabled
        requested_bounce = incoming.uint(1)
        if incoming.uint(1):  # bounced messages cannot be collection receipts
            return False
        if description.uint(4) != 0:  # trans_ord$0000
            return False
        description.uint(1)  # credit_first
        if description.uint(1):
            description.varuint(16)
            if description.uint(1):
                description.varuint(16)
            status_change(description)
        if description.uint(1) != 1:
            return False
        if description.uint(1):
            description.varuint(16)
        if currency(description) <= 0:
            return False
        if description.uint(1) == 0:  # skipped computation
            reason = description.uint(2)
            if not allow_uninit or end_status != 0 or requested_bounce or reason != 0:
                return False
            if description.uint(1) != 0:  # no action phase
                return False
            description.uint(1)  # aborted is expected when no code could run
            if description.uint(1) != 0:  # no bounce phase
                return False
            if description.uint(1) != 0:  # destination not destroyed
                return False
            description.done()
            return True
        if end_status != 2:
            return False
        if description.uint(1) != 1:
            return False
        description.uint(1)  # msg_state_used
        description.uint(1)  # account_activated
        description.varuint(16)
        vm = description.ref()
        vm.varuint(7)
        vm.varuint(7)
        if vm.uint(1):
            vm.varuint(3)
        vm.uint(8)
        if vm.uint(32) not in (0, 1):
            return False
        if vm.uint(1):
            vm.uint(32)
        vm.uint(32)
        vm.uint(512)
        vm.done()
        if description.uint(1):
            action = description.ref()
            if (action.uint(1), action.uint(1), action.uint(1)) != (1, 1, 0):
                return False
            status_change(action)
            if action.uint(1):
                action.varuint(16)
            if action.uint(1):
                action.varuint(16)
            if action.uint(32) != 0:
                return False
            if action.uint(1):
                action.uint(32)
            action.uint(16)
            action.uint(16)
            if action.uint(16) != 0 or action.uint(16) != 0:
                return False
            action.uint(256)
            action.varuint(7)
            action.varuint(7)
            action.done()
        if description.uint(1) != 0:  # aborted
            return False
        if description.uint(1) != 0:  # bounce phase
            return False
        if description.uint(1) != 0:  # destroyed main wallet
            return False
        description.done()
        return True
    except (ValueError, TypeError, IndexError, KeyError, OverflowError):
        return False


def parse_receipt(response, source, destination, amount_nano, balance_nano, marker):
    source, destination = normalize_address(source), normalize_address(destination)
    if not isinstance(response, dict) or response.get('ok') is not True or not isinstance(response.get('result'), list):
        raise ValueError('transaction API rejected the query')
    matches = []
    for transaction in response['result']:
        if not isinstance(transaction, dict):
            raise ValueError('invalid transaction history entry')
        message = transaction.get('in_msg')
        if not isinstance(message, dict):
            continue
        try:
            if message_comment(message) != marker:
                continue
            actual_source = normalize_address(message.get('source'))
            actual_destination = normalize_address(message.get('destination'))
        except (ValueError, TypeError, UnicodeError, binascii.Error):
            continue
        if (actual_source, actual_destination) != (source, destination):
            continue
        description = transaction.get('description', {})
        if not isinstance(description, dict):
            raise ValueError('invalid matching transaction description')
        explicit_abort = transaction.get('aborted') is True or description.get('aborted') is True
        # An explicit bounce from the receiver back to the sending wallet is
        # a rejection, not successful receipt of a collection payment.
        outgoing = transaction.get('out_msgs', [])
        if not isinstance(outgoing, list):
            raise ValueError('invalid matching transaction outgoing messages')
        bounced = False
        for sent in outgoing:
            if not isinstance(sent, dict):
                raise ValueError('invalid matching transaction outgoing message')
            try:
                returns_to_source = normalize_address(sent.get('destination')) == source
            except (ValueError, TypeError, binascii.Error):
                returns_to_source = False
            # The destination is the plain main wallet: an inbound collection
            # cannot authorize it to send funds back. Treat any such return as
            # a rejection even when v2 omits the explicit bounced flag.
            if returns_to_source:
                bounced = True
        if bounced:
            continue
        value = message.get('value')
        identity = transaction.get('transaction_id')
        if not isinstance(value, str) or not re.fullmatch(r'[0-9]+', value) or not isinstance(identity, dict):
            raise ValueError('invalid matching transaction receipt')
        value = int(value)
        if not 0 < value <= balance_nano or (amount_nano is not None and value != amount_nano):
            continue
        lt, tx_hash = identity.get('lt'), identity.get('hash')
        if not isinstance(lt, str) or not re.fullmatch(r'[1-9][0-9]*', lt) or not isinstance(tx_hash, str):
            raise ValueError('invalid matching transaction identity')
        if not re.fullmatch(r'[A-Za-z0-9+/]{43}=', tx_hash) or len(base64.b64decode(tx_hash, validate=True)) != 32:
            raise ValueError('invalid matching transaction hash')
        if not transaction_succeeded(transaction.get('data'), destination, lt):
            continue
        # A non-bounceable deposit into a wallet without code retains the
        # credit despite NO_STATE/aborted. Every active-wallet execution must
        # instead be non-aborted; contradictory API metadata is rejected.
        if explicit_abort and transaction_succeeded(transaction.get('data'), destination, lt, allow_uninit=False):
            continue
        matches.append((lt, tx_hash, value))
    if len(matches) > 1:
        raise ValueError('multiple matching collection receipts; manual review required')
    return matches[0] if matches else None


def endpoint_for_network(config, network):
    state = config.get('validator', {}).get('zero_state', {})
    if not isinstance(state, dict) or any(type(state.get(key)) is not int or state[key] != value for key, value in (
            ('workchain', -1), ('shard', -9223372036854775808), ('seqno', 0))):
        raise ValueError('invalid active global.config.json zero-state identity')
    identities = {
        ('F6OpKZKqvqeFp6CQmFomXNMfMj2EnaUSOXN+Mh+wVWk=', 'XplPz01CXAps5qeSWUtxcyBfdAo5zVb1N979KLSKD24='): 'mainnet',
        ('gj+B8wb/AmlPk1z1AhVI484rhrUpgSr2oSFIh56VoSg=', 'Z+IKwYS54DmmJmesw/nAD5DzWadnOCMzee+kdgSYDOg='): 'testnet',
    }
    if identities.get((state.get('root_hash'), state.get('file_hash'))) != network:
        raise ValueError('collection network differs from the pod active global.config.json')
    return 'https://toncenter.com' if network == 'mainnet' else 'https://testnet.toncenter.com'


def save_journal(path, state):
    descriptor, temporary = tempfile.mkstemp(prefix='.collect-', dir=path.parent)
    try:
        with os.fdopen(descriptor, 'w') as stream:
            json.dump(state, stream, separators=(',', ':'), sort_keys=True)
            stream.flush()
            os.fsync(stream.fileno())
        os.replace(temporary, path)
        directory = os.open(path.parent, os.O_RDONLY | os.O_DIRECTORY)
        try:
            os.fsync(directory)
        finally:
            os.close(directory)
    finally:
        if os.path.exists(temporary):
            os.unlink(temporary)


def checkpoint_collection_journal():
    # Old deployments retain the journal on disk. With memory-backed
    # controller state, acknowledge its encrypted persistence before signing.
    if not os.path.ismount('/var/ton-work/controller'):
        return
    for directory in (CHECKPOINT_REQUEST_ROOT, CHECKPOINT_ACK_ROOT):
        if directory.is_symlink() or not directory.is_dir():
            raise ValueError('encrypted collection checkpoint agent is unavailable; no transfer was submitted')
    identifier = uuid.uuid4().hex
    request = CHECKPOINT_REQUEST_ROOT / identifier
    acknowledgement = CHECKPOINT_ACK_ROOT / identifier
    descriptor = os.open(request, os.O_CREAT | os.O_EXCL | os.O_WRONLY | os.O_NOFOLLOW, 0o600)
    os.close(descriptor)
    deadline = time.monotonic() + 60
    try:
        while time.monotonic() < deadline:
            if acknowledgement.exists():
                descriptor = os.open(acknowledgement, os.O_RDONLY | os.O_NOFOLLOW)
                with os.fdopen(descriptor, 'r') as response:
                    result = response.read(32).strip()
                if result != 'ok':
                    raise ValueError('encrypted collection checkpoint failed; no transfer was submitted')
                return
            time.sleep(min(0.5, max(0, deadline - time.monotonic())))
        raise ValueError('encrypted collection checkpoint timed out; no transfer was submitted')
    finally:
        request.unlink(missing_ok=True)
        acknowledgement.unlink(missing_ok=True)


def same_plan(left, right):
    keys = ('wallet', 'source', 'destination', 'network', 'amount_nano')
    return isinstance(left, dict) and all(left.get(key) == right.get(key) for key in keys)


def load_pending(path, plan):
    if path.is_symlink():
        raise ValueError('collection journal must not be a symbolic link')
    if not path.exists():
        return None
    state = json.loads(path.read_text())
    if not isinstance(state, dict) or type(state.get('version')) is not int or state['version'] != 1 or state.get('status') not in ('pending', 'complete'):
        raise ValueError('invalid collection journal; refusing to submit another transfer')
    if not isinstance(state.get('marker'), str) or not re.fullmatch(r'kubeton-collect:[0-9a-f]{32}', state['marker']):
        raise ValueError('invalid collection journal identifier')
    if type(state.get('balance_nano')) is not int or not 0 < state['balance_nano'] < 2**120:
        raise ValueError('invalid collection journal balance')
    saved_plan = state.get('plan')
    if not isinstance(saved_plan, dict) or not isinstance(saved_plan.get('wallet'), str) or not re.fullmatch(r'[A-Za-z0-9._-]+', saved_plan['wallet']):
        raise ValueError('invalid collection journal plan')
    if saved_plan.get('network') not in ('mainnet', 'testnet') or any(normalize_address(saved_plan.get(key)) != saved_plan.get(key) for key in ('source', 'destination')):
        raise ValueError('invalid collection journal identity')
    if saved_plan['source'] != plan['source'] or saved_plan['network'] != plan['network']:
        raise ValueError('collection journal belongs to a different source account or network')
    saved_amount = saved_plan.get('amount_nano')
    if saved_amount is not None and (type(saved_amount) is not int or not 0 < saved_amount <= state['balance_nano']):
        raise ValueError('invalid collection journal amount')
    if state['status'] == 'complete':
        receipt = state.get('receipt')
        if not isinstance(receipt, dict) or not isinstance(receipt.get('lt'), str) or not re.fullmatch(r'[1-9][0-9]*', receipt['lt']):
            raise ValueError('invalid completed collection receipt identity')
        tx_hash, value = receipt.get('hash'), receipt.get('value')
        if not isinstance(tx_hash, str) or not re.fullmatch(r'[A-Za-z0-9+/]{43}=', tx_hash) or len(base64.b64decode(tx_hash, validate=True)) != 32:
            raise ValueError('invalid completed collection receipt hash')
        if not isinstance(value, str) or not re.fullmatch(r'[0-9]+', value) or not 0 < int(value) <= state['balance_nano'] or (saved_amount is not None and int(value) != saved_amount):
            raise ValueError('invalid completed collection receipt amount')
        return None
    if not same_plan(saved_plan, plan):
        raise ValueError('another collection is pending for this source; resolve its recorded destination and amount first')
    return state


def duration_seconds(value):
    match = re.fullmatch(r'([0-9]+(?:\.[0-9]+)?)([smh]?)', value)
    if not match:
        raise ValueError('invalid collection timeout')
    seconds = float(match[1]) * {'': 1, 's': 1, 'm': 60, 'h': 3600}[match[2]]
    if not 0 < seconds <= 3600:
        raise ValueError('invalid collection timeout')
    return seconds


def run_mytonctrl(command, environment, timeout):
    # MyTonCtrl spawns lite-client and Fift. Kill the complete process group
    # on timeout, and capture to a file so inherited stdout pipes cannot keep
    # this driver waiting after the console process exits.
    with tempfile.TemporaryFile() as output:
        process = subprocess.Popen(command, stdout=output, stderr=subprocess.STDOUT,
                                   env=environment, start_new_session=True)
        try:
            returncode = process.wait(timeout=timeout)
        except subprocess.TimeoutExpired:
            try:
                os.killpg(process.pid, signal.SIGKILL)
            except ProcessLookupError:
                pass
            process.wait(timeout=5)
            returncode = 124
        output.seek(0)
        return returncode, output.read().decode('utf-8', 'replace')


class Collector:
    def __init__(self, endpoint, plan, balance, journal_path, command_timeout, confirm_timeout, expectation=None):
        self.endpoint, self.plan, self.balance = endpoint, plan, balance
        self.journal_path = journal_path
        self.command_timeout, self.confirm_timeout = command_timeout, confirm_timeout
        self.expectation = expectation
        self.last_request = None

    def request_history(self, deadline):
        query = urllib.parse.urlencode({'address': self.plan['destination'], 'limit': 100, 'archival': 'true'})
        request = urllib.request.Request(self.endpoint + '/api/v2/getTransactions?' + query,
                                        headers={'Accept': 'application/json', 'User-Agent': 'kubeton/wallet-collect'})
        last_failure = None

        def timed_out():
            detail = ': ' + str(last_failure) if last_failure is not None else ''
            return TimeoutError('collection confirmation deadline reached' + detail)

        for attempt in range(3):
            if self.last_request is not None:
                delay = max(0, 1.05 - (time.monotonic() - self.last_request))
                if time.monotonic() + delay >= deadline:
                    raise timed_out()
                time.sleep(delay)
            remaining = deadline - time.monotonic()
            if remaining <= 0:
                raise timed_out()
            self.last_request = time.monotonic()
            try:
                with urllib.request.urlopen(request, timeout=min(10, remaining)) as response:
                    data = response.read(4_194_305)
                if len(data) > 4_194_304:
                    raise ValueError('oversized collection history response')
                return json.loads(data)
            except urllib.error.HTTPError as error:
                last_failure = error
                if attempt == 2 or (error.code != 429 and not 500 <= error.code < 600):
                    raise
                delay = error.headers.get('Retry-After', '1') if error.headers else '1'
                delay = int(delay) if re.fullmatch(r'[0-9]{1,3}', delay) else 1
                if time.monotonic() + delay >= deadline:
                    raise timed_out() from error
                time.sleep(delay)
            except (urllib.error.URLError, TimeoutError) as error:
                last_failure = error
                if attempt == 2:
                    raise
        raise ValueError('collection history query failed')

    def verify(self, state):
        deadline = time.monotonic() + self.confirm_timeout
        error = 'the identified transfer has not appeared in destination history'
        while time.monotonic() < deadline:
            try:
                receipt = parse_receipt(self.request_history(deadline), self.plan['source'], self.plan['destination'],
                                        self.plan['amount_nano'], state['balance_nano'], state['marker'])
                if receipt:
                    return receipt
                error = 'the identified transfer has not appeared in destination history'
            except (OSError, ValueError, TypeError, TimeoutError) as failure:
                error = str(failure)
            remaining = deadline - time.monotonic()
            if remaining > 0:
                time.sleep(min(2, remaining))
        raise ValueError('collection is unconfirmed: ' + error)

    def collect(self):
        state = load_pending(self.journal_path, self.plan)
        if self.expectation is not None:
            expectation = re.fullmatch(r'(resume|fresh):(none|kubeton-collect:[0-9a-f]{32})', self.expectation)
            if not expectation or (expectation[1] == 'resume' and expectation[2] == 'none'):
                raise ValueError('invalid collection preflight expectation')
            current = json.loads(self.journal_path.read_text()) if self.journal_path.exists() else None
            observed = current['marker'] if current is not None else 'none'
            if observed != expectation[2]:
                raise ValueError('collection journal changed after preflight; no additional transfer was submitted')
            if expectation[1] == 'resume':
                if current is None or not same_plan(current.get('plan'), self.plan):
                    raise ValueError('the collection being resumed no longer matches this request')
                if current['status'] == 'complete':
                    print('[wallet] The previously pending collection is already confirmed; no additional transfer was signed.')
                    receipt = current['receipt']
                    print('[wallet] Collection confirmed on chain: {} TON received; transaction {}.'.format(
                        '{}.{:09d}'.format(int(receipt['value']) // 1_000_000_000, int(receipt['value']) % 1_000_000_000), receipt['lt']))
                    return 0
            elif state is not None:
                raise ValueError('another collection became pending after preflight; no additional transfer was submitted')
        if state is not None:
            print('[wallet] Checking the previous collection; no additional transfer will be signed.', flush=True)
        if state is None:
            if self.balance <= 0 or (self.plan['amount_nano'] is not None and not 0 < self.plan['amount_nano'] <= self.balance):
                raise ValueError('source balance is insufficient for the requested collection')
            state = {'version': 1, 'status': 'pending', 'plan': self.plan, 'balance_nano': self.balance,
                     'marker': 'kubeton-collect:' + secrets.token_hex(16), 'created_at': int(time.time()), 'diagnostics': ''}
            save_journal(self.journal_path, state)
            checkpoint_collection_journal()
            command = 'mg {} {} {} -C {}'.format(self.plan['wallet'], self.plan['destination_input'],
                                                 self.plan['amount_input'], state['marker'])
            environment = os.environ.copy()
            environment['FIFTPATH'] = str(ACTIVE_ROOT / 'fift') + ':' + str(ACTIVE_ROOT / 'smartcont') + ':' + environment.get('FIFTPATH', '')
            try:
                state['command_rc'], state['diagnostics'] = run_mytonctrl(['mytonctrl', '--cmd', command], environment,
                                                                         self.command_timeout)
            except subprocess.TimeoutExpired as failure:
                output = failure.stdout or ''
                state['command_rc'] = 124
                state['diagnostics'] = output.decode('utf-8', 'replace') if isinstance(output, bytes) else output
            except OSError as failure:
                state['command_rc'], state['diagnostics'] = 127, str(failure)
            save_journal(self.journal_path, state)
        try:
            receipt = self.verify(state)
        except (OSError, ValueError, TypeError) as failure:
            print('Error: ' + str(failure) + '. The pending collection was retained; retry the same command to verify it without sending again.', file=sys.stderr)
            print('Collection journal: ' + str(self.journal_path), file=sys.stderr)
            diagnostics = state.get('diagnostics')
            if isinstance(diagnostics, str) and diagnostics:
                print('mytonctrl output:\n' + diagnostics, file=sys.stderr)
            return 1
        state['status'] = 'complete'
        state['receipt'] = {'lt': receipt[0], 'hash': receipt[1], 'value': str(receipt[2])}
        save_journal(self.journal_path, state)
        print('[wallet] Collection confirmed on chain: {} TON received; transaction {}.'.format(
            '{}.{:09d}'.format(receipt[2] // 1_000_000_000, receipt[2] % 1_000_000_000), receipt[0]))
        return 0


def main(argv=None):
    resource.setrlimit(resource.RLIMIT_CORE, (0, 0))
    args = sys.argv[1:] if argv is None else argv
    expectation = None
    if len(args) >= 2 and args[0] == '--expect':
        expectation, args = args[1], args[2:]
    inspect = bool(args and args[0] == '--inspect')
    if inspect:
        if JOURNAL_ROOT.is_symlink():
            raise ValueError('collection journal directory must not be a symbolic link')
        args = args[1:]
    if len(args) != 8:
        raise ValueError('invalid collection driver arguments')
    wallet, expected_source, destination_input, amount_input, network, balance, command_timeout, confirm_timeout = args
    if not re.fullmatch(r'[A-Za-z0-9._-]+', wallet) or wallet in ('.', '..'):
        raise ValueError('invalid source wallet name')
    source, destination = normalize_address(expected_source), normalize_address(destination_input)
    if source == destination:
        raise ValueError('source and destination collection accounts must differ')
    address_file = (WALLET_ROOT / (wallet + '.addr')).read_bytes()
    if len(address_file) in (32, 36):
        actual = str(int.from_bytes(address_file[32:], 'big', signed=True) if len(address_file) == 36 else 0) + ':' + address_file[:32].hex()
    else:
        actual = normalize_address(address_file.decode('ascii').strip())
    if actual != source:
        raise ValueError('source wallet address changed; no collection was submitted')
    endpoint = endpoint_for_network(json.loads(CONFIG_PATH.read_text()), network)
    if not re.fullmatch(r'-?[0-9]+:[0-9A-Fa-f]{64}', destination_input):
        friendly_data = base64.b64decode(destination_input.replace('-', '+').replace('_', '/'), validate=True)
        if bool(friendly_data[0] & 0x80) != (network == 'testnet'):
            raise ValueError('destination friendly address belongs to another network')
    amount_nano = None if amount_input == 'alld' else nano_amount(amount_input)
    source_key = hashlib.sha256((network + ':' + source).encode()).hexdigest()
    journal_path = JOURNAL_ROOT / (source_key + '.json')
    plan = {'wallet': wallet, 'source': source, 'destination': destination, 'network': network,
            'amount_nano': amount_nano, 'amount_input': amount_input, 'destination_input': destination_input}
    if inspect:
        pending = load_pending(journal_path, plan)
        if pending is None:
            if journal_path.exists():
                completed = json.loads(journal_path.read_text())
                if completed.get('status') == 'complete' and same_plan(completed.get('plan'), plan):
                    receipt = completed.get('receipt')
                    if not isinstance(receipt, dict) or not all(key in receipt for key in ('lt', 'hash', 'value')):
                        raise ValueError('invalid completed collection receipt')
                    print(json.dumps({'pending': False, 'plan': completed['plan'], 'marker': completed['marker'], 'observed_marker': completed['marker'],
                                      'receipt': receipt}, separators=(',', ':')))
                    return 2
            observed = json.loads(journal_path.read_text())['marker'] if journal_path.exists() else None
            print(json.dumps({'pending': False, 'observed_marker': observed}, separators=(',', ':')))
            return 3
        print(json.dumps({'pending': True, 'plan': pending['plan'], 'marker': pending['marker'],
                          'observed_marker': pending['marker']}, separators=(',', ':')))
        return 0
    balance_nano = nano_amount(balance)
    command_timeout, confirm_timeout = duration_seconds(command_timeout), duration_seconds(confirm_timeout)
    if not shutil.which('mytonctrl'):
        raise ValueError('mytonctrl command not found')
    if not (ACTIVE_ROOT / 'fift/Fift.fif').is_file() or not (ACTIVE_ROOT / 'smartcont/wallet.fif').is_file():
        print('Error: the active TON snapshot is missing Fift.fif or wallet.fif; collection cannot build a transfer BOC.', file=sys.stderr)
        return 90
    if JOURNAL_ROOT.is_symlink():
        raise ValueError('collection journal directory must not be a symbolic link')
    JOURNAL_ROOT.mkdir(mode=0o700, parents=True, exist_ok=True)
    os.chmod(JOURNAL_ROOT, 0o700)
    lock_descriptor = os.open(JOURNAL_ROOT / (source_key + '.lock'), os.O_CREAT | os.O_RDWR | os.O_NOFOLLOW, 0o600)
    with os.fdopen(lock_descriptor, 'a') as lock:
        os.fchmod(lock.fileno(), 0o600)
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError as error:
            raise ValueError('another collection is already running for this source wallet') from error
        return Collector(endpoint, plan, balance_nano, journal_path, command_timeout, confirm_timeout, expectation).collect()


if __name__ == '__main__':
    try:
        sys.exit(main())
    except (OSError, ValueError, TypeError, KeyError) as error:
        sys.exit('Error: ' + str(error))
PY
}

read_tonnode_collect_operation_from_pod() {
  local ns="$1" pod="$2" wallet_name="$3" source="$4" destination="$5" amount="$6" network="$7" balance="$8"
  local script
  script="$(tonnode_wallet_collect_script)"
  # The inspector reads existing public journal state; it never submits mg.
  run_with_timeout "$MYTONCTRL_EXEC_TIMEOUT" kubectl -n "$ns" exec "$pod" -c ton-node -- \
    python3 -c "$script" --inspect "$wallet_name" "$source" "$destination" "$amount" "$network" "$balance" 1 1
}

collect_tonnode_wallet_in_pod() {
  local ns="$1" pod="$2" wallet_name="$3" destination_address="$4" amount="$5"
  local source_address="${6:-}" balance="${7:-}" network="${8:-${KUBETON_WALLET_NETWORK:-}}"
  local output script budgets command_timeout outer_timeout row name status version workchain observed_source
  local exec_rc=0 expectation="${9:-}"
  local -a expectation_args=()
  [[ -z "$expectation" ]] || expectation_args=(--expect "$expectation")
  if [[ -z "$source_address" || -z "$balance" ]]; then
    row="$(resolve_tonnode_wallet_row_from_pod "$ns" "$pod" "$wallet_name")" || return 1
    IFS=$'\t' read -r name status balance version workchain observed_source <<<"$row"
    [[ "$name" == "$wallet_name" ]] || return 1
    source_address="${source_address:-$observed_source}"
  fi
  source_address="$(ton_address_to_hex "$source_address")" || return 1
  budgets="$(python3 -c '
import math, re, sys
match=re.fullmatch(r"([0-9]+(?:\.[0-9]+)?)([smhd]?)", sys.argv[1])
if not match: raise SystemExit("Error: invalid MYTONCTRL_EXEC_TIMEOUT for collection")
command=float(match[1])*{"":1,"s":1,"m":60,"h":3600,"d":86400}[match[2]]
try: confirmation=float(sys.argv[2])
except ValueError: raise SystemExit("Error: invalid WALLET_COLLECT_CONFIRM_TIMEOUT_SECONDS")
if not all(math.isfinite(value) and value>0 for value in (command,confirmation)):
    raise SystemExit("Error: collection timeouts must be positive and finite")
print(str(command)+"\t"+str(math.ceil(command+confirmation+90)))
' "$MYTONCTRL_EXEC_TIMEOUT" "$WALLET_COLLECT_CONFIRM_TIMEOUT_SECONDS")" || return 1
  IFS=$'\t' read -r command_timeout outer_timeout <<<"$budgets"
  script="$(tonnode_wallet_collect_script)"
  output="$(run_with_timeout "${outer_timeout}s" kubectl -n "$ns" exec "$pod" -c ton-node -- \
    python3 -c "$script" "${expectation_args[@]}" "$wallet_name" "$source_address" "$destination_address" "$amount" "$network" "$balance" \
    "$command_timeout" "$WALLET_COLLECT_CONFIRM_TIMEOUT_SECONDS" 2>&1)" || exec_rc=$?
  output="$(strip_ansi_sequences "$output")"
  if (( exec_rc != 0 )); then
    echo "Error: collection from '${wallet_name}' in ${ns}/${pod} could not be verified (exit ${exec_rc})." >&2
    [[ -z "$output" ]] || print_prefixed_lines "  ${pod}> " "$output" >&2
    if (( exec_rc == 124 )); then
      echo "Error: collection helper timed out; the outgoing request may already have executed. Rerun the same collection to check its saved receipt before any new transfer." >&2
    fi
    if (( exec_rc == 90 )); then
      echo "Hint: ensure Fift.fif and wallet.fif are present in the active TON snapshot." >&2
    fi
    return "$exec_rc"
  fi
  [[ -z "$output" ]] || print_prefixed_lines "  ${pod}> " "$output"
}

run_wallet_collect() {
  local wallet_network="$1"
  local main_wallet_name="$2"
  shift 2 || true
  local target_pod_name=""
  local source_wallet_name="validator_wallet_001"
  local amount="alld"
  local candidate=""
  local main_wallet_address=""
  local pod_inventory=""
  local row target_ns target_pod target_node_name wallet_row
  local wallet_name status balance version workchain source_address status_lc
  local rc=0 collected_count=0 collect_rc=0 operation_state operation_output operation_key observed_marker expected_operation
  local recovering=false
  local -A operation_states=() operation_markers=()
  local -a candidate_rows=()
  local -a pod_rows=()
  local -a table_rows=()

  [[ -n "$wallet_network" && -n "$main_wallet_name" ]] || return 1

  case "$#" in
    0)
      ;;
    1)
      candidate="$(trim_whitespace "$1")"
      if [[ "$candidate" =~ ^[0-9]+([.][0-9]+)?[.]?$ || "$candidate" == "alld" ]]; then
        amount="$candidate"
      else
        target_pod_name="$candidate"
      fi
      ;;
    2)
      if resolve_tonnode_pod_row_by_name "$1" >/dev/null 2>&1; then
        target_pod_name="$(trim_whitespace "$1")"
        candidate="$(trim_whitespace "$2")"
        if [[ "$candidate" =~ ^[0-9]+([.][0-9]+)?[.]?$ || "$candidate" == "alld" ]]; then
          amount="$candidate"
        else
          source_wallet_name="$candidate"
        fi
      else
        source_wallet_name="$(trim_whitespace "$1")"
        amount="$(trim_whitespace "$2")"
      fi
      ;;
    3)
      target_pod_name="$(trim_whitespace "$1")"
      source_wallet_name="$(trim_whitespace "$2")"
      amount="$(trim_whitespace "$3")"
      ;;
    *)
      echo "Error: usage: kubeton wallet collect <main-wallet-name> [from-tonnode-name] [wallet-name] [amount]" >&2
      return 1
      ;;
  esac

  main_wallet_name="$(trim_whitespace "$main_wallet_name")"
  source_wallet_name="$(trim_whitespace "$source_wallet_name")"
  amount="$(trim_whitespace "$amount")"
  [[ -z "$amount" ]] && amount="alld"
  if ! [[ "$main_wallet_name" =~ ^[A-Za-z0-9._-]+$ ]]; then
    echo "Error: invalid main wallet name '${main_wallet_name}'." >&2
    return 1
  fi
  if ! [[ "$source_wallet_name" =~ ^[A-Za-z0-9._-]+$ ]]; then
    echo "Error: invalid source wallet name '${source_wallet_name}'." >&2
    return 1
  fi
  if [[ "$amount" != "alld" ]] && ! [[ "$amount" =~ ^[0-9]+([.][0-9]+)?[.]?$ ]]; then
    echo "Error: collect amount must be numeric TON amount or omitted for alld." >&2
    return 1
  fi

  main_wallet_address="$(resolve_main_wallet_receive_address "$wallet_network" "$main_wallet_name")" || return 1

  if [[ -n "$target_pod_name" ]]; then
    if ! row="$(resolve_tonnode_pod_row_by_name "$target_pod_name")"; then
      echo "Error: TON pod '${target_pod_name}' not found or its inventory is unavailable." >&2
      return 1
    fi
    row="$(trim_whitespace "$row")"
    if [[ -z "$row" ]]; then
      echo "Error: TON pod '${target_pod_name}' not found." >&2
      return 1
    fi
    pod_rows+=("$row")
  else
    if ! pod_inventory="$(list_ton_pods)"; then
      echo "Error: cannot list all TON pods; no collection will be started." >&2
      return 1
    fi
    if [[ -z "$(trim_whitespace "$pod_inventory")" ]]; then
      echo "Error: no TON pods found for collection." >&2
      return 1
    fi
    mapfile -t pod_rows <<<"$pod_inventory"
  fi

  for row in "${pod_rows[@]}"; do
    [[ -z "$row" ]] && continue
    IFS=$'\t' read -r target_ns target_pod target_node_name <<<"$row"
    if [[ -z "$target_ns" || -z "$target_pod" ]]; then
      echo "Error: incomplete TON pod inventory; no collection will be started." >&2
      return 1
    fi
    if ! wallet_row="$(resolve_tonnode_wallet_row_from_pod "$target_ns" "$target_pod" "$source_wallet_name")"; then
      echo "Error: cannot read live state for wallet '${source_wallet_name}' in ${target_ns}/${target_pod}; no collection will be started." >&2
      return 1
    fi
    wallet_row="$(trim_whitespace "$wallet_row")"
    if [[ -z "$wallet_row" ]]; then
      echo "Error: cannot read live state for wallet '${source_wallet_name}' in ${target_ns}/${target_pod}; no collection will be started." >&2
      return 1
    fi
    IFS=$'\t' read -r wallet_name status balance version workchain source_address <<<"$wallet_row"
    status="$(trim_whitespace "$status")"
    status_lc="${status,,}"
    source_address="$(trim_whitespace "$source_address")"
    if [[ "$wallet_name" != "$source_wallet_name" ]] || [[ "$status_lc" != active && "$status_lc" != empty && "$status_lc" != uninit && "$status_lc" != uninitialized && "$status_lc" != frozen ]]; then
      echo "Error: cannot read live state for wallet '${source_wallet_name}' in ${target_ns}/${target_pod}; no collection will be started." >&2
      return 1
    fi
    if [[ -z "$source_address" ]] || ! ton_address_to_hex "$source_address" >/dev/null 2>&1; then
      echo "Error: cannot read the address of wallet '${source_wallet_name}' in ${target_ns}/${target_pod}; no collection will be started." >&2
      return 1
    fi
    operation_key="${target_ns}/${target_pod}/${wallet_name}"
    if operation_output="$(read_tonnode_collect_operation_from_pod "$target_ns" "$target_pod" "$wallet_name" "$source_address" "$main_wallet_address" "$amount" "$wallet_network" "$balance" 2>&1)"; then
      operation_state=0
      recovering=true
    else
      operation_state=$?
    fi
    case "$operation_state" in
      0|2|3) operation_states["$operation_key"]="$operation_state" ;;
      *)
        echo "Error: cannot safely inspect the saved collection for ${target_ns}/${target_pod}; no collection will be started." >&2
        [[ -z "$operation_output" ]] || print_prefixed_lines "  ${target_pod}> " "$operation_output" >&2
        return 1
        ;;
    esac
    observed_marker="$(printf '%s' "$operation_output" | python3 -c '
import json,re,sys
value=json.load(sys.stdin)
if not isinstance(value,dict) or "observed_marker" not in value: raise SystemExit(1)
marker=value["observed_marker"]
if marker is None or marker=="none": print("none")
elif isinstance(marker,str) and re.fullmatch(r"kubeton-collect:[0-9a-f]{32}",marker): print(marker)
else: raise SystemExit(1)
')" || {
      echo "Error: invalid collection operation identity returned by ${target_ns}/${target_pod}; no collection will be started." >&2
      return 1
    }
    operation_markers["$operation_key"]="$observed_marker"
    candidate_rows+=("${target_ns}"$'\t'"${target_pod}"$'\t'"${wallet_name}"$'\t'"${status}"$'\t'"${balance}"$'\t'"${source_address}"$'\t'"${amount}")
  done

  for row in "${candidate_rows[@]}"; do
    IFS=$'\t' read -r target_ns target_pod wallet_name status balance source_address amount <<<"$row"
    operation_key="${target_ns}/${target_pod}/${wallet_name}"
    operation_state="${operation_states[$operation_key]}"
    status_lc="${status,,}"
    if [[ "$status_lc" != active && "$operation_state" != 0 ]] &&
      [[ "$recovering" != true || "$operation_state" != 2 ]]; then
      if [[ -n "$target_pod_name" ]]; then
        echo "Error: wallet '${wallet_name}' in ${target_ns}/${target_pod} is '${status:-unknown}', not active." >&2
      else
        echo "Warning: wallet '${wallet_name}' in ${target_ns}/${target_pod} is '${status}', not active; skipping." >&2
      fi
      case "$status_lc" in
        empty) echo "Hint: an empty wallet has no funds to collect." >&2 ;;
        uninit|uninitialized) echo "Hint: after funding it, run: ./kubeton wallet activate ${target_pod} ${wallet_name}" >&2 ;;
        frozen) echo "Hint: recover this frozen wallet before collecting funds." >&2 ;;
      esac
      [[ -z "$target_pod_name" ]] || return 1
      continue
    fi
    table_rows+=("$row")
  done

  if [[ ${#table_rows[@]} -eq 0 ]]; then
    echo "Error: no active TON wallets available for collection for wallet name '${source_wallet_name}'." >&2
    echo "Hint: check source status with './kubeton wallet show balance'." >&2
    return 1
  fi

  if [[ "$recovering" == true ]]; then
    echo "[wallet] Resuming unfinished collection; matching payments already confirmed will be skipped." >&2
  fi
  print_aligned_table_7col "namespace" "tonnode pod" "from-wallet" "status" "balance" "wallet-address" "amount" "${table_rows[@]}"
  confirm_or_exit "Collect '${amount}' from '${source_wallet_name}' on ${#table_rows[@]} TON wallet(s) to main wallet '${main_wallet_name}' (${main_wallet_address}) on ${wallet_network}?"

  for row in "${table_rows[@]}"; do
    IFS=$'\t' read -r target_ns target_pod source_wallet_name status balance source_address amount <<<"$row"
    operation_key="${target_ns}/${target_pod}/${source_wallet_name}"
    if [[ "$recovering" == true && "${operation_states[$operation_key]}" == 2 ]]; then
      echo "[wallet] Collection from ${target_ns}/${target_pod} was already confirmed; skipping another transfer." >&2
      ((collected_count+=1))
      continue
    fi
    expected_operation="fresh:${operation_markers[$operation_key]}"
    [[ "${operation_states[$operation_key]}" != 0 ]] || expected_operation="resume:${operation_markers[$operation_key]}"
    collect_rc=0
    echo "[wallet] Collecting ${amount} from ${source_wallet_name} in ${target_ns}/${target_pod} to ${main_wallet_address} using mytonctrl mg" >&2
    if collect_tonnode_wallet_in_pod "$target_ns" "$target_pod" "$source_wallet_name" "$main_wallet_address" "$amount" "$source_address" "$balance" "$wallet_network" "$expected_operation"; then
      ((collected_count+=1))
    else
      collect_rc=$?
      rc=1
      if (( collect_rc == 90 )); then
        echo "Error: stopping collect because mytonctrl/Fift is not usable in ${target_ns}/${target_pod}." >&2
        break
      fi
    fi
  done

  if (( rc != 0 )); then
    echo "Error: collected ${collected_count}/${#table_rows[@]} wallet(s); at least one collection could not be verified." >&2
    return 1
  fi
  echo "[wallet] Collected ${collected_count}/${#table_rows[@]} wallet(s), verified at the destination."
}

resolve_tonnode_pod_row_by_name() {
  local target_name="$1"
  local row ns pod node_name
  local exact_match=""
  local prefix_match=""
  local prefix_count=0

  target_name="$(trim_whitespace "$target_name")"
  [[ -z "$target_name" ]] && return 1

  while IFS= read -r row; do
    [[ -z "$row" ]] && continue
    IFS=$'\t' read -r ns pod node_name <<<"$row"
    [[ -z "$ns" || -z "$pod" ]] && continue
    if [[ "$pod" == "$target_name" ]]; then
      exact_match="$row"
      break
    fi
    if [[ "$pod" == "$target_name"-* ]]; then
      prefix_match="$row"
      ((prefix_count+=1))
    fi
  done < <(list_ton_pods 2>/dev/null || true)

  if [[ -n "$exact_match" ]]; then
    printf '%s' "$exact_match"
    return 0
  fi
  if (( prefix_count == 1 )) && [[ -n "$prefix_match" ]]; then
    printf '%s' "$prefix_match"
    return 0
  fi
  if (( prefix_count > 1 )); then
    echo "Error: tonnode selector '${target_name}' matches multiple TON pods. Use an exact pod name." >&2
    return 1
  fi
  return 1
}

delete_ton_pvcs_for_statefulsets() {
  local -n sts_rows_ref="$1"
  local label="${2:-cleanup}"
  local force_unresolved_local_pvcs=false
  local row ns sts cleanup_rc=0
  local -a candidate_rows=()
  local -a trusted_sts_claim_rows=()
  local -a pvc_rows=()
  local -a live_ton_pod_rows=()
  local pvc_name
  local live_row live_ns live_pod live_node

  if [[ ${#sts_rows_ref[@]} -eq 0 ]]; then
    echo "[cleanup] No StatefulSet snapshot was provided; using expected TON PVC names and label selector." >&2
  fi

  for row in "${sts_rows_ref[@]}"; do
    [[ -z "$row" ]] && continue
    IFS=$'\t' read -r ns sts _ <<<"$row"
    [[ -z "$ns" || -z "$sts" ]] && continue

    while IFS= read -r pvc_name; do
      [[ -z "$pvc_name" ]] && continue
      append_unique_item "$ns"$'\t'"$pvc_name" candidate_rows
      append_unique_item "$ns"$'\t'"$pvc_name" trusted_sts_claim_rows
    done < <(
      kubectl -n "$ns" get pvc -o jsonpath='{range .items[*]}{.metadata.name}{"\n"}{end}' 2>/dev/null \
        | grep -E "^(ton-work|ton-src|mytoncore|mytonctrl|keybundle)-${sts}-" || true
    )
  done

  collect_expected_ton_pvc_rows_from_values candidate_rows
  collect_labeled_ton_pvc_rows candidate_rows
  collect_existing_kubeton_pvc_rows candidate_rows pvc_rows "$label" trusted_sts_claim_rows

  if [[ ${#pvc_rows[@]} -eq 0 ]]; then
    cleanup_legacy_ton_pvs_for_statefulsets "$1" "$label" || return 1
    return 0
  fi

  mapfile -t live_ton_pod_rows < <(list_ton_pods 2>/dev/null || true)
  if [[ ${#live_ton_pod_rows[@]} -gt 0 && -n "${live_ton_pod_rows[0]:-}" ]]; then
    echo "Error: refusing to delete TON PVCs while TON pod(s) still exist:" >&2
    for live_row in "${live_ton_pod_rows[@]}"; do
      [[ -z "$live_row" ]] && continue
      IFS=$'\t' read -r live_ns live_pod live_node <<<"$live_row"
      [[ -z "$live_ns" || -z "$live_pod" ]] && continue
      echo "  - ${live_ns}/${live_pod} on ${live_node:-unknown}" >&2
    done
    echo "Wait for the pods to terminate, then rerun cleanup/uninstall." >&2
    return 1
  fi

  # Only the explicitly destructive TON commands may remove a PVC object
  # whose exact local-path owner cannot be proven. The generic helper still
  # requires a durable UID-bound PV ledger and an unmounted claim.
  case "$label" in
    uninstall|drop)
      force_unresolved_local_pvcs=true
      ;;
  esac
  if [[ "${KUBETON_RETAIN_PURGE_CONFIRMED:-false}" == true && "$label" == uninstall ]]; then
    delete_pvc_rows_and_backing_volumes pvc_rows "$label" "$force_unresolved_local_pvcs" "$1" || cleanup_rc=1
  else
    delete_pvc_rows_and_backing_volumes pvc_rows "$label" "$force_unresolved_local_pvcs" || cleanup_rc=1
  fi
  cleanup_legacy_ton_pvs_for_statefulsets "$1" "$label" || cleanup_rc=1
  return "$cleanup_rc"
}

ton_fleet_resources_exist() {
  local -a sts_rows=()

  if cluster_has_tonnodes; then
    return 0
  fi

  mapfile -t sts_rows < <(list_ton_statefulsets 2>/dev/null || true)
  [[ ${#sts_rows[@]} -gt 0 && -n "${sts_rows[0]:-}" ]]
}

delete_stale_ton_pvcs_without_fleet() {
  local label="${1:-cleanup}"
  local force="${2:-false}"
  local -a candidate_rows=()
  local -a existing_rows=()
  local -a empty_sts_rows=()
  local row ns pvc

  if [[ "$force" != "true" ]] && ton_fleet_resources_exist; then
    return 0
  fi

  collect_expected_ton_pvc_rows_from_values candidate_rows
  collect_labeled_ton_pvc_rows candidate_rows
  collect_existing_kubeton_pvc_rows candidate_rows existing_rows "$label"

  if [[ ${#existing_rows[@]} -eq 0 ]]; then
    if [[ "$label" == "uninstall" || "$label" == "drop" ]]; then
      cleanup_recorded_local_path_data "$label" || return 1
    fi
    return 0
  fi

  if [[ "$force" == "true" ]]; then
    echo "[${label}] Found TON PVCs during forced cleanup; deleting them so bootstrap cannot reuse partial state:"
  else
    echo "[${label}] Found stale TON PVCs with no active TON fleet; deleting them so bootstrap cannot reuse partial state:"
  fi
  for row in "${existing_rows[@]}"; do
    IFS=$'\t' read -r ns pvc <<<"$row"
    [[ -z "$ns" || -z "$pvc" ]] && continue
    echo "  - ${ns}/${pvc}"
  done

  delete_ton_pvcs_for_statefulsets empty_sts_rows "$label"

  candidate_rows=()
  existing_rows=()
  collect_expected_ton_pvc_rows_from_values candidate_rows
  collect_labeled_ton_pvc_rows candidate_rows
  collect_existing_kubeton_pvc_rows candidate_rows existing_rows "$label"

  if [[ ${#existing_rows[@]} -eq 0 ]]; then
    if [[ "$label" == "uninstall" || "$label" == "drop" ]]; then
      cleanup_recorded_local_path_data "$label" || return 1
    fi
    return 0
  fi

  echo "Error: stale TON PVCs are still present after cleanup; refusing to continue with reusable partial state:" >&2
  for row in "${existing_rows[@]}"; do
    IFS=$'\t' read -r ns pvc <<<"$row"
    [[ -z "$ns" || -z "$pvc" ]] && continue
    echo "  - ${ns}/${pvc}" >&2
  done
  echo "Delete these PVCs/PVs manually or rerun kubeton uninstall/drop before starting." >&2
  return 1
}

delete_stale_ton_pvcs_before_fresh_start() {
  delete_stale_ton_pvcs_without_fleet "start"
}

set_ton_replicas() {
  local ns="$1"
  local name="$2"
  local replicas="$3"

  kubectl -n "$ns" scale statefulset "$name" --replicas="$replicas" >/dev/null
}

wait_pvc_bound() {
  local ns="$1"
  local pvc="$2"
  local timeout_seconds="${3:-300}"
  local deadline=$(( $(date +%s) + timeout_seconds ))
  local phase=""
  local deleting=""

  while (( $(date +%s) < deadline )); do
    phase="$(kubectl -n "$ns" get pvc "$pvc" -o jsonpath='{.status.phase}' 2>/dev/null || true)"
    deleting="$(kubectl -n "$ns" get pvc "$pvc" -o jsonpath='{.metadata.deletionTimestamp}' 2>/dev/null || true)"
    if [[ "$phase" == "Bound" && -z "$deleting" ]]; then
      return 0
    fi
    sleep 2
  done

  echo "Error: timeout waiting for PVC ${ns}/${pvc} to become Bound (last phase='${phase:-not-found}', deleting='${deleting:-no}')." >&2
  return 1
}

pvc_uses_wait_for_first_consumer() {
  local ns="$1"
  local pvc="$2"
  local storage_class=""
  local mode=""

  storage_class="$(kubectl -n "$ns" get pvc "$pvc" -o jsonpath='{.spec.storageClassName}' 2>/dev/null || true)"
  storage_class="$(trim_whitespace "$storage_class")"
  if [[ -z "$storage_class" ]]; then
    return 1
  fi

  mode="$(kubectl get storageclass "$storage_class" -o jsonpath='{.volumeBindingMode}' 2>/dev/null || true)"
  mode="$(trim_whitespace "$mode")"
  [[ "$mode" == "WaitForFirstConsumer" ]]
}

wait_pvc_gone() {
  local ns="$1"
  local pvc="$2"
  local timeout_seconds="${3:-600}"
  local deadline=$(( $(date +%s) + timeout_seconds ))
  local marker

  while (( $(date +%s) < deadline )); do
    if ! marker="$(kubectl -n "$ns" get pvc "$pvc" --ignore-not-found -o jsonpath='{.metadata.uid}' 2>/dev/null)"; then
      echo "Error: could not check whether PVC ${ns}/${pvc} was deleted." >&2
      return 2
    fi
    marker="$(trim_whitespace "$marker")"
    if [[ -z "$marker" ]]; then
      return 0
    fi
    sleep 2
  done

  echo "Error: timeout waiting for PVC ${ns}/${pvc} to be deleted." >&2
  return 1
}

wait_pv_gone() {
  local pv="$1"
  local timeout_seconds="${2:-300}"
  local deadline=$(( $(date +%s) + timeout_seconds ))
  local marker

  while (( $(date +%s) < deadline )); do
    if ! marker="$(kubectl get pv "$pv" --ignore-not-found -o jsonpath='{.metadata.uid}' 2>/dev/null)"; then
      echo "Error: could not check whether PV ${pv} was deleted." >&2
      return 2
    fi
    marker="$(trim_whitespace "$marker")"
    if [[ -z "$marker" ]]; then
      return 0
    fi
    sleep 2
  done

  echo "Warning: timeout waiting for PV ${pv} to be deleted." >&2
  return 1
}

wait_longhorn_volume_gone() {
  local volume="$1"
  local timeout_seconds="${2:-300}"
  local deadline=$(( $(date +%s) + timeout_seconds ))

  local namespace_marker marker
  if ! namespace_marker="$(kubectl get namespace "$LONGHORN_NAMESPACE" --ignore-not-found -o jsonpath='{.metadata.uid}' 2>/dev/null)"; then
    echo "Error: could not check Longhorn namespace ${LONGHORN_NAMESPACE}." >&2
    return 2
  fi
  namespace_marker="$(trim_whitespace "$namespace_marker")"
  if [[ -z "$namespace_marker" ]]; then
    return 0
  fi

  while (( $(date +%s) < deadline )); do
    if ! marker="$(kubectl -n "$LONGHORN_NAMESPACE" get volumes.longhorn.io "$volume" --ignore-not-found -o jsonpath='{.metadata.uid}' 2>/dev/null)"; then
      echo "Error: could not check whether Longhorn volume ${volume} was deleted." >&2
      return 2
    fi
    marker="$(trim_whitespace "$marker")"
    if [[ -z "$marker" ]]; then
      return 0
    fi
    sleep 2
  done

  echo "Warning: timeout waiting for Longhorn volume ${volume} to be deleted." >&2
  return 1
}

wait_volume_attachments_gone() {
  local pv="$1"
  local timeout_seconds="${2:-180}"
  local deadline=$(( $(date +%s) + timeout_seconds ))
  local count attachment_rows

  while (( $(date +%s) < deadline )); do
    if ! attachment_rows="$(kubectl get volumeattachments.storage.k8s.io \
      -o jsonpath='{range .items[?(@.spec.source.persistentVolumeName=="'"${pv}"'")]}{.metadata.name}{"\n"}{end}' 2>/dev/null)"; then
      echo "Error: could not check VolumeAttachment objects for PV ${pv}." >&2
      return 2
    fi
    count="$(printf '%s\n' "$attachment_rows" | awk 'NF{c++} END{print c+0}')"
    if [[ "${count:-0}" == "0" ]]; then
      return 0
    fi
    sleep 2
  done

  echo "Warning: timeout waiting for VolumeAttachment objects for PV ${pv} to be deleted." >&2
  return 1
}

# A PV must not be deleted while Kubernetes still reports an attachment.  The
# second check is intentionally authoritative: attachment API/RBAC failures
# and timeouts fail closed rather than being treated as "detached".
ensure_volume_attachments_gone_for_pv() {
  local pv="$1"
  local initial_timeout_seconds="${2:-180}"
  local recovery_timeout_seconds="${3:-60}"
  local wait_rc=0

  if wait_volume_attachments_gone "$pv" "$initial_timeout_seconds"; then
    return 0
  else
    wait_rc=$?
  fi
  if (( wait_rc == 2 )); then
    echo "Error: could not verify VolumeAttachment objects for PV ${pv}." >&2
    return 1
  fi

  echo "Warning: VolumeAttachment objects for PV ${pv} did not disappear normally; retrying forced attachment cleanup." >&2
  delete_volume_attachments_for_pv "$pv"
  if wait_volume_attachments_gone "$pv" "$recovery_timeout_seconds"; then
    return 0
  fi
  echo "Error: VolumeAttachment objects for PV ${pv} remain or cannot be verified; refusing PV deletion." >&2
  return 1
}

delete_pvc_and_wait_for_gone() {
  local ns="$1"
  local pvc="$2"
  local initial_timeout_seconds="${3:-120}"
  local recovery_timeout_seconds="${4:-60}"
  local wait_rc=0

  kubectl -n "$ns" delete pvc "$pvc" --ignore-not-found --wait=false >/dev/null 2>&1 || true
  if wait_pvc_gone "$ns" "$pvc" "$initial_timeout_seconds"; then
    return 0
  else
    wait_rc=$?
  fi
  if (( wait_rc == 2 )); then
    return 1
  fi

  if ! verify_no_pod_references_for_pvc "$ns" "$pvc"; then
    echo "Error: PVC ${ns}/${pvc} is still referenced by a pod; refusing to clear its finalizers." >&2
    return 1
  fi
  echo "Warning: PVC ${ns}/${pvc} did not delete normally; clearing finalizers for destructive cleanup." >&2
  kubectl -n "$ns" patch pvc "$pvc" --type=merge -p '{"metadata":{"finalizers":[]}}' >/dev/null 2>&1 || true
  kubectl -n "$ns" delete pvc "$pvc" --ignore-not-found --wait=false >/dev/null 2>&1 || true
  if wait_pvc_gone "$ns" "$pvc" "$recovery_timeout_seconds"; then
    return 0
  else
    wait_rc=$?
  fi
  if (( wait_rc == 2 )); then
    return 1
  fi

  echo "Error: PVC ${ns}/${pvc} still exists after destructive finalizer recovery." >&2
  return 1
}

# Used only by the explicit TON drop/uninstall path after a UID-bound PV/PVC
# ledger entry was stored, but the node-local host path could not be proven.
# Do not call this as a generic replacement for storage inventory: removing a
# PVC can cause a Delete-policy provisioner to reclaim its data.  The caller
# intentionally retains the unresolved PV in the durable ledger and reports a
# non-zero result for manual reconciliation.
force_delete_unmounted_pvc_after_unresolved_local_inventory() {
  local ns="$1"
  local pvc="$2"
  local expected_pvc_uid="$3"
  local timeout_seconds="${4:-60}"
  local pvc_uid pvc_deletion_timestamp pvc_identity wait_rc=0

  if ! [[ "$expected_pvc_uid" =~ ^[a-z0-9]([a-z0-9-]*[a-z0-9])?$ ]]; then
    echo "Error: refusing destructive finalizer recovery for PVC ${ns}/${pvc} without its recorded UID." >&2
    return 1
  fi

  if ! pvc_uid="$(kubectl -n "$ns" get pvc "$pvc" --ignore-not-found -o jsonpath='{.metadata.uid}' 2>/dev/null)"; then
    echo "Error: could not recheck PVC ${ns}/${pvc} before destructive finalizer recovery." >&2
    return 1
  fi
  pvc_uid="$(trim_whitespace "$pvc_uid")"
  [[ -n "$pvc_uid" ]] || return 0
  if [[ "$pvc_uid" != "$expected_pvc_uid" ]]; then
    echo "Error: refusing destructive finalizer recovery for PVC ${ns}/${pvc}: its UID changed after storage inventory." >&2
    return 1
  fi

  # Always request normal deletion first. A non-terminating PVC can still
  # acquire a pod reference; finalizers are only an escape hatch once the
  # expected claim is already terminating and proven unmounted.
  if ! kubectl -n "$ns" delete pvc "$pvc" --ignore-not-found --wait=false >/dev/null 2>&1; then
    echo "Error: could not request deletion of PVC ${ns}/${pvc} before finalizer recovery." >&2
    return 1
  fi
  if wait_pvc_gone "$ns" "$pvc" 5; then
    return 0
  else
    wait_rc=$?
  fi
  if (( wait_rc == 2 )); then
    echo "Error: could not verify PVC ${ns}/${pvc} after requesting deletion." >&2
    return 1
  fi

  if ! pvc_identity="$(kubectl -n "$ns" get pvc "$pvc" --ignore-not-found -o jsonpath='{.metadata.uid}{"\t"}{.metadata.deletionTimestamp}' 2>/dev/null)"; then
    echo "Error: could not recheck PVC ${ns}/${pvc} before finalizer recovery." >&2
    return 1
  fi
  IFS=$'\t' read -r pvc_uid pvc_deletion_timestamp <<<"$pvc_identity"
  pvc_uid="$(trim_whitespace "$pvc_uid")"
  pvc_deletion_timestamp="$(trim_whitespace "$pvc_deletion_timestamp")"
  [[ -n "$pvc_uid" ]] || return 0
  if [[ "$pvc_uid" != "$expected_pvc_uid" ]]; then
    echo "Error: refusing destructive finalizer recovery for PVC ${ns}/${pvc}: its UID changed after deletion was requested." >&2
    return 1
  fi
  if [[ -z "$pvc_deletion_timestamp" ]]; then
    echo "Error: PVC ${ns}/${pvc} did not enter termination after its delete request; refusing to clear finalizers." >&2
    return 1
  fi

  if ! verify_no_pod_references_for_pvc "$ns" "$pvc"; then
    echo "Error: PVC ${ns}/${pvc} is still referenced by a pod; refusing to clear its finalizers after unresolved local-path inventory." >&2
    return 1
  fi

  # Re-read immediately before the destructive patch. This avoids acting on a
  # same-name PVC that was recreated while pod references were inspected.
  if ! pvc_identity="$(kubectl -n "$ns" get pvc "$pvc" --ignore-not-found -o jsonpath='{.metadata.uid}{"\t"}{.metadata.deletionTimestamp}' 2>/dev/null)"; then
    echo "Error: could not recheck PVC ${ns}/${pvc} immediately before destructive finalizer recovery." >&2
    return 1
  fi
  IFS=$'\t' read -r pvc_uid pvc_deletion_timestamp <<<"$pvc_identity"
  pvc_uid="$(trim_whitespace "$pvc_uid")"
  pvc_deletion_timestamp="$(trim_whitespace "$pvc_deletion_timestamp")"
  [[ -n "$pvc_uid" ]] || return 0
  if [[ "$pvc_uid" != "$expected_pvc_uid" || -z "$pvc_deletion_timestamp" ]]; then
    echo "Error: refusing destructive finalizer recovery for PVC ${ns}/${pvc}: its UID changed immediately before cleanup." >&2
    return 1
  fi

  echo "Warning: clearing finalizers and force-deleting unmounted PVC ${ns}/${pvc}; its local backing path could not be proven and its storage record remains in the cleanup ledger for manual reconciliation." >&2
  # The JSON Patch `test` makes the final mutation conditional on the exact
  # UID captured in the ledger, closing the remaining same-name replacement
  # race between the recheck and patch.
  if ! kubectl -n "$ns" patch pvc "$pvc" --type=json \
    -p "[{\"op\":\"test\",\"path\":\"/metadata/uid\",\"value\":\"${expected_pvc_uid}\"},{\"op\":\"add\",\"path\":\"/metadata/finalizers\",\"value\":[]}]" >/dev/null 2>&1; then
    # A concurrent controller may have completed deletion after the recheck.
    # Verify that outcome instead of treating every patch failure as success.
    if wait_pvc_gone "$ns" "$pvc" 5; then
      return 0
    fi
    echo "Error: could not clear finalizers on PVC ${ns}/${pvc}." >&2
    return 1
  fi
  if wait_pvc_gone "$ns" "$pvc" "$timeout_seconds"; then
    return 0
  fi

  echo "Error: PVC ${ns}/${pvc} still exists after guarded destructive finalizer recovery." >&2
  return 1
}

delete_pv_and_wait_for_gone() {
  local pv="$1"
  local initial_timeout_seconds="${2:-180}"
  local recovery_timeout_seconds="${3:-60}"
  local allow_finalizer_recovery="${4:-true}"
  local wait_rc=0

  kubectl delete pv "$pv" --ignore-not-found --wait=false >/dev/null 2>&1 || true
  if wait_pv_gone "$pv" "$initial_timeout_seconds"; then
    return 0
  else
    wait_rc=$?
  fi
  if (( wait_rc == 2 )); then
    return 1
  fi
  if ! is_true "$allow_finalizer_recovery"; then
    echo "Error: PV ${pv} did not delete normally; refusing to clear finalizers for a non-local CSI volume." >&2
    return 1
  fi

  echo "Warning: PV ${pv} did not delete normally; clearing finalizers for destructive cleanup." >&2
  kubectl patch "pv/${pv}" --type=merge -p '{"metadata":{"finalizers":[]}}' >/dev/null 2>&1 || true
  kubectl delete pv "$pv" --ignore-not-found --wait=false >/dev/null 2>&1 || true
  if wait_pv_gone "$pv" "$recovery_timeout_seconds"; then
    return 0
  else
    wait_rc=$?
  fi
  if (( wait_rc == 2 )); then
    return 1
  fi

  echo "Error: PV ${pv} still exists after destructive finalizer recovery." >&2
  return 1
}

reset_add_target_pvc_if_exists() {
  local ns="$1"
  local pvc="$2"
  local pv=""

  if ! kubectl -n "$ns" get pvc "$pvc" >/dev/null 2>&1; then
    return 0
  fi

  pv="$(kubectl -n "$ns" get pvc "$pvc" -o jsonpath='{.spec.volumeName}' 2>/dev/null || true)"
  echo "Found leftover PVC ${ns}/${pvc}; deleting it for fresh replica bootstrap ..."
  kubectl -n "$ns" delete pvc "$pvc" --ignore-not-found --wait=false >/dev/null 2>&1 || true
  wait_pvc_gone "$ns" "$pvc" 300 || return 1

  if [[ -n "$pv" ]]; then
    kubectl delete pv "$pv" --ignore-not-found --wait=false >/dev/null 2>&1 || true
    kubectl -n "$LONGHORN_NAMESPACE" delete volumes.longhorn.io "$pv" --ignore-not-found --wait=false >/dev/null 2>&1 || true
  fi
}

wait_pod_ready() {
  local ns="$1"
  local pod="$2"
  local timeout_seconds="${3:-900}"
  local deadline=$(( $(date +%s) + timeout_seconds ))

  while (( $(date +%s) < deadline )); do
    if kubectl -n "$ns" wait --for=condition=Ready "pod/${pod}" --timeout=10s >/dev/null 2>&1; then
      return 0
    fi
    sleep 2
  done

  echo "Error: timeout waiting for pod ${ns}/${pod} to become Ready." >&2
  return 1
}

ton_pod_initial_bootstrap_state() {
  local ns="$1"
  local pod="$2"
  local pod_row node phase scheduled_status scheduled_reason scheduled_message
  local restart_count waiting_reason last_exit event_row event_reason event_message process_state
  local status_error_file status_error pod_rc=0 bootstrap_probe bootstrap_probe_rc=0

  if ! status_error_file="$(umask 077; mktemp "${TMPDIR:-/tmp}/kubeton-pod-status.XXXXXX")"; then
    printf 'status-read-error\x1f-\x1f0\x1f\x1f\x1fcannot create a temporary file for kubectl error capture'
    return 0
  fi
  pod_row="$(run_with_timeout "$STATUS_EXEC_TIMEOUT" kubectl -n "$ns" get pod "$pod" --ignore-not-found \
    -o go-template='{{.spec.nodeName}}{{"\x1f"}}{{.status.phase}}{{"\x1f"}}{{range .status.conditions}}{{if eq .type "PodScheduled"}}{{.status}}{{"\x1f"}}{{.reason}}{{"\x1f"}}{{.message}}{{end}}{{end}}{{"\x1f"}}{{range .status.containerStatuses}}{{if eq .name "ton-node"}}{{.restartCount}}{{"\x1f"}}{{if .state.waiting}}{{.state.waiting.reason}}{{end}}{{"\x1f"}}{{if .lastState.terminated}}{{.lastState.terminated.exitCode}}{{end}}{{end}}{{end}}' 2>"$status_error_file")" || pod_rc=$?
  if (( pod_rc != 0 )); then
    status_error="$(captured_command_error_reason "$pod_rc" "$STATUS_EXEC_TIMEOUT" "$status_error_file")"
    rm -f "$status_error_file" >/dev/null 2>&1 || true
    printf 'status-read-error\x1f-\x1f0\x1f\x1f\x1fkubectl get Pod failed (exit=%s): %s' "$pod_rc" "$status_error"
    return 0
  fi
  rm -f "$status_error_file" >/dev/null 2>&1 || true
  pod_row="$(printf '%s' "$pod_row" | tr '\t\r\n' '   ')"
  if [[ -z "$(trim_whitespace "$pod_row")" ]]; then
    printf 'waiting-for-pod\x1f-\x1f0\x1f\x1f\x1fPod has not been created'
    return 0
  fi
  IFS=$'\x1f' read -r node phase scheduled_status scheduled_reason scheduled_message restart_count waiting_reason last_exit <<<"$pod_row"
  node="$(trim_whitespace "$node")"
  phase="$(trim_whitespace "$phase")"
  scheduled_status="$(trim_whitespace "$scheduled_status")"
  scheduled_reason="$(trim_whitespace "$scheduled_reason")"
  scheduled_message="$(trim_whitespace "$scheduled_message")"
  restart_count="$(trim_whitespace "$restart_count")"
  waiting_reason="$(trim_whitespace "$waiting_reason")"
  last_exit="$(trim_whitespace "$last_exit")"
  [[ -z "$node" ]] && node="-"
  [[ "$restart_count" =~ ^[0-9]+$ ]] || restart_count=0

  if [[ "$scheduled_status" == "False" || -z "$node" || "$node" == "-" ]]; then
    event_row="$(run_with_timeout "$STATUS_EXEC_TIMEOUT" kubectl -n "$ns" get events \
      --field-selector "involvedObject.kind=Pod,involvedObject.name=${pod},type=Warning" \
      --sort-by=.lastTimestamp \
      -o custom-columns='REASON:.reason,MESSAGE:.message' --no-headers 2>/dev/null | tail -n 1 || true)"
    event_reason="${event_row%%[[:space:]]*}"
    event_message="${event_row#"$event_reason"}"
    event_reason="$(trim_whitespace "$event_reason")"
    event_message="$(trim_whitespace "$event_message")"
    [[ -z "$event_reason" ]] && event_reason="${scheduled_reason:-Pending}"
    [[ -z "$event_message" ]] && event_message="${scheduled_message:-Pod is not scheduled}"
    printf '%s\x1f%s\x1f%s\x1f%s\x1f%s\x1f%s' "$event_reason" "$node" "$restart_count" "$waiting_reason" "$last_exit" "$event_message"
    return 0
  fi

  if [[ -n "$waiting_reason" ]]; then
    printf '%s\x1f%s\x1f%s\x1f%s\x1f%s\x1fcontainer is waiting' "$waiting_reason" "$node" "$restart_count" "$waiting_reason" "$last_exit"
    return 0
  fi
  if [[ "$phase" != "Running" ]]; then
    event_row="$(run_with_timeout "$STATUS_EXEC_TIMEOUT" kubectl -n "$ns" get events \
      --field-selector "involvedObject.kind=Pod,involvedObject.name=${pod},type=Warning" \
      --sort-by=.lastTimestamp \
      -o custom-columns='REASON:.reason,MESSAGE:.message' --no-headers 2>/dev/null | tail -n 1 || true)"
    event_reason="${event_row%%[[:space:]]*}"
    event_message="${event_row#"$event_reason"}"
    event_reason="$(trim_whitespace "$event_reason")"
    event_message="$(trim_whitespace "$event_message")"
    if [[ -n "$event_reason" ]]; then
      printf '%s\x1f%s\x1f%s\x1f%s\x1f%s\x1f%s' "$event_reason" "$node" "$restart_count" "$waiting_reason" "$last_exit" "$event_message"
    else
      printf '%s\x1f%s\x1f%s\x1f%s\x1f%s\x1fPod phase is %s' "${phase:-Pending}" "$node" "$restart_count" "$waiting_reason" "$last_exit" "${phase:-unknown}"
    fi
    return 0
  fi

  if ! status_error_file="$(umask 077; mktemp "${TMPDIR:-/tmp}/kubeton-bootstrap-probe.XXXXXX")"; then
    printf 'status-read-error\x1f%s\x1f%s\x1f%s\x1f%s\x1fcannot create a temporary file for bootstrap-probe error capture' \
      "$node" "$restart_count" "$waiting_reason" "$last_exit"
    return 0
  fi
  # The remote shell returns success for both expected states. A non-zero
  # local kubectl result therefore means transport, timeout, auth, or exec
  # failure rather than an ordinary not-yet-committed bootstrap.
  bootstrap_probe="$(run_with_timeout "$STATUS_EXEC_TIMEOUT" kubectl -n "$ns" exec "$pod" -c ton-node -- sh -ec '
      if test -s /var/ton-work/controller/initialized.json \
        && test -s /var/ton-work/db/config.json \
        && test -s /var/ton-work/controller/mytoncore/mytoncore.db \
        && test -s /var/ton-work/controller/services/validator.service \
        && test -s /var/ton-work/controller/services/mytoncore.service; then
        printf complete
      else
        printf pending
      fi
    ' 2>"$status_error_file")" || bootstrap_probe_rc=$?
  if (( bootstrap_probe_rc != 0 )); then
    status_error="$(captured_command_error_reason \
      "$bootstrap_probe_rc" "$STATUS_EXEC_TIMEOUT" "$status_error_file")"
    rm -f "$status_error_file" >/dev/null 2>&1 || true
    printf 'status-read-error\x1f%s\x1f%s\x1f%s\x1f%s\x1fkubectl exec bootstrap probe failed (exit=%s): %s' \
      "$node" "$restart_count" "$waiting_reason" "$last_exit" "$bootstrap_probe_rc" "$status_error"
    return 0
  fi
  rm -f "$status_error_file" >/dev/null 2>&1 || true
  bootstrap_probe="$(trim_whitespace "$bootstrap_probe")"
  if [[ "$bootstrap_probe" == "complete" ]]; then
    printf 'complete\x1f%s\x1f%s\x1f%s\x1f%s\x1fMyTonCtrl bootstrap commit state is present' "$node" "$restart_count" "$waiting_reason" "$last_exit"
    return 0
  fi
  if [[ "$bootstrap_probe" != "pending" ]]; then
    printf 'status-read-error\x1f%s\x1f%s\x1f%s\x1f%s\x1fkubectl exec bootstrap probe returned an unexpected response' \
      "$node" "$restart_count" "$waiting_reason" "$last_exit"
    return 0
  fi

  process_state="$(run_with_timeout "$STATUS_EXEC_TIMEOUT" kubectl -n "$ns" exec "$pod" -c ton-node -- sh -ec '
      args="$(ps -eo args 2>/dev/null || true)"
      if printf "%s\n" "$args" | grep -q "[a]ria2c"; then
        echo downloading
      elif printf "%s\n" "$args" | grep -Eq "[p]lzip|[t]ar -xf .*var/ton-work/db"; then
        echo extracting
      else
        echo bootstrapping
      fi
    ' 2>/dev/null || true)"
  process_state="$(trim_whitespace "$process_state")"
  case "$process_state" in
    downloading|extracting|bootstrapping) ;;
    *) process_state="bootstrapping" ;;
  esac
  printf '%s\x1f%s\x1f%s\x1f%s\x1f%s\x1finitialized.json is not committed yet' "$process_state" "$node" "$restart_count" "$waiting_reason" "$last_exit"
}

wait_ton_initial_bootstrap_complete() {
  local ns="$1"
  local tonnode_name="$2"
  local desired_replicas="$3"
  local timeout_seconds="${4:-$KUBETON_START_READY_TIMEOUT_SECONDS}"
  local status_interval fatal_restart_count status_read_error_limit deadline now started_at ordinal pod row
  local state node restarts waiting_reason last_exit detail state_key complete_count fatal_count
  local status_read_errors_for_pod
  local -A last_state=()
  local -A last_printed_at=()
  local -A consecutive_status_read_errors=()

  if ! [[ "$desired_replicas" =~ ^[1-9][0-9]*$ ]]; then
    echo "Error: invalid desired TON replica count '${desired_replicas}' for bootstrap wait." >&2
    return 1
  fi
  timeout_seconds="$(trim_whitespace "$timeout_seconds")"
  status_interval="$(trim_whitespace "${KUBETON_START_STATUS_INTERVAL_SECONDS:-60}")"
  fatal_restart_count="$(trim_whitespace "${KUBETON_START_FATAL_RESTART_COUNT:-5}")"
  status_read_error_limit="$(trim_whitespace "${KUBETON_START_STATUS_READ_ERROR_LIMIT:-3}")"
  if ! [[ "$timeout_seconds" =~ ^[1-9][0-9]*$ ]]; then
    echo "Error: invalid KUBETON_START_READY_TIMEOUT_SECONDS '${timeout_seconds}'." >&2
    return 1
  fi
  [[ "$status_interval" =~ ^[1-9][0-9]*$ ]] || status_interval=60
  [[ "$fatal_restart_count" =~ ^[0-9]+$ ]] || fatal_restart_count=5
  [[ "$status_read_error_limit" =~ ^[0-9]+$ ]] || status_read_error_limit=3
  started_at="$(date +%s)"
  deadline=$((started_at + timeout_seconds))
  echo "[start] Waiting for ${desired_replicas} TON replica(s) to commit initial MyTonCtrl bootstrap (timeout ${timeout_seconds}s) ..."

  while :; do
    now="$(date +%s)"
    complete_count=0
    fatal_count=0
    for ordinal in $(seq 0 $((desired_replicas - 1))); do
      pod="${tonnode_name}-${ordinal}"
      row="$(ton_pod_initial_bootstrap_state "$ns" "$pod")"
      IFS=$'\x1f' read -r state node restarts waiting_reason last_exit detail <<<"$row"
      state="$(trim_whitespace "$state")"
      node="$(trim_whitespace "$node")"
      restarts="$(trim_whitespace "$restarts")"
      waiting_reason="$(trim_whitespace "$waiting_reason")"
      last_exit="$(trim_whitespace "$last_exit")"
      detail="$(trim_whitespace "$detail")"
      [[ "$restarts" =~ ^[0-9]+$ ]] || restarts=0
      state_key="${state}|${node}|${restarts}|${waiting_reason}|${last_exit}|${detail}"

      if [[ "${last_state[$pod]:-}" != "$state_key" ]] \
        || (( now - ${last_printed_at[$pod]:-0} >= status_interval )); then
        printf '[start] %-24s node=%-16s state=%-22s restarts=%s' "${ns}/${pod}" "${node:--}" "${state:-unknown}" "$restarts"
        [[ -n "$last_exit" ]] && printf ' lastExit=%s' "$last_exit"
        [[ -n "$detail" ]] && printf ' - %s' "$detail"
        printf '\n'
        last_state["$pod"]="$state_key"
        last_printed_at["$pod"]="$now"
      fi

      if [[ "$state" == "complete" ]]; then
        consecutive_status_read_errors["$pod"]=0
        complete_count=$((complete_count + 1))
      elif [[ "$state" == "status-read-error" ]]; then
        status_read_errors_for_pod=$(( ${consecutive_status_read_errors["$pod"]:-0} + 1 ))
        consecutive_status_read_errors["$pod"]="$status_read_errors_for_pod"
        if (( status_read_error_limit > 0 \
          && status_read_errors_for_pod >= status_read_error_limit )); then
          echo "Error: cannot read Pod ${ns}/${pod} after ${status_read_errors_for_pod} consecutive attempts; latest failure: ${detail:-unknown kubectl error}." >&2
          echo "Error: aborting the bootstrap wait because Kubernetes API progress cannot be observed; the Pods and PVCs were left intact." >&2
          return 1
        fi
      elif [[ "$state" == "CrashLoopBackOff" ]] \
        && (( fatal_restart_count > 0 && restarts >= fatal_restart_count )) \
        && [[ -n "$last_exit" && "$last_exit" != "0" ]]; then
        consecutive_status_read_errors["$pod"]=0
        fatal_count=$((fatal_count + 1))
      else
        consecutive_status_read_errors["$pod"]=0
      fi
    done

    if (( complete_count == desired_replicas )); then
      echo "[start] All ${desired_replicas} TON replica(s) committed initial MyTonCtrl bootstrap in $((now - started_at))s."
      return 0
    fi
    if (( fatal_count > 0 )); then
      echo "Error: ${fatal_count} TON replica(s) repeatedly failed with a deterministic non-zero exit; initial bootstrap did not complete." >&2
      echo "Error: inspect the launch evidence bundle printed by kubeton; the pods were left intact for diagnosis." >&2
      return 1
    fi
    if (( now >= deadline )); then
      echo "Error: timed out after ${timeout_seconds}s waiting for all TON replicas to commit initial bootstrap (${complete_count}/${desired_replicas} complete)." >&2
      echo "Error: pods and PVCs were left intact; inspect the launch evidence bundle printed by kubeton." >&2
      return 1
    fi
    sleep 5
  done
}

wait_pod_volume_stage_complete() {
  local ns="$1"
  local pod="$2"
  local timeout_seconds="${3:-$KUBETON_VOLUME_STAGE_TIMEOUT_SECONDS}"
  local deadline=$(( $(date +%s) + timeout_seconds ))
  local phase init_count container_count deleting latest_mount_warning

  while (( $(date +%s) < deadline )); do
    phase="$(kubectl -n "$ns" get pod "$pod" -o jsonpath='{.status.phase}' 2>/dev/null || true)"
    deleting="$(kubectl -n "$ns" get pod "$pod" -o jsonpath='{.metadata.deletionTimestamp}' 2>/dev/null || true)"
    init_count="$(kubectl -n "$ns" get pod "$pod" -o jsonpath='{range .status.initContainerStatuses[*]}x{"\n"}{end}' 2>/dev/null | awk 'NF{c++} END{print c+0}')"
    container_count="$(kubectl -n "$ns" get pod "$pod" -o jsonpath='{range .status.containerStatuses[*]}x{"\n"}{end}' 2>/dev/null | awk 'NF{c++} END{print c+0}')"

    if [[ -z "$deleting" ]] && [[ "$phase" == "Running" || "$phase" == "Succeeded" || "${init_count:-0}" != "0" || "${container_count:-0}" != "0" ]]; then
      return 0
    fi
    sleep 2
  done

  latest_mount_warning="$(kubectl -n "$ns" get events \
    --field-selector "involvedObject.kind=Pod,involvedObject.name=${pod},type=Warning,reason=FailedMount" \
    --sort-by=.lastTimestamp \
    -o custom-columns=MESSAGE:.message \
    --no-headers 2>/dev/null | tail -n 1 || true)"
  echo "Error: timeout waiting for pod ${ns}/${pod} to finish volume staging." >&2
  if [[ -n "$(trim_whitespace "$latest_mount_warning")" ]]; then
    echo "Latest mount warning: $(trim_whitespace "$latest_mount_warning")" >&2
  fi
  return 1
}

wait_pod_gone() {
  local ns="$1"
  local pod="$2"
  local timeout_seconds="${3:-600}"
  local deadline=$(( $(date +%s) + timeout_seconds ))

  while (( $(date +%s) < deadline )); do
    if ! kubectl -n "$ns" get pod "$pod" >/dev/null 2>&1; then
      return 0
    fi
    sleep 2
  done

  echo "Error: timeout waiting for pod ${ns}/${pod} to be deleted." >&2
  return 1
}

helper_pod_node_constraints_yaml() {
  local preferred_node="$1"
  local selector="${LONGHORN_NODE_SELECTOR:-}"
  local -a selector_pairs=()

  preferred_node="$(trim_whitespace "$preferred_node")"
  if [[ -n "$preferred_node" ]]; then
    printf '  nodeName: %s\n' "$preferred_node"
    return 0
  fi

  if ! parse_selector_pairs "$selector" selector_pairs >/dev/null 2>&1; then
    return 0
  fi
  if [[ ${#selector_pairs[@]} -eq 0 ]]; then
    return 0
  fi

  echo "  nodeSelector:"
  write_yaml_map_from_pairs selector_pairs 4
}

print_helper_pod_failure_context() {
  local ns="$1"
  local pod="$2"
  local phase node_name

  phase="$(kubectl -n "$ns" get pod "$pod" -o jsonpath='{.status.phase}' 2>/dev/null || true)"
  node_name="$(kubectl -n "$ns" get pod "$pod" -o jsonpath='{.spec.nodeName}' 2>/dev/null || true)"
  phase="$(trim_whitespace "$phase")"
  node_name="$(trim_whitespace "$node_name")"
  [[ -z "$phase" ]] && phase="unknown"
  [[ -z "$node_name" ]] && node_name="unknown"

  echo "Helper pod status: phase=${phase}, node=${node_name}" >&2
  echo "Recent warning events for ${ns}/${pod}:" >&2
  kubectl -n "$ns" get events \
    --field-selector "involvedObject.kind=Pod,involvedObject.name=${pod},type=Warning" \
    --sort-by=.lastTimestamp \
    -o custom-columns=TIME:.lastTimestamp,REASON:.reason,MESSAGE:.message \
    --no-headers 2>/dev/null | tail -n 5 >&2 || true
}

create_replica_pvc_from_ordinal0() {
  local ns="$1"
  local sts="$2"
  local claim_prefix="$3"
  local ordinal="$4"
  local source_pvc="${claim_prefix}-${sts}-0"
  local target_pvc="${claim_prefix}-${sts}-${ordinal}"
  local storage_request storage_class volume_mode access_modes_raw
  local -a access_modes=()

  if kubectl -n "$ns" get pvc "$target_pvc" >/dev/null 2>&1; then
    return 0
  fi
  if ! kubectl -n "$ns" get pvc "$source_pvc" >/dev/null 2>&1; then
    return 10
  fi

  storage_request="$(kubectl -n "$ns" get pvc "$source_pvc" -o jsonpath='{.spec.resources.requests.storage}' 2>/dev/null || true)"
  storage_class="$(kubectl -n "$ns" get pvc "$source_pvc" -o jsonpath='{.spec.storageClassName}' 2>/dev/null || true)"
  volume_mode="$(kubectl -n "$ns" get pvc "$source_pvc" -o jsonpath='{.spec.volumeMode}' 2>/dev/null || true)"
  access_modes_raw="$(kubectl -n "$ns" get pvc "$source_pvc" -o jsonpath='{.spec.accessModes[*]}' 2>/dev/null || true)"
  read -r -a access_modes <<<"$access_modes_raw"

  if [[ -z "$storage_request" ]]; then
    echo "Error: failed to derive storage request from ${ns}/${source_pvc}." >&2
    return 1
  fi
  if [[ ${#access_modes[@]} -eq 0 ]]; then
    access_modes=("ReadWriteOnce")
  fi

  {
    echo "apiVersion: v1"
    echo "kind: PersistentVolumeClaim"
    echo "metadata:"
    echo "  name: ${target_pvc}"
    echo "  namespace: ${ns}"
    echo "spec:"
    echo "  accessModes:"
    local mode
    for mode in "${access_modes[@]}"; do
      echo "  - ${mode}"
    done
    if [[ -n "$storage_class" ]]; then
      echo "  storageClassName: ${storage_class}"
    fi
    if [[ -n "$volume_mode" ]]; then
      echo "  volumeMode: ${volume_mode}"
    fi
    echo "  resources:"
    echo "    requests:"
    echo "      storage: ${storage_request}"
  } | kubectl apply -f - >/dev/null

  return 0
}

get_single_ton_statefulset() {
  local -n out_ns="$1"
  local -n out_sts="$2"
  local -n out_replicas="$3"
  local -a rows=()
  local row row_ns row_sts row_replicas inventory count=0

  inventory="$(list_ton_statefulsets)" || return 1
  mapfile -t rows <<<"$inventory"
  if [[ ${#rows[@]} -eq 0 || -z "${rows[0]}" ]]; then
    echo "Error: no TON StatefulSets found." >&2
    return 1
  fi

  for row in "${rows[@]}"; do
    [[ -z "$row" ]] && continue
    IFS=$'\t' read -r row_ns row_sts row_replicas <<<"$row"
    [[ -z "$row_ns" || -z "$row_sts" ]] && continue
    out_ns="$row_ns"
    out_sts="$row_sts"
    out_replicas="${row_replicas:-0}"
    ((count+=1))
  done

  if (( count == 1 )); then
    return 0
  fi

  echo "Error: found ${count} TON StatefulSets; add command requires exactly one." >&2
  for row in "${rows[@]}"; do
    [[ -z "$row" ]] && continue
    IFS=$'\t' read -r row_ns row_sts row_replicas <<<"$row"
    echo "  - ${row_ns}/${row_sts} replicas=${row_replicas:-0}" >&2
  done
  return 1
}

resolve_ton_pod_identity() {
  local pod_ref="$1"
  local -n out_ns="$2"
  local -n out_pod="$3"
  local -n out_sts="$4"
  local -n out_ordinal="$5"
  local resolved_ns="" resolved_pod="" resolved_sts="" resolved_ordinal=""
  local owner_sts=""
  local -a matches=()

  out_ns=""
  out_pod=""
  out_sts=""
  out_ordinal=""

  if [[ "$pod_ref" == */* ]]; then
    resolved_ns="${pod_ref%%/*}"
    resolved_pod="${pod_ref##*/}"
    if [[ -z "$resolved_ns" || -z "$resolved_pod" ]]; then
      echo "Error: invalid pod reference '${pod_ref}'. Use <pod-name> or <namespace>/<pod-name>." >&2
      return 1
    fi
    if ! kubectl -n "$resolved_ns" get pod "$resolved_pod" >/dev/null 2>&1; then
      echo "Error: pod ${resolved_ns}/${resolved_pod} not found." >&2
      return 1
    fi
    if ! kubectl -n "$resolved_ns" get pod "$resolved_pod" -l "$TON_POD_LABEL" --ignore-not-found -o name 2>/dev/null | grep -q '^pod/'; then
      echo "Error: pod ${resolved_ns}/${resolved_pod} is not a TON pod (label selector: ${TON_POD_LABEL})." >&2
      return 1
    fi
  else
    mapfile -t matches < <(kubectl get pods -A -l "$TON_POD_LABEL" --field-selector "metadata.name=${pod_ref}" \
      -o jsonpath='{range .items[*]}{.metadata.namespace}{"\t"}{.metadata.name}{"\n"}{end}')
    if [[ ${#matches[@]} -eq 0 || -z "${matches[0]}" ]]; then
      echo "Error: TON pod named '${pod_ref}' not found." >&2
      return 1
    fi
    if (( ${#matches[@]} > 1 )); then
      echo "Error: pod name '${pod_ref}' exists in multiple namespaces. Use namespace/pod format." >&2
      printf '%s\n' "${matches[@]}" | awk 'NF{print "  - "$0}' >&2
      return 1
    fi
    IFS=$'\t' read -r resolved_ns resolved_pod <<<"${matches[0]}"
  fi

  if [[ "$resolved_pod" =~ ^(.+)-([0-9]+)$ ]]; then
    resolved_ordinal="${BASH_REMATCH[2]}"
  else
    echo "Error: pod ${resolved_ns}/${resolved_pod} is not a StatefulSet ordinal pod (<name>-<ordinal>)." >&2
    return 1
  fi

  owner_sts="$(kubectl -n "$resolved_ns" get pod "$resolved_pod" -o jsonpath='{range .metadata.ownerReferences[?(@.kind=="StatefulSet")]}{.name}{end}' 2>/dev/null || true)"
  owner_sts="$(trim_whitespace "$owner_sts")"
  if [[ -z "$owner_sts" ]]; then
    echo "Error: pod ${resolved_ns}/${resolved_pod} is not owned by a StatefulSet." >&2
    return 1
  fi
  resolved_sts="$owner_sts"

  if [[ "$resolved_pod" != "${resolved_sts}-${resolved_ordinal}" ]]; then
    echo "Error: resolved StatefulSet ${resolved_sts} does not match pod name ${resolved_pod}." >&2
    return 1
  fi
  if ! kubectl -n "$resolved_ns" get statefulset "$resolved_sts" >/dev/null 2>&1; then
    echo "Error: StatefulSet ${resolved_ns}/${resolved_sts} not found." >&2
    return 1
  fi

  out_ns="$resolved_ns"
  out_pod="$resolved_pod"
  out_sts="$resolved_sts"
  out_ordinal="$resolved_ordinal"
}

get_annotation_value() {
  local resource="$1"
  local ns="$2"
  local name="$3"
  local key="$4"
  local escaped_key="$key"
  escaped_key="${escaped_key//\\/\\\\}"
  escaped_key="${escaped_key//\"/\\\"}"
  kubectl -n "$ns" get "$resource" "$name" \
    -o "go-template={{if .metadata.annotations}}{{index .metadata.annotations \"${escaped_key}\"}}{{end}}" 2>/dev/null || true
}

json_escape_string() {
  local value="${1:-}"
  value="${value//\\/\\\\}"
  value="${value//\"/\\\"}"
  value="${value//$'\n'/}"
  value="${value//$'\r'/}"
  printf '%s' "$value"
}

json_array_from_values() {
  local -n values_ref="$1"
  local out="" value escaped
  for value in "${values_ref[@]}"; do
    escaped="$(json_escape_string "$value")"
    [[ -n "$out" ]] && out+=","
    out+="\"${escaped}\""
  done
  printf '[%s]' "$out"
}

append_unique_item() {
  local item="$1"
  local -n values_ref="$2"
  local existing
  for existing in "${values_ref[@]}"; do
    if [[ "$existing" == "$item" ]]; then
      return 0
    fi
  done
  values_ref+=("$item")
}

max_positive_replicas() {
  local result=""
  local candidate

  for candidate in "$@"; do
    candidate="$(trim_whitespace "${candidate:-}")"
    if ! [[ "$candidate" =~ ^[1-9][0-9]*$ ]]; then
      continue
    fi
    if [[ -z "$result" ]] || (( candidate > result )); then
      result="$candidate"
    fi
  done

  printf '%s' "$result"
}

build_sts_ordinal_node_map() {
  local ns="$1"
  local sts="$2"
  local replicas="$3"
  local -a pairs=()
  local ordinal pod node_name

  if ! [[ "$replicas" =~ ^[1-9][0-9]*$ ]]; then
    return 0
  fi

  for ordinal in $(seq 0 $((replicas - 1))); do
    pod="${sts}-${ordinal}"
    node_name="$(kubectl -n "$ns" get pod "$pod" -o jsonpath='{.spec.nodeName}' 2>/dev/null || true)"
    node_name="$(trim_whitespace "$node_name")"
    if [[ -z "$node_name" ]]; then
      return 0
    fi
    pairs+=("${ordinal}=${node_name}")
  done

  if [[ ${#pairs[@]} -ne "$replicas" ]]; then
    return 0
  fi

  local IFS=,
  printf '%s' "${pairs[*]}"
}

parse_ordinal_node_map() {
  local mapping="$1"
  local -n out_nodes_ref="$2"
  local -A ordinal_to_node=()
  local -a pairs=()
  local pair ordinal node_name max_ordinal=-1 i

  out_nodes_ref=()
  mapping="$(trim_whitespace "$mapping")"
  [[ -z "$mapping" ]] && return 1

  IFS=',' read -r -a pairs <<<"$mapping"
  for pair in "${pairs[@]}"; do
    pair="$(trim_whitespace "$pair")"
    [[ -z "$pair" ]] && continue
    if [[ "$pair" != *=* ]]; then
      return 1
    fi
    ordinal="$(trim_whitespace "${pair%%=*}")"
    node_name="$(trim_whitespace "${pair#*=}")"
    if ! [[ "$ordinal" =~ ^[0-9]+$ ]]; then
      return 1
    fi
    if [[ -z "$node_name" ]]; then
      return 1
    fi
    ordinal_to_node["$ordinal"]="$node_name"
    if (( ordinal > max_ordinal )); then
      max_ordinal="$ordinal"
    fi
  done

  if (( max_ordinal < 0 )); then
    return 1
  fi

  for i in $(seq 0 "$max_ordinal"); do
    if [[ -z "${ordinal_to_node[$i]:-}" ]]; then
      return 1
    fi
    out_nodes_ref+=("${ordinal_to_node[$i]}")
  done
  return 0
}

set_statefulset_update_strategy() {
  local ns="$1"
  local sts="$2"
  local strategy_type="$3"
  local escaped_strategy
  escaped_strategy="$(json_escape_string "$strategy_type")"

  kubectl -n "$ns" patch statefulset "$sts" --type=merge \
    -p "{\"spec\":{\"updateStrategy\":{\"type\":\"${escaped_strategy}\"}}}" >/dev/null
}

patch_statefulset_hostname_affinity() {
  local ns="$1"
  local sts="$2"
  shift 2
  local -a hostnames=("$@")
  local hostnames_json

  if [[ ${#hostnames[@]} -eq 0 ]]; then
    kubectl -n "$ns" patch statefulset "$sts" --type=merge \
      -p '{"spec":{"template":{"spec":{"affinity":{"nodeAffinity":null}}}}}' >/dev/null
    return 0
  fi

  hostnames_json="$(json_array_from_values hostnames)"
  kubectl -n "$ns" patch statefulset "$sts" --type=merge \
    -p "{\"spec\":{\"template\":{\"spec\":{\"affinity\":{\"nodeAffinity\":{\"requiredDuringSchedulingIgnoredDuringExecution\":{\"nodeSelectorTerms\":[{\"matchExpressions\":[{\"key\":\"kubernetes.io/hostname\",\"operator\":\"In\",\"values\":${hostnames_json}}]}]}}}}}}}" >/dev/null
}

node_hostname_value() {
  local node="$1"
  local hostname

  node="$(trim_whitespace "$node")"
  [[ -n "$node" ]] || return 1
  hostname="$(kubectl get node "$node" -o go-template='{{ index .metadata.labels "kubernetes.io/hostname" }}' 2>/dev/null || true)"
  hostname="$(trim_whitespace "$hostname")"
  [[ -n "$hostname" ]] || hostname="$node"
  printf '%s' "$hostname"
}

statefulset_template_hostname_affinity_values() {
  local ns="$1"
  local sts="$2"

  kubectl -n "$ns" get statefulset "$sts" \
    -o jsonpath='{range .spec.template.spec.affinity.nodeAffinity.requiredDuringSchedulingIgnoredDuringExecution.nodeSelectorTerms[*].matchExpressions[?(@.key=="kubernetes.io/hostname")].values[*]}{.}{"\n"}{end}' 2>/dev/null \
    | awk 'NF' \
    | sort -u
}

statefulset_node_selector_string() {
  local ns="$1"
  local sts="$2"
  local selector=""
  local pair

  while IFS= read -r pair; do
    pair="$(trim_whitespace "$pair")"
    [[ -z "$pair" ]] && continue
    if [[ -n "$selector" ]]; then
      selector+=","
    fi
    selector+="$pair"
  done < <(
    kubectl -n "$ns" get statefulset "$sts" \
      -o go-template='{{range $k,$v := .spec.template.spec.nodeSelector}}{{printf "%s=%s\n" $k $v}}{{end}}' 2>/dev/null || true
  )

  printf '%s' "$selector"
}

list_schedulable_nodes_for_statefulset() {
  local ns="$1"
  local sts="$2"
  local selector

  selector="$(statefulset_node_selector_string "$ns" "$sts")"
  selector="$(trim_whitespace "$selector")"
  if [[ -n "$selector" ]]; then
    list_schedulable_nodes_by_selector "$selector"
    return 0
  fi

  kubectl get nodes -o jsonpath='{range .items[*]}{.metadata.name}{"\t"}{.spec.unschedulable}{"\n"}{end}' 2>/dev/null \
    | awk -F'\t' '$2!="true"{print $1}' \
    | awk 'NF' \
    | sort -u
}

node_matches_statefulset_selector() {
  local node="$1"
  local ns="$2"
  local sts="$3"
  local selector

  node="$(trim_whitespace "$node")"
  [[ -n "$node" ]] || return 1
  selector="$(statefulset_node_selector_string "$ns" "$sts")"
  selector="$(trim_whitespace "$selector")"
  if [[ -z "$selector" ]]; then
    return 0
  fi
  kubectl get node "$node" -l "$selector" >/dev/null 2>&1
}

collect_pv_hostname_affinity_nodes() {
  local pv="$1"
  local -n nodes_ref="$2"
  local node resolved_node

  pv="$(trim_whitespace "$pv")"
  [[ -n "$pv" ]] || return 0
  while IFS= read -r node; do
    node="$(trim_whitespace "$node")"
    [[ -z "$node" ]] && continue
    resolved_node="$(resolve_node_name_for_hostname_value "$node" || true)"
    resolved_node="$(trim_whitespace "$resolved_node")"
    [[ -z "$resolved_node" ]] && continue
    append_unique_item "$resolved_node" nodes_ref
  done < <(
    kubectl get pv "$pv" \
      -o jsonpath='{range .spec.nodeAffinity.required.nodeSelectorTerms[*].matchExpressions[?(@.key=="kubernetes.io/hostname")].values[*]}{.}{"\n"}{end}' 2>/dev/null || true
  )
}

diagnose_pending_ton_local_pvc_conflicts() {
  local ns="$1"
  local sts="$2"
  local -n pending_ordinals_ref="$3"
  local -A running_pods_by_node=()
  local -a ordinal_pv_nodes=()
  local other_ns other_pod phase node ordinal claim_prefix pvc pv pv_node selector occupied
  local failed=0

  while IFS=$'\t' read -r other_ns other_pod phase node; do
    other_ns="$(trim_whitespace "$other_ns")"
    other_pod="$(trim_whitespace "$other_pod")"
    phase="$(trim_whitespace "$phase")"
    node="$(trim_whitespace "$node")"
    [[ -n "$other_ns" && -n "$other_pod" && "$phase" == "Running" && -n "$node" ]] || continue
    running_pods_by_node["$node"]="${running_pods_by_node[$node]:-}${other_ns}/${other_pod} "
  done < <(
    kubectl get pods -A -l "$TON_POD_LABEL" \
      -o jsonpath='{range .items[*]}{.metadata.namespace}{"\t"}{.metadata.name}{"\t"}{.status.phase}{"\t"}{.spec.nodeName}{"\n"}{end}' 2>/dev/null || true
  )

  for ordinal in "${pending_ordinals_ref[@]}"; do
    ordinal="$(trim_whitespace "$ordinal")"
    [[ "$ordinal" =~ ^[0-9]+$ ]] || continue
    ordinal_pv_nodes=()

    for claim_prefix in ton-work ton-src mytoncore mytonctrl keybundle; do
      pvc="${claim_prefix}-${sts}-${ordinal}"
      pv="$(kubectl -n "$ns" get pvc "$pvc" -o jsonpath='{.spec.volumeName}' 2>/dev/null || true)"
      pv="$(trim_whitespace "$pv")"
      [[ -n "$pv" ]] || continue
      collect_pv_hostname_affinity_nodes "$pv" ordinal_pv_nodes
    done

    if (( ${#ordinal_pv_nodes[@]} > 1 )); then
      echo "Error: ${ns}/${sts}-${ordinal} has local PVCs pinned to different nodes: ${ordinal_pv_nodes[*]}." >&2
      echo "Kubernetes cannot schedule this pod until the PVCs are recreated or data is migrated to one node." >&2
      failed=1
      continue
    fi

    for pv_node in "${ordinal_pv_nodes[@]}"; do
      pv_node="$(trim_whitespace "$pv_node")"
      [[ -n "$pv_node" ]] || continue
      if ! node_matches_statefulset_selector "$pv_node" "$ns" "$sts"; then
        selector="$(statefulset_node_selector_string "$ns" "$sts")"
        echo "Error: ${ns}/${sts}-${ordinal} has a local PVC pinned to node ${pv_node}, but the StatefulSet nodeSelector '${selector:-<none>}' excludes that node." >&2
        echo "Fix by adding the required label to ${pv_node}, changing the TonNode nodeSelector, or recreating/migrating that PVC." >&2
        failed=1
      fi

      occupied="$(trim_whitespace "${running_pods_by_node[$pv_node]:-}")"
      if [[ -n "$occupied" ]]; then
        echo "Error: ${ns}/${sts}-${ordinal} has local-path PVC(s) pinned to ${pv_node}, but TON pod(s) already run there: ${occupied}." >&2
        echo "Because TON pods use hostPorts, Kubernetes cannot place another TON pod on that node." >&2
        echo "If ${ns}/${sts}-${ordinal} never started and has no data, keep keybundle-${sts}-${ordinal} and recreate only its local-path PVCs:" >&2
        echo "  kubectl -n ${ns} delete pod ${sts}-${ordinal} --ignore-not-found --wait=false" >&2
        echo "  kubectl -n ${ns} delete pvc ton-work-${sts}-${ordinal} ton-src-${sts}-${ordinal} mytoncore-${sts}-${ordinal} mytonctrl-${sts}-${ordinal} --wait=false" >&2
        failed=1
      fi
    done
  done

  (( failed == 0 ))
}

delete_unscheduled_statefulset_pods_for_start() {
  local ns="$1"
  local sts="$2"
  local pod phase node_name deletion_ts ordinal

  while IFS=$'\t' read -r pod phase node_name deletion_ts; do
    pod="$(trim_whitespace "$pod")"
    phase="$(trim_whitespace "$phase")"
    node_name="$(trim_whitespace "$node_name")"
    deletion_ts="$(trim_whitespace "$deletion_ts")"
    [[ -n "$pod" ]] || continue
    [[ "$pod" == "${sts}-"* ]] || continue
    ordinal="${pod#"${sts}-"}"
    [[ "$ordinal" =~ ^[0-9]+$ ]] || continue
    [[ "$phase" == "Pending" && -z "$node_name" && -z "$deletion_ts" ]] || continue

    echo "[start] Deleting unscheduled Pending pod ${ns}/${pod} so it can be recreated with current StatefulSet placement."
    kubectl -n "$ns" delete pod "$pod" --ignore-not-found --wait=false >/dev/null 2>&1 || true
  done < <(
    kubectl -n "$ns" get pods \
      -o jsonpath='{range .items[*]}{.metadata.name}{"\t"}{.status.phase}{"\t"}{.spec.nodeName}{"\t"}{.metadata.deletionTimestamp}{"\n"}{end}' 2>/dev/null || true
  )
}

repair_pending_ton_placement_after_start() {
  local -a sts_rows=()
  local -a operator_deploy_names=()
  local -a operator_deploy_replicas=()
  local operator_paused=0
  local row ns sts replicas pod phase node_name deletion_ts ordinal
  local pv pvc claim_prefix pv_node hostname node selector
  local repaired=0
  local skipped=0
  local failed=0
  local current_count
  local sts_failed
  local -a pending_ordinals=()
  local -a current_hostnames=()
  local -a final_hostnames=()
  local -a eligible_nodes=()
  local -a pv_nodes=()
  local -a ordinal_pv_nodes=()

  mapfile -t sts_rows < <(list_ton_statefulsets 2>/dev/null || true)
  if [[ ${#sts_rows[@]} -eq 0 || -z "${sts_rows[0]:-}" ]]; then
    return 0
  fi

  for row in "${sts_rows[@]}"; do
    [[ -z "$row" ]] && continue
    IFS=$'\t' read -r ns sts replicas <<<"$row"
    ns="$(trim_whitespace "$ns")"
    sts="$(trim_whitespace "$sts")"
    replicas="$(trim_whitespace "${replicas:-0}")"
    [[ -n "$ns" && -n "$sts" ]] || continue
    if ! [[ "$replicas" =~ ^[1-9][0-9]*$ ]]; then
      continue
    fi

    pending_ordinals=()
    while IFS=$'\t' read -r pod phase node_name deletion_ts; do
      pod="$(trim_whitespace "$pod")"
      phase="$(trim_whitespace "$phase")"
      node_name="$(trim_whitespace "$node_name")"
      deletion_ts="$(trim_whitespace "$deletion_ts")"
      [[ "$pod" == "${sts}-"* ]] || continue
      ordinal="${pod#"${sts}-"}"
      [[ "$ordinal" =~ ^[0-9]+$ ]] || continue
      [[ "$phase" == "Pending" && -z "$node_name" && -z "$deletion_ts" ]] || continue
      pending_ordinals+=("$ordinal")
    done < <(
      kubectl -n "$ns" get pods \
        -o jsonpath='{range .items[*]}{.metadata.name}{"\t"}{.status.phase}{"\t"}{.spec.nodeName}{"\t"}{.metadata.deletionTimestamp}{"\n"}{end}' 2>/dev/null || true
    )

    if (( ${#pending_ordinals[@]} == 0 )); then
      continue
    fi
    if ! diagnose_pending_ton_local_pvc_conflicts "$ns" "$sts" pending_ordinals; then
      ((failed+=1))
      continue
    fi

    mapfile -t current_hostnames < <(statefulset_template_hostname_affinity_values "$ns" "$sts")
    current_count="${#current_hostnames[@]}"
    if (( current_count == 0 )); then
      ((skipped+=1))
      continue
    fi
    if (( current_count >= replicas )); then
      ((skipped+=1))
      continue
    fi

    final_hostnames=()
    sts_failed=0
    for hostname in "${current_hostnames[@]}"; do
      hostname="$(trim_whitespace "$hostname")"
      [[ -z "$hostname" ]] && continue
      append_unique_item "$hostname" final_hostnames
    done

    pv_nodes=()
    for ordinal in "${pending_ordinals[@]}"; do
      ordinal_pv_nodes=()
      for claim_prefix in ton-work ton-src mytoncore mytonctrl keybundle; do
        pvc="${claim_prefix}-${sts}-${ordinal}"
        pv="$(kubectl -n "$ns" get pvc "$pvc" -o jsonpath='{.spec.volumeName}' 2>/dev/null || true)"
        pv="$(trim_whitespace "$pv")"
        [[ -n "$pv" ]] || continue
        collect_pv_hostname_affinity_nodes "$pv" ordinal_pv_nodes
      done

      if (( ${#ordinal_pv_nodes[@]} > 1 )); then
        echo "Error: ${ns}/${sts}-${ordinal} has local PVCs pinned to different nodes: ${ordinal_pv_nodes[*]}. Kubernetes cannot schedule this pod until the PVCs are recreated or data is migrated to one node." >&2
        sts_failed=1
        continue
      fi

      for pv_node in "${ordinal_pv_nodes[@]}"; do
        pv_node="$(trim_whitespace "$pv_node")"
        [[ -n "$pv_node" ]] || continue
        if ! node_matches_statefulset_selector "$pv_node" "$ns" "$sts"; then
          selector="$(statefulset_node_selector_string "$ns" "$sts")"
          echo "Error: ${ns}/${sts}-${ordinal} has a local PVC pinned to node ${pv_node}, but the StatefulSet nodeSelector '${selector:-<none>}' excludes that node." >&2
          echo "Fix by adding the required label to ${pv_node}, changing the TonNode nodeSelector, or recreating/migrating that PVC." >&2
          sts_failed=1
          continue
        fi
        append_unique_item "$pv_node" pv_nodes
        hostname="$(node_hostname_value "$pv_node" || true)"
        hostname="$(trim_whitespace "$hostname")"
        [[ -n "$hostname" ]] && append_unique_item "$hostname" final_hostnames
      done
    done

    if (( sts_failed > 0 )); then
      ((failed+=1))
      continue
    fi

    mapfile -t eligible_nodes < <(list_schedulable_nodes_for_statefulset "$ns" "$sts")
    for node in "${eligible_nodes[@]}"; do
      node="$(trim_whitespace "$node")"
      [[ -n "$node" ]] || continue
      hostname="$(node_hostname_value "$node" || true)"
      hostname="$(trim_whitespace "$hostname")"
      [[ -n "$hostname" ]] && append_unique_item "$hostname" final_hostnames
    done

    if (( ${#final_hostnames[@]} <= current_count )); then
      echo "Warning: ${ns}/${sts} has ${#pending_ordinals[@]} unscheduled Pending pod(s), but kubeton could not expand stale node affinity." >&2
      ((skipped+=1))
      continue
    fi

    if (( operator_paused == 0 )); then
      pause_operator_reconcile operator_deploy_names operator_deploy_replicas
      operator_paused=1
    fi

    echo "[start] Expanding stale TON node affinity for ${ns}/${sts} from ${current_count} to ${#final_hostnames[@]} host(s); recreating unscheduled Pending pod(s): ${pending_ordinals[*]}."
    set_statefulset_update_strategy "$ns" "$sts" "OnDelete" || {
      ((failed+=1))
      continue
    }
    patch_statefulset_hostname_affinity "$ns" "$sts" "${final_hostnames[@]}" || {
      ((failed+=1))
      continue
    }
    kubectl -n "$ns" patch statefulset "$sts" --type=merge \
      -p "{\"metadata\":{\"annotations\":{\"${STICKY_ORDINAL_NODE_MAP_ANNOTATION_KEY}\":null}}}" >/dev/null 2>&1 || true
    delete_unscheduled_statefulset_pods_for_start "$ns" "$sts" || true
    ((repaired+=1))
  done

  if (( operator_paused == 1 )); then
    resume_operator_reconcile operator_deploy_names operator_deploy_replicas
  fi

  if (( repaired > 0 || skipped > 0 || failed > 0 )); then
    echo "Pending TON placement repair summary: repaired=${repaired}, skipped=${skipped}, failed=${failed}"
  fi
  if (( failed > 0 )); then
    return 1
  fi
  return 0
}

clear_statefulset_sticky_placement_for_start() {
  local ns="$1"
  local sts="$2"

  patch_statefulset_hostname_affinity "$ns" "$sts" >/dev/null 2>&1 || true
  kubectl -n "$ns" patch statefulset "$sts" --type=merge \
    -p "{\"metadata\":{\"annotations\":{\"${STICKY_ORDINAL_NODE_MAP_ANNOTATION_KEY}\":null}}}" >/dev/null 2>&1 || true
  delete_unscheduled_statefulset_pods_for_start "$ns" "$sts" || true
}

ensure_statefulset_parallel_pod_management_for_start() {
  local ns="$1"
  local sts="$2"
  local policy replicas new_policy

  policy="$(kubectl -n "$ns" get statefulset "$sts" -o jsonpath='{.spec.podManagementPolicy}' 2>/dev/null || true)"
  policy="$(trim_whitespace "$policy")"
  if [[ -z "$policy" || "$policy" == "Parallel" ]]; then
    return 0
  fi

  replicas="$(kubectl -n "$ns" get statefulset "$sts" -o jsonpath='{.spec.replicas}' 2>/dev/null || true)"
  replicas="$(trim_whitespace "$replicas")"
  if ! [[ "$replicas" =~ ^[0-9]+$ ]]; then
    replicas=0
  fi
  if (( replicas != 0 )); then
    echo "Warning: StatefulSet ${ns}/${sts} uses podManagementPolicy=${policy}; it can be converted to Parallel only while replicas=0." >&2
    return 0
  fi
  if ! kubectl -n "$ns" get tonnodes.ton.ton.org "$sts" >/dev/null 2>&1; then
    echo "Warning: StatefulSet ${ns}/${sts} uses podManagementPolicy=${policy}, but no TonNode exists to recreate it; leaving it unchanged." >&2
    return 0
  fi

  echo "[start] Recreating stopped StatefulSet ${ns}/${sts} to enable Parallel pod management."
  kubectl -n "$ns" delete statefulset "$sts" --cascade=orphan --wait=true --timeout=120s >/dev/null || return 1
  wait_statefulset_present "$ns" "$sts" 300 || return 1

  new_policy="$(kubectl -n "$ns" get statefulset "$sts" -o jsonpath='{.spec.podManagementPolicy}' 2>/dev/null || true)"
  new_policy="$(trim_whitespace "$new_policy")"
  if [[ "$new_policy" != "Parallel" ]]; then
    echo "Warning: recreated StatefulSet ${ns}/${sts} still uses podManagementPolicy=${new_policy:-unknown}; ensure the running operator image includes Parallel StatefulSet support." >&2
  fi
}

statefulset_has_claim_template() {
  local ns="$1"
  local sts="$2"
  local claim_name="$3"

  kubectl -n "$ns" get statefulset "$sts" \
    -o jsonpath='{range .spec.volumeClaimTemplates[*]}{.metadata.name}{"\n"}{end}' 2>/dev/null \
    | grep -Fxq "$claim_name"
}

recreate_stopped_statefulsets_missing_dedicated_pvcs() {
  local -a sts_rows=()
  local row ns sts replicas
  local recreated=0
  local skipped=0

  mapfile -t sts_rows < <(list_ton_statefulsets 2>/dev/null || true)
  for row in "${sts_rows[@]}"; do
    [[ -z "$row" ]] && continue
    IFS=$'\t' read -r ns sts replicas <<<"$row"
    [[ -n "$ns" && -n "$sts" ]] || continue
    if statefulset_has_claim_template "$ns" "$sts" "ton-src" && statefulset_has_claim_template "$ns" "$sts" "mytonctrl"; then
      continue
    fi
    replicas="$(trim_whitespace "${replicas:-}")"
    if ! [[ "$replicas" =~ ^[0-9]+$ ]]; then
      echo "Warning: StatefulSet ${ns}/${sts} is missing dedicated ton-src/mytonctrl PVC templates, but kubeton cannot read replicas; leaving it unchanged." >&2
      ((skipped+=1))
      continue
    fi
    if (( replicas != 0 )); then
      echo "Warning: StatefulSet ${ns}/${sts} is missing dedicated ton-src/mytonctrl PVC templates, but replicas=${replicas}; it can only be recreated while stopped." >&2
      ((skipped+=1))
      continue
    fi

    echo "[start] Recreating stopped StatefulSet ${ns}/${sts} to add dedicated ton-src and mytonctrl PVC templates."
    kubectl -n "$ns" delete statefulset "$sts" --cascade=orphan --wait=true --timeout=120s >/dev/null || return 1
    wait_statefulset_present "$ns" "$sts" 300 || return 1
    ((recreated+=1))
  done

  if (( recreated > 0 || skipped > 0 )); then
    echo "[start] Dedicated PVC template migration summary: recreated=${recreated}, skipped=${skipped}"
  fi
}

preapply_stopped_node_mapping_for_statefulset() {
  local ns="$1"
  local sts="$2"
  local target_replicas="$3"
  local node_map escaped_node_map
  local -a expected_nodes=()
  local -a final_nodes=()

  if ! [[ "$target_replicas" =~ ^[1-9][0-9]*$ ]]; then
    return 0
  fi

  node_map="$(get_stopped_node_map_annotation "$ns" "$sts")"
  node_map="$(trim_whitespace "$node_map")"
  if [[ -z "$node_map" ]]; then
    clear_statefulset_sticky_placement_for_start "$ns" "$sts"
    return 0
  fi
  if ! parse_ordinal_node_map "$node_map" expected_nodes; then
    echo "Warning: invalid ${KUBETON_PAUSE_NODEMAP_ANNOTATION_KEY} on ${ns}/${sts}; cannot preapply stopped placement." >&2
    clear_statefulset_sticky_placement_for_start "$ns" "$sts"
    return 0
  fi
  if (( ${#expected_nodes[@]} < target_replicas )); then
    echo "Warning: ${KUBETON_PAUSE_NODEMAP_ANNOTATION_KEY} has ${#expected_nodes[@]} entries but target replicas=${target_replicas} on ${ns}/${sts}; cannot preapply stopped placement." >&2
    clear_statefulset_sticky_placement_for_start "$ns" "$sts"
    return 0
  fi

  ensure_statefulset_parallel_pod_management_for_start "$ns" "$sts" || return 1

  mapfile -t final_nodes < <(printf '%s\n' "${expected_nodes[@]:0:$target_replicas}" | awk 'NF' | sort -u)
  if (( ${#final_nodes[@]} == 0 )); then
    return 0
  fi

  echo "[start] Pre-applying stopped ordinal node map for ${ns}/${sts}: ${node_map}"
  patch_statefulset_hostname_affinity "$ns" "$sts" "${final_nodes[@]}" || return 1
  escaped_node_map="$(json_escape_string "$node_map")"
  kubectl -n "$ns" patch statefulset "$sts" --type=merge \
    -p "{\"metadata\":{\"annotations\":{\"${STICKY_ORDINAL_NODE_MAP_ANNOTATION_KEY}\":\"${escaped_node_map}\"}},\"spec\":{\"updateStrategy\":{\"type\":\"RollingUpdate\"}}}" >/dev/null || return 1
}

get_stopped_node_map_annotation() {
  local ns="$1"
  local sts="$2"
  local value=""

  if kubectl -n "$ns" get tonnodes.ton.ton.org "$sts" >/dev/null 2>&1; then
    value="$(get_annotation_value tonnodes.ton.ton.org "$ns" "$sts" "$KUBETON_PAUSE_NODEMAP_ANNOTATION_KEY")"
    value="$(trim_whitespace "$value")"
    if [[ -n "$value" ]]; then
      printf '%s' "$value"
      return 0
    fi
  fi

  value="$(get_annotation_value statefulset "$ns" "$sts" "$KUBETON_PAUSE_NODEMAP_ANNOTATION_KEY")"
  value="$(trim_whitespace "$value")"
  printf '%s' "$value"
}

clear_stopped_node_map_annotation() {
  local ns="$1"
  local sts="$2"
  if kubectl -n "$ns" get tonnodes.ton.ton.org "$sts" >/dev/null 2>&1; then
    kubectl -n "$ns" patch tonnodes.ton.ton.org "$sts" --type=merge \
      -p "{\"metadata\":{\"annotations\":{\"${KUBETON_PAUSE_NODEMAP_ANNOTATION_KEY}\":null}}}" >/dev/null 2>&1 || true
  fi
  kubectl -n "$ns" patch statefulset "$sts" --type=merge \
    -p "{\"metadata\":{\"annotations\":{\"${KUBETON_PAUSE_NODEMAP_ANNOTATION_KEY}\":null}}}" >/dev/null 2>&1 || true
}

clear_statefulset_pause_annotation() {
  local ns="$1"
  local sts="$2"
  kubectl -n "$ns" patch statefulset "$sts" --type=merge \
    -p "{\"metadata\":{\"annotations\":{\"${KUBETON_PAUSE_ANNOTATION_KEY}\":null}}}" >/dev/null 2>&1 || true
}

statefulset_matches_expected_nodes() {
  local ns="$1"
  local sts="$2"
  local -n expected_nodes_ref="$3"
  local ordinal pod current_node

  if [[ ${#expected_nodes_ref[@]} -eq 0 ]]; then
    return 1
  fi

  for ordinal in "${!expected_nodes_ref[@]}"; do
    pod="${sts}-${ordinal}"
    current_node="$(kubectl -n "$ns" get pod "$pod" -o jsonpath='{.spec.nodeName}' 2>/dev/null || true)"
    current_node="$(trim_whitespace "$current_node")"
    if [[ "$current_node" != "${expected_nodes_ref[$ordinal]}" ]]; then
      return 1
    fi
  done

  return 0
}

restore_statefulset_with_expected_nodes() {
  local ns="$1"
  local sts="$2"
  local target_replicas="$3"
  local -n expected_nodes_ref="$4"
  local -a allowed_nodes=()
  local -a final_nodes=()
  local ordinal pod expected_node current_node

  if ! [[ "$target_replicas" =~ ^[1-9][0-9]*$ ]]; then
    return 1
  fi
  if (( ${#expected_nodes_ref[@]} < target_replicas )); then
    return 1
  fi

  set_statefulset_update_strategy "$ns" "$sts" "OnDelete" || return 1
  set_ton_replicas "$ns" "$sts" 0 || return 1
  wait_statefulset_pods_gone "$ns" "$sts" || return 1

  for ordinal in $(seq 0 $((target_replicas - 1))); do
    expected_node="${expected_nodes_ref[$ordinal]}"
    append_unique_item "$expected_node" allowed_nodes
    patch_statefulset_hostname_affinity "$ns" "$sts" "${allowed_nodes[@]}" || return 1
    set_ton_replicas "$ns" "$sts" $((ordinal + 1)) || return 1
    pod="${sts}-${ordinal}"
    wait_pod_ready "$ns" "$pod" 1800 || return 1
    current_node="$(kubectl -n "$ns" get pod "$pod" -o jsonpath='{.spec.nodeName}' 2>/dev/null || true)"
    current_node="$(trim_whitespace "$current_node")"
    if [[ "$current_node" != "$expected_node" ]]; then
      echo "Error: ${ns}/${pod} expected node ${expected_node} but landed on ${current_node:-unknown}." >&2
      return 1
    fi
  done

  mapfile -t final_nodes < <(printf '%s\n' "${expected_nodes_ref[@]:0:$target_replicas}" | awk 'NF' | sort -u)
  patch_statefulset_hostname_affinity "$ns" "$sts" "${final_nodes[@]}" || true
  set_statefulset_update_strategy "$ns" "$sts" "RollingUpdate" || true
  return 0
}

enforce_stopped_node_mappings_after_start() {
  local -a sts_rows=()
  local -a operator_deploy_names=()
  local -a operator_deploy_replicas=()
  local operator_paused=0
  local row ns sts replicas node_map
  local remapped=0
  local unchanged=0
  local skipped=0
  local failed=0

  mapfile -t sts_rows < <(list_ton_statefulsets)
  if [[ ${#sts_rows[@]} -eq 0 || -z "${sts_rows[0]}" ]]; then
    return 0
  fi

  for row in "${sts_rows[@]}"; do
    [[ -z "$row" ]] && continue
    IFS=$'\t' read -r ns sts replicas <<<"$row"
    if [[ -z "$ns" || -z "$sts" ]]; then
      continue
    fi
    if ! [[ "$replicas" =~ ^[1-9][0-9]*$ ]]; then
      clear_stopped_node_map_annotation "$ns" "$sts"
      continue
    fi

    node_map="$(get_stopped_node_map_annotation "$ns" "$sts")"
    node_map="$(trim_whitespace "$node_map")"
    if [[ -z "$node_map" ]]; then
      continue
    fi

    local -a expected_nodes=()
    if ! parse_ordinal_node_map "$node_map" expected_nodes; then
      echo "Warning: invalid ${KUBETON_PAUSE_NODEMAP_ANNOTATION_KEY} on ${ns}/${sts}; skipping strict node restore." >&2
      ((skipped+=1))
      clear_stopped_node_map_annotation "$ns" "$sts"
      continue
    fi
    if (( ${#expected_nodes[@]} < replicas )); then
      echo "Warning: ${KUBETON_PAUSE_NODEMAP_ANNOTATION_KEY} has ${#expected_nodes[@]} entries but replicas=${replicas} on ${ns}/${sts}; skipping strict node restore." >&2
      ((skipped+=1))
      clear_stopped_node_map_annotation "$ns" "$sts"
      continue
    fi

    if statefulset_matches_expected_nodes "$ns" "$sts" expected_nodes; then
      ((unchanged+=1))
      clear_stopped_node_map_annotation "$ns" "$sts"
      continue
    fi

    if (( operator_paused == 0 )); then
      pause_operator_reconcile operator_deploy_names operator_deploy_replicas
      operator_paused=1
    fi

    echo "Restoring strict ordinal->node placement for ${ns}/${sts} ..."
    if restore_statefulset_with_expected_nodes "$ns" "$sts" "$replicas" expected_nodes; then
      ((remapped+=1))
      clear_stopped_node_map_annotation "$ns" "$sts"
    else
      echo "Error: failed strict node restore for ${ns}/${sts}." >&2
      ((failed+=1))
    fi
  done

  if (( operator_paused == 1 )); then
    resume_operator_reconcile operator_deploy_names operator_deploy_replicas
  fi

  if (( remapped > 0 || unchanged > 0 || skipped > 0 || failed > 0 )); then
    echo "Start node placement summary: remapped=${remapped}, already_matched=${unchanged}, skipped=${skipped}, failed=${failed}"
  fi
  return 0
}

ton_add_context_script() {
  cat <<'PY'
import json
import math
import re
import sys
from decimal import Decimal


def quantity(value):
    match = re.fullmatch(r"([0-9]+(?:\.[0-9]+)?(?:[eE][+-]?[0-9]+)?)([A-Za-z]*)", str(value or 0))
    units = {"": 1, "n": Decimal("1e-9"), "u": Decimal("1e-6"), "m": Decimal(".001")}
    units.update({suffix: 1000 ** power for power, suffix in enumerate("kMGTPE", 1)})
    units.update({suffix + "i": 1024 ** power for power, suffix in enumerate("KMGTPE", 1)})
    if not match or match[2] not in units:
        raise ValueError("unrecognized resource quantity")
    return Decimal(match[1]) * units[match[2]]


def requests(spec):
    apps = [item.get("resources", {}).get("requests", {}) for item in spec.get("containers", [])]
    initial = [item.get("resources", {}).get("requests", {}) for item in spec.get("initContainers", [])]
    return [max(sum(quantity(item.get(key, 0)) for item in apps),
                max((quantity(item.get(key, 0)) for item in initial), default=0))
            + quantity(spec.get("overhead", {}).get(key, 0)) for key in ("cpu", "memory")]


def main():
    sts, cr, pods, pvcs, pvs, classes = [json.loads(part) if part else {} for part in sys.stdin.read().split("\0")[:6]]
    key, value, minimum_cpu, minimum_memory, map_key = sys.argv[1:]
    name, namespace = sts["metadata"]["name"], sts["metadata"]["namespace"]
    uid, replicas = sts["metadata"]["uid"], sts["spec"]["replicas"]
    if type(replicas) is not int or replicas < 1:
        raise ValueError("add requires a running fleet; use kubeton start for a stopped fleet")
    if cr and (cr.get("spec", {}).get("replicas", 1) != replicas or
               cr.get("metadata", {}).get("annotations", {}).get("ton.ton.org/kubeton-paused-replicas")):
        raise ValueError("TonNode and StatefulSet replica counts are not converged; finish start/stop first")
    if cr and not any(owner.get("controller") and owner.get("kind") == "TonNode" and owner.get("uid") == cr["metadata"]["uid"]
                      for owner in sts["metadata"].get("ownerReferences", [])):
        raise ValueError("StatefulSet is not controlled by the matching TonNode")
    spec = sts["spec"]["template"]["spec"]
    selector = dict(spec.get("nodeSelector", {}))
    for label, wanted in cr.get("spec", {}).get("nodeSelector", {}).items():
        if selector.get(label) != wanted:
            raise ValueError("TonNode and StatefulSet node selectors are not converged")
    owned = {}
    for pod in pods["items"]:
        if any(owner.get("controller") and owner.get("kind") == "StatefulSet" and owner.get("uid") == uid
               for owner in pod.get("metadata", {}).get("ownerReferences", [])):
            suffix = pod["metadata"]["name"].removeprefix(name + "-")
            if not suffix.isdigit() or int(suffix) >= replicas or pod["metadata"].get("deletionTimestamp"):
                raise ValueError("fleet has terminating or unexpected pods; wait for convergence before add")
            owned[int(suffix)] = pod
    ready = lambda pod: bool(pod and pod.get("spec", {}).get("nodeName") and any(
        item.get("type") == "Ready" and item.get("status") == "True" for item in pod.get("status", {}).get("conditions", [])))
    unfinished = [ordinal for ordinal in range(replicas) if not ready(owned.get(ordinal))]
    resume = bool(unfinished)
    if resume:
        if unfinished != [replicas - 1]:
            raise ValueError("existing replicas are not Ready; add will not create another replica")
        tail = owned.get(replicas - 1, {})
        if tail.get("spec", {}).get("nodeName") or tail.get("status", {}).get("phase", "Pending") != "Pending":
            raise ValueError("tail replica is already assigned/starting; wait for it instead of adding another")
    ordinal = replicas - 1 if resume else replicas
    running = {str(index): pod["spec"]["nodeName"] for index, pod in owned.items() if ready(pod)}
    affinity = spec.get("affinity", {}).get("nodeAffinity", {})
    terms = affinity.get("requiredDuringSchedulingIgnoredDuringExecution", {}).get("nodeSelectorTerms", [])
    network = cr.get("spec", {}).get("network", {})
    automatic = bool(cr and network.get("hostPortsEnabled", True) and not network.get("publicIP") and len(terms) == 1
                     and not terms[0].get("matchFields") and len(terms[0].get("matchExpressions", [])) == 1
                     and terms[0]["matchExpressions"][0].get("key") == "kubernetes.io/hostname"
                     and terms[0]["matchExpressions"][0].get("operator") == "In")
    if automatic and not re.fullmatch(r"[0-9a-f]{64}", sts["metadata"].get("annotations", {}).get("ton.ton.org/sticky-placement-spec-hash", "")):
        raise ValueError("upgrade the operator with kubeton install before add: the running operator lacks safe placement-growth support")
    managed = {label: wanted for label, wanted in selector.items()
               if (label == key and wanted == value) or (label == "node.longhorn.io/create-default-disk" and wanted == "true")}
    cpu, memory = requests(spec)
    claims = {item["metadata"]["name"]: item for item in pvcs["items"]}
    volumes = {item["metadata"]["name"]: item for item in pvs["items"]}
    storage = {item["metadata"]["name"]: item for item in classes["items"]}
    data, require_csi, constraints = 0, False, []
    storage_requirements = []
    for template in sts["spec"].get("volumeClaimTemplates", []):
        claim = claims.get(template["metadata"]["name"] + "-" + name + "-" + str(ordinal))
        claim_spec = (claim or template)["spec"]
        if claim and (claim_spec.get("storageClassName") != template["spec"].get("storageClassName")
                      or quantity(claim_spec["resources"]["requests"]["storage"]) < quantity(template["spec"]["resources"]["requests"]["storage"])):
            raise ValueError("retained target PVC does not match the live claim template; PVCs were preserved")
        storage_name = claim_spec.get("storageClassName")
        if not storage_name or storage_name not in storage:
            raise ValueError("StorageClass " + str(storage_name or "(unresolved)") + " is missing")
        provisioner = storage.get(storage_name, {}).get("provisioner", "")
        require_csi |= provisioner == "driver.longhorn.io"
        bound = bool(claim_spec.get("volumeName"))
        capacity = 0 if bound else math.ceil(quantity(claim_spec["resources"]["requests"]["storage"]))
        storage_requirements.extend((storage_name, str(capacity)))
        if provisioner not in ("driver.longhorn.io", "pd.csi.storage.gke.io", "kubernetes.io/gce-pd"):
            data += capacity
        if claim:
            selected = claim.get("metadata", {}).get("annotations", {}).get("volume.kubernetes.io/selected-node")
            if selected:
                constraints.append({"node": selected})
        if bound:
            pv = volumes.get(claim_spec["volumeName"])
            if not pv or pv.get("spec", {}).get("claimRef", {}).get("uid") != claim["metadata"]["uid"]:
                raise ValueError("cannot verify the retained PVC's bound PV identity")
            if pv.get("spec", {}).get("nodeAffinity", {}).get("required"):
                constraints.append({"affinity": pv["spec"]["nodeAffinity"]["required"]})
    ports = sorted({item.get("protocol", "TCP") + "/" + str(item["hostPort"])
                    for container in spec.get("containers", []) + spec.get("initContainers", [])
                    for item in container.get("ports", []) if item.get("hostPort", 0) > 0})
    print(json.dumps({"namespace": namespace, "name": name, "uid": uid, "cr_uid": cr.get("metadata", {}).get("uid"), "replicas": replicas, "ordinal": ordinal,
                      "target": replicas if resume else replicas + 1, "resume": resume, "pod_uid": owned.get(ordinal, {}).get("metadata", {}).get("uid"),
                      "cpu": math.ceil(max(cpu, quantity(minimum_cpu)) * 1000), "memory": math.ceil(max(memory, quantity(minimum_memory))),
                      "data": data, "storage_requirements": storage_requirements, "ports": ports, "selector": selector, "managed": managed, "running": running,
                      "automatic": automatic, "affinity": affinity, "constraints": constraints, "longhorn": require_csi,
                      "scope": ",".join(label + "=" + wanted for label, wanted in sorted(selector.items()) if label not in managed)}))


try:
    main()
except (KeyError, TypeError, ValueError, ArithmeticError) as error:
    sys.exit("Error: cannot prepare add: " + str(error))
PY
}

ton_add_field() {
  printf '%s' "$1" | python3 -c 'import json,sys; value=json.load(sys.stdin)[sys.argv[1]]; print("\n".join(value) if isinstance(value,list) else json.dumps(value) if isinstance(value,dict) else str(value).lower() if isinstance(value,bool) else value)' "$2"
}

ton_add_context() {
  local ns="$1" sts="$2" sts_json cr_json pods_json pvcs_json pvs_json classes_json
  sts_json="$(kubectl -n "$ns" get statefulset "$sts" -o json)" || return 1
  cr_json="$(kubectl -n "$ns" get tonnodes.ton.ton.org "$sts" --ignore-not-found -o json)" || return 1
  pods_json="$(kubectl -n "$ns" get pods -o json)" || return 1
  pvcs_json="$(kubectl -n "$ns" get pvc -o json)" || return 1
  pvs_json="$(kubectl get pv -o json)" || return 1
  classes_json="$(kubectl get storageclass -o json)" || return 1
  printf '%s\0' "$sts_json" "$cr_json" "$pods_json" "$pvcs_json" "$pvs_json" "$classes_json" \
    | python3 -c "$(ton_add_context_script)" "$KUBETON_NODE_PREREQ_LABEL_KEY" "$KUBETON_NODE_PREREQ_LABEL_VALUE" \
      "$KUBETON_CHECK_MIN_CPU" "$KUBETON_CHECK_MIN_MEMORY" "$STICKY_ORDINAL_NODE_MAP_ANNOTATION_KEY"
}

ton_add_node_fits() {
  printf '%s\0%s' "$1" "$2" | python3 -c '
import json,sys
context,node=map(json.loads,sys.stdin.read().split("\0")); labels=node["metadata"].get("labels",{}); name=node["metadata"]["name"]
def term_matches(term):
    def matches(item, values):
        key,op,wanted=item["key"],item["operator"],item.get("values",[]); present=key in values; actual=values.get(key)
        if op=="In": return present and actual in wanted
        if op=="NotIn": return not present or actual not in wanted
        if op=="Exists": return present
        if op=="DoesNotExist": return not present
        if op in ("Gt","Lt"):
            try: return present and (int(actual)>int(wanted[0]) if op=="Gt" else int(actual)<int(wanted[0]))
            except (ValueError,IndexError): return False
        return False
    return bool(term.get("matchExpressions") or term.get("matchFields")) and all(matches(item,labels) for item in term.get("matchExpressions",[])) and all(matches(item,{"metadata.name":name}) for item in term.get("matchFields",[]))
def affinity_matches(affinity): return any(term_matches(term) for term in affinity.get("nodeSelectorTerms",[]))
if any(labels.get(key)!=value and not(key in context["managed"] and key not in labels) for key,value in context["selector"].items()): sys.exit(1)
required=context["affinity"].get("requiredDuringSchedulingIgnoredDuringExecution")
if required and not context["automatic"] and not affinity_matches(required): sys.exit(1)
for restriction in context["constraints"]:
    if restriction.get("node",name)!=name or ("affinity" in restriction and not affinity_matches(restriction["affinity"])): sys.exit(1)
print(labels.get("kubernetes.io/hostname",name))
'
}

ton_add_admit_node() {
  local context="$1" preferred="${2:-}" node node_json hostname scope
  scope="$(ton_add_field "$context" scope)"
  KUBETON_ADD_CPU_MILLI="$(ton_add_field "$context" cpu)"
  KUBETON_ADD_MEMORY_BYTES="$(ton_add_field "$context" memory)"
  KUBETON_ADD_DATA_BYTES="$(ton_add_field "$context" data)"
  KUBETON_ADD_STORAGE_REQUIREMENTS=()
  mapfile -t KUBETON_ADD_STORAGE_REQUIREMENTS < <(ton_add_field "$context" storage_requirements)
  mapfile -t KUBETON_ADD_HOST_PORTS < <(ton_add_field "$context" ports | awk NF)
  KUBETON_ADD_OCCUPIED_NODES=()
  while IFS= read -r node; do
    [[ -z "$node" ]] || KUBETON_ADD_OCCUPIED_NODES["$node"]=1
  done < <(printf '%s' "$context" | python3 -c 'import json,sys; print("\n".join(json.load(sys.stdin)["running"].values()))')
  run_node_prerequisite_check 1 "$scope" || return 1
  for node in "${KUBETON_NODE_CHECK_COMPATIBLE_NODES[@]}"; do
    [[ -z "$preferred" || "$node" == "$preferred" ]] || continue
    node_json="$(kubectl get node "$node" -o json)" || return 1
    if hostname="$(ton_add_node_fits "$context" "$node_json")"; then
      KUBETON_ADD_SELECTED_NODE="$node"
      KUBETON_ADD_SELECTED_HOSTNAME="$hostname"
      return 0
    fi
  done
  echo "Error: no free node meets the live selector, affinity, PVC placement, resources, and host-port requirements; no replica was added." >&2
  return 1
}

ton_add_resume_operator() {
  local -n names_ref="$1" replicas_ref="$2"
  local index failed=0
  for index in "${!names_ref[@]}"; do
    if ! kubectl -n "$OP_NAMESPACE" scale deployment "${names_ref[$index]}" --replicas="${replicas_ref[$index]}" >/dev/null; then
      echo "Error: cannot restore operator ${OP_NAMESPACE}/${names_ref[$index]} to ${replicas_ref[$index]} replica(s)." >&2
      failed=1
    fi
  done
  return "$failed"
}

run_add() (
  require_bin kubectl
  require_bin python3
  local ns="" sts="" replicas=""
  local context refreshed new_ordinal new_replicas new_pod selected_node selected_hostname
  local label nodes_json current_sts current_cr patch has_cr resume pod_json operator_pods
  local operator_paused=0
  local KUBETON_ADD_MODE=true KUBETON_ADD_CPU_MILLI KUBETON_ADD_MEMORY_BYTES KUBETON_ADD_DATA_BYTES
  local KUBETON_ADD_STS
  local KUBETON_ADD_SELECTED_NODE KUBETON_ADD_SELECTED_HOSTNAME
  local -a KUBETON_ADD_HOST_PORTS=() KUBETON_ADD_STORAGE_REQUIREMENTS=() operator_names=() operator_replicas=()
  local -A KUBETON_ADD_OCCUPIED_NODES=()
  trap 'if (( operator_paused )); then ton_add_resume_operator operator_names operator_replicas; fi' EXIT

  if [[ $# -ne 0 ]]; then
    echo "Error: usage: kubeton add" >&2
    exit 1
  fi

  get_single_ton_statefulset ns sts replicas || exit 1
  KUBETON_ADD_STS="$sts"
  TON_NAMESPACE="$ns"
  context="$(ton_add_context "$ns" "$sts")" || exit 1
  new_ordinal="$(ton_add_field "$context" ordinal)"
  new_replicas="$(ton_add_field "$context" target)"
  resume="$(ton_add_field "$context" resume)"
  has_cr="$(ton_add_field "$context" cr_uid)"
  new_pod="${sts}-${new_ordinal}"
  KUBETON_TARGET_TON_REPLICAS="$new_replicas"
  TON_NAMESPACE="$ns"
  if is_true "$resume"; then
    echo "[add] Resuming unfinished replica ${ns}/${new_pod}; keeping replicas=${new_replicas}."
  fi
  # Admission is for one extra, unoccupied host, using the live pod resources,
  # ports and storage. Existing validators are not treated as replaceable.
  ton_add_admit_node "$context" || exit 1
  selected_node="$KUBETON_ADD_SELECTED_NODE"
  selected_hostname="$KUBETON_ADD_SELECTED_HOSTNAME"
  echo "[add] Selected additional node: ${selected_node}."

  if should_bootstrap_baremetal; then
    ensure_auto_bootstrap_stack_if_needed
  fi
  validate_external_key_prereqs
  # Only kubeton's placement labels may be extended. Preserve every existing
  # node's labels, all explicit selectors, and all retained PVCs.
  while IFS= read -r label; do
    [[ -z "$label" ]] || kubectl label node "$selected_node" "$label" --overwrite >/dev/null || exit 1
  done < <(ton_add_field "$context" managed | python3 -c 'import json,sys; print("\n".join(key+"="+value for key,value in json.load(sys.stdin).items()))')
  if is_true "$(ton_add_field "$context" longhorn)"; then
    wait_ton_selected_nodes_longhorn_csi_ready "kubernetes.io/hostname=${selected_hostname}" || exit 1
  fi
  refreshed="$(ton_add_context "$ns" "$sts")" || exit 1
  if [[ "$(ton_add_field "$refreshed" ordinal)" != "$new_ordinal" || "$(ton_add_field "$refreshed" target)" != "$new_replicas" \
     || "$(ton_add_field "$refreshed" uid)" != "$(ton_add_field "$context" uid)" \
     || "$(ton_add_field "$refreshed" cr_uid)" != "$has_cr" \
     || "$(ton_add_field "$refreshed" managed)" != "$(ton_add_field "$context" managed)" ]]; then
    echo "Error: replica state changed while preparing add; rerun after the fleet converges." >&2
    exit 1
  fi
  context="$refreshed"
  ton_add_admit_node "$context" "$selected_node" || exit 1
  if [[ "$KUBETON_ADD_SELECTED_HOSTNAME" != "$selected_hostname" ]]; then
    echo "Error: selected node's hostname label changed during add; rerun after placement stabilizes." >&2
    exit 1
  fi
  if [[ "$has_cr" != None && -n "$has_cr" ]]; then
    operator_paused=1
    pause_operator_reconcile operator_names operator_replicas || exit 1
    (( ${#operator_names[@]} > 0 )) || { echo "Error: cannot pause the TonNode operator for safe scale-up." >&2; exit 1; }
    operator_pods="$(kubectl -n "$OP_NAMESPACE" get pods -l "app.kubernetes.io/instance=${RELEASE_NAME}" -o name)" || exit 1
    if [[ -n "$operator_pods" ]]; then
      kubectl -n "$OP_NAMESPACE" wait --for=delete pod -l "app.kubernetes.io/instance=${RELEASE_NAME}" --timeout=120s >/dev/null || exit 1
    fi
    current_cr="$(kubectl -n "$ns" get tonnodes.ton.ton.org "$sts" -o json)" || exit 1
    patch="$(printf '%s\0%s' "$context" "$current_cr" | python3 -c '
import json,sys
c,cr=map(json.loads,sys.stdin.read().split("\0"))
if cr["metadata"]["uid"]!=c["cr_uid"] or cr["spec"].get("replicas",1)!=c["replicas"]: sys.exit("Error: TonNode changed during add")
print(json.dumps([{"op":"test","path":"/metadata/resourceVersion","value":cr["metadata"]["resourceVersion"]},{"op":"add","path":"/spec/replicas","value":c["target"]}]))
')" || exit 1
    kubectl -n "$ns" patch tonnodes.ton.ton.org "$sts" --field-manager=helm --type=json -p "$patch" >/dev/null || exit 1
  fi
  current_sts="$(kubectl -n "$ns" get statefulset "$sts" -o json)" || exit 1
  nodes_json="$(kubectl get nodes -o json)" || exit 1
  patch="$(printf '%s\0%s\0%s' "$context" "$current_sts" "$nodes_json" | python3 -c '
import json,sys
c,sts,nodes=map(json.loads,sys.stdin.read().split("\0")); node,hostname,map_key=sys.argv[1:]
if sts["metadata"]["uid"]!=c["uid"] or sts["spec"]["replicas"]!=c["replicas"]: sys.exit("Error: StatefulSet changed during add")
patch=[{"op":"test","path":"/metadata/resourceVersion","value":sts["metadata"]["resourceVersion"]},{"op":"add","path":"/spec/updateStrategy","value":{"type":"OnDelete"}},{"op":"add","path":"/spec/replicas","value":c["target"]}]
if c["automatic"]:
    hosts={item["metadata"]["name"]:item["metadata"].get("labels",{}).get("kubernetes.io/hostname",item["metadata"]["name"]) for item in nodes["items"]}
    allowed=sorted({hosts[name] for name in c["running"].values()}|{hostname})
    affinity={"requiredDuringSchedulingIgnoredDuringExecution":{"nodeSelectorTerms":[{"matchExpressions":[{"key":"kubernetes.io/hostname","operator":"In","values":allowed}]}]}}
    patch.append({"op":"add","path":"/spec/template/spec/affinity/nodeAffinity","value":affinity})
    mapping={**c["running"],str(c["ordinal"]):node}
    if sts["metadata"].get("annotations") is None: patch.append({"op":"add","path":"/metadata/annotations","value":{}})
    patch.append({"op":"add","path":"/metadata/annotations/"+map_key.replace("~","~0").replace("/","~1"),"value":",".join(key+"="+value for key,value in sorted(mapping.items(),key=lambda pair:int(pair[0])))})
print(json.dumps(patch))
' "$selected_node" "$selected_hostname" "$STICKY_ORDINAL_NODE_MAP_ANNOTATION_KEY")" || exit 1
  echo "[add] Applying placement and replicas=${new_replicas} for ${ns}/${sts}; retaining existing PVCs."
  kubectl -n "$ns" patch statefulset "$sts" --type=json -p "$patch" >/dev/null || exit 1
  if is_true "$resume" && [[ -n "$(ton_add_field "$context" pod_uid)" ]]; then
    pod_json="$(kubectl -n "$ns" get pod "$new_pod" --ignore-not-found -o json)" || exit 1
    if [[ -n "$pod_json" ]] && printf '%s\0%s' "$context" "$pod_json" | python3 -c 'import json,sys; c,p=map(json.loads,sys.stdin.read().split("\0")); sys.exit(0 if p["metadata"]["uid"]==c["pod_uid"] and not p.get("spec",{}).get("nodeName") and p.get("status",{}).get("phase")=="Pending" else 1)'; then
      echo "[add] Recreating only unscheduled Pending pod ${ns}/${new_pod} with the expanded placement."
      kubectl -n "$ns" delete pod "$new_pod" --wait=false >/dev/null || exit 1
    fi
  fi
  if (( operator_paused )); then
    ton_add_resume_operator operator_names operator_replicas || exit 1
    operator_paused=0
  fi

  echo "Added TON replica: ${ns}/${new_pod} (selected node ${selected_node}); startup initiated."
  echo "[add] Initialization and TON synchronization will continue in the background."
  echo "[add] Check progress: ./kubeton status"
  echo "[add] View logs: ./kubeton logs ${selected_node}"
  echo "[add] After key generation completes, execute ./kubeton backup-keys"
)

confirm_tail_replica_wallets_and_backup() {
  local ns="$1" pod="$2"
  local inventory wallet_name wallet_row resolved_name status balance version workchain address raw_address safety
  local nonempty_count=0 unknown_count=0
  local -a table_rows=()

  echo "[del] Checking all wallets on ${ns}/${pod} before deleting its storage ..."
  if inventory="$(list_tonnode_wallet_names_from_pod "$ns" "$pod" true)"; then
    while IFS= read -r wallet_name; do
      [[ -n "$wallet_name" ]] || continue
      if ! [[ "$wallet_name" =~ ^[A-Za-z0-9._-]+$ ]]; then
        echo "Warning: a wallet filename could not be inspected safely; wallet inventory is incomplete." >&2
        ((unknown_count+=1))
        continue
      fi
      status=unknown balance=unknown address=unknown safety=unknown
      # Require an actual chain query. wl's inferred empty state is not
      # sufficient evidence for deleting a wallet's private key.
      if raw_address="$(read_tonnode_wallet_address_file_from_pod "$ns" "$pod" "$wallet_name")"; then
        address="$raw_address"
        if wallet_row="$(read_tonnode_wallet_state_from_pod "$ns" "$pod" "$wallet_name" "$raw_address" 2>/dev/null)"; then
          IFS=$'\t' read -r resolved_name status balance version workchain address <<<"$wallet_row"
          if [[ "$resolved_name" == "$wallet_name" && "$balance" =~ ^[0-9]+([.][0-9]*)?$ ]] \
            && [[ "$(ton_address_to_hex "$address" || true)" == "$raw_address" ]]; then
            if ! [[ "$balance" =~ ^0+([.]0*)?$ ]]; then
              safety=non-empty
            else
              case "${status,,}" in
                empty) safety=empty ;;
                active|uninit|uninitialized|frozen) safety=non-empty ;;
              esac
            fi
          fi
        fi
      fi
      case "$safety" in
        non-empty) ((nonempty_count+=1)) ;;
        unknown) status=unknown balance=unknown; ((unknown_count+=1)) ;;
      esac
      table_rows+=("${wallet_name}"$'\t'"${status}"$'\t'"${balance}"$'\t'"${address}"$'\t'"${safety}")
    done <<<"$inventory"
    if [[ -z "$inventory" ]]; then
      echo "[del] No wallet key or address files found on ${ns}/${pod}."
    fi
  else
    echo "Warning: cannot list wallets on ${ns}/${pod}; their balances are unknown." >&2
    ((unknown_count+=1))
  fi
  if (( ${#table_rows[@]} > 0 )); then
    print_aligned_table_5col "wallet-name" "status" "balance (TON)" "wallet-address" "check" "${table_rows[@]}"
  fi
  if (( nonempty_count > 0 )); then
    echo "Warning: ${nonempty_count} wallet(s) have a non-empty on-chain state or a positive balance. Deleting their keys without a usable backup can lose access to funds." >&2
    confirm_or_exit "Continue deleting ${ns}/${pod} despite its non-empty wallet(s)?" || return 1
  fi
  if (( unknown_count > 0 )); then
    echo "Warning: could not verify ${unknown_count} wallet balance(s) or inventory item(s). Unknown does not mean empty." >&2
    confirm_or_exit "Continue deleting ${ns}/${pod} despite unknown wallet balances or incomplete inventory?" || return 1
  fi
  echo "[del] Create a current off-cluster backup first: ./kubeton backup-fleet <backup-dir>"
  echo "[del] Alternatively: ./kubeton backup-keys <backup-dir> (recovery requires the original Vault/KMS key)."
  confirm_or_exit "Do you have a current backup of ${ns}/${pod}'s keys and wallets stored outside this cluster?"
}

run_del() {
  require_bin kubectl
  if [[ $# -ne 0 ]]; then
    echo "Error: kubeton del does not take a pod name; it always removes the tail replica (highest ordinal)." >&2
    echo "Error: usage: kubeton del" >&2
    exit 1
  fi

  local ns sts replicas ordinal pod sts_uid pod_uid current_replicas current_sts_uid current_pod_uid
  local -a claim_prefixes=("ton-work" "ton-src" "mytoncore" "mytonctrl" "keybundle")
  local -a pvc_names=()
  local -a pv_names=()
  local claim_prefix pvc pv

  get_single_ton_statefulset ns sts replicas || exit 1

  replicas="$(kubectl -n "$ns" get statefulset "$sts" -o jsonpath='{.spec.replicas}' 2>/dev/null || true)"
  if ! [[ "$replicas" =~ ^[0-9]+$ ]]; then
    echo "Error: cannot read replicas for ${ns}/${sts}." >&2
    exit 1
  fi
  if (( replicas <= 0 )); then
    echo "Error: StatefulSet ${ns}/${sts} has no replicas to delete." >&2
    exit 1
  fi

  ordinal=$((replicas - 1))
  pod="${sts}-${ordinal}"

  sts_uid="$(kubectl -n "$ns" get statefulset "$sts" -o jsonpath='{.metadata.uid}')" || return 1
  [[ -n "$sts_uid" ]] || { echo "Error: cannot verify StatefulSet identity before deletion." >&2; return 1; }
  pod_uid="$(kubectl -n "$ns" get pod "$pod" --ignore-not-found -o jsonpath='{.metadata.uid}')" || return 1
  confirm_tail_replica_wallets_and_backup "$ns" "$pod" || return 1
  confirm_or_exit "This will remove the tail TON replica ${ns}/${pod}, delete its PVC/PV (including Longhorn volume if present), and scale ${sts} to $((replicas - 1)). Continue?"

  # Wallet queries and human confirmation can take time. Do not apply the
  # approval to a different tail replica after another add/del or pod restart.
  current_replicas="$(kubectl -n "$ns" get statefulset "$sts" -o jsonpath='{.spec.replicas}')" || return 1
  current_sts_uid="$(kubectl -n "$ns" get statefulset "$sts" -o jsonpath='{.metadata.uid}')" || return 1
  current_pod_uid="$(kubectl -n "$ns" get pod "$pod" --ignore-not-found -o jsonpath='{.metadata.uid}')" || return 1
  if [[ "$current_replicas" != "$replicas" || "$current_sts_uid" != "$sts_uid" || "$current_pod_uid" != "$pod_uid" ]]; then
    echo "Error: fleet or tail pod changed during confirmation; rerun kubeton del to inspect the current wallets." >&2
    return 1
  fi

  for claim_prefix in "${claim_prefixes[@]}"; do
    pvc="${claim_prefix}-${sts}-${ordinal}"
    pvc_names+=("$pvc")
    pv="$(kubectl -n "$ns" get pvc "$pvc" -o jsonpath='{.spec.volumeName}' 2>/dev/null || true)"
    if [[ -n "$pv" ]]; then
      pv_names+=("$pv")
    fi
  done

  echo "Scaling ${ns}/${sts} from ${replicas} to $((replicas - 1)) ..."
  if kubectl -n "$ns" get tonnodes.ton.ton.org "$sts" >/dev/null 2>&1; then
    kubectl -n "$ns" patch tonnodes.ton.ton.org "$sts" --field-manager=helm --type=merge -p "{\"spec\":{\"replicas\":$((replicas - 1))}}" >/dev/null
  else
    set_ton_replicas "$ns" "$sts" "$((replicas - 1))"
  fi
  wait_pod_gone "$ns" "$pod" 600 || true

  echo "Deleting PVCs for ${ns}/${pod} ..."
  for pvc in "${pvc_names[@]}"; do
    kubectl -n "$ns" delete pvc "$pvc" --ignore-not-found --wait=false >/dev/null 2>&1 || true
  done

  if [[ ${#pv_names[@]} -gt 0 ]]; then
    echo "Deleting PV and Longhorn volume resources ..."
  fi
  for pv in "${pv_names[@]}"; do
    kubectl delete pv "$pv" --ignore-not-found --wait=false >/dev/null 2>&1 || true
    kubectl -n "$LONGHORN_NAMESPACE" delete volumes.longhorn.io "$pv" --ignore-not-found --wait=false >/dev/null 2>&1 || true
  done

  echo "Replica ${ns}/${pod} deleted."
}

run_recreate() {
  require_bin kubectl
  require_bin sha256sum

  if [[ $# -ne 2 ]]; then
    echo "Error: usage: kubeton recreate <pod-name|namespace/pod-name> <backup-dir>" >&2
    exit 1
  fi

  local pod_ref="$1"
  local input_dir="$2"
  local ns="" pod="" sts="" ordinal=""
  local replicas=""
  local pvc_ton_work pvc_ton_src pvc_mytoncore pvc_mytonctrl pvc_keybundle
  local pv_ton_work="" pv_ton_src="" pv_mytoncore="" pv_mytonctrl=""
  local item_dir bundle_dir
  local phase=""
  local remaining=180

  if [[ ! -d "$input_dir" ]]; then
    echo "Error: backup directory not found: $input_dir" >&2
    exit 1
  fi
  input_dir="$(cd "$input_dir" && pwd)"

  if should_bootstrap_baremetal; then
    ensure_auto_bootstrap_stack_if_needed
  fi
  validate_external_key_prereqs

  resolve_ton_pod_identity "$pod_ref" ns pod sts ordinal || exit 1

  replicas="$(kubectl -n "$ns" get statefulset "$sts" -o jsonpath='{.spec.replicas}' 2>/dev/null || true)"
  if ! [[ "$replicas" =~ ^[0-9]+$ ]]; then
    echo "Error: cannot read replicas for StatefulSet ${ns}/${sts}." >&2
    exit 1
  fi
  if (( ordinal >= replicas )); then
    echo "Error: pod ordinal ${ordinal} is outside StatefulSet replicas=${replicas} for ${ns}/${sts}." >&2
    exit 1
  fi

  pvc_ton_work="ton-work-${sts}-${ordinal}"
  pvc_ton_src="ton-src-${sts}-${ordinal}"
  pvc_mytoncore="mytoncore-${sts}-${ordinal}"
  pvc_mytonctrl="mytonctrl-${sts}-${ordinal}"
  pvc_keybundle="keybundle-${sts}-${ordinal}"
  item_dir="${input_dir}/${ns}/${sts}/${ordinal}"
  bundle_dir="${item_dir}/bundle"

  if [[ ! -d "$bundle_dir" ]]; then
    echo "Error: missing backup bundle dir for ${ns}/${sts}/${ordinal}: ${bundle_dir}" >&2
    exit 1
  fi
  if ! find "$bundle_dir" -type f -print -quit | grep -q .; then
    echo "Error: backup bundle dir is empty for ${ns}/${sts}/${ordinal}: ${bundle_dir}" >&2
    exit 1
  fi
  if [[ -f "${item_dir}/SHA256SUMS" ]]; then
    if ! (cd "$item_dir" && sha256sum -c SHA256SUMS >/dev/null); then
      echo "Error: SHA256SUMS verification failed for ${item_dir}." >&2
      exit 1
    fi
  else
    echo "Warning: ${item_dir}/SHA256SUMS not found; continuing without checksum verification."
  fi

  if ! kubectl -n "$ns" get pvc "$pvc_keybundle" >/dev/null 2>&1; then
    echo "Error: required key bundle PVC ${ns}/${pvc_keybundle} not found." >&2
    exit 1
  fi

  confirm_or_exit "This will recreate ${ns}/${pod}: delete PVCs ${pvc_ton_work}, ${pvc_ton_src}, ${pvc_mytoncore}, and ${pvc_mytonctrl}, let pod run for 3 minutes, inject backup bundle from ${item_dir}, then restart pod. Continue?"

  pv_ton_work="$(kubectl -n "$ns" get pvc "$pvc_ton_work" -o jsonpath='{.spec.volumeName}' 2>/dev/null || true)"
  pv_ton_src="$(kubectl -n "$ns" get pvc "$pvc_ton_src" -o jsonpath='{.spec.volumeName}' 2>/dev/null || true)"
  pv_mytoncore="$(kubectl -n "$ns" get pvc "$pvc_mytoncore" -o jsonpath='{.spec.volumeName}' 2>/dev/null || true)"
  pv_mytonctrl="$(kubectl -n "$ns" get pvc "$pvc_mytonctrl" -o jsonpath='{.spec.volumeName}' 2>/dev/null || true)"

  echo "Deleting corrupted data PVCs for ${ns}/${pod} ..."
  kubectl -n "$ns" delete pod "$pod" --ignore-not-found --wait=false >/dev/null 2>&1 || true
  kubectl -n "$ns" delete pvc "$pvc_ton_work" "$pvc_ton_src" "$pvc_mytoncore" "$pvc_mytonctrl" --ignore-not-found --wait=false >/dev/null 2>&1 || true

  # Best-effort cleanup of previous backing volumes helps avoid stuck Terminating PVCs on bare-metal.
  if [[ -n "$pv_ton_work" ]]; then
    kubectl delete pv "$pv_ton_work" --ignore-not-found --wait=false >/dev/null 2>&1 || true
    kubectl -n "$LONGHORN_NAMESPACE" delete volumes.longhorn.io "$pv_ton_work" --ignore-not-found --wait=false >/dev/null 2>&1 || true
  fi
  if [[ -n "$pv_ton_src" ]]; then
    kubectl delete pv "$pv_ton_src" --ignore-not-found --wait=false >/dev/null 2>&1 || true
    kubectl -n "$LONGHORN_NAMESPACE" delete volumes.longhorn.io "$pv_ton_src" --ignore-not-found --wait=false >/dev/null 2>&1 || true
  fi
  if [[ -n "$pv_mytoncore" ]]; then
    kubectl delete pv "$pv_mytoncore" --ignore-not-found --wait=false >/dev/null 2>&1 || true
    kubectl -n "$LONGHORN_NAMESPACE" delete volumes.longhorn.io "$pv_mytoncore" --ignore-not-found --wait=false >/dev/null 2>&1 || true
  fi
  if [[ -n "$pv_mytonctrl" ]]; then
    kubectl delete pv "$pv_mytonctrl" --ignore-not-found --wait=false >/dev/null 2>&1 || true
    kubectl -n "$LONGHORN_NAMESPACE" delete volumes.longhorn.io "$pv_mytonctrl" --ignore-not-found --wait=false >/dev/null 2>&1 || true
  fi

  echo "Waiting for fresh PVCs to become Bound ..."
  wait_pvc_bound "$ns" "$pvc_ton_work" 1800
  wait_pvc_bound "$ns" "$pvc_ton_src" 1800
  wait_pvc_bound "$ns" "$pvc_mytoncore" 1800
  wait_pvc_bound "$ns" "$pvc_mytonctrl" 1800

  echo "Waiting for initial startup of ${ns}/${pod} ..."
  wait_pod_ready "$ns" "$pod" 1800
  echo "Initial startup complete."

  while (( remaining > 0 )); do
    phase="$(kubectl -n "$ns" get pod "$pod" -o jsonpath='{.status.phase}' 2>/dev/null || true)"
    [[ -z "$phase" ]] && phase="Unknown"
    echo "[recreate] ${ns}/${pod} is running (phase=${phase}); replacing with backup in ${remaining}s ..."
    sleep 30
    ((remaining-=30))
  done

  echo "Injecting encrypted backup bundle into ${ns}/${pod} ..."
  inject_bundle_into_running_pod "$ns" "$pod" "$bundle_dir"

  echo "Restarting ${ns}/${pod} to restore keys and mytoncore from bundle ..."
  kubectl -n "$ns" delete pod "$pod" --ignore-not-found --wait=false >/dev/null 2>&1 || true
  wait_pod_ready "$ns" "$pod" 1800

  echo "Recreate completed for ${ns}/${pod}."
}

pause_operator_reconcile() {
  local -n deploy_names_ref="$1"
  local -n deploy_replicas_ref="$2"

  mapfile -t deploy_rows < <(kubectl -n "$OP_NAMESPACE" get deploy -l "app.kubernetes.io/instance=${RELEASE_NAME}" \
    -o jsonpath='{range .items[*]}{.metadata.name}{"\t"}{.spec.replicas}{"\n"}{end}')
  if [[ ${#deploy_rows[@]} -eq 0 || -z "${deploy_rows[0]}" ]]; then
    echo "Warning: no operator deployments found in namespace ${OP_NAMESPACE}; backup/restore may race with reconciliation." >&2
    return 0
  fi

  local row name replicas
  for row in "${deploy_rows[@]}"; do
    [[ -z "$row" ]] && continue
    IFS=$'\t' read -r name replicas <<<"$row"
    [[ -z "$name" ]] && continue
    if ! [[ "$replicas" =~ ^[0-9]+$ ]]; then
      replicas=1
    fi
    deploy_names_ref+=("$name")
    deploy_replicas_ref+=("$replicas")
  done

  echo "Temporarily disabling operator reconciliation (scaling deployments in ${OP_NAMESPACE} to 0) ..."
  local i
  for i in "${!deploy_names_ref[@]}"; do
    kubectl -n "$OP_NAMESPACE" scale deployment "${deploy_names_ref[$i]}" --replicas=0 >/dev/null
  done
}

resume_operator_reconcile() {
  local -n deploy_names_ref="$1"
  local -n deploy_replicas_ref="$2"
  local i

  [[ ${#deploy_names_ref[@]} -eq 0 ]] && return 0

  echo "Restoring operator reconciliation in ${OP_NAMESPACE} ..."
  for i in "${!deploy_names_ref[@]}"; do
    kubectl -n "$OP_NAMESPACE" scale deployment "${deploy_names_ref[$i]}" --replicas="${deploy_replicas_ref[$i]}" >/dev/null 2>&1 || true
  done
}

wait_statefulset_pods_gone() {
  local ns="$1"
  local sts="$2"
  local selector="app.kubernetes.io/instance=${sts},app.kubernetes.io/name=ton-node"
  local start_ts
  local next_diag
  local deadline=$(( $(date +%s) + 900 ))
  start_ts="$(date +%s)"
  next_diag=$(( start_ts + 20 ))
  while (( $(date +%s) < deadline )); do
    local now
    local count pod_inventory
    now="$(date +%s)"
    if ! pod_inventory="$(kubectl -n "$ns" get pods -l "$selector" -o name)"; then
      echo "Error: cannot verify whether TON pods of ${ns}/${sts} have terminated." >&2
      return 1
    fi
    count="$(printf '%s\n' "$pod_inventory" | awk 'NF{n++} END{print n+0}')"
    if [[ "${count:-0}" == "0" ]]; then
      return 0
    fi
    if (( now >= next_diag )); then
      local elapsed
      elapsed=$(( now - start_ts ))
      echo "[wait] ${ns}/${sts}: ${count} pod(s) still terminating after ${elapsed}s ..."
      kubectl -n "$ns" get pods -l "$selector" \
        -o custom-columns=NAME:.metadata.name,PHASE:.status.phase,DELETING:.metadata.deletionTimestamp,NODE:.spec.nodeName \
        --no-headers 2>/dev/null || true
      next_diag=$(( now + 20 ))
    fi
    sleep 2
  done
  echo "Error: timeout waiting for pods of ${ns}/${sts} to terminate" >&2
  kubectl -n "$ns" get pods -l "$selector" \
    -o custom-columns=NAME:.metadata.name,PHASE:.status.phase,DELETING:.metadata.deletionTimestamp,NODE:.spec.nodeName \
    --no-headers 2>/dev/null || true
  return 1
}

scale_statefulset_rows_to_zero() {
  local -n sts_rows_ref="$1"
  local row ns sts rc=0

  for row in "${sts_rows_ref[@]}"; do
    [[ -z "$row" ]] && continue
    IFS=$'\t' read -r ns sts _ <<<"$row"
    [[ -z "$ns" || -z "$sts" ]] && continue
    if ! kubectl -n "$ns" scale statefulset "$sts" --replicas=0 >/dev/null; then
      echo "Error: could not stop StatefulSet ${ns}/${sts} before storage cleanup." >&2
      rc=1
    fi
  done
  return "$rc"
}

clear_stopped_metadata_for_statefulset_rows() {
  local -n sts_rows_ref="$1"
  local row ns sts

  for row in "${sts_rows_ref[@]}"; do
    [[ -z "$row" ]] && continue
    IFS=$'\t' read -r ns sts _ <<<"$row"
    [[ -z "$ns" || -z "$sts" ]] && continue
    kubectl -n "$ns" patch tonnodes.ton.ton.org "$sts" --type=merge \
      -p "{\"metadata\":{\"annotations\":{\"${KUBETON_PAUSE_ANNOTATION_KEY}\":null,\"${KUBETON_PAUSE_NODEMAP_ANNOTATION_KEY}\":null}}}" >/dev/null 2>&1 || true
    kubectl -n "$ns" patch statefulset "$sts" --type=merge \
      -p "{\"metadata\":{\"annotations\":{\"${KUBETON_PAUSE_ANNOTATION_KEY}\":null,\"${KUBETON_PAUSE_NODEMAP_ANNOTATION_KEY}\":null,\"${STICKY_ORDINAL_NODE_MAP_ANNOTATION_KEY}\":null}}}" >/dev/null 2>&1 || true
  done
}

wait_statefulset_rows_pods_gone() {
  local -n sts_rows_ref="$1"
  local row ns sts
  local failed=0
  local -a wait_pids=()
  local -a wait_targets=()
  local i

  for row in "${sts_rows_ref[@]}"; do
    [[ -z "$row" ]] && continue
    IFS=$'\t' read -r ns sts _ <<<"$row"
    [[ -z "$ns" || -z "$sts" ]] && continue
    wait_statefulset_pods_gone "$ns" "$sts" &
    wait_pids+=("$!")
    wait_targets+=("${ns}/${sts}")
  done

  for i in "${!wait_pids[@]}"; do
    if ! wait "${wait_pids[$i]}"; then
      echo "Warning: timed out waiting for pods of ${wait_targets[$i]} to terminate." >&2
      failed=1
    fi
  done

  return "$failed"
}

stop_ton_for_destructive_cleanup() {
  local sts_rows_name="$1"
  local deployed_releases crd_marker rc=0

  # Failed/uninstalled Helm history cannot be upgraded. A partial purge can
  # also remove the CRD before the storage teardown completes.
  if deployed_releases="$(helm list -n "$OP_NAMESPACE" --deployed --short --filter "^${RELEASE_NAME}$")"; then
    if grep -Fxq -- "$RELEASE_NAME" <<<"$deployed_releases"; then
      if ! run_stop_without_backup; then
        echo "Warning: failed to disable TON resources in Helm release ${RELEASE_NAME}; continuing with direct TonNode/StatefulSet cleanup." >&2
      fi
    else
      echo "[uninstall] No deployed operator Helm release; using direct TON cleanup."
    fi
  else
    echo "Error: cannot inspect operator Helm release; attempting direct TON cleanup." >&2
    rc=1
  fi

  clear_stopped_metadata_for_statefulset_rows "$sts_rows_name"
  if crd_marker="$(kubectl get crd tonnodes.ton.ton.org --ignore-not-found -o name)"; then
    if [[ -n "$(trim_whitespace "$crd_marker")" ]]; then
      kubectl delete tonnodes.ton.ton.org --all -A --ignore-not-found || rc=1
    else
      echo "[uninstall] TonNode CRD already absent; continuing remaining-resource cleanup."
    fi
  else
    echo "Error: cannot verify TonNode CRD before fleet shutdown." >&2
    rc=1
  fi

  # If the operator or Helm path is unhealthy, scaling the captured StatefulSets
  # still prevents live pods from holding PVCs while deletion starts.
  scale_statefulset_rows_to_zero "$sts_rows_name" || rc=1

  echo "Waiting for TON pods to terminate before PVC deletion ..."
  wait_statefulset_rows_pods_gone "$sts_rows_name" || rc=1
  return "$rc"
}

wait_ton_statefulsets_present() {
  local timeout_seconds="${1:-300}"
  local deadline=$(( $(date +%s) + timeout_seconds ))
  local -a sts_rows=()

  while (( $(date +%s) < deadline )); do
    mapfile -t sts_rows < <(list_ton_statefulsets 2>/dev/null || true)
    if (( ${#sts_rows[@]} > 0 )) && [[ -n "${sts_rows[0]:-}" ]]; then
      return 0
    fi
    sleep 2
  done

  echo "Error: timeout waiting for TON StatefulSet creation." >&2
  return 1
}

wait_statefulset_present() {
  local ns="$1"
  local sts="$2"
  local timeout_seconds="${3:-300}"
  local deadline=$(( $(date +%s) + timeout_seconds ))

  while (( $(date +%s) < deadline )); do
    if kubectl -n "$ns" get statefulset "$sts" >/dev/null 2>&1; then
      return 0
    fi
    sleep 2
  done

  echo "Error: timeout waiting for StatefulSet ${ns}/${sts}." >&2
  return 1
}

set_tonnode_or_statefulset_replicas() {
  local ns="$1"
  local name="$2"
  local replicas="$3"

  if kubectl -n "$ns" get tonnodes.ton.ton.org "$name" >/dev/null 2>&1; then
    kubectl -n "$ns" patch tonnodes.ton.ton.org "$name" --field-manager=helm --type=merge \
      -p "{\"spec\":{\"replicas\":${replicas}}}" >/dev/null
    return 0
  fi

  set_ton_replicas "$ns" "$name" "$replicas"
}

should_use_sequential_ton_start() {
  local target_replicas="$1"
  local restore_from_stop_metadata="$2"

  if ! [[ "$target_replicas" =~ ^[1-9][0-9]*$ ]]; then
    return 1
  fi
  if (( target_replicas <= 1 || restore_from_stop_metadata != 0 )); then
    return 1
  fi

  if fleet_has_running_ton_pods; then
    if is_true "$KUBETON_SEQUENTIAL_TON_START"; then
      echo "Warning: KUBETON_SEQUENTIAL_TON_START=true ignored because TON pods are already Running; sequential staging would scale the fleet down during start." >&2
    fi
    return 1
  fi

  if is_true "$KUBETON_SEQUENTIAL_TON_START"; then
    return 0
  fi

  if is_true "$KUBETON_AUTO_SEQUENTIAL_LOCAL_PATH_START" && ton_storage_class_requires_sequential_start; then
    return 0
  fi

  return 1
}

ton_start_reconcile_observation() {
  local ns="$1"
  local tonnode_name="$2"
  local selector tonnode_row statefulset_row pod_rows rc=0

  selector="$(launch_session_selector "$tonnode_name")"
  tonnode_row="$(run_with_timeout "$STATUS_EXEC_TIMEOUT" kubectl -n "$ns" \
    get tonnodes.ton.ton.org "$tonnode_name" --ignore-not-found \
    -o go-template='{{.metadata.generation}}{{"\x1f"}}{{if .status.observedGeneration}}{{.status.observedGeneration}}{{else}}0{{end}}{{"\x1f"}}{{.spec.replicas}}')" || {
      rc=$?
      echo "reading TonNode ${ns}/${tonnode_name} failed (exit=${rc})" >&2
      return "$rc"
    }
  statefulset_row="$(run_with_timeout "$STATUS_EXEC_TIMEOUT" kubectl -n "$ns" \
    get statefulset "$tonnode_name" --ignore-not-found \
    -o go-template='{{.metadata.generation}}{{"\x1f"}}{{if .status.observedGeneration}}{{.status.observedGeneration}}{{else}}0{{end}}{{"\x1f"}}{{.spec.replicas}}')" || {
      rc=$?
      echo "reading StatefulSet ${ns}/${tonnode_name} failed (exit=${rc})" >&2
      return "$rc"
    }
  pod_rows="$(run_with_timeout "$STATUS_EXEC_TIMEOUT" kubectl -n "$ns" get pods -l "$selector" \
    -o go-template='{{range .items}}{{.metadata.name}}{{"\x1f"}}{{.metadata.uid}}{{"\x1f"}}{{if .metadata.deletionTimestamp}}terminating{{end}}{{"\n"}}{{end}}')" || {
      rc=$?
      echo "listing TON Pods for ${ns}/${tonnode_name} failed (exit=${rc})" >&2
      return "$rc"
    }

  printf 'tonnode\x1f%s\nstatefulset\x1f%s\n%s' \
    "$tonnode_row" "$statefulset_row" "$pod_rows"
}

wait_ton_controller_reconciled_after_start() {
  local ns="$1"
  local tonnode_name="$2"
  local desired_replicas="$3"
  local timeout_seconds="${4:-$KUBETON_START_RECONCILE_TIMEOUT_SECONDS}"
  local status_read_error_limit deadline now observation observation_error_file observation_error
  local observation_rc read_errors=0 kind field1 field2 field3 pod_name pod_uid pod_deleting
  local ton_generation ton_observed ton_replicas sts_generation sts_observed sts_replicas
  local observed_pod_count ordinal last_detail="waiting for the controller to observe the TonNode generation"
  local -A expected_pods=()
  local -A observed_pods=()

  if ! [[ "$desired_replicas" =~ ^[1-9][0-9]*$ ]]; then
    echo "Error: invalid desired TON replica count '${desired_replicas}' for controller reconciliation." >&2
    return 1
  fi
  timeout_seconds="$(trim_whitespace "$timeout_seconds")"
  status_read_error_limit="$(trim_whitespace "${KUBETON_START_STATUS_READ_ERROR_LIMIT:-3}")"
  if [[ "$timeout_seconds" == "auto" ]]; then
    # Controller sticky-placement repair may wait 10 minutes for old Pods to
    # disappear and 15 minutes for each ordinal to be assigned. Add another
    # five-minute margin without imposing a 24-hour wait on a missing object.
    timeout_seconds=$((900 * desired_replicas + 900))
  elif ! [[ "$timeout_seconds" =~ ^[1-9][0-9]*$ ]]; then
    echo "Error: invalid KUBETON_START_RECONCILE_TIMEOUT_SECONDS '${timeout_seconds}'." >&2
    return 1
  fi
  [[ "$status_read_error_limit" =~ ^[0-9]+$ ]] || status_read_error_limit=3
  for ordinal in $(seq 0 $((desired_replicas - 1))); do
    expected_pods["${tonnode_name}-${ordinal}"]=1
  done

  deadline=$(( $(date +%s) + timeout_seconds ))
  echo "[start] Waiting for ${ns}/${tonnode_name} controller reconciliation at ${desired_replicas} replica(s) ..."
  while :; do
    observation_rc=0
    if ! observation_error_file="$(umask 077; mktemp "${TMPDIR:-/tmp}/kubeton-start-reconcile.XXXXXX")"; then
      echo "Error: cannot create a temporary file for controller-reconciliation error capture." >&2
      return 1
    fi
    observation="$(ton_start_reconcile_observation "$ns" "$tonnode_name" \
      2>"$observation_error_file")" || observation_rc=$?
    if (( observation_rc != 0 )); then
      read_errors=$((read_errors + 1))
      observation_error="$(captured_command_error_reason \
        "$observation_rc" "$STATUS_EXEC_TIMEOUT" "$observation_error_file")"
      rm -f "$observation_error_file" >/dev/null 2>&1 || true
      last_detail="${observation_error}"
      if (( status_read_error_limit > 0 && read_errors >= status_read_error_limit )); then
        echo "Error: cannot observe TON controller reconciliation after ${read_errors} consecutive API attempts (exit=${observation_rc}): ${observation_error}." >&2
        echo "Error: the TON objects and PVCs were left intact; inspect the launch evidence bundle and API/proxy capacity." >&2
        return 1
      fi
      now="$(date +%s)"
      if (( now >= deadline )); then
        echo "Error: timed out after ${timeout_seconds}s waiting for TON controller reconciliation: ${last_detail}." >&2
        echo "Error: the TON objects and PVCs were left intact; inspect the launch evidence bundle and API/proxy capacity." >&2
        return 1
      fi
      sleep 2
      continue
    fi
    rm -f "$observation_error_file" >/dev/null 2>&1 || true
    read_errors=0
    ton_generation=""
    ton_observed=""
    ton_replicas=""
    sts_generation=""
    sts_observed=""
    sts_replicas=""
    observed_pods=()

    while IFS=$'\x1f' read -r kind field1 field2 field3; do
      case "$kind" in
        tonnode)
          ton_generation="$(trim_whitespace "$field1")"
          ton_observed="$(trim_whitespace "$field2")"
          ton_replicas="$(trim_whitespace "$field3")"
          ;;
        statefulset)
          sts_generation="$(trim_whitespace "$field1")"
          sts_observed="$(trim_whitespace "$field2")"
          sts_replicas="$(trim_whitespace "$field3")"
          ;;
        *)
          pod_name="$(trim_whitespace "$kind")"
          pod_uid="$(trim_whitespace "$field1")"
          pod_deleting="$(trim_whitespace "$field2")"
          if [[ -n "$pod_name" && -n "$pod_uid" && -z "$pod_deleting" ]]; then
            if [[ -n "${expected_pods[$pod_name]:-}" ]]; then
              observed_pods["$pod_name"]=1
            fi
          fi
          ;;
      esac
    done <<<"$observation"
    observed_pod_count="${#observed_pods[@]}"

    if [[ "$ton_generation" =~ ^[1-9][0-9]*$ \
      && "$ton_observed" =~ ^[1-9][0-9]*$ \
      && "$ton_replicas" == "$desired_replicas" \
      && "$ton_observed" -ge "$ton_generation" \
      && "$sts_generation" =~ ^[1-9][0-9]*$ \
      && "$sts_observed" =~ ^[1-9][0-9]*$ \
      && "$sts_replicas" == "$desired_replicas" \
      && "$sts_observed" -ge "$sts_generation" \
      && "$observed_pod_count" == "$desired_replicas" ]]; then
      echo "[start] ${ns}/${tonnode_name} is reconciled; all ${desired_replicas} Pod object(s) are present and non-terminating."
      return 0
    fi

    if [[ -z "$ton_generation" ]]; then
      last_detail="TonNode has not been observed"
    elif [[ "$ton_replicas" != "$desired_replicas" || "$ton_observed" != "$ton_generation" ]]; then
      last_detail="TonNode generation observed=${ton_observed:-0}/${ton_generation:-unknown}, replicas=${ton_replicas:-unknown}/${desired_replicas}"
    elif [[ -z "$sts_generation" ]]; then
      last_detail="StatefulSet has not been created"
    elif [[ ! "$sts_generation" =~ ^[1-9][0-9]*$ \
      || "$sts_replicas" != "$desired_replicas" || ! "$sts_observed" =~ ^[1-9][0-9]*$ \
      || "$sts_observed" -lt "$sts_generation" ]]; then
      last_detail="StatefulSet generation observed=${sts_observed:-0}/${sts_generation:-unknown}, replicas=${sts_replicas:-unknown}/${desired_replicas}"
    else
      last_detail="non-terminating Pod objects present=${observed_pod_count}/${desired_replicas}"
    fi

    now="$(date +%s)"
    if (( now >= deadline )); then
      echo "Error: timed out after ${timeout_seconds}s waiting for TON controller reconciliation: ${last_detail}." >&2
      echo "Error: the TON objects and PVCs were left intact; inspect the launch evidence bundle." >&2
      return 1
    fi
    sleep 2
  done
}

sequential_start_ton_fleet() {
  local target_replicas="$1"
  local -a sts_rows=()
  local row ns sts current_replicas ordinal pod

  if ! [[ "$target_replicas" =~ ^[1-9][0-9]*$ ]]; then
    return 0
  fi
  if (( target_replicas <= 1 )); then
    return 0
  fi

  wait_ton_statefulsets_present 300 || return 1
  mapfile -t sts_rows < <(list_ton_statefulsets 2>/dev/null || true)
  if (( ${#sts_rows[@]} == 0 )) || [[ -z "${sts_rows[0]:-}" ]]; then
    echo "Error: no TON StatefulSets found for sequential start." >&2
    return 1
  fi

  echo "[start] Sequential TON volume staging enabled: scaling to ${target_replicas} one ordinal at a time."
  for ordinal in $(seq 0 $((target_replicas - 1))); do
    current_replicas=$((ordinal + 1))
    if (( ordinal > 0 )); then
      # A local-path ordinal can take several minutes to bind and stage.
      # Refuse the next scale-up if durable log coverage disappeared while
      # the preceding ordinal was being prepared.
      if ! verify_start_victoria_logs_collection_ready; then
        restrict_existing_victoria_logs_after_failed_preflight || true
        echo "Error: VictoriaLogs coverage was lost before TON ordinal ${ordinal}; the next Pod was not created." >&2
        return 1
      fi
    fi
    for row in "${sts_rows[@]}"; do
      [[ -z "$row" ]] && continue
      IFS=$'\t' read -r ns sts _ <<<"$row"
      [[ -z "$ns" || -z "$sts" ]] && continue
      set_tonnode_or_statefulset_replicas "$ns" "$sts" "$current_replicas"
    done

    for row in "${sts_rows[@]}"; do
      [[ -z "$row" ]] && continue
      IFS=$'\t' read -r ns sts _ <<<"$row"
      [[ -z "$ns" || -z "$sts" ]] && continue
      pod="${sts}-${ordinal}"
      echo "[start] Waiting for ${ns}/${pod} volumes to stage ..."
      wait_pod_volume_stage_complete "$ns" "$pod" "$KUBETON_VOLUME_STAGE_TIMEOUT_SECONDS" || return 1
    done
  done
}

trigger_key_backup_once() {
  local ns="$1"
  local pod="$2"
  local deadline

  if ! kubectl -n "$ns" exec "$pod" -c key-backup -- sh -ec 'rm -f /tmp/key-backup.done /tmp/key-backup.failed; : > /tmp/key-backup.request' >/dev/null 2>&1; then
    echo "Error: failed to trigger key backup in ${ns}/${pod} (container key-backup)." >&2
    return 1
  fi

  deadline=$(( $(date +%s) + 300 ))
  while (( $(date +%s) < deadline )); do
    local status
    status="$(kubectl -n "$ns" exec "$pod" -c key-backup -- sh -ec '
      if [ -s /tmp/key-backup.done ]; then
        echo done
      elif [ -s /tmp/key-backup.failed ]; then
        echo failed
      else
        echo waiting
      fi
    ' 2>/dev/null || true)"
    status="${status%%$'\n'*}"
    case "$status" in
      done)
        return 0
        ;;
      failed)
        local fail_reason
        fail_reason="$(kubectl -n "$ns" exec "$pod" -c key-backup -- sh -ec 'cat /tmp/key-backup.failed' 2>/dev/null || true)"
        fail_reason="$(printf '%s' "$fail_reason" | tr '\n' ' ' | sed -e 's/[[:space:]]\+/ /g' -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')"
        if [[ -z "$fail_reason" ]]; then
          fail_reason="backup sidecar reported failure"
        fi
        echo "Error: manual key backup failed in ${ns}/${pod}: ${fail_reason}" >&2
        return 1
        ;;
      *)
        sleep 2
        ;;
    esac
  done

  echo "Error: timeout waiting for manual key backup completion in ${ns}/${pod}" >&2
  return 1
}

pod_has_encrypted_bundle() {
  local ns="$1"
  local pod="$2"
  kubectl -n "$ns" exec "$pod" -c key-backup -- sh -ec '
    bundle_file="${KEY_BUNDLE_FILE:-keys.bundle.enc}"
    meta_file="${KEY_BUNDLE_META_FILE:-keys.bundle.meta}"
    [ -s "/var/ton-key-bundle/${bundle_file}" ] && [ -s "/var/ton-key-bundle/${meta_file}" ]
  ' >/dev/null 2>&1
}

key_bundle_upload_checksums() {
  local src_bundle_dir="$1"
  [[ -d "$src_bundle_dir" ]] || return 1
  if [[ -e "$src_bundle_dir/.backup-publish" || -L "$src_bundle_dir/.backup-publish" ]]; then
    echo "Error: backup source ${src_bundle_dir} contains an unresolved .backup-publish journal; run or restart the source pod's key-backup container to recover publication, then export the backup again." >&2
    return 1
  fi
  (
    cd "$src_bundle_dir" || exit 1
    find . -type f ! -name .restore-controller-state -print0 \
      | sort -z | xargs -0 -r sha256sum
  )
}

commit_uploaded_key_bundle() {
  local ns="$1"
  local pod="$2"
  local bundle_mount="$3"
  local staging_dir="$4"
  local checksum_manifest="$5"
  local container="${6:-}"
  local -a container_args=()
  [[ -n "$container" ]] && container_args=(-c "$container")

  # Verify the staged bytes before touching the existing bundle. The durable
  # request distinguishes an explicit state replacement from a normal restart.
  # Roll back the original encrypted files if committing the upload/request
  # fails, so a later restart cannot mix selected keys with current settings.
  printf '%s\n' "$checksum_manifest" | kubectl -n "$ns" exec -i "$pod" "${container_args[@]}" -- sh -ec '
    bundle_dir="$1"
    staging_dir="$2"
    cd "$staging_dir"
    sha256sum -c - >/dev/null
    find . -type f -exec chmod 600 {} +
    rm -f .restore-controller-state
    previous_dir="$(mktemp -d "$bundle_dir/.restore-previous.XXXXXX")"
    replacing_payload=false
    rollback() {
      if [ "$replacing_payload" = true ]; then
        find "$bundle_dir" -mindepth 1 -maxdepth 1 \
          ! -name "${staging_dir##*/}" ! -name "${previous_dir##*/}" -exec rm -rf {} +
      fi
      for entry in "$previous_dir"/* "$previous_dir"/.[!.]* "$previous_dir"/..?*; do
        [ -e "$entry" ] || [ -L "$entry" ] || continue
        mv "$entry" "$bundle_dir/" || return 1
      done
      rmdir "$previous_dir"
      sync
    }
    trap rollback EXIT
    for entry in "$bundle_dir"/* "$bundle_dir"/.[!.]* "$bundle_dir"/..?*; do
      [ -e "$entry" ] || [ -L "$entry" ] || continue
      [ "$entry" = "$staging_dir" ] && continue
      [ "$entry" = "$previous_dir" ] && continue
      mv "$entry" "$previous_dir/"
    done
    replacing_payload=true
    for entry in "$staging_dir"/* "$staging_dir"/.[!.]* "$staging_dir"/..?*; do
      [ -e "$entry" ] || [ -L "$entry" ] || continue
      mv "$entry" "$bundle_dir/"
    done
    sync
    umask 077
    : > "$bundle_dir/.restore-controller-state"
    sync
    trap - EXIT
    cd "$bundle_dir"
    rmdir "$staging_dir"
    rm -rf "$previous_dir"
  ' _ "$bundle_mount" "$staging_dir" >/dev/null
}

restore_bundle_to_pvc() {
  local ns="$1"
  local pvc="$2"
  local src_bundle_dir="$3"
  local preferred_node="${4:-}"
  local helper_pod="kubeton-restore-$RANDOM-$RANDOM"
  local node_constraints_yaml=""
  local staging_dir="/bundle/.restore-upload-$RANDOM-$RANDOM"
  local checksum_manifest

  checksum_manifest="$(key_bundle_upload_checksums "$src_bundle_dir")" || return 1
  [[ -n "$checksum_manifest" ]] || return 1

  node_constraints_yaml="$(helper_pod_node_constraints_yaml "$preferred_node")"

  cat <<EOF | kubectl -n "$ns" apply -f - >/dev/null
apiVersion: v1
kind: Pod
metadata:
  name: ${helper_pod}
spec:
${node_constraints_yaml}
  restartPolicy: Never
  containers:
    - name: restore
      image: busybox:1.36
      command: ["sh", "-c", "sleep 3600"]
      volumeMounts:
        - name: keybundle
          mountPath: /bundle
  volumes:
    - name: keybundle
      persistentVolumeClaim:
        claimName: ${pvc}
EOF

  if ! kubectl -n "$ns" wait --for=condition=Ready "pod/${helper_pod}" --timeout="${HELPER_POD_READY_TIMEOUT}" >/dev/null; then
    print_helper_pod_failure_context "$ns" "$helper_pod"
    kubectl -n "$ns" delete pod "$helper_pod" --ignore-not-found >/dev/null 2>&1 || true
    return 1
  fi
  if ! kubectl -n "$ns" exec "$helper_pod" -- sh -ec 'mkdir -p "$1"' _ "$staging_dir" >/dev/null 2>&1; then
    kubectl -n "$ns" delete pod "$helper_pod" --ignore-not-found >/dev/null 2>&1 || true
    return 1
  fi
  if ! kubectl -n "$ns" cp "${src_bundle_dir}/." "${helper_pod}:${staging_dir}" >/dev/null; then
    kubectl -n "$ns" delete pod "$helper_pod" --ignore-not-found >/dev/null 2>&1 || true
    return 1
  fi
  if ! commit_uploaded_key_bundle "$ns" "$helper_pod" /bundle "$staging_dir" "$checksum_manifest"; then
    kubectl -n "$ns" delete pod "$helper_pod" --ignore-not-found >/dev/null 2>&1 || true
    echo "Error: could not verify and commit the explicit state-restore request for ${ns}/${pvc}." >&2
    return 1
  fi
  kubectl -n "$ns" delete pod "$helper_pod" --ignore-not-found >/dev/null 2>&1 || true
}

inject_bundle_into_running_pod() {
  local ns="$1"
  local pod="$2"
  local src_bundle_dir="$3"
  local bundle_mount=""
  local container_names=""
  local staging_dir checksum_manifest

  if [[ ! -d "$src_bundle_dir" ]]; then
    echo "Error: bundle source directory not found: $src_bundle_dir" >&2
    return 1
  fi
  if ! find "$src_bundle_dir" -type f -print -quit | grep -q .; then
    echo "Error: bundle source directory is empty: $src_bundle_dir" >&2
    return 1
  fi
  checksum_manifest="$(key_bundle_upload_checksums "$src_bundle_dir")" || return 1
  [[ -n "$checksum_manifest" ]] || return 1

  container_names="$(kubectl -n "$ns" get pod "$pod" -o jsonpath='{range .spec.containers[*]}{.name}{" "}{end}' 2>/dev/null || true)"
  if ! grep -qw "key-backup" <<<"$container_names"; then
    echo "Error: pod ${ns}/${pod} has no key-backup container." >&2
    return 1
  fi

  bundle_mount="$(kubectl -n "$ns" exec "$pod" -c key-backup -- sh -ec 'printf %s "${KEY_BUNDLE_DIR:-/var/ton-key-bundle}"' 2>/dev/null || true)"
  bundle_mount="$(trim_whitespace "$bundle_mount")"
  if [[ -z "$bundle_mount" ]]; then
    bundle_mount="/var/ton-key-bundle"
  fi
  if [[ "$bundle_mount" != /var/ton-key-bundle ]]; then
    echo "Error: unexpected encrypted bundle mount '${bundle_mount}' in ${ns}/${pod}." >&2
    return 1
  fi
  staging_dir="${bundle_mount}/.restore-upload-$RANDOM-$RANDOM"

  kubectl -n "$ns" exec "$pod" -c key-backup -- sh -ec 'mkdir -p "$1"' _ "$staging_dir" >/dev/null || return 1
  kubectl -n "$ns" cp "${src_bundle_dir}/." "${ns}/${pod}:${staging_dir}" -c key-backup >/dev/null || return 1
  if ! commit_uploaded_key_bundle "$ns" "$pod" "$bundle_mount" "$staging_dir" "$checksum_manifest" key-backup; then
    echo "Error: could not verify and commit the explicit state-restore request for ${ns}/${pod}." >&2
    return 1
  fi
}

restore_replica_from_backup() {
  local ns="$1"
  local sts="$2"
  local ordinal="$3"
  local input_dir="$4"
  local preferred_node="${5:-}"

  local pvc="keybundle-${sts}-${ordinal}"
  local item_dir="${input_dir}/${ns}/${sts}/${ordinal}"
  local bundle_dir="${item_dir}/bundle"

  if [[ ! -d "$bundle_dir" ]]; then
    echo "Warning: missing backup bundle for ${ns}/${sts}/${ordinal}: ${bundle_dir}" >&2
    return 10
  fi

  if [[ -f "${item_dir}/SHA256SUMS" ]]; then
    if ! (cd "$item_dir" && sha256sum -c SHA256SUMS >/dev/null); then
      echo "Warning: SHA256SUMS verification failed for ${item_dir}; skipping this replica" >&2
      return 11
    fi
  else
    echo "Warning: missing ${item_dir}/SHA256SUMS; continuing without checksum verification"
  fi

  if ! kubectl -n "$ns" get pvc "$pvc" >/dev/null 2>&1; then
    echo "Warning: missing PVC ${ns}/${pvc}; skipping this replica" >&2
    return 11
  fi

  if ! restore_bundle_to_pvc "$ns" "$pvc" "$bundle_dir" "$preferred_node"; then
    echo "Warning: failed to restore ${ns}/${pvc} from ${bundle_dir}; skipping this replica" >&2
    return 11
  fi

  return 0
}

export_bundle_from_pvc() {
  local ns="$1"
  local sts="$2"
  local ordinal="$3"
  local output_dir="$4"
  local preferred_node="${5:-}"
  local pvc="keybundle-${sts}-${ordinal}"
  local item_dir="$output_dir/$ns/$sts/$ordinal"
  local bundle_dir="$item_dir/bundle"
  local helper_pod="kubeton-backup-${sts}-${ordinal}-$RANDOM-$RANDOM"
  local node_constraints_yaml=""
  local publication_state

  node_constraints_yaml="$(helper_pod_node_constraints_yaml "$preferred_node")"

  if ! kubectl -n "$ns" get pvc "$pvc" >/dev/null 2>&1; then
    echo "Warning: missing PVC ${ns}/${pvc}, skipping"
    return 0
  fi

  mkdir -p "$bundle_dir"

  cat <<EOF | kubectl -n "$ns" apply -f - >/dev/null
apiVersion: v1
kind: Pod
metadata:
  name: ${helper_pod}
spec:
${node_constraints_yaml}
  restartPolicy: Never
  containers:
    - name: backup
      image: busybox:1.36
      command: ["sh", "-c", "sleep 3600"]
      volumeMounts:
        - name: keybundle
          mountPath: /bundle
          readOnly: true
  volumes:
    - name: keybundle
      persistentVolumeClaim:
        claimName: ${pvc}
        readOnly: true
EOF

  if ! kubectl -n "$ns" wait --for=condition=Ready "pod/${helper_pod}" --timeout="${HELPER_POD_READY_TIMEOUT}" >/dev/null; then
    print_helper_pod_failure_context "$ns" "$helper_pod"
    kubectl -n "$ns" delete pod "$helper_pod" --ignore-not-found >/dev/null 2>&1 || true
    echo "Error: helper pod ${ns}/${helper_pod} did not become Ready." >&2
    return 1
  fi

  if ! publication_state="$(kubectl -n "$ns" exec "$helper_pod" -- sh -ec '
    if [ -e /bundle/.backup-publish ] || [ -L /bundle/.backup-publish ]; then
      printf pending
    else
      printf ready
    fi
  ')"; then
    kubectl -n "$ns" delete pod "$helper_pod" --ignore-not-found >/dev/null 2>&1 || true
    echo "Error: cannot inspect backup publication state on ${ns}/${pvc}; the encrypted bundle was not exported." >&2
    return 1
  fi
  if [[ "$publication_state" != ready ]]; then
    kubectl -n "$ns" delete pod "$helper_pod" --ignore-not-found >/dev/null 2>&1 || true
    echo "Error: refusing to export ${ns}/${pvc} while .backup-publish is unresolved; run or restart the TON pod's key-backup container to recover publication, then retry backup-keys." >&2
    return 1
  fi

  if ! kubectl -n "$ns" cp "${helper_pod}:/bundle/." "$bundle_dir" >/dev/null; then
    kubectl -n "$ns" delete pod "$helper_pod" --ignore-not-found >/dev/null 2>&1 || true
    echo "Error: failed to copy encrypted bundle from ${ns}/${helper_pod}." >&2
    return 1
  fi

  if find "$bundle_dir" -type f -print -quit | grep -q .; then
    if ! (cd "$item_dir" && find bundle -type f -print0 | sort -z | xargs -0 sha256sum > SHA256SUMS); then
      kubectl -n "$ns" delete pod "$helper_pod" --ignore-not-found >/dev/null 2>&1 || true
      echo "Error: failed to write SHA256SUMS for ${ns}/${sts}/${ordinal}." >&2
      return 1
    fi
  else
    echo "Warning: ${ns}/${pvc} bundle directory is empty"
  fi

  kubectl -n "$ns" delete pod "$helper_pod" --ignore-not-found >/dev/null 2>&1 || true
  return 0
}

dash_line() {
  local width="$1"
  printf '%*s' "$width" '' | tr ' ' '-'
}

print_aligned_table_3col() {
  local h1="$1"
  local h2="$2"
  local h3="$3"
  shift 3
  local -a rows=("$@")
  local w1=${#h1}
  local w2=${#h2}
  local w3=${#h3}
  local row c1 c2 c3

  for row in "${rows[@]}"; do
    IFS=$'\t' read -r c1 c2 c3 <<<"$row"
    (( ${#c1} > w1 )) && w1=${#c1}
    (( ${#c2} > w2 )) && w2=${#c2}
    (( ${#c3} > w3 )) && w3=${#c3}
  done

  printf "| %-*s | %-*s | %-*s |\n" "$w1" "$h1" "$w2" "$h2" "$w3" "$h3"
  printf "|-%s-|-%s-|-%s-|\n" "$(dash_line "$w1")" "$(dash_line "$w2")" "$(dash_line "$w3")"
  for row in "${rows[@]}"; do
    IFS=$'\t' read -r c1 c2 c3 <<<"$row"
