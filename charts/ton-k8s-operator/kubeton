  replicas: 1
  strategy:
    type: Recreate
    rollingUpdate: null
  selector:
    matchLabels:
      app.kubernetes.io/name: kubeton-prometheus
      app.kubernetes.io/instance: ${deploy_name}
  template:
    metadata:
      labels:
        app.kubernetes.io/name: kubeton-prometheus
        app.kubernetes.io/instance: ${deploy_name}
        app.kubernetes.io/managed-by: kubeton
      annotations:
        ton.ton.org/exporter-address: ${exporter_address}
        ton.ton.org/auth-secret-version: $(yaml_quote "$auth_revision")
    spec:
      containers:
        - name: prometheus
          image: ${PROMETHEUS_IMAGE}
          imagePullPolicy: IfNotPresent
          args:
            - --config.file=/etc/prometheus/prometheus.yml
            - --storage.tsdb.path=/prometheus
            - --web.listen-address=:${PROMETHEUS_PORT}
            - --web.config.file=/etc/prometheus-auth/web-config.yml
          ports:
            - name: http
              containerPort: ${PROMETHEUS_PORT}
              protocol: TCP
          readinessProbe:
            tcpSocket:
              port: http
            initialDelaySeconds: 2
