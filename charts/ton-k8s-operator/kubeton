resolve_victoria_logs_helm_timeout_seconds() {
  local timeout_seconds
  timeout_seconds="$(trim_whitespace "${VICTORIA_LOGS_HELM_TIMEOUT_SECONDS:-600}")"
  if ! [[ "$timeout_seconds" =~ ^[0-9]+$ ]] || (( timeout_seconds < 60 )); then
    timeout_seconds=600
  fi
  printf '%s' "$timeout_seconds"
}

read_victoria_logs_state_value() {
  local ns="$1"
  local key="$2"

  kubectl -n "$ns" get configmap "$VICTORIA_LOGS_STATE_CONFIGMAP" \
    -o jsonpath="{.data.${key}}" 2>/dev/null \
    || true
}

victoria_logs_state_record_name() {
  local logs_namespace="$1"
  local release_name="$2"
  local collector_release_name="$3"
  local safe_namespace safe_release checksum

  safe_namespace="$(printf '%s' "$logs_namespace" | tr '[:upper:]' '[:lower:]' | sed -E 's/[^a-z0-9.-]+/-/g; s/^[.-]+//; s/[.-]+$//')"
  safe_release="$(printf '%s' "$release_name" | tr '[:upper:]' '[:lower:]' | sed -E 's/[^a-z0-9.-]+/-/g; s/^[.-]+//; s/[.-]+$//')"
  [[ -n "$safe_namespace" && -n "$safe_release" ]] || return 1
  checksum="$(printf '%s\t%s\t%s' "$logs_namespace" "$release_name" "$collector_release_name" | cksum | awk '{print $1}')"
  [[ "$checksum" =~ ^[0-9]+$ ]] || return 1
  printf 'kubeton-vlogs-state-%.40s-%.40s-%s' "$safe_namespace" "$safe_release" "$checksum"
}

write_victoria_logs_state() {
  local state_ns="$1"
  local logs_namespace="$2"
  local release_name="$3"
  local collector_release_name="$4"
  local service_name="$5"
  local collector_daemonset="$6"
  local collector_buffer_path record_name target_state_ns eligible_nodes_csv
  local -a state_namespaces=()

  if ! collector_buffer_path="$(victoria_logs_collector_buffer_path "$logs_namespace" "$collector_release_name")"; then
    echo "Error: cannot persist an invalid VictoriaLogs collector buffer path." >&2
    return 1
  fi
  if ! record_name="$(victoria_logs_state_record_name "$logs_namespace" "$release_name" "$collector_release_name")"; then
    echo "Error: cannot derive a VictoriaLogs state-ledger record name." >&2
    return 1
  fi
  eligible_nodes_csv="$(victoria_logs_eligible_nodes_csv)"

  state_namespaces+=("$state_ns")
  if [[ "$logs_namespace" != "$state_ns" ]]; then
    # Mirror the small non-secret cleanup ledger beside the logging resources.
    # It survives removal of the operator namespace when backend cleanup is
    # intentionally blocked, while the operator-namespace copy lets a plain
    # uninstall discover a custom logs namespace in the first place.
    state_namespaces+=("$logs_namespace")
  fi
  for target_state_ns in "${state_namespaces[@]}"; do
    if ! ensure_namespace "$target_state_ns"; then
      echo "Error: failed to ensure VictoriaLogs state namespace ${target_state_ns}." >&2
      return 1
    fi
    # Keep a canonical latest record for existing readers and an immutable
    # identity-specific record. Changing custom release names cannot overwrite
    # the only cleanup provenance for a previous or partially installed stack.
    if ! cat <<EOF | kubectl -n "$target_state_ns" apply -f - >/dev/null
apiVersion: v1
kind: ConfigMap
metadata:
  name: ${VICTORIA_LOGS_STATE_CONFIGMAP}
  labels:
    app.kubernetes.io/name: kubeton-victoria-logs
    app.kubernetes.io/managed-by: kubeton
    app.kubernetes.io/part-of: kubeton-victoria-logs
data:
  namespace: $(yaml_quote "$logs_namespace")
  releaseName: $(yaml_quote "$release_name")
  collectorReleaseName: $(yaml_quote "$collector_release_name")
  serviceName: $(yaml_quote "$service_name")
  collectorDaemonSet: $(yaml_quote "$collector_daemonset")
  collectorBufferPath: $(yaml_quote "$collector_buffer_path")
  eligibleNodes: $(yaml_quote "$eligible_nodes_csv")
  backendNodeSelector: $(yaml_quote "$(trim_whitespace "${VICTORIA_LOGS_NODE_SELECTOR:-}")")
  collectorNodeSelector: $(yaml_quote "$(trim_whitespace "${VICTORIA_LOGS_COLLECTOR_NODE_SELECTOR:-}")")
---
apiVersion: v1
kind: ConfigMap
metadata:
  name: ${record_name}
  labels:
    app.kubernetes.io/name: kubeton-victoria-logs
    app.kubernetes.io/managed-by: kubeton
    app.kubernetes.io/part-of: kubeton-victoria-logs
data:
  namespace: $(yaml_quote "$logs_namespace")
  releaseName: $(yaml_quote "$release_name")
  collectorReleaseName: $(yaml_quote "$collector_release_name")
  serviceName: $(yaml_quote "$service_name")
  collectorDaemonSet: $(yaml_quote "$collector_daemonset")
  collectorBufferPath: $(yaml_quote "$collector_buffer_path")
  eligibleNodes: $(yaml_quote "$eligible_nodes_csv")
  backendNodeSelector: $(yaml_quote "$(trim_whitespace "${VICTORIA_LOGS_NODE_SELECTOR:-}")")
  collectorNodeSelector: $(yaml_quote "$(trim_whitespace "${VICTORIA_LOGS_COLLECTOR_NODE_SELECTOR:-}")")
EOF
    then
      echo "Error: failed to persist VictoriaLogs state in namespace ${target_state_ns}." >&2
      return 1
    fi
  done
}

resolve_victoria_metrics_rollout_timeout_seconds() {
  local timeout_seconds
  timeout_seconds="$(trim_whitespace "${VICTORIA_METRICS_ROLLOUT_TIMEOUT_SECONDS:-300}")"
  if ! [[ "$timeout_seconds" =~ ^[0-9]+$ ]] || (( timeout_seconds < 60 )); then
    timeout_seconds=300
  fi
  printf '%s' "$timeout_seconds"
}

resolve_victoria_metrics_operator_version() {
  local configured version redirect_url

  configured="$(trim_whitespace "${VM_OPERATOR_VERSION:-}")"
  if [[ -n "$configured" ]]; then
    printf '%s' "$configured"
    return 0
  fi

  if ! command -v curl >/dev/null 2>&1; then
    echo "Error: VM_OPERATOR_VERSION is empty and curl is required to resolve VictoriaMetrics operator latest release." >&2
    return 1
  fi

  redirect_url="$(curl -fs -o /dev/null -w '%{redirect_url}' https://github.com/VictoriaMetrics/operator/releases/latest || true)"
  redirect_url="$(trim_whitespace "$redirect_url")"
  if [[ -z "$redirect_url" ]]; then
    redirect_url="$(curl -fsSL -o /dev/null -w '%{url_effective}' https://github.com/VictoriaMetrics/operator/releases/latest || true)"
    redirect_url="$(trim_whitespace "$redirect_url")"
  fi
  version="${redirect_url##*/}"
  version="$(trim_whitespace "$version")"
  if [[ -z "$version" || "$version" == "latest" ]]; then
    echo "Error: failed to resolve VictoriaMetrics operator latest release tag. Set VM_OPERATOR_VERSION explicitly." >&2
    return 1
  fi
  printf '%s' "$version"
}

victoria_metrics_operator_manifest_url() {
  local version="$1"
  printf '%s' "https://github.com/VictoriaMetrics/operator/releases/download/${version}/${VICTORIA_METRICS_OPERATOR_INSTALL_MANIFEST}"
}

read_victoria_metrics_state_value() {
  local ns="$1"
  local key="$2"

  kubectl -n "$ns" get configmap "$VICTORIA_METRICS_STATE_CONFIGMAP" \
    -o jsonpath="{.data.${key}}" 2>/dev/null \
    || true
}

write_victoria_metrics_state() {
  local state_ns="$1"
  local stack_name="$2"
  local stack_namespace="$3"
  local operator_namespace="$4"
  local operator_version="$5"
  local operator_manifest_url="$6"

  ensure_namespace "$state_ns"
  cat <<EOF | kubectl -n "$state_ns" apply -f - >/dev/null
apiVersion: v1
kind: ConfigMap
metadata:
  name: ${VICTORIA_METRICS_STATE_CONFIGMAP}
  labels:
    app.kubernetes.io/name: kubeton-victoria-metrics
    app.kubernetes.io/managed-by: kubeton
    app.kubernetes.io/part-of: kubeton-victoria-metrics
data:
  stackName: $(yaml_quote "$stack_name")
  stackNamespace: $(yaml_quote "$stack_namespace")
  operatorNamespace: $(yaml_quote "$operator_namespace")
  operatorVersion: $(yaml_quote "$operator_version")
  operatorManifestUrl: $(yaml_quote "$operator_manifest_url")
EOF
}

ensure_victoria_metrics_operator() {
  local operator_ns="$1"
  local stack_name="$2"
  local version manifest_url timeout_seconds

  version="$(resolve_victoria_metrics_operator_version)" || return 1
  manifest_url="$(victoria_metrics_operator_manifest_url "$version")"
  timeout_seconds="$(resolve_victoria_metrics_rollout_timeout_seconds)"

  echo "[victoria-metrics] Installing/updating VictoriaMetrics operator (${version}) ..." >&2
  if ! kubectl apply -f "$manifest_url" >/dev/null; then
    echo "Error: failed to apply VictoriaMetrics operator manifest ${manifest_url}." >&2
    return 1
  fi

  if ! kubectl -n "$operator_ns" rollout status "deployment/${VICTORIA_METRICS_OPERATOR_DEPLOYMENT}" --timeout="${timeout_seconds}s" >/dev/null 2>&1; then
    echo "Warning: VictoriaMetrics operator deployment ${operator_ns}/${VICTORIA_METRICS_OPERATOR_DEPLOYMENT} is not Ready yet." >&2
  fi

  printf '%s\t%s\n' "$version" "$manifest_url"
}

wait_victoria_metrics_cr_operational() {
  local ns="$1"
  local kind="$2"
  local name="$3"
  local timeout_seconds="$4"

  if ! kubectl -n "$ns" wait --for=jsonpath='{.status.updateStatus}'=operational "${kind}/${name}" --timeout="${timeout_seconds}s" >/dev/null 2>&1; then
    echo "Warning: ${kind}/${name} in namespace ${ns} did not reach status.updateStatus=operational within ${timeout_seconds}s." >&2
  fi
}

ensure_victoria_metrics_stack() {
  local ns="$1"
  local stack_name="$2"
  local auth_username="$3"
  local auth_password="$4"
  local timeout_seconds="$5"
  local logs_auth_static_url="${6:-}"
  local password_spec_line
  local remote_write_url logs_auth_target_block=""

  if [[ -z "$auth_username" ]]; then
    auth_username="$stack_name"
  fi
  remote_write_url="http://vmsingle-${stack_name}.${ns}.svc:8428/api/v1/write"
  if [[ -n "$auth_password" ]]; then
    password_spec_line="  password: $(yaml_quote "$auth_password")"
  else
    password_spec_line="  generatePassword: true"
  fi
  if [[ -n "$logs_auth_static_url" ]]; then
    logs_auth_target_block="$(cat <<EOB
    - static:
        url: $(yaml_quote "$logs_auth_static_url")
      paths:
        - "/select/.*"
EOB
)"
  fi

  cat <<EOF | kubectl -n "$ns" apply -f - >/dev/null
apiVersion: operator.victoriametrics.com/v1beta1
kind: VMSingle
metadata:
  name: ${stack_name}
  labels:
    app.kubernetes.io/name: kubeton-victoria-metrics
    app.kubernetes.io/component: storage
    app.kubernetes.io/managed-by: kubeton
    app.kubernetes.io/part-of: kubeton-victoria-metrics
---
apiVersion: operator.victoriametrics.com/v1beta1
kind: VMAgent
metadata:
  name: ${stack_name}
  labels:
    app.kubernetes.io/name: kubeton-victoria-metrics
    app.kubernetes.io/component: agent
    app.kubernetes.io/managed-by: kubeton
    app.kubernetes.io/part-of: kubeton-victoria-metrics
spec:
  selectAllByDefault: true
  remoteWrite:
    - url: $(yaml_quote "$remote_write_url")
---
apiVersion: operator.victoriametrics.com/v1beta1
kind: VMAuth
metadata:
  name: ${stack_name}
  labels:
    app.kubernetes.io/name: kubeton-victoria-metrics
    app.kubernetes.io/component: auth
    app.kubernetes.io/managed-by: kubeton
    app.kubernetes.io/part-of: kubeton-victoria-metrics
spec:
  selectAllByDefault: true
---
apiVersion: operator.victoriametrics.com/v1beta1
kind: VMUser
metadata:
  name: ${stack_name}
  labels:
    app.kubernetes.io/name: kubeton-victoria-metrics-user
    app.kubernetes.io/managed-by: kubeton
    app.kubernetes.io/part-of: kubeton-victoria-metrics
spec:
  name: $(yaml_quote "$auth_username")
  username: $(yaml_quote "$auth_username")
${password_spec_line}
  targetRefs:
    - crd:
        kind: VMSingle
        name: ${stack_name}
        namespace: ${ns}
      paths:
        - "/vmui.*"
        - "/prometheus/.*"
        - "/api/v1/.*"
    - crd:
        kind: VMAgent
        name: ${stack_name}
        namespace: ${ns}
      paths:
        - "/targets"
        - "/targets/.*"
${logs_auth_target_block}
EOF

  wait_victoria_metrics_cr_operational "$ns" "vmsingle" "$stack_name" "$timeout_seconds"
  wait_victoria_metrics_cr_operational "$ns" "vmagent" "$stack_name" "$timeout_seconds"
  wait_victoria_metrics_cr_operational "$ns" "vmauth" "$stack_name" "$timeout_seconds"
  wait_victoria_metrics_cr_operational "$ns" "vmuser" "$stack_name" "$timeout_seconds"
}

resolve_victoria_metrics_auth_service_name() {
  local ns="$1"
  local stack_name="$2"
  local service_name=""

  if kubectl -n "$ns" get service "vmauth-${stack_name}" >/dev/null 2>&1; then
    printf '%s' "vmauth-${stack_name}"
    return 0
  fi

  service_name="$(kubectl -n "$ns" get svc -l 'app.kubernetes.io/name=vmauth' -o jsonpath='{.items[0].metadata.name}' 2>/dev/null || true)"
  service_name="$(trim_whitespace "$service_name")"
  if [[ -n "$service_name" ]]; then
    printf '%s' "$service_name"
    return 0
  fi
  return 1
}

resolve_victoria_metrics_credentials() {
  local ns="$1"
  local stack_name="$2"
  local default_username="$3"
  local default_password="$4"
  local request_timeout="${5:-${STATUS_EXEC_TIMEOUT:-20s}}"
  local secret_name username password

  secret_name="vmuser-${stack_name}"
  if kubectl -n "$ns" get secret "$secret_name" --request-timeout="$request_timeout" >/dev/null 2>&1; then
    username="$(kubectl -n "$ns" get secret "$secret_name" -o jsonpath='{.data.username}' --request-timeout="$request_timeout" 2>/dev/null | base64 -d 2>/dev/null || true)"
    password="$(kubectl -n "$ns" get secret "$secret_name" -o jsonpath='{.data.password}' --request-timeout="$request_timeout" 2>/dev/null | base64 -d 2>/dev/null || true)"
    if [[ -n "$username" && -n "$password" ]]; then
      printf '%s\t%s\t%s\n' "$secret_name" "$username" "$password"
      return 0
    fi
  fi

  default_username="$(trim_whitespace "$default_username")"
  default_password="$(trim_whitespace "$default_password")"
  if [[ -n "$default_username" && -n "$default_password" ]]; then
    printf '%s\t%s\t%s\n' "$secret_name" "$default_username" "$default_password"
    return 0
  fi

  echo "Error: failed to resolve VictoriaMetrics credentials from secret ${ns}/${secret_name}." >&2
  return 1
}

ensure_victoria_metrics_scrape_resources() {
  local output_rows_array_name="${1:-}"
  local -a custom_rows=()
  local -a configured_rows=()
  local row ns tonnode_name custom_parameters exporter_address exporter_port
  local service_name scrape_name service_suffix
  local matched_count=0

  mapfile -t custom_rows < <(resolve_tonnode_custom_parameters_rows 2>/dev/null || true)
  for row in "${custom_rows[@]}"; do
    [[ -z "$row" ]] && continue
    IFS=$'\t' read -r ns tonnode_name custom_parameters <<<"$row"
    ns="$(trim_whitespace "$ns")"
    tonnode_name="$(trim_whitespace "$tonnode_name")"
    custom_parameters="$(trim_whitespace "$custom_parameters")"
    if [[ -z "$ns" || -z "$tonnode_name" || -z "$custom_parameters" || "$custom_parameters" == "<no value>" ]]; then
      continue
    fi

    exporter_address="$(extract_exporter_address "$custom_parameters")"
    if [[ -z "$exporter_address" ]]; then
      continue
    fi
    ((matched_count+=1))
    exporter_port="$(extract_exporter_port "$exporter_address")"
    if ! [[ "$exporter_port" =~ ^[0-9]+$ ]]; then
      echo "Warning: ignoring invalid --exporter-address '${exporter_address}' from TonNode ${ns}/${tonnode_name} for VictoriaMetrics scraping." >&2
      continue
    fi

    service_suffix="$(sanitize_k8s_name_fragment "$tonnode_name")"
    service_name="kubeton-vm-target-${service_suffix}"
    scrape_name="${service_name}-scrape"

    if ! cat <<EOF | kubectl -n "$ns" apply -f - >/dev/null
apiVersion: v1
kind: Service
metadata:
  name: ${service_name}
  labels:
    app.kubernetes.io/name: kubeton-victoria-metrics-target
    app.kubernetes.io/instance: ${service_name}
    app.kubernetes.io/managed-by: kubeton
    app.kubernetes.io/part-of: kubeton-victoria-metrics
    ton.ton.org/tonnode: ${tonnode_name}
  annotations:
    ton.ton.org/exporter-address: $(yaml_quote "$exporter_address")
spec:
  selector:
    app.kubernetes.io/name: ton-node
    app.kubernetes.io/instance: ${tonnode_name}
  ports:
    - name: metrics
      protocol: TCP
      port: ${exporter_port}
      targetPort: ${exporter_port}
---
apiVersion: operator.victoriametrics.com/v1beta1
kind: VMServiceScrape
metadata:
  name: ${scrape_name}
  labels:
    app.kubernetes.io/name: kubeton-victoria-metrics-target
    app.kubernetes.io/instance: ${service_name}
    app.kubernetes.io/managed-by: kubeton
    app.kubernetes.io/part-of: kubeton-victoria-metrics
    ton.ton.org/tonnode: ${tonnode_name}
  annotations:
    ton.ton.org/exporter-address: $(yaml_quote "$exporter_address")
spec:
  selector:
    matchLabels:
      app.kubernetes.io/name: kubeton-victoria-metrics-target
      app.kubernetes.io/instance: ${service_name}
  endpoints:
    - port: metrics
      path: /metrics
      interval: 15s
EOF
    then
      echo "Warning: failed to create VictoriaMetrics scrape resources for TonNode ${ns}/${tonnode_name}." >&2
      continue
    fi
    kubectl -n "$ns" wait --for=jsonpath='{.status.updateStatus}'=operational "vmservicescrape/${scrape_name}" --timeout=120s >/dev/null 2>&1 || true
    configured_rows+=("${ns}"$'\t'"${service_name}"$'\t'"${scrape_name}"$'\t'"${exporter_address}")
  done

  if [[ -n "$output_rows_array_name" ]]; then
    local -n output_rows_ref="$output_rows_array_name"
    output_rows_ref=("${configured_rows[@]}")
  fi

  if [[ ${#configured_rows[@]} -gt 0 ]]; then
    for row in "${configured_rows[@]}"; do
      IFS=$'\t' read -r ns service_name scrape_name exporter_address <<<"$row"
      echo "[victoria-metrics] ${ns}/${scrape_name} -> ${service_name} from --exporter-address ${exporter_address}."
    done
    return 0
  fi

  if (( matched_count == 0 )); then
    if cluster_has_tonnodes; then
      echo "Error: TonNode resources found, but none expose --exporter-address in CUSTOM_PARAMETERS; cannot configure VictoriaMetrics scraping." >&2
      return 1
    fi
    echo "[victoria-metrics] No TonNode resources found yet; skipping TonNode scrape resource creation."
    return 0
  fi

  echo "Error: no VictoriaMetrics scrape resources were created. Check TonNode exporter configuration and pod readiness." >&2
  return 1
}

victoria_metrics_port_forward_address() {
  local configured
  configured="$(trim_whitespace "${VICTORIA_METRICS_PORT_FORWARD_ADDRESS:-}")"
  if [[ -n "$configured" ]]; then
    printf '%s' "$configured"
    return 0
  fi

  printf '%s' "127.0.0.1"
}

wait_victoria_metrics_http_ready() {
  local local_port="$1"
  local verify_seconds="$2"
  local deadline now status_code

  if ! [[ "$verify_seconds" =~ ^[0-9]+$ ]]; then
    verify_seconds=20
  fi
  if (( verify_seconds <= 0 )); then
    return 0
  fi
  if ! command -v curl >/dev/null 2>&1; then
    return 0
  fi

  deadline=$(( $(date +%s) + verify_seconds ))
  while :; do
    status_code="$(curl -sS -o /dev/null --max-time 3 -w '%{http_code}' "http://127.0.0.1:${local_port}/" || true)"
    if [[ "$status_code" == "200" || "$status_code" == "401" || "$status_code" == "403" || "$status_code" == "404" ]]; then
      return 0
    fi

    now="$(date +%s)"
    if (( now >= deadline )); then
      return 1
    fi
    sleep 1
  done
}

ensure_victoria_metrics_port_forward() {
  local ns="$1"
  local service_name="$2"
  local local_port="$3"
  local remote_port="$4"
  local bind_address="${5:-127.0.0.1}"
  local quiet="${6:-false}"
  local state_dir="${VICTORIA_METRICS_PORT_FORWARD_DIR}"
  local wait_seconds="${VICTORIA_METRICS_PORT_FORWARD_WAIT_SECONDS}"
  local verify_seconds="${VICTORIA_METRICS_PORT_FORWARD_VERIFY_SECONDS}"
  local key pid_file log_file existing_pid pf_pid deadline now

  if ! [[ "$local_port" =~ ^[0-9]+$ ]] || ! [[ "$remote_port" =~ ^[0-9]+$ ]]; then
    return 1
  fi
  if ! [[ "$wait_seconds" =~ ^[0-9]+$ ]]; then
    wait_seconds=5
  fi
  if ! [[ "$verify_seconds" =~ ^[0-9]+$ ]]; then
    verify_seconds=20
  fi

  mkdir -p "$state_dir"
  key="$(sanitize_file_name_fragment "${ns}__${service_name}__${local_port}")"
  pid_file="${state_dir}/${key}.pid"
  log_file="${state_dir}/${key}.log"

  if [[ -f "$pid_file" ]]; then
    existing_pid="$(cat "$pid_file" 2>/dev/null || true)"
    if [[ "$existing_pid" =~ ^[0-9]+$ ]] && kill -0 "$existing_pid" >/dev/null 2>&1; then
      if port_forward_process_matches "$existing_pid" "$ns" "$service_name" "$local_port" "$remote_port" "$bind_address"; then
        if wait_victoria_metrics_http_ready "$local_port" 2; then
          printf '%s\t%s\t%s\t%s\t%s\n' "$ns" "$service_name" "$local_port" "$existing_pid" "$log_file"
          return 0
        fi
      fi
      # A saved PID may have been reused. Only replace a process which still
      # forwards this exact endpoint, including when its bind address changes.
      if port_forward_process_matches "$existing_pid" "$ns" "$service_name" "$local_port" "$remote_port" ''; then
        kill "$existing_pid" >/dev/null 2>&1 || true
        deadline=$(( $(date +%s) + wait_seconds ))
        while kill -0 "$existing_pid" >/dev/null 2>&1 \
          && port_forward_process_matches "$existing_pid" "$ns" "$service_name" "$local_port" "$remote_port" ''; do
          if (( $(date +%s) >= deadline )); then
            if [[ "$quiet" != "1" && "$quiet" != "true" ]]; then
              echo "Warning: previous port-forward for ${ns}/${service_name} did not stop before rebinding localhost:${local_port}." >&2
            fi
            return 1
          fi
          sleep 0.1
        done
      fi
    fi
    rm -f "$pid_file" >/dev/null 2>&1 || true
  fi

  nohup kubectl -n "$ns" port-forward --address "$bind_address" "svc/${service_name}" "${local_port}:${remote_port}" >"$log_file" 2>&1 &
  pf_pid="$!"
  echo "$pf_pid" >"$pid_file"

  deadline=$(( $(date +%s) + wait_seconds ))
  while :; do
    if ! kill -0 "$pf_pid" >/dev/null 2>&1; then
      rm -f "$pid_file" >/dev/null 2>&1 || true
      if [[ "$quiet" != "1" && "$quiet" != "true" ]]; then
        echo "Warning: failed to start background port-forward for ${ns}/${service_name} on localhost:${local_port}." >&2
        echo "Warning: see ${log_file}" >&2
      fi
      return 1
    fi
    if grep -q "Forwarding from" "$log_file" 2>/dev/null; then
      if ! wait_victoria_metrics_http_ready "$local_port" "$verify_seconds"; then
        kill "$pf_pid" >/dev/null 2>&1 || true
        rm -f "$pid_file" >/dev/null 2>&1 || true
        if [[ "$quiet" != "1" && "$quiet" != "true" ]]; then
          echo "Warning: port-forward for ${ns}/${service_name} started on localhost:${local_port}, but VictoriaMetrics auth endpoint is not ready." >&2
          echo "Warning: see ${log_file}" >&2
        fi
        return 1
      fi
      if ! kill -0 "$pf_pid" >/dev/null 2>&1 || ! wait_victoria_metrics_http_ready "$local_port" 2; then
        kill "$pf_pid" >/dev/null 2>&1 || true
        rm -f "$pid_file" >/dev/null 2>&1 || true
        if [[ "$quiet" != "1" && "$quiet" != "true" ]]; then
          echo "Warning: port-forward for ${ns}/${service_name} became unavailable immediately after startup on localhost:${local_port}." >&2
          echo "Warning: see ${log_file}" >&2
        fi
        return 1
      fi
      printf '%s\t%s\t%s\t%s\t%s\n' "$ns" "$service_name" "$local_port" "$pf_pid" "$log_file"
      return 0
    fi
    now="$(date +%s)"
    if (( now >= deadline )); then
      kill "$pf_pid" >/dev/null 2>&1 || true
      rm -f "$pid_file" >/dev/null 2>&1 || true
      if [[ "$quiet" != "1" && "$quiet" != "true" ]]; then
        echo "Warning: timed out waiting for port-forward readiness for ${ns}/${service_name} on localhost:${local_port}." >&2
        echo "Warning: see ${log_file}" >&2
      fi
      return 1
    fi
    sleep 1
  done
}

start_victoria_metrics_auth_port_forward() {
  local ns="$1"
  local service_name="$2"
  local base_port="$3"
  local remote_port="$4"
  local bind_address="$5"
  local forward_row attempt quiet_attempt

  if ! [[ "$base_port" =~ ^[0-9]+$ ]]; then
    base_port=8427
  fi

  for ((attempt=0; attempt<25; attempt++)); do
    quiet_attempt="true"
    if (( attempt == 24 )); then
      quiet_attempt="false"
    fi
    if forward_row="$(ensure_victoria_metrics_port_forward "$ns" "$service_name" "$((base_port + attempt))" "$remote_port" "$bind_address" "$quiet_attempt")"; then
      printf '%s' "$forward_row"
      return 0
    fi
  done
  return 1
}

wait_kubectl_proxy_ready() {
  local local_port="$1"
  local verify_seconds="$2"
  local deadline now

  if ! [[ "$verify_seconds" =~ ^[0-9]+$ ]]; then
    verify_seconds=20
  fi
  if (( verify_seconds <= 0 )); then
    return 0
  fi
  if ! command -v curl >/dev/null 2>&1; then
    return 0
  fi

  deadline=$(( $(date +%s) + verify_seconds ))
  while :; do
    if curl -fsS --max-time 3 "http://127.0.0.1:${local_port}/version" >/dev/null 2>&1; then
      return 0
    fi

    now="$(date +%s)"
    if (( now >= deadline )); then
      return 1
    fi
    sleep 1
  done
}

ensure_victoria_metrics_api_proxy() {
  local local_port="$1"
  local state_dir="${VICTORIA_METRICS_PORT_FORWARD_DIR}"
  local wait_seconds="${VICTORIA_METRICS_PORT_FORWARD_WAIT_SECONDS}"
  local verify_seconds="${VICTORIA_METRICS_PORT_FORWARD_VERIFY_SECONDS}"
  local pid_file log_file proxy_pid deadline now

  if ! [[ "$local_port" =~ ^[0-9]+$ ]]; then
    return 1
  fi
  if ! [[ "$wait_seconds" =~ ^[0-9]+$ ]]; then
    wait_seconds=5
  fi
  if ! [[ "$verify_seconds" =~ ^[0-9]+$ ]]; then
    verify_seconds=20
  fi

  mkdir -p "$state_dir"
  pid_file="${state_dir}/proxy-${local_port}.pid"
  log_file="${state_dir}/proxy-${local_port}.log"

  if [[ -f "$pid_file" ]]; then
    proxy_pid="$(cat "$pid_file" 2>/dev/null || true)"
    if [[ "$proxy_pid" =~ ^[0-9]+$ ]] && kill -0 "$proxy_pid" >/dev/null 2>&1; then
      if wait_kubectl_proxy_ready "$local_port" 2; then
        printf '%s\t%s\t%s\n' "$local_port" "$proxy_pid" "$log_file"
        return 0
      fi
      kill "$proxy_pid" >/dev/null 2>&1 || true
    fi
    rm -f "$pid_file" >/dev/null 2>&1 || true
  fi

  if command -v setsid >/dev/null 2>&1; then
    setsid kubectl proxy --disable-filter --address 127.0.0.1 --port "$local_port" >"$log_file" 2>&1 < /dev/null &
  else
    nohup kubectl proxy --disable-filter --address 127.0.0.1 --port "$local_port" >"$log_file" 2>&1 &
  fi
  proxy_pid="$!"
  echo "$proxy_pid" >"$pid_file"

  deadline=$(( $(date +%s) + wait_seconds ))
  while :; do
    if ! kill -0 "$proxy_pid" >/dev/null 2>&1; then
      rm -f "$pid_file" >/dev/null 2>&1 || true
      return 1
    fi
    if wait_kubectl_proxy_ready "$local_port" 1; then
      if ! wait_kubectl_proxy_ready "$local_port" "$verify_seconds"; then
        kill "$proxy_pid" >/dev/null 2>&1 || true
        rm -f "$pid_file" >/dev/null 2>&1 || true
        return 1
      fi
      printf '%s\t%s\t%s\n' "$local_port" "$proxy_pid" "$log_file"
      return 0
    fi
    now="$(date +%s)"
    if (( now >= deadline )); then
      kill "$proxy_pid" >/dev/null 2>&1 || true
      rm -f "$pid_file" >/dev/null 2>&1 || true
      return 1
    fi
    sleep 1
  done
}

ensure_victoria_metrics_nodeport_access_if_enabled() {
  if is_true "$VICTORIA_METRICS_NODEPORT_ENABLED"; then
    ensure_victoria_metrics_nodeport_access "$@"
  else
    echo "[victoria-metrics] Public NodePort access is disabled; use the local proxy or kubeton logs expose for the dashboard."
  fi
}

ensure_victoria_metrics_nodeport_access() {
  local ns="$1"
  local stack_name="$2"
  local remote_port="$3"
  local service_name="kubeton-vmauth-nodeport-${stack_name}"
  local node_port
  local -a node_ip_rows=()
  local row node_name node_ip ip_source
  local printed=0
  local -A seen_ip=()

  if ! [[ "$remote_port" =~ ^[0-9]+$ ]]; then
    remote_port=8427
  fi

  if ! cat <<EOF | kubectl -n "$ns" apply -f - >/dev/null
apiVersion: v1
kind: Service
metadata:
  name: ${service_name}
  labels:
    app.kubernetes.io/name: kubeton-victoria-metrics-access
    app.kubernetes.io/managed-by: kubeton
    app.kubernetes.io/part-of: kubeton-victoria-metrics
spec:
  type: NodePort
  selector:
    app.kubernetes.io/name: vmauth
    app.kubernetes.io/instance: ${stack_name}
  ports:
    - name: http
      protocol: TCP
      port: ${remote_port}
      targetPort: ${remote_port}
EOF
  then
    echo "Warning: failed to create VictoriaMetrics NodePort access Service ${ns}/${service_name}." >&2
    return 1
  fi

  node_port="$(kubectl -n "$ns" get service "$service_name" -o jsonpath='{.spec.ports[0].nodePort}' 2>/dev/null || true)"
  node_port="$(trim_whitespace "$node_port")"
  if ! [[ "$node_port" =~ ^[0-9]+$ ]]; then
    echo "Warning: failed to resolve NodePort for VictoriaMetrics access service ${ns}/${service_name}." >&2
    return 1
  fi
  echo "[victoria-metrics] NodePort service: ${ns}/${service_name} (${node_port})"

  mapfile -t node_ip_rows < <(list_node_external_ip_rows)
  for row in "${node_ip_rows[@]}"; do
    [[ -z "$row" ]] && continue
    IFS=$'\t' read -r node_name node_ip ip_source <<<"$row"
    node_name="$(trim_whitespace "$node_name")"
    node_ip="$(trim_whitespace "$node_ip")"
    ip_source="$(trim_whitespace "$ip_source")"
    [[ -z "$node_ip" ]] && continue
    if [[ -n "${seen_ip[$node_ip]:-}" ]]; then
      continue
    fi
    seen_ip["$node_ip"]=1
    ((printed+=1))
    echo "[victoria-metrics] NodePort VMUI access (${ip_source} ${node_name}): http://${node_ip}:${node_port}/vmui/"
    echo "[victoria-metrics] NodePort targets access (${ip_source} ${node_name}): http://${node_ip}:${node_port}/targets"
    echo "[victoria-metrics] NodePort VictoriaLogs VMUI access (${ip_source} ${node_name}, auth via VMAuth): http://${node_ip}:${node_port}/select/vmui/"
    echo "[victoria-metrics] NodePort VictoriaLogs query API (${ip_source} ${node_name}, auth via VMAuth): http://${node_ip}:${node_port}/select/logsql/query"
  done

  if (( printed == 0 )); then
    echo "[victoria-metrics] NodePort VMUI access: <node-ip>:${node_port}/vmui/"
    echo "[victoria-metrics] NodePort targets access: <node-ip>:${node_port}/targets"
    echo "[victoria-metrics] NodePort VictoriaLogs VMUI access (auth via VMAuth): <node-ip>:${node_port}/select/vmui/"
    echo "[victoria-metrics] NodePort VictoriaLogs query API (auth via VMAuth): <node-ip>:${node_port}/select/logsql/query"
  fi
}

ensure_victoria_logs_access_service() {
  local ns="$1"
  local release_name="$2"
  local collector_release_name="$3"
  local remote_port="$4"
  local service_name network_policy_name auth_namespace auth_stack_name

  if ! [[ "$remote_port" =~ ^[0-9]+$ ]]; then
    remote_port=9428
  fi
  service_name="$(victoria_logs_access_service_name "$release_name")"
  network_policy_name="${service_name}-ingress"
  auth_namespace="$(trim_whitespace "${VICTORIA_METRICS_NAMESPACE:-vm}")"
  [[ -n "$auth_namespace" ]] || auth_namespace="vm"
  auth_stack_name="$(victoria_metrics_stack_name)"

  # The Service is used by vlagent for ingestion and by VMAuth for queries,
  # but the backend itself has no authentication. Isolate it so arbitrary
  # in-cluster Pods cannot bypass VMAuth and query collected logs directly.
  if is_true "$VICTORIA_LOGS_NETWORK_POLICY_ENABLED"; then
    if ! cat <<EOF | kubectl -n "$ns" apply -f - >/dev/null
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: ${network_policy_name}
  labels:
    app.kubernetes.io/name: kubeton-victoria-logs-access
    app.kubernetes.io/managed-by: kubeton
    app.kubernetes.io/part-of: kubeton-victoria-logs
spec:
  podSelector:
    matchLabels:
      app: server
      app.kubernetes.io/instance: ${release_name}
      app.kubernetes.io/name: victoria-logs-single
  policyTypes:
    - Ingress
  ingress:
    - from:
        - podSelector:
            matchLabels:
              app.kubernetes.io/instance: ${collector_release_name}
              app.kubernetes.io/name: victoria-logs-collector
        - namespaceSelector:
            matchLabels:
              kubernetes.io/metadata.name: ${auth_namespace}
          podSelector:
            matchLabels:
              app.kubernetes.io/instance: ${auth_stack_name}
              app.kubernetes.io/name: vmauth
      ports:
        - protocol: TCP
          port: http
EOF
    then
      echo "Error: failed to protect VictoriaLogs backend ${ns}/${release_name} with NetworkPolicy ${network_policy_name}." >&2
      return 1
    fi
  else
    echo "Warning: VICTORIA_LOGS_NETWORK_POLICY_ENABLED=false; the unauthenticated VictoriaLogs backend is reachable by other in-cluster Pods." >&2
    if ! kubectl -n "$ns" delete networkpolicy "$network_policy_name" --ignore-not-found >/dev/null; then
      echo "Error: failed to remove disabled VictoriaLogs NetworkPolicy ${ns}/${network_policy_name}." >&2
      return 1
    fi
  fi

  if ! cat <<EOF | kubectl -n "$ns" apply -f - >/dev/null
apiVersion: v1
kind: Service
metadata:
  name: ${service_name}
  labels:
    app.kubernetes.io/name: kubeton-victoria-logs-access
    app.kubernetes.io/managed-by: kubeton
    app.kubernetes.io/part-of: kubeton-victoria-logs
spec:
  type: ClusterIP
  selector:
    app: server
    app.kubernetes.io/instance: ${release_name}
    app.kubernetes.io/name: victoria-logs-single
  ports:
    - name: http
      protocol: TCP
      port: ${remote_port}
      targetPort: http
EOF
  then
    echo "Error: failed to create VictoriaLogs access Service ${ns}/${service_name}." >&2
    return 1
  fi
  printf '%s' "$service_name"
}

victoria_logs_collector_buffer_path() {
  local ns="$1"
  local collector_release_name="$2"
  local safe_ns safe_release

  # Namespace and Helm release names are DNS labels already. Preserve their
  # complete identities here rather than applying the generic 30-character
  # name truncation, which could make two releases share a host buffer.
  safe_ns="$(printf '%s' "$ns" | tr '[:upper:]' '[:lower:]' | sed -E 's/[^a-z0-9.-]+/-/g; s/-+/-/g; s/^[.-]+//; s/[.-]+$//')"
  safe_release="$(printf '%s' "$collector_release_name" | tr '[:upper:]' '[:lower:]' | sed -E 's/[^a-z0-9.-]+/-/g; s/-+/-/g; s/^[.-]+//; s/[.-]+$//')"
  [[ -n "$safe_ns" && -n "$safe_release" ]] || return 1
  printf '/var/lib/kubeton-vlogs-buffer-%s-%s' "$safe_ns" "$safe_release"
}

victoria_logs_collector_exclude_filter() {
  local pod_name='"kubernetes.pod_name"'
  local app='"kubernetes.pod_labels.app.kubernetes.io/name"'
  local managed_by='"kubernetes.pod_labels.app.kubernetes.io/managed-by"'
  local namespace='"kubernetes.pod_namespace"' container='"kubernetes.container_name"'
  local control_plane='"kubernetes.pod_labels.control-plane"' storage_app='"kubernetes.pod_labels.app"'
  local ton_containers storage_apps storage_containers

  # Exclude before reading container files. Helpers can print private keys,
  # and arbitrary workloads/metadata have not been reviewed for collection.
  ton_containers='^(ton-node|prepare-persistent-layout|stage-ton-exporter|export-ton-binaries)$'
  storage_apps='^(longhorn-manager|longhorn-driver-deployer|longhorn-csi-plugin|csi-attacher|csi-provisioner|csi-resizer|csi-snapshotter|instance-manager|engine-image)$'
  storage_containers='^(longhorn-manager|longhorn-driver-deployer|longhorn-csi-plugin|node-driver-registrar|longhorn-liveness-probe|csi-attacher|csi-provisioner|csi-resizer|csi-snapshotter|instance-manager|engine-image(-[a-z0-9-]+)?)$'
  printf '%s:=%%{HOSTNAME} or not ((%s:="ton-node" and %s:="ton-k8s-operator" and %s:~"%s") or (%s:=%s and %s:="controller-manager" and %s:="manager") or (%s:=%s and %s:~"%s" and %s:~"%s"))' \
    "$pod_name" "$app" "$managed_by" "$container" "$ton_containers" \
    "$namespace" "$(json_quote "$OP_NAMESPACE")" "$control_plane" "$container" \
    "$namespace" "$(json_quote "$LONGHORN_NAMESPACE")" "$storage_app" "$storage_apps" "$container" "$storage_containers"
}

install_victoria_logs_collector_release() {
  local ns="$1"
  local collector_release_name="$2"
  local collector_chart="$3"
  local collector_chart_version="$4"
  local remote_write_url="$5"
  local helm_timeout_seconds="$6"
  local collector_node_selector="$7"
  local require_ton_coverage="${8:-true}"
  local collector_buffer_path vlc_selector_values_file="" vlc_affinity_values_file=""
  local -a collector_allowed_nodes=()
  local -a vlc_cmd=()

  if ! collector_buffer_path="$(victoria_logs_collector_buffer_path "$ns" "$collector_release_name")"; then
    echo "Error: cannot derive a safe VictoriaLogs collector host-buffer path for ${ns}/${collector_release_name}." >&2
    return 1
  fi
  if [[ -n "$collector_node_selector" ]]; then
    vlc_selector_values_file="$(build_victoria_logs_collector_selector_values_file "$collector_node_selector")" || return 1
  fi
  if ! victoria_logs_resolve_allowed_nodes "$collector_node_selector" false collector_allowed_nodes; then
    [[ -z "$vlc_selector_values_file" ]] || rm -f "$vlc_selector_values_file" >/dev/null 2>&1 || true
    return 1
  fi
  if is_true "$require_ton_coverage" \
    && ! victoria_logs_validate_ton_nodes_covered collector_allowed_nodes; then
    [[ -z "$vlc_selector_values_file" ]] || rm -f "$vlc_selector_values_file" >/dev/null 2>&1 || true
    return 1
  fi
  vlc_affinity_values_file="$(build_victoria_logs_collector_affinity_values_file collector_allowed_nodes)" || {
    [[ -z "$vlc_selector_values_file" ]] || rm -f "$vlc_selector_values_file" >/dev/null 2>&1 || true
    return 1
  }

  # The release-specific host path survives collector restarts and allows an
  # early collector to queue logs before the VictoriaLogs Service exists.
  # Never share this queue between collector releases.
  vlc_cmd=(helm upgrade --install "$collector_release_name" "$collector_chart" -n "$ns" --create-namespace --timeout "${helm_timeout_seconds}s" \
    --set-string "remoteWrite[0].url=${remote_write_url}" \
    --set-string "remoteWrite[0].maxDiskUsagePerURL=${VICTORIA_LOGS_COLLECTOR_BUFFER_SIZE}" \
    --set-string "collector.excludeFilter=$(victoria_logs_collector_exclude_filter)" \
    --set "collector.includePodLabels=false" \
    --set "collector.includePodAnnotations=false" \
    --set "collector.includeNodeLabels=false" \
    --set "collector.includeNodeAnnotations=false" \
    --set-string "extraArgs.tmpDataPath=${collector_buffer_path}" \
    --set-string "persistence.volume.hostPath.path=${collector_buffer_path}" \
    --set-string "persistence.volume.hostPath.type=DirectoryOrCreate" \
    --set-string "resources.requests.cpu=${VICTORIA_LOGS_COLLECTOR_CPU_REQUEST}" \
    --set-string "resources.requests.memory=${VICTORIA_LOGS_COLLECTOR_MEMORY_REQUEST}" \
    --set-string "resources.requests.ephemeral-storage=${VICTORIA_LOGS_COLLECTOR_EPHEMERAL_STORAGE_REQUEST}" \
    --set-string "resources.limits.cpu=${VICTORIA_LOGS_COLLECTOR_CPU_LIMIT}" \
    --set-string "resources.limits.memory=${VICTORIA_LOGS_COLLECTOR_MEMORY_LIMIT}" \
    --set-string "resources.limits.ephemeral-storage=${VICTORIA_LOGS_COLLECTOR_EPHEMERAL_STORAGE_LIMIT}")
  if [[ -n "$vlc_selector_values_file" ]]; then
    vlc_cmd+=(-f "$vlc_selector_values_file")
  fi
  vlc_cmd+=(-f "$vlc_affinity_values_file")
  if [[ -n "$collector_chart_version" ]]; then
    vlc_cmd+=(--version "$collector_chart_version")
  fi

  echo "[victoria-metrics] Installing/updating VictoriaLogs collector (${collector_release_name}) on preflight-approved node(s): ${collector_allowed_nodes[*]}; host buffer: ${collector_buffer_path}" >&2
  if ! run_with_timeout "${helm_timeout_seconds}s" "${vlc_cmd[@]}" >/dev/null; then
    [[ -z "$vlc_selector_values_file" ]] || rm -f "$vlc_selector_values_file" >/dev/null 2>&1 || true
    rm -f "$vlc_affinity_values_file" >/dev/null 2>&1 || true
    echo "Error: failed to install/upgrade VictoriaLogs collector release ${collector_release_name} in namespace ${ns}." >&2
    return 1
  fi
  [[ -z "$vlc_selector_values_file" ]] || rm -f "$vlc_selector_values_file" >/dev/null 2>&1 || true
  rm -f "$vlc_affinity_values_file" >/dev/null 2>&1 || true
}

ensure_start_victoria_logs_buffering_collector() {
  local require_ton_coverage="${1:-true}"
  local logs_ns logs_release_name collector_release_name remote_port timeout_seconds helm_timeout_seconds
  local repo_name repo_url collector_chart collector_chart_version collector_node_selector
  local access_service remote_write_url collector_daemonset

  if ! is_true "$VICTORIA_LOGS_ENABLED"; then
    return 0
  fi
  if is_true "$require_ton_coverage" && ! is_true "$KUBETON_START_VICTORIA_LOGS_ENABLED"; then
    return 0
  fi
  require_bin helm
  logs_ns="$(victoria_logs_namespace)"
  logs_release_name="$(victoria_logs_release_name)"
  collector_release_name="$(victoria_logs_collector_release_name)"
  remote_port="$(trim_whitespace "${VICTORIA_LOGS_PORT:-9428}")"
  [[ "$remote_port" =~ ^[0-9]+$ ]] || remote_port=9428
  timeout_seconds="$(resolve_victoria_metrics_rollout_timeout_seconds)"
  helm_timeout_seconds="$(resolve_victoria_logs_helm_timeout_seconds)"
  repo_name="$(trim_whitespace "${VICTORIA_LOGS_HELM_REPO_NAME:-vm}")"
  [[ -n "$repo_name" ]] || repo_name=vm
  repo_url="$(trim_whitespace "${VICTORIA_LOGS_HELM_REPO_URL:-https://victoriametrics.github.io/helm-charts}")"
  [[ -n "$repo_url" ]] || repo_url=https://victoriametrics.github.io/helm-charts
  collector_chart="${repo_name}/victoria-logs-collector"
  collector_chart_version="$(trim_whitespace "${VICTORIA_LOGS_COLLECTOR_CHART_VERSION:-}")"
  collector_node_selector="$(trim_whitespace "${VICTORIA_LOGS_COLLECTOR_NODE_SELECTOR:-}")"
  access_service="$(victoria_logs_access_service_name "$logs_release_name")"
  remote_write_url="http://${access_service}:${remote_port}"
  collector_daemonset="$(victoria_logs_collector_daemonset_name "$collector_release_name")"

  echo "[launch] Starting the durable node-log buffer before storage/key bootstrap ..." >&2
  if ! ensure_namespace "$logs_ns"; then
    echo "Error: the pre-bootstrap VictoriaLogs namespace ${logs_ns} could not be ensured; storage/key bootstrap was not started." >&2
    return 1
  fi
  # Persist the intended release identities and exact host-buffer path before
  # Helm runs. A failed/partial custom-named Helm install must remain
  # discoverable by a later plain uninstall even when readiness is never
  # reached. Recording intent is safe when Helm creates no resources: cleanup
  # simply finds nothing under these exact identities.
  if ! write_victoria_logs_state "$OP_NAMESPACE" "$logs_ns" "$logs_release_name" \
      "$collector_release_name" "$access_service" "$collector_daemonset"; then
    echo "Error: the pre-bootstrap VictoriaLogs collector state could not be persisted; storage/key bootstrap was not started." >&2
    return 1
  fi
  if ! ensure_helm_repo "$repo_name" "$repo_url" \
    || ! helm repo update "$repo_name" >/dev/null \
    || ! install_victoria_logs_collector_release "$logs_ns" "$collector_release_name" \
      "$collector_chart" "$collector_chart_version" "$remote_write_url" \
      "$helm_timeout_seconds" "$collector_node_selector" "$require_ton_coverage"; then
    echo "Error: the pre-bootstrap VictoriaLogs collector could not be installed; storage/key bootstrap was not started." >&2
    return 1
  fi
  # The exact Pod-level gate also handles an empty TON selector by requiring a
  # current, owned, non-terminating Ready collector on every DaemonSet target.
  # `kubectl rollout status` alone can briefly accept a Ready Pod which is
  # already terminating.
  if is_true "$require_ton_coverage"; then
    wait_victoria_logs_collector_ready_on_selected_nodes "$logs_ns" "$collector_release_name" \
      "${KUBETON_NODE_CHECK_TON_SELECTOR:-}" "$timeout_seconds" || return 1
  else
    wait_victoria_logs_collector_ready_on_selected_nodes "$logs_ns" "$collector_release_name" \
      "" "$timeout_seconds" || return 1
  fi
  echo "[launch] Pre-bootstrap container-log buffering is active; queued logs will flush when VictoriaLogs becomes available." >&2
}

suspend_existing_owned_victoria_logs_collector() {
  local ns="$1"
  local release_name="$2"
  local daemonset_name ds_row ds_uid managed_by instance app_name helm_release helm_namespace
  local sentinel collision patch timeout_seconds deadline now status_row status_uid generation observed_generation
  local desired_scheduled current_scheduled ready available misscheduled
  local pod_rows pod_row pod_name owner_kind owner_name owner_uid exact_owned_pods

  daemonset_name="$(victoria_logs_collector_daemonset_name "$release_name")"
  if ! ds_row="$(kubectl -n "$ns" get daemonset "$daemonset_name" --ignore-not-found \
      -o go-template='{{.metadata.uid}}{{"\x1f"}}{{with .metadata.labels}}{{index . "app.kubernetes.io/managed-by"}}{{end}}{{"\x1f"}}{{with .metadata.labels}}{{index . "app.kubernetes.io/instance"}}{{end}}{{"\x1f"}}{{with .metadata.labels}}{{index . "app.kubernetes.io/name"}}{{end}}{{"\x1f"}}{{with .metadata.annotations}}{{index . "meta.helm.sh/release-name"}}{{end}}{{"\x1f"}}{{with .metadata.annotations}}{{index . "meta.helm.sh/release-namespace"}}{{end}}' 2>/dev/null)"; then
    echo "Warning: cannot inspect VictoriaLogs collector DaemonSet ${ns}/${daemonset_name} after the conclusive zero-PASS preflight." >&2
    return 1
  fi
  [[ -n "$ds_row" ]] || return 0
  IFS=$'\x1f' read -r ds_uid managed_by instance app_name helm_release helm_namespace <<<"$ds_row"
  if [[ -z "$ds_uid" || "$managed_by" != "Helm" || "$instance" != "$release_name" \
    || "$app_name" != "victoria-logs-collector" || "$helm_release" != "$release_name" \
    || "$helm_namespace" != "$ns" ]]; then
    echo "Warning: refusing to suspend DaemonSet ${ns}/${daemonset_name}: exact VictoriaLogs Helm ownership could not be proven." >&2
    return 1
  fi

  sentinel="kubeton-vlogs-suspended-${ds_uid}"
  if ! collision="$(kubectl get node "$sentinel" --ignore-not-found -o go-template='{{.metadata.name}}' 2>/dev/null)"; then
    echo "Warning: cannot prove that the VictoriaLogs suspension node name '${sentinel}' is unused." >&2
    return 1
  fi
  if [[ -n "$collision" ]]; then
    echo "Warning: refusing to suspend VictoriaLogs collector because node ${sentinel} unexpectedly exists." >&2
    return 1
  fi
  # Bind the suspension mutation to the exact DaemonSet UID proven above. An
  # add operation replaces an existing affinity value and creates a missing
  # one, while the leading test prevents patching a same-name replacement.
  patch="[{\"op\":\"test\",\"path\":\"/metadata/uid\",\"value\":\"${ds_uid}\"},{\"op\":\"add\",\"path\":\"/spec/template/spec/affinity\",\"value\":{\"nodeAffinity\":{\"requiredDuringSchedulingIgnoredDuringExecution\":{\"nodeSelectorTerms\":[{\"matchFields\":[{\"key\":\"metadata.name\",\"operator\":\"In\",\"values\":[\"${sentinel}\"]}]}]}}}}]"
  echo "[launch] No node passed the completed TON preflight; suspending verified VictoriaLogs collector ${ns}/${daemonset_name}." >&2
  if ! kubectl -n "$ns" patch daemonset "$daemonset_name" --type=json -p "$patch" >/dev/null; then
    echo "Warning: failed to apply the no-node affinity to VictoriaLogs collector ${ns}/${daemonset_name}." >&2
    return 1
  fi

  timeout_seconds="$(resolve_victoria_metrics_rollout_timeout_seconds)"
  if ! [[ "$timeout_seconds" =~ ^[0-9]+$ ]] || (( timeout_seconds < 1 )); then
    timeout_seconds=300
  fi
  deadline=$(( $(date +%s) + timeout_seconds ))
  while :; do
    if ! status_row="$(kubectl -n "$ns" get daemonset "$daemonset_name" \
        -o go-template='{{.metadata.uid}}{{"\x1f"}}{{.metadata.generation}}{{"\x1f"}}{{if .status.observedGeneration}}{{.status.observedGeneration}}{{else}}0{{end}}{{"\x1f"}}{{if .status.desiredNumberScheduled}}{{.status.desiredNumberScheduled}}{{else}}0{{end}}{{"\x1f"}}{{if .status.currentNumberScheduled}}{{.status.currentNumberScheduled}}{{else}}0{{end}}{{"\x1f"}}{{if .status.numberReady}}{{.status.numberReady}}{{else}}0{{end}}{{"\x1f"}}{{if .status.numberAvailable}}{{.status.numberAvailable}}{{else}}0{{end}}{{"\x1f"}}{{if .status.numberMisscheduled}}{{.status.numberMisscheduled}}{{else}}0{{end}}' 2>/dev/null)"; then
      echo "Warning: cannot verify VictoriaLogs collector DaemonSet ${ns}/${daemonset_name} after suspension." >&2
      return 1
    fi
    IFS=$'\x1f' read -r status_uid generation observed_generation desired_scheduled current_scheduled ready available misscheduled <<<"$status_row"
    if [[ "$status_uid" != "$ds_uid" || ! "$generation" =~ ^[0-9]+$ || ! "$observed_generation" =~ ^[0-9]+$ \
      || ! "$desired_scheduled" =~ ^[0-9]+$ || ! "$current_scheduled" =~ ^[0-9]+$ \
      || ! "$ready" =~ ^[0-9]+$ || ! "$available" =~ ^[0-9]+$ || ! "$misscheduled" =~ ^[0-9]+$ ]]; then
      echo "Warning: cannot prove the suspended VictoriaLogs collector still has the expected identity and scheduling status." >&2
      return 1
    fi
    if ! pod_rows="$(kubectl -n "$ns" get pods \
        -o go-template='{{range .items}}{{.metadata.name}}{{"\x1f"}}{{range .metadata.ownerReferences}}{{if .controller}}{{.kind}}{{"\x1f"}}{{.name}}{{"\x1f"}}{{.uid}}{{end}}{{end}}{{"\n"}}{{end}}' 2>/dev/null)"; then
      echo "Warning: cannot inventory VictoriaLogs collector Pods owned by ${ns}/${daemonset_name}." >&2
      return 1
    fi
    exact_owned_pods=0
    while IFS= read -r pod_row; do
      [[ -n "$pod_row" ]] || continue
      IFS=$'\x1f' read -r pod_name owner_kind owner_name owner_uid <<<"$pod_row"
      if [[ "$owner_kind" == "DaemonSet" && "$owner_name" == "$daemonset_name" && "$owner_uid" == "$ds_uid" ]]; then
        exact_owned_pods=$((exact_owned_pods + 1))
      fi
    done <<<"$pod_rows"
    if (( observed_generation >= generation && desired_scheduled == 0 && current_scheduled == 0 \
      && ready == 0 && available == 0 && misscheduled == 0 && exact_owned_pods == 0 )); then
      echo "[launch] VictoriaLogs collector is suspended; its Helm release and per-node host buffers were preserved." >&2
      return 0
    fi
    now="$(date +%s)"
    if (( now >= deadline )); then
      echo "Warning: VictoriaLogs collector ${ns}/${daemonset_name} did not fully suspend within ${timeout_seconds}s (desired=${desired_scheduled}, current=${current_scheduled}, ready=${ready}, available=${available}, misscheduled=${misscheduled}, ownedPods=${exact_owned_pods})." >&2
      return 1
    fi
    sleep 2
  done
}

quiesce_existing_owned_victoria_logs_backend() {
  local ns="$1"
  local release_name="$2"
  local service_name sts_row sts_uid managed_by instance app_name helm_release helm_namespace
  local timeout_seconds deadline now status_row status_uid desired_replicas status_replicas current_replicas ready_replicas
  local pod_rows pod_row pod_name owner_kind owner_name owner_uid
  local exact_owned_pods

  service_name="$(victoria_logs_service_name "$release_name")"
  if ! sts_row="$(kubectl -n "$ns" get statefulset "$service_name" --ignore-not-found \
      -o go-template='{{.metadata.uid}}{{"\x1f"}}{{with .metadata.labels}}{{index . "app.kubernetes.io/managed-by"}}{{end}}{{"\x1f"}}{{with .metadata.labels}}{{index . "app.kubernetes.io/instance"}}{{end}}{{"\x1f"}}{{with .metadata.labels}}{{index . "app.kubernetes.io/name"}}{{end}}{{"\x1f"}}{{with .metadata.annotations}}{{index . "meta.helm.sh/release-name"}}{{end}}{{"\x1f"}}{{with .metadata.annotations}}{{index . "meta.helm.sh/release-namespace"}}{{end}}' 2>/dev/null)"; then
    echo "Warning: cannot inspect VictoriaLogs backend StatefulSet ${ns}/${service_name} after the failed TON preflight." >&2
    return 1
  fi
  if [[ -z "$sts_row" ]]; then
    return 0
  fi
  IFS=$'\x1f' read -r sts_uid managed_by instance app_name helm_release helm_namespace <<<"$sts_row"
  if [[ -z "$sts_uid" || "$managed_by" != "Helm" || "$instance" != "$release_name" \
    || "$app_name" != "victoria-logs-single" || "$helm_release" != "$release_name" \
    || "$helm_namespace" != "$ns" ]]; then
    echo "Warning: refusing to scale StatefulSet ${ns}/${service_name}: exact VictoriaLogs Helm ownership could not be proven." >&2
    return 1
  fi

  # The existing template may predate exact PASS-host affinity. Even if a
  # current Pod happens to be on a PASS node, a restart could move it to a
  # rejected node, so failed preflight quiesces the verified backend until the
  # next successful Helm reconciliation applies fresh safe placement.
  echo "[launch] TON preflight failed; scaling verified VictoriaLogs backend ${ns}/${service_name} to zero while collectors retain buffered logs." >&2
  # Make the scale-to-zero decision atomic with the UID/ownership proof above;
  # never mutate a same-name StatefulSet recreated between GET and PATCH.
  if ! kubectl -n "$ns" patch statefulset "$service_name" --type=json \
      -p "[{\"op\":\"test\",\"path\":\"/metadata/uid\",\"value\":\"${sts_uid}\"},{\"op\":\"add\",\"path\":\"/spec/replicas\",\"value\":0}]" >/dev/null; then
    echo "Warning: failed to scale VictoriaLogs backend StatefulSet ${ns}/${service_name} to zero." >&2
    return 1
  fi
  timeout_seconds="$(resolve_victoria_metrics_rollout_timeout_seconds)"
  if ! [[ "$timeout_seconds" =~ ^[0-9]+$ ]] || (( timeout_seconds < 1 )); then
    timeout_seconds=300
  fi
  deadline=$(( $(date +%s) + timeout_seconds ))
  while :; do
    if ! status_row="$(kubectl -n "$ns" get statefulset "$service_name" \
        -o go-template='{{.metadata.uid}}{{"\x1f"}}{{.spec.replicas}}{{"\x1f"}}{{if .status.replicas}}{{.status.replicas}}{{else}}0{{end}}{{"\x1f"}}{{if .status.currentReplicas}}{{.status.currentReplicas}}{{else}}0{{end}}{{"\x1f"}}{{if .status.readyReplicas}}{{.status.readyReplicas}}{{else}}0{{end}}' 2>/dev/null)"; then
      echo "Warning: cannot verify VictoriaLogs backend StatefulSet ${ns}/${service_name} after scaling it to zero." >&2
      return 1
    fi
    IFS=$'\x1f' read -r status_uid desired_replicas status_replicas current_replicas ready_replicas <<<"$status_row"
    if [[ "$status_uid" != "$sts_uid" || ! "$desired_replicas" =~ ^[0-9]+$ \
      || ! "$status_replicas" =~ ^[0-9]+$ || ! "$current_replicas" =~ ^[0-9]+$ \
      || ! "$ready_replicas" =~ ^[0-9]+$ ]]; then
      echo "Warning: cannot prove the scaled VictoriaLogs backend still has the expected identity and replica status." >&2
      return 1
    fi
    if ! pod_rows="$(kubectl -n "$ns" get pods \
        -o go-template='{{range .items}}{{.metadata.name}}{{"\x1f"}}{{range .metadata.ownerReferences}}{{if .controller}}{{.kind}}{{"\x1f"}}{{.name}}{{"\x1f"}}{{.uid}}{{end}}{{end}}{{"\n"}}{{end}}' 2>/dev/null)"; then
      echo "Warning: cannot inventory VictoriaLogs backend Pods owned by ${ns}/${service_name}." >&2
      return 1
    fi
    exact_owned_pods=0
    while IFS= read -r pod_row; do
      [[ -n "$pod_row" ]] || continue
      IFS=$'\x1f' read -r pod_name owner_kind owner_name owner_uid <<<"$pod_row"
      if [[ "$owner_kind" == "StatefulSet" && "$owner_name" == "$service_name" && "$owner_uid" == "$sts_uid" ]]; then
        exact_owned_pods=$((exact_owned_pods + 1))
      fi
    done <<<"$pod_rows"
    if (( desired_replicas == 0 && status_replicas == 0 && current_replicas == 0 \
      && ready_replicas == 0 && exact_owned_pods == 0 )); then
      echo "[launch] VictoriaLogs backend is quiesced; its StatefulSet, Helm release, and PVC data were preserved." >&2
      return 0
    fi
    now="$(date +%s)"
    if (( now >= deadline )); then
      echo "Warning: VictoriaLogs backend ${ns}/${service_name} did not fully quiesce within ${timeout_seconds}s (desired=${desired_replicas}, status=${status_replicas}, current=${current_replicas}, ready=${ready_replicas}, ownedPods=${exact_owned_pods}); its StatefulSet remains scaled to zero." >&2
      return 1
    fi
    sleep 2
  done
}

restrict_existing_victoria_logs_after_failed_preflight() {
  local invocation="${1:-start}"
  local logs_ns logs_release_name collector_release_name collector_daemonset collector_row=""
  local failed="false"

  if ! is_true "$VICTORIA_LOGS_ENABLED"; then
    return 0
  fi
  if [[ "$invocation" == "start" ]] && ! is_true "$KUBETON_START_VICTORIA_LOGS_ENABLED"; then
    return 0
  fi
  if (( ${#KUBETON_VICTORIA_LOGS_ELIGIBLE_NODES[@]} == 0 )); then
    # Empty evidence is destructive only when the complete node snapshot
    # conclusively evaluated every target and found zero PASS nodes. API,
    # parsing, or interrupted-check failures leave existing logging untouched.
    if ! is_true "$KUBETON_NODE_CHECK_EVALUATION_COMPLETE"; then
      return 0
    fi
    logs_ns="$(victoria_logs_namespace)"
    logs_release_name="$(victoria_logs_release_name)"
    collector_release_name="$(victoria_logs_collector_release_name)"
    if ! suspend_existing_owned_victoria_logs_collector "$logs_ns" "$collector_release_name"; then
      echo "Warning: failed to safely suspend the existing VictoriaLogs collector after the conclusive zero-PASS preflight; TON deployment remains blocked." >&2
      failed="true"
    fi
    if ! quiesce_existing_owned_victoria_logs_backend "$logs_ns" "$logs_release_name"; then
      echo "Warning: failed to safely quiesce the existing VictoriaLogs backend; TON deployment remains blocked." >&2
      failed="true"
    fi
    [[ "$failed" != "true" ]]
    return
  fi
  logs_ns="$(victoria_logs_namespace)"
  logs_release_name="$(victoria_logs_release_name)"
  collector_release_name="$(victoria_logs_collector_release_name)"
  collector_daemonset="$(victoria_logs_collector_daemonset_name "$collector_release_name")"
  if ! collector_row="$(kubectl -n "$logs_ns" get daemonset "$collector_daemonset" \
      --ignore-not-found -o go-template='{{.metadata.name}}' 2>/dev/null)"; then
    echo "Warning: cannot inventory VictoriaLogs collector ${logs_ns}/${collector_daemonset}; its placement could not be reconciled after failed preflight." >&2
    failed="true"
  elif [[ -n "$collector_row" ]]; then
    echo "[launch] TON preflight failed; restricting the existing VictoriaLogs collector to the nodes which did PASS: ${KUBETON_VICTORIA_LOGS_ELIGIBLE_NODES[*]}" >&2
    if ! ensure_start_victoria_logs_buffering_collector false; then
      echo "Warning: failed to move the existing VictoriaLogs collector away from rejected nodes; TON deployment remains blocked." >&2
      failed="true"
    fi
  fi
  if ! quiesce_existing_owned_victoria_logs_backend "$logs_ns" "$logs_release_name"; then
    echo "Warning: failed to safely quiesce the existing VictoriaLogs backend; TON deployment remains blocked." >&2
    failed="true"
  fi
  [[ "$failed" != "true" ]]
}

resolve_victoria_logs_backend_storage() {
  local configured_class="$1"
  local rows name provisioner stable_default legacy_default
  local preferred_row="" configured_row=""
  local -a defaults=()

  if ! rows="$(list_storage_class_default_rows)"; then
    echo "Error: cannot read StorageClasses to resolve VictoriaLogs backend storage; Helm was not started." >&2
    return 1
  fi
  while IFS='|' read -r name provisioner stable_default legacy_default; do
    [[ -n "$name" ]] || continue
    if [[ -z "$provisioner" ]]; then
      echo "Error: StorageClass '${name}' has no readable provisioner; VictoriaLogs placement cannot be verified." >&2
      return 1
    fi
    if [[ "$name" == "$configured_class" ]]; then configured_row="${name}"$'\t'"${provisioner}"; fi
    if [[ "$name" == longhorn ]]; then preferred_row="${name}"$'\t'"${provisioner}"; fi
    if [[ "$stable_default" == true || "$legacy_default" == true ]]; then
      defaults+=("${name}"$'\t'"${provisioner}")
    fi
  done <<<"$rows"
  if [[ -n "$configured_class" ]]; then
    if [[ -z "$configured_row" ]]; then
      echo "Error: VictoriaLogs StorageClass '${configured_class}' is missing; Helm was not started." >&2
      return 1
    fi
    printf '%s' "$configured_row"
  elif [[ -n "$preferred_row" ]]; then
    # Keep the established Longhorn preference for existing installations.
    printf '%s' "$preferred_row"
  elif (( ${#defaults[@]} == 1 )); then
    printf '%s' "${defaults[0]}"
  else
    echo "Error: VictoriaLogs requires one unambiguous default StorageClass (found ${#defaults[@]}); set VICTORIA_LOGS_STORAGE_CLASS explicitly." >&2
    return 1
  fi
}

ensure_victoria_logs_stack() {
  local ns="$1"
  local release_name="$2"
  local collector_release_name="$3"
  local remote_port="$4"
  local retention_period="$5"
  local pvc_size="$6"
  local rollout_timeout_seconds="$7"
  local helm_timeout_seconds="$8"
  local repo_name repo_url single_chart collector_chart
  local single_chart_version collector_chart_version
  local logs_storage_class logs_storage_provisioner logs_storage_row
  local logs_node_selector collector_node_selector logs_pin_to_longhorn_csi
  local logs_storage_is_longhorn="false"
  local logs_require_longhorn_csi="false"
  local vls_selector_values_file="" vls_affinity_values_file=""
  local matched_nodes=0
  local -a backend_allowed_nodes=() collector_allowed_nodes=()
  local service_name collector_daemonset access_service_name remote_write_url
  local ds_desired ds_ready
  local -a vls_cmd=()

  repo_name="$(trim_whitespace "${VICTORIA_LOGS_HELM_REPO_NAME:-vm}")"
  if [[ -z "$repo_name" ]]; then
    repo_name="vm"
  fi
  repo_url="$(trim_whitespace "${VICTORIA_LOGS_HELM_REPO_URL:-https://victoriametrics.github.io/helm-charts}")"
  if [[ -z "$repo_url" ]]; then
    repo_url="https://victoriametrics.github.io/helm-charts"
  fi
  single_chart="${repo_name}/victoria-logs-single"
  collector_chart="${repo_name}/victoria-logs-collector"
  single_chart_version="$(trim_whitespace "${VICTORIA_LOGS_SINGLE_CHART_VERSION:-}")"
  collector_chart_version="$(trim_whitespace "${VICTORIA_LOGS_COLLECTOR_CHART_VERSION:-}")"
  logs_storage_class="$(trim_whitespace "${VICTORIA_LOGS_STORAGE_CLASS:-}")"
  logs_node_selector="$(trim_whitespace "${VICTORIA_LOGS_NODE_SELECTOR:-}")"
  collector_node_selector="$(trim_whitespace "${VICTORIA_LOGS_COLLECTOR_NODE_SELECTOR:-}")"
  logs_pin_to_longhorn_csi="$(trim_whitespace "${VICTORIA_LOGS_PIN_TO_LONGHORN_CSI:-true}")"
  if ! [[ "$rollout_timeout_seconds" =~ ^[0-9]+$ ]] || (( rollout_timeout_seconds < 60 )); then
    rollout_timeout_seconds=300
  fi
  if ! [[ "$helm_timeout_seconds" =~ ^[0-9]+$ ]] || (( helm_timeout_seconds < 60 )); then
    helm_timeout_seconds=600
  fi
  if ! [[ "$remote_port" =~ ^[0-9]+$ ]]; then
    remote_port=9428
  fi
  if ! logs_storage_row="$(resolve_victoria_logs_backend_storage "$logs_storage_class")"; then
    return 1
  fi
  IFS=$'\t' read -r logs_storage_class logs_storage_provisioner <<<"$logs_storage_row"
  if [[ "$logs_storage_provisioner" == driver.longhorn.io ]]; then
    logs_storage_is_longhorn="true"
  fi
  # Cloud Persistent Disk deployments do not carry kubeton's Longhorn node
  # labels. Only inherit that placement when the selected backend actually
  # uses Longhorn. Exact fresh-PASS hostname affinity below remains required
  # for every storage provider.
  if [[ -z "$logs_node_selector" ]] && ! cluster_is_k3d \
    && is_true "$logs_storage_is_longhorn"; then
    if (( KUBETON_NODE_CHECK_EXISTING_LONGHORN == 1 )); then
      # A manually installed Longhorn may have no create-default-disk labels.
      # The preflight captured its actual manager placement; retain that even
      # when it is empty instead of imposing kubeton's bootstrap-only label.
      logs_node_selector="$(trim_whitespace "${KUBETON_NODE_CHECK_LONGHORN_MANAGER_SELECTOR:-}")"
    else
      logs_node_selector="$(trim_whitespace "${LONGHORN_NODE_SELECTOR:-}")"
    fi
  fi
  if is_true "$logs_pin_to_longhorn_csi" && is_true "$logs_storage_is_longhorn"; then
    logs_require_longhorn_csi="true"
  fi
  if ! victoria_logs_resolve_allowed_nodes "$collector_node_selector" false collector_allowed_nodes \
    || ! victoria_logs_validate_ton_nodes_covered collector_allowed_nodes; then
    echo "Error: VictoriaLogs collector has no safe complete placement; Helm was not started." >&2
    return 1
  fi

  if ! ensure_namespace "$ns"; then
    echo "Error: failed to ensure VictoriaLogs namespace ${ns}." >&2
    return 1
  fi
  if ! ensure_helm_repo "$repo_name" "$repo_url"; then
    echo "Error: failed to ensure VictoriaLogs Helm repository ${repo_name}." >&2
    return 1
  fi
  if ! helm repo update "$repo_name" >/dev/null; then
    echo "Error: failed to update VictoriaLogs Helm repository ${repo_name}." >&2
    return 1
  fi

  service_name="$(victoria_logs_service_name "$release_name")"
  collector_daemonset="$(victoria_logs_collector_daemonset_name "$collector_release_name")"
  # Create the restrictive policy before the backend Pod exists, eliminating
  # an unauthenticated in-cluster exposure window during Helm rollout. The
  # Service may safely have no endpoints until the StatefulSet becomes Ready.
  if ! access_service_name="$(ensure_victoria_logs_access_service "$ns" "$release_name" "$collector_release_name" "$remote_port")"; then
    return 1
  fi
  access_service_name="$(trim_whitespace "$access_service_name")"
  if [[ -z "$access_service_name" ]]; then
    echo "Error: VictoriaLogs access Service name could not be resolved." >&2
    return 1
  fi
  remote_write_url="http://${access_service_name}:${remote_port}"
  # Restrict the collector first. It can keep buffering while the backend is
  # upgraded, and a backend/CSI failure must not leave the previous
  # cluster-wide DaemonSet running on nodes rejected by the latest check.
  if ! install_victoria_logs_collector_release "$ns" "$collector_release_name" \
    "$collector_chart" "$collector_chart_version" "$remote_write_url" \
    "$helm_timeout_seconds" "$collector_node_selector"; then
    [[ -z "$vls_selector_values_file" ]] || rm -f "$vls_selector_values_file" >/dev/null 2>&1 || true
    rm -f "$vls_affinity_values_file" >/dev/null 2>&1 || true
    return 1
  fi
  if ! wait_victoria_logs_collector_ready_on_selected_nodes "$ns" "$collector_release_name" \
    "$KUBETON_NODE_CHECK_TON_SELECTOR" "$rollout_timeout_seconds"; then
    [[ -z "$vls_selector_values_file" ]] || rm -f "$vls_selector_values_file" >/dev/null 2>&1 || true
    rm -f "$vls_affinity_values_file" >/dev/null 2>&1 || true
    return 1
  fi

  if ! victoria_logs_resolve_allowed_nodes "$logs_node_selector" "$logs_require_longhorn_csi" backend_allowed_nodes; then
    echo "Error: VictoriaLogs backend has no safe preflight-approved placement; its Helm release was not changed." >&2
    return 1
  fi
  matched_nodes="${#backend_allowed_nodes[@]}"
  if [[ -n "$logs_node_selector" ]]; then
    vls_selector_values_file="$(build_victoria_logs_single_selector_values_file "$logs_node_selector")" || return 1
  fi
  vls_affinity_values_file="$(build_victoria_logs_single_affinity_values_file backend_allowed_nodes)" || return 1
  vls_cmd=(helm upgrade --install "$release_name" "$single_chart" -n "$ns" --create-namespace --wait --timeout "${helm_timeout_seconds}s" \
    --set-string "server.retentionPeriod=${retention_period}" \
    --set-string "server.persistentVolume.size=${pvc_size}" \
    --set-string "server.retentionDiskSpaceUsage=${VICTORIA_LOGS_RETENTION_DISK_SPACE}")
  if [[ -n "$logs_storage_class" ]]; then
    vls_cmd+=(--set-string "server.persistentVolume.storageClassName=${logs_storage_class}")
  fi
  if [[ -n "$vls_selector_values_file" ]]; then
    vls_cmd+=(-f "$vls_selector_values_file")
  fi
  vls_cmd+=(-f "$vls_affinity_values_file")
  if [[ -n "$single_chart_version" ]]; then
    vls_cmd+=(--version "$single_chart_version")
  fi

  echo "[victoria-metrics] Installing/updating VictoriaLogs single (${release_name}) ..." >&2
  if [[ -n "$logs_storage_class" ]]; then
    echo "[victoria-metrics] VictoriaLogs single storageClass: ${logs_storage_class}" >&2
  fi
  if [[ -n "$logs_node_selector" ]]; then
    echo "[victoria-metrics] VictoriaLogs single nodeSelector: ${logs_node_selector} (matched ${matched_nodes} node(s))" >&2
  fi
  echo "[victoria-metrics] VictoriaLogs single required hostname affinity: ${backend_allowed_nodes[*]}" >&2
  if is_true "$logs_require_longhorn_csi"; then
    echo "[victoria-metrics] VictoriaLogs single placement also requires registered, Ready Longhorn CSI." >&2
  fi
  if ! run_with_timeout "${helm_timeout_seconds}s" "${vls_cmd[@]}" >/dev/null; then
    if [[ -n "$vls_selector_values_file" ]]; then
      rm -f "$vls_selector_values_file" >/dev/null 2>&1 || true
    fi
    if [[ -n "$vls_affinity_values_file" ]]; then
      rm -f "$vls_affinity_values_file" >/dev/null 2>&1 || true
    fi
    echo "Error: failed to install/upgrade VictoriaLogs single release ${release_name} in namespace ${ns}." >&2
    if [[ -n "$logs_storage_class" ]]; then
      echo "Warning: VictoriaLogs storageClassName in use: ${logs_storage_class}" >&2
    fi
    if [[ -n "$logs_node_selector" ]]; then
      echo "Warning: VictoriaLogs nodeSelector in use: ${logs_node_selector}" >&2
    fi
    echo "Warning: recent VictoriaLogs pod/PVC diagnostics:" >&2
    kubectl -n "$ns" get pod "${service_name}-0" -o wide >/dev/null 2>&1 && kubectl -n "$ns" get pod "${service_name}-0" -o wide >&2 || true
    kubectl -n "$ns" get pvc 2>/dev/null | awk -v prefix="server-volume-${service_name}-" 'NR==1 || index($1, prefix)==1 {print}' >&2 || true
    kubectl -n "$ns" get events --field-selector "involvedObject.name=${service_name}-0" --sort-by=.lastTimestamp 2>/dev/null | tail -n 8 >&2 || true
    if is_true "$logs_require_longhorn_csi"; then
      if [[ -z "$logs_node_selector" ]]; then
        echo "Warning: if Longhorn CSI runs only on selected nodes, set VICTORIA_LOGS_NODE_SELECTOR (for example: ${LONGHORN_NODE_SELECTOR})." >&2
      else
        echo "Warning: verify that nodes matching VICTORIA_LOGS_NODE_SELECTOR run Longhorn CSI driver." >&2
      fi
    fi
    return 1
  fi
  if [[ -n "$vls_selector_values_file" ]]; then
    rm -f "$vls_selector_values_file" >/dev/null 2>&1 || true
  fi
  if [[ -n "$vls_affinity_values_file" ]]; then
    rm -f "$vls_affinity_values_file" >/dev/null 2>&1 || true
  fi

  if ! kubectl -n "$ns" rollout status "statefulset/${service_name}" --timeout="${rollout_timeout_seconds}s" >/dev/null 2>&1; then
    echo "Error: VictoriaLogs StatefulSet ${ns}/${service_name} is not Ready on an approved node." >&2
    return 1
  fi
  if ! victoria_logs_backend_ready_on_allowed_nodes "$ns" "$service_name" backend_allowed_nodes; then
    return 1
  fi
  if ! wait_victoria_logs_collector_ready_on_selected_nodes "$ns" "$collector_release_name" \
    "$KUBETON_NODE_CHECK_TON_SELECTOR" "$rollout_timeout_seconds"; then
    return 1
  fi

  ds_desired="$(kubectl -n "$ns" get daemonset "$collector_daemonset" -o jsonpath='{.status.desiredNumberScheduled}' 2>/dev/null || true)"
  ds_ready="$(kubectl -n "$ns" get daemonset "$collector_daemonset" -o jsonpath='{.status.numberReady}' 2>/dev/null || true)"
  ds_desired="$(trim_whitespace "$ds_desired")"
  ds_ready="$(trim_whitespace "$ds_ready")"
  if ! [[ "$ds_desired" =~ ^[0-9]+$ && "$ds_ready" =~ ^[0-9]+$ ]]; then
    echo "Error: cannot read VictoriaLogs collector readiness for ${ns}/${collector_daemonset}; log collection cannot be proven." >&2
    return 1
  fi
  if (( ds_desired == 0 )); then
    echo "Error: VictoriaLogs collector DaemonSet ${ns}/${collector_daemonset} targets no nodes; log collection is not active." >&2
    return 1
  fi
  if (( ds_ready != ds_desired )); then
    echo "Warning: VictoriaLogs collector DaemonSet aggregate readiness is ${ds_ready}/${ds_desired}; selected TON-node coverage was checked separately." >&2
  fi

  printf '%s\t%s\t%s\t%s\t%s\t%s\n' "$access_service_name" "$service_name" "$collector_daemonset" "$remote_write_url" "$ds_ready" "$ds_desired"
}

victoria_logs_backend_ready_on_allowed_nodes() {
  local ns="$1"
  local service_name="$2"
  local allowed_nodes_array_name="$3"
  local -n allowed_nodes_ref="$allowed_nodes_array_name"
  local pod_name="${service_name}-0"
  local pod_row node phase terminating ready_condition allowed_node
  local allowed="false"

  if ! pod_row="$(kubectl -n "$ns" get pod "$pod_name" \
    -o go-template='{{.spec.nodeName}}{{"\x1f"}}{{.status.phase}}{{"\x1f"}}{{if .metadata.deletionTimestamp}}terminating{{end}}{{"\x1f"}}{{range .status.conditions}}{{if and (eq .type "Ready") (eq .status "True")}}ready{{end}}{{end}}' 2>/dev/null)"; then
    echo "Error: cannot inspect VictoriaLogs backend Pod ${ns}/${pod_name}." >&2
    return 1
  fi
  IFS=$'\x1f' read -r node phase terminating ready_condition <<<"$pod_row"
  node="$(trim_whitespace "$node")"
  for allowed_node in "${allowed_nodes_ref[@]}"; do
    if [[ "$node" == "$allowed_node" ]]; then
      allowed="true"
      break
    fi
  done
  if [[ "$allowed" != "true" ]]; then
    echo "Error: VictoriaLogs backend Pod ${ns}/${pod_name} is on '${node:-no node}', outside the fresh preflight-approved nodes (${allowed_nodes_ref[*]})." >&2
    return 1
  fi
  if [[ "$phase" != "Running" || -n "$terminating" || "$ready_condition" != "ready" ]]; then
    echo "Error: VictoriaLogs backend Pod ${ns}/${pod_name} on ${node} is not non-terminating and Ready." >&2
    return 1
  fi
  echo "[victoria-metrics] VictoriaLogs backend is Ready on approved node ${node}." >&2
}

victoria_logs_collector_ready_on_selected_nodes() {
  local ns="$1"
  local collector_release_name="$2"
  local node_selector="$3"
  local collector_daemonset ds_row generation observed_generation daemonset_uid desired_scheduled current_scheduled misscheduled update_revision=""
  local revision_rows revision_row revision_kind revision_owner revision_owner_uid revision_controller revision_number revision_name
  local newest_revision=-1
  local selected_node_rows pod_rows pod_row pod_node pod_revision pod_phase terminating ready_condition owner owner_uid
  local -a selected_nodes=() allowed_nodes=()
  local -A allowed_by_node=()
  local -A ready_by_node=()
  local node

  node_selector="$(trim_whitespace "$node_selector")"
  if ! victoria_logs_resolve_allowed_nodes \
      "$(trim_whitespace "${VICTORIA_LOGS_COLLECTOR_NODE_SELECTOR:-}")" false allowed_nodes; then
    return 1
  fi
  for node in "${allowed_nodes[@]}"; do
    allowed_by_node["$node"]=1
  done
  collector_daemonset="$(victoria_logs_collector_daemonset_name "$collector_release_name")"
  if ! ds_row="$(kubectl -n "$ns" get daemonset "$collector_daemonset" \
    -o go-template='{{.metadata.generation}}{{"\x1f"}}{{.status.observedGeneration}}{{"\x1f"}}{{.metadata.uid}}{{"\x1f"}}{{.status.desiredNumberScheduled}}{{"\x1f"}}{{.status.currentNumberScheduled}}{{"\x1f"}}{{.status.numberMisscheduled}}' 2>/dev/null)"; then
    echo "Error: cannot read VictoriaLogs collector DaemonSet ${ns}/${collector_daemonset}." >&2
    return 1
  fi
  IFS=$'\x1f' read -r generation observed_generation daemonset_uid desired_scheduled current_scheduled misscheduled <<<"$ds_row"
  generation="$(trim_whitespace "$generation")"
  observed_generation="$(trim_whitespace "$observed_generation")"
  daemonset_uid="$(trim_whitespace "$daemonset_uid")"
  desired_scheduled="$(trim_whitespace "$desired_scheduled")"
  current_scheduled="$(trim_whitespace "$current_scheduled")"
  misscheduled="$(trim_whitespace "$misscheduled")"
  if ! [[ "$generation" =~ ^[1-9][0-9]*$ && "$observed_generation" == "$generation" ]] \
    || [[ -z "$daemonset_uid" ]]; then
    echo "Error: VictoriaLogs collector DaemonSet ${ns}/${collector_daemonset} has not observed its current generation." >&2
    return 1
  fi
  if ! [[ "$desired_scheduled" =~ ^[1-9][0-9]*$ \
    && "$current_scheduled" =~ ^[0-9]+$ \
    && "$misscheduled" =~ ^[0-9]+$ ]] \
    || (( desired_scheduled != ${#allowed_nodes[@]} \
      || current_scheduled != desired_scheduled \
      || misscheduled != 0 )); then
    echo "Error: VictoriaLogs collector target set is not the current preflight-approved set (current=${current_scheduled:-unknown}, desired=${desired_scheduled:-unknown}, approved=${#allowed_nodes[@]}, misscheduled=${misscheduled:-unknown})." >&2
    return 1
  fi
  # DaemonSetStatus has no updateRevision field. Resolve the newest
  # ControllerRevision owned by this exact DaemonSet UID, then require the
  # corresponding controller-revision-hash on each Ready collector Pod.
  if ! revision_rows="$(kubectl -n "$ns" get controllerrevision \
    -o go-template='{{range .items}}{{$revision := .revision}}{{$revisionName := .metadata.name}}{{range .metadata.ownerReferences}}{{.kind}}{{"\x1f"}}{{.name}}{{"\x1f"}}{{.uid}}{{"\x1f"}}{{if .controller}}true{{else}}false{{end}}{{"\x1f"}}{{$revision}}{{"\x1f"}}{{$revisionName}}{{"\n"}}{{end}}{{end}}' 2>/dev/null)"; then
    echo "Error: cannot read VictoriaLogs collector revisions for ${ns}/${collector_daemonset}." >&2
    return 1
  fi
  while IFS= read -r revision_row; do
    IFS=$'\x1f' read -r revision_kind revision_owner revision_owner_uid revision_controller revision_number revision_name <<<"$revision_row"
    if [[ "$revision_kind" != "DaemonSet" \
      || "$revision_owner" != "$collector_daemonset" \
      || "$revision_owner_uid" != "$daemonset_uid" \
      || "$revision_controller" != "true" \
      || ! "$revision_number" =~ ^[0-9]+$ ]]; then
      continue
    fi
    if (( revision_number > newest_revision )); then
      newest_revision="$revision_number"
      update_revision="$revision_name"
    fi
  done <<<"$revision_rows"
  if [[ -z "$update_revision" || "$update_revision" != "${collector_daemonset}-"* ]]; then
    echo "Error: cannot resolve the current VictoriaLogs collector revision for ${ns}/${collector_daemonset}." >&2
    return 1
  fi
  update_revision="${update_revision#"${collector_daemonset}-"}"

  # Inspect all exact-owner Pods in one snapshot. A Ready Pod on every wanted
  # host is not sufficient if an old or misscheduled collector still runs on
  # a node which the latest preflight rejected.
  if ! pod_rows="$(kubectl -n "$ns" get pods \
    -l "app.kubernetes.io/name=victoria-logs-collector,app.kubernetes.io/instance=${collector_release_name}" \
    -o go-template='{{range .items}}{{.spec.nodeName}}{{"\x1f"}}{{with .metadata.labels}}{{index . "controller-revision-hash"}}{{end}}{{"\x1f"}}{{.status.phase}}{{"\x1f"}}{{if .metadata.deletionTimestamp}}terminating{{end}}{{"\x1f"}}{{range .status.conditions}}{{if and (eq .type "Ready") (eq .status "True")}}ready{{end}}{{end}}{{"\x1f"}}{{range .metadata.ownerReferences}}{{if .controller}}{{.kind}}{{"/"}}{{.name}}{{"\x1f"}}{{.uid}}{{end}}{{end}}{{"\n"}}{{end}}' 2>/dev/null)"; then
    echo "Error: cannot list VictoriaLogs collector Pods for ${ns}/${collector_daemonset}." >&2
    return 1
  fi
  ready_by_node=()
  while IFS= read -r pod_row; do
    IFS=$'\x1f' read -r pod_node pod_revision pod_phase terminating ready_condition owner owner_uid <<<"$pod_row"
    pod_node="$(trim_whitespace "$pod_node")"
    if [[ "$owner" != "DaemonSet/${collector_daemonset}" || "$owner_uid" != "$daemonset_uid" ]]; then
      continue
    fi
    if [[ -n "$pod_node" && -z "${allowed_by_node[$pod_node]:-}" ]]; then
      echo "Error: VictoriaLogs collector Pod remains on rejected node ${pod_node}; waiting for the restricted DaemonSet rollout to remove it." >&2
      return 1
    fi
    if [[ -n "$pod_node" \
      && "$pod_revision" == "$update_revision" \
      && "$pod_phase" == "Running" \
      && -z "$terminating" \
      && "$ready_condition" == "ready" ]]; then
      ready_by_node["$pod_node"]=1
    fi
  done <<<"$pod_rows"
  for node in "${allowed_nodes[@]}"; do
    if [[ -z "${ready_by_node[$node]:-}" ]]; then
      echo "Error: preflight-approved node ${node} has no Ready VictoriaLogs collector of the current revision." >&2
      return 1
    fi
  done

  # If TON has an independently rendered selector, prove that it cannot name a
  # host outside the collector's exact approved set.
  if [[ -n "$node_selector" ]]; then
    if ! selected_node_rows="$(kubectl get nodes -l "$node_selector" -o name 2>/dev/null)"; then
      echo "Error: cannot list nodes selected for TON while verifying VictoriaLogs coverage." >&2
      return 1
    fi
    mapfile -t selected_nodes < <(printf '%s\n' "$selected_node_rows" | sed 's#^node/##' | awk 'NF' | sort -u)
    if (( ${#selected_nodes[@]} == 0 )); then
      echo "Error: TON selector '${node_selector}' matches no nodes while verifying VictoriaLogs coverage." >&2
      return 1
    fi
    for node in "${selected_nodes[@]}"; do
      if [[ -z "${allowed_by_node[$node]:-}" ]]; then
        echo "Error: selected TON node ${node} is outside the VictoriaLogs preflight-approved placement." >&2
        return 1
      fi
    done
  fi
  echo "[launch] VictoriaLogs collector is Ready only on the fresh preflight-approved nodes (${#allowed_nodes[@]} node(s))." >&2
}

wait_victoria_logs_collector_ready_on_selected_nodes() {
  local ns="$1"
  local collector_release_name="$2"
  local node_selector="$3"
  local timeout_seconds="$4"
  local deadline now last_error=""

  if ! [[ "$timeout_seconds" =~ ^[0-9]+$ ]] || (( timeout_seconds < 1 )); then
    timeout_seconds=300
  fi
  deadline=$(( $(date +%s) + timeout_seconds ))
  while :; do
    if last_error="$(victoria_logs_collector_ready_on_selected_nodes \
      "$ns" "$collector_release_name" "$node_selector" 2>&1)"; then
      [[ -z "$last_error" ]] || printf '%s\n' "$last_error" >&2
      return 0
    fi
    now="$(date +%s)"
    if (( now >= deadline )); then
      [[ -z "$last_error" ]] || printf '%s\n' "$last_error" >&2
      echo "Error: VictoriaLogs collector did not cover every selected TON node within ${timeout_seconds}s." >&2
      return 1
    fi
    sleep 2
  done
}

ensure_start_victoria_logs() {
  local logs_ns logs_release_name logs_collector_release_name
  local logs_retention_period logs_pvc_size logs_remote_port timeout_seconds helm_timeout_seconds
  local logs_stack_row access_service backend_service collector_daemonset remote_write_url ds_ready ds_desired
  local configured_logs_node_selector configured_collector_node_selector

  if ! is_true "$KUBETON_START_VICTORIA_LOGS_ENABLED" || ! is_true "$VICTORIA_LOGS_ENABLED"; then
    echo "Warning: automatic VictoriaLogs launch capture is disabled; the local bundle cannot guarantee preservation of every rapid container restart." >&2
    return 0
  fi
  require_bin helm
  logs_ns="$(victoria_logs_namespace)"
  logs_release_name="$(victoria_logs_release_name)"
  logs_collector_release_name="$(victoria_logs_collector_release_name)"
  logs_retention_period="$(trim_whitespace "${VICTORIA_LOGS_RETENTION_PERIOD:-30d}")"
  logs_pvc_size="$(trim_whitespace "${VICTORIA_LOGS_PVC_SIZE:-10Gi}")"
  logs_remote_port="$(trim_whitespace "${VICTORIA_LOGS_PORT:-9428}")"
  timeout_seconds="$(resolve_victoria_metrics_rollout_timeout_seconds)"
  helm_timeout_seconds="$(resolve_victoria_logs_helm_timeout_seconds)"
  [[ -n "$logs_retention_period" ]] || logs_retention_period=30d
  [[ -n "$logs_pvc_size" ]] || logs_pvc_size=10Gi
  [[ "$logs_remote_port" =~ ^[0-9]+$ ]] || logs_remote_port=9428

  configured_logs_node_selector="$(trim_whitespace "${VICTORIA_LOGS_NODE_SELECTOR:-}")"
  configured_collector_node_selector="$(trim_whitespace "${VICTORIA_LOGS_COLLECTOR_NODE_SELECTOR:-}")"
  access_service="$(victoria_logs_access_service_name "$logs_release_name")"
  collector_daemonset="$(victoria_logs_collector_daemonset_name "$logs_collector_release_name")"

  echo "[launch] Ensuring durable VictoriaLogs collection before TON pods are created ..." >&2
  # Persist intent before either Helm release is mutated. A partial custom
  # backend/collector install must remain discoverable by plain uninstall.
  if ! write_victoria_logs_state "$OP_NAMESPACE" "$logs_ns" "$logs_release_name" \
      "$logs_collector_release_name" "$access_service" "$collector_daemonset"; then
    echo "Error: durable launch logging intent could not be persisted; TON deployment was not applied." >&2
    return 1
  fi
  if ! logs_stack_row="$(VICTORIA_LOGS_NODE_SELECTOR="$configured_logs_node_selector" \
    VICTORIA_LOGS_COLLECTOR_NODE_SELECTOR="$configured_collector_node_selector" \
    ensure_victoria_logs_stack "$logs_ns" "$logs_release_name" "$logs_collector_release_name" \
      "$logs_remote_port" "$logs_retention_period" "$logs_pvc_size" "$timeout_seconds" "$helm_timeout_seconds")"; then
    echo "Error: durable launch logging is not Ready; TON deployment was not applied." >&2
    echo "Error: fix VictoriaLogs or set KUBETON_START_VICTORIA_LOGS_ENABLED=false to explicitly accept best-effort local capture." >&2
    return 1
  fi
  IFS=$'\t' read -r access_service backend_service collector_daemonset remote_write_url ds_ready ds_desired <<<"$logs_stack_row"
  if ! write_victoria_logs_state "$OP_NAMESPACE" "$logs_ns" "$logs_release_name" "$logs_collector_release_name" "$access_service" "$collector_daemonset"; then
    echo "Error: durable launch logging is running, but its cleanup/access state could not be persisted; TON deployment was not applied." >&2
    return 1
  fi
  KUBETON_VICTORIA_LOGS_APPLIED_NODES="$(victoria_logs_eligible_nodes_csv)"
  echo "[launch] Durable container-log collection is active (${logs_ns}/${collector_daemonset}, ${ds_ready}/${ds_desired} Ready)." >&2
}

verify_start_victoria_logs_collection_ready() {
  local logs_ns logs_release_name collector_release_name backend_service
  local -a current_approved_nodes=()

  if ! is_true "$KUBETON_START_VICTORIA_LOGS_ENABLED" || ! is_true "$VICTORIA_LOGS_ENABLED"; then
    return 0
  fi
  logs_ns="$(victoria_logs_namespace)"
  logs_release_name="$(victoria_logs_release_name)"
  collector_release_name="$(victoria_logs_collector_release_name)"
  current_approved_nodes=("${KUBETON_VICTORIA_LOGS_ELIGIBLE_NODES[@]}")
  if (( ${#current_approved_nodes[@]} == 0 )); then
    echo "Error: the final VictoriaLogs readiness probe has no fresh preflight-approved node set." >&2
    return 1
  fi
  backend_service="$(victoria_logs_service_name "$logs_release_name")"
  if ! victoria_logs_backend_ready_on_allowed_nodes "$logs_ns" "$backend_service" current_approved_nodes; then
    return 1
  fi
  victoria_logs_collector_ready_on_selected_nodes \
    "$logs_ns" "$collector_release_name" "${KUBETON_NODE_CHECK_TON_SELECTOR:-}"
}

victoria_logs_port_forward_address() {
  local configured
  configured="$(trim_whitespace "${VICTORIA_LOGS_PORT_FORWARD_ADDRESS:-}")"
  if [[ -n "$configured" ]]; then
    printf '%s' "$configured"
    return 0
  fi

  printf '%s' "127.0.0.1"
}

wait_victoria_logs_http_ready() {
  local local_port="$1"
  local verify_seconds="$2"
  local deadline now status_code

  if ! [[ "$verify_seconds" =~ ^[0-9]+$ ]]; then
    verify_seconds=20
  fi
  if (( verify_seconds <= 0 )); then
    return 0
  fi
  if ! command -v curl >/dev/null 2>&1; then
    return 0
  fi

  deadline=$(( $(date +%s) + verify_seconds ))
  while :; do
    status_code="$(curl -sS -o /dev/null --max-time 3 -w '%{http_code}' "http://127.0.0.1:${local_port}/health" || true)"
    if [[ "$status_code" == "200" || "$status_code" == "401" || "$status_code" == "403" || "$status_code" == "404" ]]; then
      return 0
    fi
    status_code="$(curl -sS -o /dev/null --max-time 3 -w '%{http_code}' "http://127.0.0.1:${local_port}/select/vmui/" || true)"
    if [[ "$status_code" == "200" || "$status_code" == "401" || "$status_code" == "403" || "$status_code" == "404" ]]; then
      return 0
    fi

    now="$(date +%s)"
    if (( now >= deadline )); then
      return 1
    fi
    sleep 1
  done
}

ensure_victoria_logs_port_forward() {
  local ns="$1"
  local service_name="$2"
  local local_port="$3"
  local remote_port="$4"
  local bind_address="${5:-127.0.0.1}"
  local quiet="${6:-false}"
  local state_dir="${VICTORIA_LOGS_PORT_FORWARD_DIR}"
  local wait_seconds="${VICTORIA_LOGS_PORT_FORWARD_WAIT_SECONDS}"
  local verify_seconds="${VICTORIA_LOGS_PORT_FORWARD_VERIFY_SECONDS}"
  local key pid_file log_file existing_pid pf_pid deadline now

  if ! [[ "$local_port" =~ ^[0-9]+$ ]] || ! [[ "$remote_port" =~ ^[0-9]+$ ]]; then
    return 1
  fi
  if ! [[ "$wait_seconds" =~ ^[0-9]+$ ]]; then
    wait_seconds=5
  fi
  if ! [[ "$verify_seconds" =~ ^[0-9]+$ ]]; then
    verify_seconds=20
  fi

  mkdir -p "$state_dir"
  key="$(sanitize_file_name_fragment "${ns}__${service_name}__${local_port}")"
  pid_file="${state_dir}/${key}.pid"
  log_file="${state_dir}/${key}.log"

  if [[ -f "$pid_file" ]]; then
    existing_pid="$(cat "$pid_file" 2>/dev/null || true)"
    if [[ "$existing_pid" =~ ^[0-9]+$ ]] && kill -0 "$existing_pid" >/dev/null 2>&1; then
      if port_forward_process_matches "$existing_pid" "$ns" "$service_name" "$local_port" "$remote_port" "$bind_address"; then
        if wait_victoria_logs_http_ready "$local_port" 2; then
          printf '%s\t%s\t%s\t%s\t%s\n' "$ns" "$service_name" "$local_port" "$existing_pid" "$log_file"
          return 0
        fi
      fi
      kill "$existing_pid" >/dev/null 2>&1 || true
    fi
    rm -f "$pid_file" >/dev/null 2>&1 || true
  fi

  nohup kubectl -n "$ns" port-forward --address "$bind_address" "svc/${service_name}" "${local_port}:${remote_port}" >"$log_file" 2>&1 &
  pf_pid="$!"
  echo "$pf_pid" >"$pid_file"

  deadline=$(( $(date +%s) + wait_seconds ))
  while :; do
    if ! kill -0 "$pf_pid" >/dev/null 2>&1; then
      rm -f "$pid_file" >/dev/null 2>&1 || true
      if [[ "$quiet" != "1" && "$quiet" != "true" ]]; then
        echo "Warning: failed to start background port-forward for ${ns}/${service_name} on localhost:${local_port}." >&2
        echo "Warning: see ${log_file}" >&2
      fi
      return 1
    fi
    if grep -q "Forwarding from" "$log_file" 2>/dev/null; then
      if ! wait_victoria_logs_http_ready "$local_port" "$verify_seconds"; then
        kill "$pf_pid" >/dev/null 2>&1 || true
        rm -f "$pid_file" >/dev/null 2>&1 || true
        if [[ "$quiet" != "1" && "$quiet" != "true" ]]; then
          echo "Warning: port-forward for ${ns}/${service_name} started on localhost:${local_port}, but VictoriaLogs endpoint is not ready." >&2
          echo "Warning: see ${log_file}" >&2
        fi
        return 1
      fi
      if ! kill -0 "$pf_pid" >/dev/null 2>&1 || ! wait_victoria_logs_http_ready "$local_port" 2; then
        kill "$pf_pid" >/dev/null 2>&1 || true
        rm -f "$pid_file" >/dev/null 2>&1 || true
        if [[ "$quiet" != "1" && "$quiet" != "true" ]]; then
          echo "Warning: port-forward for ${ns}/${service_name} became unavailable immediately after startup on localhost:${local_port}." >&2
          echo "Warning: see ${log_file}" >&2
        fi
        return 1
      fi
      printf '%s\t%s\t%s\t%s\t%s\n' "$ns" "$service_name" "$local_port" "$pf_pid" "$log_file"
      return 0
    fi
    now="$(date +%s)"
    if (( now >= deadline )); then
      kill "$pf_pid" >/dev/null 2>&1 || true
      rm -f "$pid_file" >/dev/null 2>&1 || true
      if [[ "$quiet" != "1" && "$quiet" != "true" ]]; then
        echo "Warning: timed out waiting for port-forward readiness for ${ns}/${service_name} on localhost:${local_port}." >&2
        echo "Warning: see ${log_file}" >&2
      fi
      return 1
    fi
    sleep 1
  done
}

start_victoria_logs_port_forward() {
  local ns="$1"
  local service_name="$2"
  local base_port="$3"
  local remote_port="$4"
  local bind_address="$5"
  local forward_row attempt quiet_attempt

  if ! [[ "$base_port" =~ ^[0-9]+$ ]]; then
    base_port=9428
  fi

  for ((attempt=0; attempt<25; attempt++)); do
    quiet_attempt="true"
    if (( attempt == 24 )); then
      quiet_attempt="false"
    fi
    if forward_row="$(ensure_victoria_logs_port_forward "$ns" "$service_name" "$((base_port + attempt))" "$remote_port" "$bind_address" "$quiet_attempt")"; then
      printf '%s' "$forward_row"
      return 0
    fi
  done
  return 1
}

ensure_victoria_logs_api_proxy() {
  local local_port="$1"
  local state_dir="${VICTORIA_LOGS_PORT_FORWARD_DIR}"
  local wait_seconds="${VICTORIA_LOGS_PORT_FORWARD_WAIT_SECONDS}"
  local verify_seconds="${VICTORIA_LOGS_PORT_FORWARD_VERIFY_SECONDS}"
  local pid_file log_file proxy_pid deadline now

  if ! [[ "$local_port" =~ ^[0-9]+$ ]]; then
    return 1
  fi
  if ! [[ "$wait_seconds" =~ ^[0-9]+$ ]]; then
    wait_seconds=5
  fi
  if ! [[ "$verify_seconds" =~ ^[0-9]+$ ]]; then
    verify_seconds=20
  fi

  mkdir -p "$state_dir"
  pid_file="${state_dir}/proxy-${local_port}.pid"
  log_file="${state_dir}/proxy-${local_port}.log"

  if [[ -f "$pid_file" ]]; then
    proxy_pid="$(cat "$pid_file" 2>/dev/null || true)"
    if [[ "$proxy_pid" =~ ^[0-9]+$ ]] && kill -0 "$proxy_pid" >/dev/null 2>&1; then
      if wait_kubectl_proxy_ready "$local_port" 2; then
        printf '%s\t%s\t%s\n' "$local_port" "$proxy_pid" "$log_file"
        return 0
      fi
      kill "$proxy_pid" >/dev/null 2>&1 || true
    fi
    rm -f "$pid_file" >/dev/null 2>&1 || true
  fi

  if command -v setsid >/dev/null 2>&1; then
    setsid kubectl proxy --disable-filter --address 127.0.0.1 --port "$local_port" >"$log_file" 2>&1 < /dev/null &
  else
    nohup kubectl proxy --disable-filter --address 127.0.0.1 --port "$local_port" >"$log_file" 2>&1 &
  fi
  proxy_pid="$!"
  echo "$proxy_pid" >"$pid_file"

  deadline=$(( $(date +%s) + wait_seconds ))
  while :; do
    if ! kill -0 "$proxy_pid" >/dev/null 2>&1; then
      rm -f "$pid_file" >/dev/null 2>&1 || true
      return 1
    fi
    if wait_kubectl_proxy_ready "$local_port" 1; then
      if ! wait_kubectl_proxy_ready "$local_port" "$verify_seconds"; then
        kill "$proxy_pid" >/dev/null 2>&1 || true
        rm -f "$pid_file" >/dev/null 2>&1 || true
        return 1
      fi
      printf '%s\t%s\t%s\n' "$local_port" "$proxy_pid" "$log_file"
      return 0
    fi
    now="$(date +%s)"
    if (( now >= deadline )); then
      kill "$proxy_pid" >/dev/null 2>&1 || true
      rm -f "$pid_file" >/dev/null 2>&1 || true
      return 1
    fi
    sleep 1
  done
}

ensure_victoria_logs_nodeport_access() {
  local ns="$1"
  local release_name="$2"
  local remote_port="$3"
  local service_name="kubeton-vlogs-nodeport-${release_name}"
  local node_port
  local -a node_ip_rows=()
  local row node_name node_ip ip_source
  local printed=0
  local -A seen_ip=()

  if ! [[ "$remote_port" =~ ^[0-9]+$ ]]; then
    remote_port=9428
  fi

  cat <<EOF | kubectl -n "$ns" apply -f - >/dev/null
apiVersion: v1
kind: Service
metadata:
  name: ${service_name}
  labels:
    app.kubernetes.io/name: kubeton-victoria-logs-access
    app.kubernetes.io/managed-by: kubeton
    app.kubernetes.io/part-of: kubeton-victoria-logs
spec:
  type: NodePort
  selector:
    app: server
    app.kubernetes.io/instance: ${release_name}
    app.kubernetes.io/name: victoria-logs-single
  ports:
    - name: http
      protocol: TCP
      port: ${remote_port}
      targetPort: http
EOF

  node_port="$(kubectl -n "$ns" get service "$service_name" -o jsonpath='{.spec.ports[0].nodePort}' 2>/dev/null || true)"
  node_port="$(trim_whitespace "$node_port")"
  if ! [[ "$node_port" =~ ^[0-9]+$ ]]; then
    echo "Warning: failed to resolve NodePort for VictoriaLogs access service ${ns}/${service_name}." >&2
    return 1
  fi
  echo "[victoria-metrics] VictoriaLogs NodePort service: ${ns}/${service_name} (${node_port})"

  mapfile -t node_ip_rows < <(list_node_external_ip_rows)
  for row in "${node_ip_rows[@]}"; do
    [[ -z "$row" ]] && continue
    IFS=$'\t' read -r node_name node_ip ip_source <<<"$row"
    node_name="$(trim_whitespace "$node_name")"
    node_ip="$(trim_whitespace "$node_ip")"
    ip_source="$(trim_whitespace "$ip_source")"
    [[ -z "$node_ip" ]] && continue
    if [[ -n "${seen_ip[$node_ip]:-}" ]]; then
      continue
    fi
    seen_ip["$node_ip"]=1
    ((printed+=1))
    echo "[victoria-metrics] VictoriaLogs NodePort VMUI (${ip_source} ${node_name}): http://${node_ip}:${node_port}/select/vmui/"
    echo "[victoria-metrics] VictoriaLogs NodePort query API (${ip_source} ${node_name}): http://${node_ip}:${node_port}/select/logsql/query"
  done

  if (( printed == 0 )); then
    echo "[victoria-metrics] VictoriaLogs NodePort VMUI: <node-ip>:${node_port}/select/vmui/"
    echo "[victoria-metrics] VictoriaLogs NodePort query API: <node-ip>:${node_port}/select/logsql/query"
  fi
}

build_longhorn_selector_values_file() {
  local selector="$1"
  local -a selector_pairs=()
  local values_file system_managed_selector

  parse_selector_pairs "$selector" selector_pairs || return 1
  if [[ ${#selector_pairs[@]} -eq 0 ]]; then
    echo "Error: LONGHORN_NODE_SELECTOR is set but has no valid key=value pairs." >&2
    return 1
  fi
  system_managed_selector="$(selector_pairs_to_longhorn_setting selector_pairs)"

  values_file="$(mktemp -t kubeton-longhorn-selector.XXXXXX.yaml)"
  {
    echo "global:"
    echo "  nodeSelector:"
    write_yaml_map_from_pairs selector_pairs 4
    echo "longhornManager:"
    echo "  nodeSelector:"
    write_yaml_map_from_pairs selector_pairs 4
    echo "longhornDriver:"
    echo "  nodeSelector:"
    write_yaml_map_from_pairs selector_pairs 4
    echo "longhornUI:"
    echo "  nodeSelector:"
    write_yaml_map_from_pairs selector_pairs 4
    # longhorn-csi-plugin is created dynamically by Longhorn rather than by a
    # Helm template. This setting must be present in the initial ConfigMap so
    # the manager creates CSI only on the selected nodes; applying it after
    # Longhorn is ready is too late to prevent a DiskPressure eviction.
    echo "defaultSettings:"
    echo "  systemManagedComponentsNodeSelector: $(yaml_quote "$system_managed_selector")"
  } >"$values_file"

  printf '%s' "$values_file"
}

