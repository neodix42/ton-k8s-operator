validator_build_values() {
  local ns="$1"
  local pod="$2"
  local output=""
  local commit=""
  local build_date=""

  output="$(run_with_timeout "$STATUS_EXEC_TIMEOUT" kubectl -n "$ns" exec "$pod" -- bash -lc '
    if [[ -x /usr/bin/ton/validator-engine/validator-engine ]]; then
      /usr/bin/ton/validator-engine/validator-engine -V 2>/dev/null | head -n1
    elif command -v validator-engine >/dev/null 2>&1; then
      validator-engine -V 2>/dev/null | head -n1
    else
      true
    fi
  ' 2>/dev/null || true)"
  output="${output//$'\r'/}"
  output="$(printf '%s' "$output" | sed -E $'s/\x1B\\[[0-9;]*[[:alpha:]]//g')"
  output="$(trim_whitespace "$output")"

  if [[ -n "$output" ]]; then
    commit="$(printf '%s\n' "$output" | sed -n 's/.*Commit:[[:space:]]*\([0-9a-fA-F]\{7,\}\).*/\1/p' | head -n1)"
    build_date="$(printf '%s\n' "$output" | sed -n 's/.*Date:[[:space:]]*\([^]]*\)].*/\1/p' | head -n1)"
  fi

  commit="$(trim_whitespace "$commit")"
  build_date="$(trim_whitespace "$build_date")"
  if [[ -z "$commit" ]]; then
    commit="N/A"
  else
    commit="${commit:0:7}"
  fi
  if [[ -z "$build_date" ]]; then
    build_date="N/A"
  fi
  printf '%s\t%s\n' "$commit" "$build_date"
}

status_collect_row() {
  local ns="$1"
  local pod="$2"
  local node_name="$3"
  local out_file="$4"
  local wallet_adnl=""
  local validator_build=""
  local commit_output="N/A"
  local date_output="N/A"
  local wallet_output="N/A"
  local adnl_output="N/A"
  local sync_output
  local cell_db_size
  local archive_db_size

  wallet_adnl="$(wallet_adnl_values "$ns" "$pod")"
  if [[ -n "$wallet_adnl" ]]; then
    IFS=$'\t' read -r wallet_output adnl_output <<<"$wallet_adnl"
  fi
  validator_build="$(validator_build_values "$ns" "$pod")"
  if [[ -n "$validator_build" ]]; then
    IFS=$'\t' read -r commit_output date_output <<<"$validator_build"
  fi
  sync_output="$(sync_value "$ns" "$pod")"
  [[ -z "$node_name" ]] && node_name="N/A"
  cell_db_size="$(folder_size_gb "$ns" "$pod" "/var/ton-work/db/celldb")"
  archive_db_size="$(folder_size_gb "$ns" "$pod" "/var/ton-work/db/archive")"

  commit_output="${commit_output//$'\t'/ }"
  date_output="${date_output//$'\t'/ }"
  wallet_output="${wallet_output//$'\t'/ }"
  adnl_output="${adnl_output//$'\t'/ }"
  sync_output="${sync_output//$'\t'/ }"
  cell_db_size="${cell_db_size//$'\t'/ }"
  archive_db_size="${archive_db_size//$'\t'/ }"

  printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
    "$node_name" "$pod" "$commit_output" "$date_output" "$wallet_output" "$adnl_output" "$sync_output" "$cell_db_size" "$archive_db_size" >"$out_file"
}

run_install() {
  require_bin helm
  require_bin kubectl
  local install_ready_timeout

  install_ready_timeout="$(trim_whitespace "${KUBETON_INSTALL_READY_TIMEOUT_SECONDS:-600}")"
  if ! [[ "$install_ready_timeout" =~ ^[1-9][0-9]*$ ]]; then
    echo "Error: invalid KUBETON_INSTALL_READY_TIMEOUT_SECONDS '${install_ready_timeout}'." >&2
    return 1
  fi
  if is_true "$KUBETON_SKIP_NODE_PREREQ_CHECK"; then
    echo "[check] KUBETON_SKIP_NODE_PREREQ_CHECK=true; skipping install-time node preflight." >&2
  else
    run_node_prerequisite_check_readonly || return 1
  fi

  local release_exists=0 operator_deployment=""
  local -a helm_cmd=()

  if helm -n "$OP_NAMESPACE" status "$RELEASE_NAME" >/dev/null 2>&1; then
    release_exists=1
  fi

  helm_cmd=(
    helm upgrade --install "$RELEASE_NAME" "$CHART_DIR"
    -n "$OP_NAMESPACE"
    --create-namespace
    -f "$OP_VALUES_FILE"
  )

  if (( release_exists == 1 )); then
    # Preserve current TonNode chart values during operator-only upgrades.
    helm_cmd+=(--reuse-values)
    # If no TonNode CRs exist, keep operator-only behavior and avoid accidental TonNode recreation
    # from reused values.
    if ! cluster_has_tonnodes; then
      helm_cmd+=(--set tonNode.enabled=false)
    fi
  fi

  append_helm_force_conflicts_if_supported helm_cmd
  "${helm_cmd[@]}"

  if ! operator_deployment="$(resolve_operator_controller_deployment_name)"; then
    echo "Error: cannot uniquely resolve the controller Deployment for Helm release ${OP_NAMESPACE}/${RELEASE_NAME}; inspect the launch evidence bundle." >&2
    return 1
  fi

  # Helm applying the Deployment is not evidence that its controller process
  # ever started. Keep the launch log watchers alive through the rollout and
  # make install fail when the operator cannot become Ready, leaving the
  # captured Pod/container/Event evidence available on the invoking host.
  echo "[install] Waiting for operator deployment ${OP_NAMESPACE}/${operator_deployment} to become Ready (timeout ${install_ready_timeout}s) ..."
  if ! kubectl -n "$OP_NAMESPACE" rollout status "deployment/${operator_deployment}" \
      --timeout="${install_ready_timeout}s"; then
    echo "Error: operator deployment ${OP_NAMESPACE}/${operator_deployment} did not become Ready; inspect the launch evidence bundle." >&2
    return 1
  fi
  echo "[install] Operator deployment is Ready."
}

fleet_has_stop_annotations() {
  local -a sts_rows=()
  local row ns sts pause_annotation

  mapfile -t sts_rows < <(list_ton_statefulsets 2>/dev/null || true)
  if [[ ${#sts_rows[@]} -eq 0 || -z "${sts_rows[0]}" ]]; then
    return 1
  fi

  for row in "${sts_rows[@]}"; do
    [[ -z "$row" ]] && continue
    IFS=$'\t' read -r ns sts _ <<<"$row"
    [[ -z "$ns" || -z "$sts" ]] && continue

    pause_annotation="$(get_annotation_value statefulset "$ns" "$sts" "$KUBETON_PAUSE_ANNOTATION_KEY")"
    if [[ "$pause_annotation" =~ ^[0-9]+$ ]]; then
      return 0
    fi

    if kubectl -n "$ns" get tonnodes.ton.ton.org "$sts" >/dev/null 2>&1; then
      pause_annotation="$(get_annotation_value tonnodes.ton.ton.org "$ns" "$sts" "$KUBETON_PAUSE_ANNOTATION_KEY")"
      if [[ "$pause_annotation" =~ ^[0-9]+$ ]]; then
        return 0
      fi
    fi
  done

  return 1
}

run_bootstrap_baremetal() {
  require_bin kubectl
  require_bin helm
  local replicas=""
  local bootstrap_uses_longhorn="true"

  if ! cluster_is_baremetal && ! cluster_is_k3d && ! is_true "$FORCE_BAREMETAL_BOOTSTRAP"; then
    echo "Cluster looks like cloud/managed (not bare-metal/local k3d)."
    echo "Use FORCE_BAREMETAL_BOOTSTRAP=true if you really want to bootstrap Longhorn+Vault here."
    exit 1
  fi

  replicas="$(resolve_ton_replicas_for_node_check || true)"
  if ! [[ "$replicas" =~ ^[1-9][0-9]*$ ]]; then
    echo "Error: cannot resolve tonNode.replicas from ${TON_VALUES_FILE}." >&2
    return 1
  fi
  KUBETON_TARGET_TON_REPLICAS="$replicas"
  if cluster_is_k3d; then
    bootstrap_uses_longhorn="false"
  fi
  prepare_node_prerequisites_for_workload "$replicas" "$bootstrap_uses_longhorn" || return 1

  ensure_auto_bootstrap_stack
  echo "[bootstrap] Completed."
}

run_start() {
  require_bin helm
  require_bin kubectl

  if [[ $# -ne 0 ]]; then
    echo "Error: usage: kubeton start" >&2
    exit 1
  fi

  local desired_replicas_for_start=""
  local restore_from_stop_metadata=0
  local -a extra_overrides=()
  local ton_selector_values_file=""
  local -a helm_cmd=()
  local helm_rc=0
  local sequential_start=0
  local bootstrap_required=0
  local preflight_uses_longhorn="false"

  desired_replicas_for_start="$(resolve_ton_replicas_from_values_file "$TON_VALUES_FILE" || true)"
  if ! [[ "$desired_replicas_for_start" =~ ^[1-9][0-9]*$ ]]; then
    desired_replicas_for_start="$(resolve_ton_replicas_from_values_file "$CHART_DIR/values.yaml" || true)"
  fi
  if ! [[ "$desired_replicas_for_start" =~ ^[1-9][0-9]*$ ]]; then
    echo "Error: cannot resolve tonNode.replicas from ${TON_VALUES_FILE}." >&2
    return 1
  fi
  KUBETON_TARGET_TON_REPLICAS="$desired_replicas_for_start"

  if should_bootstrap_baremetal; then
    bootstrap_required=1
  fi
  # Local k3d uses a local encrypted StorageClass and intentionally skips
  # Longhorn. Bare-metal bootstrap, an existing manager, or an already
  # Longhorn-backed encrypted StorageClass each require the per-node CSI gate.
  if { (( bootstrap_required == 1 )) && ! cluster_is_k3d; } \
    || longhorn_manager_exists \
    || storage_class_is_longhorn "$ENCRYPTED_SC_NAME"; then
    preflight_uses_longhorn="true"
  fi
  if is_true "$preflight_uses_longhorn"; then
    prepare_node_prerequisites_for_workload "$desired_replicas_for_start" true || return 1
  else
    prepare_node_prerequisites_for_workload "$desired_replicas_for_start" false || return 1
  fi
  if [[ -n "$KUBETON_NODE_CHECK_TON_SELECTOR" ]]; then
    ton_selector_values_file="$(build_ton_node_selector_values_file "$KUBETON_NODE_CHECK_TON_SELECTOR")" || return 1
    extra_overrides+=(-f "$ton_selector_values_file")
  fi

  if fleet_has_stop_annotations; then
    restore_from_stop_metadata=1
    echo "[start] Detected stopped TON fleet metadata; applying chart update before restoring previous replicas."
  fi

  ensure_ton_storage_class_available
  append_ton_storage_overrides extra_overrides
  if should_use_sequential_ton_start "$desired_replicas_for_start" "$restore_from_stop_metadata"; then
    sequential_start=1
    if ! is_true "$KUBETON_SEQUENTIAL_TON_START"; then
      echo "[start] Local-path TON storage detected; staging fresh TON replicas sequentially to prevent PVC/node drift."
    fi
  fi

  if (( bootstrap_required == 1 )); then
    # The backend may itself need Longhorn, but the collector has only local
    # hostPath dependencies. Start it first so Longhorn/Vault container logs
    # are queued locally even before the VictoriaLogs Service can exist.
    if ! ensure_start_victoria_logs_buffering_collector; then
      if [[ -n "$ton_selector_values_file" ]]; then
        rm -f "$ton_selector_values_file" >/dev/null 2>&1 || true
      fi
      return 1
    fi
    ensure_auto_bootstrap_stack
    append_baremetal_key_overrides extra_overrides
    if [[ -z "$ton_selector_values_file" ]] && ! cluster_is_k3d && [[ -n "${LONGHORN_NODE_SELECTOR:-}" ]]; then
      ton_selector_values_file="$(build_ton_node_selector_values_file "$LONGHORN_NODE_SELECTOR")"
      extra_overrides+=(-f "$ton_selector_values_file")
    fi

    # Longhorn/Vault bootstrap can take several minutes and consumes disk on
    # the selected nodes.  Refresh the same read-only gate before stale PVC
    # cleanup or Helm can create a TonNode pod; do not silently reuse a node
    # that only passed before bootstrap.
    if ! is_true "$KUBETON_SKIP_NODE_PREREQ_CHECK"; then
      echo "[check] Rechecking selected TON nodes after storage/key bootstrap ..."
      if ! run_node_prerequisite_check "$KUBETON_NODE_CHECK_REQUIRED_NODES" "$KUBETON_NODE_CHECK_TON_SELECTOR"; then
        echo "Error: selected TON nodes no longer meet bootstrap requirements; TON deployment was not applied." >&2
        if [[ -n "$ton_selector_values_file" ]]; then
          rm -f "$ton_selector_values_file" >/dev/null 2>&1 || true
        fi
        return 1
      fi
      if ! node_check_selector_is_all_compatible "$KUBETON_NODE_CHECK_TON_SELECTOR"; then
        echo "Error: the selected TON node selector now includes a node that no longer meets bootstrap requirements; TON deployment was not applied." >&2
        node_check_print_failed_selector_nodes "$KUBETON_NODE_CHECK_TON_SELECTOR"
        if [[ -n "$ton_selector_values_file" ]]; then
          rm -f "$ton_selector_values_file" >/dev/null 2>&1 || true
        fi
        return 1
      fi
    fi
  else
    validate_external_key_prereqs
  fi

  # The aggregate Longhorn readiness wait proves that some CSI nodes are
  # registered, but it cannot prove that every node selected for this TON
  # StatefulSet has driver.longhorn.io. Check the actual placement selector
  # before PVC cleanup or Helm can create a pod that later fails to attach its
  # encrypted key-bundle PVC. When an explicit preflight was skipped and no
  # selector is available, the helper deliberately checks every node: that is
  # the only safe interpretation of an unconstrained TON placement.
  if is_true "$preflight_uses_longhorn"; then
    if ! wait_ton_selected_nodes_longhorn_csi_ready "$KUBETON_NODE_CHECK_TON_SELECTOR"; then
      if [[ -n "$ton_selector_values_file" ]]; then
        rm -f "$ton_selector_values_file" >/dev/null 2>&1 || true
      fi
      return 1
    fi
  fi

  # Container restart history must be collected before the first TON Pod is
  # created. Kubernetes only exposes one previous container generation, so a
  # logging stack installed after a failed bootstrap cannot reconstruct it.
  if ! ensure_start_victoria_logs; then
    if [[ -n "$ton_selector_values_file" ]]; then
      rm -f "$ton_selector_values_file" >/dev/null 2>&1 || true
    fi
    return 1
  fi

  if (( restore_from_stop_metadata == 0 )); then
    delete_stale_ton_pvcs_before_fresh_start
  fi

  # Stale-PVC reconciliation and CSI recovery can take long enough for node
  # pressure or HostPort reservations to change after the earlier checks.
  # Refresh every deployment prerequisite after cleanup and as close to Helm
  # as possible.  Waiting for CSI comes first because it may consume most of
  # the timeout; the final immediate probe then catches a registration which
  # disappears while the resource/HostPort check is running.
  if is_true "$preflight_uses_longhorn"; then
    if ! wait_ton_selected_nodes_longhorn_csi_ready "$KUBETON_NODE_CHECK_TON_SELECTOR"; then
      if [[ -n "$ton_selector_values_file" ]]; then
        rm -f "$ton_selector_values_file" >/dev/null 2>&1 || true
      fi
      return 1
    fi
  fi
  if ! is_true "$KUBETON_SKIP_NODE_PREREQ_CHECK"; then
    echo "[check] Rechecking selected TON nodes immediately before TON deployment ..."
    if ! run_node_prerequisite_check "$KUBETON_NODE_CHECK_REQUIRED_NODES" "$KUBETON_NODE_CHECK_TON_SELECTOR"; then
      echo "Error: selected TON nodes no longer meet deployment requirements; TON deployment was not applied." >&2
      if [[ -n "$ton_selector_values_file" ]]; then
        rm -f "$ton_selector_values_file" >/dev/null 2>&1 || true
      fi
      return 1
    fi
    if [[ -n "$KUBETON_NODE_CHECK_TON_SELECTOR" ]] \
      && ! node_check_selector_is_all_compatible "$KUBETON_NODE_CHECK_TON_SELECTOR"; then
      echo "Error: the TON node selector includes a node that no longer meets deployment requirements; TON deployment was not applied." >&2
      node_check_print_failed_selector_nodes "$KUBETON_NODE_CHECK_TON_SELECTOR"
      if [[ -n "$ton_selector_values_file" ]]; then
        rm -f "$ton_selector_values_file" >/dev/null 2>&1 || true
      fi
      return 1
    fi
  fi
  if is_true "$preflight_uses_longhorn"; then
    if ! verify_ton_selected_nodes_longhorn_csi_ready "$KUBETON_NODE_CHECK_TON_SELECTOR"; then
      if [[ -n "$ton_selector_values_file" ]]; then
        rm -f "$ton_selector_values_file" >/dev/null 2>&1 || true
      fi
      return 1
    fi
  fi
  # Storage cleanup and readiness waits can take long enough for a collector
  # to be evicted after the initial VictoriaLogs installation. Narrow that
  # race with one final exact coverage probe immediately before Helm can
  # create or restart TON Pods.
  if ! verify_start_victoria_logs_collection_ready; then
    if [[ -n "$ton_selector_values_file" ]]; then
      rm -f "$ton_selector_values_file" >/dev/null 2>&1 || true
    fi
    return 1
  fi

  helm_cmd=(
    helm upgrade "$RELEASE_NAME" "$CHART_DIR"
    -n "$OP_NAMESPACE"
    -f "$OP_VALUES_FILE"
    -f "$TON_VALUES_FILE"
  )

  helm_cmd+=("${extra_overrides[@]}")
  if (( sequential_start == 1 )); then
    helm_cmd+=(--set tonNode.replicas=1)
  fi
  append_helm_force_conflicts_if_supported helm_cmd

  "${helm_cmd[@]}" || helm_rc=$?

  if (( helm_rc != 0 )); then
    if [[ -n "$ton_selector_values_file" ]]; then
      rm -f "$ton_selector_values_file" >/dev/null 2>&1 || true
    fi
    return "$helm_rc"
  fi
  if (( sequential_start == 1 )); then
    sequential_start_ton_fleet "$desired_replicas_for_start" || {
      if [[ -n "$ton_selector_values_file" ]]; then
        rm -f "$ton_selector_values_file" >/dev/null 2>&1 || true
      fi
      return 1
    }
    helm_cmd=(
      helm upgrade "$RELEASE_NAME" "$CHART_DIR"
      -n "$OP_NAMESPACE"
      -f "$OP_VALUES_FILE"
      -f "$TON_VALUES_FILE"
    )
    helm_cmd+=("${extra_overrides[@]}")
    helm_cmd+=(--set "tonNode.replicas=${desired_replicas_for_start}")
    append_helm_force_conflicts_if_supported helm_cmd
    "${helm_cmd[@]}" >/dev/null || helm_rc=$?
  fi
  if [[ -n "$ton_selector_values_file" ]]; then
    rm -f "$ton_selector_values_file" >/dev/null 2>&1 || true
  fi
  if (( helm_rc != 0 )); then
    return "$helm_rc"
  fi
  if (( restore_from_stop_metadata == 1 )); then
    local restore_operator_deployment=""
    restore_operator_deployment="$(resolve_operator_controller_deployment_name || true)"
    if [[ -z "$restore_operator_deployment" ]] \
      || ! kubectl -n "$OP_NAMESPACE" rollout status "deployment/${restore_operator_deployment}" --timeout=300s >/dev/null 2>&1; then
      echo "Warning: operator deployment for Helm release ${OP_NAMESPACE}/${RELEASE_NAME} did not report Ready before TON restore; continuing." >&2
    fi
    recreate_stopped_statefulsets_missing_dedicated_pvcs
    run_start_stopped_fleet
  fi

  repair_pending_ton_placement_after_start || return 1

  if is_true "$KUBETON_START_WAIT_FOR_BOOTSTRAP"; then
    local target_ns target_name
    target_ns="$(resolve_tonnode_namespace_from_values)"
    target_name="$(resolve_tonnode_name_from_values)"
    wait_ton_initial_bootstrap_complete \
      "$target_ns" "$target_name" "$desired_replicas_for_start" "$KUBETON_START_READY_TIMEOUT_SECONDS"
  else
    echo "[start] KUBETON_START_WAIT_FOR_BOOTSTRAP=false; TON was applied without waiting for the MyTonCtrl bootstrap commit." >&2
  fi
}

run_backup_keys() {
  require_bin kubectl
  require_bin sha256sum
  require_bin date

  local default_output_root
  default_output_root="$(cd "$CHART_DIR/.." && pwd)/key-backups"
  local output_dir="${1:-$default_output_root/$(date -u +%Y%m%dT%H%M%SZ)}"
  if [[ $# -gt 1 ]]; then
    echo "Error: usage: kubeton backup-keys [output-dir]" >&2
    exit 1
  fi

  local -a sts_rows=()
  mapfile -t sts_rows < <(list_ton_statefulsets)
  if [[ ${#sts_rows[@]} -eq 0 || -z "${sts_rows[0]}" ]]; then
    echo "No TON StatefulSets found."
    return
  fi

  confirm_or_exit "This will trigger encrypted backup in each TON pod, scale StatefulSets to 0, export bundles, then scale back. Continue?"
  mkdir -p "$output_dir"

  local -a ns_list=()
  local -a sts_list=()
  local -a replicas_list=()
  local -A ordinal_node_maps=()
  local -A helper_nodes_by_replica=()
  local -a operator_deploy_names=()
  local -a operator_deploy_replicas=()
  local row ns sts replicas i ordinal pod node_map_key node_map
  local operator_paused=0
  for row in "${sts_rows[@]}"; do
    [[ -z "$row" ]] && continue
    IFS=$'\t' read -r ns sts replicas <<<"$row"
    replicas="$(trim_whitespace "${replicas:-0}")"
    if ! [[ "$replicas" =~ ^[0-9]+$ ]]; then
      replicas=0
    fi
    ns_list+=("$ns")
    sts_list+=("$sts")
    replicas_list+=("$replicas")
    if (( replicas > 0 )); then
      node_map_key="${ns}/${sts}"
      node_map="$(build_sts_ordinal_node_map "$ns" "$sts" "$replicas" || true)"
      node_map="$(trim_whitespace "$node_map")"
      if [[ -n "$node_map" ]]; then
        ordinal_node_maps["$node_map_key"]="$node_map"
      fi
    fi
  done

  local restore_required=1
  cleanup_restore() {
    [[ "${restore_required:-0}" -ne 1 ]] && return 0
    local i ns sts replicas node_map_key node_map
    local -a expected_nodes=()
    for i in "${!sts_list[@]}"; do
      ns="${ns_list[$i]}"
      sts="${sts_list[$i]}"
      replicas="${replicas_list[$i]}"
      if [[ "$replicas" =~ ^[1-9][0-9]*$ ]]; then
        node_map_key="${ns}/${sts}"
        node_map="${ordinal_node_maps[$node_map_key]:-}"
        expected_nodes=()
        if [[ -n "$node_map" ]] \
          && parse_ordinal_node_map "$node_map" expected_nodes \
          && (( ${#expected_nodes[@]} >= replicas )) \
          && restore_statefulset_with_expected_nodes "$ns" "$sts" "$replicas" expected_nodes >/dev/null 2>&1; then
          continue
        fi
      fi
      set_ton_replicas "$ns" "$sts" "$replicas" >/dev/null 2>&1 || true
    done
    if [[ "${operator_paused:-0}" -eq 1 ]]; then
      resume_operator_reconcile operator_deploy_names operator_deploy_replicas || true
    fi
  }
  trap cleanup_restore EXIT INT TERM

  echo "Triggering manual encrypted bundle backup in each TON pod (parallel) ..."
  local -a trigger_pids=()
  local -a trigger_descs=()
  for i in "${!sts_list[@]}"; do
    ns="${ns_list[$i]}"
    sts="${sts_list[$i]}"
    replicas="${replicas_list[$i]}"
    if ! [[ "$replicas" =~ ^[0-9]+$ ]]; then
      replicas=0
    fi
    if (( replicas == 0 )); then
      continue
    fi

    for ordinal in $(seq 0 $((replicas - 1))); do
      pod="${sts}-${ordinal}"
      local helper_key="${ns}/${sts}/${ordinal}"
      local pod_node=""
      pod_node="$(kubectl -n "$ns" get pod "$pod" -o jsonpath='{.spec.nodeName}' 2>/dev/null || true)"
      pod_node="$(trim_whitespace "$pod_node")"
      if [[ -n "$pod_node" ]]; then
        helper_nodes_by_replica["$helper_key"]="$pod_node"
      fi
      trigger_key_backup_once "$ns" "$pod" &
      trigger_pids+=("$!")
      trigger_descs+=("${ns}/${pod}")
    done
  done

  local trigger_failed=0
  for i in "${!trigger_pids[@]}"; do
    if ! wait "${trigger_pids[$i]}"; then
      echo "Error: key backup trigger failed for ${trigger_descs[$i]}." >&2
      trigger_failed=1
    fi
  done
  if [[ "$trigger_failed" -ne 0 ]]; then
    echo "Error: one or more pod backup triggers failed." >&2
    return 1
  fi

  pause_operator_reconcile operator_deploy_names operator_deploy_replicas
  operator_paused=1

  echo "Scaling TON StatefulSets to 0 ..."
  for i in "${!sts_list[@]}"; do
    set_ton_replicas "${ns_list[$i]}" "${sts_list[$i]}" 0
  done
  for i in "${!sts_list[@]}"; do
    wait_statefulset_pods_gone "${ns_list[$i]}" "${sts_list[$i]}"
  done

  echo "Exporting encrypted bundles to $output_dir (parallel) ..."
  local -a export_pids=()
  local -a export_descs=()
  for i in "${!sts_list[@]}"; do
    ns="${ns_list[$i]}"
    sts="${sts_list[$i]}"
    replicas="${replicas_list[$i]}"

    if ! [[ "$replicas" =~ ^[0-9]+$ ]]; then
      replicas=0
    fi
    if (( replicas == 0 )); then
      continue
    fi

    for ordinal in $(seq 0 $((replicas - 1))); do
      local helper_key="${ns}/${sts}/${ordinal}"
      local helper_node="${helper_nodes_by_replica[$helper_key]:-}"
      export_bundle_from_pvc "$ns" "$sts" "$ordinal" "$output_dir" "$helper_node" &
      export_pids+=("$!")
      export_descs+=("${ns}/${sts}/${ordinal}")
    done
  done

  local export_failed=0
  for i in "${!export_pids[@]}"; do
    if ! wait "${export_pids[$i]}"; then
      echo "Error: encrypted bundle export failed for ${export_descs[$i]}." >&2
      export_failed=1
    fi
  done
  if [[ "$export_failed" -ne 0 ]]; then
    echo "Error: one or more encrypted bundle exports failed." >&2
    return 1
  fi

  echo "Restoring TON StatefulSets replicas with sticky node placement ..."
  local sticky_restore_count=0
  local sticky_restore_failed=0
  local -a expected_nodes=()
  for i in "${!sts_list[@]}"; do
    ns="${ns_list[$i]}"
    sts="${sts_list[$i]}"
    replicas="${replicas_list[$i]}"
    if ! [[ "$replicas" =~ ^[0-9]+$ ]]; then
      replicas=0
    fi
    if (( replicas == 0 )); then
      set_ton_replicas "$ns" "$sts" 0
      continue
    fi

    node_map_key="${ns}/${sts}"
    node_map="${ordinal_node_maps[$node_map_key]:-}"
    if [[ -z "$node_map" ]]; then
      echo "Error: missing pre-backup ordinal->node map for ${ns}/${sts}; refusing non-sticky restore." >&2
      ((sticky_restore_failed+=1))
      continue
    fi

    expected_nodes=()
    if ! parse_ordinal_node_map "$node_map" expected_nodes; then
      echo "Error: invalid pre-backup ordinal->node map for ${ns}/${sts}; refusing non-sticky restore." >&2
      ((sticky_restore_failed+=1))
      continue
    fi
    if (( ${#expected_nodes[@]} < replicas )); then
      echo "Error: incomplete pre-backup ordinal->node map for ${ns}/${sts} (have ${#expected_nodes[@]}, need ${replicas})." >&2
      ((sticky_restore_failed+=1))
      continue
    fi
    if restore_statefulset_with_expected_nodes "$ns" "$sts" "$replicas" expected_nodes; then
      ((sticky_restore_count+=1))
    else
      echo "Error: failed sticky-node restore for ${ns}/${sts} after backup." >&2
      ((sticky_restore_failed+=1))
    fi
  done
  echo "Backup node placement summary: restored=${sticky_restore_count}, failed=${sticky_restore_failed}"
  if (( sticky_restore_failed > 0 )); then
    return 1
  fi
  if [[ "$operator_paused" -eq 1 ]]; then
    resume_operator_reconcile operator_deploy_names operator_deploy_replicas
    operator_paused=0
  fi

  restore_required=0
  trap - EXIT INT TERM
  echo "Encrypted key bundle backup complete: $output_dir"
}

