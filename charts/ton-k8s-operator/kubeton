resolve_tonnode_image_from_values_file() {
  local values_file="$1"
  local image=""

  [[ -f "$values_file" ]] || return 1
  image="$(awk '
    /^[[:space:]]*tonNode:[[:space:]]*$/ {in_ton=1; next}
    in_ton && /^[^[:space:]]/ {in_ton=0}
    in_ton && /^  image:[[:space:]]*/ {
      sub(/^  image:[[:space:]]*/, "", $0)
      sub(/[[:space:]]*#.*/, "", $0)
      gsub(/^"/, "", $0)
      gsub(/"$/, "", $0)
      gsub(/^'\''/, "", $0)
      gsub(/'\''$/, "", $0)
      print $0
      exit
    }
  ' "$values_file" 2>/dev/null || true)"
  image="$(trim_whitespace "$image")"
  [[ -n "$image" ]] || return 1
  printf '%s' "$image"
}

