  cleanup_prometheus_resources || true
  cleanup_grafana_resources || true
  cleanup_victoria_metrics_resources || rc=1
  cleanup_main_wallet_resources || true
  cleanup_kubeton_managed_labeled_resources || true
  return "$rc"
}

collect_labeled_resource_leftovers() {
  local selector="$1"
  local rows_name="$2"
  local -n rows_ref="$rows_name"
  local resource ns name

  selector="$(trim_whitespace "$selector")"
  [[ -n "$selector" ]] || return 0

  while IFS= read -r resource; do
    resource="$(trim_whitespace "$resource")"
    [[ -z "$resource" ]] && continue
    while IFS= read -r line; do
      [[ -z "$line" ]] && continue
      ns="${line%%[[:space:]]*}"
      name="${line#*[[:space:]]}"
      ns="$(trim_whitespace "$ns")"
      name="$(trim_whitespace "$name")"
      [[ -z "$name" || "$name" == "<none>" ]] && continue
      append_unique_item "${resource} ${ns}/${name}" rows_ref
    done < <(
      kubectl get "$resource" -A -l "$selector" --no-headers \
        -o custom-columns='NS:.metadata.namespace,NAME:.metadata.name' 2>/dev/null || true
    )
  done < <(kubectl api-resources --verbs=list --namespaced=true -o name 2>/dev/null || true)

  while IFS= read -r resource; do
    resource="$(trim_whitespace "$resource")"
    [[ -z "$resource" ]] && continue
    while IFS= read -r name; do
      name="$(trim_whitespace "$name")"
      [[ -z "$name" || "$name" == "<none>" ]] && continue
      append_unique_item "${resource} ${name}" rows_ref
    done < <(
      kubectl get "$resource" -l "$selector" --no-headers \
        -o custom-columns='NAME:.metadata.name' 2>/dev/null || true
    )
  done < <(kubectl api-resources --verbs=list --namespaced=false -o name 2>/dev/null || true)
}

collect_uninstall_leftovers() {
  local rows_name="$1"
  local -n rows_ref="$rows_name"
  local ns name row release collector service_name pvc
  local -a candidate_pvcs=()
  local -a existing_pvcs=()
  local -a single_release_rows=()
  local -a collector_release_rows=()
  local -a vlogs_pvc_rows=()

  while IFS=$'\t' read -r ns name; do
    ns="$(trim_whitespace "$ns")"
    name="$(trim_whitespace "$name")"
    [[ -n "$ns" && -n "$name" ]] && append_unique_item "TonNode ${ns}/${name}" rows_ref
  done < <(
    kubectl get tonnodes.ton.ton.org -A -o jsonpath='{range .items[*]}{.metadata.namespace}{"\t"}{.metadata.name}{"\n"}{end}' 2>/dev/null || true
  )

  while IFS=$'\t' read -r ns name; do
    ns="$(trim_whitespace "$ns")"
    name="$(trim_whitespace "$name")"
    [[ -n "$ns" && -n "$name" ]] && append_unique_item "StatefulSet ${ns}/${name}" rows_ref
  done < <(list_ton_statefulsets 2>/dev/null || true)

  collect_expected_ton_pvc_rows_from_values candidate_pvcs
  collect_labeled_ton_pvc_rows candidate_pvcs
  collect_existing_kubeton_pvc_rows candidate_pvcs existing_pvcs "uninstall"
  for row in "${existing_pvcs[@]}"; do
    [[ -z "$row" ]] && continue
    IFS=$'\t' read -r ns pvc <<<"$row"
    [[ -n "$ns" && -n "$pvc" ]] && append_unique_item "PVC ${ns}/${pvc}" rows_ref
  done

  # A persisted ledger means host-path cleanup was not verified.  Keep this in
  # the final report so uninstall never claims success while node-local data is
  # still pending a retry.
  collect_local_path_cleanup_ledger_leftovers "$rows_name"

  for ns in "$OP_NAMESPACE" "$VAULT_NAMESPACE" "$LONGHORN_NAMESPACE"; do
    ns="$(trim_whitespace "$ns")"
    [[ -z "$ns" ]] && continue
    if kubectl get namespace "$ns" >/dev/null 2>&1; then
      append_unique_item "Namespace ${ns}" rows_ref
    fi
  done

  if kubectl get storageclass "$ENCRYPTED_SC_NAME" >/dev/null 2>&1; then
    append_unique_item "StorageClass ${ENCRYPTED_SC_NAME}" rows_ref
  fi

  if command -v helm >/dev/null 2>&1; then
    helm status "$RELEASE_NAME" -n "$OP_NAMESPACE" >/dev/null 2>&1 && append_unique_item "HelmRelease ${OP_NAMESPACE}/${RELEASE_NAME}" rows_ref
    helm status "$VAULT_RELEASE_NAME" -n "$VAULT_NAMESPACE" >/dev/null 2>&1 && append_unique_item "HelmRelease ${VAULT_NAMESPACE}/${VAULT_RELEASE_NAME}" rows_ref
    helm status "$LONGHORN_RELEASE_NAME" -n "$LONGHORN_NAMESPACE" >/dev/null 2>&1 && append_unique_item "HelmRelease ${LONGHORN_NAMESPACE}/${LONGHORN_RELEASE_NAME}" rows_ref
  fi

  if ! collect_victoria_logs_release_rows single_release_rows collector_release_rows; then
    append_unique_item "VictoriaLogs cleanup inventory unavailable" rows_ref
  fi
  for row in "${single_release_rows[@]}"; do
    [[ -z "$row" ]] && continue
    IFS=$'\t' read -r ns release <<<"$row"
    ns="$(trim_whitespace "$ns")"
    release="$(trim_whitespace "$release")"
    [[ -z "$ns" || -z "$release" ]] && continue
    if command -v helm >/dev/null 2>&1 && helm status "$release" -n "$ns" >/dev/null 2>&1; then
      append_unique_item "HelmRelease ${ns}/${release}" rows_ref
    fi
    service_name="$(victoria_logs_service_name "$release")"
    collect_pvc_rows_by_prefix "server-volume-${service_name}-" vlogs_pvc_rows "app.kubernetes.io/name=victoria-logs-single,app.kubernetes.io/instance=${release}"
  done
  for row in "${collector_release_rows[@]}"; do
    [[ -z "$row" ]] && continue
    IFS=$'\t' read -r ns collector <<<"$row"
    ns="$(trim_whitespace "$ns")"
    collector="$(trim_whitespace "$collector")"
    [[ -z "$ns" || -z "$collector" ]] && continue
    if command -v helm >/dev/null 2>&1 && helm status "$collector" -n "$ns" >/dev/null 2>&1; then
      append_unique_item "HelmRelease ${ns}/${collector}" rows_ref
    fi
  done
  for row in "${vlogs_pvc_rows[@]}"; do
    [[ -z "$row" ]] && continue
    IFS=$'\t' read -r ns pvc <<<"$row"
    [[ -n "$ns" && -n "$pvc" ]] && append_unique_item "PVC ${ns}/${pvc}" rows_ref
  done

  while IFS= read -r name; do
    name="$(trim_whitespace "$name")"
    [[ -n "$name" ]] && append_unique_item "CRD ${name#customresourcedefinition.apiextensions.k8s.io/}" rows_ref
  done < <(kubectl get crd -o name 2>/dev/null | grep 'operator.victoriametrics.com' || true)

  collect_labeled_resource_leftovers 'app.kubernetes.io/managed-by=kubeton' "$rows_name"
}

verify_uninstall_leftovers() {
  local -a leftovers=()
  local item

  collect_uninstall_leftovers leftovers
  if [[ ${#leftovers[@]} -eq 0 ]]; then
    echo "[uninstall] No kubeton-managed leftovers found."
    return 0
  fi

  echo "Warning: kubeton uninstall removed as much as possible, but these resources still remain:" >&2
  for item in "${leftovers[@]}"; do
    [[ -z "$item" ]] && continue
    echo "  - ${item}" >&2
  done
  echo "Run './kubeton uninstall' again after Kubernetes finishes terminating resources. If the same items remain repeatedly, inspect their finalizers/events." >&2
  return 1
}

run_uninstall_core() {
  local -a uninstall_sts_rows=()
  local -a uninstall_failures=()
  local item

  mapfile -t uninstall_sts_rows < <(list_ton_statefulsets 2>/dev/null || true)

  run_uninstall_step uninstall_failures "Step 1/10: stopping TON resources and waiting for pods to terminate ..." \
    stop_ton_for_destructive_cleanup uninstall_sts_rows

  run_uninstall_step uninstall_failures "Step 2/10: deleting TON PVCs and backing storage ..." \
    delete_ton_pvcs_for_statefulsets uninstall_sts_rows "uninstall"

  run_uninstall_step uninstall_failures "Step 3/10: cleaning leftover kubectl debug pods ..." \
    cleanup_kubectl_debug_pods

  run_uninstall_step uninstall_failures "Step 4/10: deleting kubeton-managed observability, VictoriaLogs, and wallet helper resources ..." \
    cleanup_observability_resources

  run_uninstall_step uninstall_failures "Step 5/10: uninstalling operator Helm release ${RELEASE_NAME} ..." \
    cleanup_operator_release

  run_uninstall_step uninstall_failures "Step 6/10: uninstalling Vault release ${VAULT_RELEASE_NAME} ..." \
    cleanup_vault_release

  run_uninstall_step uninstall_failures "Step 7/10: deleting StorageClass ${ENCRYPTED_SC_NAME} ..." \
    cleanup_encrypted_storage_class

  run_uninstall_step uninstall_failures "Step 8/10: retrying any recorded TON PVC and backing-storage cleanup ..." \
    delete_stale_ton_pvcs_without_fleet "uninstall" true

  run_uninstall_step uninstall_failures "Step 9/10: uninstalling Longhorn release ${LONGHORN_RELEASE_NAME} ..." \
    cleanup_longhorn_release

  run_uninstall_step uninstall_failures "Step 10/10: final kubeton-managed resource sweep ..." \
    cleanup_kubeton_managed_labeled_resources

  cleanup_kubectl_debug_pods "uninstall" || true

  if ! verify_uninstall_leftovers; then
    if [[ ${#uninstall_failures[@]} -gt 0 ]]; then
      echo "Uninstall steps that reported errors before the leftover check:" >&2
      for item in "${uninstall_failures[@]}"; do
        [[ -z "$item" ]] && continue
        echo "  - ${item}" >&2
      done
    fi
    return 1
  fi

  if [[ ${#uninstall_failures[@]} -gt 0 ]]; then
    echo "Warning: some uninstall steps reported errors even though no Kubernetes leftovers were found:" >&2
    for item in "${uninstall_failures[@]}"; do
      [[ -z "$item" ]] && continue
      echo "  - ${item}" >&2
    done
    echo "Uninstall is not marked complete; rerun './kubeton uninstall' after resolving the reported cleanup errors." >&2
    return 1
  fi

  echo "[uninstall] Uninstall complete."
}

run_uninstall() {
  require_bin helm
  require_bin kubectl
  confirm_or_exit "WARNING: This will stop/delete TON pods and PVCs, purge known backing storage, remove kubeton-managed observability/VictoriaLogs/wallet/debug resources, uninstall operator, uninstall Longhorn release ${LONGHORN_RELEASE_NAME}, uninstall Vault release ${VAULT_RELEASE_NAME}, and delete StorageClass ${ENCRYPTED_SC_NAME}. TonNode CRD is kept. kubeton will continue cleanup after step errors and report any leftovers to rerun uninstall for. Continue?"
  run_uninstall_core
}

run_purge() {
  require_bin helm
  require_bin kubectl
  confirm_or_exit "DANGER: purge runs full uninstall (including kubeton-managed Prometheus/Grafana/VictoriaMetrics/VictoriaLogs cleanup) and also deletes CRD tonnodes.ton.ton.org (cluster-scoped). This is separated from uninstall to avoid accidental cluster-wide CRD removal. Continue?"
  local uninstall_rc=0
  local purge_rc=0
  run_uninstall_core || uninstall_rc=$?
  echo "[purge] Deleting CRD tonnodes.ton.ton.org ..."
  kubectl delete crd tonnodes.ton.ton.org --ignore-not-found || true

  if kubectl get crd tonnodes.ton.ton.org >/dev/null 2>&1; then
    echo "Warning: TonNode CRD tonnodes.ton.ton.org still exists after purge attempted to delete it." >&2
    purge_rc=1
  fi

  if (( uninstall_rc != 0 )); then
    echo "[purge] Rechecking leftovers after TonNode CRD deletion ..."
    verify_uninstall_leftovers || true
    purge_rc=1
  fi

  if (( purge_rc != 0 )); then
    echo "Warning: purge removed as much as possible, but leftovers remain. Run './kubeton uninstall' again after Kubernetes finishes terminating resources." >&2
    return "$purge_rc"
  fi
  echo "[purge] Completed."
}

