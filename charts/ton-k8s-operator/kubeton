s=json.load(sys.stdin); name,node,image,stage,ordinal=sys.argv[1:]; spec=s["spec"]["template"]["spec"]; agent=next(c for c in spec["containers"] if c["name"]=="key-backup"); main=next(c for c in spec["containers"] if c["name"]=="ton-node")
volumes=[{"name":"recovery","emptyDir":{"medium":"Memory"}},{"name":"scratch","emptyDir":{"medium":"Memory"}}]; mounts=[{"name":"recovery","mountPath":"/recovery"},{"name":"scratch","mountPath":"/tmp"}]
