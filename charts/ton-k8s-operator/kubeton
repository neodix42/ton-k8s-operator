wait_victoria_logs_backend_gone() {
  local ns="$1"
  local release_name="$2"
  local timeout_seconds="$3"
  local deadline namespace_row remaining
  local selector="app.kubernetes.io/name=victoria-logs-single,app.kubernetes.io/instance=${release_name}"

  timeout_seconds="$(trim_whitespace "$timeout_seconds")"
  [[ "$timeout_seconds" =~ ^[1-9][0-9]*$ ]] || timeout_seconds=300
  deadline=$(( $(date +%s) + timeout_seconds ))
  while :; do
    if ! namespace_row="$(kubectl get namespace "$ns" --ignore-not-found -o name 2>/dev/null)"; then
      echo "Error: cannot verify namespace ${ns} while waiting for VictoriaLogs backend deletion." >&2
      return 1
    fi
    namespace_row="$(trim_whitespace "$namespace_row")"
    [[ -z "$namespace_row" ]] && return 0
    if ! remaining="$(kubectl -n "$ns" get statefulset,pod -l "$selector" \
      --ignore-not-found -o name 2>/dev/null)"; then
      echo "Error: cannot verify VictoriaLogs backend resources for ${ns}/${release_name}." >&2
      return 1
    fi
    remaining="$(trim_whitespace "$remaining")"
    [[ -z "$remaining" ]] && return 0
    if (( $(date +%s) >= deadline )); then
      echo "Error: VictoriaLogs backend ${ns}/${release_name} is still present after ${timeout_seconds}s; retaining its ingress NetworkPolicy and cleanup ledger." >&2
      return 1
    fi
    sleep 2
  done
}

