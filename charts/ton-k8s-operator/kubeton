ensure_dashboard_admin_secret() {
  local ns="$1" secret_name="$2" admin_user="$3" admin_password="$4" product="$5"
  local secret_json existing_row password_hash

  admin_user="$(trim_whitespace "$admin_user")"
  [[ -n "$admin_user" ]] || admin_user=admin
  if ! secret_json="$(kubectl -n "$ns" get secret "$secret_name" --ignore-not-found -o json)"; then
    echo "Error: cannot read ${product} credentials Secret ${ns}/${secret_name}; access was not enabled." >&2
    return 1
  fi
  if [[ -n "$secret_json" ]]; then
    existing_row="$(printf '%s' "$secret_json" | dashboard_credentials_from_secret_json)" || return 1
    if [[ "$product" == prometheus ]]; then
      if ! printf '%s' "$secret_json" | python3 -c 'import base64,json,sys; sys.exit(not base64.b64decode(json.load(sys.stdin)["data"].get("web-config.yml", "")))'; then
        echo "Error: Prometheus credentials Secret ${ns}/${secret_name} has no web-config.yml; refusing to expose an unprotected dashboard." >&2
        return 1
      fi
    fi
    if [[ -z "$admin_password" ]]; then
      printf '%s\n' "$existing_row"
      return 0
    fi
  fi

  if [[ -z "$admin_password" ]]; then
    admin_password="$(generate_random_password)" || return 1
  fi
  if ! printf '%s\t%s' "$admin_user" "$admin_password" | python3 -c '
import sys
parts = sys.stdin.read().split("\t")
sys.exit(len(parts) != 2 or not all(parts) or ":" in parts[0] or any(c in "".join(parts) for c in "\r\n\0"))'; then
    echo "Error: dashboard credentials must be nonempty, the username cannot contain a colon, and credentials cannot contain tabs or line breaks." >&2
    return 1
  fi

  if [[ "$product" == prometheus ]]; then
    password_hash="$(printf '%s' "$admin_password" | prometheus_password_hash)" || return 1
  fi
  {
    cat <<EOF
apiVersion: v1
kind: Secret
metadata:
  name: ${secret_name}
  labels:
    app.kubernetes.io/name: kubeton-${product}
    app.kubernetes.io/managed-by: kubeton
type: Opaque
stringData:
  admin-user: $(yaml_quote "$admin_user")
  admin-password: $(yaml_quote "$admin_password")
EOF
    if [[ "$product" == prometheus ]]; then
      printf '  web-config.yml: |\n    basic_auth_users:\n      %s: %s\n' "$(yaml_quote "$admin_user")" "$(yaml_quote "$password_hash")"
    fi
  } | kubectl -n "$ns" apply -f - >/dev/null || return 1

  printf '%s\t%s\n' "$admin_user" "$admin_password"
}

build_grafana_datasources_yaml() {
  local row ns service_name deploy_name exporter_address
  local index=0
  local url datasource_name is_default admin_row admin_user admin_password

  echo "apiVersion: 1"
  echo "datasources:"
  for row in "$@"; do
    [[ -z "$row" ]] && continue
    IFS=$'\t' read -r ns service_name deploy_name exporter_address <<<"$row"
    ns="$(trim_whitespace "$ns")"
    service_name="$(trim_whitespace "$service_name")"
    if [[ -z "$ns" || -z "$service_name" ]]; then
      continue
    fi
    url="http://${service_name}.${ns}.svc:${PROMETHEUS_PORT}"
    admin_row="$(dashboard_secret_credentials "$ns" "$PROMETHEUS_ADMIN_SECRET_NAME")" || return 1
    IFS=$'\t' read -r admin_user admin_password <<<"$admin_row"
    # Grafana expands environment references in provisioning files. Escape dollar
    # signs so a literal password is not replaced with an environment variable.
    admin_user="${admin_user//\$/\$\$}"
    admin_password="${admin_password//\$/\$\$}"
    datasource_name="kubeton-prometheus-${ns}-${service_name}"
    is_default="false"
    if (( index == 0 )); then
      is_default="true"
    fi
    echo "  - name: $(yaml_quote "$datasource_name")"
    echo "    uid: $(yaml_quote "$(grafana_datasource_uid_for_name "$datasource_name")")"
    echo "    type: prometheus"
    echo "    access: proxy"
    echo "    url: $(yaml_quote "$url")"
    echo "    basicAuth: true"
    echo "    basicAuthUser: $(yaml_quote "$admin_user")"
    echo "    secureJsonData:"
    echo "      basicAuthPassword: $(yaml_quote "$admin_password")"
    echo "    isDefault: ${is_default}"
    echo "    editable: false"
    echo "    jsonData:"
    echo "      timeInterval: 15s"
    ((index+=1))
  done
}

grafana_datasource_name_for_service() {
