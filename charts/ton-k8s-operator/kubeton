  output="${output//$'\r'/}"
  output="$(printf '%s' "$output" | sed -E $'s/\x1B\\[[0-9;]*[[:alpha:]]//g')"
  wallet="$(printf '%s\n' "$output" | awk -F': ' '/^Local validator wallet address:/ {print $2; exit}')"
  wallet="$(trim_whitespace "$wallet")"
  adnl="$(printf '%s\n' "$output" | awk -F': ' '/^Public ADNL address of node:/ {print $2; exit}')"
  adnl="$(trim_whitespace "$adnl")"

  if [[ -z "$wallet" ]]; then
    wallet="N/A"
  fi
  if [[ -z "$adnl" ]]; then
    adnl="N/A"
  fi
  printf '%s\t%s\n' "$wallet" "$adnl"
}

status_image_tag() {
  local image tag
  image="$(trim_whitespace "${1:-}")"
  if [[ -z "$image" ]]; then
    printf 'N/A'
  elif tag="$(extract_image_tag "$image")"; then
    printf '%s' "$tag"
  elif [[ "$image" == *@* ]]; then
    printf '%s' "${image##*@}"
  else
    printf latest
  fi
}

pod_image_tag_values() {
  local ns="$1" pod="$2" images ton_image mytonctrl_image
  # Read each Pod, so a rolling upgrade can show old and new tags together.
  images="$(run_with_timeout "$STATUS_EXEC_TIMEOUT" kubectl -n "$ns" get pod "$pod" \
    -o go-template='{{range .spec.initContainers}}{{if eq .name "export-ton-binaries"}}{{.image}}{{end}}{{end}}{{"\x1f"}}{{range .spec.containers}}{{if eq .name "ton-node"}}{{.image}}{{end}}{{end}}' 2>/dev/null || true)"
  IFS=$'\x1f' read -r ton_image mytonctrl_image <<<"$images"
  printf '%s\t%s\n' "$(status_image_tag "$ton_image")" "$(status_image_tag "$mytonctrl_image")"
}

validator_build_date() {
  local ns="$1"
  local pod="$2"
  local output=""
  local build_date=""

  output="$(run_with_timeout "$STATUS_EXEC_TIMEOUT" kubectl -n "$ns" exec "$pod" -c ton-node -- bash -c '
    if [[ -x /usr/bin/ton/validator-engine/validator-engine ]]; then
      /usr/bin/ton/validator-engine/validator-engine -V 2>/dev/null | head -n1
    elif command -v validator-engine >/dev/null 2>&1; then
      validator-engine -V 2>/dev/null | head -n1
    else
      true
    fi
  ' 2>/dev/null || true)"
  output="${output//$'\r'/}"
  output="$(printf '%s' "$output" | sed -E $'s/\x1B\\[[0-9;]*[[:alpha:]]//g')"
  output="$(trim_whitespace "$output")"

  if [[ -n "$output" ]]; then
    build_date="$(printf '%s\n' "$output" | sed -n 's/.*Date:[[:space:]]*\([^]]*\)].*/\1/p' | head -n1)"
  fi

  build_date="$(trim_whitespace "$build_date")"
  if [[ -z "$build_date" ]]; then
    build_date="N/A"
  fi
  printf '%s\n' "$build_date"
}

status_collect_row() {
  local ns="$1"
  local pod="$2"
  local node_name="$3"
  local out_file="$4"
  local wallet_adnl=""
  local image_tags=""
  local ton_image_output="N/A"
  local mytonctrl_image_output="N/A"
  local date_output="N/A"
  local wallet_output="N/A"
  local adnl_output="N/A"
  local sync_output
  local cell_db_size
  local archive_db_size

  wallet_adnl="$(wallet_adnl_values "$ns" "$pod")"
  if [[ -n "$wallet_adnl" ]]; then
    IFS=$'\t' read -r wallet_output adnl_output <<<"$wallet_adnl"
  fi
  image_tags="$(pod_image_tag_values "$ns" "$pod")"
  if [[ -n "$image_tags" ]]; then
    IFS=$'\t' read -r ton_image_output mytonctrl_image_output <<<"$image_tags"
  fi
  date_output="$(validator_build_date "$ns" "$pod")"
  sync_output="$(sync_value "$ns" "$pod")"
  [[ -z "$node_name" ]] && node_name="N/A"
  cell_db_size="$(folder_size_gb "$ns" "$pod" "/var/ton-work/db/celldb")"
  archive_db_size="$(folder_size_gb "$ns" "$pod" "/var/ton-work/db/archive")"

  ton_image_output="${ton_image_output//$'\t'/ }"
  mytonctrl_image_output="${mytonctrl_image_output//$'\t'/ }"
  date_output="${date_output//$'\t'/ }"
  wallet_output="${wallet_output//$'\t'/ }"
  adnl_output="${adnl_output//$'\t'/ }"
  sync_output="${sync_output//$'\t'/ }"
  cell_db_size="${cell_db_size//$'\t'/ }"
  archive_db_size="${archive_db_size//$'\t'/ }"

  printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
    "$node_name" "$pod" "$ton_image_output" "$mytonctrl_image_output" "$date_output" "$wallet_output" "$adnl_output" "$sync_output" "$cell_db_size" "$archive_db_size" >"$out_file"
}

ensure_tonnode_crd_schema() {
  local crd_manifest="$CHART_DIR/crds/ton.ton.org_tonnodes.yaml"
  if [[ ! -f "$crd_manifest" ]]; then
    echo "Error: bundled TonNode CRD manifest is missing: ${crd_manifest}." >&2
    return 1
  fi
  # Helm installs files under crds/ only once. Apply the bundled schema before
  # an upgrade can submit tonImage/args to an API server with the old schema.
  echo "[schema] Applying bundled TonNode CRD before Helm ..."
  if ! kubectl apply -f "$crd_manifest"; then
    echo "Error: cannot update the TonNode CRD schema; Helm deployment was not applied." >&2
    return 1
  fi
  if ! kubectl wait --for=condition=Established crd/tonnodes.ton.ton.org --timeout=60s; then
    echo "Error: updated TonNode CRD did not become Established; Helm deployment was not applied." >&2
    return 1
  fi
}

run_install() {
  require_bin helm
  require_bin kubectl
  local install_ready_timeout

  if is_true "$FORCE_BAREMETAL_BOOTSTRAP"; then
    echo "[install] Operator-only install: FORCE_BAREMETAL_BOOTSTRAP enables Longhorn/Vault bootstrap in 'kubeton start' or 'kubeton bootstrap-baremetal'."
    echo "[install] Export FORCE_BAREMETAL_BOOTSTRAP=true or repeat the prefix on that command; an install-only prefix does not carry over."
  fi

  install_ready_timeout="$(trim_whitespace "${KUBETON_INSTALL_READY_TIMEOUT_SECONDS:-600}")"
  if ! [[ "$install_ready_timeout" =~ ^[1-9][0-9]*$ ]]; then
    echo "Error: invalid KUBETON_INSTALL_READY_TIMEOUT_SECONDS '${install_ready_timeout}'." >&2
    return 1
  fi
  if is_true "$KUBETON_SKIP_NODE_PREREQ_CHECK"; then
    echo "[check] KUBETON_SKIP_NODE_PREREQ_CHECK=true; skipping install-time node preflight." >&2
  else
    run_node_prerequisite_check_readonly || return 1
  fi
  ensure_tonnode_crd_schema || return 1

  local release_exists=0 operator_deployment=""
  local -a helm_cmd=()

  if helm -n "$OP_NAMESPACE" status "$RELEASE_NAME" >/dev/null 2>&1; then
    release_exists=1
  fi

  helm_cmd=(
    helm upgrade --install "$RELEASE_NAME" "$CHART_DIR"
    -n "$OP_NAMESPACE"
    --create-namespace
    -f "$OP_VALUES_FILE"
  )

  if (( release_exists == 1 )); then
    # Preserve current TonNode chart values during operator-only upgrades.
    helm_cmd+=(--reuse-values)
    # Image upgrades and add/del patch the live CR without rewriting Helm's
    # saved values. Preserve those selections during operator-only upgrades.
    local selected_ton_namespace selected_ton_name live_ton_row
    local live_ton_name live_ton_image live_ton_artifact_image live_ton_release live_ton_release_namespace live_ton_replicas
    selected_ton_namespace="$(resolve_tonnode_namespace_from_values)"
    selected_ton_name="$(resolve_tonnode_name_from_values)"
    if ! live_ton_row="$(kubectl -n "$selected_ton_namespace" get tonnodes.ton.ton.org "$selected_ton_name" \
      --ignore-not-found -o go-template='{{.metadata.name}}{{"\x1f"}}{{with .spec.image}}{{.}}{{end}}{{"\x1f"}}{{with .spec.tonImage}}{{.}}{{end}}{{"\x1f"}}{{with .metadata.annotations}}{{with index . "meta.helm.sh/release-name"}}{{.}}{{end}}{{end}}{{"\x1f"}}{{with .metadata.annotations}}{{with index . "meta.helm.sh/release-namespace"}}{{.}}{{end}}{{end}}{{"\x1f"}}{{if .spec.replicas}}{{.spec.replicas}}{{else}}1{{end}}')"; then
      echo "Error: cannot read TonNode ${selected_ton_namespace}/${selected_ton_name}; refusing an operator-only upgrade that could revert its image selections." >&2
      return 1
    fi
    if [[ -n "$live_ton_row" ]]; then
      IFS=$'\x1f' read -r live_ton_name live_ton_image live_ton_artifact_image live_ton_release live_ton_release_namespace live_ton_replicas <<<"$live_ton_row"
      if [[ "$live_ton_name" == "$selected_ton_name" \
        && "$live_ton_release" == "$RELEASE_NAME" \
        && "$live_ton_release_namespace" == "$OP_NAMESPACE" ]]; then
        if ! [[ "$live_ton_replicas" =~ ^[1-9][0-9]*$ ]]; then
          echo "Error: cannot preserve the live TON replica count during operator upgrade." >&2
          return 1
        fi
        helm_cmd+=(--set-string "tonNode.image=${live_ton_image}" --set-string "tonNode.tonImage=${live_ton_artifact_image}")
        helm_cmd+=(--set "tonNode.replicas=${live_ton_replicas}")
      fi
    fi
    # If no TonNode CRs exist, keep operator-only behavior and avoid accidental TonNode recreation
    # from reused values.
    if [[ -z "$live_ton_row" ]] && ! cluster_has_tonnodes; then
      helm_cmd+=(--set tonNode.enabled=false)
    fi
  fi

  append_helm_force_conflicts_if_supported helm_cmd
  "${helm_cmd[@]}"

  if ! operator_deployment="$(resolve_operator_controller_deployment_name)"; then
    echo "Error: cannot uniquely resolve the controller Deployment for Helm release ${OP_NAMESPACE}/${RELEASE_NAME}; inspect the launch evidence bundle." >&2
    return 1
  fi

  # Helm applying the Deployment is not evidence that its controller process
  # ever started. Keep the launch log watchers alive through the rollout and
  # make install fail when the operator cannot become Ready, leaving the
  # captured Pod/container/Event evidence available on the invoking host.
  echo "[install] Waiting for operator deployment ${OP_NAMESPACE}/${operator_deployment} to become Ready (timeout ${install_ready_timeout}s) ..."
  if ! kubectl -n "$OP_NAMESPACE" rollout status "deployment/${operator_deployment}" \
      --timeout="${install_ready_timeout}s"; then
    echo "Error: operator deployment ${OP_NAMESPACE}/${operator_deployment} did not become Ready; inspect the launch evidence bundle." >&2
    return 1
  fi
  echo "[install] Operator deployment is Ready."
}

fleet_has_stop_annotations() {
  local -a sts_rows=()
  local row ns sts pause_annotation

  mapfile -t sts_rows < <(list_ton_statefulsets 2>/dev/null || true)
  if [[ ${#sts_rows[@]} -eq 0 || -z "${sts_rows[0]}" ]]; then
    return 1
  fi

  for row in "${sts_rows[@]}"; do
    [[ -z "$row" ]] && continue
    IFS=$'\t' read -r ns sts _ <<<"$row"
    [[ -z "$ns" || -z "$sts" ]] && continue

    pause_annotation="$(get_annotation_value statefulset "$ns" "$sts" "$KUBETON_PAUSE_ANNOTATION_KEY")"
    if [[ "$pause_annotation" =~ ^[0-9]+$ ]]; then
      return 0
    fi

    if kubectl -n "$ns" get tonnodes.ton.ton.org "$sts" >/dev/null 2>&1; then
      pause_annotation="$(get_annotation_value tonnodes.ton.ton.org "$ns" "$sts" "$KUBETON_PAUSE_ANNOTATION_KEY")"
      if [[ "$pause_annotation" =~ ^[0-9]+$ ]]; then
        return 0
      fi
    fi
  done

  return 1
}

run_bootstrap_baremetal() {
  require_bin kubectl
  require_bin helm
  local replicas=""
  local bootstrap_uses_longhorn="true"

  if ! cluster_is_baremetal && ! cluster_is_k3d && ! is_true "$FORCE_BAREMETAL_BOOTSTRAP"; then
    echo "Cluster looks like cloud/managed (not bare-metal/local k3d)."
    echo "Use FORCE_BAREMETAL_BOOTSTRAP=true if you really want to bootstrap Longhorn+Vault here."
    exit 1
  fi

  replicas="$(resolve_ton_replicas_for_node_check || true)"
  if ! [[ "$replicas" =~ ^[1-9][0-9]*$ ]]; then
    echo "Error: cannot resolve tonNode.replicas from ${TON_VALUES_FILE}." >&2
    return 1
  fi
  KUBETON_TARGET_TON_REPLICAS="$replicas"
  if cluster_is_k3d; then
    bootstrap_uses_longhorn="false"
  fi
  prepare_node_prerequisites_for_workload "$replicas" "$bootstrap_uses_longhorn" || return 1

  ensure_auto_bootstrap_stack || return $?
  echo "[bootstrap] Completed."
}

ton_upgrade_tonnode_row() {
  local ns="$1" name="$2"
  run_with_timeout "$STATUS_EXEC_TIMEOUT" kubectl -n "$ns" get tonnodes.ton.ton.org "$name" --ignore-not-found \
    -o go-template='{{.spec.image}}{{"\x1f"}}{{.spec.tonImage}}{{"\x1f"}}{{.spec.replicas}}{{"\x1f"}}{{.metadata.resourceVersion}}'
}

ton_upgrade_statefulset_row() {
  local ns="$1" name="$2"
  run_with_timeout "$STATUS_EXEC_TIMEOUT" kubectl -n "$ns" get statefulset "$name" \
    -o go-template='{{range .spec.template.spec.containers}}{{if eq .name "ton-node"}}{{.image}}{{end}}{{end}}{{"\x1f"}}{{range .spec.template.spec.initContainers}}{{if eq .name "export-ton-binaries"}}{{.image}}{{end}}{{end}}{{"\x1f"}}{{range .spec.template.spec.initContainers}}{{if eq .name "stage-ton-exporter"}}{{.image}}{{end}}{{end}}{{"\x1f"}}{{.metadata.generation}}{{"\x1f"}}{{if .status.observedGeneration}}{{.status.observedGeneration}}{{else}}0{{end}}{{"\x1f"}}{{.spec.replicas}}'
}

ton_upgrade_pod_rows() {
  local ns="$1" name="$2"
  run_with_timeout "$STATUS_EXEC_TIMEOUT" kubectl -n "$ns" get pods -l "$(launch_session_selector "$name")" \
    -o go-template='{{range .items}}{{.metadata.name}}{{"\x1f"}}{{range .metadata.ownerReferences}}{{if and (eq .kind "StatefulSet") .controller}}{{.name}}{{end}}{{end}}{{"\x1f"}}{{range .spec.containers}}{{if eq .name "ton-node"}}{{.image}}{{end}}{{end}}{{"\x1f"}}{{range .spec.initContainers}}{{if eq .name "export-ton-binaries"}}{{.image}}{{end}}{{end}}{{"\x1f"}}{{range .spec.initContainers}}{{if eq .name "stage-ton-exporter"}}{{.image}}{{end}}{{end}}{{"\x1f"}}{{if .metadata.deletionTimestamp}}terminating{{end}}{{"\x1f"}}{{range .spec.containers}}{{if eq .name "key-backup"}}true{{end}}{{end}}{{"\n"}}{{end}}'
}

ton_upgrade_pods_match() {
  local rows="$1" name="$2" image="$3" ton_image="$4" replicas="$5"
  local pod owner current_image current_ton exporter deleting backup count=0
  while IFS=$'\x1f' read -r pod owner current_image current_ton exporter deleting backup; do
    [[ -n "$pod" && "$owner" == "$name" ]] || continue
    count=$((count + 1))
    if [[ "$current_image" != "$image" || "$current_ton" != "$ton_image" \
      || "$exporter" != "$image" || -n "$deleting" ]]; then
      return 1
    fi
  done <<<"$rows"
  [[ "$count" == "$replicas" ]]
}

ton_upgrade_backup_keys() {
  local ns="$1" name="$2" rows="$3"
  local pod owner image ton_image exporter deleting backup state
  while IFS=$'\x1f' read -r pod owner image ton_image exporter deleting backup; do
    [[ -n "$pod" && "$owner" == "$name" && -z "$deleting" && "$backup" == true ]] || continue
    # The sidecar can inspect committed state even when ton-node is crash-looping.
    state="$(run_with_timeout "$STATUS_EXEC_TIMEOUT" kubectl -n "$ns" exec "$pod" -c key-backup -- sh -ec '
      if test -s /var/ton-work/controller/initialized.json; then
        printf initialized
      else
        printf initializing
      fi
    ')" || return 1
    case "$state" in
      initialized)
        echo "[upgrade] Saving encrypted keys for ${ns}/${pod} before rollout ..."
        if ! trigger_key_backup_once "$ns" "$pod" || ! pod_has_encrypted_bundle "$ns" "$pod"; then
          echo "Error: key backup failed for ${ns}/${pod}; image changes were not applied." >&2
          return 1
        fi
        ;;
      initializing)
        echo "[upgrade] ${ns}/${pod} has incomplete initialization; the retained database and dump cache will be reused."
        ;;
      *)
        echo "Error: cannot determine initialization state for ${ns}/${pod}." >&2
        return 1
        ;;
    esac
  done <<<"$rows"
}

wait_ton_image_upgrade() {
  local ns="$1" name="$2" image="$3" ton_image="$4" replicas="$5" deadline="$6"
  local row current_image current_ton exporter generation observed current_replicas remaining pods
  echo "[upgrade] Waiting for ${ns}/${name} to use the requested images ..."
  while :; do
    row="$(ton_upgrade_statefulset_row "$ns" "$name")" || return 1
    IFS=$'\x1f' read -r current_image current_ton exporter generation observed current_replicas <<<"$row"
    if [[ "$current_image" == "$image" && "$current_ton" == "$ton_image" && "$exporter" == "$image" \
      && "$generation" =~ ^[1-9][0-9]*$ && "$observed" =~ ^[0-9]+$ \
      && "$observed" -ge "$generation" && "$current_replicas" == "$replicas" ]]; then
      break
    fi
    if (( $(date +%s) >= deadline )); then
      echo "Error: timed out waiting for ${ns}/${name} to reconcile the requested images; rerun kubeton upgrade to resume." >&2
      return 1
    fi
    sleep 2
  done
  remaining=$((deadline - $(date +%s)))
  if (( remaining <= 0 )); then
    echo "Error: image upgrade timed out before rollout completed; rerun kubeton upgrade to resume." >&2
    return 1
  fi
  if (( replicas > 0 )); then
    # Wait only after the new template is observed; an old completed rollout is
    # otherwise indistinguishable from successful application of this update.
    kubectl -n "$ns" rollout status "statefulset/${name}" --timeout="${remaining}s" || return 1
  fi
  row="$(ton_upgrade_tonnode_row "$ns" "$name")" || return 1
  IFS=$'\x1f' read -r current_image current_ton current_replicas _ <<<"$row"
  if [[ "$current_image" != "$image" || "$current_ton" != "$ton_image" || "$current_replicas" != "$replicas" ]]; then
    echo "Error: TonNode ${ns}/${name} changed during upgrade; rerun kubeton upgrade to inspect the new state." >&2
    return 1
  fi
  pods="$(ton_upgrade_pod_rows "$ns" "$name")" || return 1
  if ! ton_upgrade_pods_match "$pods" "$name" "$image" "$ton_image" "$replicas"; then
    echo "Error: ${ns}/${name} pods do not all use the requested images yet; rerun kubeton upgrade to resume." >&2
    return 1
  fi
  if (( replicas == 0 )); then
    echo "[upgrade] Images updated; ${ns}/${name} remains stopped (0 replicas)."
  else
    echo "[upgrade] ${ns}/${name} upgraded: TON binaries exported and MyTonCtrl is Ready."
  fi
}

run_upgrade() {
  require_bin kubectl
  if [[ $# -ne 0 ]]; then
    echo "Error: usage: kubeton upgrade" >&2
    return 1
  fi
  if [[ ! -f "$TON_VALUES_FILE" ]]; then
    echo "Error: required values file not found: ${TON_VALUES_FILE}" >&2
    return 1
  fi
  local image ton_image ns name row current_image current_ton replicas resource_version
  local sts_image sts_ton exporter generation observed sts_replicas pods patch_fields="" deadline
  local checked_image checked_ton checked_replicas
  image="$(resolve_tonnode_path_scalar_from_values_file "$TON_VALUES_FILE" image)" || {
    echo "Error: tonNode.image is missing from ${TON_VALUES_FILE}." >&2; return 1;
  }
  ton_image="$(resolve_tonnode_path_scalar_from_values_file "$TON_VALUES_FILE" tonImage)" || {
    echo "Error: tonNode.tonImage is missing from ${TON_VALUES_FILE}." >&2; return 1;
  }
  for row in "$image" "$ton_image"; do
    if ! [[ "$row" =~ ^[A-Za-z0-9][A-Za-z0-9._:/@-]*$ ]] || [[ "$row" == null || "$row" == true || "$row" == false ]]; then
      echo "Error: invalid container image reference '${row}' in ${TON_VALUES_FILE}." >&2
      return 1
    fi
  done
  if ! [[ "$KUBETON_UPGRADE_TIMEOUT_SECONDS" =~ ^[1-9][0-9]*$ ]]; then
    echo "Error: invalid KUBETON_UPGRADE_TIMEOUT_SECONDS '${KUBETON_UPGRADE_TIMEOUT_SECONDS}'." >&2
    return 1
  fi
  ns="$(resolve_tonnode_namespace_from_values)"
  name="$(resolve_tonnode_name_from_values)"
  row="$(ton_upgrade_tonnode_row "$ns" "$name")" || return 1
  IFS=$'\x1f' read -r current_image current_ton replicas resource_version <<<"$row"
  if ! [[ "$replicas" =~ ^[0-9]+$ ]] || [[ -z "$resource_version" ]]; then
    echo "Error: cannot read the deployed TonNode ${ns}/${name}; run kubeton start first." >&2
    return 1
  fi
  row="$(ton_upgrade_statefulset_row "$ns" "$name")" || return 1
  IFS=$'\x1f' read -r sts_image sts_ton exporter generation observed sts_replicas <<<"$row"
  pods="$(ton_upgrade_pod_rows "$ns" "$name")" || return 1
  if [[ "$current_image" == "$image" && "$current_ton" == "$ton_image" \
    && "$sts_image" == "$image" && "$sts_ton" == "$ton_image" && "$exporter" == "$image" \
    && "$sts_replicas" == "$replicas" ]] \
    && ton_upgrade_pods_match "$pods" "$name" "$image" "$ton_image" "$replicas"; then
    echo "Nothing to upgrade."
    return 0
  fi
  if [[ "$current_image" != "$image" ]]; then
    echo "[upgrade] MyTonCtrl: ${current_image:-unset} -> ${image}"
    patch_fields="\"image\":$(json_quote "$image")"
  fi
  if [[ "$current_ton" != "$ton_image" ]]; then
    echo "[upgrade] TON: ${current_ton:-unset} -> ${ton_image}"
    patch_fields+="${patch_fields:+,}\"tonImage\":$(json_quote "$ton_image")"
  fi
  if [[ -n "$patch_fields" ]]; then
    ton_upgrade_backup_keys "$ns" "$name" "$pods" || return 1
    # Backups can outlast a status update. Refresh resourceVersion, but reject
    # a concurrent image/replica edit before applying this image-only patch.
    row="$(ton_upgrade_tonnode_row "$ns" "$name")" || return 1
    IFS=$'\x1f' read -r checked_image checked_ton checked_replicas resource_version <<<"$row"
    if [[ "$checked_image" != "$current_image" || "$checked_ton" != "$current_ton" \
      || "$checked_replicas" != "$replicas" || -z "$resource_version" ]]; then
      echo "Error: TonNode ${ns}/${name} changed during key backup; rerun kubeton upgrade." >&2
      return 1
    fi
    kubectl -n "$ns" patch tonnodes.ton.ton.org "$name" --field-manager=helm --type=merge \
      -p "{\"metadata\":{\"resourceVersion\":$(json_quote "$resource_version")},\"spec\":{${patch_fields}}}" >/dev/null || return 1
  else
    echo "[upgrade] Requested images are already configured; resuming the pending rollout."
  fi
  deadline=$(( $(date +%s) + KUBETON_UPGRADE_TIMEOUT_SECONDS ))
  wait_ton_image_upgrade "$ns" "$name" "$image" "$ton_image" "$replicas" "$deadline"
}

run_start() {
  require_bin helm
  require_bin kubectl

  if [[ $# -ne 0 ]]; then
    echo "Error: usage: kubeton start" >&2
    exit 1
  fi

  local desired_replicas_for_start=""
  local restore_from_stop_metadata=0
  local -a extra_overrides=()
  local ton_selector_values_file=""
  local -a helm_cmd=()
  local helm_rc=0
  local sequential_start=0
  local bootstrap_required=0
  local preflight_uses_longhorn="false"
  local vlogs_current_nodes="" vlogs_rechecked_nodes=""

  desired_replicas_for_start="$(resolve_ton_replicas_from_values_file "$TON_VALUES_FILE" || true)"
  if ! [[ "$desired_replicas_for_start" =~ ^[1-9][0-9]*$ ]]; then
    desired_replicas_for_start="$(resolve_ton_replicas_from_values_file "$CHART_DIR/values.yaml" || true)"
  fi
  if ! [[ "$desired_replicas_for_start" =~ ^[1-9][0-9]*$ ]]; then
    echo "Error: cannot resolve tonNode.replicas from ${TON_VALUES_FILE}." >&2
    return 1
  fi
  KUBETON_TARGET_TON_REPLICAS="$desired_replicas_for_start"

  if should_bootstrap_baremetal; then
    bootstrap_required=1
  fi
  # Local k3d uses a local encrypted StorageClass and intentionally skips
  # Longhorn. Bare-metal bootstrap, an existing manager, or an already
  # Longhorn-backed encrypted StorageClass each require the per-node CSI gate.
  if { (( bootstrap_required == 1 )) && ! cluster_is_k3d; } \
    || longhorn_manager_exists \
    || storage_class_is_longhorn "$ENCRYPTED_SC_NAME"; then
    preflight_uses_longhorn="true"
  fi
  if is_true "$preflight_uses_longhorn"; then
    if ! prepare_node_prerequisites_for_workload "$desired_replicas_for_start" true; then
      restrict_existing_victoria_logs_after_failed_preflight || true
      return 1
    fi
  else
    if ! prepare_node_prerequisites_for_workload "$desired_replicas_for_start" false; then
      restrict_existing_victoria_logs_after_failed_preflight || true
      return 1
    fi
  fi
  if is_true "$KUBETON_START_VICTORIA_LOGS_ENABLED" && is_true "$VICTORIA_LOGS_ENABLED" \
    && (( ${#KUBETON_VICTORIA_LOGS_ELIGIBLE_NODES[@]} == 0 )); then
    echo "Error: automatic VictoriaLogs logging requires a fresh successful node prerequisite check." >&2
    echo "Error: KUBETON_SKIP_NODE_PREREQ_CHECK cannot produce a cluster-wide collector; unset it or explicitly set KUBETON_START_VICTORIA_LOGS_ENABLED=false." >&2
    return 1
  fi
  if [[ -n "$KUBETON_NODE_CHECK_TON_SELECTOR" ]]; then
    ton_selector_values_file="$(build_ton_node_selector_values_file "$KUBETON_NODE_CHECK_TON_SELECTOR")" || return 1
    extra_overrides+=(-f "$ton_selector_values_file")
  fi

  if fleet_has_stop_annotations; then
    restore_from_stop_metadata=1
    echo "[start] Detected stopped TON fleet metadata; applying chart update before restoring previous replicas."
  fi

  ensure_ton_storage_class_available
  append_ton_storage_overrides extra_overrides
  if should_use_sequential_ton_start "$desired_replicas_for_start" "$restore_from_stop_metadata"; then
    sequential_start=1
    if ! is_true "$KUBETON_SEQUENTIAL_TON_START"; then
      echo "[start] Local-path TON storage detected; staging fresh TON replicas sequentially to prevent PVC/node drift."
    fi
  fi

  if (( bootstrap_required == 1 )); then
    # The backend may itself need Longhorn, but the collector has only local
    # hostPath dependencies. Start it first so Longhorn/Vault container logs
    # are queued locally even before the VictoriaLogs Service can exist.
    if ! ensure_start_victoria_logs_buffering_collector; then
      if [[ -n "$ton_selector_values_file" ]]; then
        rm -f "$ton_selector_values_file" >/dev/null 2>&1 || true
      fi
      return 1
    fi
    if ! ensure_auto_bootstrap_stack; then
      if [[ -n "$ton_selector_values_file" ]]; then
        rm -f "$ton_selector_values_file" >/dev/null 2>&1 || true
      fi
      return 1
    fi
    append_baremetal_key_overrides extra_overrides
    if [[ -z "$ton_selector_values_file" ]] && ! cluster_is_k3d && [[ -n "${LONGHORN_NODE_SELECTOR:-}" ]]; then
      ton_selector_values_file="$(build_ton_node_selector_values_file "$LONGHORN_NODE_SELECTOR")"
      extra_overrides+=(-f "$ton_selector_values_file")
    fi

    # Longhorn/Vault bootstrap can take several minutes and consumes disk on
    # the selected nodes.  Refresh the same read-only gate before stale PVC
    # cleanup or Helm can create a TonNode pod; do not silently reuse a node
    # that only passed before bootstrap.
    if ! is_true "$KUBETON_SKIP_NODE_PREREQ_CHECK"; then
      echo "[check] Rechecking selected TON nodes after storage/key bootstrap ..."
      if ! run_node_prerequisite_check "$KUBETON_NODE_CHECK_REQUIRED_NODES" "$KUBETON_NODE_CHECK_TON_SELECTOR"; then
        restrict_existing_victoria_logs_after_failed_preflight || true
        echo "Error: selected TON nodes no longer meet bootstrap requirements; TON deployment was not applied." >&2
        if [[ -n "$ton_selector_values_file" ]]; then
          rm -f "$ton_selector_values_file" >/dev/null 2>&1 || true
        fi
        return 1
      fi
      if ! node_check_selector_is_all_compatible "$KUBETON_NODE_CHECK_TON_SELECTOR"; then
        restrict_existing_victoria_logs_after_failed_preflight || true
        echo "Error: the selected TON node selector now includes a node that no longer meets bootstrap requirements; TON deployment was not applied." >&2
        node_check_print_failed_selector_nodes "$KUBETON_NODE_CHECK_TON_SELECTOR"
        if [[ -n "$ton_selector_values_file" ]]; then
          rm -f "$ton_selector_values_file" >/dev/null 2>&1 || true
        fi
        return 1
      fi
    fi
  else
    validate_external_key_prereqs
  fi

  # The aggregate Longhorn readiness wait proves that some CSI nodes are
  # registered, but it cannot prove that every node selected for this TON
  # StatefulSet has driver.longhorn.io. Check the actual placement selector
  # before PVC cleanup or Helm can create a pod that later fails to attach its
  # encrypted key-bundle PVC. When an explicit preflight was skipped and no
  # selector is available, the helper deliberately checks every node: that is
  # the only safe interpretation of an unconstrained TON placement.
  if is_true "$preflight_uses_longhorn"; then
    if ! wait_ton_selected_nodes_longhorn_csi_ready "$KUBETON_NODE_CHECK_TON_SELECTOR"; then
      restrict_existing_victoria_logs_after_failed_preflight || true
      if [[ -n "$ton_selector_values_file" ]]; then
        rm -f "$ton_selector_values_file" >/dev/null 2>&1 || true
      fi
      return 1
    fi
  fi

  # Container restart history must be collected before the first TON Pod is
  # created. Kubernetes only exposes one previous container generation, so a
  # logging stack installed after a failed bootstrap cannot reconstruct it.
  if ! ensure_start_victoria_logs; then
    restrict_existing_victoria_logs_after_failed_preflight || true
    if [[ -n "$ton_selector_values_file" ]]; then
      rm -f "$ton_selector_values_file" >/dev/null 2>&1 || true
    fi
    return 1
  fi

  if ! ensure_start_victoria_metrics true; then
    if [[ -n "$ton_selector_values_file" ]]; then
      rm -f "$ton_selector_values_file" >/dev/null 2>&1 || true
    fi
    return 1
  fi

  if (( restore_from_stop_metadata == 0 )); then
    delete_stale_ton_pvcs_before_fresh_start
  fi

  # Stale-PVC reconciliation and CSI recovery can take long enough for node
  # pressure or HostPort reservations to change after the earlier checks.
  # Refresh every deployment prerequisite after cleanup and as close to Helm
  # as possible.  Waiting for CSI comes first because it may consume most of
  # the timeout; the final immediate probe then catches a registration which
  # disappears while the resource/HostPort check is running.
  if is_true "$preflight_uses_longhorn"; then
    if ! wait_ton_selected_nodes_longhorn_csi_ready "$KUBETON_NODE_CHECK_TON_SELECTOR"; then
      restrict_existing_victoria_logs_after_failed_preflight || true
      if [[ -n "$ton_selector_values_file" ]]; then
        rm -f "$ton_selector_values_file" >/dev/null 2>&1 || true
      fi
      return 1
    fi
  fi
  if ! is_true "$KUBETON_SKIP_NODE_PREREQ_CHECK"; then
    echo "[check] Rechecking selected TON nodes immediately before TON deployment ..."
    if ! run_node_prerequisite_check "$KUBETON_NODE_CHECK_REQUIRED_NODES" "$KUBETON_NODE_CHECK_TON_SELECTOR"; then
      restrict_existing_victoria_logs_after_failed_preflight || true
      echo "Error: selected TON nodes no longer meet deployment requirements; TON deployment was not applied." >&2
      if [[ -n "$ton_selector_values_file" ]]; then
        rm -f "$ton_selector_values_file" >/dev/null 2>&1 || true
      fi
      return 1
    fi
    if [[ -n "$KUBETON_NODE_CHECK_TON_SELECTOR" ]] \
      && ! node_check_selector_is_all_compatible "$KUBETON_NODE_CHECK_TON_SELECTOR"; then
      restrict_existing_victoria_logs_after_failed_preflight || true
      echo "Error: the TON node selector includes a node that no longer meets deployment requirements; TON deployment was not applied." >&2
      node_check_print_failed_selector_nodes "$KUBETON_NODE_CHECK_TON_SELECTOR"
      if [[ -n "$ton_selector_values_file" ]]; then
        rm -f "$ton_selector_values_file" >/dev/null 2>&1 || true
      fi
      return 1
    fi
  fi
  if is_true "$preflight_uses_longhorn"; then
    if ! verify_ton_selected_nodes_longhorn_csi_ready "$KUBETON_NODE_CHECK_TON_SELECTOR"; then
      restrict_existing_victoria_logs_after_failed_preflight || true
      if [[ -n "$ton_selector_values_file" ]]; then
        rm -f "$ton_selector_values_file" >/dev/null 2>&1 || true
      fi
      return 1
    fi
  fi
  # The last node check may legitimately produce a different PASS set while
  # still satisfying the replica count (for example, one node entered
  # DiskPressure and another became available). Reconcile both VictoriaLogs
  # workloads to that exact latest set before TON Helm. Otherwise their prior
  # required affinity would retain the earlier, now-rejected hostnames.
  if is_true "$KUBETON_START_VICTORIA_LOGS_ENABLED" && is_true "$VICTORIA_LOGS_ENABLED"; then
    vlogs_current_nodes="$(victoria_logs_eligible_nodes_csv)"
    if [[ "$vlogs_current_nodes" != "$KUBETON_VICTORIA_LOGS_APPLIED_NODES" ]]; then
      echo "[launch] The approved VictoriaLogs node set changed; reconciling it before TON deployment ..." >&2
      if ! ensure_start_victoria_logs; then
        restrict_existing_victoria_logs_after_failed_preflight || true
        if [[ -n "$ton_selector_values_file" ]]; then
          rm -f "$ton_selector_values_file" >/dev/null 2>&1 || true
        fi
        return 1
      fi
      # A logging rollout can itself take minutes. Require the exact set to be
      # stable across one more complete node check; if it moved again, leave
      # TON blocked and safely narrow the existing collector to the newest
      # partial PASS set.
      echo "[check] Confirming node prerequisites after VictoriaLogs reconciliation ..."
      if ! run_node_prerequisite_check "$KUBETON_NODE_CHECK_REQUIRED_NODES" "$KUBETON_NODE_CHECK_TON_SELECTOR"; then
        restrict_existing_victoria_logs_after_failed_preflight || true
        echo "Error: node prerequisites changed during VictoriaLogs reconciliation; TON deployment was not applied." >&2
        if [[ -n "$ton_selector_values_file" ]]; then
          rm -f "$ton_selector_values_file" >/dev/null 2>&1 || true
        fi
        return 1
      fi
      if [[ -n "$KUBETON_NODE_CHECK_TON_SELECTOR" ]] \
        && ! node_check_selector_is_all_compatible "$KUBETON_NODE_CHECK_TON_SELECTOR"; then
        restrict_existing_victoria_logs_after_failed_preflight || true
        echo "Error: selected TON nodes changed during VictoriaLogs reconciliation; TON deployment was not applied." >&2
        if [[ -n "$ton_selector_values_file" ]]; then
          rm -f "$ton_selector_values_file" >/dev/null 2>&1 || true
        fi
        return 1
      fi
      # The VictoriaLogs rollout may have taken long enough for a selected
      # node's CSI registration/plugin to disappear. Preserve the immediate
      # attach-safety proof before allowing TON Helm to create Pods.
      if is_true "$preflight_uses_longhorn"; then
        if ! verify_ton_selected_nodes_longhorn_csi_ready "$KUBETON_NODE_CHECK_TON_SELECTOR"; then
          restrict_existing_victoria_logs_after_failed_preflight || true
          if [[ -n "$ton_selector_values_file" ]]; then
            rm -f "$ton_selector_values_file" >/dev/null 2>&1 || true
          fi
          return 1
        fi
      fi
      vlogs_rechecked_nodes="$(victoria_logs_eligible_nodes_csv)"
      if [[ "$vlogs_rechecked_nodes" != "$KUBETON_VICTORIA_LOGS_APPLIED_NODES" ]]; then
        restrict_existing_victoria_logs_after_failed_preflight || true
        echo "Error: VictoriaLogs placement did not remain stable across consecutive node checks; TON deployment was not applied. Rerun start after node pressure settles." >&2
        if [[ -n "$ton_selector_values_file" ]]; then
          rm -f "$ton_selector_values_file" >/dev/null 2>&1 || true
        fi
        return 1
      fi
    fi
  fi
  # Storage cleanup and readiness waits can take long enough for a collector
  # to be evicted after the initial VictoriaLogs installation. Narrow that
  # race with one final exact coverage probe immediately before Helm can
  # create or restart TON Pods.
  if ! verify_start_victoria_logs_collection_ready; then
    restrict_existing_victoria_logs_after_failed_preflight || true
    if [[ -n "$ton_selector_values_file" ]]; then
      rm -f "$ton_selector_values_file" >/dev/null 2>&1 || true
    fi
    return 1
  fi
  if ! ensure_tonnode_crd_schema; then
    if [[ -n "$ton_selector_values_file" ]]; then
      rm -f "$ton_selector_values_file" >/dev/null 2>&1 || true
    fi
    return 1
  fi

  helm_cmd=(
    helm upgrade "$RELEASE_NAME" "$CHART_DIR"
    -n "$OP_NAMESPACE"
    -f "$OP_VALUES_FILE"
    -f "$TON_VALUES_FILE"
  )

  helm_cmd+=("${extra_overrides[@]}")
  if (( sequential_start == 1 )); then
    helm_cmd+=(--set tonNode.replicas=1)
  fi
  append_helm_force_conflicts_if_supported helm_cmd

  "${helm_cmd[@]}" || helm_rc=$?

  if (( helm_rc != 0 )); then
    if [[ -n "$ton_selector_values_file" ]]; then
      rm -f "$ton_selector_values_file" >/dev/null 2>&1 || true
    fi
    return "$helm_rc"
  fi
  if (( sequential_start == 1 )); then
    sequential_start_ton_fleet "$desired_replicas_for_start" || {
      if [[ -n "$ton_selector_values_file" ]]; then
        rm -f "$ton_selector_values_file" >/dev/null 2>&1 || true
      fi
      return 1
    }
    helm_cmd=(
      helm upgrade "$RELEASE_NAME" "$CHART_DIR"
      -n "$OP_NAMESPACE"
      -f "$OP_VALUES_FILE"
      -f "$TON_VALUES_FILE"
    )
    helm_cmd+=("${extra_overrides[@]}")
    helm_cmd+=(--set "tonNode.replicas=${desired_replicas_for_start}")
    append_helm_force_conflicts_if_supported helm_cmd
    "${helm_cmd[@]}" >/dev/null || helm_rc=$?
  fi
  if [[ -n "$ton_selector_values_file" ]]; then
    rm -f "$ton_selector_values_file" >/dev/null 2>&1 || true
  fi
  if (( helm_rc != 0 )); then
    return "$helm_rc"
  fi
  if (( sequential_start == 1 )); then
    local reconcile_ns reconcile_name
    reconcile_ns="$(resolve_tonnode_namespace_from_values)"
    reconcile_name="$(resolve_tonnode_name_from_values)"
    wait_ton_controller_reconciled_after_start \
      "$reconcile_ns" "$reconcile_name" "$desired_replicas_for_start" \
      "$KUBETON_START_RECONCILE_TIMEOUT_SECONDS" || return 1
  fi
  if (( restore_from_stop_metadata == 1 )); then
    local restore_operator_deployment=""
    restore_operator_deployment="$(resolve_operator_controller_deployment_name || true)"
    if [[ -z "$restore_operator_deployment" ]] \
      || ! kubectl -n "$OP_NAMESPACE" rollout status "deployment/${restore_operator_deployment}" --timeout=300s >/dev/null 2>&1; then
      echo "Warning: operator deployment for Helm release ${OP_NAMESPACE}/${RELEASE_NAME} did not report Ready before TON restore; continuing." >&2
    fi
    recreate_stopped_statefulsets_missing_dedicated_pvcs
    run_start_stopped_fleet
  fi

  repair_pending_ton_placement_after_start || return 1

  # The initial metrics setup can precede the first TonNode CR. Refresh
  # discovery now so new fleets and changed exporter ports are scraped.
  local -a start_scrape_rows=()
  ensure_victoria_metrics_scrape_resources start_scrape_rows || return 1

  resume_stopped_dashboard_workloads || return 1

  if is_true "$KUBETON_START_WAIT_FOR_BOOTSTRAP"; then
    local target_ns target_name
    target_ns="$(resolve_tonnode_namespace_from_values)"
    target_name="$(resolve_tonnode_name_from_values)"
    wait_ton_initial_bootstrap_complete \
      "$target_ns" "$target_name" "$desired_replicas_for_start" "$KUBETON_START_READY_TIMEOUT_SECONDS"
  else
    echo "[start] KUBETON_START_WAIT_FOR_BOOTSTRAP=false; TON was applied without waiting for the MyTonCtrl bootstrap commit." >&2
  fi
}

run_backup_keys() {
  require_bin kubectl
  require_bin sha256sum
  require_bin date

  local default_output_root
  default_output_root="$(cd "$CHART_DIR/.." && pwd)/key-backups"
  local output_dir="${1:-$default_output_root/$(date -u +%Y%m%dT%H%M%SZ)}"
  if [[ $# -gt 1 ]]; then
    echo "Error: usage: kubeton backup-keys [output-dir]" >&2
    exit 1
  fi

  local -a sts_rows=()
  mapfile -t sts_rows < <(list_ton_statefulsets)
  if [[ ${#sts_rows[@]} -eq 0 || -z "${sts_rows[0]}" ]]; then
    echo "No TON StatefulSets found."
    return
  fi

  confirm_or_exit "This will trigger encrypted backup in each TON pod, scale StatefulSets to 0, export bundles, then scale back. Continue?"
  mkdir -p "$output_dir"

  local -a ns_list=()
  local -a sts_list=()
  local -a replicas_list=()
  local -A ordinal_node_maps=()
  local -A helper_nodes_by_replica=()
  local -a operator_deploy_names=()
  local -a operator_deploy_replicas=()
  local row ns sts replicas i ordinal pod node_map_key node_map
  local operator_paused=0
  for row in "${sts_rows[@]}"; do
    [[ -z "$row" ]] && continue
    IFS=$'\t' read -r ns sts replicas <<<"$row"
    replicas="$(trim_whitespace "${replicas:-0}")"
    if ! [[ "$replicas" =~ ^[0-9]+$ ]]; then
      replicas=0
    fi
    ns_list+=("$ns")
    sts_list+=("$sts")
    replicas_list+=("$replicas")
    if (( replicas > 0 )); then
      node_map_key="${ns}/${sts}"
      node_map="$(build_sts_ordinal_node_map "$ns" "$sts" "$replicas" || true)"
      node_map="$(trim_whitespace "$node_map")"
      if [[ -n "$node_map" ]]; then
        ordinal_node_maps["$node_map_key"]="$node_map"
      fi
    fi
  done

  local restore_required=1
  cleanup_restore() {
    [[ "${restore_required:-0}" -ne 1 ]] && return 0
    local i ns sts replicas node_map_key node_map
    local -a expected_nodes=()
    for i in "${!sts_list[@]}"; do
      ns="${ns_list[$i]}"
      sts="${sts_list[$i]}"
      replicas="${replicas_list[$i]}"
      if [[ "$replicas" =~ ^[1-9][0-9]*$ ]]; then
        node_map_key="${ns}/${sts}"
        node_map="${ordinal_node_maps[$node_map_key]:-}"
        expected_nodes=()
        if [[ -n "$node_map" ]] \
          && parse_ordinal_node_map "$node_map" expected_nodes \
          && (( ${#expected_nodes[@]} >= replicas )) \
          && restore_statefulset_with_expected_nodes "$ns" "$sts" "$replicas" expected_nodes >/dev/null 2>&1; then
          continue
        fi
      fi
      set_ton_replicas "$ns" "$sts" "$replicas" >/dev/null 2>&1 || true
    done
    if [[ "${operator_paused:-0}" -eq 1 ]]; then
      resume_operator_reconcile operator_deploy_names operator_deploy_replicas || true
    fi
  }
  trap cleanup_restore EXIT INT TERM

  echo "Triggering manual encrypted bundle backup in each TON pod (parallel) ..."
  local -a trigger_pids=()
  local -a trigger_descs=()
  for i in "${!sts_list[@]}"; do
    ns="${ns_list[$i]}"
    sts="${sts_list[$i]}"
    replicas="${replicas_list[$i]}"
    if ! [[ "$replicas" =~ ^[0-9]+$ ]]; then
      replicas=0
    fi
    if (( replicas == 0 )); then
      continue
    fi

    for ordinal in $(seq 0 $((replicas - 1))); do
      pod="${sts}-${ordinal}"
      local helper_key="${ns}/${sts}/${ordinal}"
      local pod_node=""
      pod_node="$(kubectl -n "$ns" get pod "$pod" -o jsonpath='{.spec.nodeName}' 2>/dev/null || true)"
      pod_node="$(trim_whitespace "$pod_node")"
      if [[ -n "$pod_node" ]]; then
        helper_nodes_by_replica["$helper_key"]="$pod_node"
      fi
      trigger_key_backup_once "$ns" "$pod" &
      trigger_pids+=("$!")
      trigger_descs+=("${ns}/${pod}")
    done
  done

  local trigger_failed=0
  for i in "${!trigger_pids[@]}"; do
    if ! wait "${trigger_pids[$i]}"; then
      echo "Error: key backup trigger failed for ${trigger_descs[$i]}." >&2
      trigger_failed=1
    fi
  done
  if [[ "$trigger_failed" -ne 0 ]]; then
    echo "Error: one or more pod backup triggers failed." >&2
    return 1
  fi

  pause_operator_reconcile operator_deploy_names operator_deploy_replicas
  operator_paused=1

  echo "Scaling TON StatefulSets to 0 ..."
  for i in "${!sts_list[@]}"; do
    set_ton_replicas "${ns_list[$i]}" "${sts_list[$i]}" 0
  done
  for i in "${!sts_list[@]}"; do
    wait_statefulset_pods_gone "${ns_list[$i]}" "${sts_list[$i]}"
  done

  echo "Exporting encrypted bundles to $output_dir (parallel) ..."
  local -a export_pids=()
  local -a export_descs=()
  for i in "${!sts_list[@]}"; do
    ns="${ns_list[$i]}"
    sts="${sts_list[$i]}"
    replicas="${replicas_list[$i]}"

    if ! [[ "$replicas" =~ ^[0-9]+$ ]]; then
      replicas=0
    fi
    if (( replicas == 0 )); then
      continue
    fi

    for ordinal in $(seq 0 $((replicas - 1))); do
      local helper_key="${ns}/${sts}/${ordinal}"
      local helper_node="${helper_nodes_by_replica[$helper_key]:-}"
      export_bundle_from_pvc "$ns" "$sts" "$ordinal" "$output_dir" "$helper_node" &
      export_pids+=("$!")
      export_descs+=("${ns}/${sts}/${ordinal}")
    done
  done

  local export_failed=0
  for i in "${!export_pids[@]}"; do
    if ! wait "${export_pids[$i]}"; then
      echo "Error: encrypted bundle export failed for ${export_descs[$i]}." >&2
      export_failed=1
    fi
  done
  if [[ "$export_failed" -ne 0 ]]; then
    echo "Error: one or more encrypted bundle exports failed." >&2
    return 1
  fi

  echo "Restoring TON StatefulSets replicas with sticky node placement ..."
  local sticky_restore_count=0
  local sticky_restore_failed=0
  local -a expected_nodes=()
  for i in "${!sts_list[@]}"; do
    ns="${ns_list[$i]}"
    sts="${sts_list[$i]}"
    replicas="${replicas_list[$i]}"
    if ! [[ "$replicas" =~ ^[0-9]+$ ]]; then
      replicas=0
    fi
    if (( replicas == 0 )); then
      set_ton_replicas "$ns" "$sts" 0
      continue
    fi

    node_map_key="${ns}/${sts}"
    node_map="${ordinal_node_maps[$node_map_key]:-}"
    if [[ -z "$node_map" ]]; then
      echo "Error: missing pre-backup ordinal->node map for ${ns}/${sts}; refusing non-sticky restore." >&2
      ((sticky_restore_failed+=1))
      continue
    fi

    expected_nodes=()
    if ! parse_ordinal_node_map "$node_map" expected_nodes; then
      echo "Error: invalid pre-backup ordinal->node map for ${ns}/${sts}; refusing non-sticky restore." >&2
      ((sticky_restore_failed+=1))
      continue
    fi
    if (( ${#expected_nodes[@]} < replicas )); then
      echo "Error: incomplete pre-backup ordinal->node map for ${ns}/${sts} (have ${#expected_nodes[@]}, need ${replicas})." >&2
      ((sticky_restore_failed+=1))
      continue
    fi
    if restore_statefulset_with_expected_nodes "$ns" "$sts" "$replicas" expected_nodes; then
      ((sticky_restore_count+=1))
    else
      echo "Error: failed sticky-node restore for ${ns}/${sts} after backup." >&2
      ((sticky_restore_failed+=1))
    fi
  done
  echo "Backup node placement summary: restored=${sticky_restore_count}, failed=${sticky_restore_failed}"
  if (( sticky_restore_failed > 0 )); then
    return 1
  fi
  if [[ "$operator_paused" -eq 1 ]]; then
    resume_operator_reconcile operator_deploy_names operator_deploy_replicas
    operator_paused=0
  fi

  restore_required=0
  trap - EXIT INT TERM
  echo "Encrypted key bundle backup complete: $output_dir"
}

ton_restore_plan_script() {
  # Reuse add's quantity and resource request parsers for replacement admission.
  ton_add_context_script | python3 -c 'import sys; print(sys.stdin.read().split("def main():",1)[0])'
  cat <<'PY'
import hashlib

snapshots = [json.loads(part) if part else {} for part in sys.stdin.read().split("\0")[:7]]
sts, cr, pods, pvcs, pvs, classes, nodes = snapshots
reference, key, value, minimum_cpu, minimum_memory, map_key = sys.argv[1:]
try:
    if cr.get("spec", {}).get("keyManagement", {}).get("provider", "vault") != "vault":
        raise ValueError("targeted recovery currently requires Vault key management")
    if not cr.get("spec", {}).get("keyManagement", {}).get("enabled"):
        raise ValueError("targeted recovery requires encrypted key management")
    name, namespace, uid = sts["metadata"]["name"], sts["metadata"]["namespace"], sts["metadata"]["uid"]
    replicas = sts["spec"]["replicas"]
    if replicas < 1 or cr["spec"].get("replicas", 1) != replicas:
        raise ValueError("fleet replica counts are not converged")
    if not any(o.get("controller") and o.get("kind") == "TonNode" and o.get("uid") == cr["metadata"]["uid"] for o in sts["metadata"].get("ownerReferences", [])):
        raise ValueError("StatefulSet is not controlled by the matching TonNode")
    owned = [p for p in pods["items"] if any(o.get("controller") and o.get("uid") == uid and o.get("kind") == "StatefulSet" for o in p.get("metadata", {}).get("ownerReferences", []))]
    matches = [p for p in owned if reference in (p["metadata"]["name"], namespace + "/" + p["metadata"]["name"], p.get("spec", {}).get("nodeName"))]
    if len(matches) != 1:
        raise ValueError("target must identify exactly one existing TON pod or server")
    pod = matches[0]; ordinal = int(pod["metadata"]["name"].removeprefix(name + "-"))
    if not 0 <= ordinal < replicas or pod["metadata"].get("deletionTimestamp"):
        raise ValueError("target is terminating or outside the fleet")
    source_node = next((n for n in nodes["items"] if n["metadata"]["name"] == pod.get("spec", {}).get("nodeName")), None)
    if not source_node or source_node["metadata"].get("deletionTimestamp") or not any(c.get("type") == "Ready" and c.get("status") == "True" for c in source_node.get("status", {}).get("conditions", [])):
        raise ValueError("source server must be Ready and reachable for a verified graceful stop; offline source fencing requires separate recovery")
    running, siblings = {}, {}
    for index in range(replicas):
        found = [p for p in owned if p["metadata"]["name"] == name + "-" + str(index)]
        if len(found) != 1 or found[0]["metadata"].get("deletionTimestamp"):
            raise ValueError("fleet has missing or terminating pods; recover them before targeted restore")
        item = found[0]; node = item.get("spec", {}).get("nodeName")
        if not node:
            raise ValueError("fleet contains an unassigned pod")
        running[str(index)] = node
        if index != ordinal:
            if not any(c.get("type") == "Ready" and c.get("status") == "True" for c in item.get("status", {}).get("conditions", [])):
                raise ValueError("another TON pod is not Ready; recover one pod at a time")
            siblings[item["metadata"]["name"]] = item["metadata"]["uid"]
    if len(set(running.values())) != replicas:
        raise ValueError("targeted recovery requires one TON replica per server")
    spec = sts["spec"]["template"]["spec"]
    main = next(c for c in spec["containers"] if c["name"] == "ton-node")
    if not any(c.get("name") == "restore-node-bootstrap" and c.get("image") == main.get("image") and
               c.get("command", [])[:2] == ["/opt/mytonctrl/venv/bin/python", "-c"] and
               c["command"][-1] == "restore-bootstrap" for c in spec.get("initContainers", [])):
        raise ValueError("targeted recovery requires an updated operator with restore-node-bootstrap support; run ./kubeton upgrade first")
    selector = dict(spec.get("nodeSelector", {})); network = cr["spec"].get("network", {})
    if selector != cr["spec"].get("nodeSelector", {}):
        raise ValueError("TonNode and StatefulSet selectors differ")
    terms = spec.get("affinity", {}).get("nodeAffinity", {}).get("requiredDuringSchedulingIgnoredDuringExecution", {}).get("nodeSelectorTerms", [])
    automatic = bool(network.get("hostPortsEnabled", True) and not network.get("publicIP") and len(terms) == 1 and not terms[0].get("matchFields") and len(terms[0].get("matchExpressions", [])) == 1 and terms[0]["matchExpressions"][0].get("key") == "kubernetes.io/hostname" and terms[0]["matchExpressions"][0].get("operator") == "In")
    if not automatic or not re.fullmatch(r"[0-9a-f]{64}", sts["metadata"].get("annotations", {}).get("ton.ton.org/sticky-placement-spec-hash", "")):
        raise ValueError("targeted relocation requires the current operator with automatic sticky placement and host ports")
    templates = {t["metadata"]["name"]: t for t in sts["spec"]["volumeClaimTemplates"]}
    if set(templates) != {"ton-work", "ton-src", "mytoncore", "mytonctrl", "keybundle"}:
        raise ValueError("unsupported claim layout; all original volumes were preserved")
    claims = {p["metadata"]["name"]: p for p in pvcs["items"]}; volumes = {p["metadata"]["name"]: p for p in pvs["items"]}; storage = {c["metadata"]["name"]: c for c in classes["items"]}
    old, data, longhorn = [], 0, False
    storage_requirements = []
    for prefix, template in templates.items():
        claim_name = prefix + "-" + name + "-" + str(ordinal); claim = claims.get(claim_name)
        if not claim or claim["metadata"].get("deletionTimestamp"):
            raise ValueError("target PVC is missing or terminating: " + claim_name)
        volume = volumes.get(claim["spec"].get("volumeName"))
        if not volume or volume["spec"].get("claimRef", {}).get("uid") != claim["metadata"]["uid"]:
            raise ValueError("cannot verify target PVC/PV identity: " + claim_name)
        if any(o.get("kind") == "Pod" for o in claim["metadata"].get("ownerReferences", [])):
            raise ValueError("target PVC has a Pod deletion owner; set StatefulSet PVC retention to Retain and retry")
        sc = template["spec"].get("storageClassName")
        provisioner = storage.get(sc, {}).get("provisioner")
        if provisioner not in ("rancher.io/local-path", "driver.longhorn.io"):
            raise ValueError("targeted recovery supports dynamic local-path or Longhorn claim templates")
        if template["spec"].get("volumeName") or template["spec"].get("selector"):
            raise ValueError("prebound claim templates cannot be relocated automatically")
        capacity = math.ceil(quantity(template["spec"]["resources"]["requests"]["storage"]))
        storage_requirements.extend((sc, str(capacity)))
        if provisioner == "rancher.io/local-path": data += capacity
        longhorn |= provisioner == "driver.longhorn.io"
        old.append({"name": claim_name, "uid": claim["metadata"]["uid"], "pv": volume["metadata"]["name"], "pv_uid": volume["metadata"]["uid"]})
    agent = next(c for c in spec["containers"] if c["name"] == "key-backup")
    env = {e["name"]: e.get("value") for e in agent.get("env", [])}
    enc, meta = env.get("KEY_BUNDLE_FILE", "keys.bundle.enc"), env.get("KEY_BUNDLE_META_FILE", "keys.bundle.meta")
    if any(not isinstance(s,str) or not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9_.-]*", s) for s in (enc,meta)):
        raise ValueError("unsupported encrypted bundle filenames")
    cpu, memory = requests(spec)
    managed = {k:v for k,v in selector.items() if (k == key and v == value) or (k == "node.longhorn.io/create-default-disk" and v == "true")}
    ports = sorted({p.get("protocol", "TCP") + "/" + str(p["hostPort"]) for c in spec.get("containers", []) + spec.get("initContainers", []) for p in c.get("ports", []) if p.get("hostPort", 0) > 0})
    fingerprint = hashlib.sha256(json.dumps({"sts_spec": sts["spec"], "cr_spec": cr["spec"], "sts_annotations": sts["metadata"].get("annotations", {}), "cr_annotations": cr["metadata"].get("annotations", {})}, sort_keys=True).encode()).hexdigest()
    print(json.dumps({"namespace": namespace, "name": name, "uid": uid, "cr_uid": cr["metadata"]["uid"], "fingerprint": fingerprint, "replicas": replicas, "ordinal": ordinal, "pod": pod["metadata"]["name"], "pod_uid": pod["metadata"]["uid"], "source": pod["spec"]["nodeName"], "siblings": siblings, "old_claims": old, "cpu": math.ceil(max(cpu, quantity(minimum_cpu))*1000), "memory": math.ceil(max(memory, quantity(minimum_memory))), "data": data, "storage_requirements": storage_requirements, "ports": ports, "selector": selector, "managed": managed, "running": running, "automatic": automatic, "affinity": spec.get("affinity", {}).get("nodeAffinity", {}), "constraints": [], "longhorn": longhorn, "scope": ",".join(k+"="+v for k,v in sorted(selector.items()) if k not in managed), "enc": enc, "meta": meta}))
except (KeyError, TypeError, ValueError, StopIteration, ArithmeticError) as error:
    sys.exit("Error: cannot prepare targeted restore: " + str(error))
PY
}

ton_restore_plan() {
  local ns="$1" sts="$2" target="$3" sts_json cr_json pods_json pvcs_json pvs_json classes_json nodes_json
  sts_json="$(kubectl -n "$ns" get statefulset "$sts" -o json)" || return 1
  cr_json="$(kubectl -n "$ns" get tonnodes.ton.ton.org "$sts" -o json)" || return 1
  pods_json="$(kubectl -n "$ns" get pods -o json)" || return 1
  pvcs_json="$(kubectl -n "$ns" get pvc -o json)" || return 1
  pvs_json="$(kubectl get pv -o json)" || return 1
  classes_json="$(kubectl get storageclass -o json)" || return 1
  nodes_json="$(kubectl get nodes -o json)" || return 1
  printf '%s\0' "$sts_json" "$cr_json" "$pods_json" "$pvcs_json" "$pvs_json" "$classes_json" "$nodes_json" \
    | python3 -c "$(ton_restore_plan_script)" "$target" "$KUBETON_NODE_PREREQ_LABEL_KEY" "$KUBETON_NODE_PREREQ_LABEL_VALUE" "$KUBETON_CHECK_MIN_CPU" "$KUBETON_CHECK_MIN_MEMORY" "$STICKY_ORDINAL_NODE_MAP_ANNOTATION_KEY"
}

ton_restore_helper_manifest() {
