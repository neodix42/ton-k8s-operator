# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib
bin/*
Dockerfile.cross

# Locally packaged Helm charts (CI packages the selected release).
/dist/charts/

# Python runtime/test caches.
__pycache__/
*.py[cod]

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool, specifically when used with LiteIDE
*.out

# Local kubeton launch evidence (may contain sensitive operational logs)
kubeton-launch-logs/
fleet-backups/
kubeton-recovery-*/

# Go workspace file
go.work

# Kubernetes Generated files - skip generated files, except for vendored files
!vendor/**/zz_generated.*

# editor and IDE paraphernalia
.idea
.vscode
*.swp
*.swo
*~
